.uni-graz.at/o:aaif.spacdh#En1600Ph1Ve1" /><aaif:adverb rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh#En1600Ph1Ad1" /><aaif:adverb rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh#En1600Ph1Ad2" /><aaif:text> El bandido se le acercó , lento y colérico </aaif:text><aaif:annoText> [s|El bandido|ms] se le [v|acercó|acercar|ts] , [a|lento|lento|ausnmnnC] y [a|colérico|colérico|ausnmnnC] </aaif:annoText></aaif:Phrase><aaif:Subject rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En1600Ph1Su1"><aaif:text>El bandido</aaif:text><aaif:position rdf:datatype="http://www.w3.org/2001/XMLSchema#int">1</aaif:position><aaif:gender rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Masculine" /><aaif:number rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Singular" /><aaif:overt rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</aaif:overt></aaif:Subject><aaif:Verb rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En1600Ph1Ve1"><aaif:text>acercó</aaif:text><aaif:lemma rdf:resource="https://gams.uni-graz.at/o:aaif.lemma#acercar" /><aaif:position rdf:datatype="http://www.w3.org/2001/XMLSchema#int">2</aaif:position><aaif:coordinated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:coordinated><aaif:partOfText rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</aaif:partOfText><aaif:syntacticConstruction rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Transitive" /></aaif:Verb><aaif:Adverb rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En1600Ph1Ad1"><aaif:text>lento</aaif:text><aaif:lemma rdf:resource="https://gams.uni-graz.at/o:aaif.lemma#lento" /><aaif:position rdf:datatype="http://www.w3.org/2001/XMLSchema#int">3</aaif:position><aaif:coordinated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</aaif:coordinated><aaif:morphosyntacticStructure rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Adjective" /><aaif:inflection rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Uninflected" /><aaif:attributionTarget rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Verb" /><aaif:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:modified><aaif:semanticClassification rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Manner" /><aaif:reduplicated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:reduplicated><aaif:prepositionalPhrase rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:prepositionalPhrase></aaif:Adverb><aaif:Adverb rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En1600Ph1Ad2"><aaif:text>colérico</aaif:text><aaif:lemma rdf:resource="https://gams.uni-graz.at/o:aaif.lemma#colérico" /><aaif:position rdf:datatype="http://www.w3.org/2001/XMLSchema#int">4</aaif:position><aaif:coordinated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</aaif:coordinated><aaif:morphosyntacticStructure rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Adjective" /><aaif:inflection rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Uninflected" /><aaif:attributionTarget rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Verb" /><aaif:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:modified><aaif:semanticClassification rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Manner" /><aaif:reduplicated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:reduplicated><aaif:prepositionalPhrase rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:prepositionalPhrase></aaif:Adverb><aaif:Entry rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En1601"><aaif:phrase rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh#En1601Ph1" /><aaif:source rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh.bibl#Cnde43" /><gams:textualContent>Adela Pues cierre los ojos, y andando, que ya empieza a caer el sol.&lt;lb/&gt;Quico Voy, mi ama.Voy.&lt;lb/&gt;( Sale  lento , volviéndose todavía desde la puerta del corral.Falín vuelca con estruendo una caja de lata llena de botones.)</gams:textualContent><rel:isPartOf rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh" /></aaif:Entry><aaif:Phrase rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En1601Ph1"><aaif:verb rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh#En1601Ph1Ve1" /><aaif:adverb rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh#En1601Ph1Ad1" /><aaif:text> Sale  lento ,</aaif:text><aaif:annoText> [v|Sale|salir|is]  [a|lento|lento|auvnmnnn] ,</aaif:annoText></aaif:Phrase><aaif:Verb rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En1601Ph1Ve1"><aaif:text>Sale</aaif:text><aaif:lemma rdf:resource="https://gams.uni-graz.at/o:aaif.lemma#salir" /><aaif:position rdf:datatype="http://www.w3.org/2001/XMLSchema#int">1</aaif:position><aaif:coordinated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:coordinated><aaif:partOfText rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</aaif:partOfText><aaif:syntacticConstruction rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Intransitive" /></aaif:Verb><aaif:Adverb rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En1601Ph1Ad1"><aaif:text>lento</aaif:text><aaif:lemma rdf:resource="https://gams.uni-graz.at/o:aaif.lemma#lento" /><aaif:position rdf:datatype="http://www.w3.org/2001/XMLSchema#int">2</aaif:position><aaif:coordinated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:coordinated><aaif:morphosyntacticStructure rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Adjective" /><aaif:inflection rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Uninflected" /><aaif:attributionTarget rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Verb" /><aaif:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:modified><aaif:semanticClassification rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Manner" /><aaif:reduplicated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:reduplicated><aaif:prepositionalPhrase rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:prepositionalPhrase></aaif:Adverb><aaif:Entry rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En1602"><aaif:phrase rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh#En1602Ph1" /><aaif:source rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh.bibl#Cnde44" /><gams:textualContent>La pobre agua está triste&lt;lb/&gt;recogida en el tazón&lt;lb/&gt;de este parquecillo urbano.&lt;lb/&gt;Es la media tarde:  Pasan &lt;lb/&gt; lentos  los novios de brazo...&lt;lb/&gt;Un niño llora a lo lejos,&lt;lb/&gt;duerme un mendigo en un banco,&lt;lb/&gt;canturrea un organillo</gams:textualContent><rel:isPartOf rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh" /></aaif:Entry><aaif:Phrase rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En1602Ph1"><aaif:subject rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh#En1602Ph1Su1" /><aaif:verb rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh#En1602Ph1Ve1" /><aaif:adverb rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh#En1602Ph1Ad1" /><aaif:text> Pasan &lt;lb\/&gt; lentos  los novios de brazo</aaif:text><aaif:annoText> [v|Pasan|pasar|is] &lt;lb\/&gt; [a|lentos|lento|apsnmnnn]  [s|los novios|mp] de brazo</aaif:annoText></aaif:Phrase><aaif:Subject rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En1602Ph1Su1"><aaif:text>los novios</aaif:text><aaif:position rdf:datatype="http://www.w3.org/2001/XMLSchema#int">3</aaif:position><aaif:gender rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Masculine" /><aaif:number rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Plural" /><aaif:overt rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</aaif:overt></aaif:Subject><aaif:Verb rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En1602Ph1Ve1"><aaif:text>Pasan</aaif:text><aaif:lemma rdf:resource="https://gams.uni-graz.at/o:aaif.lemma#pasar" /><aaif:position rdf:datatype="http://www.w3.org/2001/XMLSchema#int">1</aaif:position><aaif:coordinated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:coordinated><aaif:partOfText rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</aaif:partOfText><aaif:syntacticConstruction rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Intransitive" /></aaif:Verb><aaif:Adverb rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En1602Ph1Ad1"><aaif:text>lentos</aaif:text><aaif:lemma rdf:resource="https://gams.uni-graz.at/o:aaif.lemma#lento" /><aaif:position rdf:datatype="http://www.w3.org/2001/XMLSchema#int">2</aaif:position><aaif:coordinated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:coordinated><aaif:morphosyntacticStructure rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Adjective" /><aaif:inflection rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#MasculinePlural" /><aaif:attributionTarget rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Verb" /><aaif:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:modified><aaif:semanticClassification rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Manner" /><aaif:reduplicated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:reduplicated><aaif:prepositionalPhrase rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:prepositionalPhrase></aaif:Adverb><aaif:Entry rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En1603"><aaif:phrase rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh#En1603Ph1" /><aaif:source rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh.bibl#Cnde45" /><gams:textualContent> El reloj de arena  iba lento unos ratos y apresurado otros.</gams:textualContent><rel:isPartOf rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh" /></aaif:Entry><aaif:Phrase rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En1603Ph1"><aaif:subject rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh#En1603Ph1Su1" /><aaif:verb rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh#En1603Ph1Ve1" /><aaif:adverb rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh#En1603Ph1Ad1" /><aaif:adverb rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh#En1603Ph1Ad2" /><aaif:text> El reloj de arena  iba lento unos ratos y apresurado otros.</aaif:text><aaif:annoText> [s|El reloj de arena|ms]  [v|iba|ir|is] [a|lento|lento|auvnmnnC] unos ratos y [a|apresurado|apresurado|auvnmnnC] otros.</aaif:annoText></aaif:Phrase><aaif:Subject rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En1603Ph1Su1"><aaif:text>El reloj de arena</aaif:text><aaif:position rdf:datatype="http://www.w3.org/2001/XMLSchema#int">1</aaif:position><aaif:gender rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Masculine" /><aaif:number rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Singular" /><aaif:overt rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</aaif:overt></aaif:Subject><aaif:Verb rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En1603Ph1Ve1"><aaif:text>iba</aaif:text><aaif:lemma rdf:resource="https://gams.uni-graz.at/o:aaif.lemma#ir" /><aaif:position rdf:datatype="http://www.w3.org/2001/XMLSchema#int">2</aaif:position><aaif:coordinated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:coordinated><aaif:partOfText rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</aaif:partOfText><aaif:syntacticConstruction rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Intransitive" /></aaif:Verb><aaif:Adverb rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En1603Ph1Ad1"><aaif:text>lento</aaif:text><aaif:lemma rdf:resource="https://gams.uni-graz.at/o:aaif.lemma#lento" /><aaif:position rdf:datatype="http://www.w3.org/2001/XMLSchema#int">3</aaif:position><aaif:coordinated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</aaif:coordinated><aaif:morphosyntacticStructure rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Adjective" /><aaif:inflection rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Uninflected" /><aaif:attributionTarget rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Verb" /><aaif:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:modified><aaif:semanticClassification rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Manner" /><aaif:reduplicated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:reduplicated><aaif:prepositionalPhrase rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:prepositionalPhrase></aaif:Adverb><aaif:Adverb rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En1603Ph1Ad2"><aaif:text>apresurado</aaif:text><aaif:lemma rdf:resource="https://gams.uni-graz.at/o:aaif.lemma#apresurado" /><aaif:position rdf:datatype="http://www.w3.org/2001/XMLSchema#int">4</aaif:position><aaif:coordinated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</aaif:coordinated><aaif:morphosyntacticStructure rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Adjective" /><aaif:inflection rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Uninflected" /><aaif:attributionTarget rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Verb" /><aaif:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:modified><aaif:semanticClassification rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Manner" /><aaif:reduplicated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:reduplicated><aaif:prepositionalPhrase rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:prepositionalPhrase></aaif:Adverb><aaif:Entry rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En1604"><aaif:phrase rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh#En1604Ph1" /><aaif:source rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh.bibl#Cnde46" /><gams:textualContent>— Digo, después — aclaró , lenta , la mujerona .Santolalla se ruborizó; respondió, apresurado: </gams:textualContent><rel:isPartOf rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh" /></aaif:Entry><aaif:Phrase rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En1604Ph1"><aaif:subject rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh#En1604Ph1Su1" /><aaif:verb rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh#En1604Ph1Ve1" /><aaif:adverb rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh#En1604Ph1Ad1" /><aaif:text>Digo, después — aclaró , lenta , la mujerona .</aaif:text><aaif:annoText>Digo, después — [v|aclaró|aclarar|ts] , [a|lenta|lento|afsnmnnn] , [s|la mujerona|fs] .</aaif:annoText></aaif:Phrase><aaif:Subject rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En1604Ph1Su1"><aaif:text>la mujerona</aaif:text><aaif:position rdf:datatype="http://www.w3.org/2001/XMLSchema#int">3</aaif:position><aaif:gender rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Feminine" /><aaif:number rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Singular" /><aaif:overt rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</aaif:overt></aaif:Subject><aaif:Verb rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En1604Ph1Ve1"><aaif:text>aclaró</aaif:text><aaif:lemma rdf:resource="https://gams.uni-graz.at/o:aaif.lemma#aclarar" /><aaif:position rdf:datatype="http://www.w3.org/2001/XMLSchema#int">1</aaif:position><aaif:coordinated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:coordinated><aaif:partOfText rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</aaif:partOfText><aaif:syntacticConstruction rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Transitive" /></aaif:Verb><aaif:Adverb rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En1604Ph1Ad1"><aaif:text>lenta</aaif:text><aaif:lemma rdf:resource="https://gams.uni-graz.at/o:aaif.lemma#lento" /><aaif:position rdf:datatype="http://www.w3.org/2001/XMLSchema#int">2</aaif:position><aaif:coordinated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:coordinated><aaif:morphosyntacticStructure rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Adjective" /><aaif:inflection rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#FeminineSingular" /><aaif:attributionTarget rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Verb" /><aaif:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:modified><aaif:semanticClassification rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Manner" /><aaif:reduplicated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:reduplicated><aaif:prepositionalPhrase rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:prepositionalPhrase></aaif:Adverb><aaif:Entry rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En1605"><aaif:phrase rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh#En1605Ph1" /><aaif:source rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh.bibl#Cnde47" /><gams:textualContent>lo prolonga y hace de cada período una imagen y de cada imagen un mundo. El discurso poético  fluye lento , se bifurca en “paréntesis frondosos”, que son islas esbeltas, y continúa errante entre paisajes,</gams:textualContent><rel:isPartOf rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh" /></aaif:Entry><aaif:Phrase rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En1605Ph1"><aaif:subject rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh#En1605Ph1Su1" /><aaif:verb rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh#En1605Ph1Ve1" /><aaif:adverb rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh#En1605Ph1Ad1" /><aaif:text> El discurso poético  fluye lento </aaif:text><aaif:annoText> [s|El discurso poético|ms]  [v|fluye|fluir|is] [a|lento|lento|auvnmnnn] </aaif:annoText></aaif:Phrase><aaif:Subject rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En1605Ph1Su1"><aaif:text>El discurso poético</aaif:text><aaif:position rdf:datatype="http://www.w3.org/2001/XMLSchema#int">1</aaif:position><aaif:gender rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Masculine" /><aaif:number rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Singular" /><aaif:overt rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</aaif:overt></aaif:Subject><aaif:Verb rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En1605Ph1Ve1"><aaif:text>fluye</aaif:text><aaif:lemma rdf:resource="https://gams.uni-graz.at/o:aaif.lemma#fluir" /><aaif:position rdf:datatype="http://www.w3.org/2001/XMLSchema#int">2</aaif:position><aaif:coordinated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:coordinated><aaif:partOfText rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</aaif:partOfText><aaif:syntacticConstruction rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Intransitive" /></aaif:Verb><aaif:Adverb rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En1605Ph1Ad1"><aaif:text>lento</aaif:text><aaif:lemma rdf:resource="https://gams.uni-graz.at/o:aaif.lemma#lento" /><aaif:position rdf:datatype="http://www.w3.org/2001/XMLSchema#int">3</aaif:position><aaif:coordinated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:coordinated><aaif:morphosyntacticStructure rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Adjective" /><aaif:inflection rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Uninflected" /><aaif:attributionTarget rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Verb" /><aaif:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:modified><aaif:semanticClassification rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Manner" /><aaif:reduplicated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:reduplicated><aaif:prepositionalPhrase rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:prepositionalPhrase></aaif:Adverb><aaif:Entry rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En1606"><aaif:phrase rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh#En1606Ph1" /><aaif:source rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh.bibl#Cnde48" /><gams:textualContent>sino el que ya conocemos en nuestra poesía: disuelto en rumores, brillos, aromas; el que  gira lento y destella suave ;árboles de rocío, caracoles de la luz y la penumbra, velados azares de la</gams:textualContent><rel:isPartOf rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh" /></aaif:Entry><aaif:Phrase rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En1606Ph1"><aaif:subject rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh#En1606Ph1Su1" /><aaif:verb rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh#En1606Ph1Ve1" /><aaif:verb rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh#En1606Ph1Ve2" /><aaif:adverb rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh#En1606Ph1Ad1" /><aaif:adverb rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh#En1606Ph1Ad2" /><aaif:text> el que  gira lento y destella suave </aaif:text><aaif:annoText> [s|el que|ms]  [v|gira|girar|is] [a|lento|lento|auvnmnnn] y [v|destella|destellar|is] [a|suave|suave|auvnmnnn] </aaif:annoText></aaif:Phrase><aaif:Subject rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En1606Ph1Su1"><aaif:text>el que</aaif:text><aaif:position rdf:datatype="http://www.w3.org/2001/XMLSchema#int">1</aaif:position><aaif:gender rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Masculine" /><aaif:number rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Singular" /><aaif:overt rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</aaif:overt></aaif:Subject><aaif:Verb rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En1606Ph1Ve1"><aaif:text>gira</aaif:text><aaif:lemma rdf:resource="https://gams.uni-graz.at/o:aaif.lemma#girar" /><aaif:position rdf:datatype="http://www.w3.org/2001/XMLSchema#int">2</aaif:position><aaif:coordinated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:coordinated><aaif:partOfText rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</aaif:partOfText><aaif:syntacticConstruction rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Intransitive" /></aaif:Verb><aaif:Verb rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En1606Ph1Ve2"><aaif:text>destella</aaif:text><aaif:lemma rdf:resource="https://gams.uni-graz.at/o:aaif.lemma#destellar" /><aaif:position rdf:datatype="http://www.w3.org/2001/XMLSchema#int">4</aaif:position><aaif:coordinated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:coordinated><aaif:partOfText rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</aaif:partOfText><aaif:syntacticConstruction rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Intransitive" /></aaif:Verb><aaif:Adverb rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En1606Ph1Ad1"><aaif:text>lento</aaif:text><aaif:lemma rdf:resource="https://gams.uni-graz.at/o:aaif.lemma#lento" /><aaif:position rdf:datatype="http://www.w3.org/2001/XMLSchema#int">3</aaif:position><aaif:coordinated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:coordinated><aaif:morphosyntacticStructure rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Adjective" /><aaif:inflection rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Uninflected" /><aaif:attributionTarget rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Verb" /><aaif:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:modified><aaif:semanticClassification rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Manner" /><aaif:reduplicated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:reduplicated><aaif:prepositionalPhrase rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:prepositionalPhrase></aaif:Adverb><aaif:Adverb rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En1606Ph1Ad2"><aaif:text>suave</aaif:text><aaif:lemma rdf:resource="https://gams.uni-graz.at/o:aaif.lemma#suave" /><aaif:position rdf:datatype="http://www.w3.org/2001/XMLSchema#int">5</aaif:position><aaif:coordinated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:coordinated><aaif:morphosyntacticStructure rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Adjective" /><aaif:inflection rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Uninflected" /><aaif:attributionTarget rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Verb" /><aaif:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:modified><aaif:semanticClassification rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Manner" /><aaif:reduplicated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:reduplicated><aaif:prepositionalPhrase rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:prepositionalPhrase></aaif:Adverb><aaif:Entry rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En1607"><aaif:phrase rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh#En1607Ph1" /><aaif:source rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh.bibl#Cnde1" /><gams:textualContent>taurinos de Ruano Llopis, un mantón de Manila sobre el piano de concierto.Entró como acostumbraba entrar, embistiendo lento , con la cabeza india, rapada sobre las sienes, en forma de balazo, devolviendo los saludos con</gams:textualContent><rel:isPartOf rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh" /></aaif:Entry><aaif:Phrase rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En1607Ph1"><aaif:verb rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh#En1607Ph1Ve1" /><aaif:adverb rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh#En1607Ph1Ad1" /><aaif:text>Entró como acostumbraba entrar, embistiendo lento , con la cabeza india,</aaif:text><aaif:annoText>Entró como acostumbraba entrar, [v|embistiendo|embestir|is] [a|lento|lento|auvnmnnn] , con la cabeza india,</aaif:annoText></aaif:Phrase><aaif:Verb rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En1607Ph1Ve1"><aaif:text>embistiendo</aaif:text><aaif:lemma rdf:resource="https://gams.uni-graz.at/o:aaif.lemma#embestir" /><aaif:position rdf:datatype="http://www.w3.org/2001/XMLSchema#int">1</aaif:position><aaif:coordinated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:coordinated><aaif:partOfText rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</aaif:partOfText><aaif:syntacticConstruction rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Intransitive" /></aaif:Verb><aaif:Adverb rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En1607Ph1Ad1"><aaif:text>lento</aaif:text><aaif:lemma rdf:resource="https://gams.uni-graz.at/o:aaif.lemma#lento" /><aaif:position rdf:datatype="http://www.w3.org/2001/XMLSchema#int">2</aaif:position><aaif:coordinated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:coordinated><aaif:morphosyntacticStructure rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Adjective" /><aaif:inflection rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Uninflected" /><aaif:attributionTarget rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Verb" /><aaif:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:modified><aaif:semanticClassification rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Manner" /><aaif:reduplicated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:reduplicated><aaif:prepositionalPhrase rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:prepositionalPhrase></aaif:Adverb><aaif:Entry rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En1608"><aaif:phrase rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh#En1608Ph1" /><aaif:source rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh.bibl#Cnde1" /><gams:textualContent>Mecánicamente, había proseguido con los trámites de la quiebra.Su voz no volvió a levantarse:  corría , lento como en los sueños, a lo largo de expedientes y consultas y papeles.El nuevo amanecer lo sorprendió, en mangas de camisa,</gams:textualContent><rel:isPartOf rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh" /></aaif:Entry><aaif:Phrase rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En1608Ph1"><aaif:verb rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh#En1608Ph1Ve1" /><aaif:adverb rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh#En1608Ph1Ad1" /><aaif:text> corría , lento como en los sueños, a lo largo de expedientes y consultas y papeles</aaif:text><aaif:annoText> [v|corría|correr|is] , [a|lento|lento|auvnmnnn] como en los sueños, a lo largo de expedientes y consultas y papeles</aaif:annoText></aaif:Phrase><aaif:Verb rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En1608Ph1Ve1"><aaif:text>corría</aaif:text><aaif:lemma rdf:resource="https://gams.uni-graz.at/o:aaif.lemma#correr" /><aaif:position rdf:datatype="http://www.w3.org/2001/XMLSchema#int">1</aaif:position><aaif:coordinated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:coordinated><aaif:partOfText rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</aaif:partOfText><aaif:syntacticConstruction rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Intransitive" /></aaif:Verb><aaif:Adverb rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En1608Ph1Ad1"><aaif:text>lento</aaif:text><aaif:lemma rdf:resource="https://gams.uni-graz.at/o:aaif.lemma#lento" /><aaif:position rdf:datatype="http://www.w3.org/2001/XMLSchema#int">2</aaif:position><aaif:coordinated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:coordinated><aaif:morphosyntacticStructure rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Adjective" /><aaif:inflection rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Uninflected" /><aaif:attributionTarget rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Verb" /><aaif:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:modified><aaif:semanticClassification rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Manner" /><aaif:reduplicated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:reduplicated><aaif:prepositionalPhrase rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:prepositionalPhrase></aaif:Adverb><aaif:Entry rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En1609"><aaif:phrase rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh#En1609Ph1" /><aaif:source rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh.bibl#Cnde49" /><gams:textualContent>No, oye, que debe ser muy tarde.No te vuelvas a sentar, hombre.Mira a ver si puedes abrir.Ven.- Ya saldrá alguien -dijo Federico-, y entonces entramos nosotros.Anda, siéntate aquí, mira, en el tiesto.Y yo en el suelo.- Por Dios no, haz algo, hombre, qué horror.Si ya te decía yo que no salir, si no sé para que hemos salido.Voy a ver la otra puerta.Estaba cerrada también.La empujó con la mano, con las rodillas casi dando patadas a lo último.- Nada, no se abre.- Llama y desde dentro te oyen -dijo Federico, sentándose en el suelo y cerrando los ojos.Mercedes acercó la cara al cristal.Veía lo de dentro sin distinguirlo bien, confuso por el vaho de los cristales.Había dos figuras que no reconocía, muy juntas, sentadas de espaldas en el mismo sillón.Dio unos golpecitos tímidos y luego más fuerte.No oían.- Ay, llama tú por favor, Federico, qué horror;Dios mío.Le salía una voz casi de llanto.El se puso más cómodo y al moverse le dió náusea.— Pero parece que te he raptado, yo no te he raptado — dijo  lento y estropajoso , cuando pudo hablar.Se empezaron a oír unas campanadas en el reloj de la plaza.- Gertru, son las diez.Cuando quieras nos vamos.Eh, tú, Gertru, cariño.Ramón se había cansado y estaba tirado en la alfombra, con la cabeza en el regazo de su mujer.Quedaba menos gente.Gertru levantó los ojos bruscamente a la seña del brazo de Angel.- Si, vámonos, cuando tú quieras.Se levantaron.</gams:textualContent><rel:isPartOf rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh" /></aaif:Entry><aaif:Phrase rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En1609Ph1"><aaif:verb rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh#En1609Ph1Ve1" /><aaif:adverb rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh#En1609Ph1Ad1" /><aaif:adverb rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh#En1609Ph1Ad2" /><aaif:text> dijo  lento y estropajoso </aaif:text><aaif:annoText> [v|dijo|decir|ts]  [a|lento|lento|auvnmnnC] y [a|estropajoso|estropajoso|auvnmnnC] </aaif:annoText></aaif:Phrase><aaif:Verb rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En1609Ph1Ve1"><aaif:text>dijo</aaif:text><aaif:lemma rdf:resource="https://gams.uni-graz.at/o:aaif.lemma#decir" /><aaif:position rdf:datatype="http://www.w3.org/2001/XMLSchema#int">1</aaif:position><aaif:coordinated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:coordinated><aaif:partOfText rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</aaif:partOfText><aaif:syntacticConstruction rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Transitive" /></aaif:Verb><aaif:Adverb rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En1609Ph1Ad1"><aaif:text>lento</aaif:text><aaif:lemma rdf:resource="https://gams.uni-graz.at/o:aaif.lemma#lento" /><aaif:position rdf:datatype="http://www.w3.org/2001/XMLSchema#int">2</aaif:position><aaif:coordinated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</aaif:coordinated><aaif:morphosyntacticStructure rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Adjective" /><aaif:inflection rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Uninflected" /><aaif:attributionTarget rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Verb" /><aaif:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:modified><aaif:semanticClassification rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Manner" /><aaif:reduplicated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:reduplicated><aaif:prepositionalPhrase rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:prepositionalPhrase></aaif:Adverb><aaif:Adverb rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En1609Ph1Ad2"><aaif:text>estropajoso</aaif:text><aaif:lemma rdf:resource="https://gams.uni-graz.at/o:aaif.lemma#estropajoso" /><aaif:position rdf:datatype="http://www.w3.org/2001/XMLSchema#int">3</aaif:position><aaif:coordinated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</aaif:coordinated><aaif:morphosyntacticStructure rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Adjective" /><aaif:inflection rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Uninflected" /><aaif:attributionTarget rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Verb" /><aaif:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:modified><aaif:semanticClassification rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Manner" /><aaif:reduplicated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:reduplicated><aaif:prepositionalPhrase rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:prepositionalPhrase></aaif:Adverb><aaif:Entry rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En1610"><aaif:phrase rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh#En1610Ph1" /><aaif:source rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh.bibl#Cnde50" /><gams:textualContent>Oscurecía y apenas lloviznaba cuando empezó a moverse para tomar la última lancha a Santa María;  anduvo  lento , dejándose mojar por las gotas que caían de los árboles, hasta la penumbra y la soledad del</gams:textualContent><rel:isPartOf rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh" /></aaif:Entry><aaif:Phrase rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En1610Ph1"><aaif:verb rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh#En1610Ph1Ve1" /><aaif:adverb rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh#En1610Ph1Ad1" /><aaif:text> anduvo  lento , dejándose mojar por las gotas que caían de los árboles</aaif:text><aaif:annoText> [v|anduvo|andar|is]  [a|lento|lento|auvnmnnn] , dejándose mojar por las gotas que caían de los árboles</aaif:annoText></aaif:Phrase><aaif:Verb rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En1610Ph1Ve1"><aaif:text>anduvo</aaif:text><aaif:lemma rdf:resource="https://gams.uni-graz.at/o:aaif.lemma#andar" /><aaif:position rdf:datatype="http://www.w3.org/2001/XMLSchema#int">1</aaif:position><aaif:coordinated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:coordinated><aaif:partOfText rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</aaif:partOfText><aaif:syntacticConstruction rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Intransitive" /></aaif:Verb><aaif:Adverb rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En1610Ph1Ad1"><aaif:text>lento</aaif:text><aaif:lemma rdf:resource="https://gams.uni-graz.at/o:aaif.lemma#lento" /><aaif:position rdf:datatype="http://www.w3.org/2001/XMLSchema#int">2</aaif:position><aaif:coordinated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:coordinated><aaif:morphosyntacticStructure rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Adjective" /><aaif:inflection rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Uninflected" /><aaif:attributionTarget rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Verb" /><aaif:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:modified><aaif:semanticClassification rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Manner" /><aaif:reduplicated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:reduplicated><aaif:prepositionalPhrase rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:prepositionalPhrase></aaif:Adverb><aaif:Entry rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En1611"><aaif:phrase rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh#En1611Ph1" /><aaif:source rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh.bibl#Cnde50" /><gams:textualContent> Larsen  miró , lento y provocativo , las dos caras que lo despedían con sonrisas parejas, acentuando la burla de origen impreciso,</gams:textualContent><rel:isPartOf rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh" /></aaif:Entry><aaif:Phrase rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En1611Ph1"><aaif:subject rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh#En1611Ph1Su1" /><aaif:verb rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh#En1611Ph1Ve1" /><aaif:adverb rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh#En1611Ph1Ad1" /><aaif:adverb rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh#En1611Ph1Ad2" /><aaif:text> Larsen  miró , lento y provocativo , las dos caras</aaif:text><aaif:annoText> [s|Larsen|ms]  [v|miró|mirar|ts] , [a|lento|lento|ausnmnnC] y [a|provocativo|provocativo|ausnmnnC] , las dos caras</aaif:annoText></aaif:Phrase><aaif:Subject rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En1611Ph1Su1"><aaif:text>Larsen</aaif:text><aaif:position rdf:datatype="http://www.w3.org/2001/XMLSchema#int">1</aaif:position><aaif:gender rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Masculine" /><aaif:number rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Singular" /><aaif:overt rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</aaif:overt></aaif:Subject><aaif:Verb rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En1611Ph1Ve1"><aaif:text>miró</aaif:text><aaif:lemma rdf:resource="https://gams.uni-graz.at/o:aaif.lemma#mirar" /><aaif:position rdf:datatype="http://www.w3.org/2001/XMLSchema#int">2</aaif:position><aaif:coordinated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:coordinated><aaif:partOfText rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</aaif:partOfText><aaif:syntacticConstruction rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Transitive" /></aaif:Verb><aaif:Adverb rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En1611Ph1Ad1"><aaif:text>lento</aaif:text><aaif:lemma rdf:resource="https://gams.uni-graz.at/o:aaif.lemma#lento" /><aaif:position rdf:datatype="http://www.w3.org/2001/XMLSchema#int">3</aaif:position><aaif:coordinated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</aaif:coordinated><aaif:morphosyntacticStructure rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Adjective" /><aaif:inflection rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Uninflected" /><aaif:attributionTarget rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Verb" /><aaif:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:modified><aaif:semanticClassification rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Manner" /><aaif:reduplicated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:reduplicated><aaif:prepositionalPhrase rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:prepositionalPhrase></aaif:Adverb><aaif:Adverb rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En1611Ph1Ad2"><aaif:text>provocativo</aaif:text><aaif:lemma rdf:resource="https://gams.uni-graz.at/o:aaif.lemma#provocativo" /><aaif:position rdf:datatype="http://www.w3.org/2001/XMLSchema#int">4</aaif:position><aaif:coordinated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</aaif:coordinated><aaif:morphosyntacticStructure rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Adjective" /><aaif:inflection rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Uninflected" /><aaif:attributionTarget rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Verb" /><aaif:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:modified><aaif:semanticClassification rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Manner" /><aaif:reduplicated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:reduplicated><aaif:prepositionalPhrase rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:prepositionalPhrase></aaif:Adverb><aaif:Entry rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En1612"><aaif:phrase rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh#En1612Ph1" /><aaif:source rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh.bibl#Cnde50" /><gams:textualContent>Pero esto sucedió demasiado tarde, veinticuatro horas después. Aquel mediodía de la entrevista con Petrus, ya Gerente General, aunque no hubiera elegido aún su sueldo,  Larsen olvidó el almuerzo y después de evocar los cuerpos, las preocupaciones, los gestos desaparecidos del enorme salón que habían dividido las oficinas, empezó a bajar , lento y ruidoso , la escalera de hierro que llevaba a los galpones * y a los restos del muelle.</gams:textualContent><rel:isPartOf rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh" /></aaif:Entry><aaif:Phrase rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En1612Ph1"><aaif:subject rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh#En1612Ph1Su1" /><aaif:verb rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh#En1612Ph1Ve1" /><aaif:adverb rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh#En1612Ph1Ad1" /><aaif:adverb rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh#En1612Ph1Ad2" /><aaif:text> Larsen olvidó el almuerzo y después de evocar los cuerpos, las preocupaciones, los gestos desaparecidos del enorme salón que habían dividido las oficinas, empezó a bajar , lento y ruidoso , la escalera de hierro</aaif:text><aaif:annoText> [s|Larsen|ms] olvidó el almuerzo y después de evocar los cuerpos, las preocupaciones, los gestos desaparecidos del enorme salón que habían dividido las oficinas, empezó a [v|bajar|bajar|ts] , [a|lento|lento|auvnmnnC] y [a|ruidoso|ruidoso|auvnmnnC] , la escalera de hierro</aaif:annoText></aaif:Phrase><aaif:Subject rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En1612Ph1Su1"><aaif:text>Larsen</aaif:text><aaif:position rdf:datatype="http://www.w3.org/2001/XMLSchema#int">1</aaif:position><aaif:gender rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Masculine" /><aaif:number rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Singular" /><aaif:overt rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</aaif:overt></aaif:Subject><aaif:Verb rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En1612Ph1Ve1"><aaif:text>bajar</aaif:text><aaif:lemma rdf:resource="https://gams.uni-graz.at/o:aaif.lemma#bajar" /><aaif:position rdf:datatype="http://www.w3.org/2001/XMLSchema#int">2</aaif:position><aaif:coordinated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:coordinated><aaif:partOfText rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</aaif:partOfText><aaif:syntacticConstruction rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Transitive" /></aaif:Verb><aaif:Adverb rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En1612Ph1Ad1"><aaif:text>lento</aaif:text><aaif:lemma rdf:resource="https://gams.uni-graz.at/o:aaif.lemma#lento" /><aaif:position rdf:datatype="http://www.w3.org/2001/XMLSchema#int">3</aaif:position><aaif:coordinated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</aaif:coordinated><aaif:morphosyntacticStructure rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Adjective" /><aaif:inflection rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Uninflected" /><aaif:attributionTarget rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Verb" /><aaif:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:modified><aaif:semanticClassification rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Manner" /><aaif:reduplicated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:reduplicated><aaif:prepositionalPhrase rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:prepositionalPhrase></aaif:Adverb><aaif:Adverb rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En1612Ph1Ad2"><aaif:text>ruidoso</aaif:text><aaif:lemma rdf:resource="https://gams.uni-graz.at/o:aaif.lemma#ruidoso" /><aaif:position rdf:datatype="http://www.w3.org/2001/XMLSchema#int">4</aaif:position><aaif:coordinated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</aaif:coordinated><aaif:morphosyntacticStructure rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Adjective" /><aaif:inflection rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Uninflected" /><aaif:attributionTarget rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Verb" /><aaif:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:modified><aaif:semanticClassification rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Manner" /><aaif:reduplicated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:reduplicated><aaif:prepositionalPhrase rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:prepositionalPhrase></aaif:Adverb><aaif:Entry rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En1613"><aaif:phrase rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh#En1613Ph1" /><aaif:source rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh.bibl#Cnde51" /><gams:textualContent>cambiaban.Cada vez que uno vencía un obstáculo o acertaba un salto arriesgado, los demás aplaudían. El tiempo  transcurría lentísimo y cargado de tensión.A medida que se aproximaban al objetivo, se volvían más audaces; percibían ya muy</gams:textualContent><rel:isPartOf rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh" /></aaif:Entry><aaif:Phrase rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En1613Ph1"><aaif:subject rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh#En1613Ph1Su1" /><aaif:verb rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh#En1613Ph1Ve1" /><aaif:adverb rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh#En1613Ph1Ad1" /><aaif:text> El tiempo  transcurría lentísimo y cargado de tensión.</aaif:text><aaif:annoText> [s|El tiempo|ms]  [v|transcurría|transcurrir|is] [a|lentísimo|lento|auvnmnnC] y cargado de tensión.</aaif:annoText></aaif:Phrase><aaif:Subject rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En1613Ph1Su1"><aaif:text>El tiempo</aaif:text><aaif:position rdf:datatype="http://www.w3.org/2001/XMLSchema#int">1</aaif:position><aaif:gender rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Masculine" /><aaif:number rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Singular" /><aaif:overt rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</aaif:overt></aaif:Subject><aaif:Verb rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En1613Ph1Ve1"><aaif:text>transcurría</aaif:text><aaif:lemma rdf:resource="https://gams.uni-graz.at/o:aaif.lemma#transcurrir" /><aaif:position rdf:datatype="http://www.w3.org/2001/XMLSchema#int">2</aaif:position><aaif:coordinated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:coordinated><aaif:partOfText rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</aaif:partOfText><aaif:syntacticConstruction rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Intransitive" /></aaif:Verb><aaif:Adverb rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En1613Ph1Ad1"><aaif:text>lentísimo</aaif:text><aaif:lemma rdf:resource="https://gams.uni-graz.at/o:aaif.lemma#lento" /><aaif:position rdf:datatype="http://www.w3.org/2001/XMLSchema#int">3</aaif:position><aaif:coordinated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</aaif:coordinated><aaif:morphosyntacticStructure rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Adjective" /><aaif:inflection rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Uninflected" /><aaif:attributionTarget rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Verb" /><aaif:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:modified><aaif:semanticClassification rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Manner" /><aaif:reduplicated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:reduplicated><aaif:prepositionalPhrase rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:prepositionalPhrase></aaif:Adverb><aaif:Entry rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En1614"><aaif:phrase rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh#En1614Ph1" /><aaif:source rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh.bibl#Cnde52" /><gams:textualContent>Luego el soberano entró en el templo, donde lo recibieron mi abuelo y otro cardenal muy anciano. Su capa debía pesar como si estuviera forrada de plomo, a semejanza de las de los hipócritas que Dante describe, y se suponía que mi abuelo y su acompañante, ambos caducos y temblorosos, estaban allí para ayudarlo a soportar la carga tremenda, aunque yo no sé quién secundaba a quién, en tanto los tres caminaban por el puente, sofocados, pues lo más probable es que el joven, aun siendo emperador, añadiera en ese momento, a la fatiga de su agotadora envoltura, la que le ocasionaba el ir arrastrando a los dos viejos prendidos de la enorme prenda de brocado que centelleaba. Desfilaron , lentísimos , sobre nuestras cabezas, crac, crac, crac, crac, a modo de tres caracoles colosales.En el</gams:textualContent><rel:isPartOf rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh" /></aaif:Entry><aaif:Phrase rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En1614Ph1"><aaif:verb rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh#En1614Ph1Ve1" /><aaif:adverb rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh#En1614Ph1Ad1" /><aaif:text> Desfilaron , lentísimos , sobre nuestras cabezas</aaif:text><aaif:annoText> [v|Desfilaron|desfilar|is] , [a|lentísimos|lento|apvnmnnn] , sobre nuestras cabezas</aaif:annoText></aaif:Phrase><aaif:Verb rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En1614Ph1Ve1"><aaif:text>Desfilaron</aaif:text><aaif:lemma rdf:resource="https://gams.uni-graz.at/o:aaif.lemma#desfilar" /><aaif:position rdf:datatype="http://www.w3.org/2001/XMLSchema#int">1</aaif:position><aaif:coordinated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:coordinated><aaif:partOfText rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</aaif:partOfText><aaif:syntacticConstruction rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Intransitive" /></aaif:Verb><aaif:Adverb rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En1614Ph1Ad1"><aaif:text>lentísimos</aaif:text><aaif:lemma rdf:resource="https://gams.uni-graz.at/o:aaif.lemma#lento" /><aaif:position rdf:datatype="http://www.w3.org/2001/XMLSchema#int">2</aaif:position><aaif:coordinated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:coordinated><aaif:morphosyntacticStructure rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Adjective" /><aaif:inflection rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#MasculinePlural" /><aaif:attributionTarget rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Verb" /><aaif:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:modified><aaif:semanticClassification rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Manner" /><aaif:reduplicated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:reduplicated><aaif:prepositionalPhrase rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:prepositionalPhrase></aaif:Adverb><aaif:Entry rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En1615"><aaif:phrase rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh#En1615Ph1" /><aaif:source rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh.bibl#Cnde53" /><gams:textualContent>Impresionantes e impresionados de sí mismos, misteriosos, prestigiosos y prestigiándose  avanzan  lentos y graves por los pasillos de la Universidad con libros extraños bajo el brazo y quién sabe qué abrumadoras órdenes</gams:textualContent><rel:isPartOf rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh" /></aaif:Entry><aaif:Phrase rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En1615Ph1"><aaif:verb rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh#En1615Ph1Ve1" /><aaif:adverb rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh#En1615Ph1Ad1" /><aaif:adverb rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh#En1615Ph1Ad2" /><aaif:text> avanzan  lentos y graves por los pasillos</aaif:text><aaif:annoText> [v|avanzan|avanzar|is]  [a|lentos|lento|apsnmnnC] y [a|graves|grave|apsnmnnC] por los pasillos</aaif:annoText></aaif:Phrase><aaif:Verb rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En1615Ph1Ve1"><aaif:text>avanzan</aaif:text><aaif:lemma rdf:resource="https://gams.uni-graz.at/o:aaif.lemma#avanzar" /><aaif:position rdf:datatype="http://www.w3.org/2001/XMLSchema#int">1</aaif:position><aaif:coordinated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:coordinated><aaif:partOfText rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</aaif:partOfText><aaif:syntacticConstruction rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Intransitive" /></aaif:Verb><aaif:Adverb rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En1615Ph1Ad1"><aaif:text>lentos</aaif:text><aaif:lemma rdf:resource="https://gams.uni-graz.at/o:aaif.lemma#lento" /><aaif:position rdf:datatype="http://www.w3.org/2001/XMLSchema#int">2</aaif:position><aaif:coordinated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</aaif:coordinated><aaif:morphosyntacticStructure rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Adjective" /><aaif:inflection rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#MasculinePlural" /><aaif:attributionTarget rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Verb" /><aaif:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:modified><aaif:semanticClassification rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Manner" /><aaif:reduplicated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:reduplicated><aaif:prepositionalPhrase rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:prepositionalPhrase></aaif:Adverb><aaif:Adverb rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En1615Ph1Ad2"><aaif:text>graves</aaif:text><aaif:lemma rdf:resource="https://gams.uni-graz.at/o:aaif.lemma#grave" /><aaif:position rdf:datatype="http://www.w3.org/2001/XMLSchema#int">3</aaif:position><aaif:coordinated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</aaif:coordinated><aaif:morphosyntacticStructure rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Adjective" /><aaif:inflection rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#MasculinePlural" /><aaif:attributionTarget rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Verb" /><aaif:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:modified><aaif:semanticClassification rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Manner" /><aaif:reduplicated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:reduplicated><aaif:prepositionalPhrase rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:prepositionalPhrase></aaif:Adverb><aaif:Entry rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En1616"><aaif:phrase rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh#En1616Ph1" /><aaif:source rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh.bibl#Cnde54" /><gams:textualContent>brisa apacible estremecía las agujas de los pinos y los brotes menudos de las acacias. Las ranas  croaban , lentas , en el estanque.La criada había olvidado el libro de geografía de los niños al pie de</gams:textualContent><rel:isPartOf rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh" /></aaif:Entry><aaif:Phrase rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En1616Ph1"><aaif:subject rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh#En1616Ph1Su1" /><aaif:verb rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh#En1616Ph1Ve1" /><aaif:adverb rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh#En1616Ph1Ad1" /><aaif:text> Las ranas  croaban , lentas , en el estanque</aaif:text><aaif:annoText> [s|Las ranas|fp]  [v|croaban|croar|is] , [a|lentas|lento|axsnmnnn] , en el estanque</aaif:annoText></aaif:Phrase><aaif:Subject rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En1616Ph1Su1"><aaif:text>Las ranas</aaif:text><aaif:position rdf:datatype="http://www.w3.org/2001/XMLSchema#int">1</aaif:position><aaif:gender rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Feminine" /><aaif:number rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Plural" /><aaif:overt rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</aaif:overt></aaif:Subject><aaif:Verb rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En1616Ph1Ve1"><aaif:text>croaban</aaif:text><aaif:lemma rdf:resource="https://gams.uni-graz.at/o:aaif.lemma#croar" /><aaif:position rdf:datatype="http://www.w3.org/2001/XMLSchema#int">2</aaif:position><aaif:coordinated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:coordinated><aaif:partOfText rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</aaif:partOfText><aaif:syntacticConstruction rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Intransitive" /></aaif:Verb><aaif:Adverb rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En1616Ph1Ad1"><aaif:text>lentas</aaif:text><aaif:lemma rdf:resource="https://gams.uni-graz.at/o:aaif.lemma#lento" /><aaif:position rdf:datatype="http://www.w3.org/2001/XMLSchema#int">3</aaif:position><aaif:coordinated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:coordinated><aaif:morphosyntacticStructure rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Adjective" /><aaif:inflection rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#FemininePlural" /><aaif:attributionTarget rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Verb" /><aaif:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:modified><aaif:semanticClassification rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Manner" /><aaif:reduplicated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:reduplicated><aaif:prepositionalPhrase rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:prepositionalPhrase></aaif:Adverb><aaif:Entry rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En1617"><aaif:phrase rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh#En1617Ph1" /><aaif:source rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh.bibl#Cnde54" /><gams:textualContent>Interrumpiste unos momentos la lectura. El panorama  desfila lento , las colinas erosionadas y desnudas se suceden como en un paisaje lunar, la vegetación desmedra, el sol</gams:textualContent><rel:isPartOf rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh" /></aaif:Entry><aaif:Phrase rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En1617Ph1"><aaif:subject rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh#En1617Ph1Su1" /><aaif:verb rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh#En1617Ph1Ve1" /><aaif:adverb rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh#En1617Ph1Ad1" /><aaif:text> El panorama  desfila lento </aaif:text><aaif:annoText> [s|El panorama|ms]  [v|desfila|desfilar|is] [a|lento|lento|auvnmnnn] </aaif:annoText></aaif:Phrase><aaif:Subject rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En1617Ph1Su1"><aaif:text>El panorama</aaif:text><aaif:position rdf:datatype="http://www.w3.org/2001/XMLSchema#int">1</aaif:position><aaif:gender rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Masculine" /><aaif:number rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Singular" /><aaif:overt rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</aaif:overt></aaif:Subject><aaif:Verb rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En1617Ph1Ve1"><aaif:text>desfila</aaif:text><aaif:lemma rdf:resource="https://gams.uni-graz.at/o:aaif.lemma#desfilar" /><aaif:position rdf:datatype="http://www.w3.org/2001/XMLSchema#int">2</aaif:position><aaif:coordinated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:coordinated><aaif:partOfText rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</aaif:partOfText><aaif:syntacticConstruction rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Intransitive" /></aaif:Verb><aaif:Adverb rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En1617Ph1Ad1"><aaif:text>lento</aaif:text><aaif:lemma rdf:resource="https://gams.uni-graz.at/o:aaif.lemma#lento" /><aaif:position rdf:datatype="http://www.w3.org/2001/XMLSchema#int">3</aaif:position><aaif:coordinated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:coordinated><aaif:morphosyntacticStructure rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Adjective" /><aaif:inflection rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Uninflected" /><aaif:attributionTarget rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Verb" /><aaif:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:modified><aaif:semanticClassification rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Manner" /><aaif:reduplicated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:reduplicated><aaif:prepositionalPhrase rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:prepositionalPhrase></aaif:Adverb><aaif:Entry rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En1618"><aaif:phrase rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh#En1618Ph1" /><aaif:source rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh.bibl#Cnde55" /><gams:textualContent>los sorprendió; lo vieron destellar a lo lejos, en la cumbre de una colina, y lo vieron acercarse , lento , pesado , corpulento , con su cargamento de latas sujetas con sogas en la tolva.Un dinosaurio,</gams:textualContent><rel:isPartOf rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh" /></aaif:Entry><aaif:Phrase rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En1618Ph1"><aaif:verb rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh#En1618Ph1Ve1" /><aaif:adverb rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh#En1618Ph1Ad1" /><aaif:adverb rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh#En1618Ph1Ad2" /><aaif:adverb rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh#En1618Ph1Ad3" /><aaif:text>lo vieron acercarse , lento , pesado , corpulento ,</aaif:text><aaif:annoText>lo vieron [v|acercarse|acercar|rs] , [a|lento|lento|auvnmnnC] , [a|pesado|pesado|auvnmnnC] , [a|corpulento|corpulento|ausnmnnC] ,</aaif:annoText></aaif:Phrase><aaif:Verb rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En1618Ph1Ve1"><aaif:text>acercarse</aaif:text><aaif:lemma rdf:resource="https://gams.uni-graz.at/o:aaif.lemma#acercar" /><aaif:position rdf:datatype="http://www.w3.org/2001/XMLSchema#int">1</aaif:position><aaif:coordinated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:coordinated><aaif:partOfText rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</aaif:partOfText><aaif:syntacticConstruction rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Reflexive" /></aaif:Verb><aaif:Adverb rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En1618Ph1Ad1"><aaif:text>lento</aaif:text><aaif:lemma rdf:resource="https://gams.uni-graz.at/o:aaif.lemma#lento" /><aaif:position rdf:datatype="http://www.w3.org/2001/XMLSchema#int">2</aaif:position><aaif:coordinated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</aaif:coordinated><aaif:morphosyntacticStructure rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Adjective" /><aaif:inflection rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Uninflected" /><aaif:attributionTarget rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Verb" /><aaif:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:modified><aaif:semanticClassification rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Manner" /><aaif:reduplicated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:reduplicated><aaif:prepositionalPhrase rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:prepositionalPhrase></aaif:Adverb><aaif:Adverb rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En1618Ph1Ad2"><aaif:text>pesado</aaif:text><aaif:lemma rdf:resource="https://gams.uni-graz.at/o:aaif.lemma#pesado" /><aaif:position rdf:datatype="http://www.w3.org/2001/XMLSchema#int">3</aaif:position><aaif:coordinated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</aaif:coordinated><aaif:morphosyntacticStructure rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Adjective" /><aaif:inflection rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Uninflected" /><aaif:attributionTarget rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Verb" /><aaif:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:modified><aaif:semanticClassification rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Manner" /><aaif:reduplicated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:reduplicated><aaif:prepositionalPhrase rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:prepositionalPhrase></aaif:Adverb><aaif:Adverb rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En1618Ph1Ad3"><aaif:text>corpulento</aaif:text><aaif:lemma rdf:resource="https://gams.uni-graz.at/o:aaif.lemma#corpulento" /><aaif:position rdf:datatype="http://www.w3.org/2001/XMLSchema#int">4</aaif:position><aaif:coordinated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</aaif:coordinated><aaif:morphosyntacticStructure rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Adjective" /><aaif:inflection rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Uninflected" /><aaif:attributionTarget rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Verb" /><aaif:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:modified><aaif:semanticClassification rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Manner" /><aaif:reduplicated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:reduplicated><aaif:prepositionalPhrase rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:prepositionalPhrase></aaif:Adverb><aaif:Entry rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En1619"><aaif:phrase rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh#En1619Ph1" /><aaif:source rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh.bibl#Cnde56" /><gams:textualContent>bancos.Árboles muertos se retorcían en actitudes torturadas o grotescas envueltos en sudarios de lianas. El agua  refluía lenta hacia sus nacientes como se vuelve un hombre a sus recuerdos.El lamento del urutaú emergía del</gams:textualContent><rel:isPartOf rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh" /></aaif:Entry><aaif:Phrase rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En1619Ph1"><aaif:subject rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh#En1619Ph1Su1" /><aaif:verb rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh#En1619Ph1Ve1" /><aaif:adverb rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh#En1619Ph1Ad1" /><aaif:text> El agua  refluía lenta hacia sus nacientes</aaif:text><aaif:annoText> [s|El agua|fs]  [v|refluía|refluír|is] [a|lenta|lento|afsnmnnn] hacia sus nacientes</aaif:annoText></aaif:Phrase><aaif:Subject rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En1619Ph1Su1"><aaif:text>El agua</aaif:text><aaif:position rdf:datatype="http://www.w3.org/2001/XMLSchema#int">1</aaif:position><aaif:gender rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Feminine" /><aaif:number rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Singular" /><aaif:overt rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</aaif:overt></aaif:Subject><aaif:Verb rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En1619Ph1Ve1"><aaif:text>refluía</aaif:text><aaif:lemma rdf:resource="https://gams.uni-graz.at/o:aaif.lemma#refluír" /><aaif:position rdf:datatype="http://www.w3.org/2001/XMLSchema#int">2</aaif:position><aaif:coordinated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:coordinated><aaif:partOfText rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</aaif:partOfText><aaif:syntacticConstruction rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Intransitive" /></aaif:Verb><aaif:Adverb rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En1619Ph1Ad1"><aaif:text>lenta</aaif:text><aaif:lemma rdf:resource="https://gams.uni-graz.at/o:aaif.lemma#lento" /><aaif:position rdf:datatype="http://www.w3.org/2001/XMLSchema#int">3</aaif:position><aaif:coordinated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:coordinated><aaif:morphosyntacticStructure rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Adjective" /><aaif:inflection rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#FeminineSingular" /><aaif:attributionTarget rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Verb" /><aaif:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:modified><aaif:semanticClassification rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Manner" /><aaif:reduplicated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:reduplicated><aaif:prepositionalPhrase rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:prepositionalPhrase></aaif:Adverb><aaif:Entry rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En1620"><aaif:phrase rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh#En1620Ph1" /><aaif:source rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh.bibl#Cnde57" /><gams:textualContent>Allí están las criadas para llevarlo al atrio.»Las mendigas de los luises, que han aparecido lentas , desaparecen rápidas ;pero, más arriba, de las calles próximas salen nuevas caras, medias caras primero</gams:textualContent><rel:isPartOf rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh" /></aaif:Entry><aaif:Phrase rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En1620Ph1"><aaif:verb rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh#En1620Ph1Ve1" /><aaif:verb rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh#En1620Ph1Ve2" /><aaif:adverb rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh#En1620Ph1Ad1" /><aaif:adverb rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh#En1620Ph1Ad2" /><aaif:text>Las mendigas de los luises, que han aparecido lentas , desaparecen rápidas </aaif:text><aaif:annoText>Las mendigas de los luises, que [v|han aparecido|aparecer|is] [a|lentas|lento|axsnmnnn] , [v|desaparecen|desaparecer|is] [a|rápidas|rápido|axsnmnnn] </aaif:annoText></aaif:Phrase><aaif:Verb rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En1620Ph1Ve1"><aaif:text>han aparecido</aaif:text><aaif:lemma rdf:resource="https://gams.uni-graz.at/o:aaif.lemma#aparecer" /><aaif:position rdf:datatype="http://www.w3.org/2001/XMLSchema#int">1</aaif:position><aaif:coordinated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:coordinated><aaif:partOfText rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</aaif:partOfText><aaif:syntacticConstruction rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Intransitive" /></aaif:Verb><aaif:Verb rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En1620Ph1Ve2"><aaif:text>desaparecen</aaif:text><aaif:lemma rdf:resource="https://gams.uni-graz.at/o:aaif.lemma#desaparecer" /><aaif:position rdf:datatype="http://www.w3.org/2001/XMLSchema#int">3</aaif:position><aaif:coordinated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:coordinated><aaif:partOfText rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</aaif:partOfText><aaif:syntacticConstruction rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Intransitive" /></aaif:Verb><aaif:Adverb rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En1620Ph1Ad1"><aaif:text>lentas</aaif:text><aaif:lemma rdf:resource="https://gams.uni-graz.at/o:aaif.lemma#lento" /><aaif:position rdf:datatype="http://www.w3.org/2001/XMLSchema#int">2</aaif:position><aaif:coordinated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:coordinated><aaif:morphosyntacticStructure rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Adjective" /><aaif:inflection rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#FemininePlural" /><aaif:attributionTarget rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Verb" /><aaif:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:modified><aaif:semanticClassification rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Manner" /><aaif:reduplicated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:reduplicated><aaif:prepositionalPhrase rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:prepositionalPhrase></aaif:Adverb><aaif:Adverb rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En1620Ph1Ad2"><aaif:text>rápidas</aaif:text><aaif:lemma rdf:resource="https://gams.uni-graz.at/o:aaif.lemma#rápido" /><aaif:position rdf:datatype="http://www.w3.org/2001/XMLSchema#int">4</aaif:position><aaif:coordinated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:coordinated><aaif:morphosyntacticStructure rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Adjective" /><aaif:inflection rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#FemininePlural" /><aaif:attributionTarget rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Verb" /><aaif:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:modified><aaif:semanticClassification rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Manner" /><aaif:reduplicated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:reduplicated><aaif:prepositionalPhrase rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:prepositionalPhrase></aaif:Adverb><aaif:Entry rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En1621"><aaif:phrase rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh#En1621Ph1" /><aaif:source rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh.bibl#Cnde58" /><gams:textualContent>—  El estudio estadístico  va lento .</gams:textualContent><rel:isPartOf rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh" /></aaif:Entry><aaif:Phrase rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En1621Ph1"><aaif:subject rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh#En1621Ph1Su1" /><aaif:verb rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh#En1621Ph1Ve1" /><aaif:adverb rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh#En1621Ph1Ad1" /><aaif:text> El estudio estadístico  va lento .</aaif:text><aaif:annoText> [s|El estudio estadístico|ms]  [v|va|ir|is] [a|lento|lento|auvnmnnn] .</aaif:annoText></aaif:Phrase><aaif:Subject rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En1621Ph1Su1"><aaif:text>El estudio estadístico</aaif:text><aaif:position rdf:datatype="http://www.w3.org/2001/XMLSchema#int">1</aaif:position><aaif:gender rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Masculine" /><aaif:number rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Singular" /><aaif:overt rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</aaif:overt></aaif:Subject><aaif:Verb rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En1621Ph1Ve1"><aaif:text>va</aaif:text><aaif:lemma rdf:resource="https://gams.uni-graz.at/o:aaif.lemma#ir" /><aaif:position rdf:datatype="http://www.w3.org/2001/XMLSchema#int">2</aaif:position><aaif:coordinated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:coordinated><aaif:partOfText rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</aaif:partOfText><aaif:syntacticConstruction rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Intransitive" /></aaif:Verb><aaif:Adverb rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En1621Ph1Ad1"><aaif:text>lento</aaif:text><aaif:lemma rdf:resource="https://gams.uni-graz.at/o:aaif.lemma#lento" /><aaif:position rdf:datatype="http://www.w3.org/2001/XMLSchema#int">3</aaif:position><aaif:coordinated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:coordinated><aaif:morphosyntacticStructure rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Adjective" /><aaif:inflection rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Uninflected" /><aaif:attributionTarget rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Verb" /><aaif:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:modified><aaif:semanticClassification rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Manner" /><aaif:reduplicated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:reduplicated><aaif:prepositionalPhrase rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:prepositionalPhrase></aaif:Adverb><aaif:Entry rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En1622"><aaif:phrase rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh#En1622Ph1" /><aaif:source rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh.bibl#Cnde59" /><gams:textualContent>materiales de construcción mezclados con tierra y el agua de las cañerías rotas.Especie de lava incontenible. Avanzaba  lenta .Lo inundaba todo.Sin embargo, el ruido del taller proseguía, dominante.Otra vez las máquinas.</gams:textualContent><rel:isPartOf rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh" /></aaif:Entry><aaif:Phrase rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En1622Ph1"><aaif:verb rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh#En1622Ph1Ve1" /><aaif:adverb rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh#En1622Ph1Ad1" /><aaif:text> Avanzaba  lenta .</aaif:text><aaif:annoText> [v|Avanzaba|avanzar|is]  [a|lenta|lento|afvnmnnn] .</aaif:annoText></aaif:Phrase><aaif:Verb rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En1622Ph1Ve1"><aaif:text>Avanzaba</aaif:text><aaif:lemma rdf:resource="https://gams.uni-graz.at/o:aaif.lemma#avanzar" /><aaif:position rdf:datatype="http://www.w3.org/2001/XMLSchema#int">1</aaif:position><aaif:coordinated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:coordinated><aaif:partOfText rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</aaif:partOfText><aaif:syntacticConstruction rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Intransitive" /></aaif:Verb><aaif:Adverb rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En1622Ph1Ad1"><aaif:text>lenta</aaif:text><aaif:lemma rdf:resource="https://gams.uni-graz.at/o:aaif.lemma#lento" /><aaif:position rdf:datatype="http://www.w3.org/2001/XMLSchema#int">2</aaif:position><aaif:coordinated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:coordinated><aaif:morphosyntacticStructure rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Adjective" /><aaif:inflection rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#FeminineSingular" /><aaif:attributionTarget rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Verb" /><aaif:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:modified><aaif:semanticClassification rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Manner" /><aaif:reduplicated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:reduplicated><aaif:prepositionalPhrase rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:prepositionalPhrase></aaif:Adverb><aaif:Entry rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En1623"><aaif:phrase rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh#En1623Ph1" /><aaif:source rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh.bibl#Cnde58" /><gams:textualContent>después los neumáticos rebasarían la doble vía del funicular, en el cruce del camino forestal  caerían , lentos y preñados , los primeros copos .Y en Venecia brillaba el sol.</gams:textualContent><rel:isPartOf rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh" /></aaif:Entry><aaif:Phrase rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En1623Ph1"><aaif:subject rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh#En1623Ph1Su1" /><aaif:verb rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh#En1623Ph1Ve1" /><aaif:adverb rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh#En1623Ph1Ad1" /><aaif:adverb rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh#En1623Ph1Ad2" /><aaif:text> caerían , lentos y preñados , los primeros copos </aaif:text><aaif:annoText> [v|caerían|caer|is] , [a|lentos|lento|apsnmnnC] y [a|preñados|preñado|apsnmnnC] , [s|los primeros copos|mp] </aaif:annoText></aaif:Phrase><aaif:Subject rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En1623Ph1Su1"><aaif:text>los primeros copos</aaif:text><aaif:position rdf:datatype="http://www.w3.org/2001/XMLSchema#int">4</aaif:position><aaif:gender rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Masculine" /><aaif:number rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Plural" /><aaif:overt rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</aaif:overt></aaif:Subject><aaif:Verb rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En1623Ph1Ve1"><aaif:text>caerían</aaif:text><aaif:lemma rdf:resource="https://gams.uni-graz.at/o:aaif.lemma#caer" /><aaif:position rdf:datatype="http://www.w3.org/2001/XMLSchema#int">1</aaif:position><aaif:coordinated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:coordinated><aaif:partOfText rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</aaif:partOfText><aaif:syntacticConstruction rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Intransitive" /></aaif:Verb><aaif:Adverb rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En1623Ph1Ad1"><aaif:text>lentos</aaif:text><aaif:lemma rdf:resource="https://gams.uni-graz.at/o:aaif.lemma#lento" /><aaif:position rdf:datatype="http://www.w3.org/2001/XMLSchema#int">2</aaif:position><aaif:coordinated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</aaif:coordinated><aaif:morphosyntacticStructure rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Adjective" /><aaif:inflection rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#MasculinePlural" /><aaif:attributionTarget rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Verb" /><aaif:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:modified><aaif:semanticClassification rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Manner" /><aaif:reduplicated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:reduplicated><aaif:prepositionalPhrase rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:prepositionalPhrase></aaif:Adverb><aaif:Adverb rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En1623Ph1Ad2"><aaif:text>preñados</aaif:text><aaif:lemma rdf:resource="https://gams.uni-graz.at/o:aaif.lemma#preñado" /><aaif:position rdf:datatype="http://www.w3.org/2001/XMLSchema#int">3</aaif:position><aaif:coordinated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</aaif:coordinated><aaif:morphosyntacticStructure rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Adjective" /><aaif:inflection rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#MasculinePlural" /><aaif:attributionTarget rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Verb" /><aaif:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:modified><aaif:semanticClassification rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Manner" /><aaif:reduplicated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:reduplicated><aaif:prepositionalPhrase rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:prepositionalPhrase></aaif:Adverb><aaif:Entry rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En1624"><aaif:phrase rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh#En1624Ph1" /><aaif:source rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh.bibl#Cnde60" /><gams:textualContent>de colegio.Las muchachas miraban, confusas, a la madre arrodillada, al padre que avanzaba , lento , hierático , sumo sacerdote yendo al encuentro de la piedra de los sacrificios donde esperan el cuchillo y</gams:textualContent><rel:isPartOf rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh" /></aaif:Entry><aaif:Phrase rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En1624Ph1"><aaif:subject rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh#En1624Ph1Su1" /><aaif:verb rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh#En1624Ph1Ve1" /><aaif:adverb rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh#En1624Ph1Ad1" /><aaif:adverb rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh#En1624Ph1Ad2" /><aaif:text>al padre que avanzaba , lento , hierático ,</aaif:text><aaif:annoText>al [s|padre|ms] que [v|avanzaba|avanzar|is] , [a|lento|lento|auvnmnnC] , [a|hierático|hierático|ausnmnnC] ,</aaif:annoText></aaif:Phrase><aaif:Subject rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En1624Ph1Su1"><aaif:text>padre</aaif:text><aaif:position rdf:datatype="http://www.w3.org/2001/XMLSchema#int">1</aaif:position><aaif:gender rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Masculine" /><aaif:number rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Singular" /><aaif:overt rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</aaif:overt></aaif:Subject><aaif:Verb rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En1624Ph1Ve1"><aaif:text>avanzaba</aaif:text><aaif:lemma rdf:resource="https://gams.uni-graz.at/o:aaif.lemma#avanzar" /><aaif:position rdf:datatype="http://www.w3.org/2001/XMLSchema#int">2</aaif:position><aaif:coordinated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:coordinated><aaif:partOfText rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</aaif:partOfText><aaif:syntacticConstruction rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Intransitive" /></aaif:Verb><aaif:Adverb rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En1624Ph1Ad1"><aaif:text>lento</aaif:text><aaif:lemma rdf:resource="https://gams.uni-graz.at/o:aaif.lemma#lento" /><aaif:position rdf:datatype="http://www.w3.org/2001/XMLSchema#int">3</aaif:position><aaif:coordinated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</aaif:coordinated><aaif:morphosyntacticStructure rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Adjective" /><aaif:inflection rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Uninflected" /><aaif:attributionTarget rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Verb" /><aaif:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:modified><aaif:semanticClassification rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Manner" /><aaif:reduplicated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:reduplicated><aaif:prepositionalPhrase rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:prepositionalPhrase></aaif:Adverb><aaif:Adverb rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En1624Ph1Ad2"><aaif:text>hierático</aaif:text><aaif:lemma rdf:resource="https://gams.uni-graz.at/o:aaif.lemma#hierático" /><aaif:position rdf:datatype="http://www.w3.org/2001/XMLSchema#int">4</aaif:position><aaif:coordinated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</aaif:coordinated><aaif:morphosyntacticStructure rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Adjective" /><aaif:inflection rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Uninflected" /><aaif:attributionTarget rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Verb" /><aaif:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:modified><aaif:semanticClassification rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Manner" /><aaif:reduplicated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:reduplicated><aaif:prepositionalPhrase rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:prepositionalPhrase></aaif:Adverb><aaif:Entry rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En1625"><aaif:phrase rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh#En1625Ph1" /><aaif:source rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh.bibl#Cnde61" /><gams:textualContent>pies.Ríos de transpiración me resbalaban por el cuerpo desnudo.Me sequé la transpiración y me puse , lento , el pantalón y la camisa.</gams:textualContent><rel:isPartOf rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh" /></aaif:Entry><aaif:Phrase rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En1625Ph1"><aaif:verb rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh#En1625Ph1Ve1" /><aaif:adverb rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh#En1625Ph1Ad1" /><aaif:text>me puse , lento , el pantalón y la camisa</aaif:text><aaif:annoText>me [v|puse|poner|ts] , [a|lento|lento|auvnmnnn] , el pantalón y la camisa</aaif:annoText></aaif:Phrase><aaif:Verb rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En1625Ph1Ve1"><aaif:text>puse</aaif:text><aaif:lemma rdf:resource="https://gams.uni-graz.at/o:aaif.lemma#poner" /><aaif:position rdf:datatype="http://www.w3.org/2001/XMLSchema#int">1</aaif:position><aaif:coordinated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:coordinated><aaif:partOfText rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</aaif:partOfText><aaif:syntacticConstruction rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Transitive" /></aaif:Verb><aaif:Adverb rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En1625Ph1Ad1"><aaif:text>lento</aaif:text><aaif:lemma rdf:resource="https://gams.uni-graz.at/o:aaif.lemma#lento" /><aaif:position rdf:datatype="http://www.w3.org/2001/XMLSchema#int">2</aaif:position><aaif:coordinated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:coordinated><aaif:morphosyntacticStructure rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Adjective" /><aaif:inflection rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Uninflected" /><aaif:attributionTarget rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Verb" /><aaif:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:modified><aaif:semanticClassification rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Manner" /><aaif:reduplicated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:reduplicated><aaif:prepositionalPhrase rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:prepositionalPhrase></aaif:Adverb><aaif:Entry rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En1626"><aaif:phrase rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh#En1626Ph1" /><aaif:source rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh.bibl#Cnde61" /><gams:textualContent> Él  llenó , lento , el cheque.Lo firmó, lo sopló y se lo dio.</gams:textualContent><rel:isPartOf rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh" /></aaif:Entry><aaif:Phrase rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En1626Ph1"><aaif:subject rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh#En1626Ph1Su1" /><aaif:verb rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh#En1626Ph1Ve1" /><aaif:adverb rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh#En1626Ph1Ad1" /><aaif:text> Él  llenó , lento , el cheque.</aaif:text><aaif:annoText> [s|Él|ms]  [v|llenó|llenar|ts] , [a|lento|lento|auvnmnnn] , el cheque.</aaif:annoText></aaif:Phrase><aaif:Subject rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En1626Ph1Su1"><aaif:text>Él</aaif:text><aaif:position rdf:datatype="http://www.w3.org/2001/XMLSchema#int">1</aaif:position><aaif:gender rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Masculine" /><aaif:number rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Singular" /><aaif:overt rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</aaif:overt></aaif:Subject><aaif:Verb rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En1626Ph1Ve1"><aaif:text>llenó</aaif:text><aaif:lemma rdf:resource="https://gams.uni-graz.at/o:aaif.lemma#llenar" /><aaif:position rdf:datatype="http://www.w3.org/2001/XMLSchema#int">2</aaif:position><aaif:coordinated rdf:datatype="http://www.w3.org/2001/XMLSchema#