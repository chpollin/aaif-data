nn] </aaif:annoText></aaif:Phrase><aaif:Verb rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En2086Ph1Ve1"><aaif:text>Ciérrela</aaif:text><aaif:lemma rdf:resource="https://gams.uni-graz.at/o:aaif.lemma#cerrar" /><aaif:position rdf:datatype="http://www.w3.org/2001/XMLSchema#int">1</aaif:position><aaif:coordinated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:coordinated><aaif:partOfText rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</aaif:partOfText><aaif:syntacticConstruction rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Transitive" /></aaif:Verb><aaif:Adverb rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En2086Ph1Ad1"><aaif:text>rapidito</aaif:text><aaif:lemma rdf:resource="https://gams.uni-graz.at/o:aaif.lemma#rápido" /><aaif:position rdf:datatype="http://www.w3.org/2001/XMLSchema#int">2</aaif:position><aaif:coordinated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:coordinated><aaif:morphosyntacticStructure rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Adjective" /><aaif:inflection rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Uninflected" /><aaif:attributionTarget rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Verb" /><aaif:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:modified><aaif:semanticClassification rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Manner" /><aaif:reduplicated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:reduplicated><aaif:prepositionalPhrase rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:prepositionalPhrase></aaif:Adverb><aaif:Entry rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En2087"><aaif:phrase rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh#En2087Ph1" /><aaif:source rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh.bibl#Cnde79" /><gams:textualContent>— ¿Pero  regresamos  rápido ?</gams:textualContent><rel:isPartOf rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh" /></aaif:Entry><aaif:Phrase rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En2087Ph1"><aaif:verb rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh#En2087Ph1Ve1" /><aaif:adverb rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh#En2087Ph1Ad1" /><aaif:text> regresamos  rápido </aaif:text><aaif:annoText> [v|regresamos|regresar|is]  [a|rápido|rápido|auvnmnnn] </aaif:annoText></aaif:Phrase><aaif:Verb rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En2087Ph1Ve1"><aaif:text>regresamos</aaif:text><aaif:lemma rdf:resource="https://gams.uni-graz.at/o:aaif.lemma#regresar" /><aaif:position rdf:datatype="http://www.w3.org/2001/XMLSchema#int">1</aaif:position><aaif:coordinated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:coordinated><aaif:partOfText rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</aaif:partOfText><aaif:syntacticConstruction rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Intransitive" /></aaif:Verb><aaif:Adverb rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En2087Ph1Ad1"><aaif:text>rápido</aaif:text><aaif:lemma rdf:resource="https://gams.uni-graz.at/o:aaif.lemma#rápido" /><aaif:position rdf:datatype="http://www.w3.org/2001/XMLSchema#int">2</aaif:position><aaif:coordinated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:coordinated><aaif:morphosyntacticStructure rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Adjective" /><aaif:inflection rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Uninflected" /><aaif:attributionTarget rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Verb" /><aaif:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:modified><aaif:semanticClassification rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Manner" /><aaif:reduplicated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:reduplicated><aaif:prepositionalPhrase rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:prepositionalPhrase></aaif:Adverb><aaif:Entry rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En2088"><aaif:phrase rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh#En2088Ph1" /><aaif:source rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh.bibl#Cnde79" /><gams:textualContent> Caminaban  rápido  por unas calles angostas, empedradas.Rara vez pasaba un carro.Eran carros viejos, que avanzaban de milagro</gams:textualContent><rel:isPartOf rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh" /></aaif:Entry><aaif:Phrase rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En2088Ph1"><aaif:verb rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh#En2088Ph1Ve1" /><aaif:adverb rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh#En2088Ph1Ad1" /><aaif:text> Caminaban  rápido </aaif:text><aaif:annoText> [v|Caminaban|caminar|is]  [a|rápido|rápido|auvnmnnn] </aaif:annoText></aaif:Phrase><aaif:Verb rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En2088Ph1Ve1"><aaif:text>Caminaban</aaif:text><aaif:lemma rdf:resource="https://gams.uni-graz.at/o:aaif.lemma#caminar" /><aaif:position rdf:datatype="http://www.w3.org/2001/XMLSchema#int">1</aaif:position><aaif:coordinated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:coordinated><aaif:partOfText rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</aaif:partOfText><aaif:syntacticConstruction rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Intransitive" /></aaif:Verb><aaif:Adverb rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En2088Ph1Ad1"><aaif:text>rápido</aaif:text><aaif:lemma rdf:resource="https://gams.uni-graz.at/o:aaif.lemma#rápido" /><aaif:position rdf:datatype="http://www.w3.org/2001/XMLSchema#int">2</aaif:position><aaif:coordinated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:coordinated><aaif:morphosyntacticStructure rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Adjective" /><aaif:inflection rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Uninflected" /><aaif:attributionTarget rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Verb" /><aaif:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:modified><aaif:semanticClassification rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Manner" /><aaif:reduplicated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:reduplicated><aaif:prepositionalPhrase rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:prepositionalPhrase></aaif:Adverb><aaif:Entry rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En2089"><aaif:phrase rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh#En2089Ph1" /><aaif:source rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh.bibl#Cnde79" /><gams:textualContent>—  Pasa  rapidito  y cierra —le dijo Paloma.</gams:textualContent><rel:isPartOf rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh" /></aaif:Entry><aaif:Phrase rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En2089Ph1"><aaif:verb rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh#En2089Ph1Ve1" /><aaif:adverb rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh#En2089Ph1Ad1" /><aaif:text> Pasa  rapidito </aaif:text><aaif:annoText> [v|Pasa|pasar|is]  [a|rapidito|rápido|auvnmnnn] </aaif:annoText></aaif:Phrase><aaif:Verb rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En2089Ph1Ve1"><aaif:text>Pasa</aaif:text><aaif:lemma rdf:resource="https://gams.uni-graz.at/o:aaif.lemma#pasar" /><aaif:position rdf:datatype="http://www.w3.org/2001/XMLSchema#int">1</aaif:position><aaif:coordinated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:coordinated><aaif:partOfText rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</aaif:partOfText><aaif:syntacticConstruction rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Intransitive" /></aaif:Verb><aaif:Adverb rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En2089Ph1Ad1"><aaif:text>rapidito</aaif:text><aaif:lemma rdf:resource="https://gams.uni-gr