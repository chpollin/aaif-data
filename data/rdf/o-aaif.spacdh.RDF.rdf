<rdf:RDF xmlns:rdf="http://www.w3.org/1999/02/22-rdf-syntax-ns#" xmlns:dc="http://purl.org/dc/elements/1.1/" xmlns:functx="http://www.functx.com" xmlns:gn="http://www.geonames.org/ontology#" xmlns:dcterms="http://purl.org/dc/terms/" xmlns:gams="https://gams.uni-graz.at/o:gams-ontology/#" xmlns:skos="http://glossa.uni-graz.at/skos/scheme/o:oth/#" xmlns:t="http://www.tei-c.org/ns/1.0" xmlns:rdau="http://rdaregistry.info/Elements/u/" xmlns:aaif="https://gams.uni-graz.at/o:aaif.ontology#" xmlns:rel="http://gams.uni-graz.at#" xmlns:xd="http://www.oxygenxml.com/ns/doc/xsl"><rdf:Description rdf:about="https://gams.uni-graz.at/o:aaif.spacdh"><rel:isPartOf rdf:resource="https://gams.uni-graz.at/corpus:aaif.spacdh" /><dcterms:extent>79194</dcterms:extent></rdf:Description><aaif:Entry rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En4"><aaif:phrase rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh#En4Ph1" /><aaif:source rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh.bibl#Cnde539" /><gams:textualContent>que li dizién blasfemias e li dizién grant mal; &lt;lb/&gt;tornólis el depuerto en otro sobernal, &lt;lb/&gt;que non cantavan alto  nin cantavan tubal.&lt;lb/&gt;Vínolis sobrevienta, un espanto cabdal, &lt;lb/&gt;nin lis veno por armas nin por fuerça carnal,</gams:textualContent><rel:isPartOf rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh" /></aaif:Entry><aaif:Phrase rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En4Ph1"><aaif:verb rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh#En4Ph1Ve1" /><aaif:adverb rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh#En4Ph1Ad1" /><aaif:text>non cantavan alto </aaif:text><aaif:annoText>non [v|cantavan|cantar|is] [a|alto|alto|auvnmnnn] </aaif:annoText></aaif:Phrase><aaif:Verb rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En4Ph1Ve1"><aaif:text>cantavan</aaif:text><aaif:lemma rdf:resource="https://gams.uni-graz.at/o:aaif.lemma#cantar" /><aaif:position rdf:datatype="http://www.w3.org/2001/XMLSchema#int">1</aaif:position><aaif:coordinated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:coordinated><aaif:partOfText rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</aaif:partOfText><aaif:syntacticConstruction rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Intransitive" /></aaif:Verb><aaif:Adverb rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En4Ph1Ad1"><aaif:text>alto</aaif:text><aaif:lemma rdf:resource="https://gams.uni-graz.at/o:aaif.lemma#alto" /><aaif:position rdf:datatype="http://www.w3.org/2001/XMLSchema#int">2</aaif:position><aaif:coordinated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:coordinated><aaif:morphosyntacticStructure rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Adjective" /><aaif:inflection rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Uninflected" /><aaif:attributionTarget rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Verb" /><aaif:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:modified><aaif:semanticClassification rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Manner" /><aaif:reduplicated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:reduplicated><aaif:prepositionalPhrase rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:prepositionalPhrase></aaif:Adverb><aaif:Entry rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En5"><aaif:phrase rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh#En5Ph1" /><aaif:source rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh.bibl#Cnde503" /><gams:textualContent>si las fiere alguna de sus caças: e es que les corre sangre de las narizes, e    refuelgan alto  e muelen aýna so ceuo.</gams:textualContent><rel:isPartOf rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh" /></aaif:Entry><aaif:Phrase rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En5Ph1"><aaif:subject rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh#En5Ph1Su1" /><aaif:verb rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh#En5Ph1Ve1" /><aaif:adverb rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh#En5Ph1Ad1" /><aaif:text>   refuelgan alto </aaif:text><aaif:annoText> [s||up]  [v|refuelgan|refolgar|is] [a|alto|alto|auvnlnnn] </aaif:annoText></aaif:Phrase><aaif:Subject rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En5Ph1Su1"><aaif:position rdf:datatype="http://www.w3.org/2001/XMLSchema#int">1</aaif:position><aaif:gender rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Undefined" /><aaif:number rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Plural" /><aaif:overt rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:overt></aaif:Subject><aaif:Verb rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En5Ph1Ve1"><aaif:text>refuelgan</aaif:text><aaif:lemma rdf:resource="https://gams.uni-graz.at/o:aaif.lemma#refolgar" /><aaif:position rdf:datatype="http://www.w3.org/2001/XMLSchema#int">2</aaif:position><aaif:coordinated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:coordinated><aaif:partOfText rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</aaif:partOfText><aaif:syntacticConstruction rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Intransitive" /></aaif:Verb><aaif:Adverb rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En5Ph1Ad1"><aaif:text>alto</aaif:text><aaif:lemma rdf:resource="https://gams.uni-graz.at/o:aaif.lemma#alto" /><aaif:position rdf:datatype="http://www.w3.org/2001/XMLSchema#int">3</aaif:position><aaif:coordinated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:coordinated><aaif:morphosyntacticStructure rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Adjective" /><aaif:inflection rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Uninflected" /><aaif:attributionTarget rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Verb" /><aaif:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:modified><aaif:semanticClassification rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Location" /><aaif:reduplicated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:reduplicated><aaif:prepositionalPhrase rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:prepositionalPhrase></aaif:Adverb><aaif:Entry rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En6"><aaif:phrase rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh#En6Ph1" /><aaif:source rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh.bibl#Cnde540" /><gams:textualContent>las cosas e amuestra las colores dellas.Et demás, que por él buelan  las aues e andan altas contra el çielo.E a éste aorauan otra manera de gentes.Et ssu crençia era tal que maguer</gams:textualContent><rel:isPartOf rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh" /></aaif:Entry><aaif:Phrase rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En6Ph1"><aaif:subject rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh#En6Ph1Su1" /><aaif:verb rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh#En6Ph1Ve1" /><aaif:adverb rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh#En6Ph1Ad1" /><aaif:text> las aues e andan altas contra el çielo</aaif:text><aaif:annoText> [s|las aues|fp] e [v|andan|andar|is] [a|altas|alto|axsnlnnn] contra el çielo</aaif:annoText></aaif:Phrase><aaif:Subject rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En6Ph1Su1"><aaif:text>las aues</aaif:text><aaif:position rdf:datatype="http://www.w3.org/2001/XMLSchema#int">1</aaif:position><aaif:gender rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Feminine" /><aaif:number rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Plural" /><aaif:overt rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</aaif:overt></aaif:Subject><aaif:Verb rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En6Ph1Ve1"><aaif:text>andan</aaif:text><aaif:lemma rdf:resource="https://gams.uni-graz.at/o:aaif.lemma#andar" /><aaif:position rdf:datatype="http://www.w3.org/2001/XMLSchema#int">2</aaif:position><aaif:coordinated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:coordinated><aaif:partOfText rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</aaif:partOfText><aaif:syntacticConstruction rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Intransitive" /></aaif:Verb><aaif:Adverb rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En6Ph1Ad1"><aaif:text>altas</aaif:text><aaif:lemma rdf:resource="https://gams.uni-graz.at/o:aaif.lemma#alto" /><aaif:position rdf:datatype="http://www.w3.org/2001/XMLSchema#int">3</aaif:position><aaif:coordinated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:coordinated><aaif:morphosyntacticStructure rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Adjective" /><aaif:inflection rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#FemininePlural" /><aaif:attributionTarget rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Verb" /><aaif:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:modified><aaif:semanticClassification rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Location" /><aaif:reduplicated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:reduplicated><aaif:prepositionalPhrase rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:prepositionalPhrase></aaif:Adverb><aaif:Entry rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En7"><aaif:phrase rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh#En7Ph1" /><aaif:source rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh.bibl#Cnde541" /><gams:textualContent>ouidio menbrando se perdix quando era moço de como caye de alto.des que fue aue nunqua oso uolar alto  nin sobir a logar alto temiendo caer como quando cayo de la torre.</gams:textualContent><rel:isPartOf rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh" /></aaif:Entry><aaif:Phrase rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En7Ph1"><aaif:verb rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh#En7Ph1Ve1" /><aaif:adverb rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh#En7Ph1Ad1" /><aaif:text>oso uolar alto </aaif:text><aaif:annoText>oso [v|uolar|volar|is] [a|alto|alto|auvnlnnn] </aaif:annoText></aaif:Phrase><aaif:Verb rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En7Ph1Ve1"><aaif:text>uolar</aaif:text><aaif:lemma rdf:resource="https://gams.uni-graz.at/o:aaif.lemma#volar" /><aaif:position rdf:datatype="http://www.w3.org/2001/XMLSchema#int">1</aaif:position><aaif:coordinated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:coordinated><aaif:partOfText rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</aaif:partOfText><aaif:syntacticConstruction rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Intransitive" /></aaif:Verb><aaif:Adverb rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En7Ph1Ad1"><aaif:text>alto</aaif:text><aaif:lemma rdf:resource="https://gams.uni-graz.at/o:aaif.lemma#alto" /><aaif:position rdf:datatype="http://www.w3.org/2001/XMLSchema#int">2</aaif:position><aaif:coordinated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:coordinated><aaif:morphosyntacticStructure rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Adjective" /><aaif:inflection rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Uninflected" /><aaif:attributionTarget rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Verb" /><aaif:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:modified><aaif:semanticClassification rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Location" /><aaif:reduplicated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:reduplicated><aaif:prepositionalPhrase rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:prepositionalPhrase></aaif:Adverb><aaif:Entry rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En8"><aaif:phrase rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh#En8Ph1" /><aaif:source rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh.bibl#Cnde292" /><gams:textualContent>a ueer.&amp; pareciote luego como una ymagen grand.&amp; assi como era grand la ymagen.assi  yua  alto  el so estado .&amp; estaua contra ti.&amp; la su uista espantosa.&amp; aquella ymagen auie la</gams:textualContent><rel:isPartOf rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh" /></aaif:Entry><aaif:Phrase rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En8Ph1"><aaif:subject rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh#En8Ph1Su1" /><aaif:verb rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh#En8Ph1Ve1" /><aaif:adverb rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh#En8Ph1Ad1" /><aaif:text> yua  alto  el so estado </aaif:text><aaif:annoText> [v|yua|ir|is]  [a|alto|alto|auvnlnnn]  [s|el so estado|ms] </aaif:annoText></aaif:Phrase><aaif:Subject rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En8Ph1Su1"><aaif:text>el so estado</aaif:text><aaif:position rdf:datatype="http://www.w3.org/2001/XMLSchema#int">3</aaif:position><aaif:gender rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Masculine" /><aaif:number rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Singular" /><aaif:overt rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</aaif:overt></aaif:Subject><aaif:Verb rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En8Ph1Ve1"><aaif:text>yua</aaif:text><aaif:lemma rdf:resource="https://gams.uni-graz.at/o:aaif.lemma#ir" /><aaif:position rdf:datatype="http://www.w3.org/2001/XMLSchema#int">1</aaif:position><aaif:coordinated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:coordinated><aaif:partOfText rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</aaif:partOfText><aaif:syntacticConstruction rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Intransitive" /></aaif:Verb><aaif:Adverb rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En8Ph1Ad1"><aaif:text>alto</aaif:text><aaif:lemma rdf:resource="https://gams.uni-graz.at/o:aaif.lemma#alto" /><aaif:position rdf:datatype="http://www.w3.org/2001/XMLSchema#int">2</aaif:position><aaif:coordinated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:coordinated><aaif:morphosyntacticStructure rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Adjective" /><aaif:inflection rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Uninflected" /><aaif:attributionTarget rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Verb" /><aaif:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:modified><aaif:semanticClassification rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Location" /><aaif:reduplicated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:reduplicated><aaif:prepositionalPhrase rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:prepositionalPhrase></aaif:Adverb><aaif:Entry rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En9"><aaif:phrase rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh#En9Ph1" /><aaif:source rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh.bibl#Cnde193" /><gams:textualContent>siler &amp; el rrio matra &amp; donde el monte apennjno se alça de aquella parte con  vn espjnazo que va alto  vee omne de ally las tierras de gallia &amp; los montes de los alpes commo van de baxo en alto.</gams:textualContent><rel:isPartOf rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh" /></aaif:Entry><aaif:Phrase rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En9Ph1"><aaif:subject rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh#En9Ph1Su1" /><aaif:verb rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh#En9Ph1Ve1" /><aaif:adverb rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh#En9Ph1Ad1" /><aaif:text> vn espjnazo que va alto </aaif:text><aaif:annoText> [s|vn espjnazo|ms] que [v|va|ir|is] [a|alto|alto|auvnlnnn] </aaif:annoText></aaif:Phrase><aaif:Subject rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En9Ph1Su1"><aaif:text>vn espjnazo</aaif:text><aaif:position rdf:datatype="http://www.w3.org/2001/XMLSchema#int">1</aaif:position><aaif:gender rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Masculine" /><aaif:number rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Singular" /><aaif:overt rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</aaif:overt></aaif:Subject><aaif:Verb rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En9Ph1Ve1"><aaif:text>va</aaif:text><aaif:lemma rdf:resource="https://gams.uni-graz.at/o:aaif.lemma#ir" /><aaif:position rdf:datatype="http://www.w3.org/2001/XMLSchema#int">2</aaif:position><aaif:coordinated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:coordinated><aaif:partOfText rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</aaif:partOfText><aaif:syntacticConstruction rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Intransitive" /></aaif:Verb><aaif:Adverb rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En9Ph1Ad1"><aaif:text>alto</aaif:text><aaif:lemma rdf:resource="https://gams.uni-graz.at/o:aaif.lemma#alto" /><aaif:position rdf:datatype="http://www.w3.org/2001/XMLSchema#int">3</aaif:position><aaif:coordinated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:coordinated><aaif:morphosyntacticStructure rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Adjective" /><aaif:inflection rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Uninflected" /><aaif:attributionTarget rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Verb" /><aaif:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:modified><aaif:semanticClassification rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Location" /><aaif:reduplicated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:reduplicated><aaif:prepositionalPhrase rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:prepositionalPhrase></aaif:Adverb><aaif:Entry rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En10"><aaif:phrase rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh#En10Ph1" /><aaif:source rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh.bibl#Cnde193" /><gams:textualContent>que non era sinon  viento que querie salljr &amp; fazie finchar el seno de la tierra &amp; fazer lo alçar alto ally arriba commo venjen aquel estrumento &amp; aquellas torres encubierto.Et des que llegaron &amp; egualaron con las torres</gams:textualContent><rel:isPartOf rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh" /></aaif:Entry><aaif:Phrase rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En10Ph1"><aaif:subject rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh#En10Ph1Su1" /><aaif:verb rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh#En10Ph1Ve1" /><aaif:adverb rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh#En10Ph1Ad1" /><aaif:text> viento que querie salljr &amp; fazie finchar el seno de la tierra &amp; fazer lo alçar alto ally arriba</aaif:text><aaif:annoText> [s|viento|ms] que querie salljr &amp; fazie finchar el seno de la tierra &amp; fazer lo [v|alçar|alzar|ts] [a|alto|alto|auvnlnnn] ally arriba</aaif:annoText></aaif:Phrase><aaif:Subject rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En10Ph1Su1"><aaif:text>viento</aaif:text><aaif:position rdf:datatype="http://www.w3.org/2001/XMLSchema#int">1</aaif:position><aaif:gender rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Masculine" /><aaif:number rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Singular" /><aaif:overt rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</aaif:overt></aaif:Subject><aaif:Verb rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En10Ph1Ve1"><aaif:text>alçar</aaif:text><aaif:lemma rdf:resource="https://gams.uni-graz.at/o:aaif.lemma#alzar" /><aaif:position rdf:datatype="http://www.w3.org/2001/XMLSchema#int">2</aaif:position><aaif:coordinated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:coordinated><aaif:partOfText rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</aaif:partOfText><aaif:syntacticConstruction rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Transitive" /></aaif:Verb><aaif:Adverb rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En10Ph1Ad1"><aaif:text>alto</aaif:text><aaif:lemma rdf:resource="https://gams.uni-graz.at/o:aaif.lemma#alto" /><aaif:position rdf:datatype="http://www.w3.org/2001/XMLSchema#int">3</aaif:position><aaif:coordinated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:coordinated><aaif:morphosyntacticStructure rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Adjective" /><aaif:inflection rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Uninflected" /><aaif:attributionTarget rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Verb" /><aaif:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:modified><aaif:semanticClassification rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Location" /><aaif:reduplicated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:reduplicated><aaif:prepositionalPhrase rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:prepositionalPhrase></aaif:Adverb><aaif:Entry rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En11"><aaif:phrase rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh#En11Ph1" /><aaif:source rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh.bibl#Cnde193" /><gams:textualContent>todas las estrellas de la ossa mayor &amp; tuelle gele el alteza de la cabeça  deste monte tanto va alto .Et esta tierra de emaçia &amp; estos montes de que es çercada cuenta lucano en este logar segunt dizen</gams:textualContent><rel:isPartOf rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh" /></aaif:Entry><aaif:Phrase rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En11Ph1"><aaif:subject rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh#En11Ph1Su1" /><aaif:verb rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh#En11Ph1Ve1" /><aaif:adverb rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh#En11Ph1Ad1" /><aaif:text> deste monte tanto va alto </aaif:text><aaif:annoText> [s|deste monte|ms] tanto [v|va|ir|is] [a|alto|alto|auvnlnnn] </aaif:annoText></aaif:Phrase><aaif:Subject rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En11Ph1Su1"><aaif:text>deste monte</aaif:text><aaif:position rdf:datatype="http://www.w3.org/2001/XMLSchema#int">1</aaif:position><aaif:gender rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Masculine" /><aaif:number rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Singular" /><aaif:overt rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</aaif:overt></aaif:Subject><aaif:Verb rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En11Ph1Ve1"><aaif:text>va</aaif:text><aaif:lemma rdf:resource="https://gams.uni-graz.at/o:aaif.lemma#ir" /><aaif:position rdf:datatype="http://www.w3.org/2001/XMLSchema#int">2</aaif:position><aaif:coordinated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:coordinated><aaif:partOfText rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</aaif:partOfText><aaif:syntacticConstruction rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Intransitive" /></aaif:Verb><aaif:Adverb rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En11Ph1Ad1"><aaif:text>alto</aaif:text><aaif:lemma rdf:resource="https://gams.uni-graz.at/o:aaif.lemma#alto" /><aaif:position rdf:datatype="http://www.w3.org/2001/XMLSchema#int">3</aaif:position><aaif:coordinated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:coordinated><aaif:morphosyntacticStructure rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Adjective" /><aaif:inflection rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Uninflected" /><aaif:attributionTarget rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Verb" /><aaif:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:modified><aaif:semanticClassification rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Location" /><aaif:reduplicated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:reduplicated><aaif:prepositionalPhrase rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:prepositionalPhrase></aaif:Adverb><aaif:Entry rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En12"><aaif:phrase rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh#En12Ph1" /><aaif:source rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh.bibl#Cnde453" /><gams:textualContent>aforrasen; &lt;lb/&gt;mandó Doña Quaresma que a Carnal guardasen &lt;lb/&gt;e a Doña Çeçina con el Toçino colgasen.&lt;lb/&gt;Mandólos colgar altos , bien como atalaya, &lt;lb/&gt;e que a descolgallos ninguno ý non vaya; &lt;lb/&gt;luego los enforcaron de una viga</gams:textualContent><rel:isPartOf rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh" /></aaif:Entry><aaif:Phrase rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En12Ph1"><aaif:verb rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh#En12Ph1Ve1" /><aaif:adverb rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh#En12Ph1Ad1" /><aaif:text>Mandólos colgar altos </aaif:text><aaif:annoText>Mandólos [v|colgar|colgar|ts] [a|altos|alto|aponlnnn] </aaif:annoText></aaif:Phrase><aaif:Verb rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En12Ph1Ve1"><aaif:text>colgar</aaif:text><aaif:lemma rdf:resource="https://gams.uni-graz.at/o:aaif.lemma#colgar" /><aaif:position rdf:datatype="http://www.w3.org/2001/XMLSchema#int">1</aaif:position><aaif:coordinated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:coordinated><aaif:partOfText rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</aaif:partOfText><aaif:syntacticConstruction rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Transitive" /></aaif:Verb><aaif:Adverb rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En12Ph1Ad1"><aaif:text>altos</aaif:text><aaif:lemma rdf:resource="https://gams.uni-graz.at/o:aaif.lemma#alto" /><aaif:position rdf:datatype="http://www.w3.org/2001/XMLSchema#int">2</aaif:position><aaif:coordinated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:coordinated><aaif:morphosyntacticStructure rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Adjective" /><aaif:inflection rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#MasculinePlural" /><aaif:attributionTarget rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#VerbObject" /><aaif:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:modified><aaif:semanticClassification rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Location" /><aaif:reduplicated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:reduplicated><aaif:prepositionalPhrase rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:prepositionalPhrase></aaif:Adverb><aaif:Entry rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En13"><aaif:phrase rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh#En13Ph1" /><aaif:source rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh.bibl#Cnde455" /><gams:textualContent>e tal que nunca caya.&lt;lb/&gt;Buena es la mesura e el buen atenpramiento; &lt;lb/&gt;ca si uno subió alto , cayeron mas de çiento; &lt;lb/&gt;por ende en priuança, se guarde con buen tiento; &lt;lb/&gt;ca el amor de</gams:textualContent><rel:isPartOf rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh" /></aaif:Entry><aaif:Phrase rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En13Ph1"><aaif:subject rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh#En13Ph1Su1" /><aaif:verb rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh#En13Ph1Ve1" /><aaif:adverb rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh#En13Ph1Ad1" /><aaif:text>si uno subió alto </aaif:text><aaif:annoText>si [s|uno|ms] [v|subió|subir|is] [a|alto|alto|auvnlnnn] </aaif:annoText></aaif:Phrase><aaif:Subject rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En13Ph1Su1"><aaif:text>uno</aaif:text><aaif:position rdf:datatype="http://www.w3.org/2001/XMLSchema#int">1</aaif:position><aaif:gender rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Masculine" /><aaif:number rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Singular" /><aaif:overt rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</aaif:overt></aaif:Subject><aaif:Verb rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En13Ph1Ve1"><aaif:text>subió</aaif:text><aaif:lemma rdf:resource="https://gams.uni-graz.at/o:aaif.lemma#subir" /><aaif:position rdf:datatype="http://www.w3.org/2001/XMLSchema#int">2</aaif:position><aaif:coordinated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:coordinated><aaif:partOfText rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</aaif:partOfText><aaif:syntacticConstruction rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Intransitive" /></aaif:Verb><aaif:Adverb rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En13Ph1Ad1"><aaif:text>alto</aaif:text><aaif:lemma rdf:resource="https://gams.uni-graz.at/o:aaif.lemma#alto" /><aaif:position rdf:datatype="http://www.w3.org/2001/XMLSchema#int">3</aaif:position><aaif:coordinated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:coordinated><aaif:morphosyntacticStructure rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Adjective" /><aaif:inflection rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Uninflected" /><aaif:attributionTarget rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Verb" /><aaif:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:modified><aaif:semanticClassification rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Location" /><aaif:reduplicated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:reduplicated><aaif:prepositionalPhrase rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:prepositionalPhrase></aaif:Adverb><aaif:Entry rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En14"><aaif:phrase rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh#En14Ph1" /><aaif:source rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh.bibl#Cnde508" /><gams:textualContent>que uolarie ent'al cielo delant de todo hombre, e que mostrarie en si la diujnal magestat.E  diables  leuaronlo alto por el ayre, e Sant Pedro coniuro los diablos en nombre de Dios, Sant Paulo faziendo oracion, e lexaronlo</gams:textualContent><rel:isPartOf rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh" /></aaif:Entry><aaif:Phrase rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En14Ph1"><aaif:subject rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh#En14Ph1Su1" /><aaif:verb rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh#En14Ph1Ve1" /><aaif:adverb rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh#En14Ph1Ad1" /><aaif:text> diables  leuaronlo alto por el ayre</aaif:text><aaif:annoText> [s|diables|mp]  [v|leuaronlo|levar|ts] [a|alto|alto|auvnlnnn] por el ayre</aaif:annoText></aaif:Phrase><aaif:Subject rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En14Ph1Su1"><aaif:text>diables</aaif:text><aaif:position rdf:datatype="http://www.w3.org/2001/XMLSchema#int">1</aaif:position><aaif:gender rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Masculine" /><aaif:number rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Plural" /><aaif:overt rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</aaif:overt></aaif:Subject><aaif:Verb rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En14Ph1Ve1"><aaif:text>leuaronlo</aaif:text><aaif:lemma rdf:resource="https://gams.uni-graz.at/o:aaif.lemma#levar" /><aaif:position rdf:datatype="http://www.w3.org/2001/XMLSchema#int">2</aaif:position><aaif:coordinated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:coordinated><aaif:partOfText rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</aaif:partOfText><aaif:syntacticConstruction rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Transitive" /></aaif:Verb><aaif:Adverb rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En14Ph1Ad1"><aaif:text>alto</aaif:text><aaif:lemma rdf:resource="https://gams.uni-graz.at/o:aaif.lemma#alto" /><aaif:position rdf:datatype="http://www.w3.org/2001/XMLSchema#int">3</aaif:position><aaif:coordinated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:coordinated><aaif:morphosyntacticStructure rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Adjective" /><aaif:inflection rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Uninflected" /><aaif:attributionTarget rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Verb" /><aaif:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:modified><aaif:semanticClassification rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Location" /><aaif:reduplicated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:reduplicated><aaif:prepositionalPhrase rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:prepositionalPhrase></aaif:Adverb><aaif:Entry rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En15"><aaif:phrase rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh#En15Ph1" /><aaif:source rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh.bibl#Cnde508" /><gams:textualContent>cabeça, do era stado buytado el sancto olio, con la qual uapor ixio ensemble  una abella que uolo alto ent'al cielo.La qual cosa fue senyal de la felicidat e de la bienandança auenjdera.Apres de aquesto</gams:textualContent><rel:isPartOf rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh" /></aaif:Entry><aaif:Phrase rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En15Ph1"><aaif:subject rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh#En15Ph1Su1" /><aaif:verb rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh#En15Ph1Ve1" /><aaif:adverb rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh#En15Ph1Ad1" /><aaif:text> una abella que uolo alto ent'al cielo</aaif:text><aaif:annoText> [s|una abella|fs] que [v|uolo|volar|is] [a|alto|alto|auvnlnnn] ent'al cielo</aaif:annoText></aaif:Phrase><aaif:Subject rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En15Ph1Su1"><aaif:text>una abella</aaif:text><aaif:position rdf:datatype="http://www.w3.org/2001/XMLSchema#int">1</aaif:position><aaif:gender rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Feminine" /><aaif:number rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Singular" /><aaif:overt rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</aaif:overt></aaif:Subject><aaif:Verb rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En15Ph1Ve1"><aaif:text>uolo</aaif:text><aaif:lemma rdf:resource="https://gams.uni-graz.at/o:aaif.lemma#volar" /><aaif:position rdf:datatype="http://www.w3.org/2001/XMLSchema#int">2</aaif:position><aaif:coordinated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:coordinated><aaif:partOfText rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</aaif:partOfText><aaif:syntacticConstruction rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Intransitive" /></aaif:Verb><aaif:Adverb rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En15Ph1Ad1"><aaif:text>alto</aaif:text><aaif:lemma rdf:resource="https://gams.uni-graz.at/o:aaif.lemma#alto" /><aaif:position rdf:datatype="http://www.w3.org/2001/XMLSchema#int">3</aaif:position><aaif:coordinated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:coordinated><aaif:morphosyntacticStructure rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Adjective" /><aaif:inflection rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Uninflected" /><aaif:attributionTarget rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Verb" /><aaif:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:modified><aaif:semanticClassification rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Location" /><aaif:reduplicated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:reduplicated><aaif:prepositionalPhrase rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:prepositionalPhrase></aaif:Adverb><aaif:Entry rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En16"><aaif:phrase rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh#En16Ph1" /><aaif:source rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh.bibl#Cnde437" /><gams:textualContent>asy como el falcon tomar la garça alta en las nuves, perdida de vista, otrossy tomar la grua  yendo  alto por el ayre, e asi otras aves en mui estrañia manera, lo que nunca tomaran si non fuesse</gams:textualContent><rel:isPartOf rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh" /></aaif:Entry><aaif:Phrase rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En16Ph1"><aaif:verb rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh#En16Ph1Ve1" /><aaif:adverb rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh#En16Ph1Ad1" /><aaif:text> yendo  alto por el ayre</aaif:text><aaif:annoText> [v|yendo|ir|is]  [a|alto|alto|auvnlnnn] por el ayre</aaif:annoText></aaif:Phrase><aaif:Verb rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En16Ph1Ve1"><aaif:text>yendo</aaif:text><aaif:lemma rdf:resource="https://gams.uni-graz.at/o:aaif.lemma#ir" /><aaif:position rdf:datatype="http://www.w3.org/2001/XMLSchema#int">1</aaif:position><aaif:coordinated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:coordinated><aaif:partOfText rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</aaif:partOfText><aaif:syntacticConstruction rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Intransitive" /></aaif:Verb><aaif:Adverb rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En16Ph1Ad1"><aaif:text>alto</aaif:text><aaif:lemma rdf:resource="https://gams.uni-graz.at/o:aaif.lemma#alto" /><aaif:position rdf:datatype="http://www.w3.org/2001/XMLSchema#int">2</aaif:position><aaif:coordinated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:coordinated><aaif:morphosyntacticStructure rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Adjective" /><aaif:inflection rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Uninflected" /><aaif:attributionTarget rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Verb" /><aaif:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:modified><aaif:semanticClassification rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Location" /><aaif:reduplicated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:reduplicated><aaif:prepositionalPhrase rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:prepositionalPhrase></aaif:Adverb><aaif:Entry rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En17"><aaif:phrase rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh#En17Ph1" /><aaif:source rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh.bibl#Cnde437" /><gams:textualContent>E lo primero deveslos traer a que buelen picaça, ca de ally   toman a andar alto , e tenerse e guardar a ssu maestro e a la prision.E desque algunos dias bolare asy por</gams:textualContent><rel:isPartOf rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh" /></aaif:Entry><aaif:Phrase rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En17Ph1"><aaif:subject rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh#En17Ph1Su1" /><aaif:verb rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh#En17Ph1Ve1" /><aaif:adverb rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh#En17Ph1Ad1" /><aaif:text>  toman a andar alto </aaif:text><aaif:annoText> [s||mp] toman a [v|andar|andar|is] [a|alto|alto|auvnlnnn] </aaif:annoText></aaif:Phrase><aaif:Subject rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En17Ph1Su1"><aaif:position rdf:datatype="http://www.w3.org/2001/XMLSchema#int">1</aaif:position><aaif:gender rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Masculine" /><aaif:number rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Plural" /><aaif:overt rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:overt></aaif:Subject><aaif:Verb rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En17Ph1Ve1"><aaif:text>andar</aaif:text><aaif:lemma rdf:resource="https://gams.uni-graz.at/o:aaif.lemma#andar" /><aaif:position rdf:datatype="http://www.w3.org/2001/XMLSchema#int">2</aaif:position><aaif:coordinated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:coordinated><aaif:partOfText rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</aaif:partOfText><aaif:syntacticConstruction rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Intransitive" /></aaif:Verb><aaif:Adverb rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En17Ph1Ad1"><aaif:text>alto</aaif:text><aaif:lemma rdf:resource="https://gams.uni-graz.at/o:aaif.lemma#alto" /><aaif:position rdf:datatype="http://www.w3.org/2001/XMLSchema#int">3</aaif:position><aaif:coordinated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:coordinated><aaif:morphosyntacticStructure rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Adjective" /><aaif:inflection rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Uninflected" /><aaif:attributionTarget rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Verb" /><aaif:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:modified><aaif:semanticClassification rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Location" /><aaif:reduplicated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:reduplicated><aaif:prepositionalPhrase rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:prepositionalPhrase></aaif:Adverb><aaif:Entry rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En18"><aaif:phrase rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh#En18Ph1" /><aaif:source rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh.bibl#Cnde509" /><gams:textualContent>huessos en vna bella caxa et lieuanla a las cueuas que son en las montanyas, et alli  la cuelgan alto , que bestias saluages no y alcancen.</gams:textualContent><rel:isPartOf rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh" /></aaif:Entry><aaif:Phrase rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En18Ph1"><aaif:subject rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh#En18Ph1Su1" /><aaif:verb rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh#En18Ph1Ve1" /><aaif:adverb rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh#En18Ph1Ad1" /><aaif:text>alli  la cuelgan alto </aaif:text><aaif:annoText>alli [s||up] la [v|cuelgan|colgar|ts] [a|alto|alto|auvnlnnn] </aaif:annoText></aaif:Phrase><aaif:Subject rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En18Ph1Su1"><aaif:position rdf:datatype="http://www.w3.org/2001/XMLSchema#int">1</aaif:position><aaif:gender rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Undefined" /><aaif:number rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Plural" /><aaif:overt rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:overt></aaif:Subject><aaif:Verb rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En18Ph1Ve1"><aaif:text>cuelgan</aaif:text><aaif:lemma rdf:resource="https://gams.uni-graz.at/o:aaif.lemma#colgar" /><aaif:position rdf:datatype="http://www.w3.org/2001/XMLSchema#int">2</aaif:position><aaif:coordinated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:coordinated><aaif:partOfText rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</aaif:partOfText><aaif:syntacticConstruction rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Transitive" /></aaif:Verb><aaif:Adverb rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En18Ph1Ad1"><aaif:text>alto</aaif:text><aaif:lemma rdf:resource="https://gams.uni-graz.at/o:aaif.lemma#alto" /><aaif:position rdf:datatype="http://www.w3.org/2001/XMLSchema#int">3</aaif:position><aaif:coordinated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:coordinated><aaif:morphosyntacticStructure rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Adjective" /><aaif:inflection rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Uninflected" /><aaif:attributionTarget rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Verb" /><aaif:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:modified><aaif:semanticClassification rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Location" /><aaif:reduplicated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:reduplicated><aaif:prepositionalPhrase rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:prepositionalPhrase></aaif:Adverb><aaif:Entry rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En19"><aaif:phrase rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh#En19Ph1" /><aaif:source rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh.bibl#Cnde238" /><gams:textualContent>manera e por ésta, que nasçerás en oriente e ponerte has en ocçidente; e en el verano yrás alto e en el yvierno yrás baxo».E esso mysmo mandó a la luna e a las estrellas e</gams:textualContent><rel:isPartOf rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh" /></aaif:Entry><aaif:Phrase rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En19Ph1"><aaif:verb rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh#En19Ph1Ve1" /><aaif:adverb rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh#En19Ph1Ad1" /><aaif:text>en el verano yrás alto e en el yvierno yrás baxo</aaif:text><aaif:annoText>en el verano [v|yrás|ir|is] [a|alto|alto|auvnlnnn] e en el yvierno yrás baxo</aaif:annoText></aaif:Phrase><aaif:Verb rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En19Ph1Ve1"><aaif:text>yrás</aaif:text><aaif:lemma rdf:resource="https://gams.uni-graz.at/o:aaif.lemma#ir" /><aaif:position rdf:datatype="http://www.w3.org/2001/XMLSchema#int">1</aaif:position><aaif:coordinated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:coordinated><aaif:partOfText rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</aaif:partOfText><aaif:syntacticConstruction rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Intransitive" /></aaif:Verb><aaif:Adverb rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En19Ph1Ad1"><aaif:text>alto</aaif:text><aaif:lemma rdf:resource="https://gams.uni-graz.at/o:aaif.lemma#alto" /><aaif:position rdf:datatype="http://www.w3.org/2001/XMLSchema#int">2</aaif:position><aaif:coordinated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:coordinated><aaif:morphosyntacticStructure rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Adjective" /><aaif:inflection rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Uninflected" /><aaif:attributionTarget rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Verb" /><aaif:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:modified><aaif:semanticClassification rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Location" /><aaif:reduplicated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:reduplicated><aaif:prepositionalPhrase rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:prepositionalPhrase></aaif:Adverb><aaif:Entry rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En20"><aaif:phrase rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh#En20Ph1" /><aaif:source rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh.bibl#Cnde238" /><gams:textualContent>Dize: 'Las bestias se son corronpidas en su estiércol', e  el fedor  sube alto  e el podrimiento e corrupçión.</gams:textualContent><rel:isPartOf rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh" /></aaif:Entry><aaif:Phrase rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En20Ph1"><aaif:subject rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh#En20Ph1Su1" /><aaif:verb rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh#En20Ph1Ve1" /><aaif:adverb rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh#En20Ph1Ad1" /><aaif:text> el fedor  sube alto </aaif:text><aaif:annoText> [s|el fedor|ms]  [v|sube|subir|is] [a|alto|alto|auvnlnnn] </aaif:annoText></aaif:Phrase><aaif:Subject rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En20Ph1Su1"><aaif:text>el fedor</aaif:text><aaif:position rdf:datatype="http://www.w3.org/2001/XMLSchema#int">1</aaif:position><aaif:gender rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Masculine" /><aaif:number rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Singular" /><aaif:overt rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</aaif:overt></aaif:Subject><aaif:Verb rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En20Ph1Ve1"><aaif:text>sube</aaif:text><aaif:lemma rdf:resource="https://gams.uni-graz.at/o:aaif.lemma#subir" /><aaif:position rdf:datatype="http://www.w3.org/2001/XMLSchema#int">2</aaif:position><aaif:coordinated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:coordinated><aaif:partOfText rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</aaif:partOfText><aaif:syntacticConstruction rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Intransitive" /></aaif:Verb><aaif:Adverb rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En20Ph1Ad1"><aaif:text>alto</aaif:text><aaif:lemma rdf:resource="https://gams.uni-graz.at/o:aaif.lemma#alto" /><aaif:position rdf:datatype="http://www.w3.org/2001/XMLSchema#int">3</aaif:position><aaif:coordinated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:coordinated><aaif:morphosyntacticStructure rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Adjective" /><aaif:inflection rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Uninflected" /><aaif:attributionTarget rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Verb" /><aaif:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:modified><aaif:semanticClassification rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Location" /><aaif:reduplicated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:reduplicated><aaif:prepositionalPhrase rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:prepositionalPhrase></aaif:Adverb><aaif:Entry rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En21"><aaif:phrase rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh#En21Ph1" /><aaif:source rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh.bibl#Cnde238" /><gams:textualContent>se caerán de miedo del rroído del fuego, * e assí morrán.* Ca ssi  quisieren mirar alto , verán el fumo muy terrible e muy obscuro; e si quisieron mirar baxo, verán el fuego muy</gams:textualContent><rel:isPartOf rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh" /></aaif:Entry><aaif:Phrase rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En21Ph1"><aaif:subject rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh#En21Ph1Su1" /><aaif:verb rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh#En21Ph1Ve1" /><aaif:adverb rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh#En21Ph1Ad1" /><aaif:text>ssi  quisieren mirar alto </aaif:text><aaif:annoText>ssi [s||up] quisieren [v|mirar|mirar|is] [a|alto|alto|auvnlnnn] </aaif:annoText></aaif:Phrase><aaif:Subject rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En21Ph1Su1"><aaif:position rdf:datatype="http://www.w3.org/2001/XMLSchema#int">1</aaif:position><aaif:gender rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Undefined" /><aaif:number rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Plural" /><aaif:overt rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:overt></aaif:Subject><aaif:Verb rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En21Ph1Ve1"><aaif:text>mirar</aaif:text><aaif:lemma rdf:resource="https://gams.uni-graz.at/o:aaif.lemma#mirar" /><aaif:position rdf:datatype="http://www.w3.org/2001/XMLSchema#int">2</aaif:position><aaif:coordinated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:coordinated><aaif:partOfText rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</aaif:partOfText><aaif:syntacticConstruction rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Intransitive" /></aaif:Verb><aaif:Adverb rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En21Ph1Ad1"><aaif:text>alto</aaif:text><aaif:lemma rdf:resource="https://gams.uni-graz.at/o:aaif.lemma#alto" /><aaif:position rdf:datatype="http://www.w3.org/2001/XMLSchema#int">3</aaif:position><aaif:coordinated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:coordinated><aaif:morphosyntacticStructure rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Adjective" /><aaif:inflection rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Uninflected" /><aaif:attributionTarget rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Verb" /><aaif:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:modified><aaif:semanticClassification rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Location" /><aaif:reduplicated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:reduplicated><aaif:prepositionalPhrase rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:prepositionalPhrase></aaif:Adverb><aaif:Entry rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En22"><aaif:phrase rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh#En22Ph1" /><aaif:source rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh.bibl#Cnde238" /><gams:textualContent>E quando será levado delante Dios,  el pecador non osará mirar alto , sinon a tiera.E el ángel lo tomará por los cabellos, faziéndolo mirar alto arriba.E</gams:textualContent><rel:isPartOf rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh" /></aaif:Entry><aaif:Phrase rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En22Ph1"><aaif:subject rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh#En22Ph1Su1" /><aaif:verb rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh#En22Ph1Ve1" /><aaif:adverb rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh#En22Ph1Ad1" /><aaif:text> el pecador non osará mirar alto , sinon a tiera</aaif:text><aaif:annoText> [s|el pecador|ms] non osará [v|mirar|mirar|is] [a|alto|alto|auvnlnnn] , sinon a tiera</aaif:annoText></aaif:Phrase><aaif:Subject rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En22Ph1Su1"><aaif:text>el pecador</aaif:text><aaif:position rdf:datatype="http://www.w3.org/2001/XMLSchema#int">1</aaif:position><aaif:gender rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Masculine" /><aaif:number rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Singular" /><aaif:overt rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</aaif:overt></aaif:Subject><aaif:Verb rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En22Ph1Ve1"><aaif:text>mirar</aaif:text><aaif:lemma rdf:resource="https://gams.uni-graz.at/o:aaif.lemma#mirar" /><aaif:position rdf:datatype="http://www.w3.org/2001/XMLSchema#int">2</aaif:position><aaif:coordinated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:coordinated><aaif:partOfText rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</aaif:partOfText><aaif:syntacticConstruction rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Intransitive" /></aaif:Verb><aaif:Adverb rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En22Ph1Ad1"><aaif:text>alto</aaif:text><aaif:lemma rdf:resource="https://gams.uni-graz.at/o:aaif.lemma#alto" /><aaif:position rdf:datatype="http://www.w3.org/2001/XMLSchema#int">3</aaif:position><aaif:coordinated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:coordinated><aaif:morphosyntacticStructure rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Adjective" /><aaif:inflection rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Uninflected" /><aaif:attributionTarget rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Verb" /><aaif:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:modified><aaif:semanticClassification rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Location" /><aaif:reduplicated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:reduplicated><aaif:prepositionalPhrase rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:prepositionalPhrase></aaif:Adverb><aaif:Entry rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En23"><aaif:phrase rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh#En23Ph1" /><aaif:source rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh.bibl#Cnde543" /><gams:textualContent>que &lt;lb/&gt;* ençiende la estrella con llama sileta; *&lt;lb/&gt;por tanto conviene çerrar la buxeta *&lt;lb/&gt;e non fablar alto en son diuturno, *que para contar las estorias de Turno *non sabe ninguno esta arte muy neta</gams:textualContent><rel:isPartOf rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh" /></aaif:Entry><aaif:Phrase rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En23Ph1"><aaif:verb rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh#En23Ph1Ve1" /><aaif:adverb rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh#En23Ph1Ad1" /><aaif:text>conviene çerrar la buxeta *&lt;lb\/&gt;e non fablar alto en son diuturno</aaif:text><aaif:annoText>conviene çerrar la buxeta *&lt;lb\/&gt;e non [v|fablar|hablar|is] [a|alto|alto|auvnmnnn] en son diuturno</aaif:annoText></aaif:Phrase><aaif:Verb rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En23Ph1Ve1"><aaif:text>fablar</aaif:text><aaif:lemma rdf:resource="https://gams.uni-graz.at/o:aaif.lemma#hablar" /><aaif:position rdf:datatype="http://www.w3.org/2001/XMLSchema#int">1</aaif:position><aaif:coordinated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:coordinated><aaif:partOfText rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</aaif:partOfText><aaif:syntacticConstruction rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Intransitive" /></aaif:Verb><aaif:Adverb rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En23Ph1Ad1"><aaif:text>alto</aaif:text><aaif:lemma rdf:resource="https://gams.uni-graz.at/o:aaif.lemma#alto" /><aaif:position rdf:datatype="http://www.w3.org/2001/XMLSchema#int">2</aaif:position><aaif:coordinated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:coordinated><aaif:morphosyntacticStructure rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Adjective" /><aaif:inflection rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Uninflected" /><aaif:attributionTarget rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Verb" /><aaif:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:modified><aaif:semanticClassification rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Manner" /><aaif:reduplicated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:reduplicated><aaif:prepositionalPhrase rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:prepositionalPhrase></aaif:Adverb><aaif:Entry rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En24"><aaif:phrase rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh#En24Ph1" /><aaif:source rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh.bibl#Cnde124" /><gams:textualContent> (132 y 33) fiio de Yssay, (134) e dixo:  el varon que fue leuantado alto  Xpo. del Dios de Iacob, (135) e graçio so de los salmus de Israhel.</gams:textualContent><rel:isPartOf rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh" /></aaif:Entry><aaif:Phrase rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En24Ph1"><aaif:subject rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh#En24Ph1Su1" /><aaif:verb rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh#En24Ph1Ve1" /><aaif:adverb rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh#En24Ph1Ad1" /><aaif:text> el varon que fue leuantado alto </aaif:text><aaif:annoText> [s|el varon|ms] que fue [v|leuantado|levantar|ts] [a|alto|alto|auvnlnnn] </aaif:annoText></aaif:Phrase><aaif:Subject rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En24Ph1Su1"><aaif:text>el varon</aaif:text><aaif:position rdf:datatype="http://www.w3.org/2001/XMLSchema#int">1</aaif:position><aaif:gender rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Masculine" /><aaif:number rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Singular" /><aaif:overt rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</aaif:overt></aaif:Subject><aaif:Verb rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En24Ph1Ve1"><aaif:text>leuantado</aaif:text><aaif:lemma rdf:resource="https://gams.uni-graz.at/o:aaif.lemma#levantar" /><aaif:position rdf:datatype="http://www.w3.org/2001/XMLSchema#int">2</aaif:position><aaif:coordinated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:coordinated><aaif:partOfText rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</aaif:partOfText><aaif:syntacticConstruction rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Transitive" /></aaif:Verb><aaif:Adverb rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En24Ph1Ad1"><aaif:text>alto</aaif:text><aaif:lemma rdf:resource="https://gams.uni-graz.at/o:aaif.lemma#alto" /><aaif:position rdf:datatype="http://www.w3.org/2001/XMLSchema#int">3</aaif:position><aaif:coordinated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:coordinated><aaif:morphosyntacticStructure rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Adjective" /><aaif:inflection rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Uninflected" /><aaif:attributionTarget rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Verb" /><aaif:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:modified><aaif:semanticClassification rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Location" /><aaif:reduplicated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:reduplicated><aaif:prepositionalPhrase rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:prepositionalPhrase></aaif:Adverb><aaif:Entry rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En25"><aaif:phrase rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh#En25Ph1" /><aaif:source rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh.bibl#Cnde296" /><gams:textualContent>, e Ner fue padre de Chis, fijo de Abiel, el qual era Abner, e asy dize alta en otro testo: Avinier, fijo de Ner.</gams:textualContent><rel:isPartOf rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh" /></aaif:Entry><aaif:Phrase rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En25Ph1"><aaif:verb rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh#En25Ph1Ve1" /><aaif:adverb rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh#En25Ph1Ad1" /><aaif:text>asy dize alta en otro testo</aaif:text><aaif:annoText>asy [v|dize|decir|is] [a|alta|alto|afvnmnnn] en otro testo</aaif:annoText></aaif:Phrase><aaif:Verb rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En25Ph1Ve1"><aaif:text>dize</aaif:text><aaif:lemma rdf:resource="https://gams.uni-graz.at/o:aaif.lemma#decir" /><aaif:position rdf:datatype="http://www.w3.org/2001/XMLSchema#int">1</aaif:position><aaif:coordinated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:coordinated><aaif:partOfText rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</aaif:partOfText><aaif:syntacticConstruction rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Intransitive" /></aaif:Verb><aaif:Adverb rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En25Ph1Ad1"><aaif:text>alta</aaif:text><aaif:lemma rdf:resource="https://gams.uni-graz.at/o:aaif.lemma#alto" /><aaif:position rdf:datatype="http://www.w3.org/2001/XMLSchema#int">2</aaif:position><aaif:coordinated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:coordinated><aaif:morphosyntacticStructure rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Adjective" /><aaif:inflection rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#FeminineSingular" /><aaif:attributionTarget rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Verb" /><aaif:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:modified><aaif:semanticClassification rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Manner" /><aaif:reduplicated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:reduplicated><aaif:prepositionalPhrase rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:prepositionalPhrase></aaif:Adverb><aaif:Entry rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En26"><aaif:phrase rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh#En26Ph1" /><aaif:source rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh.bibl#Cnde544" /><gams:textualContent>clara lumbre al mi camino, y las sus comas servirán a las mis carreras, * y mirando alto le diré: «¡O luna blanca, seyme favorable!Que la ysla de Lepnos sea sojudgada a</gams:textualContent><rel:isPartOf rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh" /></aaif:Entry><aaif:Phrase rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En26Ph1"><aaif:verb rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh#En26Ph1Ve1" /><aaif:adverb rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh#En26Ph1Ad1" /><aaif:text>y mirando alto le diré</aaif:text><aaif:annoText>y [v|mirando|mirar|is] [a|alto|alto|auvnlnnn] le diré</aaif:annoText></aaif:Phrase><aaif:Verb rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En26Ph1Ve1"><aaif:text>mirando</aaif:text><aaif:lemma rdf:resource="https://gams.uni-graz.at/o:aaif.lemma#mirar" /><aaif:position rdf:datatype="http://www.w3.org/2001/XMLSchema#int">1</aaif:position><aaif:coordinated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:coordinated><aaif:partOfText rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</aaif:partOfText><aaif:syntacticConstruction rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Intransitive" /></aaif:Verb><aaif:Adverb rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En26Ph1Ad1"><aaif:text>alto</aaif:text><aaif:lemma rdf:resource="https://gams.uni-graz.at/o:aaif.lemma#alto" /><aaif:position rdf:datatype="http://www.w3.org/2001/XMLSchema#int">2</aaif:position><aaif:coordinated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:coordinated><aaif:morphosyntacticStructure rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Adjective" /><aaif:inflection rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Uninflected" /><aaif:attributionTarget rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Verb" /><aaif:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:modified><aaif:semanticClassification rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Location" /><aaif:reduplicated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:reduplicated><aaif:prepositionalPhrase rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:prepositionalPhrase></aaif:Adverb><aaif:Entry rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En27"><aaif:phrase rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh#En27Ph1" /><aaif:source rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh.bibl#Cnde513" /><gams:textualContent>E ante que cayese, tomólo por los lomos, las piernas arriba e la cabeça ayuso, e levantólo alto , e dio tal golpe con él en tierra que le quebró la çerviz, e murió luego allí.</gams:textualContent><rel:isPartOf rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh" /></aaif:Entry><aaif:Phrase rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En27Ph1"><aaif:verb rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh#En27Ph1Ve1" /><aaif:adverb rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh#En27Ph1Ad1" /><aaif:text>e levantólo alto </aaif:text><aaif:annoText>e [v|levantólo|levantar|ts] [a|alto|alto|auvnlnnn] </aaif:annoText></aaif:Phrase><aaif:Verb rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En27Ph1Ve1"><aaif:text>levantólo</aaif:text><aaif:lemma rdf:resource="https://gams.uni-graz.at/o:aaif.lemma#levantar" /><aaif:position rdf:datatype="http://www.w3.org/2001/XMLSchema#int">1</aaif:position><aaif:coordinated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:coordinated><aaif:partOfText rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</aaif:partOfText><aaif:syntacticConstruction rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Transitive" /></aaif:Verb><aaif:Adverb rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En27Ph1Ad1"><aaif:text>alto</aaif:text><aaif:lemma rdf:resource="https://gams.uni-graz.at/o:aaif.lemma#alto" /><aaif:position rdf:datatype="http://www.w3.org/2001/XMLSchema#int">2</aaif:position><aaif:coordinated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:coordinated><aaif:morphosyntacticStructure rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Adjective" /><aaif:inflection rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Uninflected" /><aaif:attributionTarget rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Verb" /><aaif:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:modified><aaif:semanticClassification rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Location" /><aaif:reduplicated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:reduplicated><aaif:prepositionalPhrase rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:prepositionalPhrase></aaif:Adverb><aaif:Entry rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En28"><aaif:phrase rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh#En28Ph1" /><aaif:source rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh.bibl#Cnde545" /><gams:textualContent> la postrimera parte de esa oraçión (que es «et ne nos inducas in tentacionen») sea dicha alto  porque todos respondan: «Set libera nos a malo</gams:textualContent><rel:isPartOf rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh" /></aaif:Entry><aaif:Phrase rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En28Ph1"><aaif:subject rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh#En28Ph1Su1" /><aaif:verb rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh#En28Ph1Ve1" /><aaif:adverb rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh#En28Ph1Ad1" /><aaif:text> la postrimera parte de esa oraçión (que es «et ne nos inducas in tentacionen») sea dicha alto </aaif:text><aaif:annoText> [s|la postrimera parte de esa oraçión|fs] (que es «et ne nos inducas in tentacionen») [v|sea dicha|decir|ts] [a|alto|alto|auvnmnnn] </aaif:annoText></aaif:Phrase><aaif:Subject rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En28Ph1Su1"><aaif:text>la postrimera parte de esa oraçión</aaif:text><aaif:position rdf:datatype="http://www.w3.org/2001/XMLSchema#int">1</aaif:position><aaif:gender rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Feminine" /><aaif:number rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Singular" /><aaif:overt rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</aaif:overt></aaif:Subject><aaif:Verb rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En28Ph1Ve1"><aaif:text>sea dicha</aaif:text><aaif:lemma rdf:resource="https://gams.uni-graz.at/o:aaif.lemma#decir" /><aaif:position rdf:datatype="http://www.w3.org/2001/XMLSchema#int">2</aaif:position><aaif:coordinated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:coordinated><aaif:partOfText rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</aaif:partOfText><aaif:syntacticConstruction rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Transitive" /></aaif:Verb><aaif:Adverb rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En28Ph1Ad1"><aaif:text>alto</aaif:text><aaif:lemma rdf:resource="https://gams.uni-graz.at/o:aaif.lemma#alto" /><aaif:position rdf:datatype="http://www.w3.org/2001/XMLSchema#int">3</aaif:position><aaif:coordinated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:coordinated><aaif:morphosyntacticStructure rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Adjective" /><aaif:inflection rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Uninflected" /><aaif:attributionTarget rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Verb" /><aaif:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:modified><aaif:semanticClassification rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Manner" /><aaif:reduplicated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:reduplicated><aaif:prepositionalPhrase rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:prepositionalPhrase></aaif:Adverb><aaif:Entry rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En29"><aaif:phrase rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh#En29Ph1" /><aaif:source rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh.bibl#Cnde546" /><gams:textualContent>nuevos modos!&lt;lb/&gt; Por fazer engaño a todos &lt;lb/&gt;tú te dexas engañar; &lt;lb/&gt;ayunas por no ayunar, &lt;lb/&gt;por sobir alto te omillas; &lt;lb/&gt;no pidiendo grandes sillas, &lt;lb/&gt;las demanda tu callar.&lt;lb/&gt;»Avnque con la cataduramansa tú</gams:textualContent><rel:isPartOf rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh" /></aaif:Entry><aaif:Phrase rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En29Ph1"><aaif:verb rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh#En29Ph1Ve1" /><aaif:adverb rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh#En29Ph1Ad1" /><aaif:text>por sobir alto te omillas</aaif:text><aaif:annoText>por [v|sobir|subir|is] [a|alto|alto|auvnlnnn] te omillas</aaif:annoText></aaif:Phrase><aaif:Verb rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En29Ph1Ve1"><aaif:text>sobir</aaif:text><aaif:lemma rdf:resource="https://gams.uni-graz.at/o:aaif.lemma#subir" /><aaif:position rdf:datatype="http://www.w3.org/2001/XMLSchema#int">1</aaif:position><aaif:coordinated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:coordinated><aaif:partOfText rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</aaif:partOfText><aaif:syntacticConstruction rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Intransitive" /></aaif:Verb><aaif:Adverb rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En29Ph1Ad1"><aaif:text>alto</aaif:text><aaif:lemma rdf:resource="https://gams.uni-graz.at/o:aaif.lemma#alto" /><aaif:position rdf:datatype="http://www.w3.org/2001/XMLSchema#int">2</aaif:position><aaif:coordinated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:coordinated><aaif:morphosyntacticStructure rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Adjective" /><aaif:inflection rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Uninflected" /><aaif:attributionTarget rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Verb" /><aaif:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:modified><aaif:semanticClassification rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Location" /><aaif:reduplicated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:reduplicated><aaif:prepositionalPhrase rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:prepositionalPhrase></aaif:Adverb><aaif:Entry rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En30"><aaif:phrase rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh#En30Ph1" /><aaif:source rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh.bibl#Cnde547" /><gams:textualContent>quanto yo cuento.E quando  el rey oyo que tantos eran muertos, abaxo la cabeca, e dixo alto , que todos lo oyeron: «¡O Galuan!¡maldito tu seas, que todos estos hombres</gams:textualContent><rel:isPartOf rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh" /></aaif:Entry><aaif:Phrase rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En30Ph1"><aaif:subject rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh#En30Ph1Su1" /><aaif:verb rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh#En30Ph1Ve1" /><aaif:adverb rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh#En30Ph1Ad1" /><aaif:text> el rey oyo que tantos eran muertos, abaxo la cabeca, e dixo alto , que todos lo oyeron</aaif:text><aaif:annoText> [s|el rey|ms] oyo que tantos eran muertos, abaxo la cabeca, e [v|dixo|decir|ts] [a|alto|alto|auvnmnnn] , que todos lo oyeron</aaif:annoText></aaif:Phrase><aaif:Subject rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En30Ph1Su1"><aaif:text>el rey</aaif:text><aaif:position rdf:datatype="http://www.w3.org/2001/XMLSchema#int">1</aaif:position><aaif:gender rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Masculine" /><aaif:number rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Singular" /><aaif:overt rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</aaif:overt></aaif:Subject><aaif:Verb rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En30Ph1Ve1"><aaif:text>dixo</aaif:text><aaif:lemma rdf:resource="https://gams.uni-graz.at/o:aaif.lemma#decir" /><aaif:position rdf:datatype="http://www.w3.org/2001/XMLSchema#int">2</aaif:position><aaif:coordinated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:coordinated><aaif:partOfText rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</aaif:partOfText><aaif:syntacticConstruction rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Transitive" /></aaif:Verb><aaif:Adverb rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En30Ph1Ad1"><aaif:text>alto</aaif:text><aaif:lemma rdf:resource="https://gams.uni-graz.at/o:aaif.lemma#alto" /><aaif:position rdf:datatype="http://www.w3.org/2001/XMLSchema#int">3</aaif:position><aaif:coordinated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:coordinated><aaif:morphosyntacticStructure rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Adjective" /><aaif:inflection rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Uninflected" /><aaif:attributionTarget rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Verb" /><aaif:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:modified><aaif:semanticClassification rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Manner" /><aaif:reduplicated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:reduplicated><aaif:prepositionalPhrase rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:prepositionalPhrase></aaif:Adverb><aaif:Entry rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En31"><aaif:phrase rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh#En31Ph1" /><aaif:source rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh.bibl#Cnde547" /><gams:textualContent>dezian nada; y  el rey estaua encima del palacio; e pues estuuo assi vna gran pieça, dixo alto , que todos lo oyeron: «¡Que luengo tienpo me sofristes, e me mantuuistes en gran honrra</gams:textualContent><rel:isPartOf rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh" /></aaif:Entry><aaif:Phrase rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En31Ph1"><aaif:subject rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh#En31Ph1Su1" /><aaif:verb rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh#En31Ph1Ve1" /><aaif:adverb rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh#En31Ph1Ad1" /><aaif:text> el rey estaua encima del palacio; e pues estuuo assi vna gran pieça, dixo alto </aaif:text><aaif:annoText> [s|el rey|ms] estaua encima del palacio; e pues estuuo assi vna gran pieça, [v|dixo|decir|ts] [a|alto|alto|auvnmnnn] </aaif:annoText></aaif:Phrase><aaif:Subject rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En31Ph1Su1"><aaif:text>el rey</aaif:text><aaif:position rdf:datatype="http://www.w3.org/2001/XMLSchema#int">1</aaif:position><aaif:gender rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Masculine" /><aaif:number rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Singular" /><aaif:overt rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</aaif:overt></aaif:Subject><aaif:Verb rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En31Ph1Ve1"><aaif:text>dixo</aaif:text><aaif:lemma rdf:resource="https://gams.uni-graz.at/o:aaif.lemma#decir" /><aaif:position rdf:datatype="http://www.w3.org/2001/XMLSchema#int">2</aaif:position><aaif:coordinated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:coordinated><aaif:partOfText rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</aaif:partOfText><aaif:syntacticConstruction rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Transitive" /></aaif:Verb><aaif:Adverb rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En31Ph1Ad1"><aaif:text>alto</aaif:text><aaif:lemma rdf:resource="https://gams.uni-graz.at/o:aaif.lemma#alto" /><aaif:position rdf:datatype="http://www.w3.org/2001/XMLSchema#int">3</aaif:position><aaif:coordinated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:coordinated><aaif:morphosyntacticStructure rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Adjective" /><aaif:inflection rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Uninflected" /><aaif:attributionTarget rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Verb" /><aaif:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:modified><aaif:semanticClassification rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Manner" /><aaif:reduplicated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:reduplicated><aaif:prepositionalPhrase rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:prepositionalPhrase></aaif:Adverb><aaif:Entry rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En32"><aaif:phrase rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh#En32Ph1" /><aaif:source rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh.bibl#Cnde91" /><gams:textualContent>CALISTO.¿No te digo que hables alto  cuando hablares?¿Qué dices?</gams:textualContent><rel:isPartOf rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh" /></aaif:Entry><aaif:Phrase rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En32Ph1"><aaif:verb rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh#En32Ph1Ve1" /><aaif:adverb rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh#En32Ph1Ad1" /><aaif:text>te digo que hables alto </aaif:text><aaif:annoText>te digo que [v|hables|hablar|is] [a|alto|alto|auvnmnnn] </aaif:annoText></aaif:Phrase><aaif:Verb rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En32Ph1Ve1"><aaif:text>hables</aaif:text><aaif:lemma rdf:resource="https://gams.uni-graz.at/o:aaif.lemma#hablar" /><aaif:position rdf:datatype="http://www.w3.org/2001/XMLSchema#int">1</aaif:position><aaif:coordinated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:coordinated><aaif:partOfText rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</aaif:partOfText><aaif:syntacticConstruction rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Intransitive" /></aaif:Verb><aaif:Adverb rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En32Ph1Ad1"><aaif:text>alto</aaif:text><aaif:lemma rdf:resource="https://gams.uni-graz.at/o:aaif.lemma#alto" /><aaif:position rdf:datatype="http://www.w3.org/2001/XMLSchema#int">2</aaif:position><aaif:coordinated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:coordinated><aaif:morphosyntacticStructure rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Adjective" /><aaif:inflection rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Uninflected" /><aaif:attributionTarget rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Verb" /><aaif:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:modified><aaif:semanticClassification rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Manner" /><aaif:reduplicated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:reduplicated><aaif:prepositionalPhrase rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:prepositionalPhrase></aaif:Adverb><aaif:Entry rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En33"><aaif:phrase rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh#En33Ph1" /><aaif:source rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh.bibl#Cnde548" /><gams:textualContent>Galterio.Acércate más, Menedemo, porque hablando alto darás ocasión que estos negocios sean más públicos de lo que son.</gams:textualContent><rel:isPartOf rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh" /></aaif:Entry><aaif:Phrase rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En33Ph1"><aaif:verb rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh#En33Ph1Ve1" /><aaif:adverb rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh#En33Ph1Ad1" /><aaif:text>porque hablando alto darás ocasión que estos negocios sean más públicos</aaif:text><aaif:annoText>porque [v|hablando|hablar|is] [a|alto|alto|auvnmnnn] darás ocasión que estos negocios sean más públicos</aaif:annoText></aaif:Phrase><aaif:Verb rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En33Ph1Ve1"><aaif:text>hablando</aaif:text><aaif:lemma rdf:resource="https://gams.uni-graz.at/o:aaif.lemma#hablar" /><aaif:position rdf:datatype="http://www.w3.org/2001/XMLSchema#int">1</aaif:position><aaif:coordinated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:coordinated><aaif:partOfText rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</aaif:partOfText><aaif:syntacticConstruction rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Intransitive" /></aaif:Verb><aaif:Adverb rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En33Ph1Ad1"><aaif:text>alto</aaif:text><aaif:lemma rdf:resource="https://gams.uni-graz.at/o:aaif.lemma#alto" /><aaif:position rdf:datatype="http://www.w3.org/2001/XMLSchema#int">2</aaif:position><aaif:coordinated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:coordinated><aaif:morphosyntacticStructure rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Adjective" /><aaif:inflection rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Uninflected" /><aaif:attributionTarget rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Verb" /><aaif:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:modified><aaif:semanticClassification rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Manner" /><aaif:reduplicated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:reduplicated><aaif:prepositionalPhrase rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:prepositionalPhrase></aaif:Adverb><aaif:Entry rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En34"><aaif:phrase rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh#En34Ph1" /><aaif:source rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh.bibl#Cnde305" /><gams:textualContent>Lavandera  Hábleme  alto , que me duele este oído. &lt;lb/&gt;Lozana Digo que si laváis a españoles solamente.</gams:textualContent><rel:isPartOf rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh" /></aaif:Entry><aaif:Phrase rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En34Ph1"><aaif:verb rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh#En34Ph1Ve1" /><aaif:adverb rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh#En34Ph1Ad1" /><aaif:text> Hábleme  alto , que me duele este oído</aaif:text><aaif:annoText> [v|Hábleme|hablar|is]  [a|alto|alto|auvnmnnn] , que me duele este oído</aaif:annoText></aaif:Phrase><aaif:Verb rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En34Ph1Ve1"><aaif:text>Hábleme</aaif:text><aaif:lemma rdf:resource="https://gams.uni-graz.at/o:aaif.lemma#hablar" /><aaif:position rdf:datatype="http://www.w3.org/2001/XMLSchema#int">1</aaif:position><aaif:coordinated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:coordinated><aaif:partOfText rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</aaif:partOfText><aaif:syntacticConstruction rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Intransitive" /></aaif:Verb><aaif:Adverb rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En34Ph1Ad1"><aaif:text>alto</aaif:text><aaif:lemma rdf:resource="https://gams.uni-graz.at/o:aaif.lemma#alto" /><aaif:position rdf:datatype="http://www.w3.org/2001/XMLSchema#int">2</aaif:position><aaif:coordinated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:coordinated><aaif:morphosyntacticStructure rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Adjective" /><aaif:inflection rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Uninflected" /><aaif:attributionTarget rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Verb" /><aaif:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:modified><aaif:semanticClassification rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Manner" /><aaif:reduplicated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:reduplicated><aaif:prepositionalPhrase rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:prepositionalPhrase></aaif:Adverb><aaif:Entry rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En35"><aaif:phrase rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh#En35Ph1" /><aaif:source rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh.bibl#Cnde549" /><gams:textualContent>Carón.¿Por qué no lo dirás alto ?</gams:textualContent><rel:isPartOf rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh" /></aaif:Entry><aaif:Phrase rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En35Ph1"><aaif:verb rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh#En35Ph1Ve1" /><aaif:adverb rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh#En35Ph1Ad1" /><aaif:text>¿Por qué no lo dirás alto ?</aaif:text><aaif:annoText>¿Por qué no lo [v|dirás|decir|ts] [a|alto|alto|auvnmnnn] ?</aaif:annoText></aaif:Phrase><aaif:Verb rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En35Ph1Ve1"><aaif:text>dirás</aaif:text><aaif:lemma rdf:resource="https://gams.uni-graz.at/o:aaif.lemma#decir" /><aaif:position rdf:datatype="http://www.w3.org/2001/XMLSchema#int">1</aaif:position><aaif:coordinated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:coordinated><aaif:partOfText rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</aaif:partOfText><aaif:syntacticConstruction rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Transitive" /></aaif:Verb><aaif:Adverb rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En35Ph1Ad1"><aaif:text>alto</aaif:text><aaif:lemma rdf:resource="https://gams.uni-graz.at/o:aaif.lemma#alto" /><aaif:position rdf:datatype="http://www.w3.org/2001/XMLSchema#int">2</aaif:position><aaif:coordinated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:coordinated><aaif:morphosyntacticStructure rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Adjective" /><aaif:inflection rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Uninflected" /><aaif:attributionTarget rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Verb" /><aaif:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:modified><aaif:semanticClassification rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Manner" /><aaif:reduplicated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:reduplicated><aaif:prepositionalPhrase rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:prepositionalPhrase></aaif:Adverb><aaif:Entry rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En36"><aaif:phrase rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh#En36Ph1" /><aaif:source rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh.bibl#Cnde183" /><gams:textualContent>la hermosura de una mujer, comenzó a replicar;pero en esto oyeron un gran estruendo y un hablar alto de muchos que venían y así, mirando todos hacia la puerta de la sala donde estaban, vieron muchas</gams:textualContent><rel:isPartOf rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh" /></aaif:Entry><aaif:Phrase rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En36Ph1"><aaif:verb rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh#En36Ph1Ve1" /><aaif:adverb rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh#En36Ph1Ad1" /><aaif:text>oyeron un gran estruendo y un hablar alto de muchos</aaif:text><aaif:annoText>oyeron un gran estruendo y un [v|hablar|hablar|is] [a|alto|alto|auvnmnnn] de muchos</aaif:annoText></aaif:Phrase><aaif:Verb rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En36Ph1Ve1"><aaif:text>hablar</aaif:text><aaif:lemma rdf:resource="https://gams.uni-graz.at/o:aaif.lemma#hablar" /><aaif:position rdf:datatype="http://www.w3.org/2001/XMLSchema#int">1</aaif:position><aaif:coordinated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:coordinated><aaif:partOfText rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</aaif:partOfText><aaif:syntacticConstruction rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Intransitive" /></aaif:Verb><aaif:Adverb rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En36Ph1Ad1"><aaif:text>alto</aaif:text><aaif:lemma rdf:resource="https://gams.uni-graz.at/o:aaif.lemma#alto" /><aaif:position rdf:datatype="http://www.w3.org/2001/XMLSchema#int">2</aaif:position><aaif:coordinated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:coordinated><aaif:morphosyntacticStructure rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Adjective" /><aaif:inflection rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Uninflected" /><aaif:attributionTarget rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Verb" /><aaif:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:modified><aaif:semanticClassification rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Manner" /><aaif:reduplicated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:reduplicated><aaif:prepositionalPhrase rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:prepositionalPhrase></aaif:Adverb><aaif:Entry rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En37"><aaif:phrase rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh#En37Ph1" /><aaif:source rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh.bibl#Cnde183" /><gams:textualContent>habiéndose los unos y los otros conocido, después de haberse hecho algunas señas,  los moscovitas comenzaron a hablar alto  diciendo el precio que querían por sus martas; pero tan estremo era el frío que era imposible ser entendidos</gams:textualContent><rel:isPartOf rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh" /></aaif:Entry><aaif:Phrase rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En37Ph1"><aaif:subject rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh#En37Ph1Su1" /><aaif:verb rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh#En37Ph1Ve1" /><aaif:adverb rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh#En37Ph1Ad1" /><aaif:text> los moscovitas comenzaron a hablar alto </aaif:text><aaif:annoText> [s|los moscovitas|mp] comenzaron a [v|hablar|hablar|is] [a|alto|alto|auvnmnnn] </aaif:annoText></aaif:Phrase><aaif:Subject rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En37Ph1Su1"><aaif:text>los moscovitas</aaif:text><aaif:position rdf:datatype="http://www.w3.org/2001/XMLSchema#int">1</aaif:position><aaif:gender rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Masculine" /><aaif:number rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Plural" /><aaif:overt rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</aaif:overt></aaif:Subject><aaif:Verb rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En37Ph1Ve1"><aaif:text>hablar</aaif:text><aaif:lemma rdf:resource="https://gams.uni-graz.at/o:aaif.lemma#hablar" /><aaif:position rdf:datatype="http://www.w3.org/2001/XMLSchema#int">2</aaif:position><aaif:coordinated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:coordinated><aaif:partOfText rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</aaif:partOfText><aaif:syntacticConstruction rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Intransitive" /></aaif:Verb><aaif:Adverb rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En37Ph1Ad1"><aaif:text>alto</aaif:text><aaif:lemma rdf:resource="https://gams.uni-graz.at/o:aaif.lemma#alto" /><aaif:position rdf:datatype="http://www.w3.org/2001/XMLSchema#int">3</aaif:position><aaif:coordinated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:coordinated><aaif:morphosyntacticStructure rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Adjective" /><aaif:inflection rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Uninflected" /><aaif:attributionTarget rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Verb" /><aaif:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:modified><aaif:semanticClassification rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Manner" /><aaif:reduplicated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:reduplicated><aaif:prepositionalPhrase rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:prepositionalPhrase></aaif:Adverb><aaif:Entry rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En38"><aaif:phrase rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh#En38Ph1" /><aaif:source rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh.bibl#Cnde183" /><gams:textualContent>les había allí quedado en un brasero, de manera que toda la casa quedó a escuras, y luego  pusiéronse a hablar alto  y a hacer ruido y mostraban estar en alguna gran contienda sobre el juego, diciendo el uno: "</gams:textualContent><rel:isPartOf rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh" /></aaif:Entry><aaif:Phrase rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En38Ph1"><aaif:subject rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh#En38Ph1Su1" /><aaif:verb rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh#En38Ph1Ve1" /><aaif:adverb rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh#En38Ph1Ad1" /><aaif:text>luego  pusiéronse a hablar alto </aaif:text><aaif:annoText>luego [s||mp] pusiéronse a [v|hablar|hablar|is] [a|alto|alto|auvnmnnn] </aaif:annoText></aaif:Phrase><aaif:Subject rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En38Ph1Su1"><aaif:position rdf:datatype="http://www.w3.org/2001/XMLSchema#int">1</aaif:position><aaif:gender rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Masculine" /><aaif:number rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Plural" /><aaif:overt rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:overt></aaif:Subject><aaif:Verb rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En38Ph1Ve1"><aaif:text>hablar</aaif:text><aaif:lemma rdf:resource="https://gams.uni-graz.at/o:aaif.lemma#hablar" /><aaif:position rdf:datatype="http://www.w3.org/2001/XMLSchema#int">2</aaif:position><aaif:coordinated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:coordinated><aaif:partOfText rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</aaif:partOfText><aaif:syntacticConstruction rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Intransitive" /></aaif:Verb><aaif:Adverb rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En38Ph1Ad1"><aaif:text>alto</aaif:text><aaif:lemma rdf:resource="https://gams.uni-graz.at/o:aaif.lemma#alto" /><aaif:position rdf:datatype="http://www.w3.org/2001/XMLSchema#int">3</aaif:position><aaif:coordinated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:coordinated><aaif:morphosyntacticStructure rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Adjective" /><aaif:inflection rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Uninflected" /><aaif:attributionTarget rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Verb" /><aaif:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:modified><aaif:semanticClassification rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Manner" /><aaif:reduplicated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:reduplicated><aaif:prepositionalPhrase rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:prepositionalPhrase></aaif:Adverb><aaif:Entry rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En39"><aaif:phrase rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh#En39Ph1" /><aaif:source rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh.bibl#Cnde100" /><gams:textualContent>Miçilo ¿Qué dizes entre dientes?¿Por qué no me hablas alto ?</gams:textualContent><rel:isPartOf rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh" /></aaif:Entry><aaif:Phrase rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En39Ph1"><aaif:verb rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh#En39Ph1Ve1" /><aaif:adverb rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh#En39Ph1Ad1" /><aaif:text>¿Por qué no me hablas alto ?</aaif:text><aaif:annoText>¿Por qué no me [v|hablas|hablar|is] [a|alto|alto|auvnmnnn] ?</aaif:annoText></aaif:Phrase><aaif:Verb rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En39Ph1Ve1"><aaif:text>hablas</aaif:text><aaif:lemma rdf:resource="https://gams.uni-graz.at/o:aaif.lemma#hablar" /><aaif:position rdf:datatype="http://www.w3.org/2001/XMLSchema#int">1</aaif:position><aaif:coordinated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:coordinated><aaif:partOfText rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</aaif:partOfText><aaif:syntacticConstruction rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Intransitive" /></aaif:Verb><aaif:Adverb rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En39Ph1Ad1"><aaif:text>alto</aaif:text><aaif:lemma rdf:resource="https://gams.uni-graz.at/o:aaif.lemma#alto" /><aaif:position rdf:datatype="http://www.w3.org/2001/XMLSchema#int">2</aaif:position><aaif:coordinated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:coordinated><aaif:morphosyntacticStructure rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Adjective" /><aaif:inflection rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Uninflected" /><aaif:attributionTarget rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Verb" /><aaif:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:modified><aaif:semanticClassification rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Manner" /><aaif:reduplicated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:reduplicated><aaif:prepositionalPhrase rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:prepositionalPhrase></aaif:Adverb><aaif:Entry rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En40"><aaif:phrase rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh#En40Ph1" /><aaif:source rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh.bibl#Cnde142" /><gams:textualContent>da a mí de los usos, si lo que hago es vien hecho!En verdad que lo de dezir alto la misa que es una muy buena cosa porque el preçepto no manda ver misa, sino oirla, y</gams:textualContent><rel:isPartOf rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh" /></aaif:Entry><aaif:Phrase rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En40Ph1"><aaif:verb rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh#En40Ph1Ve1" /><aaif:adverb rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh#En40Ph1Ad1" /><aaif:text>lo de dezir alto la misa</aaif:text><aaif:annoText>lo de [v|dezir|decir|ts] [a|alto|alto|auvnmnnn] la misa</aaif:annoText></aaif:Phrase><aaif:Verb rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En40Ph1Ve1"><aaif:text>dezir</aaif:text><aaif:lemma rdf:resource="https://gams.uni-graz.at/o:aaif.lemma#decir" /><aaif:position rdf:datatype="http://www.w3.org/2001/XMLSchema#int">1</aaif:position><aaif:coordinated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:coordinated><aaif:partOfText rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</aaif:partOfText><aaif:syntacticConstruction rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Transitive" /></aaif:Verb><aaif:Adverb rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En40Ph1Ad1"><aaif:text>alto</aaif:text><aaif:lemma rdf:resource="https://gams.uni-graz.at/o:aaif.lemma#alto" /><aaif:position rdf:datatype="http://www.w3.org/2001/XMLSchema#int">2</aaif:position><aaif:coordinated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:coordinated><aaif:morphosyntacticStructure rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Adjective" /><aaif:inflection rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Uninflected" /><aaif:attributionTarget rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Verb" /><aaif:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:modified><aaif:semanticClassification rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Manner" /><aaif:reduplicated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:reduplicated><aaif:prepositionalPhrase rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:prepositionalPhrase></aaif:Adverb><aaif:Entry rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En41"><aaif:phrase rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh#En41Ph1" /><aaif:source rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh.bibl#Cnde308" /><gams:textualContent>Cholula, uno colorado y otro prieto.Mientras que comía, ni por pensamiento habían de hacer alboroto ni hablar alto  los de su guarda , que estaban en las salas cerca de la del Montezuma.Traíanle frutas de</gams:textualContent><rel:isPartOf rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh" /></aaif:Entry><aaif:Phrase rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En41Ph1"><aaif:subject rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh#En41Ph1Su1" /><aaif:verb rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh#En41Ph1Ve1" /><aaif:adverb rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh#En41Ph1Ad1" /><aaif:text>ni hablar alto  los de su guarda </aaif:text><aaif:annoText>ni [v|hablar|hablar|is] [a|alto|alto|auvnmnnn]  [s|los de su guarda|mp] </aaif:annoText></aaif:Phrase><aaif:Subject rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En41Ph1Su1"><aaif:text>los de su guarda</aaif:text><aaif:position rdf:datatype="http://www.w3.org/2001/XMLSchema#int">3</aaif:position><aaif:gender rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Masculine" /><aaif:number rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Plural" /><aaif:overt rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</aaif:overt></aaif:Subject><aaif:Verb rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En41Ph1Ve1"><aaif:text>hablar</aaif:text><aaif:lemma rdf:resource="https://gams.uni-graz.at/o:aaif.lemma#hablar" /><aaif:position rdf:datatype="http://www.w3.org/2001/XMLSchema#int">1</aaif:position><aaif:coordinated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:coordinated><aaif:partOfText rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</aaif:partOfText><aaif:syntacticConstruction rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Intransitive" /></aaif:Verb><aaif:Adverb rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En41Ph1Ad1"><aaif:text>alto</aaif:text><aaif:lemma rdf:resource="https://gams.uni-graz.at/o:aaif.lemma#alto" /><aaif:position rdf:datatype="http://www.w3.org/2001/XMLSchema#int">2</aaif:position><aaif:coordinated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:coordinated><aaif:morphosyntacticStructure rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Adjective" /><aaif:inflection rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Uninflected" /><aaif:attributionTarget rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Verb" /><aaif:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:modified><aaif:semanticClassification rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Manner" /><aaif:reduplicated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:reduplicated><aaif:prepositionalPhrase rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:prepositionalPhrase></aaif:Adverb><aaif:Entry rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En42"><aaif:phrase rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh#En42Ph1" /><aaif:source rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh.bibl#Cnde467" /><gams:textualContent>Respondióle que sí.Preguntó lo mismo al compañero, y respondió que no. El truhán  dijo alto , que lo oyó el príncipe:</gams:textualContent><rel:isPartOf rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh" /></aaif:Entry><aaif:Phrase rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En42Ph1"><aaif:subject rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh#En42Ph1Su1" /><aaif:verb rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh#En42Ph1Ve1" /><aaif:adverb rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh#En42Ph1Ad1" /><aaif:text> El truhán  dijo alto </aaif:text><aaif:annoText> [s|El truhán|ms]  [v|dijo|decir|ts] [a|alto|alto|auvnmnnn] </aaif:annoText></aaif:Phrase><aaif:Subject rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En42Ph1Su1"><aaif:text>El truhán</aaif:text><aaif:position rdf:datatype="http://www.w3.org/2001/XMLSchema#int">1</aaif:position><aaif:gender rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Masculine" /><aaif:number rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Singular" /><aaif:overt rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</aaif:overt></aaif:Subject><aaif:Verb rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En42Ph1Ve1"><aaif:text>dijo</aaif:text><aaif:lemma rdf:resource="https://gams.uni-graz.at/o:aaif.lemma#decir" /><aaif:position rdf:datatype="http://www.w3.org/2001/XMLSchema#int">2</aaif:position><aaif:coordinated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:coordinated><aaif:partOfText rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</aaif:partOfText><aaif:syntacticConstruction rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Transitive" /></aaif:Verb><aaif:Adverb rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En42Ph1Ad1"><aaif:text>alto</aaif:text><aaif:lemma rdf:resource="https://gams.uni-graz.at/o:aaif.lemma#alto" /><aaif:position rdf:datatype="http://www.w3.org/2001/XMLSchema#int">3</aaif:position><aaif:coordinated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:coordinated><aaif:morphosyntacticStructure rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Adjective" /><aaif:inflection rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Uninflected" /><aaif:attributionTarget rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Verb" /><aaif:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:modified><aaif:semanticClassification rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Manner" /><aaif:reduplicated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:reduplicated><aaif:prepositionalPhrase rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:prepositionalPhrase></aaif:Adverb><aaif:Entry rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En43"><aaif:phrase rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh#En43Ph1" /><aaif:source rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh.bibl#Cnde416" /><gams:textualContent>los hombres de grande entendimiento ser buenos oradores ni predicadores; y en especial que la acción pide algunas veces hablar alto  y otras bajo, y los que son trabados de lengua no pueden orar sino a voces y gritos; y</gams:textualContent><rel:isPartOf rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh" /></aaif:Entry><aaif:Phrase rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En43Ph1"><aaif:verb rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh#En43Ph1Ve1" /><aaif:adverb rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh#En43Ph1Ad1" /><aaif:text>la acción pide algunas veces hablar alto </aaif:text><aaif:annoText>la acción pide algunas veces [v|hablar|hablar|is] [a|alto|alto|auvnmnnn] </aaif:annoText></aaif:Phrase><aaif:Verb rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En43Ph1Ve1"><aaif:text>hablar</aaif:text><aaif:lemma rdf:resource="https://gams.uni-graz.at/o:aaif.lemma#hablar" /><aaif:position rdf:datatype="http://www.w3.org/2001/XMLSchema#int">1</aaif:position><aaif:coordinated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:coordinated><aaif:partOfText rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</aaif:partOfText><aaif:syntacticConstruction rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Intransitive" /></aaif:Verb><aaif:Adverb rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En43Ph1Ad1"><aaif:text>alto</aaif:text><aaif:lemma rdf:resource="https://gams.uni-graz.at/o:aaif.lemma#alto" /><aaif:position rdf:datatype="http://www.w3.org/2001/XMLSchema#int">2</aaif:position><aaif:coordinated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:coordinated><aaif:morphosyntacticStructure rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Adjective" /><aaif:inflection rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Uninflected" /><aaif:attributionTarget rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Verb" /><aaif:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:modified><aaif:semanticClassification rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Manner" /><aaif:reduplicated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:reduplicated><aaif:prepositionalPhrase rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:prepositionalPhrase></aaif:Adverb><aaif:Entry rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En44"><aaif:phrase rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh#En44Ph1" /><aaif:source rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh.bibl#Cnde550" /><gams:textualContent>Esto dicho, el padre guiaba yendo delante, y después de haber pasado muchas tierras, Ýcaro, con la presunción de las alas, olvidado del consejo, desamparó a su padre y comenzó a volar alto ; mas a poco de tiempo se arrepintió, porque el Sol ablandó la cera con que las alas estaban pegadas, y forzosamente, y contra su voluntad, se dejó caer en el mar, que de su nombre de allí adelante se llamó Ycareo. Escribe esto Ovidio</gams:textualContent><rel:isPartOf rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh" /></aaif:Entry><aaif:Phrase rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En44Ph1"><aaif:verb rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh#En44Ph1Ve1" /><aaif:adverb rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh#En44Ph1Ad1" /><aaif:text>y comenzó a volar alto </aaif:text><aaif:annoText>y comenzó a [v|volar|volar|is] [a|alto|alto|auvnlnnn] </aaif:annoText></aaif:Phrase><aaif:Verb rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En44Ph1Ve1"><aaif:text>volar</aaif:text><aaif:lemma rdf:resource="https://gams.uni-graz.at/o:aaif.lemma#volar" /><aaif:position rdf:datatype="http://www.w3.org/2001/XMLSchema#int">1</aaif:position><aaif:coordinated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:coordinated><aaif:partOfText rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</aaif:partOfText><aaif:syntacticConstruction rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Intransitive" /></aaif:Verb><aaif:Adverb rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En44Ph1Ad1"><aaif:text>alto</aaif:text><aaif:lemma rdf:resource="https://gams.uni-graz.at/o:aaif.lemma#alto" /><aaif:position rdf:datatype="http://www.w3.org/2001/XMLSchema#int">2</aaif:position><aaif:coordinated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:coordinated><aaif:morphosyntacticStructure rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Adjective" /><aaif:inflection rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Uninflected" /><aaif:attributionTarget rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Verb" /><aaif:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:modified><aaif:semanticClassification rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Location" /><aaif:reduplicated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:reduplicated><aaif:prepositionalPhrase rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:prepositionalPhrase></aaif:Adverb><aaif:Entry rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En45"><aaif:phrase rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh#En45Ph1" /><aaif:source rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh.bibl#Cnde315" /><gams:textualContent>9 Hay otros que escupen alto y contra el aire, los quales en semejantes actos, usándolos sin discreción, salpican la cara a los circunstantes</gams:textualContent><rel:isPartOf rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh" /></aaif:Entry><aaif:Phrase rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En45Ph1"><aaif:subject rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh#En45Ph1Su1" /><aaif:verb rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh#En45Ph1Ve1" /><aaif:adverb rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh#En45Ph1Ad1" /><aaif:text>Hay otros que escupen alto y contra el aire</aaif:text><aaif:annoText>Hay [s|otros|mp] que [v|escupen|escupir|is] [a|alto|alto|auvnlnnn] y contra el aire</aaif:annoText></aaif:Phrase><aaif:Subject rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En45Ph1Su1"><aaif:text>otros</aaif:text><aaif:position rdf:datatype="http://www.w3.org/2001/XMLSchema#int">1</aaif:position><aaif:gender rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Masculine" /><aaif:number rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Plural" /><aaif:overt rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</aaif:overt></aaif:Subject><aaif:Verb rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En45Ph1Ve1"><aaif:text>escupen</aaif:text><aaif:lemma rdf:resource="https://gams.uni-graz.at/o:aaif.lemma#escupir" /><aaif:position rdf:datatype="http://www.w3.org/2001/XMLSchema#int">2</aaif:position><aaif:coordinated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:coordinated><aaif:partOfText rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</aaif:partOfText><aaif:syntacticConstruction rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Intransitive" /></aaif:Verb><aaif:Adverb rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En45Ph1Ad1"><aaif:text>alto</aaif:text><aaif:lemma rdf:resource="https://gams.uni-graz.at/o:aaif.lemma#alto" /><aaif:position rdf:datatype="http://www.w3.org/2001/XMLSchema#int">3</aaif:position><aaif:coordinated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:coordinated><aaif:morphosyntacticStructure rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Adjective" /><aaif:inflection rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Uninflected" /><aaif:attributionTarget rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Verb" /><aaif:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:modified><aaif:semanticClassification rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Location" /><aaif:reduplicated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:reduplicated><aaif:prepositionalPhrase rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:prepositionalPhrase></aaif:Adverb><aaif:Entry rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En46"><aaif:phrase rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh#En46Ph1" /><aaif:source rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh.bibl#Cnde144" /><gams:textualContent>de los del vulgo.Veamos, pues, en qué consiste el lenguaje y esta frasi de hablar alto ; veamos las condiciones que ha de tener, y, por vn camino, me haced sabidor de dos</gams:textualContent><rel:isPartOf rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh" /></aaif:Entry><aaif:Phrase rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En46Ph1"><aaif:verb rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh#En46Ph1Ve1" /><aaif:adverb rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh#En46Ph1Ad1" /><aaif:text>Veamos, pues, en qué consiste el lenguaje y esta frasi de hablar alto </aaif:text><aaif:annoText>Veamos, pues, en qué consiste el lenguaje y esta frasi de [v|hablar|hablar|is] [a|alto|alto|auvnmnnn] </aaif:annoText></aaif:Phrase><aaif:Verb rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En46Ph1Ve1"><aaif:text>hablar</aaif:text><aaif:lemma rdf:resource="https://gams.uni-graz.at/o:aaif.lemma#hablar" /><aaif:position rdf:datatype="http://www.w3.org/2001/XMLSchema#int">1</aaif:position><aaif:coordinated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:coordinated><aaif:partOfText rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</aaif:partOfText><aaif:syntacticConstruction rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Intransitive" /></aaif:Verb><aaif:Adverb rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En46Ph1Ad1"><aaif:text>alto</aaif:text><aaif:lemma rdf:resource="https://gams.uni-graz.at/o:aaif.lemma#alto" /><aaif:position rdf:datatype="http://www.w3.org/2001/XMLSchema#int">2</aaif:position><aaif:coordinated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:coordinated><aaif:morphosyntacticStructure rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Adjective" /><aaif:inflection rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Uninflected" /><aaif:attributionTarget rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Verb" /><aaif:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:modified><aaif:semanticClassification rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Manner" /><aaif:reduplicated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:reduplicated><aaif:prepositionalPhrase rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:prepositionalPhrase></aaif:Adverb><aaif:Entry rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En47"><aaif:phrase rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh#En47Ph1" /><aaif:source rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh.bibl#Cnde316" /><gams:textualContent>Van.Tengo el premio por tan mio, &lt;lb/&gt;que en esto de subir alto , &lt;lb/&gt;antes sobro, que no falto.</gams:textualContent><rel:isPartOf rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh" /></aaif:Entry><aaif:Phrase rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En47Ph1"><aaif:verb rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh#En47Ph1Ve1" /><aaif:adverb rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh#En47Ph1Ad1" /><aaif:text>en esto de subir alto </aaif:text><aaif:annoText>en esto de [v|subir|subir|is] [a|alto|alto|auvnlnnn] </aaif:annoText></aaif:Phrase><aaif:Verb rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En47Ph1Ve1"><aaif:text>subir</aaif:text><aaif:lemma rdf:resource="https://gams.uni-graz.at/o:aaif.lemma#subir" /><aaif:position rdf:datatype="http://www.w3.org/2001/XMLSchema#int">1</aaif:position><aaif:coordinated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:coordinated><aaif:partOfText rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</aaif:partOfText><aaif:syntacticConstruction rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Intransitive" /></aaif:Verb><aaif:Adverb rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En47Ph1Ad1"><aaif:text>alto</aaif:text><aaif:lemma rdf:resource="https://gams.uni-graz.at/o:aaif.lemma#alto" /><aaif:position rdf:datatype="http://www.w3.org/2001/XMLSchema#int">2</aaif:position><aaif:coordinated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:coordinated><aaif:morphosyntacticStructure rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Adjective" /><aaif:inflection rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Uninflected" /><aaif:attributionTarget rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Verb" /><aaif:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:modified><aaif:semanticClassification rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Location" /><aaif:reduplicated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:reduplicated><aaif:prepositionalPhrase rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:prepositionalPhrase></aaif:Adverb><aaif:Entry rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En48"><aaif:phrase rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh#En48Ph1" /><aaif:source rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh.bibl#Cnde322" /><gams:textualContent>tomó dinero en la mano que no le besase; en oyendo cualquier reloj, quitaba su gorra;  hablaba  alto o hacía otro ruido por no alborotar los tahures, especial los que ganando toman ocasión de levantarse; hombre</gams:textualContent><rel:isPartOf rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh" /></aaif:Entry><aaif:Phrase rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En48Ph1"><aaif:verb rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh#En48Ph1Ve1" /><aaif:adverb rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh#En48Ph1Ad1" /><aaif:text> hablaba  alto o hacía otro ruido</aaif:text><aaif:annoText> [v|hablaba|hablar|is]  [a|alto|alto|auvnmnnn] o hacía otro ruido</aaif:annoText></aaif:Phrase><aaif:Verb rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En48Ph1Ve1"><aaif:text>hablaba</aaif:text><aaif:lemma rdf:resource="https://gams.uni-graz.at/o:aaif.lemma#hablar" /><aaif:position rdf:datatype="http://www.w3.org/2001/XMLSchema#int">1</aaif:position><aaif:coordinated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:coordinated><aaif:partOfText rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</aaif:partOfText><aaif:syntacticConstruction rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Intransitive" /></aaif:Verb><aaif:Adverb rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En48Ph1Ad1"><aaif:text>alto</aaif:text><aaif:lemma rdf:resource="https://gams.uni-graz.at/o:aaif.lemma#alto" /><aaif:position rdf:datatype="http://www.w3.org/2001/XMLSchema#int">2</aaif:position><aaif:coordinated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:coordinated><aaif:morphosyntacticStructure rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Adjective" /><aaif:inflection rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Uninflected" /><aaif:attributionTarget rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Verb" /><aaif:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:modified><aaif:semanticClassification rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Manner" /><aaif:reduplicated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:reduplicated><aaif:prepositionalPhrase rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:prepositionalPhrase></aaif:Adverb><aaif:Entry rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En49"><aaif:phrase rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh#En49Ph1" /><aaif:source rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh.bibl#Cnde322" /><gams:textualContent>paje se amohina, pareciéndole que llaman a la puerta y no responde; si  los que están presentes  hablan alto , aunque sean de respeto, se le pierde diciéndoles que o jueguen o se pongan en la calle;</gams:textualContent><rel:isPartOf rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh" /></aaif:Entry><aaif:Phrase rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En49Ph1"><aaif:subject rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh#En49Ph1Su1" /><aaif:verb rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh#En49Ph1Ve1" /><aaif:adverb rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh#En49Ph1Ad1" /><aaif:text> los que están presentes  hablan alto </aaif:text><aaif:annoText> [s|los que están presentes|mp]  [v|hablan|hablar|is] [a|alto|alto|auvnmnnn] </aaif:annoText></aaif:Phrase><aaif:Subject rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En49Ph1Su1"><aaif:text>los que están presentes</aaif:text><aaif:position rdf:datatype="http://www.w3.org/2001/XMLSchema#int">1</aaif:position><aaif:gender rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Masculine" /><aaif:number rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Plural" /><aaif:overt rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</aaif:overt></aaif:Subject><aaif:Verb rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En49Ph1Ve1"><aaif:text>hablan</aaif:text><aaif:lemma rdf:resource="https://gams.uni-graz.at/o:aaif.lemma#hablar" /><aaif:position rdf:datatype="http://www.w3.org/2001/XMLSchema#int">2</aaif:position><aaif:coordinated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:coordinated><aaif:partOfText rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</aaif:partOfText><aaif:syntacticConstruction rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Intransitive" /></aaif:Verb><aaif:Adverb rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En49Ph1Ad1"><aaif:text>alto</aaif:text><aaif:lemma rdf:resource="https://gams.uni-graz.at/o:aaif.lemma#alto" /><aaif:position rdf:datatype="http://www.w3.org/2001/XMLSchema#int">3</aaif:position><aaif:coordinated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:coordinated><aaif:morphosyntacticStructure rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Adjective" /><aaif:inflection rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Uninflected" /><aaif:attributionTarget rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Verb" /><aaif:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:modified><aaif:semanticClassification rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Manner" /><aaif:reduplicated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:reduplicated><aaif:prepositionalPhrase rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:prepositionalPhrase></aaif:Adverb><aaif:Entry rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En50"><aaif:phrase rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh#En50Ph1" /><aaif:source rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh.bibl#Cnde468" /><gams:textualContent>él, escrito como en borrador, aunque de muy buena letra, fue un soneto, que, leyéndole alto , porque Sancho también lo oyese, vio que decía desta manera: </gams:textualContent><rel:isPartOf rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh" /></aaif:Entry><aaif:Phrase rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En50Ph1"><aaif:verb rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh#En50Ph1Ve1" /><aaif:adverb rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh#En50Ph1Ad1" /><aaif:text>fue un soneto, que, leyéndole alto ,</aaif:text><aaif:annoText>fue un soneto, que, [v|leyéndole|leer|ts] [a|alto|alto|auvnmnnn] ,</aaif:annoText></aaif:Phrase><aaif:Verb rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En50Ph1Ve1"><aaif:text>leyéndole</aaif:text><aaif:lemma rdf:resource="https://gams.uni-graz.at/o:aaif.lemma#leer" /><aaif:position rdf:datatype="http://www.w3.org/2001/XMLSchema#int">1</aaif:position><aaif:coordinated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:coordinated><aaif:partOfText rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</aaif:partOfText><aaif:syntacticConstruction rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Transitive" /></aaif:Verb><aaif:Adverb rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En50Ph1Ad1"><aaif:text>alto</aaif:text><aaif:lemma rdf:resource="https://gams.uni-graz.at/o:aaif.lemma#alto" /><aaif:position rdf:datatype="http://www.w3.org/2001/XMLSchema#int">2</aaif:position><aaif:coordinated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:coordinated><aaif:morphosyntacticStructure rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Adjective" /><aaif:inflection rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Uninflected" /><aaif:attributionTarget rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Verb" /><aaif:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:modified><aaif:semanticClassification rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Manner" /><aaif:reduplicated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:reduplicated><aaif:prepositionalPhrase rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:prepositionalPhrase></aaif:Adverb><aaif:Entry rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En51"><aaif:phrase rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh#En51Ph1" /><aaif:source rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh.bibl#Cnde468" /><gams:textualContent>Y leyéndola alto , como Sancho se lo había rogado, vio que decía desta manera:</gams:textualContent><rel:isPartOf rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh" /></aaif:Entry><aaif:Phrase rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En51Ph1"><aaif:verb rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh#En51Ph1Ve1" /><aaif:adverb rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh#En51Ph1Ad1" /><aaif:text>Y leyéndola alto , como Sancho se lo había rogado</aaif:text><aaif:annoText>Y [v|leyéndola|leer|ts] [a|alto|alto|auvnmnnn] , como Sancho se lo había rogado</aaif:annoText></aaif:Phrase><aaif:Verb rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En51Ph1Ve1"><aaif:text>leyéndola</aaif:text><aaif:lemma rdf:resource="https://gams.uni-graz.at/o:aaif.lemma#leer" /><aaif:position rdf:datatype="http://www.w3.org/2001/XMLSchema#int">1</aaif:position><aaif:coordinated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:coordinated><aaif:partOfText rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</aaif:partOfText><aaif:syntacticConstruction rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Transitive" /></aaif:Verb><aaif:Adverb rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En51Ph1Ad1"><aaif:text>alto</aaif:text><aaif:lemma rdf:resource="https://gams.uni-graz.at/o:aaif.lemma#alto" /><aaif:position rdf:datatype="http://www.w3.org/2001/XMLSchema#int">2</aaif:position><aaif:coordinated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:coordinated><aaif:morphosyntacticStructure rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Adjective" /><aaif:inflection rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Uninflected" /><aaif:attributionTarget rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Verb" /><aaif:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:modified><aaif:semanticClassification rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Manner" /><aaif:reduplicated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:reduplicated><aaif:prepositionalPhrase rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:prepositionalPhrase></aaif:Adverb><aaif:Entry rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En52"><aaif:phrase rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh#En52Ph1" /><aaif:source rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh.bibl#Cnde147" /><gams:textualContent>uso y costumbre, dejádmelos en golito, y si columbráredes que se levantan a montear la caza,  hablad alto , que será pedir favor, y si no os valiere, asomaos a la ventana y decid a voces:</gams:textualContent><rel:isPartOf rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh" /></aaif:Entry><aaif:Phrase rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En52Ph1"><aaif:subject rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh#En52Ph1Su1" /><aaif:verb rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh#En52Ph1Ve1" /><aaif:adverb rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh#En52Ph1Ad1" /><aaif:text>si columbráredes que se levantan a montear la caza,  hablad alto </aaif:text><aaif:annoText>si columbráredes que se levantan a montear la caza, [s||up] [v|hablad|hablar|is] [a|alto|alto|auvnmnnn] </aaif:annoText></aaif:Phrase><aaif:Subject rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En52Ph1Su1"><aaif:position rdf:datatype="http://www.w3.org/2001/XMLSchema#int">1</aaif:position><aaif:gender rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Undefined" /><aaif:number rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Plural" /><aaif:overt rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:overt></aaif:Subject><aaif:Verb rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En52Ph1Ve1"><aaif:text>hablad</aaif:text><aaif:lemma rdf:resource="https://gams.uni-graz.at/o:aaif.lemma#hablar" /><aaif:position rdf:datatype="http://www.w3.org/2001/XMLSchema#int">2</aaif:position><aaif:coordinated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:coordinated><aaif:partOfText rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</aaif:partOfText><aaif:syntacticConstruction rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Intransitive" /></aaif:Verb><aaif:Adverb rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En52Ph1Ad1"><aaif:text>alto</aaif:text><aaif:lemma rdf:resource="https://gams.uni-graz.at/o:aaif.lemma#alto" /><aaif:position rdf:datatype="http://www.w3.org/2001/XMLSchema#int">3</aaif:position><aaif:coordinated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:coordinated><aaif:morphosyntacticStructure rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Adjective" /><aaif:inflection rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Uninflected" /><aaif:attributionTarget rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Verb" /><aaif:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:modified><aaif:semanticClassification rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Manner" /><aaif:reduplicated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:reduplicated><aaif:prepositionalPhrase rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:prepositionalPhrase></aaif:Adverb><aaif:Entry rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En53"><aaif:phrase rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh#En53Ph1" /><aaif:source rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh.bibl#Cnde147" /><gams:textualContent>causa de querer echar al aire las dos manos en que estribaba.Este no tenía de donde caer alto , porque siempre andaba a burra, sin peligro de poder caer della; mas lo que es dar</gams:textualContent><rel:isPartOf rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh" /></aaif:Entry><aaif:Phrase rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En53Ph1"><aaif:verb rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh#En53Ph1Ve1" /><aaif:adverb rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh#En53Ph1Ad1" /><aaif:text>Este no tenía de donde caer alto </aaif:text><aaif:annoText>Este no tenía de donde [v|caer|caer|is] [a|alto|alto|auvnlnnn] </aaif:annoText></aaif:Phrase><aaif:Verb rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En53Ph1Ve1"><aaif:text>caer</aaif:text><aaif:lemma rdf:resource="https://gams.uni-graz.at/o:aaif.lemma#caer" /><aaif:position rdf:datatype="http://www.w3.org/2001/XMLSchema#int">1</aaif:position><aaif:coordinated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:coordinated><aaif:partOfText rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</aaif:partOfText><aaif:syntacticConstruction rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Intransitive" /></aaif:Verb><aaif:Adverb rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En53Ph1Ad1"><aaif:text>alto</aaif:text><aaif:lemma rdf:resource="https://gams.uni-graz.at/o:aaif.lemma#alto" /><aaif:position rdf:datatype="http://www.w3.org/2001/XMLSchema#int">2</aaif:position><aaif:coordinated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:coordinated><aaif:morphosyntacticStructure rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Adjective" /><aaif:inflection rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Uninflected" /><aaif:attributionTarget rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Verb" /><aaif:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:modified><aaif:semanticClassification rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Location" /><aaif:reduplicated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:reduplicated><aaif:prepositionalPhrase rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:prepositionalPhrase></aaif:Adverb><aaif:Entry rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En54"><aaif:phrase rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh#En54Ph1" /><aaif:source rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh.bibl#Cnde551" /><gams:textualContent>Ella &lt;lb/&gt; Leedla  alto , marido .</gams:textualContent><rel:isPartOf rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh" /></aaif:Entry><aaif:Phrase rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En54Ph1"><aaif:subject rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh#En54Ph1Su1" /><aaif:verb rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh#En54Ph1Ve1" /><aaif:adverb rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh#En54Ph1Ad1" /><aaif:text> Leedla  alto , marido .</aaif:text><aaif:annoText> [v|Leedla|leer|ts]  [a|alto|alto|auvnmnnn] , [s|marido|ms] .</aaif:annoText></aaif:Phrase><aaif:Subject rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En54Ph1Su1"><aaif:text>marido</aaif:text><aaif:position rdf:datatype="http://www.w3.org/2001/XMLSchema#int">3</aaif:position><aaif:gender rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Masculine" /><aaif:number rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Singular" /><aaif:overt rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</aaif:overt></aaif:Subject><aaif:Verb rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En54Ph1Ve1"><aaif:text>Leedla</aaif:text><aaif:lemma rdf:resource="https://gams.uni-graz.at/o:aaif.lemma#leer" /><aaif:position rdf:datatype="http://www.w3.org/2001/XMLSchema#int">1</aaif:position><aaif:coordinated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:coordinated><aaif:partOfText rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</aaif:partOfText><aaif:syntacticConstruction rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Transitive" /></aaif:Verb><aaif:Adverb rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En54Ph1Ad1"><aaif:text>alto</aaif:text><aaif:lemma rdf:resource="https://gams.uni-graz.at/o:aaif.lemma#alto" /><aaif:position rdf:datatype="http://www.w3.org/2001/XMLSchema#int">2</aaif:position><aaif:coordinated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:coordinated><aaif:morphosyntacticStructure rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Adjective" /><aaif:inflection rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Uninflected" /><aaif:attributionTarget rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Verb" /><aaif:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:modified><aaif:semanticClassification rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Manner" /><aaif:reduplicated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:reduplicated><aaif:prepositionalPhrase rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:prepositionalPhrase></aaif:Adverb><aaif:Entry rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En55"><aaif:phrase rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh#En55Ph1" /><aaif:source rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh.bibl#Cnde552" /><gams:textualContent>Desde el asiento  padre Eneas así habló alto .</gams:textualContent><rel:isPartOf rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh" /></aaif:Entry><aaif:Phrase rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En55Ph1"><aaif:subject rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh#En55Ph1Su1" /><aaif:verb rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh#En55Ph1Ve1" /><aaif:adverb rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh#En55Ph1Ad1" /><aaif:text> padre Eneas así habló alto </aaif:text><aaif:annoText> [s|padre Eneas|ms] así [v|habló|hablar|is] [a|alto|alto|auvnmnnn] </aaif:annoText></aaif:Phrase><aaif:Subject rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En55Ph1Su1"><aaif:text>padre Eneas</aaif:text><aaif:position rdf:datatype="http://www.w3.org/2001/XMLSchema#int">1</aaif:position><aaif:gender rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Masculine" /><aaif:number rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Singular" /><aaif:overt rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</aaif:overt></aaif:Subject><aaif:Verb rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En55Ph1Ve1"><aaif:text>habló</aaif:text><aaif:lemma rdf:resource="https://gams.uni-graz.at/o:aaif.lemma#hablar" /><aaif:position rdf:datatype="http://www.w3.org/2001/XMLSchema#int">2</aaif:position><aaif:coordinated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:coordinated><aaif:partOfText rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</aaif:partOfText><aaif:syntacticConstruction rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Intransitive" /></aaif:Verb><aaif:Adverb rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En55Ph1Ad1"><aaif:text>alto</aaif:text><aaif:lemma rdf:resource="https://gams.uni-graz.at/o:aaif.lemma#alto" /><aaif:position rdf:datatype="http://www.w3.org/2001/XMLSchema#int">3</aaif:position><aaif:coordinated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:coordinated><aaif:morphosyntacticStructure rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Adjective" /><aaif:inflection rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Uninflected" /><aaif:attributionTarget rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Verb" /><aaif:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:modified><aaif:semanticClassification rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Manner" /><aaif:reduplicated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:reduplicated><aaif:prepositionalPhrase rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:prepositionalPhrase></aaif:Adverb><aaif:Entry rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En56"><aaif:phrase rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh#En56Ph1" /><aaif:source rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh.bibl#Cnde553" /><gams:textualContent> Habla  alto y respóndele alto .</gams:textualContent><rel:isPartOf rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh" /></aaif:Entry><aaif:Phrase rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En56Ph1"><aaif:verb rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh#En56Ph1Ve1" /><aaif:verb rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh#En56Ph1Ve2" /><aaif:adverb rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh#En56Ph1Ad1" /><aaif:adverb rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh#En56Ph1Ad2" /><aaif:text> Habla  alto y respóndele alto .</aaif:text><aaif:annoText> [v|Habla|hablar|i]  [a|alto|alto|auvnmnnn] y [v|respóndele|responder|ts] [a|alto|alto|auvnmnnn] .</aaif:annoText></aaif:Phrase><aaif:Verb rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En56Ph1Ve1"><aaif:text>Habla</aaif:text><aaif:lemma rdf:resource="https://gams.uni-graz.at/o:aaif.lemma#hablar" /><aaif:position rdf:datatype="http://www.w3.org/2001/XMLSchema#int">1</aaif:position><aaif:coordinated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:coordinated><aaif:partOfText rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</aaif:partOfText><aaif:syntacticConstruction rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Intransitive" /></aaif:Verb><aaif:Verb rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En56Ph1Ve2"><aaif:text>respóndele</aaif:text><aaif:lemma rdf:resource="https://gams.uni-graz.at/o:aaif.lemma#responder" /><aaif:position rdf:datatype="http://www.w3.org/2001/XMLSchema#int">3</aaif:position><aaif:coordinated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:coordinated><aaif:partOfText rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</aaif:partOfText><aaif:syntacticConstruction rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Transitive" /></aaif:Verb><aaif:Adverb rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En56Ph1Ad1"><aaif:text>alto</aaif:text><aaif:lemma rdf:resource="https://gams.uni-graz.at/o:aaif.lemma#alto" /><aaif:position rdf:datatype="http://www.w3.org/2001/XMLSchema#int">2</aaif:position><aaif:coordinated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:coordinated><aaif:morphosyntacticStructure rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Adjective" /><aaif:inflection rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Uninflected" /><aaif:attributionTarget rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Verb" /><aaif:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:modified><aaif:semanticClassification rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Manner" /><aaif:reduplicated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:reduplicated><aaif:prepositionalPhrase rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:prepositionalPhrase></aaif:Adverb><aaif:Adverb rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En56Ph1Ad2"><aaif:text>alto</aaif:text><aaif:lemma rdf:resource="https://gams.uni-graz.at/o:aaif.lemma#alto" /><aaif:position rdf:datatype="http://www.w3.org/2001/XMLSchema#int">4</aaif:position><aaif:coordinated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:coordinated><aaif:morphosyntacticStructure rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Adjective" /><aaif:inflection rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Uninflected" /><aaif:attributionTarget rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Verb" /><aaif:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:modified><aaif:semanticClassification rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Manner" /><aaif:reduplicated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:reduplicated><aaif:prepositionalPhrase rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:prepositionalPhrase></aaif:Adverb><aaif:Entry rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En57"><aaif:phrase rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh#En57Ph1" /><aaif:source rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh.bibl#Cnde130" /><gams:textualContent>la enfermedad, aplicábale la mañana por remedio.Era tan noble que jamás sacó sangre baja: siempre picaba alto .Cuando sangraba del tobillo a alguna dama, asistía mi padre con una luz, y mi tío</gams:textualContent><rel:isPartOf rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh" /></aaif:Entry><aaif:Phrase rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En57Ph1"><aaif:verb rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh#En57Ph1Ve1" /><aaif:adverb rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh#En57Ph1Ad1" /><aaif:text>siempre picaba alto </aaif:text><aaif:annoText>siempre [v|picaba|picar|is] [a|alto|alto|auvnlnnn] </aaif:annoText></aaif:Phrase><aaif:Verb rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En57Ph1Ve1"><aaif:text>picaba</aaif:text><aaif:lemma rdf:resource="https://gams.uni-graz.at/o:aaif.lemma#picar" /><aaif:position rdf:datatype="http://www.w3.org/2001/XMLSchema#int">1</aaif:position><aaif:coordinated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:coordinated><aaif:partOfText rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</aaif:partOfText><aaif:syntacticConstruction rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Intransitive" /></aaif:Verb><aaif:Adverb rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En57Ph1Ad1"><aaif:text>alto</aaif:text><aaif:lemma rdf:resource="https://gams.uni-graz.at/o:aaif.lemma#alto" /><aaif:position rdf:datatype="http://www.w3.org/2001/XMLSchema#int">2</aaif:position><aaif:coordinated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:coordinated><aaif:morphosyntacticStructure rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Adjective" /><aaif:inflection rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Uninflected" /><aaif:attributionTarget rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Verb" /><aaif:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:modified><aaif:semanticClassification rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Location" /><aaif:reduplicated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:reduplicated><aaif:prepositionalPhrase rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:prepositionalPhrase></aaif:Adverb><aaif:Entry rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En58"><aaif:phrase rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh#En58Ph1" /><aaif:source rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh.bibl#Cnde335" /><gams:textualContent>Y no paró aquí, sino que a otro desventurado que, encogiéndose de hombros, no osaba hablar alto , lo mandó pasear.Y, preguntando unos por qué le azotaban, respondían otros:</gams:textualContent><rel:isPartOf rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh" /></aaif:Entry><aaif:Phrase rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En58Ph1"><aaif:verb rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh#En58Ph1Ve1" /><aaif:adverb rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh#En58Ph1Ad1" /><aaif:text>no osaba hablar alto </aaif:text><aaif:annoText>no osaba [v|hablar|hablar|is] [a|alto|alto|auvnmnnn] </aaif:annoText></aaif:Phrase><aaif:Verb rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En58Ph1Ve1"><aaif:text>hablar</aaif:text><aaif:lemma rdf:resource="https://gams.uni-graz.at/o:aaif.lemma#hablar" /><aaif:position rdf:datatype="http://www.w3.org/2001/XMLSchema#int">1</aaif:position><aaif:coordinated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:coordinated><aaif:partOfText rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</aaif:partOfText><aaif:syntacticConstruction rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Intransitive" /></aaif:Verb><aaif:Adverb rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En58Ph1Ad1"><aaif:text>alto</aaif:text><aaif:lemma rdf:resource="https://gams.uni-graz.at/o:aaif.lemma#alto" /><aaif:position rdf:datatype="http://www.w3.org/2001/XMLSchema#int">2</aaif:position><aaif:coordinated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:coordinated><aaif:morphosyntacticStructure rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Adjective" /><aaif:inflection rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Uninflected" /><aaif:attributionTarget rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Verb" /><aaif:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:modified><aaif:semanticClassification rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Manner" /><aaif:reduplicated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:reduplicated><aaif:prepositionalPhrase rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:prepositionalPhrase></aaif:Adverb><aaif:Entry rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En59"><aaif:phrase rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh#En59Ph1" /><aaif:source rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh.bibl#Cnde555" /><gams:textualContent> Lee  alto .Con el seguro que promete mi real palabra, podrán Vuestra Majestad y Sus Altezas venir hoy a mi</gams:textualContent><rel:isPartOf rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh" /></aaif:Entry><aaif:Phrase rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En59Ph1"><aaif:verb rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh#En59Ph1Ve1" /><aaif:adverb rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh#En59Ph1Ad1" /><aaif:text> Lee  alto </aaif:text><aaif:annoText> [v|Lee|leer|is]  [a|alto|alto|auvnmnnn] </aaif:annoText></aaif:Phrase><aaif:Verb rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En59Ph1Ve1"><aaif:text>Lee</aaif:text><aaif:lemma rdf:resource="https://gams.uni-graz.at/o:aaif.lemma#leer" /><aaif:position rdf:datatype="http://www.w3.org/2001/XMLSchema#int">1</aaif:position><aaif:coordinated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:coordinated><aaif:partOfText rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</aaif:partOfText><aaif:syntacticConstruction rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Intransitive" /></aaif:Verb><aaif:Adverb rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En59Ph1Ad1"><aaif:text>alto</aaif:text><aaif:lemma rdf:resource="https://gams.uni-graz.at/o:aaif.lemma#alto" /><aaif:position rdf:datatype="http://www.w3.org/2001/XMLSchema#int">2</aaif:position><aaif:coordinated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:coordinated><aaif:morphosyntacticStructure rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Adjective" /><aaif:inflection rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Uninflected" /><aaif:attributionTarget rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Verb" /><aaif:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:modified><aaif:semanticClassification rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Manner" /><aaif:reduplicated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:reduplicated><aaif:prepositionalPhrase rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:prepositionalPhrase></aaif:Adverb><aaif:Entry rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En60"><aaif:phrase rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh#En60Ph1" /><aaif:source rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh.bibl#Cnde556" /><gams:textualContent>los trabajadores para aliviar el trabajo; ni tampoco cantan las indias, ni aun saben ellos ni ellas hablar alto .Desde chicos los crían tan encogidos que, si les mandan llamar a alguno, aunque lo tengan a la vista</gams:textualContent><rel:isPartOf rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh" /></aaif:Entry><aaif:Phrase rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En60Ph1"><aaif:subject rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh#En60Ph1Su1" /><aaif:verb rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh#En60Ph1Ve1" /><aaif:adverb rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh#En60Ph1Ad1" /><aaif:text>ni aun saben ellos ni ellas hablar alto </aaif:text><aaif:annoText>ni aun saben [s|ellos ni ellas|mp] [v|hablar|hablar|is] [a|alto|alto|auvnmnnn] </aaif:annoText></aaif:Phrase><aaif:Subject rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En60Ph1Su1"><aaif:text>ellos ni ellas</aaif:text><aaif:position rdf:datatype="http://www.w3.org/2001/XMLSchema#int">1</aaif:position><aaif:gender rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Masculine" /><aaif:number rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Plural" /><aaif:overt rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</aaif:overt></aaif:Subject><aaif:Verb rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En60Ph1Ve1"><aaif:text>hablar</aaif:text><aaif:lemma rdf:resource="https://gams.uni-graz.at/o:aaif.lemma#hablar" /><aaif:position rdf:datatype="http://www.w3.org/2001/XMLSchema#int">2</aaif:position><aaif:coordinated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:coordinated><aaif:partOfText rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</aaif:partOfText><aaif:syntacticConstruction rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Intransitive" /></aaif:Verb><aaif:Adverb rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En60Ph1Ad1"><aaif:text>alto</aaif:text><aaif:lemma rdf:resource="https://gams.uni-graz.at/o:aaif.lemma#alto" /><aaif:position rdf:datatype="http://www.w3.org/2001/XMLSchema#int">3</aaif:position><aaif:coordinated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:coordinated><aaif:morphosyntacticStructure rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Adjective" /><aaif:inflection rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Uninflected" /><aaif:attributionTarget rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Verb" /><aaif:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:modified><aaif:semanticClassification rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Manner" /><aaif:reduplicated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:reduplicated><aaif:prepositionalPhrase rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:prepositionalPhrase></aaif:Adverb><aaif:Entry rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En61"><aaif:phrase rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh#En61Ph1" /><aaif:source rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh.bibl#Cnde246" /><gams:textualContent>en que no esperaba nada de la inventiva de su confidente, contábale, sin embargo, sus cuitas y  hablaba  alto delante de él, depositando en el taimado Ferrus sus más importantes secretos con la misma tranquilidad con que deja un</gams:textualContent><rel:isPartOf rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh" /></aaif:Entry><aaif:Phrase rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En61Ph1"><aaif:verb rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh#En61Ph1Ve1" /><aaif:adverb rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh#En61Ph1Ad1" /><aaif:text> hablaba  alto delante de él</aaif:text><aaif:annoText> [v|hablaba|hablar|is]  [a|alto|alto|auvnmnnn] delante de él</aaif:annoText></aaif:Phrase><aaif:Verb rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En61Ph1Ve1"><aaif:text>hablaba</aaif:text><aaif:lemma rdf:resource="https://gams.uni-graz.at/o:aaif.lemma#hablar" /><aaif:position rdf:datatype="http://www.w3.org/2001/XMLSchema#int">1</aaif:position><aaif:coordinated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:coordinated><aaif:partOfText rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</aaif:partOfText><aaif:syntacticConstruction rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Intransitive" /></aaif:Verb><aaif:Adverb rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En61Ph1Ad1"><aaif:text>alto</aaif:text><aaif:lemma rdf:resource="https://gams.uni-graz.at/o:aaif.lemma#alto" /><aaif:position rdf:datatype="http://www.w3.org/2001/XMLSchema#int">2</aaif:position><aaif:coordinated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:coordinated><aaif:morphosyntacticStructure rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Adjective" /><aaif:inflection rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Uninflected" /><aaif:attributionTarget rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Verb" /><aaif:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:modified><aaif:semanticClassification rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Manner" /><aaif:reduplicated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:reduplicated><aaif:prepositionalPhrase rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:prepositionalPhrase></aaif:Adverb><aaif:Entry rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En62"><aaif:phrase rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh#En62Ph1" /><aaif:source rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh.bibl#Cnde247" /><gams:textualContent>que vio alejarse de la ventana?Tanteemos un poco más, se dijo para sí, y enseguida añadió alto :</gams:textualContent><rel:isPartOf rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh" /></aaif:Entry><aaif:Phrase rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En62Ph1"><aaif:verb rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh#En62Ph1Ve1" /><aaif:adverb rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh#En62Ph1Ad1" /><aaif:text>enseguida añadió alto :</aaif:text><aaif:annoText>enseguida [v|añadió|añadir|ts] [a|alto|alto|auvnmnnn] :</aaif:annoText></aaif:Phrase><aaif:Verb rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En62Ph1Ve1"><aaif:text>añadió</aaif:text><aaif:lemma rdf:resource="https://gams.uni-graz.at/o:aaif.lemma#añadir" /><aaif:position rdf:datatype="http://www.w3.org/2001/XMLSchema#int">1</aaif:position><aaif:coordinated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:coordinated><aaif:partOfText rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</aaif:partOfText><aaif:syntacticConstruction rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Transitive" /></aaif:Verb><aaif:Adverb rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En62Ph1Ad1"><aaif:text>alto</aaif:text><aaif:lemma rdf:resource="https://gams.uni-graz.at/o:aaif.lemma#alto" /><aaif:position rdf:datatype="http://www.w3.org/2001/XMLSchema#int">2</aaif:position><aaif:coordinated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:coordinated><aaif:morphosyntacticStructure rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Adjective" /><aaif:inflection rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Uninflected" /><aaif:attributionTarget rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Verb" /><aaif:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:modified><aaif:semanticClassification rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Manner" /><aaif:reduplicated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:reduplicated><aaif:prepositionalPhrase rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:prepositionalPhrase></aaif:Adverb><aaif:Entry rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En63"><aaif:phrase rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh#En63Ph1" /><aaif:source rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh.bibl#Cnde247" /><gams:textualContent>paseo.Pero  el hombre no pasó de largo cual ella esperaba; se plantó en la esquina y dijo alto : Sin vergüenza, sangre de chincha, ven para cá si eres guapo.</gams:textualContent><rel:isPartOf rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh" /></aaif:Entry><aaif:Phrase rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En63Ph1"><aaif:subject rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh#En63Ph1Su1" /><aaif:verb rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh#En63Ph1Ve1" /><aaif:adverb rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh#En63Ph1Ad1" /><aaif:text> el hombre no pasó de largo cual ella esperaba; se plantó en la esquina y dijo alto :</aaif:text><aaif:annoText> [s|el hombre|ms] no pasó de largo cual ella esperaba; se plantó en la esquina y [v|dijo|decir|ts] [a|alto|alto|auvnmnnn] :</aaif:annoText></aaif:Phrase><aaif:Subject rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En63Ph1Su1"><aaif:text>el hombre</aaif:text><aaif:position rdf:datatype="http://www.w3.org/2001/XMLSchema#int">1</aaif:position><aaif:gender rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Masculine" /><aaif:number rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Singular" /><aaif:overt rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</aaif:overt></aaif:Subject><aaif:Verb rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En63Ph1Ve1"><aaif:text>dijo</aaif:text><aaif:lemma rdf:resource="https://gams.uni-graz.at/o:aaif.lemma#decir" /><aaif:position rdf:datatype="http://www.w3.org/2001/XMLSchema#int">2</aaif:position><aaif:coordinated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:coordinated><aaif:partOfText rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</aaif:partOfText><aaif:syntacticConstruction rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Transitive" /></aaif:Verb><aaif:Adverb rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En63Ph1Ad1"><aaif:text>alto</aaif:text><aaif:lemma rdf:resource="https://gams.uni-graz.at/o:aaif.lemma#alto" /><aaif:position rdf:datatype="http://www.w3.org/2001/XMLSchema#int">3</aaif:position><aaif:coordinated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:coordinated><aaif:morphosyntacticStructure rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Adjective" /><aaif:inflection rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Uninflected" /><aaif:attributionTarget rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Verb" /><aaif:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:modified><aaif:semanticClassification rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Manner" /><aaif:reduplicated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:reduplicated><aaif:prepositionalPhrase rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:prepositionalPhrase></aaif:Adverb><aaif:Entry rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En64"><aaif:phrase rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh#En64Ph1" /><aaif:source rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh.bibl#Cnde247" /><gams:textualContent>evitando la ocasión, evitó el peligro.Se puso seria y pasó al lado de su tía, a quien dijo alto que era hora de recogerse.El reloj de Leonardo marcaba las once de la noche.</gams:textualContent><rel:isPartOf rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh" /></aaif:Entry><aaif:Phrase rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En64Ph1"><aaif:verb rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh#En64Ph1Ve1" /><aaif:adverb rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh#En64Ph1Ad1" /><aaif:text>a quien dijo alto que era hora de recogerse</aaif:text><aaif:annoText>a quien [v|dijo|decir|ts] [a|alto|alto|auvnmnnn] que era hora de recogerse</aaif:annoText></aaif:Phrase><aaif:Verb rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En64Ph1Ve1"><aaif:text>dijo</aaif:text><aaif:lemma rdf:resource="https://gams.uni-graz.at/o:aaif.lemma#decir" /><aaif:position rdf:datatype="http://www.w3.org/2001/XMLSchema#int">1</aaif:position><aaif:coordinated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:coordinated><aaif:partOfText rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</aaif:partOfText><aaif:syntacticConstruction rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Transitive" /></aaif:Verb><aaif:Adverb rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En64Ph1Ad1"><aaif:text>alto</aaif:text><aaif:lemma rdf:resource="https://gams.uni-graz.at/o:aaif.lemma#alto" /><aaif:position rdf:datatype="http://www.w3.org/2001/XMLSchema#int">2</aaif:position><aaif:coordinated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:coordinated><aaif:morphosyntacticStructure rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Adjective" /><aaif:inflection rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Uninflected" /><aaif:attributionTarget rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Verb" /><aaif:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:modified><aaif:semanticClassification rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Manner" /><aaif:reduplicated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:reduplicated><aaif:prepositionalPhrase rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:prepositionalPhrase></aaif:Adverb><aaif:Entry rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En65"><aaif:phrase rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh#En65Ph1" /><aaif:source rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh.bibl#Cnde247" /><gams:textualContent>A tiempo de montar echó  Gamboa una mirada desdeñosa al espectáculo en torno del carruaje, y dijo alto , de modo que lo oyó Pedro, que le tenía el estribo: ¡Ay!¡Qué falta hacía aquí </gams:textualContent><rel:isPartOf rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh" /></aaif:Entry><aaif:Phrase rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En65Ph1"><aaif:subject rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh#En65Ph1Su1" /><aaif:verb rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh#En65Ph1Ve1" /><aaif:adverb rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh#En65Ph1Ad1" /><aaif:text> Gamboa una mirada desdeñosa al espectáculo en torno del carruaje, y dijo alto , de modo que lo oyó Pedro, que le tenía el estribo: ¡Ay!</aaif:text><aaif:annoText> [s|Gamboa|ms] una mirada desdeñosa al espectáculo en torno del carruaje, y [v|dijo|decir|ts] [a|alto|alto|auvnmnnn] , de modo que lo oyó Pedro, que le tenía el estribo: ¡Ay!</aaif:annoText></aaif:Phrase><aaif:Subject rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En65Ph1Su1"><aaif:text>Gamboa</aaif:text><aaif:position rdf:datatype="http://www.w3.org/2001/XMLSchema#int">1</aaif:position><aaif:gender rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Masculine" /><aaif:number rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Singular" /><aaif:overt rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</aaif:overt></aaif:Subject><aaif:Verb rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En65Ph1Ve1"><aaif:text>dijo</aaif:text><aaif:lemma rdf:resource="https://gams.uni-graz.at/o:aaif.lemma#decir" /><aaif:position rdf:datatype="http://www.w3.org/2001/XMLSchema#int">2</aaif:position><aaif:coordinated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:coordinated><aaif:partOfText rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</aaif:partOfText><aaif:syntacticConstruction rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Transitive" /></aaif:Verb><aaif:Adverb rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En65Ph1Ad1"><aaif:text>alto</aaif:text><aaif:lemma rdf:resource="https://gams.uni-graz.at/o:aaif.lemma#alto" /><aaif:position rdf:datatype="http://www.w3.org/2001/XMLSchema#int">3</aaif:position><aaif:coordinated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:coordinated><aaif:morphosyntacticStructure rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Adjective" /><aaif:inflection rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Uninflected" /><aaif:attributionTarget rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Verb" /><aaif:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:modified><aaif:semanticClassification rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Manner" /><aaif:reduplicated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:reduplicated><aaif:prepositionalPhrase rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:prepositionalPhrase></aaif:Adverb><aaif:Entry rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En66"><aaif:phrase rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh#En66Ph1" /><aaif:source rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh.bibl#Cnde247" /><gams:textualContent>se hace el dormido para no tomarse el trabajo de abrir la talanquera.Lo haré salir a patadas, agregó alto , dando un puñetazo en el pomo de la silla.Echó pie a tierra sin más demora y se </gams:textualContent><rel:isPartOf rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh" /></aaif:Entry><aaif:Phrase rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En66Ph1"><aaif:verb rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh#En66Ph1Ve1" /><aaif:adverb rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh#En66Ph1Ad1" /><aaif:text>Lo haré salir a patadas, agregó alto </aaif:text><aaif:annoText>Lo haré salir a patadas, [v|agregó|agregar|ts] [a|alto|alto|auvnmnnn] </aaif:annoText></aaif:Phrase><aaif:Verb rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En66Ph1Ve1"><aaif:text>agregó</aaif:text><aaif:lemma rdf:resource="https://gams.uni-graz.at/o:aaif.lemma#agregar" /><aaif:position rdf:datatype="http://www.w3.org/2001/XMLSchema#int">1</aaif:position><aaif:coordinated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:coordinated><aaif:partOfText rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</aaif:partOfText><aaif:syntacticConstruction rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Transitive" /></aaif:Verb><aaif:Adverb rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En66Ph1Ad1"><aaif:text>alto</aaif:text><aaif:lemma rdf:resource="https://gams.uni-graz.at/o:aaif.lemma#alto" /><aaif:position rdf:datatype="http://www.w3.org/2001/XMLSchema#int">2</aaif:position><aaif:coordinated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:coordinated><aaif:morphosyntacticStructure rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Adjective" /><aaif:inflection rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Uninflected" /><aaif:attributionTarget rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Verb" /><aaif:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:modified><aaif:semanticClassification rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Manner" /><aaif:reduplicated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:reduplicated><aaif:prepositionalPhrase rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:prepositionalPhrase></aaif:Adverb><aaif:Entry rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En67"><aaif:phrase rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh#En67Ph1" /><aaif:source rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh.bibl#Cnde247" /><gams:textualContent>luego que notó el buen parecer de la muchacha—.Aquí hay gato encerrado.El médico — añadió alto —, ha pasado mala noche, y duerme...</gams:textualContent><rel:isPartOf rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh" /></aaif:Entry><aaif:Phrase rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En67Ph1"><aaif:verb rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh#En67Ph1Ve1" /><aaif:adverb rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh#En67Ph1Ad1" /><aaif:text>El médico — añadió alto —</aaif:text><aaif:annoText>El médico — [v|añadió|añadir|ts] [a|alto|alto|auvnmnnn] —</aaif:annoText></aaif:Phrase><aaif:Verb rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En67Ph1Ve1"><aaif:text>añadió</aaif:text><aaif:lemma rdf:resource="https://gams.uni-graz.at/o:aaif.lemma#añadir" /><aaif:position rdf:datatype="http://www.w3.org/2001/XMLSchema#int">1</aaif:position><aaif:coordinated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:coordinated><aaif:partOfText rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</aaif:partOfText><aaif:syntacticConstruction rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Transitive" /></aaif:Verb><aaif:Adverb rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En67Ph1Ad1"><aaif:text>alto</aaif:text><aaif:lemma rdf:resource="https://gams.uni-graz.at/o:aaif.lemma#alto" /><aaif:position rdf:datatype="http://www.w3.org/2001/XMLSchema#int">2</aaif:position><aaif:coordinated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:coordinated><aaif:morphosyntacticStructure rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Adjective" /><aaif:inflection rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Uninflected" /><aaif:attributionTarget rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Verb" /><aaif:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:modified><aaif:semanticClassification rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Manner" /><aaif:reduplicated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:reduplicated><aaif:prepositionalPhrase rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:prepositionalPhrase></aaif:Adverb><aaif:Entry rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En68"><aaif:phrase rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh#En68Ph1" /><aaif:source rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh.bibl#Cnde247" /><gams:textualContent>—dijo D.Cándido para sí—.¿Pues no se aparece a la hora nona?—luego añadió alto —: Tratárase de tablas sin nudos ni alabeos, señor D.Fernando, o de ladrillos sin caliches,</gams:textualContent><rel:isPartOf rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh" /></aaif:Entry><aaif:Phrase rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En68Ph1"><aaif:verb rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh#En68Ph1Ve1" /><aaif:adverb rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh#En68Ph1Ad1" /><aaif:text>luego añadió alto </aaif:text><aaif:annoText>luego [v|añadió|añadir|ts] [a|alto|alto|auvnmnnn] </aaif:annoText></aaif:Phrase><aaif:Verb rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En68Ph1Ve1"><aaif:text>añadió</aaif:text><aaif:lemma rdf:resource="https://gams.uni-graz.at/o:aaif.lemma#añadir" /><aaif:position rdf:datatype="http://www.w3.org/2001/XMLSchema#int">1</aaif:position><aaif:coordinated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:coordinated><aaif:partOfText rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</aaif:partOfText><aaif:syntacticConstruction rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Transitive" /></aaif:Verb><aaif:Adverb rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En68Ph1Ad1"><aaif:text>alto</aaif:text><aaif:lemma rdf:resource="https://gams.uni-graz.at/o:aaif.lemma#alto" /><aaif:position rdf:datatype="http://www.w3.org/2001/XMLSchema#int">2</aaif:position><aaif:coordinated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:coordinated><aaif:morphosyntacticStructure rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Adjective" /><aaif:inflection rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Uninflected" /><aaif:attributionTarget rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Verb" /><aaif:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:modified><aaif:semanticClassification rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Manner" /><aaif:reduplicated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:reduplicated><aaif:prepositionalPhrase rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:prepositionalPhrase></aaif:Adverb><aaif:Entry rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En69"><aaif:phrase rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh#En69Ph1" /><aaif:source rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh.bibl#Cnde247" /><gams:textualContent>— Habla, canta claro, mulata de mis culpas — añadió  alto  Leonardo para que le oyese Cecilia si estaba en el aposento inmediato—.No me gustan los tapujos.</gams:textualContent><rel:isPartOf rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh" /></aaif:Entry><aaif:Phrase rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En69Ph1"><aaif:subject rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh#En69Ph1Su1" /><aaif:verb rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh#En69Ph1Ve1" /><aaif:adverb rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh#En69Ph1Ad1" /><aaif:text> añadió  alto  Leonardo para que le oyese Cecilia</aaif:text><aaif:annoText> [v|añadió|añadir|ts]  [a|alto|alto|auvnmnnn]  [s|Leonardo|ms] para que le oyese Cecilia</aaif:annoText></aaif:Phrase><aaif:Subject rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En69Ph1Su1"><aaif:text>Leonardo</aaif:text><aaif:position rdf:datatype="http://www.w3.org/2001/XMLSchema#int">3</aaif:position><aaif:gender rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Masculine" /><aaif:number rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Singular" /><aaif:overt rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</aaif:overt></aaif:Subject><aaif:Verb rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En69Ph1Ve1"><aaif:text>añadió</aaif:text><aaif:lemma rdf:resource="https://gams.uni-graz.at/o:aaif.lemma#añadir" /><aaif:position rdf:datatype="http://www.w3.org/2001/XMLSchema#int">1</aaif:position><aaif:coordinated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:coordinated><aaif:partOfText rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</aaif:partOfText><aaif:syntacticConstruction rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Transitive" /></aaif:Verb><aaif:Adverb rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En69Ph1Ad1"><aaif:text>alto</aaif:text><aaif:lemma rdf:resource="https://gams.uni-graz.at/o:aaif.lemma#alto" /><aaif:position rdf:datatype="http://www.w3.org/2001/XMLSchema#int">2</aaif:position><aaif:coordinated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:coordinated><aaif:morphosyntacticStructure rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Adjective" /><aaif:inflection rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Uninflected" /><aaif:attributionTarget rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Verb" /><aaif:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:modified><aaif:semanticClassification rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Manner" /><aaif:reduplicated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:reduplicated><aaif:prepositionalPhrase rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:prepositionalPhrase></aaif:Adverb><aaif:Entry rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En70"><aaif:phrase rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh#En70Ph1" /><aaif:source rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh.bibl#Cnde367" /><gams:textualContent>la guitarra, o bailando un bolero que no había más que ver.Si hubiese sido ahora, hubiera hablado alto , bailado de mala gana, o sentándome en el sofá, tararearía un aria italiana, cogería el abanico de las </gams:textualContent><rel:isPartOf rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh" /></aaif:Entry><aaif:Phrase rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En70Ph1"><aaif:verb rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh#En70Ph1Ve1" /><aaif:adverb rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh#En70Ph1Ad1" /><aaif:text>Si hubiese sido ahora, hubiera hablado alto </aaif:text><aaif:annoText>Si hubiese sido ahora, [v|hubiera hablado|hablar|is] [a|alto|alto|auvnmnnn] </aaif:annoText></aaif:Phrase><aaif:Verb rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En70Ph1Ve1"><aaif:text>hubiera hablado</aaif:text><aaif:lemma rdf:resource="https://gams.uni-graz.at/o:aaif.lemma#hablar" /><aaif:position rdf:datatype="http://www.w3.org/2001/XMLSchema#int">1</aaif:position><aaif:coordinated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:coordinated><aaif:partOfText rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</aaif:partOfText><aaif:syntacticConstruction rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Intransitive" /></aaif:Verb><aaif:Adverb rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En70Ph1Ad1"><aaif:text>alto</aaif:text><aaif:lemma rdf:resource="https://gams.uni-graz.at/o:aaif.lemma#alto" /><aaif:position rdf:datatype="http://www.w3.org/2001/XMLSchema#int">2</aaif:position><aaif:coordinated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:coordinated><aaif:morphosyntacticStructure rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Adjective" /><aaif:inflection rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Uninflected" /><aaif:attributionTarget rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Verb" /><aaif:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:modified><aaif:semanticClassification rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Manner" /><aaif:reduplicated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:reduplicated><aaif:prepositionalPhrase rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:prepositionalPhrase></aaif:Adverb><aaif:Entry rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En71"><aaif:phrase rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh#En71Ph1" /><aaif:source rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh.bibl#Cnde248" /><gams:textualContent>—  Léela  alto  —añadió mi padre paseándose por la habitación y enjugándose el sudor que le humedecía la frente.</gams:textualContent><rel:isPartOf rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh" /></aaif:Entry><aaif:Phrase rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En71Ph1"><aaif:verb rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh#En71Ph1Ve1" /><aaif:adverb rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh#En71Ph1Ad1" /><aaif:text> Léela  alto </aaif:text><aaif:annoText> [v|Léela|leer|ts]  [a|alto|alto|auvnmnnn] </aaif:annoText></aaif:Phrase><aaif:Verb rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En71Ph1Ve1"><aaif:text>Léela</aaif:text><aaif:lemma rdf:resource="https://gams.uni-graz.at/o:aaif.lemma#leer" /><aaif:position rdf:datatype="http://www.w3.org/2001/XMLSchema#int">1</aaif:position><aaif:coordinated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:coordinated><aaif:partOfText rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</aaif:partOfText><aaif:syntacticConstruction rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Transitive" /></aaif:Verb><aaif:Adverb rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En71Ph1Ad1"><aaif:text>alto</aaif:text><aaif:lemma rdf:resource="https://gams.uni-graz.at/o:aaif.lemma#alto" /><aaif:position rdf:datatype="http://www.w3.org/2001/XMLSchema#int">2</aaif:position><aaif:coordinated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:coordinated><aaif:morphosyntacticStructure rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Adjective" /><aaif:inflection rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Uninflected" /><aaif:attributionTarget rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Verb" /><aaif:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:modified><aaif:semanticClassification rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Manner" /><aaif:reduplicated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:reduplicated><aaif:prepositionalPhrase rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:prepositionalPhrase></aaif:Adverb><aaif:Entry rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En72"><aaif:phrase rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh#En72Ph1" /><aaif:source rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh.bibl#Cnde181" /><gams:textualContent>Esto lo dijo bastante alto para que lo oyese el sereno que daba vuelta a la esquina.El borracho sintió en los ojos la claridad</gams:textualContent><rel:isPartOf rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh" /></aaif:Entry><aaif:Phrase rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En72Ph1"><aaif:verb rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh#En72Ph1Ve1" /><aaif:adverb rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh#En72Ph1Ad1" /><aaif:text>Esto lo dijo bastante alto para que lo oyese el sereno</aaif:text><aaif:annoText>Esto lo [v|dijo|decir|ts] bastante [a|alto|alto|auvmmnnn] para que lo oyese el sereno</aaif:annoText></aaif:Phrase><aaif:Verb rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En72Ph1Ve1"><aaif:text>dijo</aaif:text><aaif:lemma rdf:resource="https://gams.uni-graz.at/o:aaif.lemma#decir" /><aaif:position rdf:datatype="http://www.w3.org/2001/XMLSchema#int">1</aaif:position><aaif:coordinated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:coordinated><aaif:partOfText rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</aaif:partOfText><aaif:syntacticConstruction rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Transitive" /></aaif:Verb><aaif:Adverb rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En72Ph1Ad1"><aaif:text>alto</aaif:text><aaif:lemma rdf:resource="https://gams.uni-graz.at/o:aaif.lemma#alto" /><aaif:position rdf:datatype="http://www.w3.org/2001/XMLSchema#int">2</aaif:position><aaif:coordinated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:coordinated><aaif:morphosyntacticStructure rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Adjective" /><aaif:inflection rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Uninflected" /><aaif:attributionTarget rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Verb" /><aaif:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</aaif:modified><aaif:semanticClassification rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Manner" /><aaif:reduplicated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:reduplicated><aaif:prepositionalPhrase rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:prepositionalPhrase></aaif:Adverb><aaif:Entry rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En73"><aaif:phrase rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh#En73Ph1" /><aaif:source rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh.bibl#Cnde181" /><gams:textualContent>— Sí,  hablaba  alto , soñaba a gritos...</gams:textualContent><rel:isPartOf rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh" /></aaif:Entry><aaif:Phrase rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En73Ph1"><aaif:verb rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh#En73Ph1Ve1" /><aaif:adverb rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh#En73Ph1Ad1" /><aaif:text> hablaba  alto , soñaba a gritos...</aaif:text><aaif:annoText> [v|hablaba|hablar|is]  [a|alto|alto|auvnmnnn] , soñaba a gritos...</aaif:annoText></aaif:Phrase><aaif:Verb rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En73Ph1Ve1"><aaif:text>hablaba</aaif:text><aaif:lemma rdf:resource="https://gams.uni-graz.at/o:aaif.lemma#hablar" /><aaif:position rdf:datatype="http://www.w3.org/2001/XMLSchema#int">1</aaif:position><aaif:coordinated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:coordinated><aaif:partOfText rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</aaif:partOfText><aaif:syntacticConstruction rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Intransitive" /></aaif:Verb><aaif:Adverb rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En73Ph1Ad1"><aaif:text>alto</aaif:text><aaif:lemma rdf:resource="https://gams.uni-graz.at/o:aaif.lemma#alto" /><aaif:position rdf:datatype="http://www.w3.org/2001/XMLSchema#int">2</aaif:position><aaif:coordinated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:coordinated><aaif:morphosyntacticStructure rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Adjective" /><aaif:inflection rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Uninflected" /><aaif:attributionTarget rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Verb" /><aaif:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:modified><aaif:semanticClassification rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Manner" /><aaif:reduplicated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:reduplicated><aaif:prepositionalPhrase rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:prepositionalPhrase></aaif:Adverb><aaif:Entry rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En74"><aaif:phrase rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh#En74Ph1" /><aaif:source rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh.bibl#Cnde181" /><gams:textualContent>— Y yo he hablado alto ...</gams:textualContent><rel:isPartOf rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh" /></aaif:Entry><aaif:Phrase rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En74Ph1"><aaif:subject rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh#En74Ph1Su1" /><aaif:verb rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh#En74Ph1Ve1" /><aaif:adverb rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh#En74Ph1Ad1" /><aaif:text>Y yo he hablado alto </aaif:text><aaif:annoText>Y [s|yo|us] [v|he hablado|hablar|is] [a|alto|alto|auvnmnnn] </aaif:annoText></aaif:Phrase><aaif:Subject rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En74Ph1Su1"><aaif:text>yo</aaif:text><aaif:position rdf:datatype="http://www.w3.org/2001/XMLSchema#int">1</aaif:position><aaif:gender rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Undefined" /><aaif:number rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Singular" /><aaif:overt rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</aaif:overt></aaif:Subject><aaif:Verb rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En74Ph1Ve1"><aaif:text>he hablado</aaif:text><aaif:lemma rdf:resource="https://gams.uni-graz.at/o:aaif.lemma#hablar" /><aaif:position rdf:datatype="http://www.w3.org/2001/XMLSchema#int">2</aaif:position><aaif:coordinated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:coordinated><aaif:partOfText rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</aaif:partOfText><aaif:syntacticConstruction rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Intransitive" /></aaif:Verb><aaif:Adverb rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En74Ph1Ad1"><aaif:text>alto</aaif:text><aaif:lemma rdf:resource="https://gams.uni-graz.at/o:aaif.lemma#alto" /><aaif:position rdf:datatype="http://www.w3.org/2001/XMLSchema#int">3</aaif:position><aaif:coordinated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:coordinated><aaif:morphosyntacticStructure rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Adjective" /><aaif:inflection rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Uninflected" /><aaif:attributionTarget rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Verb" /><aaif:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:modified><aaif:semanticClassification rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Manner" /><aaif:reduplicated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:reduplicated><aaif:prepositionalPhrase rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:prepositionalPhrase></aaif:Adverb><aaif:Entry rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En75"><aaif:phrase rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh#En75Ph1" /><aaif:source rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh.bibl#Cnde181" /><gams:textualContent> Don Álvaro  hablaba alto , como si quisiera que le oyesen en toda la casa.</gams:textualContent><rel:isPartOf rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh" /></aaif:Entry><aaif:Phrase rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En75Ph1"><aaif:subject rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh#En75Ph1Su1" /><aaif:verb rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh#En75Ph1Ve1" /><aaif:adverb rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh#En75Ph1Ad1" /><aaif:text> Don Álvaro  hablaba alto </aaif:text><aaif:annoText> [s|Don Álvaro|ms]  [v|hablaba|hablar|is] [a|alto|alto|auvnmnnn] </aaif:annoText></aaif:Phrase><aaif:Subject rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En75Ph1Su1"><aaif:text>Don Álvaro</aaif:text><aaif:position rdf:datatype="http://www.w3.org/2001/XMLSchema#int">1</aaif:position><aaif:gender rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Masculine" /><aaif:number rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Singular" /><aaif:overt rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</aaif:overt></aaif:Subject><aaif:Verb rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En75Ph1Ve1"><aaif:text>hablaba</aaif:text><aaif:lemma rdf:resource="https://gams.uni-graz.at/o:aaif.lemma#hablar" /><aaif:position rdf:datatype="http://www.w3.org/2001/XMLSchema#int">2</aaif:position><aaif:coordinated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:coordinated><aaif:partOfText rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</aaif:partOfText><aaif:syntacticConstruction rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Intransitive" /></aaif:Verb><aaif:Adverb rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En75Ph1Ad1"><aaif:text>alto</aaif:text><aaif:lemma rdf:resource="https://gams.uni-graz.at/o:aaif.lemma#alto" /><aaif:position rdf:datatype="http://www.w3.org/2001/XMLSchema#int">3</aaif:position><aaif:coordinated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:coordinated><aaif:morphosyntacticStructure rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Adjective" /><aaif:inflection rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Uninflected" /><aaif:attributionTarget rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Verb" /><aaif:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:modified><aaif:semanticClassification rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Manner" /><aaif:reduplicated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:reduplicated><aaif:prepositionalPhrase rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:prepositionalPhrase></aaif:Adverb><aaif:Entry rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En76"><aaif:phrase rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh#En76Ph1" /><aaif:source rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh.bibl#Cnde181" /><gams:textualContent>respeto que merecía el difunto.Todos los hachones se habían apagado y chorreaban agua en vez de cera.Se hablaba alto en las filas.</gams:textualContent><rel:isPartOf rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh" /></aaif:Entry><aaif:Phrase rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En76Ph1"><aaif:verb rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh#En76Ph1Ve1" /><aaif:adverb rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh#En76Ph1Ad1" /><aaif:text>Se hablaba alto en las filas.</aaif:text><aaif:annoText>Se [v|hablaba|hablar|rs] [a|alto|alto|auvnmnnn] en las filas.</aaif:annoText></aaif:Phrase><aaif:Verb rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En76Ph1Ve1"><aaif:text>hablaba</aaif:text><aaif:lemma rdf:resource="https://gams.uni-graz.at/o:aaif.lemma#hablar" /><aaif:position rdf:datatype="http://www.w3.org/2001/XMLSchema#int">1</aaif:position><aaif:coordinated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:coordinated><aaif:partOfText rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</aaif:partOfText><aaif:syntacticConstruction rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Reflexive" /></aaif:Verb><aaif:Adverb rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En76Ph1Ad1"><aaif:text>alto</aaif:text><aaif:lemma rdf:resource="https://gams.uni-graz.at/o:aaif.lemma#alto" /><aaif:position rdf:datatype="http://www.w3.org/2001/XMLSchema#int">2</aaif:position><aaif:coordinated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:coordinated><aaif:morphosyntacticStructure rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Adjective" /><aaif:inflection rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Uninflected" /><aaif:attributionTarget rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Verb" /><aaif:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:modified><aaif:semanticClassification rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Manner" /><aaif:reduplicated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:reduplicated><aaif:prepositionalPhrase rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:prepositionalPhrase></aaif:Adverb><aaif:Entry rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En77"><aaif:phrase rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh#En77Ph1" /><aaif:source rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh.bibl#Cnde181" /><gams:textualContent>"No podía explicárselo; los celos, si así podían llamarse, le habían hecho hablar alto .Por lo demás, él despreciaba a la rubia lubrica en el fondo del alma...y sólo en un </gams:textualContent><rel:isPartOf rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh" /></aaif:Entry><aaif:Phrase rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En77Ph1"><aaif:verb rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh#En77Ph1Ve1" /><aaif:adverb rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh#En77Ph1Ad1" /><aaif:text>los celos, si así podían llamarse, le habían hecho hablar alto </aaif:text><aaif:annoText>los celos, si así podían llamarse, le habían hecho [v|hablar|hablar|is] [a|alto|alto|auvnmnnn] </aaif:annoText></aaif:Phrase><aaif:Verb rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En77Ph1Ve1"><aaif:text>hablar</aaif:text><aaif:lemma rdf:resource="https://gams.uni-graz.at/o:aaif.lemma#hablar" /><aaif:position rdf:datatype="http://www.w3.org/2001/XMLSchema#int">1</aaif:position><aaif:coordinated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:coordinated><aaif:partOfText rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</aaif:partOfText><aaif:syntacticConstruction rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Intransitive" /></aaif:Verb><aaif:Adverb rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En77Ph1Ad1"><aaif:text>alto</aaif:text><aaif:lemma rdf:resource="https://gams.uni-graz.at/o:aaif.lemma#alto" /><aaif:position rdf:datatype="http://www.w3.org/2001/XMLSchema#int">2</aaif:position><aaif:coordinated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:coordinated><aaif:morphosyntacticStructure rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Adjective" /><aaif:inflection rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Uninflected" /><aaif:attributionTarget rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Verb" /><aaif:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:modified><aaif:semanticClassification rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Manner" /><aaif:reduplicated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:reduplicated><aaif:prepositionalPhrase rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:prepositionalPhrase></aaif:Adverb><aaif:Entry rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En78"><aaif:phrase rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh#En78Ph1" /><aaif:source rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh.bibl#Cnde249" /><gams:textualContent>a mí el ojo, o ese bocado tan fino no está para ti.¡Jinojo, si picaste alto !Y con esto, y con el réspez * de toda tu casta...Te digo, Cleto,</gams:textualContent><rel:isPartOf rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh" /></aaif:Entry><aaif:Phrase rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En78Ph1"><aaif:verb rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh#En78Ph1Ve1" /><aaif:adverb rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh#En78Ph1Ad1" /><aaif:text>¡Jinojo, si picaste alto !</aaif:text><aaif:annoText>¡Jinojo, si [v|picaste|picar|is] [a|alto|alto|auvnlnnn] !</aaif:annoText></aaif:Phrase><aaif:Verb rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En78Ph1Ve1"><aaif:text>picaste</aaif:text><aaif:lemma rdf:resource="https://gams.uni-graz.at/o:aaif.lemma#picar" /><aaif:position rdf:datatype="http://www.w3.org/2001/XMLSchema#int">1</aaif:position><aaif:coordinated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:coordinated><aaif:partOfText rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</aaif:partOfText><aaif:syntacticConstruction rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Intransitive" /></aaif:Verb><aaif:Adverb rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En78Ph1Ad1"><aaif:text>alto</aaif:text><aaif:lemma rdf:resource="https://gams.uni-graz.at/o:aaif.lemma#alto" /><aaif:position rdf:datatype="http://www.w3.org/2001/XMLSchema#int">2</aaif:position><aaif:coordinated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:coordinated><aaif:morphosyntacticStructure rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Adjective" /><aaif:inflection rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Uninflected" /><aaif:attributionTarget rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Verb" /><aaif:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:modified><aaif:semanticClassification rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Location" /><aaif:reduplicated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:reduplicated><aaif:prepositionalPhrase rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:prepositionalPhrase></aaif:Adverb><aaif:Entry rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En79"><aaif:phrase rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh#En79Ph1" /><aaif:source rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh.bibl#Cnde557" /><gams:textualContent>Lo importante para él, lo necesario, lo indispensable, era crear, pensar alto y hablar gordo  y convertirse él mismo en un personaje de sus novelas</gams:textualContent><rel:isPartOf rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh" /></aaif:Entry><aaif:Phrase rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En79Ph1"><aaif:verb rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh#En79Ph1Ve1" /><aaif:verb rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh#En79Ph1Ve2" /><aaif:adverb rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh#En79Ph1Ad1" /><aaif:adverb rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh#En79Ph1Ad2" /><aaif:text>Lo importante para él, lo necesario, lo indispensable, era crear, pensar alto y hablar gordo </aaif:text><aaif:annoText>Lo importante para él, lo necesario, lo indispensable, era crear, [v|pensar|pensar|is] [a|alto|alto|auvnmnnn] y [v|hablar|hablar|is] [a|gordo|gordo|auvnmnnn] </aaif:annoText></aaif:Phrase><aaif:Verb rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En79Ph1Ve1"><aaif:text>pensar</aaif:text><aaif:lemma rdf:resource="https://gams.uni-graz.at/o:aaif.lemma#pensar" /><aaif:position rdf:datatype="http://www.w3.org/2001/XMLSchema#int">1</aaif:position><aaif:coordinated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:coordinated><aaif:partOfText rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</aaif:partOfText><aaif:syntacticConstruction rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Intransitive" /></aaif:Verb><aaif:Verb rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En79Ph1Ve2"><aaif:text>hablar</aaif:text><aaif:lemma rdf:resource="https://gams.uni-graz.at/o:aaif.lemma#hablar" /><aaif:position rdf:datatype="http://www.w3.org/2001/XMLSchema#int">3</aaif:position><aaif:coordinated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:coordinated><aaif:partOfText rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</aaif:partOfText><aaif:syntacticConstruction rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Intransitive" /></aaif:Verb><aaif:Adverb rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En79Ph1Ad1"><aaif:text>alto</aaif:text><aaif:lemma rdf:resource="https://gams.uni-graz.at/o:aaif.lemma#alto" /><aaif:position rdf:datatype="http://www.w3.org/2001/XMLSchema#int">2</aaif:position><aaif:coordinated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:coordinated><aaif:morphosyntacticStructure rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Adjective" /><aaif:inflection rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Uninflected" /><aaif:attributionTarget rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Verb" /><aaif:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:modified><aaif:semanticClassification rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Manner" /><aaif:reduplicated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:reduplicated><aaif:prepositionalPhrase rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:prepositionalPhrase></aaif:Adverb><aaif:Adverb rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En79Ph1Ad2"><aaif:text>gordo</aaif:text><aaif:lemma rdf:resource="https://gams.uni-graz.at/o:aaif.lemma#gordo" /><aaif:position rdf:datatype="http://www.w3.org/2001/XMLSchema#int">4</aaif:position><aaif:coordinated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:coordinated><aaif:morphosyntacticStructure rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Adjective" /><aaif:inflection rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Uninflected" /><aaif:attributionTarget rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Verb" /><aaif:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:modified><aaif:semanticClassification rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Manner" /><aaif:reduplicated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:reduplicated><aaif:prepositionalPhrase rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:prepositionalPhrase></aaif:Adverb><aaif:Entry rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En80"><aaif:phrase rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh#En80Ph1" /><aaif:source rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh.bibl#Cnde140" /><gams:textualContent>Julián reflexionaba en la rara coincidencia de los terrores de Nucha y los suyos propios; y pensando alto , prorrumpía: — Señorita, también esta casa...vamos, no es por decir mal de ella, pero...es un poco miedosa.¿No le parece?</gams:textualContent><rel:isPartOf rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh" /></aaif:Entry><aaif:Phrase rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En80Ph1"><aaif:verb rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh#En80Ph1Ve1" /><aaif:adverb rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh#En80Ph1Ad1" /><aaif:text>y pensando alto , prorrumpía:</aaif:text><aaif:annoText>y [v|pensando|pensar|is] [a|alto|alto|auvnmnnn] , prorrumpía:</aaif:annoText></aaif:Phrase><aaif:Verb rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En80Ph1Ve1"><aaif:text>pensando</aaif:text><aaif:lemma rdf:resource="https://gams.uni-graz.at/o:aaif.lemma#pensar" /><aaif:position rdf:datatype="http://www.w3.org/2001/XMLSchema#int">1</aaif:position><aaif:coordinated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:coordinated><aaif:partOfText rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</aaif:partOfText><aaif:syntacticConstruction rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Intransitive" /></aaif:Verb><aaif:Adverb rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En80Ph1Ad1"><aaif:text>alto</aaif:text><aaif:lemma rdf:resource="https://gams.uni-graz.at/o:aaif.lemma#alto" /><aaif:position rdf:datatype="http://www.w3.org/2001/XMLSchema#int">2</aaif:position><aaif:coordinated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:coordinated><aaif:morphosyntacticStructure rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Adjective" /><aaif:inflection rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Uninflected" /><aaif:attributionTarget rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Verb" /><aaif:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:modified><aaif:semanticClassification rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Manner" /><aaif:reduplicated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:reduplicated><aaif:prepositionalPhrase rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:prepositionalPhrase></aaif:Adverb><aaif:Entry rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En81"><aaif:phrase rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh#En81Ph1" /><aaif:source rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh.bibl#Cnde113" /><gams:textualContent>y ese carácter es mujeril y revela una gran degradación.Hay que tener algo dentro de la cabeza y pensar alto .La mujer tiene como centro natural la familia, pero el hombre debe salirse de esta pequeñez y trabajar</gams:textualContent><rel:isPartOf rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh" /></aaif:Entry><aaif:Phrase rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En81Ph1"><aaif:verb rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh#En81Ph1Ve1" /><aaif:adverb rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh#En81Ph1Ad1" /><aaif:text>Hay que tener algo dentro de la cabeza y pensar alto </aaif:text><aaif:annoText>Hay que tener algo dentro de la cabeza y [v|pensar|pensar|is] [a|alto|alto|auvnmnnn] </aaif:annoText></aaif:Phrase><aaif:Verb rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En81Ph1Ve1"><aaif:text>pensar</aaif:text><aaif:lemma rdf:resource="https://gams.uni-graz.at/o:aaif.lemma#pensar" /><aaif:position rdf:datatype="http://www.w3.org/2001/XMLSchema#int">1</aaif:position><aaif:coordinated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:coordinated><aaif:partOfText rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</aaif:partOfText><aaif:syntacticConstruction rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Intransitive" /></aaif:Verb><aaif:Adverb rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En81Ph1Ad1"><aaif:text>alto</aaif:text><aaif:lemma rdf:resource="https://gams.uni-graz.at/o:aaif.lemma#alto" /><aaif:position rdf:datatype="http://www.w3.org/2001/XMLSchema#int">2</aaif:position><aaif:coordinated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:coordinated><aaif:morphosyntacticStructure rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Adjective" /><aaif:inflection rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Uninflected" /><aaif:attributionTarget rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Verb" /><aaif:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:modified><aaif:semanticClassification rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Manner" /><aaif:reduplicated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:reduplicated><aaif:prepositionalPhrase rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:prepositionalPhrase></aaif:Adverb><aaif:Entry rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En82"><aaif:phrase rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh#En82Ph1" /><aaif:source rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh.bibl#Cnde558" /><gams:textualContent>— Acompáñame...¡Tengo mucho miedo a las arañas!No hables alto ...Allí duerme Isabel.</gams:textualContent><rel:isPartOf rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh" /></aaif:Entry><aaif:Phrase rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En82Ph1"><aaif:verb rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh#En82Ph1Ve1" /><aaif:adverb rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh#En82Ph1Ad1" /><aaif:text>No hables alto </aaif:text><aaif:annoText>No [v|hables|hablar|is] [a|alto|alto|auvnmnnn] </aaif:annoText></aaif:Phrase><aaif:Verb rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En82Ph1Ve1"><aaif:text>hables</aaif:text><aaif:lemma rdf:resource="https://gams.uni-graz.at/o:aaif.lemma#hablar" /><aaif:position rdf:datatype="http://www.w3.org/2001/XMLSchema#int">1</aaif:position><aaif:coordinated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:coordinated><aaif:partOfText rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</aaif:partOfText><aaif:syntacticConstruction rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Intransitive" /></aaif:Verb><aaif:Adverb rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En82Ph1Ad1"><aaif:text>alto</aaif:text><aaif:lemma rdf:resource="https://gams.uni-graz.at/o:aaif.lemma#alto" /><aaif:position rdf:datatype="http://www.w3.org/2001/XMLSchema#int">2</aaif:position><aaif:coordinated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:coordinated><aaif:morphosyntacticStructure rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Adjective" /><aaif:inflection rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Uninflected" /><aaif:attributionTarget rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Verb" /><aaif:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:modified><aaif:semanticClassification rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Manner" /><aaif:reduplicated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:reduplicated><aaif:prepositionalPhrase rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:prepositionalPhrase></aaif:Adverb><aaif:Entry rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En83"><aaif:phrase rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh#En83Ph1" /><aaif:source rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh.bibl#Cnde115" /><gams:textualContent> Milagritos y Dolorcitas , preocupadas sobre todo de hacer admirar sus trajes, sus sombreros, sus quitasoles, hablaban alto , se reían estrepitosamente, se deleitaban con el néctar de vanidad al ver el efecto que producían en torno de </gams:textualContent><rel:isPartOf rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh" /></aaif:Entry><aaif:Phrase rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En83Ph1"><aaif:subject rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh#En83Ph1Su1" /><aaif:verb rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh#En83Ph1Ve1" /><aaif:adverb rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh#En83Ph1Ad1" /><aaif:text> Milagritos y Dolorcitas , preocupadas sobre todo de hacer admirar sus trajes, sus sombreros, sus quitasoles, hablaban alto ,</aaif:text><aaif:annoText> [s|Milagritos y Dolorcitas|fp] , preocupadas sobre todo de hacer admirar sus trajes, sus sombreros, sus quitasoles, [v|hablaban|hablar|is] [a|alto|alto|auvnmnnn] ,</aaif:annoText></aaif:Phrase><aaif:Subject rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En83Ph1Su1"><aaif:text>Milagritos y Dolorcitas</aaif:text><aaif:position rdf:datatype="http://www.w3.org/2001/XMLSchema#int">1</aaif:position><aaif:gender rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Feminine" /><aaif:number rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Plural" /><aaif:overt rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</aaif:overt></aaif:Subject><aaif:Verb rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En83Ph1Ve1"><aaif:text>hablaban</aaif:text><aaif:lemma rdf:resource="https://gams.uni-graz.at/o:aaif.lemma#hablar" /><aaif:position rdf:datatype="http://www.w3.org/2001/XMLSchema#int">2</aaif:position><aaif:coordinated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:coordinated><aaif:partOfText rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</aaif:partOfText><aaif:syntacticConstruction rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Intransitive" /></aaif:Verb><aaif:Adverb rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En83Ph1Ad1"><aaif:text>alto</aaif:text><aaif:lemma rdf:resource="https://gams.uni-graz.at/o:aaif.lemma#alto" /><aaif:position rdf:datatype="http://www.w3.org/2001/XMLSchema#int">3</aaif:position><aaif:coordinated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:coordinated><aaif:morphosyntacticStructure rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Adjective" /><aaif:inflection rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Uninflected" /><aaif:attributionTarget rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Verb" /><aaif:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:modified><aaif:semanticClassification rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Manner" /><aaif:reduplicated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:reduplicated><aaif:prepositionalPhrase rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:prepositionalPhrase></aaif:Adverb><aaif:Entry rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En84"><aaif:phrase rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh#En84Ph1" /><aaif:source rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh.bibl#Cnde115" /><gams:textualContent>se alejó apresurada con mademoiselle.Aquéllas pasaron junto á Patricio escoltadas por Guy de Morins y Jacques Termal. Las dos jóvenes  hablaban alto , haciéndose notar, persuadidas de que todos admiraban su belleza y sus trajes.Patricio siguió detrás, á </gams:textualContent><rel:isPartOf rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh" /></aaif:Entry><aaif:Phrase rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En84Ph1"><aaif:subject rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh#En84Ph1Su1" /><aaif:verb rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh#En84Ph1Ve1" /><aaif:adverb rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh#En84Ph1Ad1" /><aaif:text> Las dos jóvenes  hablaban alto </aaif:text><aaif:annoText> [s|Las dos jóvenes|fp]  [v|hablaban|hablar|is] [a|alto|alto|auvnmnnn] </aaif:annoText></aaif:Phrase><aaif:Subject rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En84Ph1Su1"><aaif:text>Las dos jóvenes</aaif:text><aaif:position rdf:datatype="http://www.w3.org/2001/XMLSchema#int">1</aaif:position><aaif:gender rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Feminine" /><aaif:number rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Plural" /><aaif:overt rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</aaif:overt></aaif:Subject><aaif:Verb rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En84Ph1Ve1"><aaif:text>hablaban</aaif:text><aaif:lemma rdf:resource="https://gams.uni-graz.at/o:aaif.lemma#hablar" /><aaif:position rdf:datatype="http://www.w3.org/2001/XMLSchema#int">2</aaif:position><aaif:coordinated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:coordinated><aaif:partOfText rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</aaif:partOfText><aaif:syntacticConstruction rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Intransitive" /></aaif:Verb><aaif:Adverb rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En84Ph1Ad1"><aaif:text>alto</aaif:text><aaif:lemma rdf:resource="https://gams.uni-graz.at/o:aaif.lemma#alto" /><aaif:position rdf:datatype="http://www.w3.org/2001/XMLSchema#int">3</aaif:position><aaif:coordinated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:coordinated><aaif:morphosyntacticStructure rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Adjective" /><aaif:inflection rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Uninflected" /><aaif:attributionTarget rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Verb" /><aaif:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:modified><aaif:semanticClassification rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Manner" /><aaif:reduplicated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:reduplicated><aaif:prepositionalPhrase rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:prepositionalPhrase></aaif:Adverb><aaif:Entry rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En85"><aaif:phrase rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh#En85Ph1" /><aaif:source rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh.bibl#Cnde25" /><gams:textualContent> Rió con risa exasperada, alto .«Bien, pues todo eso hay que hacerlo» —gritó con violencia frenética— «Hay que </gams:textualContent><rel:isPartOf rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh" /></aaif:Entry><aaif:Phrase rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En85Ph1"><aaif:verb rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh#En85Ph1Ve1" /><aaif:adverb rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh#En85Ph1Ad1" /><aaif:text> Rió con risa exasperada, alto </aaif:text><aaif:annoText> [v|Rió|reír|is] con risa exasperada, [a|alto|alto|auvnmnnC] </aaif:annoText></aaif:Phrase><aaif:Verb rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En85Ph1Ve1"><aaif:text>Rió</aaif:text><aaif:lemma rdf:resource="https://gams.uni-graz.at/o:aaif.lemma#reír" /><aaif:position rdf:datatype="http://www.w3.org/2001/XMLSchema#int">1</aaif:position><aaif:coordinated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:coordinated><aaif:partOfText rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</aaif:partOfText><aaif:syntacticConstruction rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Intransitive" /></aaif:Verb><aaif:Adverb rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En85Ph1Ad1"><aaif:text>alto</aaif:text><aaif:lemma rdf:resource="https://gams.uni-graz.at/o:aaif.lemma#alto" /><aaif:position rdf:datatype="http://www.w3.org/2001/XMLSchema#int">2</aaif:position><aaif:coordinated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</aaif:coordinated><aaif:morphosyntacticStructure rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Adjective" /><aaif:inflection rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Uninflected" /><aaif:attributionTarget rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Verb" /><aaif:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:modified><aaif:semanticClassification rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Manner" /><aaif:reduplicated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:reduplicated><aaif:prepositionalPhrase rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:prepositionalPhrase></aaif:Adverb><aaif:Entry rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En86"><aaif:phrase rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh#En86Ph1" /><aaif:source rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh.bibl#Cnde25" /><gams:textualContent>turbio, cuando  el artista , en un momento de relampagueante lucidez, se volvió hacia su enfermera y pronunció alto y claro : </gams:textualContent><rel:isPartOf rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh" /></aaif:Entry><aaif:Phrase rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En86Ph1"><aaif:subject rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh#En86Ph1Su1" /><aaif:verb rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh#En86Ph1Ve1" /><aaif:adverb rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh#En86Ph1Ad1" /><aaif:adverb rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh#En86Ph1Ad2" /><aaif:text> el artista , en un momento de relampagueante lucidez, se volvió hacia su enfermera y pronunció alto y claro </aaif:text><aaif:annoText> [s|el artista|ms] , en un momento de relampagueante lucidez, se volvió hacia su enfermera y [v|pronunció|pronunciar|ts] [a|alto|alto|auvnmnnC] y [a|claro|claro|auvnmnnC] </aaif:annoText></aaif:Phrase><aaif:Subject rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En86Ph1Su1"><aaif:text>el artista</aaif:text><aaif:position rdf:datatype="http://www.w3.org/2001/XMLSchema#int">1</aaif:position><aaif:gender rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Masculine" /><aaif:number rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Singular" /><aaif:overt rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</aaif:overt></aaif:Subject><aaif:Verb rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En86Ph1Ve1"><aaif:text>pronunció</aaif:text><aaif:lemma rdf:resource="https://gams.uni-graz.at/o:aaif.lemma#pronunciar" /><aaif:position rdf:datatype="http://www.w3.org/2001/XMLSchema#int">2</aaif:position><aaif:coordinated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:coordinated><aaif:partOfText rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</aaif:partOfText><aaif:syntacticConstruction rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Transitive" /></aaif:Verb><aaif:Adverb rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En86Ph1Ad1"><aaif:text>alto</aaif:text><aaif:lemma rdf:resource="https://gams.uni-graz.at/o:aaif.lemma#alto" /><aaif:position rdf:datatype="http://www.w3.org/2001/XMLSchema#int">3</aaif:position><aaif:coordinated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</aaif:coordinated><aaif:morphosyntacticStructure rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Adjective" /><aaif:inflection rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Uninflected" /><aaif:attributionTarget rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Verb" /><aaif:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:modified><aaif:semanticClassification rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Manner" /><aaif:reduplicated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:reduplicated><aaif:prepositionalPhrase rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:prepositionalPhrase></aaif:Adverb><aaif:Adverb rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En86Ph1Ad2"><aaif:text>claro</aaif:text><aaif:lemma rdf:resource="https://gams.uni-graz.at/o:aaif.lemma#claro" /><aaif:position rdf:datatype="http://www.w3.org/2001/XMLSchema#int">4</aaif:position><aaif:coordinated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</aaif:coordinated><aaif:morphosyntacticStructure rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Adjective" /><aaif:inflection rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Uninflected" /><aaif:attributionTarget rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Verb" /><aaif:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:modified><aaif:semanticClassification rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Manner" /><aaif:reduplicated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:reduplicated><aaif:prepositionalPhrase rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:prepositionalPhrase></aaif:Adverb><aaif:Entry rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En87"><aaif:phrase rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh#En87Ph1" /><aaif:source rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh.bibl#Cnde224" /><gams:textualContent>lejano saludo de las novedades mundanas que ella conocía. Mariflor miraba á los ojos de la gente; reía alto , lucía el florido cabello peinado á la moda de las ciudades; tenía pensamientos pulidos, ideas bizarras que</gams:textualContent><rel:isPartOf rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh" /></aaif:Entry><aaif:Phrase rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En87Ph1"><aaif:subject rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh#En87Ph1Su1" /><aaif:verb rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh#En87Ph1Ve1" /><aaif:adverb rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh#En87Ph1Ad1" /><aaif:text> Mariflor miraba á los ojos de la gente; reía alto </aaif:text><aaif:annoText> [s|Mariflor|fs] miraba á los ojos de la gente; [v|reía|reír|is] [a|alto|alto|auvnmnnn] </aaif:annoText></aaif:Phrase><aaif:Subject rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En87Ph1Su1"><aaif:text>Mariflor</aaif:text><aaif:position rdf:datatype="http://www.w3.org/2001/XMLSchema#int">1</aaif:position><aaif:gender rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Feminine" /><aaif:number rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Singular" /><aaif:overt rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</aaif:overt></aaif:Subject><aaif:Verb rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En87Ph1Ve1"><aaif:text>reía</aaif:text><aaif:lemma rdf:resource="https://gams.uni-graz.at/o:aaif.lemma#reír" /><aaif:position rdf:datatype="http://www.w3.org/2001/XMLSchema#int">2</aaif:position><aaif:coordinated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:coordinated><aaif:partOfText rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</aaif:partOfText><aaif:syntacticConstruction rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Intransitive" /></aaif:Verb><aaif:Adverb rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En87Ph1Ad1"><aaif:text>alto</aaif:text><aaif:lemma rdf:resource="https://gams.uni-graz.at/o:aaif.lemma#alto" /><aaif:position rdf:datatype="http://www.w3.org/2001/XMLSchema#int">3</aaif:position><aaif:coordinated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:coordinated><aaif:morphosyntacticStructure rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Adjective" /><aaif:inflection rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Uninflected" /><aaif:attributionTarget rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Verb" /><aaif:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:modified><aaif:semanticClassification rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Manner" /><aaif:reduplicated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:reduplicated><aaif:prepositionalPhrase rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:prepositionalPhrase></aaif:Adverb><aaif:Entry rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En88"><aaif:phrase rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh#En88Ph1" /><aaif:source rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh.bibl#Cnde30" /><gams:textualContent> Lolilla, la tonta,  dice alto por las puertas y ventanas, que no hay tales perros rabiosos, y que nuestro alcalde actual, así como</gams:textualContent><rel:isPartOf rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh" /></aaif:Entry><aaif:Phrase rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En88Ph1"><aaif:subject rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh#En88Ph1Su1" /><aaif:verb rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh#En88Ph1Ve1" /><aaif:adverb rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh#En88Ph1Ad1" /><aaif:text> Lolilla, la tonta,  dice alto por las puertas y ventanas</aaif:text><aaif:annoText> [s|Lolilla, la tonta,|fs]  [v|dice|decir|ts] [a|alto|alto|auvnmnnn] por las puertas y ventanas</aaif:annoText></aaif:Phrase><aaif:Subject rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En88Ph1Su1"><aaif:text>Lolilla, la tonta,</aaif:text><aaif:position rdf:datatype="http://www.w3.org/2001/XMLSchema#int">1</aaif:position><aaif:gender rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Feminine" /><aaif:number rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Singular" /><aaif:overt rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</aaif:overt></aaif:Subject><aaif:Verb rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En88Ph1Ve1"><aaif:text>dice</aaif:text><aaif:lemma rdf:resource="https://gams.uni-graz.at/o:aaif.lemma#decir" /><aaif:position rdf:datatype="http://www.w3.org/2001/XMLSchema#int">2</aaif:position><aaif:coordinated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:coordinated><aaif:partOfText rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</aaif:partOfText><aaif:syntacticConstruction rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Transitive" /></aaif:Verb><aaif:Adverb rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En88Ph1Ad1"><aaif:text>alto</aaif:text><aaif:lemma rdf:resource="https://gams.uni-graz.at/o:aaif.lemma#alto" /><aaif:position rdf:datatype="http://www.w3.org/2001/XMLSchema#int">3</aaif:position><aaif:coordinated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:coordinated><aaif:morphosyntacticStructure rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Adjective" /><aaif:inflection rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Uninflected" /><aaif:attributionTarget rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Verb" /><aaif:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:modified><aaif:semanticClassification rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Manner" /><aaif:reduplicated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:reduplicated><aaif:prepositionalPhrase rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:prepositionalPhrase></aaif:Adverb><aaif:Entry rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En89"><aaif:phrase rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh#En89Ph1" /><aaif:source rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh.bibl#Cnde522" /><gams:textualContent>invocar a Dios, o ver, como la mancha íbase aproximando. La mancha , por de pronto, volaba bastante alto .Un chispazo de esperanza prendió en medio de aquel hondo desconsuelo.</gams:textualContent><rel:isPartOf rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh" /></aaif:Entry><aaif:Phrase rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En89Ph1"><aaif:subject rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh#En89Ph1Su1" /><aaif:verb rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh#En89Ph1Ve1" /><aaif:adverb rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh#En89Ph1Ad1" /><aaif:text> La mancha , por de pronto, volaba bastante alto </aaif:text><aaif:annoText> [s|La mancha|fs] , por de pronto, [v|volaba|volar|is] bastante [a|alto|alto|auvmlnnn] </aaif:annoText></aaif:Phrase><aaif:Subject rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En89Ph1Su1"><aaif:text>La mancha</aaif:text><aaif:position rdf:datatype="http://www.w3.org/2001/XMLSchema#int">1</aaif:position><aaif:gender rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Feminine" /><aaif:number rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Singular" /><aaif:overt rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</aaif:overt></aaif:Subject><aaif:Verb rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En89Ph1Ve1"><aaif:text>volaba</aaif:text><aaif:lemma rdf:resource="https://gams.uni-graz.at/o:aaif.lemma#volar" /><aaif:position rdf:datatype="http://www.w3.org/2001/XMLSchema#int">2</aaif:position><aaif:coordinated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:coordinated><aaif:partOfText rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</aaif:partOfText><aaif:syntacticConstruction rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Intransitive" /></aaif:Verb><aaif:Adverb rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En89Ph1Ad1"><aaif:text>alto</aaif:text><aaif:lemma rdf:resource="https://gams.uni-graz.at/o:aaif.lemma#alto" /><aaif:position rdf:datatype="http://www.w3.org/2001/XMLSchema#int">3</aaif:position><aaif:coordinated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:coordinated><aaif:morphosyntacticStructure rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Adjective" /><aaif:inflection rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Uninflected" /><aaif:attributionTarget rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Verb" /><aaif:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</aaif:modified><aaif:semanticClassification rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Location" /><aaif:reduplicated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:reduplicated><aaif:prepositionalPhrase rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:prepositionalPhrase></aaif:Adverb><aaif:Entry rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En90"><aaif:phrase rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh#En90Ph1" /><aaif:source rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh.bibl#Cnde522" /><gams:textualContent>permitido percatarse de la fuga de sus semejantes. Otros, los más medrosos seguramente, se han elevado , alto, bien alto , y allá se quedan, entre al esplendor del luminoso azul, describiendo dilatados </gams:textualContent><rel:isPartOf rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh" /></aaif:Entry><aaif:Phrase rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En90Ph1"><aaif:subject rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh#En90Ph1Su1" /><aaif:verb rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh#En90Ph1Ve1" /><aaif:adverb rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh#En90Ph1Ad1" /><aaif:text> Otros, los más medrosos seguramente, se han elevado , alto, bien alto </aaif:text><aaif:annoText> [s|Otros, los más medrosos seguramente,|mp] se [v|han elevado|elevar|rs] , alto, bien [a|alto|alto|auvmlrnn] </aaif:annoText></aaif:Phrase><aaif:Subject rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En90Ph1Su1"><aaif:text>Otros, los más medrosos seguramente,</aaif:text><aaif:position rdf:datatype="http://www.w3.org/2001/XMLSchema#int">1</aaif:position><aaif:gender rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Masculine" /><aaif:number rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Plural" /><aaif:overt rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</aaif:overt></aaif:Subject><aaif:Verb rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En90Ph1Ve1"><aaif:text>han elevado</aaif:text><aaif:lemma rdf:resource="https://gams.uni-graz.at/o:aaif.lemma#elevar" /><aaif:position rdf:datatype="http://www.w3.org/2001/XMLSchema#int">2</aaif:position><aaif:coordinated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:coordinated><aaif:partOfText rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</aaif:partOfText><aaif:syntacticConstruction rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Reflexive" /></aaif:Verb><aaif:Adverb rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En90Ph1Ad1"><aaif:text>alto</aaif:text><aaif:lemma rdf:resource="https://gams.uni-graz.at/o:aaif.lemma#alto" /><aaif:position rdf:datatype="http://www.w3.org/2001/XMLSchema#int">3</aaif:position><aaif:coordinated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:coordinated><aaif:morphosyntacticStructure rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Adjective" /><aaif:inflection rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Uninflected" /><aaif:attributionTarget rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Verb" /><aaif:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</aaif:modified><aaif:semanticClassification rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Location" /><aaif:reduplicated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</aaif:reduplicated><aaif:prepositionalPhrase rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:prepositionalPhrase></aaif:Adverb><aaif:Entry rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En91"><aaif:phrase rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh#En91Ph1" /><aaif:source rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh.bibl#Cnde559" /><gams:textualContent>, sorprendió a un sujeto en actitud sospechosa y que llevaba un paquete bajo el brazo.Al intimarle alto , el desconocido echó a correr desapareciendo en uno de los terrenos baldíos que hay en las calles inmediatas a </gams:textualContent><rel:isPartOf rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh" /></aaif:Entry><aaif:Phrase rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En91Ph1"><aaif:verb rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh#En91Ph1Ve1" /><aaif:adverb rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh#En91Ph1Ad1" /><aaif:text>Al intimarle alto , el desconocido echó a correr</aaif:text><aaif:annoText>Al [v|intimarle|intimar|ts] [a|alto|alto|auvnqnnn] , el desconocido echó a correr</aaif:annoText></aaif:Phrase><aaif:Verb rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En91Ph1Ve1"><aaif:text>intimarle</aaif:text><aaif:lemma rdf:resource="https://gams.uni-graz.at/o:aaif.lemma#intimar" /><aaif:position rdf:datatype="http://www.w3.org/2001/XMLSchema#int">1</aaif:position><aaif:coordinated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:coordinated><aaif:partOfText rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</aaif:partOfText><aaif:syntacticConstruction rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Transitive" /></aaif:Verb><aaif:Adverb rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En91Ph1Ad1"><aaif:text>alto</aaif:text><aaif:lemma rdf:resource="https://gams.uni-graz.at/o:aaif.lemma#alto" /><aaif:position rdf:datatype="http://www.w3.org/2001/XMLSchema#int">2</aaif:position><aaif:coordinated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:coordinated><aaif:morphosyntacticStructure rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Adjective" /><aaif:inflection rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Uninflected" /><aaif:attributionTarget rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Verb" /><aaif:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:modified><aaif:semanticClassification rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Quantity" /><aaif:reduplicated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:reduplicated><aaif:prepositionalPhrase rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:prepositionalPhrase></aaif:Adverb><aaif:Entry rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En92"><aaif:phrase rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh#En92Ph1" /><aaif:source rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh.bibl#Cnde560" /><gams:textualContent>Grano de oro a fondo negro &lt;lb/&gt;aviento &lt;lb/&gt;con un cósmico temblor.&lt;lb/&gt;Sembrar en el campo aéreo, &lt;lb/&gt; crecer  alto a flor sutil.&lt;lb/&gt;Sudó la tierra y el paso &lt;lb/&gt;o acaso &lt;lb/&gt;del rojo cedía al gris. </gams:textualContent><rel:isPartOf rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh" /></aaif:Entry><aaif:Phrase rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En92Ph1"><aaif:verb rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh#En92Ph1Ve1" /><aaif:adverb rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh#En92Ph1Ad1" /><aaif:text> crecer  alto a flor sutil</aaif:text><aaif:annoText> [v|crecer|crecer|is]  [a|alto|alto|auvnlnnn] a flor sutil</aaif:annoText></aaif:Phrase><aaif:Verb rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En92Ph1Ve1"><aaif:text>crecer</aaif:text><aaif:lemma rdf:resource="https://gams.uni-graz.at/o:aaif.lemma#crecer" /><aaif:position rdf:datatype="http://www.w3.org/2001/XMLSchema#int">1</aaif:position><aaif:coordinated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:coordinated><aaif:partOfText rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</aaif:partOfText><aaif:syntacticConstruction rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Intransitive" /></aaif:Verb><aaif:Adverb rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En92Ph1Ad1"><aaif:text>alto</aaif:text><aaif:lemma rdf:resource="https://gams.uni-graz.at/o:aaif.lemma#alto" /><aaif:position rdf:datatype="http://www.w3.org/2001/XMLSchema#int">2</aaif:position><aaif:coordinated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:coordinated><aaif:morphosyntacticStructure rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Adjective" /><aaif:inflection rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Uninflected" /><aaif:attributionTarget rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Verb" /><aaif:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:modified><aaif:semanticClassification rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Location" /><aaif:reduplicated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:reduplicated><aaif:prepositionalPhrase rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:prepositionalPhrase></aaif:Adverb><aaif:Entry rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En93"><aaif:phrase rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh#En93Ph1" /><aaif:source rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh.bibl#Cnde35" /><gams:textualContent>Llevaba los ojos en alto, apenas si advertía los torsos negros y las cabezas lanosas que se doblaban saludándolo. Iba  alto y orgulloso .Se sentía como señoreando los hombres y las cosas.Hubiera querido destruir para poner a prueba su</gams:textualContent><rel:isPartOf rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh" /></aaif:Entry><aaif:Phrase rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En93Ph1"><aaif:verb rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh#En93Ph1Ve1" /><aaif:adverb rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh#En93Ph1Ad1" /><aaif:adverb rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh#En93Ph1Ad2" /><aaif:text> Iba  alto y orgulloso </aaif:text><aaif:annoText> [v|Iba|ir|is]  [a|alto|alto|ausnmnnC] y [a|orgulloso|orgulloso|ausnmnnC] </aaif:annoText></aaif:Phrase><aaif:Verb rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En93Ph1Ve1"><aaif:text>Iba</aaif:text><aaif:lemma rdf:resource="https://gams.uni-graz.at/o:aaif.lemma#ir" /><aaif:position rdf:datatype="http://www.w3.org/2001/XMLSchema#int">1</aaif:position><aaif:coordinated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:coordinated><aaif:partOfText rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</aaif:partOfText><aaif:syntacticConstruction rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Intransitive" /></aaif:Verb><aaif:Adverb rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En93Ph1Ad1"><aaif:text>alto</aaif:text><aaif:lemma rdf:resource="https://gams.uni-graz.at/o:aaif.lemma#alto" /><aaif:position rdf:datatype="http://www.w3.org/2001/XMLSchema#int">2</aaif:position><aaif:coordinated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</aaif:coordinated><aaif:morphosyntacticStructure rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Adjective" /><aaif:inflection rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Uninflected" /><aaif:attributionTarget rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Verb" /><aaif:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:modified><aaif:semanticClassification rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Manner" /><aaif:reduplicated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:reduplicated><aaif:prepositionalPhrase rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:prepositionalPhrase></aaif:Adverb><aaif:Adverb rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En93Ph1Ad2"><aaif:text>orgulloso</aaif:text><aaif:lemma rdf:resource="https://gams.uni-graz.at/o:aaif.lemma#orgulloso" /><aaif:position rdf:datatype="http://www.w3.org/2001/XMLSchema#int">3</aaif:position><aaif:coordinated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</aaif:coordinated><aaif:morphosyntacticStructure rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Adjective" /><aaif:inflection rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Uninflected" /><aaif:attributionTarget rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Verb" /><aaif:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:modified><aaif:semanticClassification rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Manner" /><aaif:reduplicated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:reduplicated><aaif:prepositionalPhrase rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:prepositionalPhrase></aaif:Adverb><aaif:Entry rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En94"><aaif:phrase rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh#En94Ph1" /><aaif:source rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh.bibl#Cnde35" /><gams:textualContent>El cielo se despejaba perezosamente. El sol  iba alto  y su luz bañaba todas las cosas.Los ojos convergían en la hondonada del camino, de donde</gams:textualContent><rel:isPartOf rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh" /></aaif:Entry><aaif:Phrase rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En94Ph1"><aaif:subject rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh#En94Ph1Su1" /><aaif:verb rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh#En94Ph1Ve1" /><aaif:adverb rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh#En94Ph1Ad1" /><aaif:text> El sol  iba alto </aaif:text><aaif:annoText> [s|El sol|ms]  [v|iba|ir|is] [a|alto|alto|auvnlnnn] </aaif:annoText></aaif:Phrase><aaif:Subject rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En94Ph1Su1"><aaif:text>El sol</aaif:text><aaif:position rdf:datatype="http://www.w3.org/2001/XMLSchema#int">1</aaif:position><aaif:gender rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Masculine" /><aaif:number rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Singular" /><aaif:overt rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</aaif:overt></aaif:Subject><aaif:Verb rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En94Ph1Ve1"><aaif:text>iba</aaif:text><aaif:lemma rdf:resource="https://gams.uni-graz.at/o:aaif.lemma#ir" /><aaif:position rdf:datatype="http://www.w3.org/2001/XMLSchema#int">2</aaif:position><aaif:coordinated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:coordinated><aaif:partOfText rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</aaif:partOfText><aaif:syntacticConstruction rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Intransitive" /></aaif:Verb><aaif:Adverb rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En94Ph1Ad1"><aaif:text>alto</aaif:text><aaif:lemma rdf:resource="https://gams.uni-graz.at/o:aaif.lemma#alto" /><aaif:position rdf:datatype="http://www.w3.org/2001/XMLSchema#int">3</aaif:position><aaif:coordinated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:coordinated><aaif:morphosyntacticStructure rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Adjective" /><aaif:inflection rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Uninflected" /><aaif:attributionTarget rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Verb" /><aaif:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:modified><aaif:semanticClassification rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Location" /><aaif:reduplicated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:reduplicated><aaif:prepositionalPhrase rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:prepositionalPhrase></aaif:Adverb><aaif:Entry rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En95"><aaif:phrase rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh#En95Ph1" /><aaif:source rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh.bibl#Cnde256" /><gams:textualContent>hasta que, no con la sospecha, sino con el firme convencimiento de que Mangacha lo engañaba,  agregó  alto por oírse él mismo: </gams:textualContent><rel:isPartOf rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh" /></aaif:Entry><aaif:Phrase rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En95Ph1"><aaif:verb rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh#En95Ph1Ve1" /><aaif:adverb rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh#En95Ph1Ad1" /><aaif:text> agregó  alto por oírse él mismo:</aaif:text><aaif:annoText> [v|agregó|agregar|ts]  [a|alto|alto|auvnmnnn] por oírse él mismo:</aaif:annoText></aaif:Phrase><aaif:Verb rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En95Ph1Ve1"><aaif:text>agregó</aaif:text><aaif:lemma rdf:resource="https://gams.uni-graz.at/o:aaif.lemma#agregar" /><aaif:position rdf:datatype="http://www.w3.org/2001/XMLSchema#int">1</aaif:position><aaif:coordinated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:coordinated><aaif:partOfText rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</aaif:partOfText><aaif:syntacticConstruction rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Transitive" /></aaif:Verb><aaif:Adverb rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En95Ph1Ad1"><aaif:text>alto</aaif:text><aaif:lemma rdf:resource="https://gams.uni-graz.at/o:aaif.lemma#alto" /><aaif:position rdf:datatype="http://www.w3.org/2001/XMLSchema#int">2</aaif:position><aaif:coordinated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:coordinated><aaif:morphosyntacticStructure rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Adjective" /><aaif:inflection rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Uninflected" /><aaif:attributionTarget rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Verb" /><aaif:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:modified><aaif:semanticClassification rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Manner" /><aaif:reduplicated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:reduplicated><aaif:prepositionalPhrase rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:prepositionalPhrase></aaif:Adverb><aaif:Entry rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En96"><aaif:phrase rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh#En96Ph1" /><aaif:source rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh.bibl#Cnde43" /><gams:textualContent>Madre No es día de hablar alto .Callando se recuerda mejor.</gams:textualContent><rel:isPartOf rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh" /></aaif:Entry><aaif:Phrase rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En96Ph1"><aaif:verb rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh#En96Ph1Ve1" /><aaif:adverb rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh#En96Ph1Ad1" /><aaif:text>No es día de hablar alto </aaif:text><aaif:annoText>No es día de [v|hablar|hablar|is] [a|alto|alto|auvnmnnn] </aaif:annoText></aaif:Phrase><aaif:Verb rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En96Ph1Ve1"><aaif:text>hablar</aaif:text><aaif:lemma rdf:resource="https://gams.uni-graz.at/o:aaif.lemma#hablar" /><aaif:position rdf:datatype="http://www.w3.org/2001/XMLSchema#int">1</aaif:position><aaif:coordinated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:coordinated><aaif:partOfText rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</aaif:partOfText><aaif:syntacticConstruction rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Intransitive" /></aaif:Verb><aaif:Adverb rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En96Ph1Ad1"><aaif:text>alto</aaif:text><aaif:lemma rdf:resource="https://gams.uni-graz.at/o:aaif.lemma#alto" /><aaif:position rdf:datatype="http://www.w3.org/2001/XMLSchema#int">2</aaif:position><aaif:coordinated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:coordinated><aaif:morphosyntacticStructure rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Adjective" /><aaif:inflection rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Uninflected" /><aaif:attributionTarget rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Verb" /><aaif:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:modified><aaif:semanticClassification rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Manner" /><aaif:reduplicated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:reduplicated><aaif:prepositionalPhrase rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:prepositionalPhrase></aaif:Adverb><aaif:Entry rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En97"><aaif:phrase rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh#En97Ph1" /><aaif:source rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh.bibl#Cnde2" /><gams:textualContent>como si se viera desde una torre celestial. ¿Cómo verlo desde más alto? ¡ Subir , subir más alto , contra esas nubes percudidas, contra ese cielo raso: muro de cárcel!¡Volar alto, más alto, con los brazos tendidos, brincando sobre los nervios de las piernas!</gams:textualContent><rel:isPartOf rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh" /></aaif:Entry><aaif:Phrase rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En97Ph1"><aaif:verb rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh#En97Ph1Ve1" /><aaif:adverb rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh#En97Ph1Ad1" /><aaif:text> Subir , subir más alto </aaif:text><aaif:annoText> [v|Subir|subir|is] , subir más [a|alto|alto|auvmlnnn] </aaif:annoText></aaif:Phrase><aaif:Verb rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En97Ph1Ve1"><aaif:text>Subir</aaif:text><aaif:lemma rdf:resource="https://gams.uni-graz.at/o:aaif.lemma#subir" /><aaif:position rdf:datatype="http://www.w3.org/2001/XMLSchema#int">1</aaif:position><aaif:coordinated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</aaif:coordinated><aaif:partOfText rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</aaif:partOfText><aaif:syntacticConstruction rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Intransitive" /></aaif:Verb><aaif:Adverb rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En97Ph1Ad1"><aaif:text>alto</aaif:text><aaif:lemma rdf:resource="https://gams.uni-graz.at/o:aaif.lemma#alto" /><aaif:position rdf:datatype="http://www.w3.org/2001/XMLSchema#int">2</aaif:position><aaif:coordinated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:coordinated><aaif:morphosyntacticStructure rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Adjective" /><aaif:inflection rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Uninflected" /><aaif:attributionTarget rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Verb" /><aaif:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</aaif:modified><aaif:semanticClassification rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Location" /><aaif:reduplicated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:reduplicated><aaif:prepositionalPhrase rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:prepositionalPhrase></aaif:Adverb><aaif:Entry rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En98"><aaif:phrase rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh#En98Ph1" /><aaif:source rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh.bibl#Cnde2" /><gams:textualContent>subir más alto, contra esas nubes percudidas, contra ese cielo raso: muro de cárcel!¡ Volar alto, más alto , con los brazos tendidos, brincando sobre los nervios de las piernas!</gams:textualContent><rel:isPartOf rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh" /></aaif:Entry><aaif:Phrase rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En98Ph1"><aaif:verb rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh#En98Ph1Ve1" /><aaif:adverb rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh#En98Ph1Ad1" /><aaif:text> Volar alto, más alto ,</aaif:text><aaif:annoText> [v|Volar|volar|is] alto, más [a|alto|alto|auvmlrnn] ,</aaif:annoText></aaif:Phrase><aaif:Verb rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En98Ph1Ve1"><aaif:text>Volar</aaif:text><aaif:lemma rdf:resource="https://gams.uni-graz.at/o:aaif.lemma#volar" /><aaif:position rdf:datatype="http://www.w3.org/2001/XMLSchema#int">1</aaif:position><aaif:coordinated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:coordinated><aaif:partOfText rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</aaif:partOfText><aaif:syntacticConstruction rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Intransitive" /></aaif:Verb><aaif:Adverb rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En98Ph1Ad1"><aaif:text>alto</aaif:text><aaif:lemma rdf:resource="https://gams.uni-graz.at/o:aaif.lemma#alto" /><aaif:position rdf:datatype="http://www.w3.org/2001/XMLSchema#int">2</aaif:position><aaif:coordinated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:coordinated><aaif:morphosyntacticStructure rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Adjective" /><aaif:inflection rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Uninflected" /><aaif:attributionTarget rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Verb" /><aaif:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</aaif:modified><aaif:semanticClassification rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Location" /><aaif:reduplicated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</aaif:reduplicated><aaif:prepositionalPhrase rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:prepositionalPhrase></aaif:Adverb><aaif:Entry rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En99"><aaif:phrase rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh#En99Ph1" /><aaif:source rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh.bibl#Cnde561" /><gams:textualContent>aquellos que desde la nave &lt;lb/&gt;escucharon &lt;lb/&gt;sal, soledad y noche reunirse, &lt;lb/&gt;oirán el coro de González Calbalho surgir alto y cristalino  &lt;lb/&gt;desde su primavera nocturna.&lt;lb/&gt;Recordáis otro?Príncipe de Aquitania: a su torre &lt;lb/&gt;abolida, </gams:textualContent><rel:isPartOf rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh" /></aaif:Entry><aaif:Phrase rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En99Ph1"><aaif:subject rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh#En99Ph1Su1" /><aaif:verb rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh#En99Ph1Ve1" /><aaif:adverb rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh#En99Ph1Ad1" /><aaif:adverb rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh#En99Ph1Ad2" /><aaif:text>oirán el coro de González Calbalho surgir alto y cristalino </aaif:text><aaif:annoText>oirán [s|el coro de González Calbalho|ms] [v|surgir|surgir|is] [a|alto|alto|ausnmnnC] y [a|cristalino|cristalino|ausnmnnC] </aaif:annoText></aaif:Phrase><aaif:Subject rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En99Ph1Su1"><aaif:text>el coro de González Calbalho</aaif:text><aaif:position rdf:datatype="http://www.w3.org/2001/XMLSchema#int">1</aaif:position><aaif:gender rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Masculine" /><aaif:number rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Singular" /><aaif:overt rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</aaif:overt></aaif:Subject><aaif:Verb rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En99Ph1Ve1"><aaif:text>surgir</aaif:text><aaif:lemma rdf:resource="https://gams.uni-graz.at/o:aaif.lemma#surgir" /><aaif:position rdf:datatype="http://www.w3.org/2001/XMLSchema#int">2</aaif:position><aaif:coordinated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:coordinated><aaif:partOfText rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</aaif:partOfText><aaif:syntacticConstruction rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Intransitive" /></aaif:Verb><aaif:Adverb rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En99Ph1Ad1"><aaif:text>alto</aaif:text><aaif:lemma rdf:resource="https://gams.uni-graz.at/o:aaif.lemma#alto" /><aaif:position rdf:datatype="http://www.w3.org/2001/XMLSchema#int">3</aaif:position><aaif:coordinated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</aaif:coordinated><aaif:morphosyntacticStructure rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Adjective" /><aaif:inflection rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Uninflected" /><aaif:attributionTarget rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Verb" /><aaif:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:modified><aaif:semanticClassification rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Manner" /><aaif:reduplicated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:reduplicated><aaif:prepositionalPhrase rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:prepositionalPhrase></aaif:Adverb><aaif:Adverb rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En99Ph1Ad2"><aaif:text>cristalino</aaif:text><aaif:lemma rdf:resource="https://gams.uni-graz.at/o:aaif.lemma#cristalino" /><aaif:position rdf:datatype="http://www.w3.org/2001/XMLSchema#int">4</aaif:position><aaif:coordinated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</aaif:coordinated><aaif:morphosyntacticStructure rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Adjective" /><aaif:inflection rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Uninflected" /><aaif:attributionTarget rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Verb" /><aaif:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:modified><aaif:semanticClassification rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Manner" /><aaif:reduplicated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:reduplicated><aaif:prepositionalPhrase rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:prepositionalPhrase></aaif:Adverb><aaif:Entry rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En100"><aaif:phrase rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh#En100Ph1" /><aaif:source rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh.bibl#Cnde524" /><gams:textualContent>, la que abrazó y besó a su padre a la vez que le hacía una seña para que no hablase alto  indicando a Ramón que aún dormía en el catre, bajo la parralera.Se dirigieron hacia el interior de </gams:textualContent><rel:isPartOf rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh" /></aaif:Entry><aaif:Phrase rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En100Ph1"><aaif:verb rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh#En100Ph1Ve1" /><aaif:adverb rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh#En100Ph1Ad1" /><aaif:text>para que no hablase alto </aaif:text><aaif:annoText>para que no [v|hablase|hablar|is] [a|alto|alto|auvnmnnn] </aaif:annoText></aaif:Phrase><aaif:Verb rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En100Ph1Ve1"><aaif:text>hablase</aaif:text><aaif:lemma rdf:resource="https://gams.uni-graz.at/o:aaif.lemma#hablar" /><aaif:position rdf:datatype="http://www.w3.org/2001/XMLSchema#int">1</aaif:position><aaif:coordinated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:coordinated><aaif:partOfText rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</aaif:partOfText><aaif:syntacticConstruction rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Intransitive" /></aaif:Verb><aaif:Adverb rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En100Ph1Ad1"><aaif:text>alto</aaif:text><aaif:lemma rdf:resource="https://gams.uni-graz.at/o:aaif.lemma#alto" /><aaif:position rdf:datatype="http://www.w3.org/2001/XMLSchema#int">2</aaif:position><aaif:coordinated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:coordinated><aaif:morphosyntacticStructure rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Adjective" /><aaif:inflection rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Uninflected" /><aaif:attributionTarget rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Verb" /><aaif:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:modified><aaif:semanticClassification rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Manner" /><aaif:reduplicated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:reduplicated><aaif:prepositionalPhrase rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:prepositionalPhrase></aaif:Adverb><aaif:Entry rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En101"><aaif:phrase rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh#En101Ph1" /><aaif:source rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh.bibl#Cnde407" /><gams:textualContent>los comían por dentro, * sacándoles las tripas, hasta dejar la pura cáscara.Y como   los colgaban alto , allá se estaban campaneándose al soplo del aire muchos días, a veces meses, a veces ya nada</gams:textualContent><rel:isPartOf rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh" /></aaif:Entry><aaif:Phrase rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En101Ph1"><aaif:subject rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh#En101Ph1Su1" /><aaif:verb rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh#En101Ph1Ve1" /><aaif:adverb rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh#En101Ph1Ad1" /><aaif:text>  los colgaban alto </aaif:text><aaif:annoText> [s||up] los [v|colgaban|colgar|ts] [a|alto|alto|auvnlnnn] </aaif:annoText></aaif:Phrase><aaif:Subject rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En101Ph1Su1"><aaif:position rdf:datatype="http://www.w3.org/2001/XMLSchema#int">1</aaif:position><aaif:gender rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Undefined" /><aaif:number rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Plural" /><aaif:overt rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:overt></aaif:Subject><aaif:Verb rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En101Ph1Ve1"><aaif:text>colgaban</aaif:text><aaif:lemma rdf:resource="https://gams.uni-graz.at/o:aaif.lemma#colgar" /><aaif:position rdf:datatype="http://www.w3.org/2001/XMLSchema#int">2</aaif:position><aaif:coordinated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:coordinated><aaif:partOfText rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</aaif:partOfText><aaif:syntacticConstruction rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Transitive" /></aaif:Verb><aaif:Adverb rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En101Ph1Ad1"><aaif:text>alto</aaif:text><aaif:lemma rdf:resource="https://gams.uni-graz.at/o:aaif.lemma#alto" /><aaif:position rdf:datatype="http://www.w3.org/2001/XMLSchema#int">3</aaif:position><aaif:coordinated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:coordinated><aaif:morphosyntacticStructure rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Adjective" /><aaif:inflection rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Uninflected" /><aaif:attributionTarget rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Verb" /><aaif:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:modified><aaif:semanticClassification rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Location" /><aaif:reduplicated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:reduplicated><aaif:prepositionalPhrase rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:prepositionalPhrase></aaif:Adverb><aaif:Entry rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En102"><aaif:phrase rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh#En102Ph1" /><aaif:source rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh.bibl#Cnde48" /><gams:textualContent> El que espera la mañana ... &lt;lb/&gt; mira , alto al cielo, y nada ve.&lt;lb/&gt;Ella en tanto está cayendo &lt;lb/&gt;y todas las flores lo saben. </gams:textualContent><rel:isPartOf rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh" /></aaif:Entry><aaif:Phrase rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En102Ph1"><aaif:subject rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh#En102Ph1Su1" /><aaif:verb rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh#En102Ph1Ve1" /><aaif:adverb rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh#En102Ph1Ad1" /><aaif:text> El que espera la mañana ... &lt;lb\/&gt; mira , alto al cielo, y nada ve</aaif:text><aaif:annoText> [s|El que espera la mañana|ms] ... &lt;lb\/&gt; [v|mira|mirar|is] , [a|alto|alto|auvnlnnn] al cielo, y nada ve</aaif:annoText></aaif:Phrase><aaif:Subject rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En102Ph1Su1"><aaif:text>El que espera la mañana</aaif:text><aaif:position rdf:datatype="http://www.w3.org/2001/XMLSchema#int">1</aaif:position><aaif:gender rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Masculine" /><aaif:number rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Singular" /><aaif:overt rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</aaif:overt></aaif:Subject><aaif:Verb rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En102Ph1Ve1"><aaif:text>mira</aaif:text><aaif:lemma rdf:resource="https://gams.uni-graz.at/o:aaif.lemma#mirar" /><aaif:position rdf:datatype="http://www.w3.org/2001/XMLSchema#int">2</aaif:position><aaif:coordinated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:coordinated><aaif:partOfText rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</aaif:partOfText><aaif:syntacticConstruction rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Intransitive" /></aaif:Verb><aaif:Adverb rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En102Ph1Ad1"><aaif:text>alto</aaif:text><aaif:lemma rdf:resource="https://gams.uni-graz.at/o:aaif.lemma#alto" /><aaif:position rdf:datatype="http://www.w3.org/2001/XMLSchema#int">3</aaif:position><aaif:coordinated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:coordinated><aaif:morphosyntacticStructure rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Adjective" /><aaif:inflection rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Uninflected" /><aaif:attributionTarget rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Verb" /><aaif:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:modified><aaif:semanticClassification rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Location" /><aaif:reduplicated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:reduplicated><aaif:prepositionalPhrase rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:prepositionalPhrase></aaif:Adverb><aaif:Entry rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En103"><aaif:phrase rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh#En103Ph1" /><aaif:source rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh.bibl#Cnde1" /><gams:textualContent>me muero de la vergüenza.Ni los tíos, ni la vieja, me comprenden: que quiero llegar alto , rozarme con lo mejor que ofrece México.¡No, por Dios, no rozarme!Ser lo </gams:textualContent><rel:isPartOf rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh" /></aaif:Entry><aaif:Phrase rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En103Ph1"><aaif:verb rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh#En103Ph1Ve1" /><aaif:adverb rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh#En103Ph1Ad1" /><aaif:text>que quiero llegar alto </aaif:text><aaif:annoText>que quiero [v|llegar|llegar|is] [a|alto|alto|auvnlnnn] </aaif:annoText></aaif:Phrase><aaif:Verb rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En103Ph1Ve1"><aaif:text>llegar</aaif:text><aaif:lemma rdf:resource="https://gams.uni-graz.at/o:aaif.lemma#llegar" /><aaif:position rdf:datatype="http://www.w3.org/2001/XMLSchema#int">1</aaif:position><aaif:coordinated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:coordinated><aaif:partOfText rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</aaif:partOfText><aaif:syntacticConstruction rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Intransitive" /></aaif:Verb><aaif:Adverb rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En103Ph1Ad1"><aaif:text>alto</aaif:text><aaif:lemma rdf:resource="https://gams.uni-graz.at/o:aaif.lemma#alto" /><aaif:position rdf:datatype="http://www.w3.org/2001/XMLSchema#int">2</aaif:position><aaif:coordinated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:coordinated><aaif:morphosyntacticStructure rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Adjective" /><aaif:inflection rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Uninflected" /><aaif:attributionTarget rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Verb" /><aaif:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:modified><aaif:semanticClassification rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Location" /><aaif:reduplicated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:reduplicated><aaif:prepositionalPhrase rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:prepositionalPhrase></aaif:Adverb><aaif:Entry rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En104"><aaif:phrase rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh#En104Ph1" /><aaif:source rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh.bibl#Cnde1" /><gams:textualContent>suspiró doña Serena—.Y qué le vamos a hacer.¡Nosotros tampoco fuimos como los que llegaron alto !Se acuerda, compadre, cuando todos salimos de las mismas rancherías, de los mismos pueblos, todos </gams:textualContent><rel:isPartOf rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh" /></aaif:Entry><aaif:Phrase rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En104Ph1"><aaif:subject rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh#En104Ph1Su1" /><aaif:verb rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh#En104Ph1Ve1" /><aaif:adverb rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh#En104Ph1Ad1" /><aaif:text>Nosotros tampoco fuimos como los que llegaron alto </aaif:text><aaif:annoText>Nosotros tampoco fuimos como [s|los que|mp] [v|llegaron|llegar|is] [a|alto|alto|auvnlnnn] </aaif:annoText></aaif:Phrase><aaif:Subject rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En104Ph1Su1"><aaif:text>los que</aaif:text><aaif:position rdf:datatype="http://www.w3.org/2001/XMLSchema#int">1</aaif:position><aaif:gender rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Masculine" /><aaif:number rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Plural" /><aaif:overt rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</aaif:overt></aaif:Subject><aaif:Verb rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En104Ph1Ve1"><aaif:text>llegaron</aaif:text><aaif:lemma rdf:resource="https://gams.uni-graz.at/o:aaif.lemma#llegar" /><aaif:position rdf:datatype="http://www.w3.org/2001/XMLSchema#int">2</aaif:position><aaif:coordinated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:coordinated><aaif:partOfText rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</aaif:partOfText><aaif:syntacticConstruction rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Intransitive" /></aaif:Verb><aaif:Adverb rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En104Ph1Ad1"><aaif:text>alto</aaif:text><aaif:lemma rdf:resource="https://gams.uni-graz.at/o:aaif.lemma#alto" /><aaif:position rdf:datatype="http://www.w3.org/2001/XMLSchema#int">3</aaif:position><aaif:coordinated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:coordinated><aaif:morphosyntacticStructure rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Adjective" /><aaif:inflection rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Uninflected" /><aaif:attributionTarget rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Verb" /><aaif:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:modified><aaif:semanticClassification rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Location" /><aaif:reduplicated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:reduplicated><aaif:prepositionalPhrase rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:prepositionalPhrase></aaif:Adverb><aaif:Entry rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En105"><aaif:phrase rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh#En105Ph1" /><aaif:source rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh.bibl#Cnde1" /><gams:textualContent>todo lo que tenía que hacer (hacer lo que no hizo su padre; haberse aguantado;  todos  llegaron alto ; Calles era maestro de escuela).Y Rodrigo crecía, y yo aumentaba la mentira: era hombre</gams:textualContent><rel:isPartOf rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh" /></aaif:Entry><aaif:Phrase rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En105Ph1"><aaif:subject rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh#En105Ph1Su1" /><aaif:verb rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh#En105Ph1Ve1" /><aaif:adverb rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh#En105Ph1Ad1" /><aaif:text> todos  llegaron alto </aaif:text><aaif:annoText> [s|todos|mp]  [v|llegaron|llegar|is] [a|alto|alto|auvnlnnn] </aaif:annoText></aaif:Phrase><aaif:Subject rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En105Ph1Su1"><aaif:text>todos</aaif:text><aaif:position rdf:datatype="http://www.w3.org/2001/XMLSchema#int">1</aaif:position><aaif:gender rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Masculine" /><aaif:number rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Plural" /><aaif:overt rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</aaif:overt></aaif:Subject><aaif:Verb rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En105Ph1Ve1"><aaif:text>llegaron</aaif:text><aaif:lemma rdf:resource="https://gams.uni-graz.at/o:aaif.lemma#llegar" /><aaif:position rdf:datatype="http://www.w3.org/2001/XMLSchema#int">2</aaif:position><aaif:coordinated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:coordinated><aaif:partOfText rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</aaif:partOfText><aaif:syntacticConstruction rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Intransitive" /></aaif:Verb><aaif:Adverb rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En105Ph1Ad1"><aaif:text>alto</aaif:text><aaif:lemma rdf:resource="https://gams.uni-graz.at/o:aaif.lemma#alto" /><aaif:position rdf:datatype="http://www.w3.org/2001/XMLSchema#int">3</aaif:position><aaif:coordinated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:coordinated><aaif:morphosyntacticStructure rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Adjective" /><aaif:inflection rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Uninflected" /><aaif:attributionTarget rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Verb" /><aaif:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:modified><aaif:semanticClassification rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Location" /><aaif:reduplicated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:reduplicated><aaif:prepositionalPhrase rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:prepositionalPhrase></aaif:Adverb><aaif:Entry rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En106"><aaif:phrase rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh#En106Ph1" /><aaif:source rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh.bibl#Cnde117" /><gams:textualContent>que está untado ese falso aguijón.Al tankayllu no se le puede dar caza fácilmente, pues vuela alto , buscando la flor de los arbustos.Su color es raro, tabaco oscuro; en el vientre lleva</gams:textualContent><rel:isPartOf rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh" /></aaif:Entry><aaif:Phrase rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En106Ph1"><aaif:verb rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh#En106Ph1Ve1" /><aaif:adverb rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh#En106Ph1Ad1" /><aaif:text>pues vuela alto </aaif:text><aaif:annoText>pues [v|vuela|volar|is] [a|alto|alto|auvnlnnn] </aaif:annoText></aaif:Phrase><aaif:Verb rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En106Ph1Ve1"><aaif:text>vuela</aaif:text><aaif:lemma rdf:resource="https://gams.uni-graz.at/o:aaif.lemma#volar" /><aaif:position rdf:datatype="http://www.w3.org/2001/XMLSchema#int">1</aaif:position><aaif:coordinated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:coordinated><aaif:partOfText rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</aaif:partOfText><aaif:syntacticConstruction rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Intransitive" /></aaif:Verb><aaif:Adverb rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En106Ph1Ad1"><aaif:text>alto</aaif:text><aaif:lemma rdf:resource="https://gams.uni-graz.at/o:aaif.lemma#alto" /><aaif:position rdf:datatype="http://www.w3.org/2001/XMLSchema#int">2</aaif:position><aaif:coordinated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:coordinated><aaif:morphosyntacticStructure rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Adjective" /><aaif:inflection rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Uninflected" /><aaif:attributionTarget rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Verb" /><aaif:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:modified><aaif:semanticClassification rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Location" /><aaif:reduplicated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:reduplicated><aaif:prepositionalPhrase rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:prepositionalPhrase></aaif:Adverb><aaif:Entry rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En107"><aaif:phrase rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh#En107Ph1" /><aaif:source rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh.bibl#Cnde117" /><gams:textualContent> Antero lo lanzó alto .El trompo bajó girando.Se posó sobre una de las piedras redondas del piso, cantó agudamente</gams:textualContent><rel:isPartOf rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh" /></aaif:Entry><aaif:Phrase rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En107Ph1"><aaif:subject rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh#En107Ph1Su1" /><aaif:verb rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh#En107Ph1Ve1" /><aaif:adverb rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh#En107Ph1Ad1" /><aaif:text> Antero lo lanzó alto </aaif:text><aaif:annoText> [s|Antero|ms] lo [v|lanzó|lanzar|ts] [a|alto|alto|auvnlnnn] </aaif:annoText></aaif:Phrase><aaif:Subject rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En107Ph1Su1"><aaif:text>Antero</aaif:text><aaif:position rdf:datatype="http://www.w3.org/2001/XMLSchema#int">1</aaif:position><aaif:gender rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Masculine" /><aaif:number rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Singular" /><aaif:overt rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</aaif:overt></aaif:Subject><aaif:Verb rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En107Ph1Ve1"><aaif:text>lanzó</aaif:text><aaif:lemma rdf:resource="https://gams.uni-graz.at/o:aaif.lemma#lanzar" /><aaif:position rdf:datatype="http://www.w3.org/2001/XMLSchema#int">2</aaif:position><aaif:coordinated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:coordinated><aaif:partOfText rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</aaif:partOfText><aaif:syntacticConstruction rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Transitive" /></aaif:Verb><aaif:Adverb rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En107Ph1Ad1"><aaif:text>alto</aaif:text><aaif:lemma rdf:resource="https://gams.uni-graz.at/o:aaif.lemma#alto" /><aaif:position rdf:datatype="http://www.w3.org/2001/XMLSchema#int">3</aaif:position><aaif:coordinated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:coordinated><aaif:morphosyntacticStructure rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Adjective" /><aaif:inflection rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Uninflected" /><aaif:attributionTarget rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Verb" /><aaif:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:modified><aaif:semanticClassification rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Location" /><aaif:reduplicated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:reduplicated><aaif:prepositionalPhrase rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:prepositionalPhrase></aaif:Adverb><aaif:Entry rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En108"><aaif:phrase rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh#En108Ph1" /><aaif:source rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh.bibl#Cnde117" /><gams:textualContent>patio interior, en compañía del "Añuco", y repetir el mensaje a mi padre. Tirar  alto el trompo y, guiándome por el zumbido, recibirlo en la palma de la mano.Lo habría hecho</gams:textualContent><rel:isPartOf rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh" /></aaif:Entry><aaif:Phrase rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En108Ph1"><aaif:verb rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh#En108Ph1Ve1" /><aaif:adverb rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh#En108Ph1Ad1" /><aaif:text> Tirar  alto el trompo</aaif:text><aaif:annoText> [v|Tirar|tirar|ts]  [a|alto|alto|auvnlnnn] el trompo</aaif:annoText></aaif:Phrase><aaif:Verb rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En108Ph1Ve1"><aaif:text>Tirar</aaif:text><aaif:lemma rdf:resource="https://gams.uni-graz.at/o:aaif.lemma#tirar" /><aaif:position rdf:datatype="http://www.w3.org/2001/XMLSchema#int">1</aaif:position><aaif:coordinated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:coordinated><aaif:partOfText rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</aaif:partOfText><aaif:syntacticConstruction rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Transitive" /></aaif:Verb><aaif:Adverb rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En108Ph1Ad1"><aaif:text>alto</aaif:text><aaif:lemma rdf:resource="https://gams.uni-graz.at/o:aaif.lemma#alto" /><aaif:position rdf:datatype="http://www.w3.org/2001/XMLSchema#int">2</aaif:position><aaif:coordinated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:coordinated><aaif:morphosyntacticStructure rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Adjective" /><aaif:inflection rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Uninflected" /><aaif:attributionTarget rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Verb" /><aaif:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:modified><aaif:semanticClassification rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Location" /><aaif:reduplicated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:reduplicated><aaif:prepositionalPhrase rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:prepositionalPhrase></aaif:Adverb><aaif:Entry rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En109"><aaif:phrase rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh#En109Ph1" /><aaif:source rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh.bibl#Cnde49" /><gams:textualContent>sitio, algo especial, que dan ganas de saber lo qué está pensando.Se lo venía explicando bastante alto y con entusiasmo para ver si se lo hacía entender, y de pronto él en persona se nos puso al lado.</gams:textualContent><rel:isPartOf rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh" /></aaif:Entry><aaif:Phrase rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En109Ph1"><aaif:verb rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh#En109Ph1Ve1" /><aaif:adverb rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh#En109Ph1Ad1" /><aaif:text>Se lo venía explicando bastante alto y con entusiasmo</aaif:text><aaif:annoText>Se lo venía [v|explicando|explicar|ts] bastante [a|alto|alto|auvmmnnC] y con entusiasmo</aaif:annoText></aaif:Phrase><aaif:Verb rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En109Ph1Ve1"><aaif:text>explicando</aaif:text><aaif:lemma rdf:resource="https://gams.uni-graz.at/o:aaif.lemma#explicar" /><aaif:position rdf:datatype="http://www.w3.org/2001/XMLSchema#int">1</aaif:position><aaif:coordinated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:coordinated><aaif:partOfText rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</aaif:partOfText><aaif:syntacticConstruction rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Transitive" /></aaif:Verb><aaif:Adverb rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En109Ph1Ad1"><aaif:text>alto</aaif:text><aaif:lemma rdf:resource="https://gams.uni-graz.at/o:aaif.lemma#alto" /><aaif:position rdf:datatype="http://www.w3.org/2001/XMLSchema#int">2</aaif:position><aaif:coordinated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</aaif:coordinated><aaif:morphosyntacticStructure rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Adjective" /><aaif:inflection rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Uninflected" /><aaif:attributionTarget rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Verb" /><aaif:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</aaif:modified><aaif:semanticClassification rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Manner" /><aaif:reduplicated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:reduplicated><aaif:prepositionalPhrase rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:prepositionalPhrase></aaif:Adverb><aaif:Entry rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En110"><aaif:phrase rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh#En110Ph1" /><aaif:source rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh.bibl#Cnde52" /><gams:textualContent>los ladridos iracundos de los galgos.De vez en vez,  un halcón remontaba el vuelo y planeaba , alto y seguro.Mi hijo Marzio andaba de caza con los hijos de León Orsini.Caían aves muertas entre los </gams:textualContent><rel:isPartOf rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh" /></aaif:Entry><aaif:Phrase rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En110Ph1"><aaif:subject rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh#En110Ph1Su1" /><aaif:verb rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh#En110Ph1Ve1" /><aaif:adverb rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh#En110Ph1Ad1" /><aaif:text> un halcón remontaba el vuelo y planeaba , alto y seguro</aaif:text><aaif:annoText> [s|un halcón|ms] remontaba el vuelo y [v|planeaba|planear|is] , [a|alto|alto|auvnmnnC] y seguro</aaif:annoText></aaif:Phrase><aaif:Subject rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En110Ph1Su1"><aaif:text>un halcón</aaif:text><aaif:position rdf:datatype="http://www.w3.org/2001/XMLSchema#int">1</aaif:position><aaif:gender rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Masculine" /><aaif:number rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Singular" /><aaif:overt rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</aaif:overt></aaif:Subject><aaif:Verb rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En110Ph1Ve1"><aaif:text>planeaba</aaif:text><aaif:lemma rdf:resource="https://gams.uni-graz.at/o:aaif.lemma#planear" /><aaif:position rdf:datatype="http://www.w3.org/2001/XMLSchema#int">2</aaif:position><aaif:coordinated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:coordinated><aaif:partOfText rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</aaif:partOfText><aaif:syntacticConstruction rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Intransitive" /></aaif:Verb><aaif:Adverb rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En110Ph1Ad1"><aaif:text>alto</aaif:text><aaif:lemma rdf:resource="https://gams.uni-graz.at/o:aaif.lemma#alto" /><aaif:position rdf:datatype="http://www.w3.org/2001/XMLSchema#int">3</aaif:position><aaif:coordinated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</aaif:coordinated><aaif:morphosyntacticStructure rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Adjective" /><aaif:inflection rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Uninflected" /><aaif:attributionTarget rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Verb" /><aaif:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:modified><aaif:semanticClassification rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Manner" /><aaif:reduplicated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:reduplicated><aaif:prepositionalPhrase rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:prepositionalPhrase></aaif:Adverb><aaif:Entry rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En111"><aaif:phrase rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh#En111Ph1" /><aaif:source rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh.bibl#Cnde118" /><gams:textualContent>bovinos alsacianos que Sofía había visto hasta ahora.Tostados, fanfarrones, luciendo cicatrices en las caras, hablando alto , calando la hembra con ojos que le dejaban en cueros, parecían responder a un nuevo estilo militar que,</gams:textualContent><rel:isPartOf rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh" /></aaif:Entry><aaif:Phrase rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En111Ph1"><aaif:verb rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh#En111Ph1Ve1" /><aaif:adverb rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh#En111Ph1Ad1" /><aaif:text>fanfarrones, luciendo cicatrices en las caras, hablando alto </aaif:text><aaif:annoText>fanfarrones, luciendo cicatrices en las caras, [v|hablando|hablar|is] [a|alto|alto|auvnmnnn] </aaif:annoText></aaif:Phrase><aaif:Verb rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En111Ph1Ve1"><aaif:text>hablando</aaif:text><aaif:lemma rdf:resource="https://gams.uni-graz.at/o:aaif.lemma#hablar" /><aaif:position rdf:datatype="http://www.w3.org/2001/XMLSchema#int">1</aaif:position><aaif:coordinated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:coordinated><aaif:partOfText rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</aaif:partOfText><aaif:syntacticConstruction rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Intransitive" /></aaif:Verb><aaif:Adverb rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En111Ph1Ad1"><aaif:text>alto</aaif:text><aaif:lemma rdf:resource="https://gams.uni-graz.at/o:aaif.lemma#alto" /><aaif:position rdf:datatype="http://www.w3.org/2001/XMLSchema#int">2</aaif:position><aaif:coordinated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:coordinated><aaif:morphosyntacticStructure rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Adjective" /><aaif:inflection rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Uninflected" /><aaif:attributionTarget rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Verb" /><aaif:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:modified><aaif:semanticClassification rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Manner" /><aaif:reduplicated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:reduplicated><aaif:prepositionalPhrase rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:prepositionalPhrase></aaif:Adverb><aaif:Entry rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En112"><aaif:phrase rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh#En112Ph1" /><aaif:source rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh.bibl#Cnde562" /><gams:textualContent>Cóndor.Atrévete a decir que no vuelo alto .</gams:textualContent><rel:isPartOf rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh" /></aaif:Entry><aaif:Phrase rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En112Ph1"><aaif:verb rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh#En112Ph1Ve1" /><aaif:adverb rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh#En112Ph1Ad1" /><aaif:text>Atrévete a decir que no vuelo alto </aaif:text><aaif:annoText>Atrévete a decir que no [v|vuelo|volar|is] [a|alto|alto|auvnlnnn] </aaif:annoText></aaif:Phrase><aaif:Verb rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En112Ph1Ve1"><aaif:text>vuelo</aaif:text><aaif:lemma rdf:resource="https://gams.uni-graz.at/o:aaif.lemma#volar" /><aaif:position rdf:datatype="http://www.w3.org/2001/XMLSchema#int">1</aaif:position><aaif:coordinated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:coordinated><aaif:partOfText rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</aaif:partOfText><aaif:syntacticConstruction rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Intransitive" /></aaif:Verb><aaif:Adverb rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En112Ph1Ad1"><aaif:text>alto</aaif:text><aaif:lemma rdf:resource="https://gams.uni-graz.at/o:aaif.lemma#alto" /><aaif:position rdf:datatype="http://www.w3.org/2001/XMLSchema#int">2</aaif:position><aaif:coordinated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:coordinated><aaif:morphosyntacticStructure rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Adjective" /><aaif:inflection rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Uninflected" /><aaif:attributionTarget rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Verb" /><aaif:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:modified><aaif:semanticClassification rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Location" /><aaif:reduplicated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:reduplicated><aaif:prepositionalPhrase rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:prepositionalPhrase></aaif:Adverb><aaif:Entry rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En113"><aaif:phrase rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh#En113Ph1" /><aaif:source rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh.bibl#Cnde263" /><gams:textualContent>él disimulaba y hablaba con la vieja y se reía y  ella, Petra, también se reía y hablaba alto  y la vieja salía de nuevo a la ventana y volvía para dentro y se estaba un gran rato allá dentro</gams:textualContent><rel:isPartOf rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh" /></aaif:Entry><aaif:Phrase rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En113Ph1"><aaif:subject rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh#En113Ph1Su1" /><aaif:verb rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh#En113Ph1Ve1" /><aaif:adverb rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh#En113Ph1Ad1" /><aaif:text> ella, Petra, también se reía y hablaba alto </aaif:text><aaif:annoText> [s|ella, Petra,|fs] también se reía y [v|hablaba|hablar|is] [a|alto|alto|auvnmnnn] </aaif:annoText></aaif:Phrase><aaif:Subject rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En113Ph1Su1"><aaif:text>ella, Petra,</aaif:text><aaif:position rdf:datatype="http://www.w3.org/2001/XMLSchema#int">1</aaif:position><aaif:gender rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Feminine" /><aaif:number rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Singular" /><aaif:overt rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</aaif:overt></aaif:Subject><aaif:Verb rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En113Ph1Ve1"><aaif:text>hablaba</aaif:text><aaif:lemma rdf:resource="https://gams.uni-graz.at/o:aaif.lemma#hablar" /><aaif:position rdf:datatype="http://www.w3.org/2001/XMLSchema#int">2</aaif:position><aaif:coordinated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:coordinated><aaif:partOfText rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</aaif:partOfText><aaif:syntacticConstruction rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Intransitive" /></aaif:Verb><aaif:Adverb rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En113Ph1Ad1"><aaif:text>alto</aaif:text><aaif:lemma rdf:resource="https://gams.uni-graz.at/o:aaif.lemma#alto" /><aaif:position rdf:datatype="http://www.w3.org/2001/XMLSchema#int">3</aaif:position><aaif:coordinated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:coordinated><aaif:morphosyntacticStructure rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Adjective" /><aaif:inflection rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Uninflected" /><aaif:attributionTarget rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Verb" /><aaif:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:modified><aaif:semanticClassification rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Manner" /><aaif:reduplicated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:reduplicated><aaif:prepositionalPhrase rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:prepositionalPhrase></aaif:Adverb><aaif:Entry rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En114"><aaif:phrase rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh#En114Ph1" /><aaif:source rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh.bibl#Cnde263" /><gams:textualContent>Ella se rió un poco falsa no porque no le diera risa, sino porque no estaba acostumbrada a reírse alto  y a la vez que quería dejar ver que comprendía el chiste y lo apreciaba y era popular, encontraba </gams:textualContent><rel:isPartOf rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh" /></aaif:Entry><aaif:Phrase rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En114Ph1"><aaif:verb rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh#En114Ph1Ve1" /><aaif:adverb rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh#En114Ph1Ad1" /><aaif:text>no estaba acostumbrada a reírse alto </aaif:text><aaif:annoText>no estaba acostumbrada a [v|reírse|reír|rs] [a|alto|alto|auvnmnnn] </aaif:annoText></aaif:Phrase><aaif:Verb rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En114Ph1Ve1"><aaif:text>reírse</aaif:text><aaif:lemma rdf:resource="https://gams.uni-graz.at/o:aaif.lemma#reír" /><aaif:position rdf:datatype="http://www.w3.org/2001/XMLSchema#int">1</aaif:position><aaif:coordinated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:coordinated><aaif:partOfText rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</aaif:partOfText><aaif:syntacticConstruction rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Reflexive" /></aaif:Verb><aaif:Adverb rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En114Ph1Ad1"><aaif:text>alto</aaif:text><aaif:lemma rdf:resource="https://gams.uni-graz.at/o:aaif.lemma#alto" /><aaif:position rdf:datatype="http://www.w3.org/2001/XMLSchema#int">2</aaif:position><aaif:coordinated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:coordinated><aaif:morphosyntacticStructure rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Adjective" /><aaif:inflection rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Uninflected" /><aaif:attributionTarget rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Verb" /><aaif:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:modified><aaif:semanticClassification rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Manner" /><aaif:reduplicated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:reduplicated><aaif:prepositionalPhrase rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:prepositionalPhrase></aaif:Adverb><aaif:Entry rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En115"><aaif:phrase rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh#En115Ph1" /><aaif:source rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh.bibl#Cnde263" /><gams:textualContent>apreciaba y era popular, encontraba vulgar su risa porque alguien le decía que  la gente bien no se ríe alto .Si esto luce complicado es porque es complicado para mí.</gams:textualContent><rel:isPartOf rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh" /></aaif:Entry><aaif:Phrase rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En115Ph1"><aaif:subject rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh#En115Ph1Su1" /><aaif:verb rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh#En115Ph1Ve1" /><aaif:adverb rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh#En115Ph1Ad1" /><aaif:text> la gente bien no se ríe alto </aaif:text><aaif:annoText> [s|la gente bien|fs] no se [v|ríe|reír|rs] [a|alto|alto|auvnmnnn] </aaif:annoText></aaif:Phrase><aaif:Subject rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En115Ph1Su1"><aaif:text>la gente bien</aaif:text><aaif:position rdf:datatype="http://www.w3.org/2001/XMLSchema#int">1</aaif:position><aaif:gender rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Feminine" /><aaif:number rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Singular" /><aaif:overt rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</aaif:overt></aaif:Subject><aaif:Verb rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En115Ph1Ve1"><aaif:text>ríe</aaif:text><aaif:lemma rdf:resource="https://gams.uni-graz.at/o:aaif.lemma#reír" /><aaif:position rdf:datatype="http://www.w3.org/2001/XMLSchema#int">2</aaif:position><aaif:coordinated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:coordinated><aaif:partOfText rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</aaif:partOfText><aaif:syntacticConstruction rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Reflexive" /></aaif:Verb><aaif:Adverb rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En115Ph1Ad1"><aaif:text>alto</aaif:text><aaif:lemma rdf:resource="https://gams.uni-graz.at/o:aaif.lemma#alto" /><aaif:position rdf:datatype="http://www.w3.org/2001/XMLSchema#int">3</aaif:position><aaif:coordinated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:coordinated><aaif:morphosyntacticStructure rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Adjective" /><aaif:inflection rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Uninflected" /><aaif:attributionTarget rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Verb" /><aaif:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:modified><aaif:semanticClassification rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Manner" /><aaif:reduplicated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:reduplicated><aaif:prepositionalPhrase rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:prepositionalPhrase></aaif:Adverb><aaif:Entry rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En116"><aaif:phrase rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh#En116Ph1" /><aaif:source rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh.bibl#Cnde263" /><gams:textualContent>tambores, son la relación, lo que permite volar bajo y ver las casas y la gente o volar alto y ver las nubes y estar entre el cielo y la tierra, suspendido, sin dimensión, pero en </gams:textualContent><rel:isPartOf rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh" /></aaif:Entry><aaif:Phrase rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En116Ph1"><aaif:verb rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh#En116Ph1Ve1" /><aaif:adverb rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh#En116Ph1Ad1" /><aaif:text>lo que permite volar bajo y ver las casas y la gente</aaif:text><aaif:annoText>lo que permite [v|volar|volar|is] [a|bajo|bajo|auvnlnnn] y ver las casas y la gente</aaif:annoText></aaif:Phrase><aaif:Verb rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En116Ph1Ve1"><aaif:text>volar</aaif:text><aaif:lemma rdf:resource="https://gams.uni-graz.at/o:aaif.lemma#volar" /><aaif:position rdf:datatype="http://www.w3.org/2001/XMLSchema#int">1</aaif:position><aaif:coordinated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:coordinated><aaif:partOfText rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</aaif:partOfText><aaif:syntacticConstruction rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Intransitive" /></aaif:Verb><aaif:Adverb rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En116Ph1Ad1"><aaif:text>bajo</aaif:text><aaif:lemma rdf:resource="https://gams.uni-graz.at/o:aaif.lemma#bajo" /><aaif:position rdf:datatype="http://www.w3.org/2001/XMLSchema#int">2</aaif:position><aaif:coordinated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:coordinated><aaif:morphosyntacticStructure rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Adjective" /><aaif:inflection rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Uninflected" /><aaif:attributionTarget rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Verb" /><aaif:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:modified><aaif:semanticClassification rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Location" /><aaif:reduplicated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:reduplicated><aaif:prepositionalPhrase rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:prepositionalPhrase></aaif:Adverb><aaif:Entry rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En117"><aaif:phrase rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh#En117Ph1" /><aaif:source rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh.bibl#Cnde263" /><gams:textualContent>pero tiene un encanto ufano, una violenta sorpresa siempre almacenada en reserva y  algo indefinido, poético que vuela alto con las maracas y la guitarra y las voces del macho en falsetto o —a veces y— en</gams:textualContent><rel:isPartOf rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh" /></aaif:Entry><aaif:Phrase rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En117Ph1"><aaif:subject rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh#En117Ph1Su1" /><aaif:verb rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh#En117Ph1Ve1" /><aaif:adverb rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh#En117Ph1Ad1" /><aaif:text> algo indefinido, poético que vuela alto con las maracas y la guitarra</aaif:text><aaif:annoText> [s|algo indefinido, poético|ms] que [v|vuela|volar|is] [a|alto|alto|auvnlnnn] con las maracas y la guitarra</aaif:annoText></aaif:Phrase><aaif:Subject rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En117Ph1Su1"><aaif:text>algo indefinido, poético</aaif:text><aaif:position rdf:datatype="http://www.w3.org/2001/XMLSchema#int">1</aaif:position><aaif:gender rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Masculine" /><aaif:number rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Singular" /><aaif:overt rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</aaif:overt></aaif:Subject><aaif:Verb rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En117Ph1Ve1"><aaif:text>vuela</aaif:text><aaif:lemma rdf:resource="https://gams.uni-graz.at/o:aaif.lemma#volar" /><aaif:position rdf:datatype="http://www.w3.org/2001/XMLSchema#int">2</aaif:position><aaif:coordinated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:coordinated><aaif:partOfText rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</aaif:partOfText><aaif:syntacticConstruction rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Intransitive" /></aaif:Verb><aaif:Adverb rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En117Ph1Ad1"><aaif:text>alto</aaif:text><aaif:lemma rdf:resource="https://gams.uni-graz.at/o:aaif.lemma#alto" /><aaif:position rdf:datatype="http://www.w3.org/2001/XMLSchema#int">3</aaif:position><aaif:coordinated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:coordinated><aaif:morphosyntacticStructure rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Adjective" /><aaif:inflection rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Uninflected" /><aaif:attributionTarget rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Verb" /><aaif:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:modified><aaif:semanticClassification rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Location" /><aaif:reduplicated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:reduplicated><aaif:prepositionalPhrase rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:prepositionalPhrase></aaif:Adverb><aaif:Entry rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En118"><aaif:phrase rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh#En118Ph1" /><aaif:source rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh.bibl#Cnde54" /><gams:textualContent>O hablar alto y piropear a las muchachas en las galerías subterráneas del metro parisiense, siempre con los inevitables maletones de </gams:textualContent><rel:isPartOf rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh" /></aaif:Entry><aaif:Phrase rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En118Ph1"><aaif:verb rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh#En118Ph1Ve1" /><aaif:adverb rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh#En118Ph1Ad1" /><aaif:text>O hablar alto y piropear a las muchachas</aaif:text><aaif:annoText>O [v|hablar|hablar|is] [a|alto|alto|auvnmnnn] y piropear a las muchachas</aaif:annoText></aaif:Phrase><aaif:Verb rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En118Ph1Ve1"><aaif:text>hablar</aaif:text><aaif:lemma rdf:resource="https://gams.uni-graz.at/o:aaif.lemma#hablar" /><aaif:position rdf:datatype="http://www.w3.org/2001/XMLSchema#int">1</aaif:position><aaif:coordinated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:coordinated><aaif:partOfText rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</aaif:partOfText><aaif:syntacticConstruction rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Intransitive" /></aaif:Verb><aaif:Adverb rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En118Ph1Ad1"><aaif:text>alto</aaif:text><aaif:lemma rdf:resource="https://gams.uni-graz.at/o:aaif.lemma#alto" /><aaif:position rdf:datatype="http://www.w3.org/2001/XMLSchema#int">2</aaif:position><aaif:coordinated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:coordinated><aaif:morphosyntacticStructure rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Adjective" /><aaif:inflection rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Uninflected" /><aaif:attributionTarget rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Verb" /><aaif:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:modified><aaif:semanticClassification rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Manner" /><aaif:reduplicated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:reduplicated><aaif:prepositionalPhrase rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:prepositionalPhrase></aaif:Adverb><aaif:Entry rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En119"><aaif:phrase rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh#En119Ph1" /><aaif:source rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh.bibl#Cnde119" /><gams:textualContent>A Flash Gordon no hay nadie que se la dé» y se vuelve hacia Montero para susurrarle pero bastante alto .¿Hoy se habrá bañado este Durán que está tan callado?, Montero le sonríe servilmente y Cirulli</gams:textualContent><rel:isPartOf rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh" /></aaif:Entry><aaif:Phrase rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En119Ph1"><aaif:verb rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh#En119Ph1Ve1" /><aaif:adverb rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh#En119Ph1Ad1" /><aaif:text>para susurrarle pero bastante alto </aaif:text><aaif:annoText>para [v|susurrarle|susurrar|ts] pero bastante [a|alto|alto|auvmmnnn] </aaif:annoText></aaif:Phrase><aaif:Verb rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En119Ph1Ve1"><aaif:text>susurrarle</aaif:text><aaif:lemma rdf:resource="https://gams.uni-graz.at/o:aaif.lemma#susurrar" /><aaif:position rdf:datatype="http://www.w3.org/2001/XMLSchema#int">1</aaif:position><aaif:coordinated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:coordinated><aaif:partOfText rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</aaif:partOfText><aaif:syntacticConstruction rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Transitive" /></aaif:Verb><aaif:Adverb rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En119Ph1Ad1"><aaif:text>alto</aaif:text><aaif:lemma rdf:resource="https://gams.uni-graz.at/o:aaif.lemma#alto" /><aaif:position rdf:datatype="http://www.w3.org/2001/XMLSchema#int">2</aaif:position><aaif:coordinated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:coordinated><aaif:morphosyntacticStructure rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Adjective" /><aaif:inflection rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Uninflected" /><aaif:attributionTarget rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Verb" /><aaif:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</aaif:modified><aaif:semanticClassification rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Manner" /><aaif:reduplicated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:reduplicated><aaif:prepositionalPhrase rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:prepositionalPhrase></aaif:Adverb><aaif:Entry rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En120"><aaif:phrase rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh#En120Ph1" /><aaif:source rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh.bibl#Cnde6" /><gams:textualContent>¿cuartos?, aquí...» ¡Zas!«¡levanta la monyeca!» y  él  levantó altísimo las dos monyecas y las mantuvo así mientras Frau Proserpina iba por otro chal, «será un invierno muy</gams:textualContent><rel:isPartOf rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh" /></aaif:Entry><aaif:Phrase rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En120Ph1"><aaif:subject rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh#En120Ph1Su1" /><aaif:verb rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh#En120Ph1Ve1" /><aaif:adverb rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh#En120Ph1Ad1" /><aaif:text> él  levantó altísimo las dos monyecas</aaif:text><aaif:annoText> [s|él|ms]  [v|levantó|levantar|ts] [a|altísimo|alto|auvnlnnn] las dos monyecas</aaif:annoText></aaif:Phrase><aaif:Subject rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En120Ph1Su1"><aaif:text>él</aaif:text><aaif:position rdf:datatype="http://www.w3.org/2001/XMLSchema#int">1</aaif:position><aaif:gender rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Masculine" /><aaif:number rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Singular" /><aaif:overt rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</aaif:overt></aaif:Subject><aaif:Verb rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En120Ph1Ve1"><aaif:text>levantó</aaif:text><aaif:lemma rdf:resource="https://gams.uni-graz.at/o:aaif.lemma#levantar" /><aaif:position rdf:datatype="http://www.w3.org/2001/XMLSchema#int">2</aaif:position><aaif:coordinated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:coordinated><aaif:partOfText rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</aaif:partOfText><aaif:syntacticConstruction rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Transitive" /></aaif:Verb><aaif:Adverb rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En120Ph1Ad1"><aaif:text>altísimo</aaif:text><aaif:lemma rdf:resource="https://gams.uni-graz.at/o:aaif.lemma#alto" /><aaif:position rdf:datatype="http://www.w3.org/2001/XMLSchema#int">3</aaif:position><aaif:coordinated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:coordinated><aaif:morphosyntacticStructure rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Adjective" /><aaif:inflection rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Uninflected" /><aaif:attributionTarget rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Verb" /><aaif:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:modified><aaif:semanticClassification rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Location" /><aaif:reduplicated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:reduplicated><aaif:prepositionalPhrase rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:prepositionalPhrase></aaif:Adverb><aaif:Entry rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En121"><aaif:phrase rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh#En121Ph1" /><aaif:source rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh.bibl#Cnde6" /><gams:textualContent>en lo más hondo de su alma.No dijo ni pío, sin embargo.Lo que hizo fue levantar altísimo las muñecas y arrancarse con el ejercicio como en sus buenas épocas; se llenó de sentimiento, y ya</gams:textualContent><rel:isPartOf rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh" /></aaif:Entry><aaif:Phrase rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En121Ph1"><aaif:verb rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh#En121Ph1Ve1" /><aaif:adverb rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh#En121Ph1Ad1" /><aaif:text>Lo que hizo fue levantar altísimo las muñecas</aaif:text><aaif:annoText>Lo que hizo fue [v|levantar|levantar|ts] [a|altísimo|alto|auvnlnnn] las muñecas</aaif:annoText></aaif:Phrase><aaif:Verb rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En121Ph1Ve1"><aaif:text>levantar</aaif:text><aaif:lemma rdf:resource="https://gams.uni-graz.at/o:aaif.lemma#levantar" /><aaif:position rdf:datatype="http://www.w3.org/2001/XMLSchema#int">1</aaif:position><aaif:coordinated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:coordinated><aaif:partOfText rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</aaif:partOfText><aaif:syntacticConstruction rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Transitive" /></aaif:Verb><aaif:Adverb rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En121Ph1Ad1"><aaif:text>altísimo</aaif:text><aaif:lemma rdf:resource="https://gams.uni-graz.at/o:aaif.lemma#alto" /><aaif:position rdf:datatype="http://www.w3.org/2001/XMLSchema#int">2</aaif:position><aaif:coordinated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:coordinated><aaif:morphosyntacticStructure rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Adjective" /><aaif:inflection rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Uninflected" /><aaif:attributionTarget rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Verb" /><aaif:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:modified><aaif:semanticClassification rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Location" /><aaif:reduplicated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:reduplicated><aaif:prepositionalPhrase rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:prepositionalPhrase></aaif:Adverb><aaif:Entry rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En122"><aaif:phrase rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh#En122Ph1" /><aaif:source rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh.bibl#Cnde415" /><gams:textualContent>más anchas?Las tienen, van a misa —tarde— para que acabe la obligación más pronto,    hablan alto , toman vermut, cerveza, vino, juegan a la lotería, se apasionan por el fútbol y lo </gams:textualContent><rel:isPartOf rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh" /></aaif:Entry><aaif:Phrase rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En122Ph1"><aaif:subject rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh#En122Ph1Su1" /><aaif:verb rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh#En122Ph1Ve1" /><aaif:adverb rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh#En122Ph1Ad1" /><aaif:text>   hablan alto </aaif:text><aaif:annoText> [s||mp]  [v|hablan|hablar|is] [a|alto|alto|auvnmnnn] </aaif:annoText></aaif:Phrase><aaif:Subject rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En122Ph1Su1"><aaif:position rdf:datatype="http://www.w3.org/2001/XMLSchema#int">1</aaif:position><aaif:gender rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Masculine" /><aaif:number rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Plural" /><aaif:overt rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:overt></aaif:Subject><aaif:Verb rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En122Ph1Ve1"><aaif:text>hablan</aaif:text><aaif:lemma rdf:resource="https://gams.uni-graz.at/o:aaif.lemma#hablar" /><aaif:position rdf:datatype="http://www.w3.org/2001/XMLSchema#int">2</aaif:position><aaif:coordinated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:coordinated><aaif:partOfText rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</aaif:partOfText><aaif:syntacticConstruction rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Intransitive" /></aaif:Verb><aaif:Adverb rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En122Ph1Ad1"><aaif:text>alto</aaif:text><aaif:lemma rdf:resource="https://gams.uni-graz.at/o:aaif.lemma#alto" /><aaif:position rdf:datatype="http://www.w3.org/2001/XMLSchema#int">3</aaif:position><aaif:coordinated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:coordinated><aaif:morphosyntacticStructure rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Adjective" /><aaif:inflection rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Uninflected" /><aaif:attributionTarget rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Verb" /><aaif:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:modified><aaif:semanticClassification rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Manner" /><aaif:reduplicated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:reduplicated><aaif:prepositionalPhrase rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:prepositionalPhrase></aaif:Adverb><aaif:Entry rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En123"><aaif:phrase rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh#En123Ph1" /><aaif:source rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh.bibl#Cnde58" /><gams:textualContent>dinamitar las costumbres.Quizá conseguía alguna audiencia, ya que, en aquella sociedad donde la bondad no se valoraba alto , el costroso sujeto se empeñaba en mostrar una calculada malevolencia.En todo caso, el tipo no causaba una agradable</gams:textualContent><rel:isPartOf rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh" /></aaif:Entry><aaif:Phrase rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En123Ph1"><aaif:subject rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh#En123Ph1Su1" /><aaif:verb rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh#En123Ph1Ve1" /><aaif:adverb rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh#En123Ph1Ad1" /><aaif:text>en aquella sociedad donde la bondad no se valoraba alto </aaif:text><aaif:annoText>en aquella sociedad donde [s|la bondad|fs] no se [v|valoraba|valorar|rs] [a|alto|alto|auvnqnnn] </aaif:annoText></aaif:Phrase><aaif:Subject rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En123Ph1Su1"><aaif:text>la bondad</aaif:text><aaif:position rdf:datatype="http://www.w3.org/2001/XMLSchema#int">1</aaif:position><aaif:gender rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Feminine" /><aaif:number rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Singular" /><aaif:overt rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</aaif:overt></aaif:Subject><aaif:Verb rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En123Ph1Ve1"><aaif:text>valoraba</aaif:text><aaif:lemma rdf:resource="https://gams.uni-graz.at/o:aaif.lemma#valorar" /><aaif:position rdf:datatype="http://www.w3.org/2001/XMLSchema#int">2</aaif:position><aaif:coordinated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:coordinated><aaif:partOfText rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</aaif:partOfText><aaif:syntacticConstruction rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Reflexive" /></aaif:Verb><aaif:Adverb rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En123Ph1Ad1"><aaif:text>alto</aaif:text><aaif:lemma rdf:resource="https://gams.uni-graz.at/o:aaif.lemma#alto" /><aaif:position rdf:datatype="http://www.w3.org/2001/XMLSchema#int">3</aaif:position><aaif:coordinated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:coordinated><aaif:morphosyntacticStructure rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Adjective" /><aaif:inflection rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Uninflected" /><aaif:attributionTarget rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Verb" /><aaif:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:modified><aaif:semanticClassification rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Quantity" /><aaif:reduplicated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:reduplicated><aaif:prepositionalPhrase rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:prepositionalPhrase></aaif:Adverb><aaif:Entry rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En124"><aaif:phrase rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh#En124Ph1" /><aaif:source rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh.bibl#Cnde266" /><gams:textualContent>el público al saludar desde el palco, yo la había oído cantar en el Novelty cuando se cotizaba alto , ahora estaba vieja y flaca pero conservaba toda la voz para los tangos.Mejor todavía, porque su</gams:textualContent><rel:isPartOf rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh" /></aaif:Entry><aaif:Phrase rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En124Ph1"><aaif:verb rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh#En124Ph1Ve1" /><aaif:adverb rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh#En124Ph1Ad1" /><aaif:text>yo la había oído cantar en el Novelty cuando se cotizaba alto </aaif:text><aaif:annoText>yo la había oído cantar en el Novelty cuando se [v|cotizaba|cotizar|rs] [a|alto|alto|auvnqnnn] </aaif:annoText></aaif:Phrase><aaif:Verb rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En124Ph1Ve1"><aaif:text>cotizaba</aaif:text><aaif:lemma rdf:resource="https://gams.uni-graz.at/o:aaif.lemma#cotizar" /><aaif:position rdf:datatype="http://www.w3.org/2001/XMLSchema#int">1</aaif:position><aaif:coordinated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:coordinated><aaif:partOfText rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</aaif:partOfText><aaif:syntacticConstruction rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Reflexive" /></aaif:Verb><aaif:Adverb rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En124Ph1Ad1"><aaif:text>alto</aaif:text><aaif:lemma rdf:resource="https://gams.uni-graz.at/o:aaif.lemma#alto" /><aaif:position rdf:datatype="http://www.w3.org/2001/XMLSchema#int">2</aaif:position><aaif:coordinated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:coordinated><aaif:morphosyntacticStructure rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Adjective" /><aaif:inflection rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Uninflected" /><aaif:attributionTarget rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Verb" /><aaif:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:modified><aaif:semanticClassification rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Quantity" /><aaif:reduplicated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:reduplicated><aaif:prepositionalPhrase rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:prepositionalPhrase></aaif:Adverb><aaif:Entry rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En125"><aaif:phrase rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh#En125Ph1" /><aaif:source rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh.bibl#Cnde70" /><gams:textualContent>y es entonces que oigo las frases que me ha estado diciendo esta muchacha, murmurando primero, después hablando alto , luego gritando: «Vas a ver» (claro que con su pronunciación habanera ella no decía)</gams:textualContent><rel:isPartOf rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh" /></aaif:Entry><aaif:Phrase rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En125Ph1"><aaif:verb rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh#En125Ph1Ve1" /><aaif:adverb rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh#En125Ph1Ad1" /><aaif:text>las frases que me ha estado diciendo esta muchacha, murmurando primero, después hablando alto </aaif:text><aaif:annoText>las frases que me ha estado diciendo esta muchacha, murmurando primero, después [v|hablando|hablar|is] [a|alto|alto|auvnmnnn] </aaif:annoText></aaif:Phrase><aaif:Verb rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En125Ph1Ve1"><aaif:text>hablando</aaif:text><aaif:lemma rdf:resource="https://gams.uni-graz.at/o:aaif.lemma#hablar" /><aaif:position rdf:datatype="http://www.w3.org/2001/XMLSchema#int">1</aaif:position><aaif:coordinated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:coordinated><aaif:partOfText rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</aaif:partOfText><aaif:syntacticConstruction rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Intransitive" /></aaif:Verb><aaif:Adverb rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En125Ph1Ad1"><aaif:text>alto</aaif:text><aaif:lemma rdf:resource="https://gams.uni-graz.at/o:aaif.lemma#alto" /><aaif:position rdf:datatype="http://www.w3.org/2001/XMLSchema#int">2</aaif:position><aaif:coordinated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:coordinated><aaif:morphosyntacticStructure rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Adjective" /><aaif:inflection rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Uninflected" /><aaif:attributionTarget rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Verb" /><aaif:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:modified><aaif:semanticClassification rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Manner" /><aaif:reduplicated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:reduplicated><aaif:prepositionalPhrase rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:prepositionalPhrase></aaif:Adverb><aaif:Entry rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En126"><aaif:phrase rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh#En126Ph1" /><aaif:source rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh.bibl#Cnde495" /><gams:textualContent>— El enfermo de amores —siguió don Isaías— siempre hace lo mismo: busca un lugar solitario donde lamerse la pata herida.Y eso es lo que yo hice.Vine aquí y me escondí.Heredé las rentas junto a un catalejo que mi padre compró por ver si volvía la urraca, y que yo usaba para subirme aquí, a la terraza, a cualquier hora del día o de la noche, y enchufarlo por donde a mí me parecía que debía andar la trenza.No la vi, como es natural, ni me importó demasiado, porque la esperanza es algo que vale por sí mismo.Pero a cambio una noche miré arriba y descubrí las estrellas.Ya se sabe, del amor a la astronomía no hay más que un paso. El amor  caza alto : es un problema de erección.Entonces entendí que sólo allí arriba podría encontrar la paz.Sólo los astros estaban a salvo del tremedal de las pasiones.Sólo en ellos era posible recobrar la armonía perdida de la infancia.¡Qué gran hallazgo para un joven a quien la desventura quiso, ya que no feliz, al menos clásico!Total, que cambié la trenza por las estrellas y me vine aquí, y aquí me pasaba las noches mirando a las alturas.</gams:textualContent><rel:isPartOf rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh" /></aaif:Entry><aaif:Phrase rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En126Ph1"><aaif:subject rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh#En126Ph1Su1" /><aaif:verb rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh#En126Ph1Ve1" /><aaif:adverb rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh#En126Ph1Ad1" /><aaif:text> El amor  caza alto </aaif:text><aaif:annoText> [s|El amor|ms]  [v|caza|cazar|is] [a|alto|alto|auvnlnnn] </aaif:annoText></aaif:Phrase><aaif:Subject rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En126Ph1Su1"><aaif:text>El amor</aaif:text><aaif:position rdf:datatype="http://www.w3.org/2001/XMLSchema#int">1</aaif:position><aaif:gender rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Masculine" /><aaif:number rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Singular" /><aaif:overt rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</aaif:overt></aaif:Subject><aaif:Verb rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En126Ph1Ve1"><aaif:text>caza</aaif:text><aaif:lemma rdf:resource="https://gams.uni-graz.at/o:aaif.lemma#cazar" /><aaif:position rdf:datatype="http://www.w3.org/2001/XMLSchema#int">2</aaif:position><aaif:coordinated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:coordinated><aaif:partOfText rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</aaif:partOfText><aaif:syntacticConstruction rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Intransitive" /></aaif:Verb><aaif:Adverb rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En126Ph1Ad1"><aaif:text>alto</aaif:text><aaif:lemma rdf:resource="https://gams.uni-graz.at/o:aaif.lemma#alto" /><aaif:position rdf:datatype="http://www.w3.org/2001/XMLSchema#int">3</aaif:position><aaif:coordinated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:coordinated><aaif:morphosyntacticStructure rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Adjective" /><aaif:inflection rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Uninflected" /><aaif:attributionTarget rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Verb" /><aaif:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:modified><aaif:semanticClassification rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Location" /><aaif:reduplicated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:reduplicated><aaif:prepositionalPhrase rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:prepositionalPhrase></aaif:Adverb><aaif:Entry rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En127"><aaif:phrase rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh#En127Ph1" /><aaif:source rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh.bibl#Cnde75" /><gams:textualContent>Más bien al contrario.Podía ser suave en los gestos y en las palabras, aunque le gustara hablar alto , con esa alta voz de los vascos que parecen tener el tórax de cemento.No.Nunca le</gams:textualContent><rel:isPartOf rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh" /></aaif:Entry><aaif:Phrase rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En127Ph1"><aaif:verb rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh#En127Ph1Ve1" /><aaif:adverb rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh#En127Ph1Ad1" /><aaif:text>aunque le gustara hablar alto </aaif:text><aaif:annoText>aunque le gustara [v|hablar|hablar|is] [a|alto|alto|auvnmnnn] </aaif:annoText></aaif:Phrase><aaif:Verb rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En127Ph1Ve1"><aaif:text>hablar</aaif:text><aaif:lemma rdf:resource="https://gams.uni-graz.at/o:aaif.lemma#hablar" /><aaif:position rdf:datatype="http://www.w3.org/2001/XMLSchema#int">1</aaif:position><aaif:coordinated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:coordinated><aaif:partOfText rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</aaif:partOfText><aaif:syntacticConstruction rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Intransitive" /></aaif:Verb><aaif:Adverb rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En127Ph1Ad1"><aaif:text>alto</aaif:text><aaif:lemma rdf:resource="https://gams.uni-graz.at/o:aaif.lemma#alto" /><aaif:position rdf:datatype="http://www.w3.org/2001/XMLSchema#int">2</aaif:position><aaif:coordinated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:coordinated><aaif:morphosyntacticStructure rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Adjective" /><aaif:inflection rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Uninflected" /><aaif:attributionTarget rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Verb" /><aaif:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:modified><aaif:semanticClassification rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Manner" /><aaif:reduplicated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:reduplicated><aaif:prepositionalPhrase rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:prepositionalPhrase></aaif:Adverb><aaif:Entry rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En128"><aaif:phrase rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh#En128Ph1" /><aaif:source rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh.bibl#Cnde76" /><gams:textualContent>Se acomodó en la silla y encendió un cigarrillo. El rumor del aire acondicionado se escuchaba alto en la quietud de la tarde.Era la hora de la modorra.A pesar del fresco clima artificial,</gams:textualContent><rel:isPartOf rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh" /></aaif:Entry><aaif:Phrase rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En128Ph1"><aaif:subject rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh#En128Ph1Su1" /><aaif:verb rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh#En128Ph1Ve1" /><aaif:adverb rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh#En128Ph1Ad1" /><aaif:text> El rumor del aire acondicionado se escuchaba alto en la quietud de la tarde</aaif:text><aaif:annoText> [s|El rumor del aire acondicionado|ms] se [v|escuchaba|escuchar|rs] [a|alto|alto|auvnmnnn] en la quietud de la tarde</aaif:annoText></aaif:Phrase><aaif:Subject rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En128Ph1Su1"><aaif:text>El rumor del aire acondicionado</aaif:text><aaif:position rdf:datatype="http://www.w3.org/2001/XMLSchema#int">1</aaif:position><aaif:gender rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Masculine" /><aaif:number rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Singular" /><aaif:overt rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</aaif:overt></aaif:Subject><aaif:Verb rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En128Ph1Ve1"><aaif:text>escuchaba</aaif:text><aaif:lemma rdf:resource="https://gams.uni-graz.at/o:aaif.lemma#escuchar" /><aaif:position rdf:datatype="http://www.w3.org/2001/XMLSchema#int">2</aaif:position><aaif:coordinated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:coordinated><aaif:partOfText rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</aaif:partOfText><aaif:syntacticConstruction rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Reflexive" /></aaif:Verb><aaif:Adverb rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En128Ph1Ad1"><aaif:text>alto</aaif:text><aaif:lemma rdf:resource="https://gams.uni-graz.at/o:aaif.lemma#alto" /><aaif:position rdf:datatype="http://www.w3.org/2001/XMLSchema#int">3</aaif:position><aaif:coordinated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:coordinated><aaif:morphosyntacticStructure rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Adjective" /><aaif:inflection rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Uninflected" /><aaif:attributionTarget rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Verb" /><aaif:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:modified><aaif:semanticClassification rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Manner" /><aaif:reduplicated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:reduplicated><aaif:prepositionalPhrase rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:prepositionalPhrase></aaif:Adverb><aaif:Entry rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En129"><aaif:phrase rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh#En129Ph1" /><aaif:source rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh.bibl#Cnde123" /><gams:textualContent>disimularlo, en no mentar a Juan ni para maldecirlo, en reírse más fuerte que nunca, en cantar alto «Diciembre me gustó pa'que te vayas», cada vez que una Navidad se cerraba de nuevo sobre su desesperanza.</gams:textualContent><rel:isPartOf rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh" /></aaif:Entry><aaif:Phrase rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En129Ph1"><aaif:verb rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh#En129Ph1Ve1" /><aaif:adverb rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh#En129Ph1Ad1" /><aaif:text>en cantar alto «Diciembre me gustó pa'que te vayas»</aaif:text><aaif:annoText>en [v|cantar|cantar|ts] [a|alto|alto|auvnmnnn] «Diciembre me gustó pa'que te vayas»</aaif:annoText></aaif:Phrase><aaif:Verb rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En129Ph1Ve1"><aaif:text>cantar</aaif:text><aaif:lemma rdf:resource="https://gams.uni-graz.at/o:aaif.lemma#cantar" /><aaif:position rdf:datatype="http://www.w3.org/2001/XMLSchema#int">1</aaif:position><aaif:coordinated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:coordinated><aaif:partOfText rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</aaif:partOfText><aaif:syntacticConstruction rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Transitive" /></aaif:Verb><aaif:Adverb rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En129Ph1Ad1"><aaif:text>alto</aaif:text><aaif:lemma rdf:resource="https://gams.uni-graz.at/o:aaif.lemma#alto" /><aaif:position rdf:datatype="http://www.w3.org/2001/XMLSchema#int">2</aaif:position><aaif:coordinated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:coordinated><aaif:morphosyntacticStructure rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Adjective" /><aaif:inflection rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Uninflected" /><aaif:attributionTarget rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Verb" /><aaif:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:modified><aaif:semanticClassification rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Manner" /><aaif:reduplicated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:reduplicated><aaif:prepositionalPhrase rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:prepositionalPhrase></aaif:Adverb><aaif:Entry rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En130"><aaif:phrase rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh#En130Ph1" /><aaif:source rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh.bibl#Cnde272" /><gams:textualContent>que  Superman invita a dar un paseo por los aires, encima de la ciudad, y bajó la escalera mirando alto y recio , sintiendo que cada paso de los que él daba era oído y aclamado por una multitud.</gams:textualContent><rel:isPartOf rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh" /></aaif:Entry><aaif:Phrase rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En130Ph1"><aaif:subject rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh#En130Ph1Su1" /><aaif:verb rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh#En130Ph1Ve1" /><aaif:adverb rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh#En130Ph1Ad1" /><aaif:adverb rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh#En130Ph1Ad2" /><aaif:text> Superman invita a dar un paseo por los aires, encima de la ciudad, y bajó la escalera mirando alto y recio </aaif:text><aaif:annoText> [s|Superman|ms] invita a dar un paseo por los aires, encima de la ciudad, y bajó la escalera [v|mirando|mirar|is] [a|alto|alto|auvnmnnC] y [a|recio|recio|auvnmnnC] </aaif:annoText></aaif:Phrase><aaif:Subject rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En130Ph1Su1"><aaif:text>Superman</aaif:text><aaif:position rdf:datatype="http://www.w3.org/2001/XMLSchema#int">1</aaif:position><aaif:gender rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Masculine" /><aaif:number rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Singular" /><aaif:overt rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</aaif:overt></aaif:Subject><aaif:Verb rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En130Ph1Ve1"><aaif:text>mirando</aaif:text><aaif:lemma rdf:resource="https://gams.uni-graz.at/o:aaif.lemma#mirar" /><aaif:position rdf:datatype="http://www.w3.org/2001/XMLSchema#int">2</aaif:position><aaif:coordinated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:coordinated><aaif:partOfText rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</aaif:partOfText><aaif:syntacticConstruction rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Intransitive" /></aaif:Verb><aaif:Adverb rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En130Ph1Ad1"><aaif:text>alto</aaif:text><aaif:lemma rdf:resource="https://gams.uni-graz.at/o:aaif.lemma#alto" /><aaif:position rdf:datatype="http://www.w3.org/2001/XMLSchema#int">3</aaif:position><aaif:coordinated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</aaif:coordinated><aaif:morphosyntacticStructure rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Adjective" /><aaif:inflection rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Uninflected" /><aaif:attributionTarget rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Verb" /><aaif:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:modified><aaif:semanticClassification rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Manner" /><aaif:reduplicated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:reduplicated><aaif:prepositionalPhrase rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:prepositionalPhrase></aaif:Adverb><aaif:Adverb rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En130Ph1Ad2"><aaif:text>recio</aaif:text><aaif:lemma rdf:resource="https://gams.uni-graz.at/o:aaif.lemma#recio" /><aaif:position rdf:datatype="http://www.w3.org/2001/XMLSchema#int">4</aaif:position><aaif:coordinated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</aaif:coordinated><aaif:morphosyntacticStructure rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Adjective" /><aaif:inflection rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Uninflected" /><aaif:attributionTarget rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Verb" /><aaif:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:modified><aaif:semanticClassification rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Manner" /><aaif:reduplicated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:reduplicated><aaif:prepositionalPhrase rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:prepositionalPhrase></aaif:Adverb><aaif:Entry rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En131"><aaif:phrase rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh#En131Ph1" /><aaif:source rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh.bibl#Cnde187" /><gams:textualContent>sí, siento la brisa que la acaricia y mi mano que toca mi mejilla, adiós Romualdo,  hablo  claro y alto , veo la ciudad rodeándome tan benigna como la Casa porque nadie podrá descubrirme bajo este disfraz.</gams:textualContent><rel:isPartOf rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh" /></aaif:Entry><aaif:Phrase rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En131Ph1"><aaif:verb rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh#En131Ph1Ve1" /><aaif:adverb rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh#En131Ph1Ad1" /><aaif:adverb rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh#En131Ph1Ad2" /><aaif:text> hablo  claro y alto </aaif:text><aaif:annoText> [v|hablo|hablar|is]  [a|claro|claro|auvnmnnC] y [a|alto|alto|auvnmnnC] </aaif:annoText></aaif:Phrase><aaif:Verb rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En131Ph1Ve1"><aaif:text>hablo</aaif:text><aaif:lemma rdf:resource="https://gams.uni-graz.at/o:aaif.lemma#hablar" /><aaif:position rdf:datatype="http://www.w3.org/2001/XMLSchema#int">1</aaif:position><aaif:coordinated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:coordinated><aaif:partOfText rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</aaif:partOfText><aaif:syntacticConstruction rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Intransitive" /></aaif:Verb><aaif:Adverb rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En131Ph1Ad1"><aaif:text>claro</aaif:text><aaif:lemma rdf:resource="https://gams.uni-graz.at/o:aaif.lemma#claro" /><aaif:position rdf:datatype="http://www.w3.org/2001/XMLSchema#int">2</aaif:position><aaif:coordinated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</aaif:coordinated><aaif:morphosyntacticStructure rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Adjective" /><aaif:inflection rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Uninflected" /><aaif:attributionTarget rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Verb" /><aaif:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:modified><aaif:semanticClassification rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Manner" /><aaif:reduplicated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:reduplicated><aaif:prepositionalPhrase rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:prepositionalPhrase></aaif:Adverb><aaif:Adverb rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En131Ph1Ad2"><aaif:text>alto</aaif:text><aaif:lemma rdf:resource="https://gams.uni-graz.at/o:aaif.lemma#alto" /><aaif:position rdf:datatype="http://www.w3.org/2001/XMLSchema#int">3</aaif:position><aaif:coordinated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</aaif:coordinated><aaif:morphosyntacticStructure rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Adjective" /><aaif:inflection rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Uninflected" /><aaif:attributionTarget rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Verb" /><aaif:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:modified><aaif:semanticClassification rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Manner" /><aaif:reduplicated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:reduplicated><aaif:prepositionalPhrase rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:prepositionalPhrase></aaif:Adverb><aaif:Entry rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En132"><aaif:phrase rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh#En132Ph1" /><aaif:source rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh.bibl#Cnde190" /><gams:textualContent>58.  Arder  verde por seco y lazera justo por pecador.</gams:textualContent><rel:isPartOf rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh" /></aaif:Entry><aaif:Phrase rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En132Ph1"><aaif:verb rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh#En132Ph1Ve1" /><aaif:adverb rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh#En132Ph1Ad1" /><aaif:text> Arder  verde por seco y lazera justo por pecador.</aaif:text><aaif:annoText> [v|Arder|Arder|is]  [a|verde|verde|auvnunnn] por seco y lazera justo por pecador.</aaif:annoText></aaif:Phrase><aaif:Verb rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En132Ph1Ve1"><aaif:text>Arder</aaif:text><aaif:lemma rdf:resource="https://gams.uni-graz.at/o:aaif.lemma#Arder" /><aaif:position rdf:datatype="http://www.w3.org/2001/XMLSchema#int">1</aaif:position><aaif:coordinated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:coordinated><aaif:partOfText rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</aaif:partOfText><aaif:syntacticConstruction rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Intransitive" /></aaif:Verb><aaif:Adverb rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En132Ph1Ad1"><aaif:text>verde</aaif:text><aaif:lemma rdf:resource="https://gams.uni-graz.at/o:aaif.lemma#verde" /><aaif:position rdf:datatype="http://www.w3.org/2001/XMLSchema#int">2</aaif:position><aaif:coordinated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:coordinated><aaif:morphosyntacticStructure rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Adjective" /><aaif:inflection rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Uninflected" /><aaif:attributionTarget rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Verb" /><aaif:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:modified><aaif:semanticClassification rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Other" /><aaif:reduplicated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:reduplicated><aaif:prepositionalPhrase rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:prepositionalPhrase></aaif:Adverb><aaif:Entry rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En133"><aaif:phrase rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh#En133Ph1" /><aaif:source rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh.bibl#Cnde28" /><gams:textualContent> Brilló  verde un farol .Al verlo, el profesor vio de paso los eléctricos puntitos de luz de las calles</gams:textualContent><rel:isPartOf rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh" /></aaif:Entry><aaif:Phrase rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En133Ph1"><aaif:subject rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh#En133Ph1Su1" /><aaif:verb rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh#En133Ph1Ve1" /><aaif:adverb rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh#En133Ph1Ad1" /><aaif:text> Brilló  verde un farol .</aaif:text><aaif:annoText> [v|Brilló|brillar|is]  [a|verde|verde|auvnunnn] [s|un farol|ms] .</aaif:annoText></aaif:Phrase><aaif:Subject rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En133Ph1Su1"><aaif:text>un farol</aaif:text><aaif:position rdf:datatype="http://www.w3.org/2001/XMLSchema#int">3</aaif:position><aaif:gender rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Masculine" /><aaif:number rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Singular" /><aaif:overt rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</aaif:overt></aaif:Subject><aaif:Verb rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En133Ph1Ve1"><aaif:text>Brilló</aaif:text><aaif:lemma rdf:resource="https://gams.uni-graz.at/o:aaif.lemma#brillar" /><aaif:position rdf:datatype="http://www.w3.org/2001/XMLSchema#int">1</aaif:position><aaif:coordinated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:coordinated><aaif:partOfText rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</aaif:partOfText><aaif:syntacticConstruction rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Intransitive" /></aaif:Verb><aaif:Adverb rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En133Ph1Ad1"><aaif:text>verde</aaif:text><aaif:lemma rdf:resource="https://gams.uni-graz.at/o:aaif.lemma#verde" /><aaif:position rdf:datatype="http://www.w3.org/2001/XMLSchema#int">2</aaif:position><aaif:coordinated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:coordinated><aaif:morphosyntacticStructure rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Adjective" /><aaif:inflection rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Uninflected" /><aaif:attributionTarget rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Verb" /><aaif:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:modified><aaif:semanticClassification rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Other" /><aaif:reduplicated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:reduplicated><aaif:prepositionalPhrase rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:prepositionalPhrase></aaif:Adverb><aaif:Entry rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En134"><aaif:phrase rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh#En134Ph1" /><aaif:source rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh.bibl#Cnde192" /><gams:textualContent>del lloro que la natura del poder d'él assíl priso el coraçón que les non pudo fablar baxo , e alçó la boz de guisa que los que les dexaran la casa e salieran fuera, e los</gams:textualContent><rel:isPartOf rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh" /></aaif:Entry><aaif:Phrase rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En134Ph1"><aaif:verb rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh#En134Ph1Ve1" /><aaif:adverb rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh#En134Ph1Ad1" /><aaif:text>les non pudo fablar baxo </aaif:text><aaif:annoText>les non pudo [v|fablar|hablar|is] [a|baxo|bajo|auvnmnnn] </aaif:annoText></aaif:Phrase><aaif:Verb rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En134Ph1Ve1"><aaif:text>fablar</aaif:text><aaif:lemma rdf:resource="https://gams.uni-graz.at/o:aaif.lemma#hablar" /><aaif:position rdf:datatype="http://www.w3.org/2001/XMLSchema#int">1</aaif:position><aaif:coordinated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:coordinated><aaif:partOfText rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</aaif:partOfText><aaif:syntacticConstruction rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Intransitive" /></aaif:Verb><aaif:Adverb rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En134Ph1Ad1"><aaif:text>baxo</aaif:text><aaif:lemma rdf:resource="https://gams.uni-graz.at/o:aaif.lemma#bajo" /><aaif:position rdf:datatype="http://www.w3.org/2001/XMLSchema#int">2</aaif:position><aaif:coordinated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:coordinated><aaif:morphosyntacticStructure rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Adjective" /><aaif:inflection rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Uninflected" /><aaif:attributionTarget rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Verb" /><aaif:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:modified><aaif:semanticClassification rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Manner" /><aaif:reduplicated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:reduplicated><aaif:prepositionalPhrase rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:prepositionalPhrase></aaif:Adverb><aaif:Entry rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En135"><aaif:phrase rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh#En135Ph1" /><aaif:source rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh.bibl#Cnde236" /><gams:textualContent>quando te fablare baxo , no·l creas, ca siete maldades trae en el coraçón.</gams:textualContent><rel:isPartOf rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh" /></aaif:Entry><aaif:Phrase rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En135Ph1"><aaif:verb rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh#En135Ph1Ve1" /><aaif:adverb rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh#En135Ph1Ad1" /><aaif:text>te fablare baxo </aaif:text><aaif:annoText>te [v|fablare|hablar|is] [a|baxo|bajo|auvnmnnn] </aaif:annoText></aaif:Phrase><aaif:Verb rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En135Ph1Ve1"><aaif:text>fablare</aaif:text><aaif:lemma rdf:resource="https://gams.uni-graz.at/o:aaif.lemma#hablar" /><aaif:position rdf:datatype="http://www.w3.org/2001/XMLSchema#int">1</aaif:position><aaif:coordinated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:coordinated><aaif:partOfText rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</aaif:partOfText><aaif:syntacticConstruction rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Intransitive" /></aaif:Verb><aaif:Adverb rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En135Ph1Ad1"><aaif:text>baxo</aaif:text><aaif:lemma rdf:resource="https://gams.uni-graz.at/o:aaif.lemma#bajo" /><aaif:position rdf:datatype="http://www.w3.org/2001/XMLSchema#int">2</aaif:position><aaif:coordinated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:coordinated><aaif:morphosyntacticStructure rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Adjective" /><aaif:inflection rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Uninflected" /><aaif:attributionTarget rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Verb" /><aaif:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:modified><aaif:semanticClassification rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Manner" /><aaif:reduplicated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:reduplicated><aaif:prepositionalPhrase rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:prepositionalPhrase></aaif:Adverb><aaif:Entry rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En136"><aaif:phrase rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh#En136Ph1" /><aaif:source rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh.bibl#Cnde237" /><gams:textualContent>ca quando, fijo, la virtud ativa * &lt;lb/&gt;labra * con las sierpes en la tierra, &lt;lb/&gt; mirando  baxo , los párpados çierra&lt;lb/&gt;e con tal velo de las ver se priva.&lt;lb/&gt;&lt;lb/&gt;54 Onde, si d'ellas</gams:textualContent><rel:isPartOf rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh" /></aaif:Entry><aaif:Phrase rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En136Ph1"><aaif:verb rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh#En136Ph1Ve1" /><aaif:adverb rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh#En136Ph1Ad1" /><aaif:text> mirando  baxo </aaif:text><aaif:annoText> [v|mirando|mirar|is]  [a|baxo|bajo|auvnlnnn] </aaif:annoText></aaif:Phrase><aaif:Verb rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En136Ph1Ve1"><aaif:text>mirando</aaif:text><aaif:lemma rdf:resource="https://gams.uni-graz.at/o:aaif.lemma#mirar" /><aaif:position rdf:datatype="http://www.w3.org/2001/XMLSchema#int">1</aaif:position><aaif:coordinated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:coordinated><aaif:partOfText rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</aaif:partOfText><aaif:syntacticConstruction rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Intransitive" /></aaif:Verb><aaif:Adverb rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En136Ph1Ad1"><aaif:text>baxo</aaif:text><aaif:lemma rdf:resource="https://gams.uni-graz.at/o:aaif.lemma#bajo" /><aaif:position rdf:datatype="http://www.w3.org/2001/XMLSchema#int">2</aaif:position><aaif:coordinated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:coordinated><aaif:morphosyntacticStructure rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Adjective" /><aaif:inflection rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Uninflected" /><aaif:attributionTarget rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Verb" /><aaif:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:modified><aaif:semanticClassification rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Location" /><aaif:reduplicated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:reduplicated><aaif:prepositionalPhrase rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:prepositionalPhrase></aaif:Adverb><aaif:Entry rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En137"><aaif:phrase rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh#En137Ph1" /><aaif:source rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh.bibl#Cnde238" /><gams:textualContent>nasçerás en oriente e ponerte has en ocçidente; e en el verano yrás alto e en el yvierno yrás baxo ».E esso mysmo mandó a la luna e a las estrellas e a las otras planetas.E</gams:textualContent><rel:isPartOf rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh" /></aaif:Entry><aaif:Phrase rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En137Ph1"><aaif:verb rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh#En137Ph1Ve1" /><aaif:adverb rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh#En137Ph1Ad1" /><aaif:text>en el yvierno yrás baxo </aaif:text><aaif:annoText>en el yvierno [v|yrás|ir|is] [a|baxo|bajo|auvnlnnn] </aaif:annoText></aaif:Phrase><aaif:Verb rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En137Ph1Ve1"><aaif:text>yrás</aaif:text><aaif:lemma rdf:resource="https://gams.uni-graz.at/o:aaif.lemma#ir" /><aaif:position rdf:datatype="http://www.w3.org/2001/XMLSchema#int">1</aaif:position><aaif:coordinated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:coordinated><aaif:partOfText rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</aaif:partOfText><aaif:syntacticConstruction rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Intransitive" /></aaif:Verb><aaif:Adverb rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En137Ph1Ad1"><aaif:text>baxo</aaif:text><aaif:lemma rdf:resource="https://gams.uni-graz.at/o:aaif.lemma#bajo" /><aaif:position rdf:datatype="http://www.w3.org/2001/XMLSchema#int">2</aaif:position><aaif:coordinated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:coordinated><aaif:morphosyntacticStructure rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Adjective" /><aaif:inflection rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Uninflected" /><aaif:attributionTarget rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Verb" /><aaif:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:modified><aaif:semanticClassification rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Location" /><aaif:reduplicated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:reduplicated><aaif:prepositionalPhrase rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:prepositionalPhrase></aaif:Adverb><aaif:Entry rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En138"><aaif:phrase rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh#En138Ph1" /><aaif:source rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh.bibl#Cnde238" /><gams:textualContent>, non lo podemos errar.E por esto dize el thema: «Catad que  los omnes que andavan baxo  ya van arriba * al tenplo de Dios alabándolo».* E por esto dezía David en el</gams:textualContent><rel:isPartOf rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh" /></aaif:Entry><aaif:Phrase rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En138Ph1"><aaif:subject rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh#En138Ph1Su1" /><aaif:verb rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh#En138Ph1Ve1" /><aaif:adverb rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh#En138Ph1Ad1" /><aaif:text> los omnes que andavan baxo </aaif:text><aaif:annoText> [s|los omnes|mp] que [v|andavan|andar|is] [a|baxo|bajo|auvnlnnn] </aaif:annoText></aaif:Phrase><aaif:Subject rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En138Ph1Su1"><aaif:text>los omnes</aaif:text><aaif:position rdf:datatype="http://www.w3.org/2001/XMLSchema#int">1</aaif:position><aaif:gender rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Masculine" /><aaif:number rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Plural" /><aaif:overt rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</aaif:overt></aaif:Subject><aaif:Verb rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En138Ph1Ve1"><aaif:text>andavan</aaif:text><aaif:lemma rdf:resource="https://gams.uni-graz.at/o:aaif.lemma#andar" /><aaif:position rdf:datatype="http://www.w3.org/2001/XMLSchema#int">2</aaif:position><aaif:coordinated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:coordinated><aaif:partOfText rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</aaif:partOfText><aaif:syntacticConstruction rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Intransitive" /></aaif:Verb><aaif:Adverb rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En138Ph1Ad1"><aaif:text>baxo</aaif:text><aaif:lemma rdf:resource="https://gams.uni-graz.at/o:aaif.lemma#bajo" /><aaif:position rdf:datatype="http://www.w3.org/2001/XMLSchema#int">3</aaif:position><aaif:coordinated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:coordinated><aaif:morphosyntacticStructure rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Adjective" /><aaif:inflection rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Uninflected" /><aaif:attributionTarget rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Verb" /><aaif:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:modified><aaif:semanticClassification rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Location" /><aaif:reduplicated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:reduplicated><aaif:prepositionalPhrase rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:prepositionalPhrase></aaif:Adverb><aaif:Entry rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En139"><aaif:phrase rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh#En139Ph1" /><aaif:source rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh.bibl#Cnde238" /><gams:textualContent>* Ca ssi quisieren mirar alto, verán el fumo muy terrible e muy obscuro; e si  quisieron mirar baxo , verán el fuego muy ardiente.¿Quién podrá estar que non muera?E por esto non dize</gams:textualContent><rel:isPartOf rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh" /></aaif:Entry><aaif:Phrase rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En139Ph1"><aaif:subject rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh#En139Ph1Su1" /><aaif:verb rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh#En139Ph1Ve1" /><aaif:adverb rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh#En139Ph1Ad1" /><aaif:text>si  quisieron mirar baxo </aaif:text><aaif:annoText>si [s||up] quisieron [v|mirar|mirar|is] [a|baxo|bajo|auvnlnnn] </aaif:annoText></aaif:Phrase><aaif:Subject rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En139Ph1Su1"><aaif:position rdf:datatype="http://www.w3.org/2001/XMLSchema#int">1</aaif:position><aaif:gender rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Undefined" /><aaif:number rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Plural" /><aaif:overt rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:overt></aaif:Subject><aaif:Verb rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En139Ph1Ve1"><aaif:text>mirar</aaif:text><aaif:lemma rdf:resource="https://gams.uni-graz.at/o:aaif.lemma#mirar" /><aaif:position rdf:datatype="http://www.w3.org/2001/XMLSchema#int">2</aaif:position><aaif:coordinated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:coordinated><aaif:partOfText rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</aaif:partOfText><aaif:syntacticConstruction rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Intransitive" /></aaif:Verb><aaif:Adverb rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En139Ph1Ad1"><aaif:text>baxo</aaif:text><aaif:lemma rdf:resource="https://gams.uni-graz.at/o:aaif.lemma#bajo" /><aaif:position rdf:datatype="http://www.w3.org/2001/XMLSchema#int">3</aaif:position><aaif:coordinated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:coordinated><aaif:morphosyntacticStructure rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Adjective" /><aaif:inflection rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Uninflected" /><aaif:attributionTarget rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Verb" /><aaif:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:modified><aaif:semanticClassification rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Location" /><aaif:reduplicated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:reduplicated><aaif:prepositionalPhrase rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:prepositionalPhrase></aaif:Adverb><aaif:Entry rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En140"><aaif:phrase rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh#En140Ph1" /><aaif:source rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh.bibl#Cnde239" /><gams:textualContent>contiene en el Simbolo de nuestra fee, es de responder que  la Sancta Scriptur a usa de manera de fablar baxa , segun la qual pueden entender los ombres vulgares, et muchas vezes non pone las cosas propriamente ansi como</gams:textualContent><rel:isPartOf rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh" /></aaif:Entry><aaif:Phrase rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En140Ph1"><aaif:subject rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh#En140Ph1Su1" /><aaif:verb rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh#En140Ph1Ve1" /><aaif:adverb rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh#En140Ph1Ad1" /><aaif:text> la Sancta Scriptur a usa de manera de fablar baxa </aaif:text><aaif:annoText> [s|la Sancta Scriptur|fs] a usa de manera de [v|fablar|hablar|is] [a|baxa|bajo|afvnmnnn] </aaif:annoText></aaif:Phrase><aaif:Subject rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En140Ph1Su1"><aaif:text>la Sancta Scriptur</aaif:text><aaif:position rdf:datatype="http://www.w3.org/2001/XMLSchema#int">1</aaif:position><aaif:gender rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Feminine" /><aaif:number rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Singular" /><aaif:overt rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</aaif:overt></aaif:Subject><aaif:Verb rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En140Ph1Ve1"><aaif:text>fablar</aaif:text><aaif:lemma rdf:resource="https://gams.uni-graz.at/o:aaif.lemma#hablar" /><aaif:position rdf:datatype="http://www.w3.org/2001/XMLSchema#int">2</aaif:position><aaif:coordinated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:coordinated><aaif:partOfText rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</aaif:partOfText><aaif:syntacticConstruction rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Intransitive" /></aaif:Verb><aaif:Adverb rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En140Ph1Ad1"><aaif:text>baxa</aaif:text><aaif:lemma rdf:resource="https://gams.uni-graz.at/o:aaif.lemma#bajo" /><aaif:position rdf:datatype="http://www.w3.org/2001/XMLSchema#int">3</aaif:position><aaif:coordinated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:coordinated><aaif:morphosyntacticStructure rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Adjective" /><aaif:inflection rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#FeminineSingular" /><aaif:attributionTarget rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Verb" /><aaif:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:modified><aaif:semanticClassification rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Manner" /><aaif:reduplicated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:reduplicated><aaif:prepositionalPhrase rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:prepositionalPhrase></aaif:Adverb><aaif:Entry rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En141"><aaif:phrase rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh#En141Ph1" /><aaif:source rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh.bibl#Cnde240" /><gams:textualContent>dolor&lt;lb/&gt;en la paciencia del &lt;lb/&gt;muy mucho más ciño corto; &lt;lb/&gt;yo, si como y si me cingo &lt;lb/&gt; baxo , non basta'l caudal; &lt;lb/&gt;vos, que de fiesta y domingo&lt;lb/&gt;más contenéis que contingo, &lt;lb/&gt;ceñid vos alto</gams:textualContent><rel:isPartOf rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh" /></aaif:Entry><aaif:Phrase rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En141Ph1"><aaif:verb rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh#En141Ph1Ve1" /><aaif:adverb rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh#En141Ph1Ad1" /><aaif:text>si me cingo &lt;lb\/&gt; baxo </aaif:text><aaif:annoText>si me [v|cingo|ceñir|rs] &lt;lb\/&gt; [a|baxo|bajo|auvnlnnn] </aaif:annoText></aaif:Phrase><aaif:Verb rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En141Ph1Ve1"><aaif:text>cingo</aaif:text><aaif:lemma rdf:resource="https://gams.uni-graz.at/o:aaif.lemma#ceñir" /><aaif:position rdf:datatype="http://www.w3.org/2001/XMLSchema#int">1</aaif:position><aaif:coordinated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:coordinated><aaif:partOfText rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</aaif:partOfText><aaif:syntacticConstruction rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Reflexive" /></aaif:Verb><aaif:Adverb rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En141Ph1Ad1"><aaif:text>baxo</aaif:text><aaif:lemma rdf:resource="https://gams.uni-graz.at/o:aaif.lemma#bajo" /><aaif:position rdf:datatype="http://www.w3.org/2001/XMLSchema#int">2</aaif:position><aaif:coordinated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:coordinated><aaif:morphosyntacticStructure rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Adjective" /><aaif:inflection rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Uninflected" /><aaif:attributionTarget rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Verb" /><aaif:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:modified><aaif:semanticClassification rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Location" /><aaif:reduplicated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:reduplicated><aaif:prepositionalPhrase rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:prepositionalPhrase></aaif:Adverb><aaif:Entry rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En142"><aaif:phrase rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh#En142Ph1" /><aaif:source rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh.bibl#Cnde183" /><gams:textualContent>Dixo entonces miser Bernardo: «Cumple luego que vos se lo mostréis, y paréceme que es ésta una de las cosas que hacen mucho al caso;porque demás que hay algunos enamorados que con ciertas señas o con un ademán que no se puede decir qué es, se descubren tan cubiertamente a la persona que quieren, que casi sin hacer ellos ningún movimiento ella les lee en los ojos y en el gesto lo que dentro en el corazón tienen;he visto yo alguna vez algún hombre hablar con su amiga largo rato en sus amores y ser la plática de entrambos de tal arte que, aunque los que estaban delante oían lo más, no podían entender ninguna particularidad, ni certificarse que aquello fuesen amores;y esto todo se hacía porque tenían estos dos que hablaban estraño aviso y cuidado de todo lo que pasaban y llevaban tal arte en esto que sin mostrar estar recatados de los que los oían,    decían baxo solamente las palabras que más importaban y alto todas las otras que podían echarse a otros fines.»</gams:textualContent><rel:isPartOf rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh" /></aaif:Entry><aaif:Phrase rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En142Ph1"><aaif:subject rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh#En142Ph1Su1" /><aaif:verb rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh#En142Ph1Ve1" /><aaif:adverb rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh#En142Ph1Ad1" /><aaif:adverb rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh#En142Ph1Ad2" /><aaif:text>   decían baxo solamente las palabras que más importaban y alto todas las otras</aaif:text><aaif:annoText> [s||mp]  [v|decían|decir|ts] [a|baxo|bajo|auvnmnnC] solamente las palabras que más importaban y [a|alto|alto|auvnmnnC] todas las otras</aaif:annoText></aaif:Phrase><aaif:Subject rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En142Ph1Su1"><aaif:position rdf:datatype="http://www.w3.org/2001/XMLSchema#int">1</aaif:position><aaif:gender rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Masculine" /><aaif:number rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Plural" /><aaif:overt rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:overt></aaif:Subject><aaif:Verb rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En142Ph1Ve1"><aaif:text>decían</aaif:text><aaif:lemma rdf:resource="https://gams.uni-graz.at/o:aaif.lemma#decir" /><aaif:position rdf:datatype="http://www.w3.org/2001/XMLSchema#int">2</aaif:position><aaif:coordinated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:coordinated><aaif:partOfText rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</aaif:partOfText><aaif:syntacticConstruction rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Transitive" /></aaif:Verb><aaif:Adverb rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En142Ph1Ad1"><aaif:text>baxo</aaif:text><aaif:lemma rdf:resource="https://gams.uni-graz.at/o:aaif.lemma#bajo" /><aaif:position rdf:datatype="http://www.w3.org/2001/XMLSchema#int">3</aaif:position><aaif:coordinated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</aaif:coordinated><aaif:morphosyntacticStructure rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Adjective" /><aaif:inflection rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Uninflected" /><aaif:attributionTarget rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Verb" /><aaif:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:modified><aaif:semanticClassification rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Manner" /><aaif:reduplicated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:reduplicated><aaif:prepositionalPhrase rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:prepositionalPhrase></aaif:Adverb><aaif:Adverb rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En142Ph1Ad2"><aaif:text>alto</aaif:text><aaif:lemma rdf:resource="https://gams.uni-graz.at/o:aaif.lemma#alto" /><aaif:position rdf:datatype="http://www.w3.org/2001/XMLSchema#int">4</aaif:position><aaif:coordinated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</aaif:coordinated><aaif:morphosyntacticStructure rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Adjective" /><aaif:inflection rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Uninflected" /><aaif:attributionTarget rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Verb" /><aaif:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:modified><aaif:semanticClassification rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Manner" /><aaif:reduplicated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:reduplicated><aaif:prepositionalPhrase rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:prepositionalPhrase></aaif:Adverb><aaif:Entry rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En143"><aaif:phrase rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh#En143Ph1" /><aaif:source rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh.bibl#Cnde241" /><gams:textualContent>dexar una paja ni yerva.Antes un rato que lleguen al pueblo o a palacio   comiençan a cantar baxo  y a tirar los arcos al passo de la ordenança que traen.Suben poco a poco la boz hasta gañir</gams:textualContent><rel:isPartOf rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh" /></aaif:Entry><aaif:Phrase rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En143Ph1"><aaif:subject rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh#En143Ph1Su1" /><aaif:verb rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh#En143Ph1Ve1" /><aaif:adverb rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh#En143Ph1Ad1" /><aaif:text>  comiençan a cantar baxo </aaif:text><aaif:annoText> [s||up] comiençan a [v|cantar|cantar|is] [a|baxo|bajo|auvnmnnn] </aaif:annoText></aaif:Phrase><aaif:Subject rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En143Ph1Su1"><aaif:position rdf:datatype="http://www.w3.org/2001/XMLSchema#int">1</aaif:position><aaif:gender rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Undefined" /><aaif:number rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Plural" /><aaif:overt rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:overt></aaif:Subject><aaif:Verb rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En143Ph1Ve1"><aaif:text>cantar</aaif:text><aaif:lemma rdf:resource="https://gams.uni-graz.at/o:aaif.lemma#cantar" /><aaif:position rdf:datatype="http://www.w3.org/2001/XMLSchema#int">2</aaif:position><aaif:coordinated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:coordinated><aaif:partOfText rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</aaif:partOfText><aaif:syntacticConstruction rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Intransitive" /></aaif:Verb><aaif:Adverb rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En143Ph1Ad1"><aaif:text>baxo</aaif:text><aaif:lemma rdf:resource="https://gams.uni-graz.at/o:aaif.lemma#bajo" /><aaif:position rdf:datatype="http://www.w3.org/2001/XMLSchema#int">3</aaif:position><aaif:coordinated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:coordinated><aaif:morphosyntacticStructure rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Adjective" /><aaif:inflection rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Uninflected" /><aaif:attributionTarget rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Verb" /><aaif:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:modified><aaif:semanticClassification rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Manner" /><aaif:reduplicated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:reduplicated><aaif:prepositionalPhrase rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:prepositionalPhrase></aaif:Adverb><aaif:Entry rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En144"><aaif:phrase rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh#En144Ph1" /><aaif:source rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh.bibl#Cnde145" /><gams:textualContent>»Sus padres estaban de manera que fácilmente pudiera llegar y hablar bajo , sin ser sentida de alguno.Verdad es que estaba sobre aviso de lo que pudiera suceder, para</gams:textualContent><rel:isPartOf rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh" /></aaif:Entry><aaif:Phrase rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En144Ph1"><aaif:verb rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh#En144Ph1Ve1" /><aaif:adverb rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh#En144Ph1Ad1" /><aaif:text>fácilmente pudiera llegar y hablar bajo </aaif:text><aaif:annoText>fácilmente pudiera llegar y [v|hablar|hablar|is] [a|bajo|bajo|auvnmnnn] </aaif:annoText></aaif:Phrase><aaif:Verb rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En144Ph1Ve1"><aaif:text>hablar</aaif:text><aaif:lemma rdf:resource="https://gams.uni-graz.at/o:aaif.lemma#hablar" /><aaif:position rdf:datatype="http://www.w3.org/2001/XMLSchema#int">1</aaif:position><aaif:coordinated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:coordinated><aaif:partOfText rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</aaif:partOfText><aaif:syntacticConstruction rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Intransitive" /></aaif:Verb><aaif:Adverb rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En144Ph1Ad1"><aaif:text>bajo</aaif:text><aaif:lemma rdf:resource="https://gams.uni-graz.at/o:aaif.lemma#bajo" /><aaif:position rdf:datatype="http://www.w3.org/2001/XMLSchema#int">2</aaif:position><aaif:coordinated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:coordinated><aaif:morphosyntacticStructure rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Adjective" /><aaif:inflection rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Uninflected" /><aaif:attributionTarget rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Verb" /><aaif:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:modified><aaif:semanticClassification rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Manner" /><aaif:reduplicated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:reduplicated><aaif:prepositionalPhrase rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:prepositionalPhrase></aaif:Adverb><aaif:Entry rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En145"><aaif:phrase rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh#En145Ph1" /><aaif:source rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh.bibl#Cnde242" /><gams:textualContent>RODRIGO ¿Por qué?&lt;lb/&gt; Habla  bajo , escucha...</gams:textualContent><rel:isPartOf rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh" /></aaif:Entry><aaif:Phrase rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En145Ph1"><aaif:verb rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh#En145Ph1Ve1" /><aaif:adverb rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh#En145Ph1Ad1" /><aaif:text> Habla  bajo </aaif:text><aaif:annoText> [v|Habla|hablar|is]  [a|bajo|bajo|auvnmnnn] </aaif:annoText></aaif:Phrase><aaif:Verb rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En145Ph1Ve1"><aaif:text>Habla</aaif:text><aaif:lemma rdf:resource="https://gams.uni-graz.at/o:aaif.lemma#hablar" /><aaif:position rdf:datatype="http://www.w3.org/2001/XMLSchema#int">1</aaif:position><aaif:coordinated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:coordinated><aaif:partOfText rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</aaif:partOfText><aaif:syntacticConstruction rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Intransitive" /></aaif:Verb><aaif:Adverb rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En145Ph1Ad1"><aaif:text>bajo</aaif:text><aaif:lemma rdf:resource="https://gams.uni-graz.at/o:aaif.lemma#bajo" /><aaif:position rdf:datatype="http://www.w3.org/2001/XMLSchema#int">2</aaif:position><aaif:coordinated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:coordinated><aaif:morphosyntacticStructure rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Adjective" /><aaif:inflection rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Uninflected" /><aaif:attributionTarget rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Verb" /><aaif:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:modified><aaif:semanticClassification rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Manner" /><aaif:reduplicated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:reduplicated><aaif:prepositionalPhrase rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:prepositionalPhrase></aaif:Adverb><aaif:Entry rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En146"><aaif:phrase rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh#En146Ph1" /><aaif:source rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh.bibl#Cnde243" /><gams:textualContent>jacinta &lt;lb/&gt; Lee  bajo , que darás &lt;lb/&gt;mal ejemplo.&lt;lb/&gt;&lt;lb/&gt;lucrecia&lt;lb/&gt;No me oirás.&lt;lb/&gt;Toma y lee para ti.</gams:textualContent><rel:isPartOf rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh" /></aaif:Entry><aaif:Phrase rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En146Ph1"><aaif:verb rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh#En146Ph1Ve1" /><aaif:adverb rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh#En146Ph1Ad1" /><aaif:text> Lee  bajo </aaif:text><aaif:annoText> [v|Lee|leer|is]  [a|bajo|bajo|auvnmnnn] </aaif:annoText></aaif:Phrase><aaif:Verb rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En146Ph1Ve1"><aaif:text>Lee</aaif:text><aaif:lemma rdf:resource="https://gams.uni-graz.at/o:aaif.lemma#leer" /><aaif:position rdf:datatype="http://www.w3.org/2001/XMLSchema#int">1</aaif:position><aaif:coordinated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:coordinated><aaif:partOfText rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</aaif:partOfText><aaif:syntacticConstruction rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Intransitive" /></aaif:Verb><aaif:Adverb rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En146Ph1Ad1"><aaif:text>bajo</aaif:text><aaif:lemma rdf:resource="https://gams.uni-graz.at/o:aaif.lemma#bajo" /><aaif:position rdf:datatype="http://www.w3.org/2001/XMLSchema#int">2</aaif:position><aaif:coordinated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:coordinated><aaif:morphosyntacticStructure rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Adjective" /><aaif:inflection rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Uninflected" /><aaif:attributionTarget rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Verb" /><aaif:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:modified><aaif:semanticClassification rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Manner" /><aaif:reduplicated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:reduplicated><aaif:prepositionalPhrase rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:prepositionalPhrase></aaif:Adverb><aaif:Entry rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En147"><aaif:phrase rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh#En147Ph1" /><aaif:source rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh.bibl#Cnde152" /><gams:textualContent>LAURENCIO ¿No le dije yo?¿Cuánto va que es el romance para el mercader y el estribo para tu dinero?&lt;lb/&gt;BELA  Habla  bajo , ignorante.&lt;lb/&gt;FELIPA ¡Si la vieses con qué gracia está haciendo pestillos a los concetos, compitiendo con el papel la mano de la pluma, haciéndola más blanca la negra que está sirviéndola!</gams:textualContent><rel:isPartOf rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh" /></aaif:Entry><aaif:Phrase rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En147Ph1"><aaif:verb rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh#En147Ph1Ve1" /><aaif:adverb rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh#En147Ph1Ad1" /><aaif:text> Habla  bajo , ignorante</aaif:text><aaif:annoText> [v|Habla|hablar|is]  [a|bajo|bajo|auvnmnnn] , ignorante</aaif:annoText></aaif:Phrase><aaif:Verb rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En147Ph1Ve1"><aaif:text>Habla</aaif:text><aaif:lemma rdf:resource="https://gams.uni-graz.at/o:aaif.lemma#hablar" /><aaif:position rdf:datatype="http://www.w3.org/2001/XMLSchema#int">1</aaif:position><aaif:coordinated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:coordinated><aaif:partOfText rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</aaif:partOfText><aaif:syntacticConstruction rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Intransitive" /></aaif:Verb><aaif:Adverb rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En147Ph1Ad1"><aaif:text>bajo</aaif:text><aaif:lemma rdf:resource="https://gams.uni-graz.at/o:aaif.lemma#bajo" /><aaif:position rdf:datatype="http://www.w3.org/2001/XMLSchema#int">2</aaif:position><aaif:coordinated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:coordinated><aaif:morphosyntacticStructure rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Adjective" /><aaif:inflection rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Uninflected" /><aaif:attributionTarget rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Verb" /><aaif:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:modified><aaif:semanticClassification rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Manner" /><aaif:reduplicated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:reduplicated><aaif:prepositionalPhrase rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:prepositionalPhrase></aaif:Adverb><aaif:Entry rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En148"><aaif:phrase rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh#En148Ph1" /><aaif:source rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh.bibl#Cnde244" /><gams:textualContent>Juanita.&lt;lb/&gt;(Aparece en escena.) &lt;lb/&gt;Bien puedes llegarte; &lt;lb/&gt;pero habla bajito , &lt;lb/&gt;no sea nos oigan &lt;lb/&gt;la conversación.</gams:textualContent><rel:isPartOf rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh" /></aaif:Entry><aaif:Phrase rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En148Ph1"><aaif:verb rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh#En148Ph1Ve1" /><aaif:adverb rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh#En148Ph1Ad1" /><aaif:text>pero habla bajito </aaif:text><aaif:annoText>pero [v|habla|hablar|is] [a|bajito|bajo|auvnmnnn] </aaif:annoText></aaif:Phrase><aaif:Verb rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En148Ph1Ve1"><aaif:text>habla</aaif:text><aaif:lemma rdf:resource="https://gams.uni-graz.at/o:aaif.lemma#hablar" /><aaif:position rdf:datatype="http://www.w3.org/2001/XMLSchema#int">1</aaif:position><aaif:coordinated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:coordinated><aaif:partOfText rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</aaif:partOfText><aaif:syntacticConstruction rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Intransitive" /></aaif:Verb><aaif:Adverb rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En148Ph1Ad1"><aaif:text>bajito</aaif:text><aaif:lemma rdf:resource="https://gams.uni-graz.at/o:aaif.lemma#bajo" /><aaif:position rdf:datatype="http://www.w3.org/2001/XMLSchema#int">2</aaif:position><aaif:coordinated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:coordinated><aaif:morphosyntacticStructure rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Adjective" /><aaif:inflection rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Uninflected" /><aaif:attributionTarget rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Verb" /><aaif:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:modified><aaif:semanticClassification rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Manner" /><aaif:reduplicated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:reduplicated><aaif:prepositionalPhrase rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:prepositionalPhrase></aaif:Adverb><aaif:Entry rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En149"><aaif:phrase rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh#En149Ph1" /><aaif:source rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh.bibl#Cnde245" /><gams:textualContent>D.mariano &lt;lb/&gt; Habla  bajo , que está cerca &lt;lb/&gt;el tío.Allá me tenía &lt;lb/&gt;en su despacho; y si no entra &lt;lb/&gt;mi madre</gams:textualContent><rel:isPartOf rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh" /></aaif:Entry><aaif:Phrase rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En149Ph1"><aaif:verb rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh#En149Ph1Ve1" /><aaif:adverb rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh#En149Ph1Ad1" /><aaif:text> Habla  bajo </aaif:text><aaif:annoText> [v|Habla|hablar|is]  [a|bajo|bajo|auvnmnnn] </aaif:annoText></aaif:Phrase><aaif:Verb rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En149Ph1Ve1"><aaif:text>Habla</aaif:text><aaif:lemma rdf:resource="https://gams.uni-graz.at/o:aaif.lemma#hablar" /><aaif:position rdf:datatype="http://www.w3.org/2001/XMLSchema#int">1</aaif:position><aaif:coordinated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:coordinated><aaif:partOfText rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</aaif:partOfText><aaif:syntacticConstruction rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Intransitive" /></aaif:Verb><aaif:Adverb rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En149Ph1Ad1"><aaif:text>bajo</aaif:text><aaif:lemma rdf:resource="https://gams.uni-graz.at/o:aaif.lemma#bajo" /><aaif:position rdf:datatype="http://www.w3.org/2001/XMLSchema#int">2</aaif:position><aaif:coordinated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:coordinated><aaif:morphosyntacticStructure rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Adjective" /><aaif:inflection rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Uninflected" /><aaif:attributionTarget rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Verb" /><aaif:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:modified><aaif:semanticClassification rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Manner" /><aaif:reduplicated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:reduplicated><aaif:prepositionalPhrase rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:prepositionalPhrase></aaif:Adverb><aaif:Entry rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En150"><aaif:phrase rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh#En150Ph1" /><aaif:source rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh.bibl#Cnde246" /><gams:textualContent>— En buen hora, Ferrus.Llégate más cerca y habla bajo .Conozco tu celo, y tú conoces mi poder.Hasta la presente creo haberte recompensado más allá de</gams:textualContent><rel:isPartOf rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh" /></aaif:Entry><aaif:Phrase rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En150Ph1"><aaif:verb rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh#En150Ph1Ve1" /><aaif:adverb rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh#En150Ph1Ad1" /><aaif:text>Llégate más cerca y habla bajo </aaif:text><aaif:annoText>Llégate más cerca y [v|habla|hablar|is] [a|bajo|bajo|auvnmnnn] </aaif:annoText></aaif:Phrase><aaif:Verb rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En150Ph1Ve1"><aaif:text>habla</aaif:text><aaif:lemma rdf:resource="https://gams.uni-graz.at/o:aaif.lemma#hablar" /><aaif:position rdf:datatype="http://www.w3.org/2001/XMLSchema#int">1</aaif:position><aaif:coordinated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:coordinated><aaif:partOfText rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</aaif:partOfText><aaif:syntacticConstruction rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Intransitive" /></aaif:Verb><aaif:Adverb rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En150Ph1Ad1"><aaif:text>bajo</aaif:text><aaif:lemma rdf:resource="https://gams.uni-graz.at/o:aaif.lemma#bajo" /><aaif:position rdf:datatype="http://www.w3.org/2001/XMLSchema#int">2</aaif:position><aaif:coordinated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:coordinated><aaif:morphosyntacticStructure rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Adjective" /><aaif:inflection rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Uninflected" /><aaif:attributionTarget rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Verb" /><aaif:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:modified><aaif:semanticClassification rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Manner" /><aaif:reduplicated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:reduplicated><aaif:prepositionalPhrase rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:prepositionalPhrase></aaif:Adverb><aaif:Entry rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En151"><aaif:phrase rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh#En151Ph1" /><aaif:source rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh.bibl#Cnde247" /><gams:textualContent>»Se paró el amo y me dijo bajito y muy serio : María de Regla, llamarás a esa puerta, preguntarás por el señor doctor Montes de Oca, y harás</gams:textualContent><rel:isPartOf rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh" /></aaif:Entry><aaif:Phrase rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En151Ph1"><aaif:subject rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh#En151Ph1Su1" /><aaif:verb rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh#En151Ph1Ve1" /><aaif:adverb rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh#En151Ph1Ad1" /><aaif:adverb rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh#En151Ph1Ad2" /><aaif:text>Se paró el amo y me dijo bajito y muy serio </aaif:text><aaif:annoText>Se paró [s|el amo|ms] y me [v|dijo|decir|is] [a|bajito|bajo|auvnmnnC] y muy [a|serio|serio|auvmmnnC] </aaif:annoText></aaif:Phrase><aaif:Subject rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En151Ph1Su1"><aaif:text>el amo</aaif:text><aaif:position rdf:datatype="http://www.w3.org/2001/XMLSchema#int">1</aaif:position><aaif:gender rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Masculine" /><aaif:number rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Singular" /><aaif:overt rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</aaif:overt></aaif:Subject><aaif:Verb rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En151Ph1Ve1"><aaif:text>dijo</aaif:text><aaif:lemma rdf:resource="https://gams.uni-graz.at/o:aaif.lemma#decir" /><aaif:position rdf:datatype="http://www.w3.org/2001/XMLSchema#int">2</aaif:position><aaif:coordinated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:coordinated><aaif:partOfText rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</aaif:partOfText><aaif:syntacticConstruction rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Intransitive" /></aaif:Verb><aaif:Adverb rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En151Ph1Ad1"><aaif:text>bajito</aaif:text><aaif:lemma rdf:resource="https://gams.uni-graz.at/o:aaif.lemma#bajo" /><aaif:position rdf:datatype="http://www.w3.org/2001/XMLSchema#int">3</aaif:position><aaif:coordinated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</aaif:coordinated><aaif:morphosyntacticStructure rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Adjective" /><aaif:inflection rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Uninflected" /><aaif:attributionTarget rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Verb" /><aaif:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:modified><aaif:semanticClassification rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Manner" /><aaif:reduplicated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:reduplicated><aaif:prepositionalPhrase rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:prepositionalPhrase></aaif:Adverb><aaif:Adverb rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En151Ph1Ad2"><aaif:text>serio</aaif:text><aaif:lemma rdf:resource="https://gams.uni-graz.at/o:aaif.lemma#serio" /><aaif:position rdf:datatype="http://www.w3.org/2001/XMLSchema#int">4</aaif:position><aaif:coordinated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</aaif:coordinated><aaif:morphosyntacticStructure rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Adjective" /><aaif:inflection rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Uninflected" /><aaif:attributionTarget rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Verb" /><aaif:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</aaif:modified><aaif:semanticClassification rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Manner" /><aaif:reduplicated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:reduplicated><aaif:prepositionalPhrase rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:prepositionalPhrase></aaif:Adverb><aaif:Entry rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En152"><aaif:phrase rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh#En152Ph1" /><aaif:source rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh.bibl#Cnde248" /><gams:textualContent>— Mejor, porque así tendré tiempo de ir a bañarme.A ver, Salomé —dije parándome a la puerta de la cocina, a tiempo que  mis compadres se entraban a la sala conversando bajo —: ¿qué me tienes tú?</gams:textualContent><rel:isPartOf rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh" /></aaif:Entry><aaif:Phrase rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En152Ph1"><aaif:subject rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh#En152Ph1Su1" /><aaif:verb rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh#En152Ph1Ve1" /><aaif:adverb rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh#En152Ph1Ad1" /><aaif:text> mis compadres se entraban a la sala conversando bajo </aaif:text><aaif:annoText> [s|mis compadres|mp] se entraban a la sala [v|conversando|conversar|is] [a|bajo|bajo|auvnmnnn] </aaif:annoText></aaif:Phrase><aaif:Subject rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En152Ph1Su1"><aaif:text>mis compadres</aaif:text><aaif:position rdf:datatype="http://www.w3.org/2001/XMLSchema#int">1</aaif:position><aaif:gender rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Masculine" /><aaif:number rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Plural" /><aaif:overt rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</aaif:overt></aaif:Subject><aaif:Verb rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En152Ph1Ve1"><aaif:text>conversando</aaif:text><aaif:lemma rdf:resource="https://gams.uni-graz.at/o:aaif.lemma#conversar" /><aaif:position rdf:datatype="http://www.w3.org/2001/XMLSchema#int">2</aaif:position><aaif:coordinated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:coordinated><aaif:partOfText rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</aaif:partOfText><aaif:syntacticConstruction rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Intransitive" /></aaif:Verb><aaif:Adverb rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En152Ph1Ad1"><aaif:text>bajo</aaif:text><aaif:lemma rdf:resource="https://gams.uni-graz.at/o:aaif.lemma#bajo" /><aaif:position rdf:datatype="http://www.w3.org/2001/XMLSchema#int">3</aaif:position><aaif:coordinated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:coordinated><aaif:morphosyntacticStructure rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Adjective" /><aaif:inflection rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Uninflected" /><aaif:attributionTarget rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Verb" /><aaif:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:modified><aaif:semanticClassification rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Manner" /><aaif:reduplicated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:reduplicated><aaif:prepositionalPhrase rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:prepositionalPhrase></aaif:Adverb><aaif:Entry rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En153"><aaif:phrase rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh#En153Ph1" /><aaif:source rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh.bibl#Cnde248" /><gams:textualContent> Conversaban  bajo  don Jerónimo y Carlos , paseándose por el corredor de sus cuartos, cuando salté el vallado del huerto para caer al patio exterior.</gams:textualContent><rel:isPartOf rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh" /></aaif:Entry><aaif:Phrase rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En153Ph1"><aaif:subject rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh#En153Ph1Su1" /><aaif:verb rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh#En153Ph1Ve1" /><aaif:adverb rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh#En153Ph1Ad1" /><aaif:text> Conversaban  bajo  don Jerónimo y Carlos </aaif:text><aaif:annoText> [v|Conversaban|conversar|is]  [a|bajo|bajo|auvnmnnn]  [s|don Jerónimo y Carlos|mp] </aaif:annoText></aaif:Phrase><aaif:Subject rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En153Ph1Su1"><aaif:text>don Jerónimo y Carlos</aaif:text><aaif:position rdf:datatype="http://www.w3.org/2001/XMLSchema#int">3</aaif:position><aaif:gender rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Masculine" /><aaif:number rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Plural" /><aaif:overt rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</aaif:overt></aaif:Subject><aaif:Verb rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En153Ph1Ve1"><aaif:text>Conversaban</aaif:text><aaif:lemma rdf:resource="https://gams.uni-graz.at/o:aaif.lemma#conversar" /><aaif:position rdf:datatype="http://www.w3.org/2001/XMLSchema#int">1</aaif:position><aaif:coordinated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:coordinated><aaif:partOfText rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</aaif:partOfText><aaif:syntacticConstruction rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Intransitive" /></aaif:Verb><aaif:Adverb rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En153Ph1Ad1"><aaif:text>bajo</aaif:text><aaif:lemma rdf:resource="https://gams.uni-graz.at/o:aaif.lemma#bajo" /><aaif:position rdf:datatype="http://www.w3.org/2001/XMLSchema#int">2</aaif:position><aaif:coordinated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:coordinated><aaif:morphosyntacticStructure rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Adjective" /><aaif:inflection rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Uninflected" /><aaif:attributionTarget rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Verb" /><aaif:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:modified><aaif:semanticClassification rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Manner" /><aaif:reduplicated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:reduplicated><aaif:prepositionalPhrase rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:prepositionalPhrase></aaif:Adverb><aaif:Entry rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En154"><aaif:phrase rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh#En154Ph1" /><aaif:source rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh.bibl#Cnde181" /><gams:textualContent>lo más que podía al balcón, ponerse en pie sobre los estribos, estirar el cuello y  hablar  bajo  para que ella tuviese que inclinarse sobre la barandilla si quería oírle, que sí quería aquella tarde.</gams:textualContent><rel:isPartOf rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh" /></aaif:Entry><aaif:Phrase rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En154Ph1"><aaif:verb rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh#En154Ph1Ve1" /><aaif:adverb rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh#En154Ph1Ad1" /><aaif:text> hablar  bajo </aaif:text><aaif:annoText> [v|hablar|hablar|is]  [a|bajo|bajo|auvnmnnn] </aaif:annoText></aaif:Phrase><aaif:Verb rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En154Ph1Ve1"><aaif:text>hablar</aaif:text><aaif:lemma rdf:resource="https://gams.uni-graz.at/o:aaif.lemma#hablar" /><aaif:position rdf:datatype="http://www.w3.org/2001/XMLSchema#int">1</aaif:position><aaif:coordinated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:coordinated><aaif:partOfText rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</aaif:partOfText><aaif:syntacticConstruction rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Intransitive" /></aaif:Verb><aaif:Adverb rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En154Ph1Ad1"><aaif:text>bajo</aaif:text><aaif:lemma rdf:resource="https://gams.uni-graz.at/o:aaif.lemma#bajo" /><aaif:position rdf:datatype="http://www.w3.org/2001/XMLSchema#int">2</aaif:position><aaif:coordinated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:coordinated><aaif:morphosyntacticStructure rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Adjective" /><aaif:inflection rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Uninflected" /><aaif:attributionTarget rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Verb" /><aaif:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:modified><aaif:semanticClassification rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Manner" /><aaif:reduplicated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:reduplicated><aaif:prepositionalPhrase rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:prepositionalPhrase></aaif:Adverb><aaif:Entry rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En155"><aaif:phrase rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh#En155Ph1" /><aaif:source rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh.bibl#Cnde181" /><gams:textualContent>Esto lo cantó bajito  Joaquín Orgaz , tocando el tambor en la cabeza de Guimarán.Y acto continuo el mediquillo salió de la capilla oscura</gams:textualContent><rel:isPartOf rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh" /></aaif:Entry><aaif:Phrase rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En155Ph1"><aaif:subject rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh#En155Ph1Su1" /><aaif:verb rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh#En155Ph1Ve1" /><aaif:adverb rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh#En155Ph1Ad1" /><aaif:text>Esto lo cantó bajito  Joaquín Orgaz </aaif:text><aaif:annoText>Esto lo [v|cantó|cantar|ts] [a|bajito|bajo|auvnmnnn]  [s|Joaquín Orgaz|ms] </aaif:annoText></aaif:Phrase><aaif:Subject rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En155Ph1Su1"><aaif:text>Joaquín Orgaz</aaif:text><aaif:position rdf:datatype="http://www.w3.org/2001/XMLSchema#int">3</aaif:position><aaif:gender rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Masculine" /><aaif:number rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Singular" /><aaif:overt rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</aaif:overt></aaif:Subject><aaif:Verb rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En155Ph1Ve1"><aaif:text>cantó</aaif:text><aaif:lemma rdf:resource="https://gams.uni-graz.at/o:aaif.lemma#cantar" /><aaif:position rdf:datatype="http://www.w3.org/2001/XMLSchema#int">1</aaif:position><aaif:coordinated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:coordinated><aaif:partOfText rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</aaif:partOfText><aaif:syntacticConstruction rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Transitive" /></aaif:Verb><aaif:Adverb rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En155Ph1Ad1"><aaif:text>bajito</aaif:text><aaif:lemma rdf:resource="https://gams.uni-graz.at/o:aaif.lemma#bajo" /><aaif:position rdf:datatype="http://www.w3.org/2001/XMLSchema#int">2</aaif:position><aaif:coordinated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:coordinated><aaif:morphosyntacticStructure rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Adjective" /><aaif:inflection rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Uninflected" /><aaif:attributionTarget rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Verb" /><aaif:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:modified><aaif:semanticClassification rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Manner" /><aaif:reduplicated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:reduplicated><aaif:prepositionalPhrase rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:prepositionalPhrase></aaif:Adverb><aaif:Entry rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En156"><aaif:phrase rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh#En156Ph1" /><aaif:source rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh.bibl#Cnde249" /><gams:textualContent>y el más desatinado.Madruga y él formaban un delicioso contraste. Madruga era impasible de fisonomía, hablaba bajo , poco y como de mala gana;pero lo que hablaba salía forrado en cobre de sus labios, cuya expresión</gams:textualContent><rel:isPartOf rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh" /></aaif:Entry><aaif:Phrase rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En156Ph1"><aaif:subject rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh#En156Ph1Su1" /><aaif:verb rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh#En156Ph1Ve1" /><aaif:adverb rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh#En156Ph1Ad1" /><aaif:text> Madruga era impasible de fisonomía, hablaba bajo , poco y como de mala gana</aaif:text><aaif:annoText> [s|Madruga|fs] era impasible de fisonomía, [v|hablaba|hablar|is] [a|bajo|bajo|auvnmnnC] , poco y como de mala gana</aaif:annoText></aaif:Phrase><aaif:Subject rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En156Ph1Su1"><aaif:text>Madruga</aaif:text><aaif:position rdf:datatype="http://www.w3.org/2001/XMLSchema#int">1</aaif:position><aaif:gender rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Feminine" /><aaif:number rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Singular" /><aaif:overt rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</aaif:overt></aaif:Subject><aaif:Verb rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En156Ph1Ve1"><aaif:text>hablaba</aaif:text><aaif:lemma rdf:resource="https://gams.uni-graz.at/o:aaif.lemma#hablar" /><aaif:position rdf:datatype="http://www.w3.org/2001/XMLSchema#int">2</aaif:position><aaif:coordinated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:coordinated><aaif:partOfText rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</aaif:partOfText><aaif:syntacticConstruction rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Intransitive" /></aaif:Verb><aaif:Adverb rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En156Ph1Ad1"><aaif:text>bajo</aaif:text><aaif:lemma rdf:resource="https://gams.uni-graz.at/o:aaif.lemma#bajo" /><aaif:position rdf:datatype="http://www.w3.org/2001/XMLSchema#int">3</aaif:position><aaif:coordinated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</aaif:coordinated><aaif:morphosyntacticStructure rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Adjective" /><aaif:inflection rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Uninflected" /><aaif:attributionTarget rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Verb" /><aaif:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:modified><aaif:semanticClassification rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Manner" /><aaif:reduplicated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:reduplicated><aaif:prepositionalPhrase rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:prepositionalPhrase></aaif:Adverb><aaif:Entry rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En157"><aaif:phrase rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh#En157Ph1" /><aaif:source rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh.bibl#Cnde249" /><gams:textualContent>l hallarse la barquía enfrente de la Monja y próxima a los primeros barcos, volvió a decir Andrés , bajito también:</gams:textualContent><rel:isPartOf rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh" /></aaif:Entry><aaif:Phrase rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En157Ph1"><aaif:subject rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh#En157Ph1Su1" /><aaif:verb rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh#En157Ph1Ve1" /><aaif:adverb rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh#En157Ph1Ad1" /><aaif:text>volvió a decir Andrés , bajito también</aaif:text><aaif:annoText>volvió a [v|decir|decir|ts] [s|Andrés|ms] , [a|bajito|bajo|auvnmnnn] también</aaif:annoText></aaif:Phrase><aaif:Subject rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En157Ph1Su1"><aaif:text>Andrés</aaif:text><aaif:position rdf:datatype="http://www.w3.org/2001/XMLSchema#int">2</aaif:position><aaif:gender rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Masculine" /><aaif:number rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Singular" /><aaif:overt rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</aaif:overt></aaif:Subject><aaif:Verb rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En157Ph1Ve1"><aaif:text>decir</aaif:text><aaif:lemma rdf:resource="https://gams.uni-graz.at/o:aaif.lemma#decir" /><aaif:position rdf:datatype="http://www.w3.org/2001/XMLSchema#int">1</aaif:position><aaif:coordinated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:coordinated><aaif:partOfText rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</aaif:partOfText><aaif:syntacticConstruction rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Transitive" /></aaif:Verb><aaif:Adverb rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En157Ph1Ad1"><aaif:text>bajito</aaif:text><aaif:lemma rdf:resource="https://gams.uni-graz.at/o:aaif.lemma#bajo" /><aaif:position rdf:datatype="http://www.w3.org/2001/XMLSchema#int">3</aaif:position><aaif:coordinated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:coordinated><aaif:morphosyntacticStructure rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Adjective" /><aaif:inflection rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Uninflected" /><aaif:attributionTarget rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Verb" /><aaif:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:modified><aaif:semanticClassification rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Manner" /><aaif:reduplicated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:reduplicated><aaif:prepositionalPhrase rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:prepositionalPhrase></aaif:Adverb><aaif:Entry rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En158"><aaif:phrase rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh#En158Ph1" /><aaif:source rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh.bibl#Cnde140" /><gams:textualContent>sacando del bolsillo castañas, las ponían a asar entre el rescoldo; y  todas , empezando por cuchichear bajito , acababan por charlotear como urracas.Era Sabel la reina de aquella pequeña corte: sofocada por la llama</gams:textualContent><rel:isPartOf rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh" /></aaif:Entry><aaif:Phrase rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En158Ph1"><aaif:subject rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh#En158Ph1Su1" /><aaif:verb rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh#En158Ph1Ve1" /><aaif:adverb rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh#En158Ph1Ad1" /><aaif:text> todas , empezando por cuchichear bajito </aaif:text><aaif:annoText> [s|todas|fp] , empezando por [v|cuchichear|cuchichear|is] [a|bajito|bajo|auvnmnnn] </aaif:annoText></aaif:Phrase><aaif:Subject rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En158Ph1Su1"><aaif:text>todas</aaif:text><aaif:position rdf:datatype="http://www.w3.org/2001/XMLSchema#int">1</aaif:position><aaif:gender rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Feminine" /><aaif:number rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Plural" /><aaif:overt rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</aaif:overt></aaif:Subject><aaif:Verb rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En158Ph1Ve1"><aaif:text>cuchichear</aaif:text><aaif:lemma rdf:resource="https://gams.uni-graz.at/o:aaif.lemma#cuchichear" /><aaif:position rdf:datatype="http://www.w3.org/2001/XMLSchema#int">2</aaif:position><aaif:coordinated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:coordinated><aaif:partOfText rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</aaif:partOfText><aaif:syntacticConstruction rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Intransitive" /></aaif:Verb><aaif:Adverb rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En158Ph1Ad1"><aaif:text>bajito</aaif:text><aaif:lemma rdf:resource="https://gams.uni-graz.at/o:aaif.lemma#bajo" /><aaif:position rdf:datatype="http://www.w3.org/2001/XMLSchema#int">3</aaif:position><aaif:coordinated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:coordinated><aaif:morphosyntacticStructure rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Adjective" /><aaif:inflection rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Uninflected" /><aaif:attributionTarget rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Verb" /><aaif:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:modified><aaif:semanticClassification rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Manner" /><aaif:reduplicated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:reduplicated><aaif:prepositionalPhrase rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:prepositionalPhrase></aaif:Adverb><aaif:Entry rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En159"><aaif:phrase rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh#En159Ph1" /><aaif:source rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh.bibl#Cnde140" /><gams:textualContent> los convidados , transidos aún del miedo que infunde el terrible sacramento del matrimonio visto de cerca, hablaban bajito , lo mismo que en un duelo, esmerándose en evitar hasta el repique de las cucharillas en la loza</gams:textualContent><rel:isPartOf rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh" /></aaif:Entry><aaif:Phrase rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En159Ph1"><aaif:subject rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh#En159Ph1Su1" /><aaif:verb rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh#En159Ph1Ve1" /><aaif:adverb rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh#En159Ph1Ad1" /><aaif:text> los convidados , transidos aún del miedo que infunde el terrible sacramento del matrimonio visto de cerca, hablaban bajito </aaif:text><aaif:annoText> [s|los convidados|mp] , transidos aún del miedo que infunde el terrible sacramento del matrimonio visto de cerca, [v|hablaban|hablar|is] [a|bajito|bajo|auvnmnnn] </aaif:annoText></aaif:Phrase><aaif:Subject rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En159Ph1Su1"><aaif:text>los convidados</aaif:text><aaif:position rdf:datatype="http://www.w3.org/2001/XMLSchema#int">1</aaif:position><aaif:gender rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Masculine" /><aaif:number rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Plural" /><aaif:overt rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</aaif:overt></aaif:Subject><aaif:Verb rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En159Ph1Ve1"><aaif:text>hablaban</aaif:text><aaif:lemma rdf:resource="https://gams.uni-graz.at/o:aaif.lemma#hablar" /><aaif:position rdf:datatype="http://www.w3.org/2001/XMLSchema#int">2</aaif:position><aaif:coordinated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:coordinated><aaif:partOfText rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</aaif:partOfText><aaif:syntacticConstruction rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Intransitive" /></aaif:Verb><aaif:Adverb rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En159Ph1Ad1"><aaif:text>bajito</aaif:text><aaif:lemma rdf:resource="https://gams.uni-graz.at/o:aaif.lemma#bajo" /><aaif:position rdf:datatype="http://www.w3.org/2001/XMLSchema#int">3</aaif:position><aaif:coordinated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:coordinated><aaif:morphosyntacticStructure rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Adjective" /><aaif:inflection rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Uninflected" /><aaif:attributionTarget rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Verb" /><aaif:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:modified><aaif:semanticClassification rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Manner" /><aaif:reduplicated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:reduplicated><aaif:prepositionalPhrase rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:prepositionalPhrase></aaif:Adverb><aaif:Entry rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En160"><aaif:phrase rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh#En160Ph1" /><aaif:source rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh.bibl#Cnde140" /><gams:textualContent>que aquella mañana había de ser fecunda en extraordinarias sorpresas.En la capilla acostumbraba Perucho notar que se hablaba bajito , se andaba despacio, se contenía hasta la respiración: el menor desliz en tal materia solía costarle un</gams:textualContent><rel:isPartOf rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh" /></aaif:Entry><aaif:Phrase rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En160Ph1"><aaif:verb rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh#En160Ph1Ve1" /><aaif:adverb rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh#En160Ph1Ad1" /><aaif:text>se hablaba bajito , se andaba despacio</aaif:text><aaif:annoText>se [v|hablaba|hablar|rs] [a|bajito|bajo|auvnmnnn] , se andaba despacio</aaif:annoText></aaif:Phrase><aaif:Verb rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En160Ph1Ve1"><aaif:text>hablaba</aaif:text><aaif:lemma rdf:resource="https://gams.uni-graz.at/o:aaif.lemma#hablar" /><aaif:position rdf:datatype="http://www.w3.org/2001/XMLSchema#int">1</aaif:position><aaif:coordinated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:coordinated><aaif:partOfText rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</aaif:partOfText><aaif:syntacticConstruction rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Reflexive" /></aaif:Verb><aaif:Adverb rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En160Ph1Ad1"><aaif:text>bajito</aaif:text><aaif:lemma rdf:resource="https://gams.uni-graz.at/o:aaif.lemma#bajo" /><aaif:position rdf:datatype="http://www.w3.org/2001/XMLSchema#int">2</aaif:position><aaif:coordinated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:coordinated><aaif:morphosyntacticStructure rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Adjective" /><aaif:inflection rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Uninflected" /><aaif:attributionTarget rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Verb" /><aaif:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:modified><aaif:semanticClassification rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Manner" /><aaif:reduplicated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:reduplicated><aaif:prepositionalPhrase rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:prepositionalPhrase></aaif:Adverb><aaif:Entry rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En161"><aaif:phrase rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh#En161Ph1" /><aaif:source rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh.bibl#Cnde250" /><gams:textualContent>Al despedirse de mí, me habló bajito :</gams:textualContent><rel:isPartOf rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh" /></aaif:Entry><aaif:Phrase rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En161Ph1"><aaif:verb rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh#En161Ph1Ve1" /><aaif:adverb rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh#En161Ph1Ad1" /><aaif:text>me habló bajito </aaif:text><aaif:annoText>me [v|habló|hablar|ts] [a|bajito|bajo|auvnmnnn] </aaif:annoText></aaif:Phrase><aaif:Verb rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En161Ph1Ve1"><aaif:text>habló</aaif:text><aaif:lemma rdf:resource="https://gams.uni-graz.at/o:aaif.lemma#hablar" /><aaif:position rdf:datatype="http://www.w3.org/2001/XMLSchema#int">1</aaif:position><aaif:coordinated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:coordinated><aaif:partOfText rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</aaif:partOfText><aaif:syntacticConstruction rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Transitive" /></aaif:Verb><aaif:Adverb rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En161Ph1Ad1"><aaif:text>bajito</aaif:text><aaif:lemma rdf:resource="https://gams.uni-graz.at/o:aaif.lemma#bajo" /><aaif:position rdf:datatype="http://www.w3.org/2001/XMLSchema#int">2</aaif:position><aaif:coordinated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:coordinated><aaif:morphosyntacticStructure rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Adjective" /><aaif:inflection rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Uninflected" /><aaif:attributionTarget rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Verb" /><aaif:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:modified><aaif:semanticClassification rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Manner" /><aaif:reduplicated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:reduplicated><aaif:prepositionalPhrase rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:prepositionalPhrase></aaif:Adverb><aaif:Entry rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En162"><aaif:phrase rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh#En162Ph1" /><aaif:source rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh.bibl#Cnde250" /><gams:textualContent> Gavilán continuó hablando bajo , y sólo podía yo escuchar las respuestas y exclamaciones del coronel.Oí como el ruido de un</gams:textualContent><rel:isPartOf rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh" /></aaif:Entry><aaif:Phrase rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En162Ph1"><aaif:subject rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh#En162Ph1Su1" /><aaif:verb rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh#En162Ph1Ve1" /><aaif:adverb rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh#En162Ph1Ad1" /><aaif:text> Gavilán continuó hablando bajo </aaif:text><aaif:annoText> [s|Gavilán|ms] continuó [v|hablando|hablar|is] [a|bajo|bajo|auvnmnnn] </aaif:annoText></aaif:Phrase><aaif:Subject rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En162Ph1Su1"><aaif:text>Gavilán</aaif:text><aaif:position rdf:datatype="http://www.w3.org/2001/XMLSchema#int">1</aaif:position><aaif:gender rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Masculine" /><aaif:number rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Singular" /><aaif:overt rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</aaif:overt></aaif:Subject><aaif:Verb rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En162Ph1Ve1"><aaif:text>hablando</aaif:text><aaif:lemma rdf:resource="https://gams.uni-graz.at/o:aaif.lemma#hablar" /><aaif:position rdf:datatype="http://www.w3.org/2001/XMLSchema#int">2</aaif:position><aaif:coordinated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:coordinated><aaif:partOfText rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</aaif:partOfText><aaif:syntacticConstruction rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Intransitive" /></aaif:Verb><aaif:Adverb rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En162Ph1Ad1"><aaif:text>bajo</aaif:text><aaif:lemma rdf:resource="https://gams.uni-graz.at/o:aaif.lemma#bajo" /><aaif:position rdf:datatype="http://www.w3.org/2001/XMLSchema#int">3</aaif:position><aaif:coordinated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:coordinated><aaif:morphosyntacticStructure rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Adjective" /><aaif:inflection rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Uninflected" /><aaif:attributionTarget rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Verb" /><aaif:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:modified><aaif:semanticClassification rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Manner" /><aaif:reduplicated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:reduplicated><aaif:prepositionalPhrase rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:prepositionalPhrase></aaif:Adverb><aaif:Entry rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En163"><aaif:phrase rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh#En163Ph1" /><aaif:source rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh.bibl#Cnde20" /><gams:textualContent> Fray Benito miró de una manera dulce al padre guardián, murmurando bajo , y sonriente:</gams:textualContent><rel:isPartOf rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh" /></aaif:Entry><aaif:Phrase rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En163Ph1"><aaif:subject rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh#En163Ph1Su1" /><aaif:verb rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh#En163Ph1Ve1" /><aaif:adverb rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh#En163Ph1Ad1" /><aaif:text> Fray Benito miró de una manera dulce al padre guardián, murmurando bajo , y sonriente</aaif:text><aaif:annoText> [s|Fray Benito|ms] miró de una manera dulce al padre guardián, [v|murmurando|murmurar|ts] [a|bajo|bajo|auvnmnnC] , y sonriente</aaif:annoText></aaif:Phrase><aaif:Subject rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En163Ph1Su1"><aaif:text>Fray Benito</aaif:text><aaif:position rdf:datatype="http://www.w3.org/2001/XMLSchema#int">1</aaif:position><aaif:gender rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Masculine" /><aaif:number rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Singular" /><aaif:overt rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</aaif:overt></aaif:Subject><aaif:Verb rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En163Ph1Ve1"><aaif:text>murmurando</aaif:text><aaif:lemma rdf:resource="https://gams.uni-graz.at/o:aaif.lemma#murmurar" /><aaif:position rdf:datatype="http://www.w3.org/2001/XMLSchema#int">2</aaif:position><aaif:coordinated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:coordinated><aaif:partOfText rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</aaif:partOfText><aaif:syntacticConstruction rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Transitive" /></aaif:Verb><aaif:Adverb rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En163Ph1Ad1"><aaif:text>bajo</aaif:text><aaif:lemma rdf:resource="https://gams.uni-graz.at/o:aaif.lemma#bajo" /><aaif:position rdf:datatype="http://www.w3.org/2001/XMLSchema#int">3</aaif:position><aaif:coordinated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</aaif:coordinated><aaif:morphosyntacticStructure rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Adjective" /><aaif:inflection rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Uninflected" /><aaif:attributionTarget rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Verb" /><aaif:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:modified><aaif:semanticClassification rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Manner" /><aaif:reduplicated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:reduplicated><aaif:prepositionalPhrase rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:prepositionalPhrase></aaif:Adverb><aaif:Entry rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En164"><aaif:phrase rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh#En164Ph1" /><aaif:source rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh.bibl#Cnde20" /><gams:textualContent>Al cabo de un rato bajó la cabeza que había erguido, como el mastín de raza que huele pendencia;dejóla caer de cara sobre sus brazos cruzados, refrególa en ellos perezoso y plegando los párpados en pesada modorra,  murmuró  bajo algunas palabras a modo de rezongo.</gams:textualContent><rel:isPartOf rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh" /></aaif:Entry><aaif:Phrase rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En164Ph1"><aaif:verb rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh#En164Ph1Ve1" /><aaif:adverb rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh#En164Ph1Ad1" /><aaif:text> murmuró  bajo algunas palabras</aaif:text><aaif:annoText> [v|murmuró|murmurar|ts]  [a|bajo|bajo|auvnmnnn] algunas palabras</aaif:annoText></aaif:Phrase><aaif:Verb rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En164Ph1Ve1"><aaif:text>murmuró</aaif:text><aaif:lemma rdf:resource="https://gams.uni-graz.at/o:aaif.lemma#murmurar" /><aaif:position rdf:datatype="http://www.w3.org/2001/XMLSchema#int">1</aaif:position><aaif:coordinated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:coordinated><aaif:partOfText rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</aaif:partOfText><aaif:syntacticConstruction rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Transitive" /></aaif:Verb><aaif:Adverb rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En164Ph1Ad1"><aaif:text>bajo</aaif:text><aaif:lemma rdf:resource="https://gams.uni-graz.at/o:aaif.lemma#bajo" /><aaif:position rdf:datatype="http://www.w3.org/2001/XMLSchema#int">2</aaif:position><aaif:coordinated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:coordinated><aaif:morphosyntacticStructure rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Adjective" /><aaif:inflection rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Uninflected" /><aaif:attributionTarget rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Verb" /><aaif:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:modified><aaif:semanticClassification rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Manner" /><aaif:reduplicated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:reduplicated><aaif:prepositionalPhrase rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:prepositionalPhrase></aaif:Adverb><aaif:Entry rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En165"><aaif:phrase rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh#En165Ph1" /><aaif:source rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh.bibl#Cnde20" /><gams:textualContent>Allí,  el overo fue acortando el paso, piafó bajo y sordamente dos veces, y se detuvo con el hocico estirado y las orejas tiesas.</gams:textualContent><rel:isPartOf rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh" /></aaif:Entry><aaif:Phrase rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En165Ph1"><aaif:subject rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh#En165Ph1Su1" /><aaif:verb rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh#En165Ph1Ve1" /><aaif:adverb rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh#En165Ph1Ad1" /><aaif:text> el overo fue acortando el paso, piafó bajo y sordamente</aaif:text><aaif:annoText> [s|el overo|ms] fue acortando el paso, [v|piafó|piafar|is] [a|bajo|bajo|auvnmnnC] y sordamente</aaif:annoText></aaif:Phrase><aaif:Subject rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En165Ph1Su1"><aaif:text>el overo</aaif:text><aaif:position rdf:datatype="http://www.w3.org/2001/XMLSchema#int">1</aaif:position><aaif:gender rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Masculine" /><aaif:number rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Singular" /><aaif:overt rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</aaif:overt></aaif:Subject><aaif:Verb rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En165Ph1Ve1"><aaif:text>piafó</aaif:text><aaif:lemma rdf:resource="https://gams.uni-graz.at/o:aaif.lemma#piafar" /><aaif:position rdf:datatype="http://www.w3.org/2001/XMLSchema#int">2</aaif:position><aaif:coordinated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:coordinated><aaif:partOfText rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</aaif:partOfText><aaif:syntacticConstruction rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Intransitive" /></aaif:Verb><aaif:Adverb rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En165Ph1Ad1"><aaif:text>bajo</aaif:text><aaif:lemma rdf:resource="https://gams.uni-graz.at/o:aaif.lemma#bajo" /><aaif:position rdf:datatype="http://www.w3.org/2001/XMLSchema#int">3</aaif:position><aaif:coordinated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</aaif:coordinated><aaif:morphosyntacticStructure rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Adjective" /><aaif:inflection rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Uninflected" /><aaif:attributionTarget rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Verb" /><aaif:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:modified><aaif:semanticClassification rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Manner" /><aaif:reduplicated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:reduplicated><aaif:prepositionalPhrase rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:prepositionalPhrase></aaif:Adverb><aaif:Entry rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En166"><aaif:phrase rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh#En166Ph1" /><aaif:source rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh.bibl#Cnde251" /><gams:textualContent>posar la ardiente cabeza, &lt;lb/&gt;y así, soñando embriagado &lt;lb/&gt;inmortales primaveras, &lt;lb/&gt;auroras interminables, &lt;lb/&gt;felicidades supremas, &lt;lb/&gt; decirte bajo, muy bajo , &lt;lb/&gt;que tan sólo tú lo oyeras, &lt;lb/&gt;en la lengua de los dioses &lt;lb/&gt;todo un poema</gams:textualContent><rel:isPartOf rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh" /></aaif:Entry><aaif:Phrase rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En166Ph1"><aaif:verb rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh#En166Ph1Ve1" /><aaif:adverb rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh#En166Ph1Ad1" /><aaif:text> decirte bajo, muy bajo </aaif:text><aaif:annoText> [v|decirte|decir|ts] bajo, muy [a|bajo|bajo|auvmmrnn] </aaif:annoText></aaif:Phrase><aaif:Verb rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En166Ph1Ve1"><aaif:text>decirte</aaif:text><aaif:lemma rdf:resource="https://gams.uni-graz.at/o:aaif.lemma#decir" /><aaif:position rdf:datatype="http://www.w3.org/2001/XMLSchema#int">1</aaif:position><aaif:coordinated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:coordinated><aaif:partOfText rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</aaif:partOfText><aaif:syntacticConstruction rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Transitive" /></aaif:Verb><aaif:Adverb rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En166Ph1Ad1"><aaif:text>bajo</aaif:text><aaif:lemma rdf:resource="https://gams.uni-graz.at/o:aaif.lemma#bajo" /><aaif:position rdf:datatype="http://www.w3.org/2001/XMLSchema#int">2</aaif:position><aaif:coordinated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:coordinated><aaif:morphosyntacticStructure rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Adjective" /><aaif:inflection rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Uninflected" /><aaif:attributionTarget rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Verb" /><aaif:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</aaif:modified><aaif:semanticClassification rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Manner" /><aaif:reduplicated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</aaif:reduplicated><aaif:prepositionalPhrase rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:prepositionalPhrase></aaif:Adverb><aaif:Entry rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En167"><aaif:phrase rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh#En167Ph1" /><aaif:source rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh.bibl#Cnde25" /><gams:textualContent>— ¿Es usted de los que encuentran desconsoladora la perspectiva del no ser?— articuló  bajito  Minia , que se cubrió la cabeza, por respeto al lugar sagrado, con el chal de lana</gams:textualContent><rel:isPartOf rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh" /></aaif:Entry><aaif:Phrase rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En167Ph1"><aaif:subject rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh#En167Ph1Su1" /><aaif:verb rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh#En167Ph1Ve1" /><aaif:adverb rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh#En167Ph1Ad1" /><aaif:text> articuló  bajito  Minia </aaif:text><aaif:annoText> [v|articuló|articular|ts]  [a|bajito|bajo|auvnmnnn]  [s|Minia|fs] </aaif:annoText></aaif:Phrase><aaif:Subject rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En167Ph1Su1"><aaif:text>Minia</aaif:text><aaif:position rdf:datatype="http://www.w3.org/2001/XMLSchema#int">3</aaif:position><aaif:gender rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Feminine" /><aaif:number rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Singular" /><aaif:overt rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</aaif:overt></aaif:Subject><aaif:Verb rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En167Ph1Ve1"><aaif:text>articuló</aaif:text><aaif:lemma rdf:resource="https://gams.uni-graz.at/o:aaif.lemma#articular" /><aaif:position rdf:datatype="http://www.w3.org/2001/XMLSchema#int">1</aaif:position><aaif:coordinated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:coordinated><aaif:partOfText rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</aaif:partOfText><aaif:syntacticConstruction rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Transitive" /></aaif:Verb><aaif:Adverb rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En167Ph1Ad1"><aaif:text>bajito</aaif:text><aaif:lemma rdf:resource="https://gams.uni-graz.at/o:aaif.lemma#bajo" /><aaif:position rdf:datatype="http://www.w3.org/2001/XMLSchema#int">2</aaif:position><aaif:coordinated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:coordinated><aaif:morphosyntacticStructure rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Adjective" /><aaif:inflection rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Uninflected" /><aaif:attributionTarget rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Verb" /><aaif:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:modified><aaif:semanticClassification rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Manner" /><aaif:reduplicated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:reduplicated><aaif:prepositionalPhrase rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:prepositionalPhrase></aaif:Adverb><aaif:Entry rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En168"><aaif:phrase rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh#En168Ph1" /><aaif:source rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh.bibl#Cnde25" /><gams:textualContent>que hizo fue un guiño de complicidad, un gesto pícaro, envuelto en una caricia fogosa.Y  riendo  bajo , satisfecha, campante, exclamó:</gams:textualContent><rel:isPartOf rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh" /></aaif:Entry><aaif:Phrase rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En168Ph1"><aaif:verb rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh#En168Ph1Ve1" /><aaif:adverb rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh#En168Ph1Ad1" /><aaif:text> riendo  bajo , satisfecha, campante</aaif:text><aaif:annoText> [v|riendo|reír|is]  [a|bajo|bajo|auvnmnnC] , satisfecha, campante</aaif:annoText></aaif:Phrase><aaif:Verb rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En168Ph1Ve1"><aaif:text>riendo</aaif:text><aaif:lemma rdf:resource="https://gams.uni-graz.at/o:aaif.lemma#reír" /><aaif:position rdf:datatype="http://www.w3.org/2001/XMLSchema#int">1</aaif:position><aaif:coordinated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:coordinated><aaif:partOfText rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</aaif:partOfText><aaif:syntacticConstruction rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Intransitive" /></aaif:Verb><aaif:Adverb rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En168Ph1Ad1"><aaif:text>bajo</aaif:text><aaif:lemma rdf:resource="https://gams.uni-graz.at/o:aaif.lemma#bajo" /><aaif:position rdf:datatype="http://www.w3.org/2001/XMLSchema#int">2</aaif:position><aaif:coordinated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</aaif:coordinated><aaif:morphosyntacticStructure rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Adjective" /><aaif:inflection rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Uninflected" /><aaif:attributionTarget rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Verb" /><aaif:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:modified><aaif:semanticClassification rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Manner" /><aaif:reduplicated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:reduplicated><aaif:prepositionalPhrase rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:prepositionalPhrase></aaif:Adverb><aaif:Entry rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En169"><aaif:phrase rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh#En169Ph1" /><aaif:source rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh.bibl#Cnde25" /><gams:textualContent>una medadora, que se le guisaban muchos platos, que de Marineda venía el médico a menudo...Y    susurraban bajo : «¡Tan nuevo!¡Tan mociño y tan galán!¡Dios lo remedie!» Después</gams:textualContent><rel:isPartOf rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh" /></aaif:Entry><aaif:Phrase rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En169Ph1"><aaif:subject rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh#En169Ph1Su1" /><aaif:verb rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh#En169Ph1Ve1" /><aaif:adverb rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh#En169Ph1Ad1" /><aaif:text>   susurraban bajo </aaif:text><aaif:annoText> [s||up]  [v|susurraban|susurrar|ts] [a|bajo|bajo|auvnmnnn] </aaif:annoText></aaif:Phrase><aaif:Subject rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En169Ph1Su1"><aaif:position rdf:datatype="http://www.w3.org/2001/XMLSchema#int">1</aaif:position><aaif:gender rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Undefined" /><aaif:number rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Plural" /><aaif:overt rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:overt></aaif:Subject><aaif:Verb rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En169Ph1Ve1"><aaif:text>susurraban</aaif:text><aaif:lemma rdf:resource="https://gams.uni-graz.at/o:aaif.lemma#susurrar" /><aaif:position rdf:datatype="http://www.w3.org/2001/XMLSchema#int">2</aaif:position><aaif:coordinated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:coordinated><aaif:partOfText rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</aaif:partOfText><aaif:syntacticConstruction rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Transitive" /></aaif:Verb><aaif:Adverb rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En169Ph1Ad1"><aaif:text>bajo</aaif:text><aaif:lemma rdf:resource="https://gams.uni-graz.at/o:aaif.lemma#bajo" /><aaif:position rdf:datatype="http://www.w3.org/2001/XMLSchema#int">3</aaif:position><aaif:coordinated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:coordinated><aaif:morphosyntacticStructure rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Adjective" /><aaif:inflection rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Uninflected" /><aaif:attributionTarget rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Verb" /><aaif:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:modified><aaif:semanticClassification rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Manner" /><aaif:reduplicated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:reduplicated><aaif:prepositionalPhrase rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:prepositionalPhrase></aaif:Adverb><aaif:Entry rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En170"><aaif:phrase rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh#En170Ph1" /><aaif:source rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh.bibl#Cnde223" /><gams:textualContent>Y si hubo áspera hiel en mi existencia, &lt;lb/&gt;Melificó toda acritud el Arte.&lt;lb/&gt;&lt;lb/&gt;Mi intelecto libré de pensar bajo , &lt;lb/&gt;Bañó el agua castalia el alma mía, &lt;lb/&gt;Peregrinó mi corazón y trajo &lt;lb/&gt;De la sagrada selva la armonía</gams:textualContent><rel:isPartOf rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh" /></aaif:Entry><aaif:Phrase rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En170Ph1"><aaif:verb rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh#En170Ph1Ve1" /><aaif:adverb rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh#En170Ph1Ad1" /><aaif:text>Mi intelecto libré de pensar bajo </aaif:text><aaif:annoText>Mi intelecto libré de [v|pensar|pensar|is] [a|bajo|bajo|auvnmnnn] </aaif:annoText></aaif:Phrase><aaif:Verb rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En170Ph1Ve1"><aaif:text>pensar</aaif:text><aaif:lemma rdf:resource="https://gams.uni-graz.at/o:aaif.lemma#pensar" /><aaif:position rdf:datatype="http://www.w3.org/2001/XMLSchema#int">1</aaif:position><aaif:coordinated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:coordinated><aaif:partOfText rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</aaif:partOfText><aaif:syntacticConstruction rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Intransitive" /></aaif:Verb><aaif:Adverb rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En170Ph1Ad1"><aaif:text>bajo</aaif:text><aaif:lemma rdf:resource="https://gams.uni-graz.at/o:aaif.lemma#bajo" /><aaif:position rdf:datatype="http://www.w3.org/2001/XMLSchema#int">2</aaif:position><aaif:coordinated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:coordinated><aaif:morphosyntacticStructure rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Adjective" /><aaif:inflection rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Uninflected" /><aaif:attributionTarget rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Verb" /><aaif:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:modified><aaif:semanticClassification rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Manner" /><aaif:reduplicated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:reduplicated><aaif:prepositionalPhrase rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:prepositionalPhrase></aaif:Adverb><aaif:Entry rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En171"><aaif:phrase rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh#En171Ph1" /><aaif:source rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh.bibl#Cnde252" /><gams:textualContent>años, y no quitaba su extraordinaria corpulencia ni agilidad a sus miembros ni elegancia a sus maneras. Hablaba  bajo con suaves y cariñosas inflexiones y marcadísimo acento flamenco, y todo revelaba en él, más que el altivo</gams:textualContent><rel:isPartOf rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh" /></aaif:Entry><aaif:Phrase rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En171Ph1"><aaif:verb rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh#En171Ph1Ve1" /><aaif:adverb rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh#En171Ph1Ad1" /><aaif:text> Hablaba  bajo con suaves y cariñosas inflexiones y marcadísimo acento flamenco</aaif:text><aaif:annoText> [v|Hablaba|hablar|is]  [a|bajo|bajo|auvnmnnC] con suaves y cariñosas inflexiones y marcadísimo acento flamenco</aaif:annoText></aaif:Phrase><aaif:Verb rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En171Ph1Ve1"><aaif:text>Hablaba</aaif:text><aaif:lemma rdf:resource="https://gams.uni-graz.at/o:aaif.lemma#hablar" /><aaif:position rdf:datatype="http://www.w3.org/2001/XMLSchema#int">1</aaif:position><aaif:coordinated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:coordinated><aaif:partOfText rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</aaif:partOfText><aaif:syntacticConstruction rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Intransitive" /></aaif:Verb><aaif:Adverb rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En171Ph1Ad1"><aaif:text>bajo</aaif:text><aaif:lemma rdf:resource="https://gams.uni-graz.at/o:aaif.lemma#bajo" /><aaif:position rdf:datatype="http://www.w3.org/2001/XMLSchema#int">2</aaif:position><aaif:coordinated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</aaif:coordinated><aaif:morphosyntacticStructure rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Adjective" /><aaif:inflection rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Uninflected" /><aaif:attributionTarget rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Verb" /><aaif:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:modified><aaif:semanticClassification rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Manner" /><aaif:reduplicated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:reduplicated><aaif:prepositionalPhrase rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:prepositionalPhrase></aaif:Adverb><aaif:Entry rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En172"><aaif:phrase rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh#En172Ph1" /><aaif:source rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh.bibl#Cnde253" /><gams:textualContent> Juan se le acercó y le dijo bajito :</gams:textualContent><rel:isPartOf rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh" /></aaif:Entry><aaif:Phrase rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En172Ph1"><aaif:subject rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh#En172Ph1Su1" /><aaif:verb rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh#En172Ph1Ve1" /><aaif:adverb rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh#En172Ph1Ad1" /><aaif:text> Juan se le acercó y le dijo bajito </aaif:text><aaif:annoText> [s|Juan|ms] se le acercó y le [v|dijo|decir|ts] [a|bajito|bajo|auvnmnnn] </aaif:annoText></aaif:Phrase><aaif:Subject rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En172Ph1Su1"><aaif:text>Juan</aaif:text><aaif:position rdf:datatype="http://www.w3.org/2001/XMLSchema#int">1</aaif:position><aaif:gender rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Masculine" /><aaif:number rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Singular" /><aaif:overt rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</aaif:overt></aaif:Subject><aaif:Verb rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En172Ph1Ve1"><aaif:text>dijo</aaif:text><aaif:lemma rdf:resource="https://gams.uni-graz.at/o:aaif.lemma#decir" /><aaif:position rdf:datatype="http://www.w3.org/2001/XMLSchema#int">2</aaif:position><aaif:coordinated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:coordinated><aaif:partOfText rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</aaif:partOfText><aaif:syntacticConstruction rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Transitive" /></aaif:Verb><aaif:Adverb rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En172Ph1Ad1"><aaif:text>bajito</aaif:text><aaif:lemma rdf:resource="https://gams.uni-graz.at/o:aaif.lemma#bajo" /><aaif:position rdf:datatype="http://www.w3.org/2001/XMLSchema#int">3</aaif:position><aaif:coordinated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:coordinated><aaif:morphosyntacticStructure rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Adjective" /><aaif:inflection rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Uninflected" /><aaif:attributionTarget rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Verb" /><aaif:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:modified><aaif:semanticClassification rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Manner" /><aaif:reduplicated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:reduplicated><aaif:prepositionalPhrase rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:prepositionalPhrase></aaif:Adverb><aaif:Entry rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En173"><aaif:phrase rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh#En173Ph1" /><aaif:source rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh.bibl#Cnde254" /><gams:textualContent> Él llama a la chica aparte, le habla bajo  y ella hace ademanes de quien conviene.</gams:textualContent><rel:isPartOf rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh" /></aaif:Entry><aaif:Phrase rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En173Ph1"><aaif:subject rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh#En173Ph1Su1" /><aaif:verb rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh#En173Ph1Ve1" /><aaif:adverb rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh#En173Ph1Ad1" /><aaif:text> Él llama a la chica aparte, le habla bajo </aaif:text><aaif:annoText> [s|Él|ms] llama a la chica aparte, le [v|habla|hablar|is] [a|bajo|bajo|auvnmnnn] </aaif:annoText></aaif:Phrase><aaif:Subject rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En173Ph1Su1"><aaif:text>Él</aaif:text><aaif:position rdf:datatype="http://www.w3.org/2001/XMLSchema#int">1</aaif:position><aaif:gender rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Masculine" /><aaif:number rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Singular" /><aaif:overt rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</aaif:overt></aaif:Subject><aaif:Verb rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En173Ph1Ve1"><aaif:text>habla</aaif:text><aaif:lemma rdf:resource="https://gams.uni-graz.at/o:aaif.lemma#hablar" /><aaif:position rdf:datatype="http://www.w3.org/2001/XMLSchema#int">2</aaif:position><aaif:coordinated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:coordinated><aaif:partOfText rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</aaif:partOfText><aaif:syntacticConstruction rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Intransitive" /></aaif:Verb><aaif:Adverb rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En173Ph1Ad1"><aaif:text>bajo</aaif:text><aaif:lemma rdf:resource="https://gams.uni-graz.at/o:aaif.lemma#bajo" /><aaif:position rdf:datatype="http://www.w3.org/2001/XMLSchema#int">3</aaif:position><aaif:coordinated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:coordinated><aaif:morphosyntacticStructure rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Adjective" /><aaif:inflection rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Uninflected" /><aaif:attributionTarget rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Verb" /><aaif:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:modified><aaif:semanticClassification rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Manner" /><aaif:reduplicated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:reduplicated><aaif:prepositionalPhrase rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:prepositionalPhrase></aaif:Adverb><aaif:Entry rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En174"><aaif:phrase rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh#En174Ph1" /><aaif:source rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh.bibl#Cnde255" /><gams:textualContent>su arrogancia enana.Buscará otra silla igual para nivelarse.Entonces, mirándose por entre las cejas,    hablarán bajo .La escena conyugal se convertirá en coloquio de prometidos, impacientando a los dueños de la casa.Ella</gams:textualContent><rel:isPartOf rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh" /></aaif:Entry><aaif:Phrase rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En174Ph1"><aaif:subject rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh#En174Ph1Su1" /><aaif:verb rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh#En174Ph1Ve1" /><aaif:adverb rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh#En174Ph1Ad1" /><aaif:text>   hablarán bajo </aaif:text><aaif:annoText> [s||up]  [v|hablarán|hablar|is] [a|bajo|bajo|auvnmnnn] </aaif:annoText></aaif:Phrase><aaif:Subject rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En174Ph1Su1"><aaif:position rdf:datatype="http://www.w3.org/2001/XMLSchema#int">1</aaif:position><aaif:gender rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Undefined" /><aaif:number rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Plural" /><aaif:overt rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:overt></aaif:Subject><aaif:Verb rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En174Ph1Ve1"><aaif:text>hablarán</aaif:text><aaif:lemma rdf:resource="https://gams.uni-graz.at/o:aaif.lemma#hablar" /><aaif:position rdf:datatype="http://www.w3.org/2001/XMLSchema#int">2</aaif:position><aaif:coordinated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:coordinated><aaif:partOfText rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</aaif:partOfText><aaif:syntacticConstruction rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Intransitive" /></aaif:Verb><aaif:Adverb rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En174Ph1Ad1"><aaif:text>bajo</aaif:text><aaif:lemma rdf:resource="https://gams.uni-graz.at/o:aaif.lemma#bajo" /><aaif:position rdf:datatype="http://www.w3.org/2001/XMLSchema#int">3</aaif:position><aaif:coordinated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:coordinated><aaif:morphosyntacticStructure rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Adjective" /><aaif:inflection rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Uninflected" /><aaif:attributionTarget rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Verb" /><aaif:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:modified><aaif:semanticClassification rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Manner" /><aaif:reduplicated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:reduplicated><aaif:prepositionalPhrase rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:prepositionalPhrase></aaif:Adverb><aaif:Entry rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En175"><aaif:phrase rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh#En175Ph1" /><aaif:source rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh.bibl#Cnde256" /><gams:textualContent>El perro salió chato.Al verlo pasar,  el gateado meneó las orejas y relinchó bajito .</gams:textualContent><rel:isPartOf rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh" /></aaif:Entry><aaif:Phrase rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En175Ph1"><aaif:subject rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh#En175Ph1Su1" /><aaif:verb rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh#En175Ph1Ve1" /><aaif:adverb rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh#En175Ph1Ad1" /><aaif:text> el gateado meneó las orejas y relinchó bajito </aaif:text><aaif:annoText> [s|el gateado|ms] meneó las orejas y [v|relinchó|relinchar|is] [a|bajito|bajo|auvnmnnn] </aaif:annoText></aaif:Phrase><aaif:Subject rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En175Ph1Su1"><aaif:text>el gateado</aaif:text><aaif:position rdf:datatype="http://www.w3.org/2001/XMLSchema#int">1</aaif:position><aaif:gender rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Masculine" /><aaif:number rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Singular" /><aaif:overt rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</aaif:overt></aaif:Subject><aaif:Verb rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En175Ph1Ve1"><aaif:text>relinchó</aaif:text><aaif:lemma rdf:resource="https://gams.uni-graz.at/o:aaif.lemma#relinchar" /><aaif:position rdf:datatype="http://www.w3.org/2001/XMLSchema#int">2</aaif:position><aaif:coordinated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:coordinated><aaif:partOfText rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</aaif:partOfText><aaif:syntacticConstruction rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Intransitive" /></aaif:Verb><aaif:Adverb rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En175Ph1Ad1"><aaif:text>bajito</aaif:text><aaif:lemma rdf:resource="https://gams.uni-graz.at/o:aaif.lemma#bajo" /><aaif:position rdf:datatype="http://www.w3.org/2001/XMLSchema#int">3</aaif:position><aaif:coordinated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:coordinated><aaif:morphosyntacticStructure rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Adjective" /><aaif:inflection rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Uninflected" /><aaif:attributionTarget rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Verb" /><aaif:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:modified><aaif:semanticClassification rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Manner" /><aaif:reduplicated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:reduplicated><aaif:prepositionalPhrase rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:prepositionalPhrase></aaif:Adverb><aaif:Entry rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En176"><aaif:phrase rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh#En176Ph1" /><aaif:source rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh.bibl#Cnde256" /><gams:textualContent> Don Froilán  hablaba bajito , como si estuviese comunicando de prisa un secreto, y escupiendo a menudo.Escondido en el hueco de la</gams:textualContent><rel:isPartOf rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh" /></aaif:Entry><aaif:Phrase rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En176Ph1"><aaif:subject rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh#En176Ph1Su1" /><aaif:verb rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh#En176Ph1Ve1" /><aaif:adverb rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh#En176Ph1Ad1" /><aaif:text> Don Froilán  hablaba bajito </aaif:text><aaif:annoText> [s|Don Froilán|ms]  [v|hablaba|hablar|is] [a|bajito|bajo|auvnmnnn] </aaif:annoText></aaif:Phrase><aaif:Subject rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En176Ph1Su1"><aaif:text>Don Froilán</aaif:text><aaif:position rdf:datatype="http://www.w3.org/2001/XMLSchema#int">1</aaif:position><aaif:gender rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Masculine" /><aaif:number rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Singular" /><aaif:overt rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</aaif:overt></aaif:Subject><aaif:Verb rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En176Ph1Ve1"><aaif:text>hablaba</aaif:text><aaif:lemma rdf:resource="https://gams.uni-graz.at/o:aaif.lemma#hablar" /><aaif:position rdf:datatype="http://www.w3.org/2001/XMLSchema#int">2</aaif:position><aaif:coordinated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:coordinated><aaif:partOfText rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</aaif:partOfText><aaif:syntacticConstruction rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Intransitive" /></aaif:Verb><aaif:Adverb rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En176Ph1Ad1"><aaif:text>bajito</aaif:text><aaif:lemma rdf:resource="https://gams.uni-graz.at/o:aaif.lemma#bajo" /><aaif:position rdf:datatype="http://www.w3.org/2001/XMLSchema#int">3</aaif:position><aaif:coordinated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:coordinated><aaif:morphosyntacticStructure rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Adjective" /><aaif:inflection rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Uninflected" /><aaif:attributionTarget rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Verb" /><aaif:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:modified><aaif:semanticClassification rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Manner" /><aaif:reduplicated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:reduplicated><aaif:prepositionalPhrase rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:prepositionalPhrase></aaif:Adverb><aaif:Entry rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En177"><aaif:phrase rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh#En177Ph1" /><aaif:source rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh.bibl#Cnde256" /><gams:textualContent>sus bailes..., los más concurridos.A veces  las parejas salían al terroso patio y luego, platicando bajito , se alejaban y perdían entre los árboles del Caraguatá.La gata vieja, sentada en un banquito</gams:textualContent><rel:isPartOf rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh" /></aaif:Entry><aaif:Phrase rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En177Ph1"><aaif:subject rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh#En177Ph1Su1" /><aaif:verb rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh#En177Ph1Ve1" /><aaif:adverb rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh#En177Ph1Ad1" /><aaif:text> las parejas salían al terroso patio y luego, platicando bajito ,</aaif:text><aaif:annoText> [s|las parejas|fp] salían al terroso patio y luego, [v|platicando|platicar|is] [a|bajito|bajo|auvnmnnn] ,</aaif:annoText></aaif:Phrase><aaif:Subject rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En177Ph1Su1"><aaif:text>las parejas</aaif:text><aaif:position rdf:datatype="http://www.w3.org/2001/XMLSchema#int">1</aaif:position><aaif:gender rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Feminine" /><aaif:number rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Plural" /><aaif:overt rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</aaif:overt></aaif:Subject><aaif:Verb rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En177Ph1Ve1"><aaif:text>platicando</aaif:text><aaif:lemma rdf:resource="https://gams.uni-graz.at/o:aaif.lemma#platicar" /><aaif:position rdf:datatype="http://www.w3.org/2001/XMLSchema#int">2</aaif:position><aaif:coordinated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:coordinated><aaif:partOfText rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</aaif:partOfText><aaif:syntacticConstruction rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Intransitive" /></aaif:Verb><aaif:Adverb rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En177Ph1Ad1"><aaif:text>bajito</aaif:text><aaif:lemma rdf:resource="https://gams.uni-graz.at/o:aaif.lemma#bajo" /><aaif:position rdf:datatype="http://www.w3.org/2001/XMLSchema#int">3</aaif:position><aaif:coordinated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:coordinated><aaif:morphosyntacticStructure rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Adjective" /><aaif:inflection rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Uninflected" /><aaif:attributionTarget rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Verb" /><aaif:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:modified><aaif:semanticClassification rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Manner" /><aaif:reduplicated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:reduplicated><aaif:prepositionalPhrase rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:prepositionalPhrase></aaif:Adverb><aaif:Entry rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En178"><aaif:phrase rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh#En178Ph1" /><aaif:source rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh.bibl#Cnde256" /><gams:textualContent>hombres se interpusieron.Como quien aparta aguas se abría paso. Pancha se abrazó a él y le dijo bajito :</gams:textualContent><rel:isPartOf rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh" /></aaif:Entry><aaif:Phrase rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En178Ph1"><aaif:subject rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh#En178Ph1Su1" /><aaif:verb rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh#En178Ph1Ve1" /><aaif:adverb rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh#En178Ph1Ad1" /><aaif:text> Pancha se abrazó a él y le dijo bajito </aaif:text><aaif:annoText> [s|Pancha|fs] se abrazó a él y le [v|dijo|decir|ts] [a|bajito|bajo|auvnmnnn] </aaif:annoText></aaif:Phrase><aaif:Subject rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En178Ph1Su1"><aaif:text>Pancha</aaif:text><aaif:position rdf:datatype="http://www.w3.org/2001/XMLSchema#int">1</aaif:position><aaif:gender rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Feminine" /><aaif:number rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Singular" /><aaif:overt rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</aaif:overt></aaif:Subject><aaif:Verb rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En178Ph1Ve1"><aaif:text>dijo</aaif:text><aaif:lemma rdf:resource="https://gams.uni-graz.at/o:aaif.lemma#decir" /><aaif:position rdf:datatype="http://www.w3.org/2001/XMLSchema#int">2</aaif:position><aaif:coordinated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:coordinated><aaif:partOfText rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</aaif:partOfText><aaif:syntacticConstruction rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Transitive" /></aaif:Verb><aaif:Adverb rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En178Ph1Ad1"><aaif:text>bajito</aaif:text><aaif:lemma rdf:resource="https://gams.uni-graz.at/o:aaif.lemma#bajo" /><aaif:position rdf:datatype="http://www.w3.org/2001/XMLSchema#int">3</aaif:position><aaif:coordinated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:coordinated><aaif:morphosyntacticStructure rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Adjective" /><aaif:inflection rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Uninflected" /><aaif:attributionTarget rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Verb" /><aaif:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:modified><aaif:semanticClassification rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Manner" /><aaif:reduplicated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:reduplicated><aaif:prepositionalPhrase rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:prepositionalPhrase></aaif:Adverb><aaif:Entry rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En179"><aaif:phrase rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh#En179Ph1" /><aaif:source rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh.bibl#Cnde38" /><gams:textualContent>Allá abajo,  el jardín se reía bajito  con un retozo de savia entre los brotes nuevos, sofocando de prisa sus rumores bajo el viento encubridor.</gams:textualContent><rel:isPartOf rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh" /></aaif:Entry><aaif:Phrase rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En179Ph1"><aaif:subject rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh#En179Ph1Su1" /><aaif:verb rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh#En179Ph1Ve1" /><aaif:adverb rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh#En179Ph1Ad1" /><aaif:text> el jardín se reía bajito </aaif:text><aaif:annoText> [s|el jardín|ms] se [v|reía|reír|rs] [a|bajito|bajo|auvnmnnn] </aaif:annoText></aaif:Phrase><aaif:Subject rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En179Ph1Su1"><aaif:text>el jardín</aaif:text><aaif:position rdf:datatype="http://www.w3.org/2001/XMLSchema#int">1</aaif:position><aaif:gender rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Masculine" /><aaif:number rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Singular" /><aaif:overt rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</aaif:overt></aaif:Subject><aaif:Verb rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En179Ph1Ve1"><aaif:text>reía</aaif:text><aaif:lemma rdf:resource="https://gams.uni-graz.at/o:aaif.lemma#reír" /><aaif:position rdf:datatype="http://www.w3.org/2001/XMLSchema#int">2</aaif:position><aaif:coordinated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:coordinated><aaif:partOfText rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</aaif:partOfText><aaif:syntacticConstruction rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Reflexive" /></aaif:Verb><aaif:Adverb rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En179Ph1Ad1"><aaif:text>bajito</aaif:text><aaif:lemma rdf:resource="https://gams.uni-graz.at/o:aaif.lemma#bajo" /><aaif:position rdf:datatype="http://www.w3.org/2001/XMLSchema#int">3</aaif:position><aaif:coordinated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:coordinated><aaif:morphosyntacticStructure rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Adjective" /><aaif:inflection rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Uninflected" /><aaif:attributionTarget rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Verb" /><aaif:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:modified><aaif:semanticClassification rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Manner" /><aaif:reduplicated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:reduplicated><aaif:prepositionalPhrase rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:prepositionalPhrase></aaif:Adverb><aaif:Entry rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En180"><aaif:phrase rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh#En180Ph1" /><aaif:source rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh.bibl#Cnde257" /><gams:textualContent>para la Academia de Ciencias Morales y Políticas.Hay muchos ejemplares de estos republicanos de la cátedra... Hablar  bajito , sorber tazas de té...la cosa inglesa...una tabla finísima del quince...En cuanto hubo que</gams:textualContent><rel:isPartOf rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh" /></aaif:Entry><aaif:Phrase rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En180Ph1"><aaif:verb rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh#En180Ph1Ve1" /><aaif:adverb rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh#En180Ph1Ad1" /><aaif:text> Hablar  bajito </aaif:text><aaif:annoText> [v|Hablar|hablar|is]  [a|bajito|bajo|auvnmnnn] </aaif:annoText></aaif:Phrase><aaif:Verb rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En180Ph1Ve1"><aaif:text>Hablar</aaif:text><aaif:lemma rdf:resource="https://gams.uni-graz.at/o:aaif.lemma#hablar" /><aaif:position rdf:datatype="http://www.w3.org/2001/XMLSchema#int">1</aaif:position><aaif:coordinated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:coordinated><aaif:partOfText rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</aaif:partOfText><aaif:syntacticConstruction rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Intransitive" /></aaif:Verb><aaif:Adverb rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En180Ph1Ad1"><aaif:text>bajito</aaif:text><aaif:lemma rdf:resource="https://gams.uni-graz.at/o:aaif.lemma#bajo" /><aaif:position rdf:datatype="http://www.w3.org/2001/XMLSchema#int">2</aaif:position><aaif:coordinated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:coordinated><aaif:morphosyntacticStructure rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Adjective" /><aaif:inflection rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Uninflected" /><aaif:attributionTarget rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Verb" /><aaif:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:modified><aaif:semanticClassification rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Manner" /><aaif:reduplicated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:reduplicated><aaif:prepositionalPhrase rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:prepositionalPhrase></aaif:Adverb><aaif:Entry rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En181"><aaif:phrase rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh#En181Ph1" /><aaif:source rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh.bibl#Cnde41" /><gams:textualContent>de día hubiera visto el chispazo de alegría picaresca en los ojos negros de su hijo.Porque  Julián  hablaba bajo pero ahora con firmeza y contentura:</gams:textualContent><rel:isPartOf rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh" /></aaif:Entry><aaif:Phrase rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En181Ph1"><aaif:subject rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh#En181Ph1Su1" /><aaif:verb rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh#En181Ph1Ve1" /><aaif:adverb rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh#En181Ph1Ad1" /><aaif:text> Julián  hablaba bajo pero ahora con firmeza y contentura</aaif:text><aaif:annoText> [s|Julián|ms]  [v|hablaba|hablar|is] [a|bajo|bajo|auvnmnnC] pero ahora con firmeza y contentura</aaif:annoText></aaif:Phrase><aaif:Subject rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En181Ph1Su1"><aaif:text>Julián</aaif:text><aaif:position rdf:datatype="http://www.w3.org/2001/XMLSchema#int">1</aaif:position><aaif:gender rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Masculine" /><aaif:number rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Singular" /><aaif:overt rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</aaif:overt></aaif:Subject><aaif:Verb rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En181Ph1Ve1"><aaif:text>hablaba</aaif:text><aaif:lemma rdf:resource="https://gams.uni-graz.at/o:aaif.lemma#hablar" /><aaif:position rdf:datatype="http://www.w3.org/2001/XMLSchema#int">2</aaif:position><aaif:coordinated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:coordinated><aaif:partOfText rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</aaif:partOfText><aaif:syntacticConstruction rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Intransitive" /></aaif:Verb><aaif:Adverb rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En181Ph1Ad1"><aaif:text>bajo</aaif:text><aaif:lemma rdf:resource="https://gams.uni-graz.at/o:aaif.lemma#bajo" /><aaif:position rdf:datatype="http://www.w3.org/2001/XMLSchema#int">3</aaif:position><aaif:coordinated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</aaif:coordinated><aaif:morphosyntacticStructure rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Adjective" /><aaif:inflection rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Uninflected" /><aaif:attributionTarget rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Verb" /><aaif:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:modified><aaif:semanticClassification rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Manner" /><aaif:reduplicated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:reduplicated><aaif:prepositionalPhrase rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:prepositionalPhrase></aaif:Adverb><aaif:Entry rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En182"><aaif:phrase rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh#En182Ph1" /><aaif:source rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh.bibl#Cnde185" /><gams:textualContent>pero yo sí sabía la clase de hombre que era él, y, dominando mi orgullo, resolví pisar bajo para humillarlo.Tuve en seguida la intuición –clara, nítida– de lo sencillo que podría ser esclavizarlo a expensas de</gams:textualContent><rel:isPartOf rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh" /></aaif:Entry><aaif:Phrase rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En182Ph1"><aaif:verb rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh#En182Ph1Ve1" /><aaif:adverb rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh#En182Ph1Ad1" /><aaif:text>resolví pisar bajo para humillarlo</aaif:text><aaif:annoText>resolví [v|pisar|pisar|is] [a|bajo|bajo|auvnmnnn] para humillarlo</aaif:annoText></aaif:Phrase><aaif:Verb rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En182Ph1Ve1"><aaif:text>pisar</aaif:text><aaif:lemma rdf:resource="https://gams.uni-graz.at/o:aaif.lemma#pisar" /><aaif:position rdf:datatype="http://www.w3.org/2001/XMLSchema#int">1</aaif:position><aaif:coordinated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:coordinated><aaif:partOfText rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</aaif:partOfText><aaif:syntacticConstruction rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Intransitive" /></aaif:Verb><aaif:Adverb rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En182Ph1Ad1"><aaif:text>bajo</aaif:text><aaif:lemma rdf:resource="https://gams.uni-graz.at/o:aaif.lemma#bajo" /><aaif:position rdf:datatype="http://www.w3.org/2001/XMLSchema#int">2</aaif:position><aaif:coordinated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:coordinated><aaif:morphosyntacticStructure rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Adjective" /><aaif:inflection rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Uninflected" /><aaif:attributionTarget rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Verb" /><aaif:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:modified><aaif:semanticClassification rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Manner" /><aaif:reduplicated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:reduplicated><aaif:prepositionalPhrase rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:prepositionalPhrase></aaif:Adverb><aaif:Entry rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En183"><aaif:phrase rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh#En183Ph1" /><aaif:source rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh.bibl#Cnde258" /><gams:textualContent>Se rió bajito .</gams:textualContent><rel:isPartOf rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh" /></aaif:Entry><aaif:Phrase rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En183Ph1"><aaif:verb rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh#En183Ph1Ve1" /><aaif:adverb rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh#En183Ph1Ad1" /><aaif:text>Se rió bajito </aaif:text><aaif:annoText>Se [v|rió|reír|rs] [a|bajito|bajo|auvnmnnn] </aaif:annoText></aaif:Phrase><aaif:Verb rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En183Ph1Ve1"><aaif:text>rió</aaif:text><aaif:lemma rdf:resource="https://gams.uni-graz.at/o:aaif.lemma#reír" /><aaif:position rdf:datatype="http://www.w3.org/2001/XMLSchema#int">1</aaif:position><aaif:coordinated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:coordinated><aaif:partOfText rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</aaif:partOfText><aaif:syntacticConstruction rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Reflexive" /></aaif:Verb><aaif:Adverb rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En183Ph1Ad1"><aaif:text>bajito</aaif:text><aaif:lemma rdf:resource="https://gams.uni-graz.at/o:aaif.lemma#bajo" /><aaif:position rdf:datatype="http://www.w3.org/2001/XMLSchema#int">2</aaif:position><aaif:coordinated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:coordinated><aaif:morphosyntacticStructure rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Adjective" /><aaif:inflection rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Uninflected" /><aaif:attributionTarget rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Verb" /><aaif:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:modified><aaif:semanticClassification rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Manner" /><aaif:reduplicated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:reduplicated><aaif:prepositionalPhrase rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:prepositionalPhrase></aaif:Adverb><aaif:Entry rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En184"><aaif:phrase rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh#En184Ph1" /><aaif:source rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh.bibl#Cnde176" /><gams:textualContent> Lucio le hizo un aparte a la chica y le decía bajito , escondiendo la voz en el dorso de la mano: «Eso lo dice porque me fía; por</gams:textualContent><rel:isPartOf rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh" /></aaif:Entry><aaif:Phrase rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En184Ph1"><aaif:subject rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh#En184Ph1Su1" /><aaif:verb rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh#En184Ph1Ve1" /><aaif:adverb rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh#En184Ph1Ad1" /><aaif:text> Lucio le hizo un aparte a la chica y le decía bajito </aaif:text><aaif:annoText> [s|Lucio|ms] le hizo un aparte a la chica y le [v|decía|decir|ts] [a|bajito|bajo|auvnmnnn] </aaif:annoText></aaif:Phrase><aaif:Subject rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En184Ph1Su1"><aaif:text>Lucio</aaif:text><aaif:position rdf:datatype="http://www.w3.org/2001/XMLSchema#int">1</aaif:position><aaif:gender rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Masculine" /><aaif:number rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Singular" /><aaif:overt rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</aaif:overt></aaif:Subject><aaif:Verb rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En184Ph1Ve1"><aaif:text>decía</aaif:text><aaif:lemma rdf:resource="https://gams.uni-graz.at/o:aaif.lemma#decir" /><aaif:position rdf:datatype="http://www.w3.org/2001/XMLSchema#int">2</aaif:position><aaif:coordinated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:coordinated><aaif:partOfText rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</aaif:partOfText><aaif:syntacticConstruction rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Transitive" /></aaif:Verb><aaif:Adverb rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En184Ph1Ad1"><aaif:text>bajito</aaif:text><aaif:lemma rdf:resource="https://gams.uni-graz.at/o:aaif.lemma#bajo" /><aaif:position rdf:datatype="http://www.w3.org/2001/XMLSchema#int">3</aaif:position><aaif:coordinated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:coordinated><aaif:morphosyntacticStructure rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Adjective" /><aaif:inflection rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Uninflected" /><aaif:attributionTarget rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Verb" /><aaif:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:modified><aaif:semanticClassification rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Manner" /><aaif:reduplicated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:reduplicated><aaif:prepositionalPhrase rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:prepositionalPhrase></aaif:Adverb><aaif:Entry rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En185"><aaif:phrase rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh#En185Ph1" /><aaif:source rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh.bibl#Cnde176" /><gams:textualContent>casi a los pies del declive.Lo dominaban desde unos ochenta o cien metros de altura.   Hablaban bajo , sin saber por qué.</gams:textualContent><rel:isPartOf rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh" /></aaif:Entry><aaif:Phrase rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En185Ph1"><aaif:subject rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh#En185Ph1Su1" /><aaif:verb rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh#En185Ph1Ve1" /><aaif:adverb rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh#En185Ph1Ad1" /><aaif:text>   Hablaban bajo </aaif:text><aaif:annoText> [s||up]  [v|Hablaban|hablar|is] [a|bajo|bajo|auvnmnnn] </aaif:annoText></aaif:Phrase><aaif:Subject rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En185Ph1Su1"><aaif:position rdf:datatype="http://www.w3.org/2001/XMLSchema#int">1</aaif:position><aaif:gender rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Undefined" /><aaif:number rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Plural" /><aaif:overt rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:overt></aaif:Subject><aaif:Verb rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En185Ph1Ve1"><aaif:text>Hablaban</aaif:text><aaif:lemma rdf:resource="https://gams.uni-graz.at/o:aaif.lemma#hablar" /><aaif:position rdf:datatype="http://www.w3.org/2001/XMLSchema#int">2</aaif:position><aaif:coordinated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:coordinated><aaif:partOfText rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</aaif:partOfText><aaif:syntacticConstruction rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Intransitive" /></aaif:Verb><aaif:Adverb rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En185Ph1Ad1"><aaif:text>bajo</aaif:text><aaif:lemma rdf:resource="https://gams.uni-graz.at/o:aaif.lemma#bajo" /><aaif:position rdf:datatype="http://www.w3.org/2001/XMLSchema#int">3</aaif:position><aaif:coordinated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:coordinated><aaif:morphosyntacticStructure rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Adjective" /><aaif:inflection rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Uninflected" /><aaif:attributionTarget rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Verb" /><aaif:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:modified><aaif:semanticClassification rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Manner" /><aaif:reduplicated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:reduplicated><aaif:prepositionalPhrase rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:prepositionalPhrase></aaif:Adverb><aaif:Entry rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En186"><aaif:phrase rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh#En186Ph1" /><aaif:source rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh.bibl#Cnde117" /><gams:textualContent>—  Háblale  bajito  —me advirtió.</gams:textualContent><rel:isPartOf rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh" /></aaif:Entry><aaif:Phrase rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En186Ph1"><aaif:verb rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh#En186Ph1Ve1" /><aaif:adverb rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh#En186Ph1Ad1" /><aaif:text> Háblale  bajito </aaif:text><aaif:annoText> [v|Háblale|hablar|is]  [a|bajito|bajo|auvnmnnn] </aaif:annoText></aaif:Phrase><aaif:Verb rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En186Ph1Ve1"><aaif:text>Háblale</aaif:text><aaif:lemma rdf:resource="https://gams.uni-graz.at/o:aaif.lemma#hablar" /><aaif:position rdf:datatype="http://www.w3.org/2001/XMLSchema#int">1</aaif:position><aaif:coordinated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:coordinated><aaif:partOfText rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</aaif:partOfText><aaif:syntacticConstruction rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Intransitive" /></aaif:Verb><aaif:Adverb rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En186Ph1Ad1"><aaif:text>bajito</aaif:text><aaif:lemma rdf:resource="https://gams.uni-graz.at/o:aaif.lemma#bajo" /><aaif:position rdf:datatype="http://www.w3.org/2001/XMLSchema#int">2</aaif:position><aaif:coordinated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:coordinated><aaif:morphosyntacticStructure rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Adjective" /><aaif:inflection rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Uninflected" /><aaif:attributionTarget rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Verb" /><aaif:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:modified><aaif:semanticClassification rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Manner" /><aaif:reduplicated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:reduplicated><aaif:prepositionalPhrase rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:prepositionalPhrase></aaif:Adverb><aaif:Entry rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En187"><aaif:phrase rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh#En187Ph1" /><aaif:source rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh.bibl#Cnde117" /><gams:textualContent>pequeños.Su color era cenizo; pero anduvo erguido, con la cabeza levantada, aunque  sus ojos  miraban bajo , con una humildad que oprimía.</gams:textualContent><rel:isPartOf rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh" /></aaif:Entry><aaif:Phrase rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En187Ph1"><aaif:subject rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh#En187Ph1Su1" /><aaif:verb rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh#En187Ph1Ve1" /><aaif:adverb rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh#En187Ph1Ad1" /><aaif:text> sus ojos  miraban bajo , con una humildad que oprimía</aaif:text><aaif:annoText> [s|sus ojos|mp]  [v|miraban|mirar|is] [a|bajo|bajo|auvnmnnn] , con una humildad que oprimía</aaif:annoText></aaif:Phrase><aaif:Subject rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En187Ph1Su1"><aaif:text>sus ojos</aaif:text><aaif:position rdf:datatype="http://www.w3.org/2001/XMLSchema#int">1</aaif:position><aaif:gender rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Masculine" /><aaif:number rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Plural" /><aaif:overt rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</aaif:overt></aaif:Subject><aaif:Verb rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En187Ph1Ve1"><aaif:text>miraban</aaif:text><aaif:lemma rdf:resource="https://gams.uni-graz.at/o:aaif.lemma#mirar" /><aaif:position rdf:datatype="http://www.w3.org/2001/XMLSchema#int">2</aaif:position><aaif:coordinated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:coordinated><aaif:partOfText rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</aaif:partOfText><aaif:syntacticConstruction rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Intransitive" /></aaif:Verb><aaif:Adverb rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En187Ph1Ad1"><aaif:text>bajo</aaif:text><aaif:lemma rdf:resource="https://gams.uni-graz.at/o:aaif.lemma#bajo" /><aaif:position rdf:datatype="http://www.w3.org/2001/XMLSchema#int">3</aaif:position><aaif:coordinated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:coordinated><aaif:morphosyntacticStructure rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Adjective" /><aaif:inflection rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Uninflected" /><aaif:attributionTarget rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Verb" /><aaif:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:modified><aaif:semanticClassification rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Manner" /><aaif:reduplicated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:reduplicated><aaif:prepositionalPhrase rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:prepositionalPhrase></aaif:Adverb><aaif:Entry rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En188"><aaif:phrase rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh#En188Ph1" /><aaif:source rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh.bibl#Cnde259" /><gams:textualContent>mazo de vetiver.El vaho del guarapo giraba en la brisa con el toque de oración. Volando  bajo , las auras anunciaban lluvias reticentes, cuyas primeras gotas, anchas y sonoras, eran sorbidas por tejas tan</gams:textualContent><rel:isPartOf rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh" /></aaif:Entry><aaif:Phrase rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En188Ph1"><aaif:subject rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh#En188Ph1Su1" /><aaif:verb rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh#En188Ph1Ve1" /><aaif:adverb rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh#En188Ph1Ad1" /><aaif:text> Volando  bajo , las auras anunciaban lluvias reticentes</aaif:text><aaif:annoText> [v|Volando|volar|is]  [a|bajo|bajo|auvnlnnn] , [s|las auras|fp] anunciaban lluvias reticentes</aaif:annoText></aaif:Phrase><aaif:Subject rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En188Ph1Su1"><aaif:text>las auras</aaif:text><aaif:position rdf:datatype="http://www.w3.org/2001/XMLSchema#int">3</aaif:position><aaif:gender rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Feminine" /><aaif:number rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Plural" /><aaif:overt rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</aaif:overt></aaif:Subject><aaif:Verb rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En188Ph1Ve1"><aaif:text>Volando</aaif:text><aaif:lemma rdf:resource="https://gams.uni-graz.at/o:aaif.lemma#volar" /><aaif:position rdf:datatype="http://www.w3.org/2001/XMLSchema#int">1</aaif:position><aaif:coordinated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:coordinated><aaif:partOfText rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</aaif:partOfText><aaif:syntacticConstruction rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Intransitive" /></aaif:Verb><aaif:Adverb rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En188Ph1Ad1"><aaif:text>bajo</aaif:text><aaif:lemma rdf:resource="https://gams.uni-graz.at/o:aaif.lemma#bajo" /><aaif:position rdf:datatype="http://www.w3.org/2001/XMLSchema#int">2</aaif:position><aaif:coordinated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:coordinated><aaif:morphosyntacticStructure rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Adjective" /><aaif:inflection rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Uninflected" /><aaif:attributionTarget rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Verb" /><aaif:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:modified><aaif:semanticClassification rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Location" /><aaif:reduplicated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:reduplicated><aaif:prepositionalPhrase rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:prepositionalPhrase></aaif:Adverb><aaif:Entry rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En189"><aaif:phrase rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh#En189Ph1" /><aaif:source rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh.bibl#Cnde49" /><gams:textualContent>— No te apures, mujer —le dijo bajito —, ¿qué es, que no te gusta?</gams:textualContent><rel:isPartOf rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh" /></aaif:Entry><aaif:Phrase rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En189Ph1"><aaif:verb rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh#En189Ph1Ve1" /><aaif:adverb rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh#En189Ph1Ad1" /><aaif:text>le dijo bajito </aaif:text><aaif:annoText>le [v|dijo|decir|ts] [a|bajito|bajo|auvnmnnn] </aaif:annoText></aaif:Phrase><aaif:Verb rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En189Ph1Ve1"><aaif:text>dijo</aaif:text><aaif:lemma rdf:resource="https://gams.uni-graz.at/o:aaif.lemma#decir" /><aaif:position rdf:datatype="http://www.w3.org/2001/XMLSchema#int">1</aaif:position><aaif:coordinated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:coordinated><aaif:partOfText rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</aaif:partOfText><aaif:syntacticConstruction rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Transitive" /></aaif:Verb><aaif:Adverb rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En189Ph1Ad1"><aaif:text>bajito</aaif:text><aaif:lemma rdf:resource="https://gams.uni-graz.at/o:aaif.lemma#bajo" /><aaif:position rdf:datatype="http://www.w3.org/2001/XMLSchema#int">2</aaif:position><aaif:coordinated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:coordinated><aaif:morphosyntacticStructure rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Adjective" /><aaif:inflection rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Uninflected" /><aaif:attributionTarget rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Verb" /><aaif:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:modified><aaif:semanticClassification rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Manner" /><aaif:reduplicated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:reduplicated><aaif:prepositionalPhrase rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:prepositionalPhrase></aaif:Adverb><aaif:Entry rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En190"><aaif:phrase rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh#En190Ph1" /><aaif:source rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh.bibl#Cnde260" /><gams:textualContent>En el silencio del anochecer en que ondeaban las chispitas azules de los muäs, empezábamos a oír bajito la guitarra que sonaba como enterrada, o como si la memoria del sonido aflorase en nosotros bajo el</gams:textualContent><rel:isPartOf rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh" /></aaif:Entry><aaif:Phrase rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En190Ph1"><aaif:verb rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh#En190Ph1Ve1" /><aaif:adverb rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh#En190Ph1Ad1" /><aaif:text>empezábamos a oír bajito la guitarra</aaif:text><aaif:annoText>empezábamos a [v|oír|oír|ts] [a|bajito|bajo|auvnmnnn] la guitarra</aaif:annoText></aaif:Phrase><aaif:Verb rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En190Ph1Ve1"><aaif:text>oír</aaif:text><aaif:lemma rdf:resource="https://gams.uni-graz.at/o:aaif.lemma#oír" /><aaif:position rdf:datatype="http://www.w3.org/2001/XMLSchema#int">1</aaif:position><aaif:coordinated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:coordinated><aaif:partOfText rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</aaif:partOfText><aaif:syntacticConstruction rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Transitive" /></aaif:Verb><aaif:Adverb rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En190Ph1Ad1"><aaif:text>bajito</aaif:text><aaif:lemma rdf:resource="https://gams.uni-graz.at/o:aaif.lemma#bajo" /><aaif:position rdf:datatype="http://www.w3.org/2001/XMLSchema#int">2</aaif:position><aaif:coordinated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:coordinated><aaif:morphosyntacticStructure rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Adjective" /><aaif:inflection rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Uninflected" /><aaif:attributionTarget rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Verb" /><aaif:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:modified><aaif:semanticClassification rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Manner" /><aaif:reduplicated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:reduplicated><aaif:prepositionalPhrase rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:prepositionalPhrase></aaif:Adverb><aaif:Entry rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En191"><aaif:phrase rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh#En191Ph1" /><aaif:source rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh.bibl#Cnde51" /><gams:textualContent>uniforme de salida,  ella se mete debajo de la cama o se zambulle en el ropero y comienza a llorar bajito , de pena porque voy a salir.Y sigue llorando bajito cuando formamos, y me sigue, caminando</gams:textualContent><rel:isPartOf rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh" /></aaif:Entry><aaif:Phrase rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En191Ph1"><aaif:subject rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh#En191Ph1Su1" /><aaif:verb rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh#En191Ph1Ve1" /><aaif:adverb rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh#En191Ph1Ad1" /><aaif:text> ella se mete debajo de la cama o se zambulle en el ropero y comienza a llorar bajito , de pena</aaif:text><aaif:annoText> [s|ella|fs] se mete debajo de la cama o se zambulle en el ropero y comienza a [v|llorar|llorar|is] [a|bajito|bajo|auvnmnnn] , de pena</aaif:annoText></aaif:Phrase><aaif:Subject rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En191Ph1Su1"><aaif:text>ella</aaif:text><aaif:position rdf:datatype="http://www.w3.org/2001/XMLSchema#int">1</aaif:position><aaif:gender rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Feminine" /><aaif:number rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Singular" /><aaif:overt rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</aaif:overt></aaif:Subject><aaif:Verb rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En191Ph1Ve1"><aaif:text>llorar</aaif:text><aaif:lemma rdf:resource="https://gams.uni-graz.at/o:aaif.lemma#llorar" /><aaif:position rdf:datatype="http://www.w3.org/2001/XMLSchema#int">2</aaif:position><aaif:coordinated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:coordinated><aaif:partOfText rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</aaif:partOfText><aaif:syntacticConstruction rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Intransitive" /></aaif:Verb><aaif:Adverb rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En191Ph1Ad1"><aaif:text>bajito</aaif:text><aaif:lemma rdf:resource="https://gams.uni-graz.at/o:aaif.lemma#bajo" /><aaif:position rdf:datatype="http://www.w3.org/2001/XMLSchema#int">3</aaif:position><aaif:coordinated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:coordinated><aaif:morphosyntacticStructure rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Adjective" /><aaif:inflection rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Uninflected" /><aaif:attributionTarget rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Verb" /><aaif:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:modified><aaif:semanticClassification rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Manner" /><aaif:reduplicated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:reduplicated><aaif:prepositionalPhrase rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:prepositionalPhrase></aaif:Adverb><aaif:Entry rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En192"><aaif:phrase rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh#En192Ph1" /><aaif:source rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh.bibl#Cnde51" /><gams:textualContent>zambulle en el ropero y comienza a llorar bajito, de pena porque voy a salir.Y sigue llorando bajito  cuando formamos, y me sigue, caminando con su cabeza agachada, como un alma en pena.Se</gams:textualContent><rel:isPartOf rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh" /></aaif:Entry><aaif:Phrase rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En192Ph1"><aaif:verb rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh#En192Ph1Ve1" /><aaif:adverb rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh#En192Ph1Ad1" /><aaif:text>sigue llorando bajito </aaif:text><aaif:annoText>sigue [v|llorando|llorar|is] [a|bajito|bajo|auvnmnnn] </aaif:annoText></aaif:Phrase><aaif:Verb rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En192Ph1Ve1"><aaif:text>llorando</aaif:text><aaif:lemma rdf:resource="https://gams.uni-graz.at/o:aaif.lemma#llorar" /><aaif:position rdf:datatype="http://www.w3.org/2001/XMLSchema#int">1</aaif:position><aaif:coordinated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:coordinated><aaif:partOfText rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</aaif:partOfText><aaif:syntacticConstruction rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Intransitive" /></aaif:Verb><aaif:Adverb rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En192Ph1Ad1"><aaif:text>bajito</aaif:text><aaif:lemma rdf:resource="https://gams.uni-graz.at/o:aaif.lemma#bajo" /><aaif:position rdf:datatype="http://www.w3.org/2001/XMLSchema#int">2</aaif:position><aaif:coordinated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:coordinated><aaif:morphosyntacticStructure rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Adjective" /><aaif:inflection rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Uninflected" /><aaif:attributionTarget rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Verb" /><aaif:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:modified><aaif:semanticClassification rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Manner" /><aaif:reduplicated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:reduplicated><aaif:prepositionalPhrase rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:prepositionalPhrase></aaif:Adverb><aaif:Entry rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En193"><aaif:phrase rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh#En193Ph1" /><aaif:source rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh.bibl#Cnde51" /><gams:textualContent>".Y eso parecía.Andaba pegado al poeta, siguiéndolo a todas partes, mirándolo,  hablándole bajito para que nadie lo oyera.Se iban al descampado a conversar tranquilos.Y el poeta comenzó a defender</gams:textualContent><rel:isPartOf rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh" /></aaif:Entry><aaif:Phrase rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En193Ph1"><aaif:verb rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh#En193Ph1Ve1" /><aaif:adverb rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh#En193Ph1Ad1" /><aaif:text> hablándole bajito para que nadie lo oyera</aaif:text><aaif:annoText> [v|hablándole|hablar|is] [a|bajito|bajo|auvnmnnn] para que nadie lo oyera</aaif:annoText></aaif:Phrase><aaif:Verb rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En193Ph1Ve1"><aaif:text>hablándole</aaif:text><aaif:lemma rdf:resource="https://gams.uni-graz.at/o:aaif.lemma#hablar" /><aaif:position rdf:datatype="http://www.w3.org/2001/XMLSchema#int">1</aaif:position><aaif:coordinated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:coordinated><aaif:partOfText rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</aaif:partOfText><aaif:syntacticConstruction rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Intransitive" /></aaif:Verb><aaif:Adverb rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En193Ph1Ad1"><aaif:text>bajito</aaif:text><aaif:lemma rdf:resource="https://gams.uni-graz.at/o:aaif.lemma#bajo" /><aaif:position rdf:datatype="http://www.w3.org/2001/XMLSchema#int">2</aaif:position><aaif:coordinated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:coordinated><aaif:morphosyntacticStructure rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Adjective" /><aaif:inflection rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Uninflected" /><aaif:attributionTarget rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Verb" /><aaif:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:modified><aaif:semanticClassification rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Manner" /><aaif:reduplicated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:reduplicated><aaif:prepositionalPhrase rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:prepositionalPhrase></aaif:Adverb><aaif:Entry rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En194"><aaif:phrase rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh#En194Ph1" /><aaif:source rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh.bibl#Cnde51" /><gams:textualContent>Jaguar se volviera hacia él. Su propia boca , detrás de los vendajes cómplices, comenzó a murmurar , bajito , "soplón, soplón".Después cerró el ojo, convertido en un absceso ígneo, y ya</gams:textualContent><rel:isPartOf rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh" /></aaif:Entry><aaif:Phrase rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En194Ph1"><aaif:subject rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh#En194Ph1Su1" /><aaif:verb rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh#En194Ph1Ve1" /><aaif:adverb rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh#En194Ph1Ad1" /><aaif:text> Su propia boca , detrás de los vendajes cómplices, comenzó a murmurar , bajito , \"soplón, soplón\"</aaif:text><aaif:annoText> [s|Su propia boca|fs] , detrás de los vendajes cómplices, comenzó a [v|murmurar|murmurar|ts] , [a|bajito|bajo|auvnmnnn] , \"soplón, soplón\"</aaif:annoText></aaif:Phrase><aaif:Subject rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En194Ph1Su1"><aaif:text>Su propia boca</aaif:text><aaif:position rdf:datatype="http://www.w3.org/2001/XMLSchema#int">1</aaif:position><aaif:gender rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Feminine" /><aaif:number rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Singular" /><aaif:overt rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</aaif:overt></aaif:Subject><aaif:Verb rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En194Ph1Ve1"><aaif:text>murmurar</aaif:text><aaif:lemma rdf:resource="https://gams.uni-graz.at/o:aaif.lemma#murmurar" /><aaif:position rdf:datatype="http://www.w3.org/2001/XMLSchema#int">2</aaif:position><aaif:coordinated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:coordinated><aaif:partOfText rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</aaif:partOfText><aaif:syntacticConstruction rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Transitive" /></aaif:Verb><aaif:Adverb rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En194Ph1Ad1"><aaif:text>bajito</aaif:text><aaif:lemma rdf:resource="https://gams.uni-graz.at/o:aaif.lemma#bajo" /><aaif:position rdf:datatype="http://www.w3.org/2001/XMLSchema#int">3</aaif:position><aaif:coordinated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:coordinated><aaif:morphosyntacticStructure rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Adjective" /><aaif:inflection rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Uninflected" /><aaif:attributionTarget rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Verb" /><aaif:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:modified><aaif:semanticClassification rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Manner" /><aaif:reduplicated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:reduplicated><aaif:prepositionalPhrase rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:prepositionalPhrase></aaif:Adverb><aaif:Entry rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En195"><aaif:phrase rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh#En195Ph1" /><aaif:source rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh.bibl#Cnde261" /><gams:textualContent>sin interrupción quebraba el silencio bajo de los murmullos: aun  los perros babeantes , de piel sarnosa, jadeaban bajo , corriendo entre la multitud de paso lento que esperaba la aparición, en la lejanía, de las torres</gams:textualContent><rel:isPartOf rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh" /></aaif:Entry><aaif:Phrase rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En195Ph1"><aaif:subject rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh#En195Ph1Su1" /><aaif:verb rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh#En195Ph1Ve1" /><aaif:adverb rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh#En195Ph1Ad1" /><aaif:text> los perros babeantes , de piel sarnosa, jadeaban bajo </aaif:text><aaif:annoText> [s|los perros babeantes|mp] , de piel sarnosa, [v|jadeaban|jadear|is] [a|bajo|bajo|auvnmnnn] </aaif:annoText></aaif:Phrase><aaif:Subject rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En195Ph1Su1"><aaif:text>los perros babeantes</aaif:text><aaif:position rdf:datatype="http://www.w3.org/2001/XMLSchema#int">1</aaif:position><aaif:gender rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Masculine" /><aaif:number rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Plural" /><aaif:overt rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</aaif:overt></aaif:Subject><aaif:Verb rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En195Ph1Ve1"><aaif:text>jadeaban</aaif:text><aaif:lemma rdf:resource="https://gams.uni-graz.at/o:aaif.lemma#jadear" /><aaif:position rdf:datatype="http://www.w3.org/2001/XMLSchema#int">2</aaif:position><aaif:coordinated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:coordinated><aaif:partOfText rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</aaif:partOfText><aaif:syntacticConstruction rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Intransitive" /></aaif:Verb><aaif:Adverb rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En195Ph1Ad1"><aaif:text>bajo</aaif:text><aaif:lemma rdf:resource="https://gams.uni-graz.at/o:aaif.lemma#bajo" /><aaif:position rdf:datatype="http://www.w3.org/2001/XMLSchema#int">3</aaif:position><aaif:coordinated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:coordinated><aaif:morphosyntacticStructure rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Adjective" /><aaif:inflection rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Uninflected" /><aaif:attributionTarget rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Verb" /><aaif:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:modified><aaif:semanticClassification rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Manner" /><aaif:reduplicated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:reduplicated><aaif:prepositionalPhrase rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:prepositionalPhrase></aaif:Adverb><aaif:Entry rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En196"><aaif:phrase rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh#En196Ph1" /><aaif:source rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh.bibl#Cnde261" /><gams:textualContent>la blusa blanca y alargó una mano para recoger el rebozo.Él la condujo hacia afuera. Ella  mugía bajo , como un becerrillo lazado.Y él levantó el rostro hacia el cielo, tapizado esta noche con todas</gams:textualContent><rel:isPartOf rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh" /></aaif:Entry><aaif:Phrase rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En196Ph1"><aaif:subject rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh#En196Ph1Su1" /><aaif:verb rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh#En196Ph1Ve1" /><aaif:adverb rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh#En196Ph1Ad1" /><aaif:text> Ella  mugía bajo , como un becerrillo lazado</aaif:text><aaif:annoText> [s|Ella|fs]  [v|mugía|mugir|is] [a|bajo|bajo|auvnmnnn] , como un becerrillo lazado</aaif:annoText></aaif:Phrase><aaif:Subject rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En196Ph1Su1"><aaif:text>Ella</aaif:text><aaif:position rdf:datatype="http://www.w3.org/2001/XMLSchema#int">1</aaif:position><aaif:gender rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Feminine" /><aaif:number rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Singular" /><aaif:overt rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</aaif:overt></aaif:Subject><aaif:Verb rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En196Ph1Ve1"><aaif:text>mugía</aaif:text><aaif:lemma rdf:resource="https://gams.uni-graz.at/o:aaif.lemma#mugir" /><aaif:position rdf:datatype="http://www.w3.org/2001/XMLSchema#int">2</aaif:position><aaif:coordinated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:coordinated><aaif:partOfText rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</aaif:partOfText><aaif:syntacticConstruction rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Intransitive" /></aaif:Verb><aaif:Adverb rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En196Ph1Ad1"><aaif:text>bajo</aaif:text><aaif:lemma rdf:resource="https://gams.uni-graz.at/o:aaif.lemma#bajo" /><aaif:position rdf:datatype="http://www.w3.org/2001/XMLSchema#int">3</aaif:position><aaif:coordinated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:coordinated><aaif:morphosyntacticStructure rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Adjective" /><aaif:inflection rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Uninflected" /><aaif:attributionTarget rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Verb" /><aaif:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:modified><aaif:semanticClassification rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Manner" /><aaif:reduplicated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:reduplicated><aaif:prepositionalPhrase rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:prepositionalPhrase></aaif:Adverb><aaif:Entry rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En197"><aaif:phrase rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh#En197Ph1" /><aaif:source rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh.bibl#Cnde118" /><gams:textualContent>son paseadas, para escarmiento, a lo largo del camino que conduce a la Grande Riviére. Los buitres , volando bajo , daban de picotazos, al paso, a las caras amoratadas por el suplicio, que acababan de</gams:textualContent><rel:isPartOf rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh" /></aaif:Entry><aaif:Phrase rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En197Ph1"><aaif:subject rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh#En197Ph1Su1" /><aaif:verb rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh#En197Ph1Ve1" /><aaif:adverb rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh#En197Ph1Ad1" /><aaif:text> Los buitres , volando bajo ,</aaif:text><aaif:annoText> [s|Los buitres|mp] , [v|volando|volar|is] [a|bajo|bajo|auvnmnnn] ,</aaif:annoText></aaif:Phrase><aaif:Subject rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En197Ph1Su1"><aaif:text>Los buitres</aaif:text><aaif:position rdf:datatype="http://www.w3.org/2001/XMLSchema#int">1</aaif:position><aaif:gender rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Masculine" /><aaif:number rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Plural" /><aaif:overt rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</aaif:overt></aaif:Subject><aaif:Verb rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En197Ph1Ve1"><aaif:text>volando</aaif:text><aaif:lemma rdf:resource="https://gams.uni-graz.at/o:aaif.lemma#volar" /><aaif:position rdf:datatype="http://www.w3.org/2001/XMLSchema#int">2</aaif:position><aaif:coordinated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:coordinated><aaif:partOfText rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</aaif:partOfText><aaif:syntacticConstruction rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Intransitive" /></aaif:Verb><aaif:Adverb rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En197Ph1Ad1"><aaif:text>bajo</aaif:text><aaif:lemma rdf:resource="https://gams.uni-graz.at/o:aaif.lemma#bajo" /><aaif:position rdf:datatype="http://www.w3.org/2001/XMLSchema#int">3</aaif:position><aaif:coordinated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:coordinated><aaif:morphosyntacticStructure rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Adjective" /><aaif:inflection rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Uninflected" /><aaif:attributionTarget rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Verb" /><aaif:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:modified><aaif:semanticClassification rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Manner" /><aaif:reduplicated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:reduplicated><aaif:prepositionalPhrase rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:prepositionalPhrase></aaif:Adverb><aaif:Entry rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En198"><aaif:phrase rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh#En198Ph1" /><aaif:source rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh.bibl#Cnde118" /><gams:textualContent>preludio de sinfonía, anunciaba de lejos el avance del turbión, en tanto que  los buitres tiñosos , volando bajo en círculos cada vez más cerrados, abandonaban el paisaje.Un deleitoso olor a bosques mojados, a tierra</gams:textualContent><rel:isPartOf rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh" /></aaif:Entry><aaif:Phrase rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En198Ph1"><aaif:subject rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh#En198Ph1Su1" /><aaif:verb rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh#En198Ph1Ve1" /><aaif:adverb rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh#En198Ph1Ad1" /><aaif:text> los buitres tiñosos , volando bajo en círculos cada vez más cerrados</aaif:text><aaif:annoText> [s|los buitres tiñosos|mp] , [v|volando|volar|is] [a|bajo|bajo|auvnmnnn] en círculos cada vez más cerrados</aaif:annoText></aaif:Phrase><aaif:Subject rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En198Ph1Su1"><aaif:text>los buitres tiñosos</aaif:text><aaif:position rdf:datatype="http://www.w3.org/2001/XMLSchema#int">1</aaif:position><aaif:gender rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Masculine" /><aaif:number rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Plural" /><aaif:overt rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</aaif:overt></aaif:Subject><aaif:Verb rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En198Ph1Ve1"><aaif:text>volando</aaif:text><aaif:lemma rdf:resource="https://gams.uni-graz.at/o:aaif.lemma#volar" /><aaif:position rdf:datatype="http://www.w3.org/2001/XMLSchema#int">2</aaif:position><aaif:coordinated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:coordinated><aaif:partOfText rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</aaif:partOfText><aaif:syntacticConstruction rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Intransitive" /></aaif:Verb><aaif:Adverb rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En198Ph1Ad1"><aaif:text>bajo</aaif:text><aaif:lemma rdf:resource="https://gams.uni-graz.at/o:aaif.lemma#bajo" /><aaif:position rdf:datatype="http://www.w3.org/2001/XMLSchema#int">3</aaif:position><aaif:coordinated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:coordinated><aaif:morphosyntacticStructure rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Adjective" /><aaif:inflection rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Uninflected" /><aaif:attributionTarget rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Verb" /><aaif:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:modified><aaif:semanticClassification rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Manner" /><aaif:reduplicated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:reduplicated><aaif:prepositionalPhrase rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:prepositionalPhrase></aaif:Adverb><aaif:Entry rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En199"><aaif:phrase rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh#En199Ph1" /><aaif:source rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh.bibl#Cnde262" /><gams:textualContent>— Ya no llora más —dijo la Maga, mirando hacia la cama—.   Hablemos bajo , va a dormir muy bien con la aspirina.Yo no me he acostado para nada con Gregorovius.</gams:textualContent><rel:isPartOf rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh" /></aaif:Entry><aaif:Phrase rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En199Ph1"><aaif:subject rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh#En199Ph1Su1" /><aaif:verb rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh#En199Ph1Ve1" /><aaif:adverb rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh#En199Ph1Ad1" /><aaif:text>   Hablemos bajo </aaif:text><aaif:annoText> [s||up]  [v|Hablemos|hablar|is] [a|bajo|bajo|auvnmnnn] </aaif:annoText></aaif:Phrase><aaif:Subject rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En199Ph1Su1"><aaif:position rdf:datatype="http://www.w3.org/2001/XMLSchema#int">1</aaif:position><aaif:gender rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Undefined" /><aaif:number rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Plural" /><aaif:overt rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:overt></aaif:Subject><aaif:Verb rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En199Ph1Ve1"><aaif:text>Hablemos</aaif:text><aaif:lemma rdf:resource="https://gams.uni-graz.at/o:aaif.lemma#hablar" /><aaif:position rdf:datatype="http://www.w3.org/2001/XMLSchema#int">2</aaif:position><aaif:coordinated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:coordinated><aaif:partOfText rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</aaif:partOfText><aaif:syntacticConstruction rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Intransitive" /></aaif:Verb><aaif:Adverb rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En199Ph1Ad1"><aaif:text>bajo</aaif:text><aaif:lemma rdf:resource="https://gams.uni-graz.at/o:aaif.lemma#bajo" /><aaif:position rdf:datatype="http://www.w3.org/2001/XMLSchema#int">3</aaif:position><aaif:coordinated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:coordinated><aaif:morphosyntacticStructure rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Adjective" /><aaif:inflection rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Uninflected" /><aaif:attributionTarget rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Verb" /><aaif:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:modified><aaif:semanticClassification rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Manner" /><aaif:reduplicated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:reduplicated><aaif:prepositionalPhrase rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:prepositionalPhrase></aaif:Adverb><aaif:Entry rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En200"><aaif:phrase rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh#En200Ph1" /><aaif:source rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh.bibl#Cnde262" /><gams:textualContent>como fatídico era imposible imaginar nada más logrado, por eso cuando  el señor de aire plácido empezó a reírse bajito  y se tapó educadamente la boca con un guante, Oliveira tuvo que admitir que el tipo tenía derecho,</gams:textualContent><rel:isPartOf rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh" /></aaif:Entry><aaif:Phrase rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En200Ph1"><aaif:subject rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh#En200Ph1Su1" /><aaif:verb rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh#En200Ph1Ve1" /><aaif:adverb rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh#En200Ph1Ad1" /><aaif:text> el señor de aire plácido empezó a reírse bajito </aaif:text><aaif:annoText> [s|el señor de aire plácido|ms] empezó a [v|reírse|reír|rs] [a|bajito|bajo|auvnmnnn] </aaif:annoText></aaif:Phrase><aaif:Subject rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En200Ph1Su1"><aaif:text>el señor de aire plácido</aaif:text><aaif:position rdf:datatype="http://www.w3.org/2001/XMLSchema#int">1</aaif:position><aaif:gender rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Masculine" /><aaif:number rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Singular" /><aaif:overt rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</aaif:overt></aaif:Subject><aaif:Verb rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En200Ph1Ve1"><aaif:text>reírse</aaif:text><aaif:lemma rdf:resource="https://gams.uni-graz.at/o:aaif.lemma#reír" /><aaif:position rdf:datatype="http://www.w3.org/2001/XMLSchema#int">2</aaif:position><aaif:coordinated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:coordinated><aaif:partOfText rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</aaif:partOfText><aaif:syntacticConstruction rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Reflexive" /></aaif:Verb><aaif:Adverb rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En200Ph1Ad1"><aaif:text>bajito</aaif:text><aaif:lemma rdf:resource="https://gams.uni-graz.at/o:aaif.lemma#bajo" /><aaif:position rdf:datatype="http://www.w3.org/2001/XMLSchema#int">3</aaif:position><aaif:coordinated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:coordinated><aaif:morphosyntacticStructure rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Adjective" /><aaif:inflection rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Uninflected" /><aaif:attributionTarget rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Verb" /><aaif:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:modified><aaif:semanticClassification rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Manner" /><aaif:reduplicated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:reduplicated><aaif:prepositionalPhrase rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:prepositionalPhrase></aaif:Adverb><aaif:Entry rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En201"><aaif:phrase rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh#En201Ph1" /><aaif:source rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh.bibl#Cnde262" /><gams:textualContent>con una voz de nariz—.A ver qué le contesta Horacio.Me parece que se está riendo bajito , cuando empieza a reírse no encuentra las palabras, es increíble.Yo voy a ver lo que pasa</gams:textualContent><rel:isPartOf rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh" /></aaif:Entry><aaif:Phrase rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En201Ph1"><aaif:verb rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh#En201Ph1Ve1" /><aaif:adverb rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh#En201Ph1Ad1" /><aaif:text>Me parece que se está riendo bajito </aaif:text><aaif:annoText>Me parece que se está [v|riendo|reír|rs] [a|bajito|bajo|auvnmnnn] </aaif:annoText></aaif:Phrase><aaif:Verb rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En201Ph1Ve1"><aaif:text>riendo</aaif:text><aaif:lemma rdf:resource="https://gams.uni-graz.at/o:aaif.lemma#reír" /><aaif:position rdf:datatype="http://www.w3.org/2001/XMLSchema#int">1</aaif:position><aaif:coordinated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:coordinated><aaif:partOfText rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</aaif:partOfText><aaif:syntacticConstruction rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Reflexive" /></aaif:Verb><aaif:Adverb rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En201Ph1Ad1"><aaif:text>bajito</aaif:text><aaif:lemma rdf:resource="https://gams.uni-graz.at/o:aaif.lemma#bajo" /><aaif:position rdf:datatype="http://www.w3.org/2001/XMLSchema#int">2</aaif:position><aaif:coordinated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:coordinated><aaif:morphosyntacticStructure rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Adjective" /><aaif:inflection rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Uninflected" /><aaif:attributionTarget rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Verb" /><aaif:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:modified><aaif:semanticClassification rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Manner" /><aaif:reduplicated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:reduplicated><aaif:prepositionalPhrase rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:prepositionalPhrase></aaif:Adverb><aaif:Entry rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En202"><aaif:phrase rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh#En202Ph1" /><aaif:source rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh.bibl#Cnde262" /><gams:textualContent>, siempre la acción.Die Tätigkeit, viejo.Zás, éramos pocos y parió la abuela.   Hablen bajo , che, que van a despertar al niño.</gams:textualContent><rel:isPartOf rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh" /></aaif:Entry><aaif:Phrase rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En202Ph1"><aaif:subject rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh#En202Ph1Su1" /><aaif:verb rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh#En202Ph1Ve1" /><aaif:adverb rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh#En202Ph1Ad1" /><aaif:text>   Hablen bajo , che,</aaif:text><aaif:annoText> [s||up]  [v|Hablen|hablar|is] [a|bajo|bajo|auvnmnnn] , che,</aaif:annoText></aaif:Phrase><aaif:Subject rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En202Ph1Su1"><aaif:position rdf:datatype="http://www.w3.org/2001/XMLSchema#int">1</aaif:position><aaif:gender rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Undefined" /><aaif:number rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Plural" /><aaif:overt rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:overt></aaif:Subject><aaif:Verb rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En202Ph1Ve1"><aaif:text>Hablen</aaif:text><aaif:lemma rdf:resource="https://gams.uni-graz.at/o:aaif.lemma#hablar" /><aaif:position rdf:datatype="http://www.w3.org/2001/XMLSchema#int">2</aaif:position><aaif:coordinated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:coordinated><aaif:partOfText rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</aaif:partOfText><aaif:syntacticConstruction rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Intransitive" /></aaif:Verb><aaif:Adverb rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En202Ph1Ad1"><aaif:text>bajo</aaif:text><aaif:lemma rdf:resource="https://gams.uni-graz.at/o:aaif.lemma#bajo" /><aaif:position rdf:datatype="http://www.w3.org/2001/XMLSchema#int">3</aaif:position><aaif:coordinated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:coordinated><aaif:morphosyntacticStructure rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Adjective" /><aaif:inflection rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Uninflected" /><aaif:attributionTarget rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Verb" /><aaif:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:modified><aaif:semanticClassification rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Manner" /><aaif:reduplicated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:reduplicated><aaif:prepositionalPhrase rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:prepositionalPhrase></aaif:Adverb><aaif:Entry rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En203"><aaif:phrase rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh#En203Ph1" /><aaif:source rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh.bibl#Cnde262" /><gams:textualContent>—  Hablá  bajo  —dijo Ronald—.Y meté en un rincón ese paraguas de mierda.</gams:textualContent><rel:isPartOf rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh" /></aaif:Entry><aaif:Phrase rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En203Ph1"><aaif:verb rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh#En203Ph1Ve1" /><aaif:adverb rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh#En203Ph1Ad1" /><aaif:text> Hablá  bajo </aaif:text><aaif:annoText> [v|Hablá|hablar|is]  [a|bajo|bajo|auvnmnnn] </aaif:annoText></aaif:Phrase><aaif:Verb rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En203Ph1Ve1"><aaif:text>Hablá</aaif:text><aaif:lemma rdf:resource="https://gams.uni-graz.at/o:aaif.lemma#hablar" /><aaif:position rdf:datatype="http://www.w3.org/2001/XMLSchema#int">1</aaif:position><aaif:coordinated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:coordinated><aaif:partOfText rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</aaif:partOfText><aaif:syntacticConstruction rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Intransitive" /></aaif:Verb><aaif:Adverb rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En203Ph1Ad1"><aaif:text>bajo</aaif:text><aaif:lemma rdf:resource="https://gams.uni-graz.at/o:aaif.lemma#bajo" /><aaif:position rdf:datatype="http://www.w3.org/2001/XMLSchema#int">2</aaif:position><aaif:coordinated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:coordinated><aaif:morphosyntacticStructure rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Adjective" /><aaif:inflection rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Uninflected" /><aaif:attributionTarget rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Verb" /><aaif:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:modified><aaif:semanticClassification rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Manner" /><aaif:reduplicated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:reduplicated><aaif:prepositionalPhrase rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:prepositionalPhrase></aaif:Adverb><aaif:Entry rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En204"><aaif:phrase rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh#En204Ph1" /><aaif:source rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh.bibl#Cnde262" /><gams:textualContent>—    Hablemos bajo  —dijo Babs.</gams:textualContent><rel:isPartOf rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh" /></aaif:Entry><aaif:Phrase rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En204Ph1"><aaif:subject rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh#En204Ph1Su1" /><aaif:verb rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh#En204Ph1Ve1" /><aaif:adverb rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh#En204Ph1Ad1" /><aaif:text>   Hablemos bajo </aaif:text><aaif:annoText> [s||up]  [v|Hablemos|hablar|is] [a|bajo|bajo|auvnmnnn] </aaif:annoText></aaif:Phrase><aaif:Subject rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En204Ph1Su1"><aaif:position rdf:datatype="http://www.w3.org/2001/XMLSchema#int">1</aaif:position><aaif:gender rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Undefined" /><aaif:number rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Plural" /><aaif:overt rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:overt></aaif:Subject><aaif:Verb rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En204Ph1Ve1"><aaif:text>Hablemos</aaif:text><aaif:lemma rdf:resource="https://gams.uni-graz.at/o:aaif.lemma#hablar" /><aaif:position rdf:datatype="http://www.w3.org/2001/XMLSchema#int">2</aaif:position><aaif:coordinated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:coordinated><aaif:partOfText rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</aaif:partOfText><aaif:syntacticConstruction rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Intransitive" /></aaif:Verb><aaif:Adverb rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En204Ph1Ad1"><aaif:text>bajo</aaif:text><aaif:lemma rdf:resource="https://gams.uni-graz.at/o:aaif.lemma#bajo" /><aaif:position rdf:datatype="http://www.w3.org/2001/XMLSchema#int">3</aaif:position><aaif:coordinated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:coordinated><aaif:morphosyntacticStructure rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Adjective" /><aaif:inflection rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Uninflected" /><aaif:attributionTarget rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Verb" /><aaif:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:modified><aaif:semanticClassification rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Manner" /><aaif:reduplicated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:reduplicated><aaif:prepositionalPhrase rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:prepositionalPhrase></aaif:Adverb><aaif:Entry rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En205"><aaif:phrase rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh#En205Ph1" /><aaif:source rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh.bibl#Cnde262" /><gams:textualContent>—    Hablen bajo  —dijo la Maga que llegaba detrás de ellos—.¿Por qué no cerrás el paraguas para entrar?</gams:textualContent><rel:isPartOf rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh" /></aaif:Entry><aaif:Phrase rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En205Ph1"><aaif:subject rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh#En205Ph1Su1" /><aaif:verb rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh#En205Ph1Ve1" /><aaif:adverb rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh#En205Ph1Ad1" /><aaif:text>   Hablen bajo </aaif:text><aaif:annoText> [s||up]  [v|Hablen|hablar|is] [a|bajo|bajo|auvnmnnn] </aaif:annoText></aaif:Phrase><aaif:Subject rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En205Ph1Su1"><aaif:position rdf:datatype="http://www.w3.org/2001/XMLSchema#int">1</aaif:position><aaif:gender rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Undefined" /><aaif:number rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Plural" /><aaif:overt rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:overt></aaif:Subject><aaif:Verb rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En205Ph1Ve1"><aaif:text>Hablen</aaif:text><aaif:lemma rdf:resource="https://gams.uni-graz.at/o:aaif.lemma#hablar" /><aaif:position rdf:datatype="http://www.w3.org/2001/XMLSchema#int">2</aaif:position><aaif:coordinated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:coordinated><aaif:partOfText rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</aaif:partOfText><aaif:syntacticConstruction rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Intransitive" /></aaif:Verb><aaif:Adverb rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En205Ph1Ad1"><aaif:text>bajo</aaif:text><aaif:lemma rdf:resource="https://gams.uni-graz.at/o:aaif.lemma#bajo" /><aaif:position rdf:datatype="http://www.w3.org/2001/XMLSchema#int">3</aaif:position><aaif:coordinated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:coordinated><aaif:morphosyntacticStructure rdf:resource="https://gams.uni-gr