.at/o:aaif.spacdh#En1332Ph1Ad2"><aaif:text>claro</aaif:text><aaif:lemma rdf:resource="https://gams.uni-graz.at/o:aaif.lemma#claro" /><aaif:position rdf:datatype="http://www.w3.org/2001/XMLSchema#int">4</aaif:position><aaif:coordinated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:coordinated><aaif:morphosyntacticStructure rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Adjective" /><aaif:inflection rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Uninflected" /><aaif:attributionTarget rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Verb" /><aaif:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:modified><aaif:semanticClassification rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Manner" /><aaif:reduplicated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:reduplicated><aaif:prepositionalPhrase rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:prepositionalPhrase></aaif:Adverb><aaif:Entry rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En1333"><aaif:phrase rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh#En1333Ph1" /><aaif:source rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh.bibl#Cnde43" /><gams:textualContent>Martín Aprieta fuerte .Más.(La mira mientras ella termina el vendaje.) ¿Por qué te has puesto ese vestido</gams:textualContent><rel:isPartOf rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh" /></aaif:Entry><aaif:Phrase rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En1333Ph1"><aaif:verb rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh#En1333Ph1Ve1" /><aaif:adverb rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh#En1333Ph1Ad1" /><aaif:text>Martín Aprieta fuerte </aaif:text><aaif:annoText>Martín [v|Aprieta|apretar|is] [a|fuerte|fuerte|auvnmnnn] </aaif:annoText></aaif:Phrase><aaif:Verb rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En1333Ph1Ve1"><aaif:text>Aprieta</aaif:text><aaif:lemma rdf:resource="https://gams.uni-graz.at/o:aaif.lemma#apretar" /><aaif:position rdf:datatype="http://www.w3.org/2001/XMLSchema#int">1</aaif:position><aaif:coordinated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:coordinated><aaif:partOfText rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</aaif:partOfText><aaif:syntacticConstruction rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Intransitive" /></aaif:Verb><aaif:Adverb rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En1333Ph1Ad1"><aaif:text>fuerte</aaif:text><aaif:lemma rdf:resource="https://gams.uni-graz.at/o:aaif.lemma#fuerte" /><aaif:position rdf:datatype="http://www.w3.org/2001/XMLSchema#int">2</aaif:position><aaif:coordinated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:coordinated><aaif:morphosyntacticStructure rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Adjective" /><aaif:inflection rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Uninflected" /><aaif:attributionTarget rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Verb" /><aaif:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:modified><aaif:semanticClassification rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Manner" /><aaif:reduplicated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:reduplicated><aaif:prepositionalPhrase rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:prepositionalPhrase></aaif:Adverb><aaif:Entry rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En1334"><aaif:phrase rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh#En1334Ph1" /><aaif:source rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh.bibl#Cnde43" /><gams:textualContent>noche en el baile no te separes de mí.Si oyes que alguna voz extraña te llama, apriétame fuerte la mano y no te muevas de mi lado.¿Me lo prometes?</gams:textualContent><rel:isPartOf rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh" /></aaif:Entry><aaif:Phrase rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En1334Ph1"><aaif:verb rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh#En1334Ph1Ve1" /><aaif:adverb rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh#En1334Ph1Ad1" /><aaif:text>Si oyes que alguna voz extraña te llama, apriétame fuerte la mano</aaif:text><aaif:annoText>Si oyes que alguna voz extraña te llama, [v|apriétame|apretar|ts] [a|fuerte|fuerte|auvnmnnn] la mano</aaif:annoText></aaif:Phrase><aaif:Verb rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En1334Ph1Ve1"><aaif:text>apriétame</aaif:text><aaif:lemma rdf:resource="https://gams.uni-graz.at/o:aaif.lemma#apretar" /><aaif:position rdf:datatype="http://www.w3.org/2001/XMLSchema#int">1</aaif:position><aaif:coordinated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:coordinated><aaif:partOfText rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</aaif:partOfText><aaif:syntacticConstruction rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Transitive" /></aaif:Verb><aaif:Adverb rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En1334Ph1Ad1"><aaif:text>fuerte</aaif:text><aaif:lemma rdf:resource="https://gams.uni-graz.at/o:aaif.lemma#fuerte" /><aaif:position rdf:datatype="http://www.w3.org/2001/XMLSchema#int">2</aaif:position><aaif:coordinated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:coordinated><aaif:morphosyntacticStructure rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Adjective" /><aaif:inflection rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Uninflected" /><aaif:attributionTarget rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Verb" /><aaif:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:modified><aaif:semanticClassification rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Manner" /><aaif:reduplicated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:reduplicated><aaif:prepositionalPhrase rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:prepositionalPhrase></aaif:Adverb><aaif:Entry rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En1335"><aaif:phrase rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh#En1335Ph1" /><aaif:source rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh.bibl#Cnde43" /><gams:textualContent>Telva Más bajo, rapaza, que tengo muy orgullosas las orejas, y si me hablan fuerte no oigo.</gams:textualContent><rel:isPartOf rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh" /></aaif:Entry><aaif:Phrase rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En1335Ph1"><aaif:verb rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh#En1335Ph1Ve1" /><aaif:adverb rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh#En1335Ph1Ad1" /><aaif:text>tengo muy orgullosas las orejas, y si me hablan fuerte no oigo</aaif:text><aaif:annoText>tengo muy orgullosas las orejas, y si me [v|hablan|hablar|is] [a|fuerte|fuerte|auvnmnnn] no oigo</aaif:annoText></aaif:Phrase><aaif:Verb rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En1335Ph1Ve1"><aaif:text>hablan</aaif:text><aaif:lemma rdf:resource="https://gams.uni-graz.at/o:aaif.lemma#hablar" /><aaif:position rdf:datatype="http://www.w3.org/2001/XMLSchema#int">1</aaif:position><aaif:coordinated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:coordinated><aaif:partOfText rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</aaif:partOfText><aaif:syntacticConstruction rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Intransitive" /></aaif:Verb><aaif:Adverb rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En1335Ph1Ad1"><aaif:text>fuerte</aaif:text><aaif:lemma rdf:resource="https://gams.uni-graz.at/o:aaif.lemma#fuerte" /><aaif:position rdf:datatype="http://www.w3.org/2001/XMLSchema#int">2</aaif:position><aaif:coordinated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:coordinated><aaif:morphosyntacticStructure rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Adjective" /><aaif:inflection rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Uninflected" /><aaif:attributionTarget rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Verb" /><aaif:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:modified><aaif:semanticClassification rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Manner" /><aaif:reduplicated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:reduplicated><aaif:prepositionalPhrase rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:prepositionalPhrase></aaif:Adverb><aaif:Entry rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En1336"><aaif:phrase rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh#En1336Ph1" /><aaif:source rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh.bibl#Cnde258" /><gams:textualContent>La sentía respirar fuerte .</gams:textualContent><rel:isPartOf rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh" /></aaif:Entry><aaif:Phrase rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En1336Ph1"><aaif:verb rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh#En1336Ph1Ve1" /><aaif:adverb rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh#En1336Ph1Ad1" /><aaif:text>La sentía respirar fuerte </aaif:text><aaif:annoText>La sentía [v|respirar|respirar|is] [a|fuerte|fuerte|auvnmnnn] </aaif:annoText></aaif:Phrase><aaif:Verb rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En1336Ph1Ve1"><aaif:text>respirar</aaif:text><aaif:lemma rdf:resource="https://gams.uni-graz.at/o:aaif.lemma#respirar" /><aaif:position rdf:datatype="http://www.w3.org/2001/XMLSchema#int">1</aaif:position><aaif:coordinated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:coordinated><aaif:partOfText rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</aaif:partOfText><aaif:syntacticConstruction rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Intransitive" /></aaif:Verb><aaif:Adverb rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En1336Ph1Ad1"><aaif:text>fuerte</aaif:text><aaif:lemma rdf:resource="https://gams.uni-graz.at/o:aaif.lemma#fuerte" /><aaif:position rdf:datatype="http://www.w3.org/2001/XMLSchema#int">2</aaif:position><aaif:coordinated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:coordinated><aaif:morphosyntacticStructure rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Adjective" /><aaif:inflection rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Uninflected" /><aaif:attributionTarget rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Verb" /><aaif:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:modified><aaif:semanticClassification rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Manner" /><aaif:reduplicated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:reduplicated><aaif:prepositionalPhrase rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:prepositionalPhrase></aaif:Adverb><aaif:Entry rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En1337"><aaif:phrase rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh#En1337Ph1" /><aaif:source rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh.bibl#Cnde258" /><gams:textualContent> Ena  respiró fuerte , como si esto le aliviase de mil sentimientos ardorosos.Cruzó las manos a su espalda, casi estirándose</gams:textualContent><rel:isPartOf rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh" /></aaif:Entry><aaif:Phrase rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En1337Ph1"><aaif:subject rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh#En1337Ph1Su1" /><aaif:verb rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh#En1337Ph1Ve1" /><aaif:adverb rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh#En1337Ph1Ad1" /><aaif:text> Ena  respiró fuerte </aaif:text><aaif:annoText> [s|Ena|fs]  [v|respiró|respirar|is] [a|fuerte|fuerte|auvnmnnn] </aaif:annoText></aaif:Phrase><aaif:Subject rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En1337Ph1Su1"><aaif:text>Ena</aaif:text><aaif:position rdf:datatype="http://www.w3.org/2001/XMLSchema#int">1</aaif:position><aaif:gender rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Feminine" /><aaif:number rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Singular" /><aaif:overt rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</aaif:overt></aaif:Subject><aaif:Verb rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En1337Ph1Ve1"><aaif:text>respiró</aaif:text><aaif:lemma rdf:resource="https://gams.uni-graz.at/o:aaif.lemma#respirar" /><aaif:position rdf:datatype="http://www.w3.org/2001/XMLSchema#int">2</aaif:position><aaif:coordinated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:coordinated><aaif:partOfText rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</aaif:partOfText><aaif:syntacticConstruction rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Intransitive" /></aaif:Verb><aaif:Adverb rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En1337Ph1Ad1"><aaif:text>fuerte</aaif:text><aaif:lemma rdf:resource="https://gams.uni-graz.at/o:aaif.lemma#fuerte" /><aaif:position rdf:datatype="http://www.w3.org/2001/XMLSchema#int">3</aaif:position><aaif:coordinated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:coordinated><aaif:morphosyntacticStructure rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Adjective" /><aaif:inflection rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Uninflected" /><aaif:attributionTarget rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Verb" /><aaif:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:modified><aaif:semanticClassification rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Manner" /><aaif:reduplicated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:reduplicated><aaif:prepositionalPhrase rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:prepositionalPhrase></aaif:Adverb><aaif:Entry rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En1338"><aaif:phrase rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh#En1338Ph1" /><aaif:source rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh.bibl#Cnde116" /><gams:textualContent>chicas cuántos groseros hay este año?”, y nosotros nos metíamos pasto en la boca para no reírnos fuerte , porque lo bueno era dejarlas con las ganas y no seguírsela, así después cuando nos oían jugar a</gams:textualContent><rel:isPartOf rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh" /></aaif:Entry><aaif:Phrase rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En1338Ph1"><aaif:verb rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh#En1338Ph1Ve1" /><aaif:adverb rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh#En1338Ph1Ad1" /><aaif:text>nosotros nos metíamos pasto en la boca para no reírnos fuerte </aaif:text><aaif:annoText>nosotros nos metíamos pasto en la boca para no [v|reírnos|reír|rs] [a|fuerte|fuerte|auvnmnnn] </aaif:annoText></aaif:Phrase><aaif:Verb rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En1338Ph1Ve1"><aaif:text>reírnos</aaif:text><aaif:lemma rdf:resource="https://gams.uni-graz.at/o:aaif.lemma#reír" /><aaif:position rdf:datatype="http://www.w3.org/2001/XMLSchema#int">1</aaif:position><aaif:coordinated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:coordinated><aaif:partOfText rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</aaif:partOfText><aaif:syntacticConstruction rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Reflexive" /></aaif:Verb><aaif:Adverb rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En1338Ph1Ad1"><aaif:text>fuerte</aaif:text><aaif:lemma rdf:resource="https://gams.uni-graz.at/o:aaif.lemma#fuerte" /><aaif:position rdf:datatype="http://www.w3.org/2001/XMLSchema#int">2</aaif:position><aaif:coordinated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:coordinated><aaif:morphosyntacticStructure rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Adjective" /><aaif:inflection rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Uninflected" /><aaif:attributionTarget rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Verb" /><aaif:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:modified><aaif:semanticClassification rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Manner" /><aaif:reduplicated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:reduplicated><aaif:prepositionalPhrase rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:prepositionalPhrase></aaif:Adverb><aaif:Entry rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En1339"><aaif:phrase rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh#En1339Ph1" /><aaif:source rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh.bibl#Cnde116" /><gams:textualContent>velaba en lo alto de la pared del fondo como un ojo protector.Se oía toser, respirar fuerte , a veces un diálogo en voz baja.Todo era grato y seguro, sin ese acoso, sin...Pero no</gams:textualContent><rel:isPartOf rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh" /></aaif:Entry><aaif:Phrase rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En1339Ph1"><aaif:verb rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh#En1339Ph1Ve1" /><aaif:adverb rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh#En1339Ph1Ad1" /><aaif:text>Se oía toser, respirar fuerte </aaif:text><aaif:annoText>Se oía toser, [v|respirar|respirar|is] [a|fuerte|fuerte|auvnmnnn] </aaif:annoText></aaif:Phrase><aaif:Verb rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En1339Ph1Ve1"><aaif:text>respirar</aaif:text><aaif:lemma rdf:resource="https://gams.uni-graz.at/o:aaif.lemma#respirar" /><aaif:position rdf:datatype="http://www.w3.org/2001/XMLSchema#int">1</aaif:position><aaif:coordinated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:coordinated><aaif:partOfText rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</aaif:partOfText><aaif:syntacticConstruction rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Intransitive" /></aaif:Verb><aaif:Adverb rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En1339Ph1Ad1"><aaif:text>fuerte</aaif:text><aaif:lemma rdf:resource="https://gams.uni-graz.at/o:aaif.lemma#fuerte" /><aaif:position rdf:datatype="http://www.w3.org/2001/XMLSchema#int">2</aaif:position><aaif:coordinated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:coordinated><aaif:morphosyntacticStructure rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Adjective" /><aaif:inflection rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Uninflected" /><aaif:attributionTarget rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Verb" /><aaif:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:modified><aaif:semanticClassification rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Manner" /><aaif:reduplicated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:reduplicated><aaif:prepositionalPhrase rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:prepositionalPhrase></aaif:Adverb><aaif:Entry rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En1340"><aaif:phrase rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh#En1340Ph1" /><aaif:source rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh.bibl#Cnde2" /><gams:textualContent>veces son preocupaciones.Aúlla el Orión y nada sucede.Hay que dormir.Mañana es día de trabajar fuerte .Después de la primera misa, Dios mediante, hay que ir al rancho y pasarse a la</gams:textualContent><rel:isPartOf rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh" /></aaif:Entry><aaif:Phrase rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En1340Ph1"><aaif:verb rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh#En1340Ph1Ve1" /><aaif:adverb rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh#En1340Ph1Ad1" /><aaif:text>Mañana es día de trabajar fuerte </aaif:text><aaif:annoText>Mañana es día de [v|trabajar|trabajar|is] [a|fuerte|fuerte|auvnmnnn] </aaif:annoText></aaif:Phrase><aaif:Verb rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En1340Ph1Ve1"><aaif:text>trabajar</aaif:text><aaif:lemma rdf:resource="https://gams.uni-graz.at/o:aaif.lemma#trabajar" /><aaif:position rdf:datatype="http://www.w3.org/2001/XMLSchema#int">1</aaif:position><aaif:coordinated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:coordinated><aaif:partOfText rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</aaif:partOfText><aaif:syntacticConstruction rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Intransitive" /></aaif:Verb><aaif:Adverb rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En1340Ph1Ad1"><aaif:text>fuerte</aaif:text><aaif:lemma rdf:resource="https://gams.uni-graz.at/o:aaif.lemma#fuerte" /><aaif:position rdf:datatype="http://www.w3.org/2001/XMLSchema#int">2</aaif:position><aaif:coordinated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:coordinated><aaif:morphosyntacticStructure rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Adjective" /><aaif:inflection rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Uninflected" /><aaif:attributionTarget rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Verb" /><aaif:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:modified><aaif:semanticClassification rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Manner" /><aaif:reduplicated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:reduplicated><aaif:prepositionalPhrase rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:prepositionalPhrase></aaif:Adverb><aaif:Entry rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En1341"><aaif:phrase rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh#En1341Ph1" /><aaif:source rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh.bibl#Cnde2" /><gams:textualContent>porque los placeros discutieran lo que les cobraban por impuesto de piso cada vez más gravoso, hasta porque gritaran fuerte  o porque tropezaran con alguien.</gams:textualContent><rel:isPartOf rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh" /></aaif:Entry><aaif:Phrase rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En1341Ph1"><aaif:verb rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh#En1341Ph1Ve1" /><aaif:adverb rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh#En1341Ph1Ad1" /><aaif:text>hasta porque gritaran fuerte </aaif:text><aaif:annoText>hasta porque [v|gritaran|gritar|is] [a|fuerte|fuerte|auvnmnnn] </aaif:annoText></aaif:Phrase><aaif:Verb rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En1341Ph1Ve1"><aaif:text>gritaran</aaif:text><aaif:lemma rdf:resource="https://gams.uni-graz.at/o:aaif.lemma#gritar" /><aaif:position rdf:datatype="http://www.w3.org/2001/XMLSchema#int">1</aaif:position><aaif:coordinated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:coordinated><aaif:partOfText rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</aaif:partOfText><aaif:syntacticConstruction rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Intransitive" /></aaif:Verb><aaif:Adverb rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En1341Ph1Ad1"><aaif:text>fuerte</aaif:text><aaif:lemma rdf:resource="https://gams.uni-graz.at/o:aaif.lemma#fuerte" /><aaif:position rdf:datatype="http://www.w3.org/2001/XMLSchema#int">2</aaif:position><aaif:coordinated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:coordinated><aaif:morphosyntacticStructure rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Adjective" /><aaif:inflection rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Uninflected" /><aaif:attributionTarget rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Verb" /><aaif:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:modified><aaif:semanticClassification rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Manner" /><aaif:reduplicated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:reduplicated><aaif:prepositionalPhrase rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:prepositionalPhrase></aaif:Adverb><aaif:Entry rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En1342"><aaif:phrase rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh#En1342Ph1" /><aaif:source rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh.bibl#Cnde45" /><gams:textualContent>Traía los sacos apoyados sobre la cadera y llegaba respirando fuerte  y oliendo a cardenillo, el perfume humilde de la calderilla, pues como se vivía al céntimo y</gams:textualContent><rel:isPartOf rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh" /></aaif:Entry><aaif:Phrase rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En1342Ph1"><aaif:verb rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh#En1342Ph1Ve1" /><aaif:adverb rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh#En1342Ph1Ad1" /><aaif:text>llegaba respirando fuerte </aaif:text><aaif:annoText>llegaba [v|respirando|respirar|is] [a|fuerte|fuerte|auvnmnnn] </aaif:annoText></aaif:Phrase><aaif:Verb rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En1342Ph1Ve1"><aaif:text>respirando</aaif:text><aaif:lemma rdf:resource="https://gams.uni-graz.at/o:aaif.lemma#respirar" /><aaif:position rdf:datatype="http://www.w3.org/2001/XMLSchema#int">1</aaif:position><aaif:coordinated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:coordinated><aaif:partOfText rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</aaif:partOfText><aaif:syntacticConstruction rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Intransitive" /></aaif:Verb><aaif:Adverb rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En1342Ph1Ad1"><aaif:text>fuerte</aaif:text><aaif:lemma rdf:resource="https://gams.uni-graz.at/o:aaif.lemma#fuerte" /><aaif:position rdf:datatype="http://www.w3.org/2001/XMLSchema#int">2</aaif:position><aaif:coordinated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:coordinated><aaif:morphosyntacticStructure rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Adjective" /><aaif:inflection rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Uninflected" /><aaif:attributionTarget rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Verb" /><aaif:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:modified><aaif:semanticClassification rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Manner" /><aaif:reduplicated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:reduplicated><aaif:prepositionalPhrase rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:prepositionalPhrase></aaif:Adverb><aaif:Entry rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En1343"><aaif:phrase rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh#En1343Ph1" /><aaif:source rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh.bibl#Cnde403" /><gams:textualContent>viene lo mejor del cuento —anunció en tono jovial—.Como les decía, los hombres jugaban fuerte .Y el brasileño, que ya perdía un dineral, echaba chispas a cada “vale cuatro” de</gams:textualContent><rel:isPartOf rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh" /></aaif:Entry><aaif:Phrase rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En1343Ph1"><aaif:subject rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh#En1343Ph1Su1" /><aaif:verb rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh#En1343Ph1Ve1" /><aaif:adverb rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh#En1343Ph1Ad1" /><aaif:text>Como les decía, los hombres jugaban fuerte </aaif:text><aaif:annoText>Como les decía, [s|los hombres|mp] [v|jugaban|jugar|is] [a|fuerte|fuerte|auvnmnnn] </aaif:annoText></aaif:Phrase><aaif:Subject rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En1343Ph1Su1"><aaif:text>los hombres</aaif:text><aaif:position rdf:datatype="http://www.w3.org/2001/XMLSchema#int">1</aaif:position><aaif:gender rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Masculine" /><aaif:number rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Plural" /><aaif:overt rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</aaif:overt></aaif:Subject><aaif:Verb rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En1343Ph1Ve1"><aaif:text>jugaban</aaif:text><aaif:lemma rdf:resource="https://gams.uni-graz.at/o:aaif.lemma#jugar" /><aaif:position rdf:datatype="http://www.w3.org/2001/XMLSchema#int">2</aaif:position><aaif:coordinated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:coordinated><aaif:partOfText rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</aaif:partOfText><aaif:syntacticConstruction rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Intransitive" /></aaif:Verb><aaif:Adverb rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En1343Ph1Ad1"><aaif:text>fuerte</aaif:text><aaif:lemma rdf:resource="https://gams.uni-graz.at/o:aaif.lemma#fuerte" /><aaif:position rdf:datatype="http://www.w3.org/2001/XMLSchema#int">3</aaif:position><aaif:coordinated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:coordinated><aaif:morphosyntacticStructure rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Adjective" /><aaif:inflection rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Uninflected" /><aaif:attributionTarget rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Verb" /><aaif:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:modified><aaif:semanticClassification rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Manner" /><aaif:reduplicated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:reduplicated><aaif:prepositionalPhrase rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:prepositionalPhrase></aaif:Adverb><aaif:Entry rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En1344"><aaif:phrase rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh#En1344Ph1" /><aaif:source rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh.bibl#Cnde403" /><gams:textualContent>que de repente cayó el tirifilo con su patota.Venían todos medio en curda, y  el tirifilo entró pisando fuerte y gritando: “¡Abran cancha!” Paró la música, se alborotó el mujerío, y vi</gams:textualContent><rel:isPartOf rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh" /></aaif:Entry><aaif:Phrase rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En1344Ph1"><aaif:subject rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh#En1344Ph1Su1" /><aaif:verb rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh#En1344Ph1Ve1" /><aaif:adverb rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh#En1344Ph1Ad1" /><aaif:text> el tirifilo entró pisando fuerte y gritando</aaif:text><aaif:annoText> [s|el tirifilo|ms] entró [v|pisando|pisar|is] [a|fuerte|fuerte|auvnmnnn] y gritando</aaif:annoText></aaif:Phrase><aaif:Subject rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En1344Ph1Su1"><aaif:text>el tirifilo</aaif:text><aaif:position rdf:datatype="http://www.w3.org/2001/XMLSchema#int">1</aaif:position><aaif:gender rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Masculine" /><aaif:number rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Singular" /><aaif:overt rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</aaif:overt></aaif:Subject><aaif:Verb rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En1344Ph1Ve1"><aaif:text>pisando</aaif:text><aaif:lemma rdf:resource="https://gams.uni-graz.at/o:aaif.lemma#pisar" /><aaif:position rdf:datatype="http://www.w3.org/2001/XMLSchema#int">2</aaif:position><aaif:coordinated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:coordinated><aaif:partOfText rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</aaif:partOfText><aaif:syntacticConstruction rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Intransitive" /></aaif:Verb><aaif:Adverb rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En1344Ph1Ad1"><aaif:text>fuerte</aaif:text><aaif:lemma rdf:resource="https://gams.uni-graz.at/o:aaif.lemma#fuerte" /><aaif:position rdf:datatype="http://www.w3.org/2001/XMLSchema#int">3</aaif:position><aaif:coordinated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:coordinated><aaif:morphosyntacticStructure rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Adjective" /><aaif:inflection rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Uninflected" /><aaif:attributionTarget rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Verb" /><aaif:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:modified><aaif:semanticClassification rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Manner" /><aaif:reduplicated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:reduplicated><aaif:prepositionalPhrase rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:prepositionalPhrase></aaif:Adverb><aaif:Entry rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En1345"><aaif:phrase rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh#En1345Ph1" /><aaif:source rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh.bibl#Cnde403" /><gams:textualContent>en este punto me pareció que la vieja quería entrar a enojarse.Insinuó algunos pasos de cueca, zapateó fuerte , y plantándose luego delante del astrólogo le chantó la siguiente copla:</gams:textualContent><rel:isPartOf rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh" /></aaif:Entry><aaif:Phrase rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En1345Ph1"><aaif:verb rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh#En1345Ph1Ve1" /><aaif:adverb rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh#En1345Ph1Ad1" /><aaif:text>Insinuó algunos pasos de cueca, zapateó fuerte </aaif:text><aaif:annoText>Insinuó algunos pasos de cueca, [v|zapateó|zapatear|is] [a|fuerte|fuerte|auvnmnnn] </aaif:annoText></aaif:Phrase><aaif:Verb rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En1345Ph1Ve1"><aaif:text>zapateó</aaif:text><aaif:lemma rdf:resource="https://gams.uni-graz.at/o:aaif.lemma#zapatear" /><aaif:position rdf:datatype="http://www.w3.org/2001/XMLSchema#int">1</aaif:position><aaif:coordinated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:coordinated><aaif:partOfText rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</aaif:partOfText><aaif:syntacticConstruction rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Intransitive" /></aaif:Verb><aaif:Adverb rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En1345Ph1Ad1"><aaif:text>fuerte</aaif:text><aaif:lemma rdf:resource="https://gams.uni-graz.at/o:aaif.lemma#fuerte" /><aaif:position rdf:datatype="http://www.w3.org/2001/XMLSchema#int">2</aaif:position><aaif:coordinated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:coordinated><aaif:morphosyntacticStructure rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Adjective" /><aaif:inflection rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Uninflected" /><aaif:attributionTarget rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Verb" /><aaif:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:modified><aaif:semanticClassification rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Manner" /><aaif:reduplicated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:reduplicated><aaif:prepositionalPhrase rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:prepositionalPhrase></aaif:Adverb><aaif:Entry rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En1346"><aaif:phrase rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh#En1346Ph1" /><aaif:source rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh.bibl#Cnde403" /><gams:textualContent>toque.Pese a mi trasformación, yo conservaba todavía cierto dinamismo animal que me hacía erguir el busto, pisar fuerte y hablar sonoro , motas de imperfección que no escaparon ciertamente al ojo experto de mis inventores.José Antonio</gams:textualContent><rel:isPartOf rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh" /></aaif:Entry><aaif:Phrase rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En1346Ph1"><aaif:verb rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh#En1346Ph1Ve1" /><aaif:verb rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh#En1346Ph1Ve2" /><aaif:adverb rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh#En1346Ph1Ad1" /><aaif:adverb rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh#En1346Ph1Ad2" /><aaif:text>yo conservaba todavía cierto dinamismo animal que me hacía erguir el busto, pisar fuerte y hablar sonoro </aaif:text><aaif:annoText>yo conservaba todavía cierto dinamismo animal que me hacía erguir el busto, [v|pisar|pisar|is] [a|fuerte|fuerte|auvnmnnn] y [v|hablar|hablar|is] [a|sonoro|sonoro|auvnmnnn] </aaif:annoText></aaif:Phrase><aaif:Verb rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En1346Ph1Ve1"><aaif:text>pisar</aaif:text><aaif:lemma rdf:resource="https://gams.uni-graz.at/o:aaif.lemma#pisar" /><aaif:position rdf:datatype="http://www.w3.org/2001/XMLSchema#int">1</aaif:position><aaif:coordinated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:coordinated><aaif:partOfText rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</aaif:partOfText><aaif:syntacticConstruction rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Intransitive" /></aaif:Verb><aaif:Verb rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En1346Ph1Ve2"><aaif:text>hablar</aaif:text><aaif:lemma rdf:resource="https://gams.uni-graz.at/o:aaif.lemma#hablar" /><aaif:position rdf:datatype="http://www.w3.org/2001/XMLSchema#int">3</aaif:position><aaif:coordinated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:coordinated><aaif:partOfText rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</aaif:partOfText><aaif:syntacticConstruction rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Intransitive" /></aaif:Verb><aaif:Adverb rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En1346Ph1Ad1"><aaif:text>fuerte</aaif:text><aaif:lemma rdf:resource="https://gams.uni-graz.at/o:aaif.lemma#fuerte" /><aaif:position rdf:datatype="http://www.w3.org/2001/XMLSchema#int">2</aaif:position><aaif:coordinated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:coordinated><aaif:morphosyntacticStructure rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Adjective" /><aaif:inflection rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Uninflected" /><aaif:attributionTarget rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Verb" /><aaif:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:modified><aaif:semanticClassification rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Manner" /><aaif:reduplicated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:reduplicated><aaif:prepositionalPhrase rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:prepositionalPhrase></aaif:Adverb><aaif:Adverb rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En1346Ph1Ad2"><aaif:text>sonoro</aaif:text><aaif:lemma rdf:resource="https://gams.uni-graz.at/o:aaif.lemma#sonoro" /><aaif:position rdf:datatype="http://www.w3.org/2001/XMLSchema#int">4</aaif:position><aaif:coordinated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:coordinated><aaif:morphosyntacticStructure rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Adjective" /><aaif:inflection rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Uninflected" /><aaif:attributionTarget rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Verb" /><aaif:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:modified><aaif:semanticClassification rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Manner" /><aaif:reduplicated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:reduplicated><aaif:prepositionalPhrase rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:prepositionalPhrase></aaif:Adverb><aaif:Entry rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En1347"><aaif:phrase rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh#En1347Ph1" /><aaif:source rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh.bibl#Cnde404" /><gams:textualContent>, María Santísima!...Hace dos días fui a ponérselo en conocimiento a la señora Vaca Manuela, pero me echó juerte .Sólo a usté, me dijo, le puede caber en la cabeza que Machojón se aparezca onde queman</gams:textualContent><rel:isPartOf rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh" /></aaif:Entry><aaif:Phrase rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En1347Ph1"><aaif:verb rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh#En1347Ph1Ve1" /><aaif:adverb rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh#En1347Ph1Ad1" /><aaif:text>fui a ponérselo en conocimiento a la señora Vaca Manuela, pero me echó juerte </aaif:text><aaif:annoText>fui a ponérselo en conocimiento a la señora Vaca Manuela, pero me [v|echó|echar|ts] [a|juerte|fuerte|auvnmnnn] </aaif:annoText></aaif:Phrase><aaif:Verb rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En1347Ph1Ve1"><aaif:text>echó</aaif:text><aaif:lemma rdf:resource="https://gams.uni-graz.at/o:aaif.lemma#echar" /><aaif:position rdf:datatype="http://www.w3.org/2001/XMLSchema#int">1</aaif:position><aaif:coordinated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:coordinated><aaif:partOfText rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</aaif:partOfText><aaif:syntacticConstruction rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Transitive" /></aaif:Verb><aaif:Adverb rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En1347Ph1Ad1"><aaif:text>juerte</aaif:text><aaif:lemma rdf:resource="https://gams.uni-graz.at/o:aaif.lemma#fuerte" /><aaif:position rdf:datatype="http://www.w3.org/2001/XMLSchema#int">2</aaif:position><aaif:coordinated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:coordinated><aaif:morphosyntacticStructure rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Adjective" /><aaif:inflection rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Uninflected" /><aaif:attributionTarget rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Verb" /><aaif:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:modified><aaif:semanticClassification rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Manner" /><aaif:reduplicated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:reduplicated><aaif:prepositionalPhrase rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:prepositionalPhrase></aaif:Adverb><aaif:Entry rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En1348"><aaif:phrase rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh#En1348Ph1" /><aaif:source rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh.bibl#Cnde404" /><gams:textualContent> Mincho Lobos , a pesar de su flojera de hombre pacífico y bondadoso, hombre quitado de ruidos, se alegó fuerte con el maestro escultor, un caballero pálido, melenudo, una ceja sobre el labio en forma de bigote</gams:textualContent><rel:isPartOf rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh" /></aaif:Entry><aaif:Phrase rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En1348Ph1"><aaif:subject rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh#En1348Ph1Su1" /><aaif:verb rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh#En1348Ph1Ve1" /><aaif:adverb rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh#En1348Ph1Ad1" /><aaif:text> Mincho Lobos , a pesar de su flojera de hombre pacífico y bondadoso, hombre quitado de ruidos, se alegó fuerte con el maestro escultor</aaif:text><aaif:annoText> [s|Mincho Lobos|ms] , a pesar de su flojera de hombre pacífico y bondadoso, hombre quitado de ruidos, se [v|alegó|alegar|rs] [a|fuerte|fuerte|auvnmnnn] con el maestro escultor</aaif:annoText></aaif:Phrase><aaif:Subject rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En1348Ph1Su1"><aaif:text>Mincho Lobos</aaif:text><aaif:position rdf:datatype="http://www.w3.org/2001/XMLSchema#int">1</aaif:position><aaif:gender rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Masculine" /><aaif:number rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Singular" /><aaif:overt rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</aaif:overt></aaif:Subject><aaif:Verb rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En1348Ph1Ve1"><aaif:text>alegó</aaif:text><aaif:lemma rdf:resource="https://gams.uni-graz.at/o:aaif.lemma#alegar" /><aaif:position rdf:datatype="http://www.w3.org/2001/XMLSchema#int">2</aaif:position><aaif:coordinated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:coordinated><aaif:partOfText rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</aaif:partOfText><aaif:syntacticConstruction rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Reflexive" /></aaif:Verb><aaif:Adverb rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En1348Ph1Ad1"><aaif:text>fuerte</aaif:text><aaif:lemma rdf:resource="https://gams.uni-graz.at/o:aaif.lemma#fuerte" /><aaif:position rdf:datatype="http://www.w3.org/2001/XMLSchema#int">3</aaif:position><aaif:coordinated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:coordinated><aaif:morphosyntacticStructure rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Adjective" /><aaif:inflection rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Uninflected" /><aaif:attributionTarget rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Verb" /><aaif:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:modified><aaif:semanticClassification rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Manner" /><aaif:reduplicated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:reduplicated><aaif:prepositionalPhrase rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:prepositionalPhrase></aaif:Adverb><aaif:Entry rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En1349"><aaif:phrase rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh#En1349Ph1" /><aaif:source rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh.bibl#Cnde404" /><gams:textualContent>l ir asomando el sol que no llegó a lucir bien, por una lluvia menuda que empezó a pegar fuerte .¡Adiós!, le gritaron a la niña Candelaria, desde la puerta de trancas, mas nadie</gams:textualContent><rel:isPartOf rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh" /></aaif:Entry><aaif:Phrase rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En1349Ph1"><aaif:verb rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh#En1349Ph1Ve1" /><aaif:adverb rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh#En1349Ph1Ad1" /><aaif:text>el sol que no llegó a lucir bien, por una lluvia menuda que empezó a pegar fuerte </aaif:text><aaif:annoText>el sol que no llegó a lucir bien, por una lluvia menuda que empezó a [v|pegar|pegar|is] [a|fuerte|fuerte|auvnmnnn] </aaif:annoText></aaif:Phrase><aaif:Verb rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En1349Ph1Ve1"><aaif:text>pegar</aaif:text><aaif:lemma rdf:resource="https://gams.uni-graz.at/o:aaif.lemma#pegar" /><aaif:position rdf:datatype="http://www.w3.org/2001/XMLSchema#int">1</aaif:position><aaif:coordinated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:coordinated><aaif:partOfText rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</aaif:partOfText><aaif:syntacticConstruction rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Intransitive" /></aaif:Verb><aaif:Adverb rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En1349Ph1Ad1"><aaif:text>fuerte</aaif:text><aaif:lemma rdf:resource="https://gams.uni-graz.at/o:aaif.lemma#fuerte" /><aaif:position rdf:datatype="http://www.w3.org/2001/XMLSchema#int">2</aaif:position><aaif:coordinated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:coordinated><aaif:morphosyntacticStructure rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Adjective" /><aaif:inflection rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Uninflected" /><aaif:attributionTarget rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Verb" /><aaif:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:modified><aaif:semanticClassification rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Manner" /><aaif:reduplicated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:reduplicated><aaif:prepositionalPhrase rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:prepositionalPhrase></aaif:Adverb><aaif:Entry rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En1350"><aaif:phrase rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh#En1350Ph1" /><aaif:source rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh.bibl#Cnde46" /><gams:textualContent>;ni rastros de preocupación quedaban en mí: salí silbando de la casa y pasé ante el zapatero pisando fuerte ;bajé la calle, me dirigí hacia el centro, fui a tomarme una cerveza, puse un tango</gams:textualContent><rel:isPartOf rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh" /></aaif:Entry><aaif:Phrase rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En1350Ph1"><aaif:verb rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh#En1350Ph1Ve1" /><aaif:adverb rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh#En1350Ph1Ad1" /><aaif:text>salí silbando de la casa y pasé ante el zapatero pisando fuerte </aaif:text><aaif:annoText>salí silbando de la casa y pasé ante el zapatero [v|pisando|pisar|is] [a|fuerte|fuerte|auvnmnnn] </aaif:annoText></aaif:Phrase><aaif:Verb rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En1350Ph1Ve1"><aaif:text>pisando</aaif:text><aaif:lemma rdf:resource="https://gams.uni-graz.at/o:aaif.lemma#pisar" /><aaif:position rdf:datatype="http://www.w3.org/2001/XMLSchema#int">1</aaif:position><aaif:coordinated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:coordinated><aaif:partOfText rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</aaif:partOfText><aaif:syntacticConstruction rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Intransitive" /></aaif:Verb><aaif:Adverb rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En1350Ph1Ad1"><aaif:text>fuerte</aaif:text><aaif:lemma rdf:resource="https://gams.uni-graz.at/o:aaif.lemma#fuerte" /><aaif:position rdf:datatype="http://www.w3.org/2001/XMLSchema#int">2</aaif:position><aaif:coordinated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:coordinated><aaif:morphosyntacticStructure rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Adjective" /><aaif:inflection rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Uninflected" /><aaif:attributionTarget rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Verb" /><aaif:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:modified><aaif:semanticClassification rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Manner" /><aaif:reduplicated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:reduplicated><aaif:prepositionalPhrase rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:prepositionalPhrase></aaif:Adverb><aaif:Entry rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En1351"><aaif:phrase rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh#En1351Ph1" /><aaif:source rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh.bibl#Cnde186" /><gams:textualContent>Venían así aquella noche los del grupito, pisando fuerte y mirando a las mujeres con aire de jaquetones.Buscaron mesa y se sentaron cerca de la mía,</gams:textualContent><rel:isPartOf rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh" /></aaif:Entry><aaif:Phrase rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En1351Ph1"><aaif:verb rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh#En1351Ph1Ve1" /><aaif:adverb rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh#En1351Ph1Ad1" /><aaif:text>Venían así aquella noche los del grupito, pisando fuerte y mirando a las mujeres con aire de jaquetones</aaif:text><aaif:annoText>Venían así aquella noche los del grupito, [v|pisando|pisar|is] [a|fuerte|fuerte|auvnmnnn] y mirando a las mujeres con aire de jaquetones</aaif:annoText></aaif:Phrase><aaif:Verb rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En1351Ph1Ve1"><aaif:text>pisando</aaif:text><aaif:lemma rdf:resource="https://gams.uni-graz.at/o:aaif.lemma#pisar" /><aaif:position rdf:datatype="http://www.w3.org/2001/XMLSchema#int">1</aaif:position><aaif:coordinated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:coordinated><aaif:partOfText rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</aaif:partOfText><aaif:syntacticConstruction rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Intransitive" /></aaif:Verb><aaif:Adverb rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En1351Ph1Ad1"><aaif:text>fuerte</aaif:text><aaif:lemma rdf:resource="https://gams.uni-graz.at/o:aaif.lemma#fuerte" /><aaif:position rdf:datatype="http://www.w3.org/2001/XMLSchema#int">2</aaif:position><aaif:coordinated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:coordinated><aaif:morphosyntacticStructure rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Adjective" /><aaif:inflection rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Uninflected" /><aaif:attributionTarget rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Verb" /><aaif:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:modified><aaif:semanticClassification rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Manner" /><aaif:reduplicated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:reduplicated><aaif:prepositionalPhrase rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:prepositionalPhrase></aaif:Adverb><aaif:Entry rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En1352"><aaif:phrase rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh#En1352Ph1" /><aaif:source rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh.bibl#Cnde186" /><gams:textualContent>cocido.Tanto lo miré, que el pollo se arreglaba sin cesar el nudo de la corbata y hablaba fuerte , dedicándome sus gracias y animando su boca consumida, hundida entre su nariz y su barbilla, con una</gams:textualContent><rel:isPartOf rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh" /></aaif:Entry><aaif:Phrase rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En1352Ph1"><aaif:subject rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh#En1352Ph1Su1" /><aaif:verb rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh#En1352Ph1Ve1" /><aaif:adverb rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh#En1352Ph1Ad1" /><aaif:text>Tanto lo miré, que el pollo se arreglaba sin cesar el nudo de la corbata y hablaba fuerte </aaif:text><aaif:annoText>Tanto lo miré, que [s|el pollo|ms] se arreglaba sin cesar el nudo de la corbata y [v|hablaba|hablar|is] [a|fuerte|fuerte|auvnmnnn] </aaif:annoText></aaif:Phrase><aaif:Subject rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En1352Ph1Su1"><aaif:text>el pollo</aaif:text><aaif:position rdf:datatype="http://www.w3.org/2001/XMLSchema#int">1</aaif:position><aaif:gender rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Masculine" /><aaif:number rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Singular" /><aaif:overt rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</aaif:overt></aaif:Subject><aaif:Verb rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En1352Ph1Ve1"><aaif:text>hablaba</aaif:text><aaif:lemma rdf:resource="https://gams.uni-graz.at/o:aaif.lemma#hablar" /><aaif:position rdf:datatype="http://www.w3.org/2001/XMLSchema#int">2</aaif:position><aaif:coordinated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:coordinated><aaif:partOfText rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</aaif:partOfText><aaif:syntacticConstruction rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Intransitive" /></aaif:Verb><aaif:Adverb rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En1352Ph1Ad1"><aaif:text>fuerte</aaif:text><aaif:lemma rdf:resource="https://gams.uni-graz.at/o:aaif.lemma#fuerte" /><aaif:position rdf:datatype="http://www.w3.org/2001/XMLSchema#int">3</aaif:position><aaif:coordinated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:coordinated><aaif:morphosyntacticStructure rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Adjective" /><aaif:inflection rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Uninflected" /><aaif:attributionTarget rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Verb" /><aaif:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:modified><aaif:semanticClassification rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Manner" /><aaif:reduplicated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:reduplicated><aaif:prepositionalPhrase rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:prepositionalPhrase></aaif:Adverb><aaif:Entry rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En1353"><aaif:phrase rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh#En1353Ph1" /><aaif:source rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh.bibl#Cnde406" /><gams:textualContent>¿Dónde ha visto usted que un hombre sin cultura y sin principios ande por ahí, tosiendo y pisando fuerte  como un señorito?¡No seré yo quien lo vea, se lo juro!</gams:textualContent><rel:isPartOf rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh" /></aaif:Entry><aaif:Phrase rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En1353Ph1"><aaif:verb rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh#En1353Ph1Ve1" /><aaif:verb rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh#En1353Ph1Ve2" /><aaif:adverb rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh#En1353Ph1Ad1" /><aaif:text>un hombre sin cultura y sin principios ande por ahí, tosiendo y pisando fuerte </aaif:text><aaif:annoText>un hombre sin cultura y sin principios ande por ahí, [v|tosiendo|toser|is] y [v|pisando|pisar|is] [a|fuerte|fuerte|auvnmnnn] </aaif:annoText></aaif:Phrase><aaif:Verb rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En1353Ph1Ve1"><aaif:text>tosiendo</aaif:text><aaif:lemma rdf:resource="https://gams.uni-graz.at/o:aaif.lemma#toser" /><aaif:position rdf:datatype="http://www.w3.org/2001/XMLSchema#int">1</aaif:position><aaif:coordinated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</aaif:coordinated><aaif:partOfText rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</aaif:partOfText><aaif:syntacticConstruction rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Intransitive" /></aaif:Verb><aaif:Verb rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En1353Ph1Ve2"><aaif:text>pisando</aaif:text><aaif:lemma rdf:resource="https://gams.uni-graz.at/o:aaif.lemma#pisar" /><aaif:position rdf:datatype="http://www.w3.org/2001/XMLSchema#int">2</aaif:position><aaif:coordinated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</aaif:coordinated><aaif:partOfText rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</aaif:partOfText><aaif:syntacticConstruction rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Intransitive" /></aaif:Verb><aaif:Adverb rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En1353Ph1Ad1"><aaif:text>fuerte</aaif:text><aaif:lemma rdf:resource="https://gams.uni-graz.at/o:aaif.lemma#fuerte" /><aaif:position rdf:datatype="http://www.w3.org/2001/XMLSchema#int">3</aaif:position><aaif:coordinated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:coordinated><aaif:morphosyntacticStructure rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Adjective" /><aaif:inflection rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Uninflected" /><aaif:attributionTarget rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Verb" /><aaif:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:modified><aaif:semanticClassification rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Manner" /><aaif:reduplicated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:reduplicated><aaif:prepositionalPhrase rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:prepositionalPhrase></aaif:Adverb><aaif:Entry rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En1354"><aaif:phrase rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh#En1354Ph1" /><aaif:source rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh.bibl#Cnde406" /><gams:textualContent>Martín Marco chupó del pitillo casi con majestad.Después respiró fuerte .</gams:textualContent><rel:isPartOf rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh" /></aaif:Entry><aaif:Phrase rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En1354Ph1"><aaif:verb rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh#En1354Ph1Ve1" /><aaif:adverb rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh#En1354Ph1Ad1" /><aaif:text>Después respiró fuerte </aaif:text><aaif:annoText>Después [v|respiró|respirar|is] [a|fuerte|fuerte|auvnmnnn] </aaif:annoText></aaif:Phrase><aaif:Verb rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En1354Ph1Ve1"><aaif:text>respiró</aaif:text><aaif:lemma rdf:resource="https://gams.uni-graz.at/o:aaif.lemma#respirar" /><aaif:position rdf:datatype="http://www.w3.org/2001/XMLSchema#int">1</aaif:position><aaif:coordinated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:coordinated><aaif:partOfText rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</aaif:partOfText><aaif:syntacticConstruction rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Intransitive" /></aaif:Verb><aaif:Adverb rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En1354Ph1Ad1"><aaif:text>fuerte</aaif:text><aaif:lemma rdf:resource="https://gams.uni-graz.at/o:aaif.lemma#fuerte" /><aaif:position rdf:datatype="http://www.w3.org/2001/XMLSchema#int">2</aaif:position><aaif:coordinated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:coordinated><aaif:morphosyntacticStructure rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Adjective" /><aaif:inflection rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Uninflected" /><aaif:attributionTarget rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Verb" /><aaif:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:modified><aaif:semanticClassification rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Manner" /><aaif:reduplicated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:reduplicated><aaif:prepositionalPhrase rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:prepositionalPhrase></aaif:Adverb><aaif:Entry rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En1355"><aaif:phrase rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh#En1355Ph1" /><aaif:source rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh.bibl#Cnde524" /><gams:textualContent>Y ahora a trabajar fuerte para pagar esta deuda.Nada de pensar en poesías ni viajes a Buenos Aires...— Y para suavizar agregó</gams:textualContent><rel:isPartOf rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh" /></aaif:Entry><aaif:Phrase rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En1355Ph1"><aaif:verb rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh#En1355Ph1Ve1" /><aaif:adverb rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh#En1355Ph1Ad1" /><aaif:text>Y ahora a trabajar fuerte para pagar esta deuda</aaif:text><aaif:annoText>Y ahora a [v|trabajar|trabajar|is] [a|fuerte|fuerte|auvnmnnn] para pagar esta deuda</aaif:annoText></aaif:Phrase><aaif:Verb rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En1355Ph1Ve1"><aaif:text>trabajar</aaif:text><aaif:lemma rdf:resource="https://gams.uni-graz.at/o:aaif.lemma#trabajar" /><aaif:position rdf:datatype="http://www.w3.org/2001/XMLSchema#int">1</aaif:position><aaif:coordinated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:coordinated><aaif:partOfText rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</aaif:partOfText><aaif:syntacticConstruction rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Intransitive" /></aaif:Verb><aaif:Adverb rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En1355Ph1Ad1"><aaif:text>fuerte</aaif:text><aaif:lemma rdf:resource="https://gams.uni-graz.at/o:aaif.lemma#fuerte" /><aaif:position rdf:datatype="http://www.w3.org/2001/XMLSchema#int">2</aaif:position><aaif:coordinated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:coordinated><aaif:morphosyntacticStructure rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Adjective" /><aaif:inflection rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Uninflected" /><aaif:attributionTarget rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Verb" /><aaif:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:modified><aaif:semanticClassification rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Manner" /><aaif:reduplicated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:reduplicated><aaif:prepositionalPhrase rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:prepositionalPhrase></aaif:Adverb><aaif:Entry rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En1356"><aaif:phrase rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh#En1356Ph1" /><aaif:source rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh.bibl#Cnde407" /><gams:textualContent>De vez en cuando, también, venían los cuervos * volando muy bajito y graznando fuerte  como si creyeran estar en algún lugar deshabitado</gams:textualContent><rel:isPartOf rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh" /></aaif:Entry><aaif:Phrase rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En1356Ph1"><aaif:verb rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh#En1356Ph1Ve1" /><aaif:verb rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh#En1356Ph1Ve2" /><aaif:adverb rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh#En1356Ph1Ad1" /><aaif:adverb rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh#En1356Ph1Ad2" /><aaif:text>venían los cuervos * volando muy bajito y graznando fuerte </aaif:text><aaif:annoText>venían los cuervos * [v|volando|volar|is] muy [a|bajito|bajo|auvmmnnn] y [v|graznando|graznar|is] [a|fuerte|fuerte|auvnmnnn] </aaif:annoText></aaif:Phrase><aaif:Verb rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En1356Ph1Ve1"><aaif:text>volando</aaif:text><aaif:lemma rdf:resource="https://gams.uni-graz.at/o:aaif.lemma#volar" /><aaif:position rdf:datatype="http://www.w3.org/2001/XMLSchema#int">1</aaif:position><aaif:coordinated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:coordinated><aaif:partOfText rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</aaif:partOfText><aaif:syntacticConstruction rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Intransitive" /></aaif:Verb><aaif:Verb rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En1356Ph1Ve2"><aaif:text>graznando</aaif:text><aaif:lemma rdf:resource="https://gams.uni-graz.at/o:aaif.lemma#graznar" /><aaif:position rdf:datatype="http://www.w3.org/2001/XMLSchema#int">3</aaif:position><aaif:coordinated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:coordinated><aaif:partOfText rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</aaif:partOfText><aaif:syntacticConstruction rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Intransitive" /></aaif:Verb><aaif:Adverb rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En1356Ph1Ad1"><aaif:text>bajito</aaif:text><aaif:lemma rdf:resource="https://gams.uni-graz.at/o:aaif.lemma#bajo" /><aaif:position rdf:datatype="http://www.w3.org/2001/XMLSchema#int">2</aaif:position><aaif:coordinated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:coordinated><aaif:morphosyntacticStructure rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Adjective" /><aaif:inflection rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Uninflected" /><aaif:attributionTarget rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Verb" /><aaif:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</aaif:modified><aaif:semanticClassification rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Manner" /><aaif:reduplicated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:reduplicated><aaif:prepositionalPhrase rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:prepositionalPhrase></aaif:Adverb><aaif:Adverb rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En1356Ph1Ad2"><aaif:text>fuerte</aaif:text><aaif:lemma rdf:resource="https://gams.uni-graz.at/o:aaif.lemma#fuerte" /><aaif:position rdf:datatype="http://www.w3.org/2001/XMLSchema#int">4</aaif:position><aaif:coordinated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:coordinated><aaif:morphosyntacticStructure rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Adjective" /><aaif:inflection rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Uninflected" /><aaif:attributionTarget rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Verb" /><aaif:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:modified><aaif:semanticClassification rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Manner" /><aaif:reduplicated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:reduplicated><aaif:prepositionalPhrase rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:prepositionalPhrase></aaif:Adverb><aaif:Entry rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En1357"><aaif:phrase rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh#En1357Ph1" /><aaif:source rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh.bibl#Cnde407" /><gams:textualContent>Nos quedamos agazapados detrás de unas piedras grandes y boludas, todavía resollando fuerte  por la carrera.Solamente mirábamos a Pedro Zamora preguntándole con los ojos qué era * lo que nos habrá pasado</gams:textualContent><rel:isPartOf rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh" /></aaif:Entry><aaif:Phrase rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En1357Ph1"><aaif:verb rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh#En1357Ph1Ve1" /><aaif:adverb rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh#En1357Ph1Ad1" /><aaif:text>todavía resollando fuerte </aaif:text><aaif:annoText>todavía [v|resollando|resollar|is] [a|fuerte|fuerte|auvnmnnn] </aaif:annoText></aaif:Phrase><aaif:Verb rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En1357Ph1Ve1"><aaif:text>resollando</aaif:text><aaif:lemma rdf:resource="https://gams.uni-graz.at/o:aaif.lemma#resollar" /><aaif:position rdf:datatype="http://www.w3.org/2001/XMLSchema#int">1</aaif:position><aaif:coordinated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:coordinated><aaif:partOfText rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</aaif:partOfText><aaif:syntacticConstruction rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Intransitive" /></aaif:Verb><aaif:Adverb rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En1357Ph1Ad1"><aaif:text>fuerte</aaif:text><aaif:lemma rdf:resource="https://gams.uni-graz.at/o:aaif.lemma#fuerte" /><aaif:position rdf:datatype="http://www.w3.org/2001/XMLSchema#int">2</aaif:position><aaif:coordinated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:coordinated><aaif:morphosyntacticStructure rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Adjective" /><aaif:inflection rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Uninflected" /><aaif:attributionTarget rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Verb" /><aaif:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:modified><aaif:semanticClassification rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Manner" /><aaif:reduplicated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:reduplicated><aaif:prepositionalPhrase rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:prepositionalPhrase></aaif:Adverb><aaif:Entry rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En1358"><aaif:phrase rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh#En1358Ph1" /><aaif:source rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh.bibl#Cnde407" /><gams:textualContent>se * salta el codo.Por eso lo agarré con la mano buena y le dije: “ Agárrate  fuerte de aquí” Y se me murió en la orilla, frente a las luces de un lugar que le</gams:textualContent><rel:isPartOf rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh" /></aaif:Entry><aaif:Phrase rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En1358Ph1"><aaif:verb rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh#En1358Ph1Ve1" /><aaif:adverb rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh#En1358Ph1Ad1" /><aaif:text> Agárrate  fuerte de aquí</aaif:text><aaif:annoText> [v|Agárrate|agarrar|rs]  [a|fuerte|fuerte|auvnmnnn] de aquí</aaif:annoText></aaif:Phrase><aaif:Verb rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En1358Ph1Ve1"><aaif:text>Agárrate</aaif:text><aaif:lemma rdf:resource="https://gams.uni-graz.at/o:aaif.lemma#agarrar" /><aaif:position rdf:datatype="http://www.w3.org/2001/XMLSchema#int">1</aaif:position><aaif:coordinated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:coordinated><aaif:partOfText rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</aaif:partOfText><aaif:syntacticConstruction rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Reflexive" /></aaif:Verb><aaif:Adverb rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En1358Ph1Ad1"><aaif:text>fuerte</aaif:text><aaif:lemma rdf:resource="https://gams.uni-graz.at/o:aaif.lemma#fuerte" /><aaif:position rdf:datatype="http://www.w3.org/2001/XMLSchema#int">2</aaif:position><aaif:coordinated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:coordinated><aaif:morphosyntacticStructure rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Adjective" /><aaif:inflection rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Uninflected" /><aaif:attributionTarget rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Verb" /><aaif:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:modified><aaif:semanticClassification rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Manner" /><aaif:reduplicated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:reduplicated><aaif:prepositionalPhrase rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:prepositionalPhrase></aaif:Adverb><aaif:Entry rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En1359"><aaif:phrase rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh#En1359Ph1" /><aaif:source rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh.bibl#Cnde407" /><gams:textualContent>al arpa y a la tambora, haciendo tatachum, chum, chum, con los platillos,  arreándole  fuerte y con ganas al Zopilote mojado.Aquello estaba de haberse visto, hasta el gobernador se quitó el</gams:textualContent><rel:isPartOf rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh" /></aaif:Entry><aaif:Phrase rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En1359Ph1"><aaif:verb rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh#En1359Ph1Ve1" /><aaif:adverb rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh#En1359Ph1Ad1" /><aaif:text> arreándole  fuerte y con ganas al Zopilote mojado</aaif:text><aaif:annoText> [v|arreándole|arrear|ts]  [a|fuerte|fuerte|auvnmnnn] y con ganas al Zopilote mojado</aaif:annoText></aaif:Phrase><aaif:Verb rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En1359Ph1Ve1"><aaif:text>arreándole</aaif:text><aaif:lemma rdf:resource="https://gams.uni-graz.at/o:aaif.lemma#arrear" /><aaif:position rdf:datatype="http://www.w3.org/2001/XMLSchema#int">1</aaif:position><aaif:coordinated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:coordinated><aaif:partOfText rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</aaif:partOfText><aaif:syntacticConstruction rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Transitive" /></aaif:Verb><aaif:Adverb rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En1359Ph1Ad1"><aaif:text>fuerte</aaif:text><aaif:lemma rdf:resource="https://gams.uni-graz.at/o:aaif.lemma#fuerte" /><aaif:position rdf:datatype="http://www.w3.org/2001/XMLSchema#int">2</aaif:position><aaif:coordinated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:coordinated><aaif:morphosyntacticStructure rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Adjective" /><aaif:inflection rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Uninflected" /><aaif:attributionTarget rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Verb" /><aaif:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:modified><aaif:semanticClassification rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Manner" /><aaif:reduplicated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:reduplicated><aaif:prepositionalPhrase rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:prepositionalPhrase></aaif:Adverb><aaif:Entry rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En1360"><aaif:phrase rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh#En1360Ph1" /><aaif:source rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh.bibl#Cnde525" /><gams:textualContent>capital y los grupos de la costa.Fui capturado una sola vez, pero me bastó.Me pegaron fuerte .Después de la guerra tuvieron que hacerme...una delicada operación.Y me ha quedado un bonito recuerdo</gams:textualContent><rel:isPartOf rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh" /></aaif:Entry><aaif:Phrase rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En1360Ph1"><aaif:verb rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh#En1360Ph1Ve1" /><aaif:adverb rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh#En1360Ph1Ad1" /><aaif:text>Me pegaron fuerte </aaif:text><aaif:annoText>Me [v|pegaron|pegar|ts] [a|fuerte|fuerte|auvnmnnn] </aaif:annoText></aaif:Phrase><aaif:Verb rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En1360Ph1Ve1"><aaif:text>pegaron</aaif:text><aaif:lemma rdf:resource="https://gams.uni-graz.at/o:aaif.lemma#pegar" /><aaif:position rdf:datatype="http://www.w3.org/2001/XMLSchema#int">1</aaif:position><aaif:coordinated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:coordinated><aaif:partOfText rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</aaif:partOfText><aaif:syntacticConstruction rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Transitive" /></aaif:Verb><aaif:Adverb rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En1360Ph1Ad1"><aaif:text>fuerte</aaif:text><aaif:lemma rdf:resource="https://gams.uni-graz.at/o:aaif.lemma#fuerte" /><aaif:position rdf:datatype="http://www.w3.org/2001/XMLSchema#int">2</aaif:position><aaif:coordinated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:coordinated><aaif:morphosyntacticStructure rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Adjective" /><aaif:inflection rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Uninflected" /><aaif:attributionTarget rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Verb" /><aaif:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:modified><aaif:semanticClassification rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Manner" /><aaif:reduplicated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:reduplicated><aaif:prepositionalPhrase rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:prepositionalPhrase></aaif:Adverb><aaif:Entry rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En1361"><aaif:phrase rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh#En1361Ph1" /><aaif:source rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh.bibl#Cnde526" /><gams:textualContent>Agarre el remo, babosada, y métale juerte , si no quiere que lo pescoceye!</gams:textualContent><rel:isPartOf rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh" /></aaif:Entry><aaif:Phrase rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En1361Ph1"><aaif:verb rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh#En1361Ph1Ve1" /><aaif:adverb rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh#En1361Ph1Ad1" /><aaif:text>Agarre el remo, babosada, y métale juerte </aaif:text><aaif:annoText>Agarre el remo, babosada, y [v|métale|meter|is] [a|juerte|fuerte|auvnmnnn] </aaif:annoText></aaif:Phrase><aaif:Verb rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En1361Ph1Ve1"><aaif:text>métale</aaif:text><aaif:lemma rdf:resource="https://gams.uni-graz.at/o:aaif.lemma#meter" /><aaif:position rdf:datatype="http://www.w3.org/2001/XMLSchema#int">1</aaif:position><aaif:coordinated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:coordinated><aaif:partOfText rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</aaif:partOfText><aaif:syntacticConstruction rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Intransitive" /></aaif:Verb><aaif:Adverb rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En1361Ph1Ad1"><aaif:text>juerte</aaif:text><aaif:lemma rdf:resource="https://gams.uni-graz.at/o:aaif.lemma#fuerte" /><aaif:position rdf:datatype="http://www.w3.org/2001/XMLSchema#int">2</aaif:position><aaif:coordinated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:coordinated><aaif:morphosyntacticStructure rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Adjective" /><aaif:inflection rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Uninflected" /><aaif:attributionTarget rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Verb" /><aaif:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:modified><aaif:semanticClassification rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Manner" /><aaif:reduplicated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:reduplicated><aaif:prepositionalPhrase rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:prepositionalPhrase></aaif:Adverb><aaif:Entry rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En1362"><aaif:phrase rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh#En1362Ph1" /><aaif:source rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh.bibl#Cnde287" /><gams:textualContent>manos sobre los hombros de Susana San Juan, con su boca casi pegada a la oreja de ella para no hablar fuerte , encajaba secretamente cada una de sus palabras: “Tengo la boca llena de tierra”.Luego se</gams:textualContent><rel:isPartOf rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh" /></aaif:Entry><aaif:Phrase rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En1362Ph1"><aaif:verb rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh#En1362Ph1Ve1" /><aaif:adverb rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh#En1362Ph1Ad1" /><aaif:text>para no hablar fuerte </aaif:text><aaif:annoText>para no [v|hablar|hablar|is] [a|fuerte|fuerte|auvnmnnn] </aaif:annoText></aaif:Phrase><aaif:Verb rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En1362Ph1Ve1"><aaif:text>hablar</aaif:text><aaif:lemma rdf:resource="https://gams.uni-graz.at/o:aaif.lemma#hablar" /><aaif:position rdf:datatype="http://www.w3.org/2001/XMLSchema#int">1</aaif:position><aaif:coordinated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:coordinated><aaif:partOfText rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</aaif:partOfText><aaif:syntacticConstruction rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Intransitive" /></aaif:Verb><aaif:Adverb rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En1362Ph1Ad1"><aaif:text>fuerte</aaif:text><aaif:lemma rdf:resource="https://gams.uni-graz.at/o:aaif.lemma#fuerte" /><aaif:position rdf:datatype="http://www.w3.org/2001/XMLSchema#int">2</aaif:position><aaif:coordinated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:coordinated><aaif:morphosyntacticStructure rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Adjective" /><aaif:inflection rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Uninflected" /><aaif:attributionTarget rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Verb" /><aaif:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:modified><aaif:semanticClassification rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Manner" /><aaif:reduplicated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:reduplicated><aaif:prepositionalPhrase rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:prepositionalPhrase></aaif:Adverb><aaif:Entry rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En1363"><aaif:phrase rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh#En1363Ph1" /><aaif:source rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh.bibl#Cnde408" /><gams:textualContent>dije yo con vivo interés.«Ninguno, ¡no lo sentiría!A ver, Alberto, pellízcame fuerte en cualquier parte —dijo, y volviéndose hacia mí—, mire usted bien en qué sitio me pellizca</gams:textualContent><rel:isPartOf rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh" /></aaif:Entry><aaif:Phrase rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En1363Ph1"><aaif:verb rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh#En1363Ph1Ve1" /><aaif:adverb rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh#En1363Ph1Ad1" /><aaif:text>A ver, Alberto, pellízcame fuerte en cualquier parte</aaif:text><aaif:annoText>A ver, Alberto, [v|pellízcame|pellizcar|is] [a|fuerte|fuerte|auvnmnnn] en cualquier parte</aaif:annoText></aaif:Phrase><aaif:Verb rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En1363Ph1Ve1"><aaif:text>pellízcame</aaif:text><aaif:lemma rdf:resource="https://gams.uni-graz.at/o:aaif.lemma#pellizcar" /><aaif:position rdf:datatype="http://www.w3.org/2001/XMLSchema#int">1</aaif:position><aaif:coordinated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:coordinated><aaif:partOfText rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</aaif:partOfText><aaif:syntacticConstruction rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Intransitive" /></aaif:Verb><aaif:Adverb rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En1363Ph1Ad1"><aaif:text>fuerte</aaif:text><aaif:lemma rdf:resource="https://gams.uni-graz.at/o:aaif.lemma#fuerte" /><aaif:position rdf:datatype="http://www.w3.org/2001/XMLSchema#int">2</aaif:position><aaif:coordinated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:coordinated><aaif:morphosyntacticStructure rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Adjective" /><aaif:inflection rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Uninflected" /><aaif:attributionTarget rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Verb" /><aaif:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:modified><aaif:semanticClassification rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Manner" /><aaif:reduplicated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:reduplicated><aaif:prepositionalPhrase rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:prepositionalPhrase></aaif:Adverb><aaif:Entry rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En1364"><aaif:phrase rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh#En1364Ph1" /><aaif:source rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh.bibl#Cnde527" /><gams:textualContent>al señor cura un agasajo de truchas que pescara José del Cairo en los molinos viejos del Pontigo. Llamaron  fuerte en el portalón, salí corriendo del horno, que estaba dándole una merienda de moscas al cornudo</gams:textualContent><rel:isPartOf rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh" /></aaif:Entry><aaif:Phrase rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En1364Ph1"><aaif:verb rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh#En1364Ph1Ve1" /><aaif:adverb rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh#En1364Ph1Ad1" /><aaif:text> Llamaron  fuerte en el portalón</aaif:text><aaif:annoText> [v|Llamaron|llamar|is]  [a|fuerte|fuerte|auvnmnnn] en el portalón</aaif:annoText></aaif:Phrase><aaif:Verb rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En1364Ph1Ve1"><aaif:text>Llamaron</aaif:text><aaif:lemma rdf:resource="https://gams.uni-graz.at/o:aaif.lemma#llamar" /><aaif:position rdf:datatype="http://www.w3.org/2001/XMLSchema#int">1</aaif:position><aaif:coordinated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:coordinated><aaif:partOfText rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</aaif:partOfText><aaif:syntacticConstruction rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Intransitive" /></aaif:Verb><aaif:Adverb rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En1364Ph1Ad1"><aaif:text>fuerte</aaif:text><aaif:lemma rdf:resource="https://gams.uni-graz.at/o:aaif.lemma#fuerte" /><aaif:position rdf:datatype="http://www.w3.org/2001/XMLSchema#int">2</aaif:position><aaif:coordinated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:coordinated><aaif:morphosyntacticStructure rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Adjective" /><aaif:inflection rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Uninflected" /><aaif:attributionTarget rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Verb" /><aaif:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:modified><aaif:semanticClassification rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Manner" /><aaif:reduplicated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:reduplicated><aaif:prepositionalPhrase rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:prepositionalPhrase></aaif:Adverb><aaif:Entry rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En1365"><aaif:phrase rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh#En1365Ph1" /><aaif:source rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh.bibl#Cnde409" /><gams:textualContent>“ que Nietzsche descubrió en la raíz de la tragedia griega.Pecca fortiter sed fide fortius, “ peca fuerte y confía más fuerte ”, dijo Lutero.Esto es: cultiva en el centro de tu alma la</gams:textualContent><rel:isPartOf rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh" /></aaif:Entry><aaif:Phrase rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En1365Ph1"><aaif:verb rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh#En1365Ph1Ve1" /><aaif:verb rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh#En1365Ph1Ve2" /><aaif:adverb rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh#En1365Ph1Ad1" /><aaif:adverb rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh#En1365Ph1Ad2" /><aaif:text>Pecca fortiter sed fide fortius, “ peca fuerte y confía más fuerte </aaif:text><aaif:annoText>Pecca fortiter sed fide fortius, “ [v|peca|pecar|is] [a|fuerte|fuerte|auvnmnnn] y [v|confía|confíar|is] más [a|fuerte|fuerte|auvmmnnn] </aaif:annoText></aaif:Phrase><aaif:Verb rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En1365Ph1Ve1"><aaif:text>peca</aaif:text><aaif:lemma rdf:resource="https://gams.uni-graz.at/o:aaif.lemma#pecar" /><aaif:position rdf:datatype="http://www.w3.org/2001/XMLSchema#int">1</aaif:position><aaif:coordinated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:coordinated><aaif:partOfText rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</aaif:partOfText><aaif:syntacticConstruction rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Intransitive" /></aaif:Verb><aaif:Verb rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En1365Ph1Ve2"><aaif:text>confía</aaif:text><aaif:lemma rdf:resource="https://gams.uni-graz.at/o:aaif.lemma#confíar" /><aaif:position rdf:datatype="http://www.w3.org/2001/XMLSchema#int">3</aaif:position><aaif:coordinated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:coordinated><aaif:partOfText rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</aaif:partOfText><aaif:syntacticConstruction rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Intransitive" /></aaif:Verb><aaif:Adverb rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En1365Ph1Ad1"><aaif:text>fuerte</aaif:text><aaif:lemma rdf:resource="https://gams.uni-graz.at/o:aaif.lemma#fuerte" /><aaif:position rdf:datatype="http://www.w3.org/2001/XMLSchema#int">2</aaif:position><aaif:coordinated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:coordinated><aaif:morphosyntacticStructure rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Adjective" /><aaif:inflection rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Uninflected" /><aaif:attributionTarget rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Verb" /><aaif:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:modified><aaif:semanticClassification rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Manner" /><aaif:reduplicated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:reduplicated><aaif:prepositionalPhrase rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:prepositionalPhrase></aaif:Adverb><aaif:Adverb rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En1365Ph1Ad2"><aaif:text>fuerte</aaif:text><aaif:lemma rdf:resource="https://gams.uni-graz.at/o:aaif.lemma#fuerte" /><aaif:position rdf:datatype="http://www.w3.org/2001/XMLSchema#int">4</aaif:position><aaif:coordinated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:coordinated><aaif:morphosyntacticStructure rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Adjective" /><aaif:inflection rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Uninflected" /><aaif:attributionTarget rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Verb" /><aaif:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</aaif:modified><aaif:semanticClassification rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Manner" /><aaif:reduplicated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:reduplicated><aaif:prepositionalPhrase rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:prepositionalPhrase></aaif:Adverb><aaif:Entry rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En1366"><aaif:phrase rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh#En1366Ph1" /><aaif:source rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh.bibl#Cnde117" /><gams:textualContent>y empecé a envolverle la cuerda.Ajustaba el cordel en la púa, ciñendo las vueltas lentamente y tirando fuerte .Aseguré el trompo entre mis dedos, en la mano izquierda; saqué el extremo de la cuerda por</gams:textualContent><rel:isPartOf rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh" /></aaif:Entry><aaif:Phrase rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En1366Ph1"><aaif:verb rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh#En1366Ph1Ve1" /><aaif:adverb rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh#En1366Ph1Ad1" /><aaif:text>Ajustaba el cordel en la púa, ciñendo las vueltas lentamente y tirando fuerte </aaif:text><aaif:annoText>Ajustaba el cordel en la púa, ciñendo las vueltas lentamente y [v|tirando|tirar|is] [a|fuerte|fuerte|auvnmnnn] </aaif:annoText></aaif:Phrase><aaif:Verb rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En1366Ph1Ve1"><aaif:text>tirando</aaif:text><aaif:lemma rdf:resource="https://gams.uni-graz.at/o:aaif.lemma#tirar" /><aaif:position rdf:datatype="http://www.w3.org/2001/XMLSchema#int">1</aaif:position><aaif:coordinated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:coordinated><aaif:partOfText rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</aaif:partOfText><aaif:syntacticConstruction rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Intransitive" /></aaif:Verb><aaif:Adverb rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En1366Ph1Ad1"><aaif:text>fuerte</aaif:text><aaif:lemma rdf:resource="https://gams.uni-graz.at/o:aaif.lemma#fuerte" /><aaif:position rdf:datatype="http://www.w3.org/2001/XMLSchema#int">2</aaif:position><aaif:coordinated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:coordinated><aaif:morphosyntacticStructure rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Adjective" /><aaif:inflection rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Uninflected" /><aaif:attributionTarget rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Verb" /><aaif:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:modified><aaif:semanticClassification rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Manner" /><aaif:reduplicated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:reduplicated><aaif:prepositionalPhrase rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:prepositionalPhrase></aaif:Adverb><aaif:Entry rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En1367"><aaif:phrase rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh#En1367Ph1" /><aaif:source rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh.bibl#Cnde117" /><gams:textualContent>la sal!Hoy vamos a expulsar de Abancay a todos los ladrones.¡Gritad, mujeres; gritad fuerte ;que lo oiga el mundo entero!¡Morirán los ladrones!</gams:textualContent><rel:isPartOf rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh" /></aaif:Entry><aaif:Phrase rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En1367Ph1"><aaif:verb rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh#En1367Ph1Ve1" /><aaif:adverb rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh#En1367Ph1Ad1" /><aaif:text>¡Gritad, mujeres; gritad fuerte </aaif:text><aaif:annoText>¡Gritad, mujeres; [v|gritad|gritar|is] [a|fuerte|fuerte|auvnmnnn] </aaif:annoText></aaif:Phrase><aaif:Verb rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En1367Ph1Ve1"><aaif:text>gritad</aaif:text><aaif:lemma rdf:resource="https://gams.uni-graz.at/o:aaif.lemma#gritar" /><aaif:position rdf:datatype="http://www.w3.org/2001/XMLSchema#int">1</aaif:position><aaif:coordinated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:coordinated><aaif:partOfText rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</aaif:partOfText><aaif:syntacticConstruction rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Intransitive" /></aaif:Verb><aaif:Adverb rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En1367Ph1Ad1"><aaif:text>fuerte</aaif:text><aaif:lemma rdf:resource="https://gams.uni-graz.at/o:aaif.lemma#fuerte" /><aaif:position rdf:datatype="http://www.w3.org/2001/XMLSchema#int">2</aaif:position><aaif:coordinated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:coordinated><aaif:morphosyntacticStructure rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Adjective" /><aaif:inflection rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Uninflected" /><aaif:attributionTarget rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Verb" /><aaif:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:modified><aaif:semanticClassification rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Manner" /><aaif:reduplicated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:reduplicated><aaif:prepositionalPhrase rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:prepositionalPhrase></aaif:Adverb><aaif:Entry rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En1368"><aaif:phrase rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh#En1368Ph1" /><aaif:source rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh.bibl#Cnde117" /><gams:textualContent>Bajamos en la puerta del Colegio. El mayordomo  tocó fuerte el postigo.</gams:textualContent><rel:isPartOf rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh" /></aaif:Entry><aaif:Phrase rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En1368Ph1"><aaif:subject rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh#En1368Ph1Su1" /><aaif:verb rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh#En1368Ph1Ve1" /><aaif:adverb rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh#En1368Ph1Ad1" /><aaif:text> El mayordomo  tocó fuerte el postigo</aaif:text><aaif:annoText> [s|El mayordomo|ms]  [v|tocó|tocar|ts] [a|fuerte|fuerte|auvnmnnn] el postigo</aaif:annoText></aaif:Phrase><aaif:Subject rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En1368Ph1Su1"><aaif:text>El mayordomo</aaif:text><aaif:position rdf:datatype="http://www.w3.org/2001/XMLSchema#int">1</aaif:position><aaif:gender rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Masculine" /><aaif:number rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Singular" /><aaif:overt rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</aaif:overt></aaif:Subject><aaif:Verb rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En1368Ph1Ve1"><aaif:text>tocó</aaif:text><aaif:lemma rdf:resource="https://gams.uni-graz.at/o:aaif.lemma#tocar" /><aaif:position rdf:datatype="http://www.w3.org/2001/XMLSchema#int">2</aaif:position><aaif:coordinated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:coordinated><aaif:partOfText rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</aaif:partOfText><aaif:syntacticConstruction rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Transitive" /></aaif:Verb><aaif:Adverb rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En1368Ph1Ad1"><aaif:text>fuerte</aaif:text><aaif:lemma rdf:resource="https://gams.uni-graz.at/o:aaif.lemma#fuerte" /><aaif:position rdf:datatype="http://www.w3.org/2001/XMLSchema#int">3</aaif:position><aaif:coordinated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:coordinated><aaif:morphosyntacticStructure rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Adjective" /><aaif:inflection rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Uninflected" /><aaif:attributionTarget rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Verb" /><aaif:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:modified><aaif:semanticClassification rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Manner" /><aaif:reduplicated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:reduplicated><aaif:prepositionalPhrase rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:prepositionalPhrase></aaif:Adverb><aaif:Entry rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En1369"><aaif:phrase rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh#En1369Ph1" /><aaif:source rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh.bibl#Cnde117" /><gams:textualContent> El zumbayllu  cantó fuerte en el aire.Se paró en una de las gradas de madera que subían al corredor; saltó</gams:textualContent><rel:isPartOf rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh" /></aaif:Entry><aaif:Phrase rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En1369Ph1"><aaif:subject rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh#En1369Ph1Su1" /><aaif:verb rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh#En1369Ph1Ve1" /><aaif:adverb rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh#En1369Ph1Ad1" /><aaif:text> El zumbayllu  cantó fuerte en el aire</aaif:text><aaif:annoText> [s|El zumbayllu|ms]  [v|cantó|cantar|is] [a|fuerte|fuerte|auvnmnnn] en el aire</aaif:annoText></aaif:Phrase><aaif:Subject rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En1369Ph1Su1"><aaif:text>El zumbayllu</aaif:text><aaif:position rdf:datatype="http://www.w3.org/2001/XMLSchema#int">1</aaif:position><aaif:gender rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Masculine" /><aaif:number rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Singular" /><aaif:overt rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</aaif:overt></aaif:Subject><aaif:Verb rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En1369Ph1Ve1"><aaif:text>cantó</aaif:text><aaif:lemma rdf:resource="https://gams.uni-graz.at/o:aaif.lemma#cantar" /><aaif:position rdf:datatype="http://www.w3.org/2001/XMLSchema#int">2</aaif:position><aaif:coordinated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:coordinated><aaif:partOfText rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</aaif:partOfText><aaif:syntacticConstruction rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Intransitive" /></aaif:Verb><aaif:Adverb rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En1369Ph1Ad1"><aaif:text>fuerte</aaif:text><aaif:lemma rdf:resource="https://gams.uni-graz.at/o:aaif.lemma#fuerte" /><aaif:position rdf:datatype="http://www.w3.org/2001/XMLSchema#int">3</aaif:position><aaif:coordinated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:coordinated><aaif:morphosyntacticStructure rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Adjective" /><aaif:inflection rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Uninflected" /><aaif:attributionTarget rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Verb" /><aaif:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:modified><aaif:semanticClassification rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Manner" /><aaif:reduplicated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:reduplicated><aaif:prepositionalPhrase rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:prepositionalPhrase></aaif:Adverb><aaif:Entry rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En1370"><aaif:phrase rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh#En1370Ph1" /><aaif:source rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh.bibl#Cnde117" /><gams:textualContent>por las ventanas, el trotar de los caballos en el empedrado de la calle.Nos acostamos y  dormimos fuerte .</gams:textualContent><rel:isPartOf rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh" /></aaif:Entry><aaif:Phrase rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En1370Ph1"><aaif:verb rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh#En1370Ph1Ve1" /><aaif:adverb rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh#En1370Ph1Ad1" /><aaif:text>Nos acostamos y  dormimos fuerte </aaif:text><aaif:annoText>Nos acostamos y  [v|dormimos|dormir|is] [a|fuerte|fuerte|auvnmnnn] </aaif:annoText></aaif:Phrase><aaif:Verb rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En1370Ph1Ve1"><aaif:text>dormimos</aaif:text><aaif:lemma rdf:resource="https://gams.uni-graz.at/o:aaif.lemma#dormir" /><aaif:position rdf:datatype="http://www.w3.org/2001/XMLSchema#int">1</aaif:position><aaif:coordinated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:coordinated><aaif:partOfText rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</aaif:partOfText><aaif:syntacticConstruction rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Intransitive" /></aaif:Verb><aaif:Adverb rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En1370Ph1Ad1"><aaif:text>fuerte</aaif:text><aaif:lemma rdf:resource="https://gams.uni-graz.at/o:aaif.lemma#fuerte" /><aaif:position rdf:datatype="http://www.w3.org/2001/XMLSchema#int">2</aaif:position><aaif:coordinated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:coordinated><aaif:morphosyntacticStructure rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Adjective" /><aaif:inflection rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Uninflected" /><aaif:attributionTarget rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Verb" /><aaif:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:modified><aaif:semanticClassification rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Manner" /><aaif:reduplicated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:reduplicated><aaif:prepositionalPhrase rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:prepositionalPhrase></aaif:Adverb><aaif:Entry rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En1371"><aaif:phrase rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh#En1371Ph1" /><aaif:source rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh.bibl#Cnde117" /><gams:textualContent>, cual un puma su cola.Oí que reía sin recato.Estaba lejos de la gente. Reía  fuerte , en cortos desahogos.Señalaba con el brazo extendido el parque, y volvía a reír.Apuntaría a</gams:textualContent><rel:isPartOf rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh" /></aaif:Entry><aaif:Phrase rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En1371Ph1"><aaif:verb rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh#En1371Ph1Ve1" /><aaif:adverb rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh#En1371Ph1Ad1" /><aaif:text> Reía  fuerte , en cortos desahogos</aaif:text><aaif:annoText> [v|Reía|reír|is]  [a|fuerte|fuerte|auvnmnnn] , en cortos desahogos</aaif:annoText></aaif:Phrase><aaif:Verb rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En1371Ph1Ve1"><aaif:text>Reía</aaif:text><aaif:lemma rdf:resource="https://gams.uni-graz.at/o:aaif.lemma#reír" /><aaif:position rdf:datatype="http://www.w3.org/2001/XMLSchema#int">1</aaif:position><aaif:coordinated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:coordinated><aaif:partOfText rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</aaif:partOfText><aaif:syntacticConstruction rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Intransitive" /></aaif:Verb><aaif:Adverb rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En1371Ph1Ad1"><aaif:text>fuerte</aaif:text><aaif:lemma rdf:resource="https://gams.uni-graz.at/o:aaif.lemma#fuerte" /><aaif:position rdf:datatype="http://www.w3.org/2001/XMLSchema#int">2</aaif:position><aaif:coordinated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:coordinated><aaif:morphosyntacticStructure rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Adjective" /><aaif:inflection rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Uninflected" /><aaif:attributionTarget rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Verb" /><aaif:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:modified><aaif:semanticClassification rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Manner" /><aaif:reduplicated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:reduplicated><aaif:prepositionalPhrase rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:prepositionalPhrase></aaif:Adverb><aaif:Entry rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En1372"><aaif:phrase rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh#En1372Ph1" /><aaif:source rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh.bibl#Cnde117" /><gams:textualContent>Padre grande de Abancay.Después sentarán tranquilos; tiritando se morirán, tranquilos.Hasta entonces van a empujar fuerte , aunque como nube o como viento vayan los civiles.¡Llegarán no más!¡Ya estarán llegando</gams:textualContent><rel:isPartOf rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh" /></aaif:Entry><aaif:Phrase rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En1372Ph1"><aaif:verb rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh#En1372Ph1Ve1" /><aaif:adverb rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh#En1372Ph1Ad1" /><aaif:text>Hasta entonces van a empujar fuerte </aaif:text><aaif:annoText>Hasta entonces van a [v|empujar|empujar|is] [a|fuerte|fuerte|auvnmnnn] </aaif:annoText></aaif:Phrase><aaif:Verb rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En1372Ph1Ve1"><aaif:text>empujar</aaif:text><aaif:lemma rdf:resource="https://gams.uni-graz.at/o:aaif.lemma#empujar" /><aaif:position rdf:datatype="http://www.w3.org/2001/XMLSchema#int">1</aaif:position><aaif:coordinated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:coordinated><aaif:partOfText rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</aaif:partOfText><aaif:syntacticConstruction rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Intransitive" /></aaif:Verb><aaif:Adverb rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En1372Ph1Ad1"><aaif:text>fuerte</aaif:text><aaif:lemma rdf:resource="https://gams.uni-graz.at/o:aaif.lemma#fuerte" /><aaif:position rdf:datatype="http://www.w3.org/2001/XMLSchema#int">2</aaif:position><aaif:coordinated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:coordinated><aaif:morphosyntacticStructure rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Adjective" /><aaif:inflection rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Uninflected" /><aaif:attributionTarget rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Verb" /><aaif:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:modified><aaif:semanticClassification rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Manner" /><aaif:reduplicated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:reduplicated><aaif:prepositionalPhrase rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:prepositionalPhrase></aaif:Adverb><aaif:Entry rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En1373"><aaif:phrase rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh#En1373Ph1" /><aaif:source rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh.bibl#Cnde117" /><gams:textualContent>desnudo.Ambas estaban muy cerca del fogón.La mayor levantó la aguja hacia la luz. Miré  fuerte , y pude ver en la punta de la aguja un nido de piques, un nido grande, quizá</gams:textualContent><rel:isPartOf rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh" /></aaif:Entry><aaif:Phrase rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En1373Ph1"><aaif:verb rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh#En1373Ph1Ve1" /><aaif:adverb rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh#En1373Ph1Ad1" /><aaif:text> Miré  fuerte </aaif:text><aaif:annoText> [v|Miré|mirar|is]  [a|fuerte|fuerte|auvnmnnn] </aaif:annoText></aaif:Phrase><aaif:Verb rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En1373Ph1Ve1"><aaif:text>Miré</aaif:text><aaif:lemma rdf:resource="https://gams.uni-graz.at/o:aaif.lemma#mirar" /><aaif:position rdf:datatype="http://www.w3.org/2001/XMLSchema#int">1</aaif:position><aaif:coordinated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:coordinated><aaif:partOfText rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</aaif:partOfText><aaif:syntacticConstruction rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Intransitive" /></aaif:Verb><aaif:Adverb rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En1373Ph1Ad1"><aaif:text>fuerte</aaif:text><aaif:lemma rdf:resource="https://gams.uni-graz.at/o:aaif.lemma#fuerte" /><aaif:position rdf:datatype="http://www.w3.org/2001/XMLSchema#int">2</aaif:position><aaif:coordinated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:coordinated><aaif:morphosyntacticStructure rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Adjective" /><aaif:inflection rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Uninflected" /><aaif:attributionTarget rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Verb" /><aaif:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:modified><aaif:semanticClassification rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Manner" /><aaif:reduplicated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:reduplicated><aaif:prepositionalPhrase rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:prepositionalPhrase></aaif:Adverb><aaif:Entry rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En1374"><aaif:phrase rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh#En1374Ph1" /><aaif:source rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh.bibl#Cnde49" /><gams:textualContent>cielo estaba moteado de vencejos altísimos, blanco, inmenso, como desbordado de una gran taza. Natalia  respiró fuerte mientras se alejaba hacia las calles tranquilas.Enfiló la de su casa que hacía un poco de cuesta.</gams:textualContent><rel:isPartOf rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh" /></aaif:Entry><aaif:Phrase rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En1374Ph1"><aaif:subject rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh#En1374Ph1Su1" /><aaif:verb rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh#En1374Ph1Ve1" /><aaif:adverb rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh#En1374Ph1Ad1" /><aaif:text> Natalia  respiró fuerte mientras se alejaba</aaif:text><aaif:annoText> [s|Natalia|fs]  [v|respiró|respirar|is] [a|fuerte|fuerte|auvnmnnn] mientras se alejaba</aaif:annoText></aaif:Phrase><aaif:Subject rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En1374Ph1Su1"><aaif:text>Natalia</aaif:text><aaif:position rdf:datatype="http://www.w3.org/2001/XMLSchema#int">1</aaif:position><aaif:gender rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Feminine" /><aaif:number rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Singular" /><aaif:overt rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</aaif:overt></aaif:Subject><aaif:Verb rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En1374Ph1Ve1"><aaif:text>respiró</aaif:text><aaif:lemma rdf:resource="https://gams.uni-graz.at/o:aaif.lemma#respirar" /><aaif:position rdf:datatype="http://www.w3.org/2001/XMLSchema#int">2</aaif:position><aaif:coordinated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:coordinated><aaif:partOfText rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</aaif:partOfText><aaif:syntacticConstruction rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Intransitive" /></aaif:Verb><aaif:Adverb rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En1374Ph1Ad1"><aaif:text>fuerte</aaif:text><aaif:lemma rdf:resource="https://gams.uni-graz.at/o:aaif.lemma#fuerte" /><aaif:position rdf:datatype="http://www.w3.org/2001/XMLSchema#int">3</aaif:position><aaif:coordinated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:coordinated><aaif:morphosyntacticStructure rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Adjective" /><aaif:inflection rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Uninflected" /><aaif:attributionTarget rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Verb" /><aaif:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:modified><aaif:semanticClassification rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Manner" /><aaif:reduplicated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:reduplicated><aaif:prepositionalPhrase rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:prepositionalPhrase></aaif:Adverb><aaif:Entry rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En1375"><aaif:phrase rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh#En1375Ph1" /><aaif:source rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh.bibl#Cnde49" /><gams:textualContent>Pues a la chiquita ésta yo no le veo nada.Tiene unos bracines que parecen palos.- Hombre, no;es mona.Muy crío, eso es lo que pasa.Ya se pondrá en su punto.Es de las que se ponen en su punto después del segundo hijo.Qué dolor de cabeza, oye.Dos horas he dormido.- Por ahora es de las que no deben dar ni frío ni calor.- Eso creo, sí.Algo simplona.Yo también estoy cansadísimo.- — Y dice que se casa, eh, que no quiere esperar ni dos meses.Le ha dado fuerte .Gertru le daba vueltas al pañuelo de Angel, sin levantar los ojos del regazo.- Te has quedado callada.Mírame.- No me pasa nada.- Que me mires.</gams:textualContent><rel:isPartOf rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh" /></aaif:Entry><aaif:Phrase rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En1375Ph1"><aaif:verb rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh#En1375Ph1Ve1" /><aaif:adverb rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh#En1375Ph1Ad1" /><aaif:text>Le ha dado fuerte </aaif:text><aaif:annoText>Le ha [v|dado|dar|is] [a|fuerte|fuerte|auvnmnnn] </aaif:annoText></aaif:Phrase><aaif:Verb rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En1375Ph1Ve1"><aaif:text>dado</aaif:text><aaif:lemma rdf:resource="https://gams.uni-graz.at/o:aaif.lemma#dar" /><aaif:position rdf:datatype="http://www.w3.org/2001/XMLSchema#int">1</aaif:position><aaif:coordinated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:coordinated><aaif:partOfText rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</aaif:partOfText><aaif:syntacticConstruction rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Intransitive" /></aaif:Verb><aaif:Adverb rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En1375Ph1Ad1"><aaif:text>fuerte</aaif:text><aaif:lemma rdf:resource="https://gams.uni-graz.at/o:aaif.lemma#fuerte" /><aaif:position rdf:datatype="http://www.w3.org/2001/XMLSchema#int">2</aaif:position><aaif:coordinated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:coordinated><aaif:morphosyntacticStructure rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Adjective" /><aaif:inflection rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Uninflected" /><aaif:attributionTarget rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Verb" /><aaif:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:modified><aaif:semanticClassification rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Manner" /><aaif:reduplicated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:reduplicated><aaif:prepositionalPhrase rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:prepositionalPhrase></aaif:Adverb><aaif:Entry rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En1376"><aaif:phrase rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh#En1376Ph1" /><aaif:source rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh.bibl#Cnde49" /><gams:textualContent>Mercedes dejó de hablar y  él volvió a apretarla fuerte .Sentía ella contra su mejilla el roce de la solapa de príncipe de gales, un botón de la</gams:textualContent><rel:isPartOf rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh" /></aaif:Entry><aaif:Phrase rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En1376Ph1"><aaif:subject rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh#En1376Ph1Su1" /><aaif:verb rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh#En1376Ph1Ve1" /><aaif:adverb rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh#En1376Ph1Ad1" /><aaif:text> él volvió a apretarla fuerte </aaif:text><aaif:annoText> [s|él|ms] volvió a [v|apretarla|apretar|ts] [a|fuerte|fuerte|auvnmnnn] </aaif:annoText></aaif:Phrase><aaif:Subject rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En1376Ph1Su1"><aaif:text>él</aaif:text><aaif:position rdf:datatype="http://www.w3.org/2001/XMLSchema#int">1</aaif:position><aaif:gender rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Masculine" /><aaif:number rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Singular" /><aaif:overt rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</aaif:overt></aaif:Subject><aaif:Verb rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En1376Ph1Ve1"><aaif:text>apretarla</aaif:text><aaif:lemma rdf:resource="https://gams.uni-graz.at/o:aaif.lemma#apretar" /><aaif:position rdf:datatype="http://www.w3.org/2001/XMLSchema#int">2</aaif:position><aaif:coordinated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:coordinated><aaif:partOfText rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</aaif:partOfText><aaif:syntacticConstruction rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Transitive" /></aaif:Verb><aaif:Adverb rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En1376Ph1Ad1"><aaif:text>fuerte</aaif:text><aaif:lemma rdf:resource="https://gams.uni-graz.at/o:aaif.lemma#fuerte" /><aaif:position rdf:datatype="http://www.w3.org/2001/XMLSchema#int">3</aaif:position><aaif:coordinated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:coordinated><aaif:morphosyntacticStructure rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Adjective" /><aaif:inflection rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Uninflected" /><aaif:attributionTarget rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Verb" /><aaif:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:modified><aaif:semanticClassification rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Manner" /><aaif:reduplicated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:reduplicated><aaif:prepositionalPhrase rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:prepositionalPhrase></aaif:Adverb><aaif:Entry rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En1377"><aaif:phrase rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh#En1377Ph1" /><aaif:source rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh.bibl#Cnde49" /><gams:textualContent>— Perdona que te haya molestado. El me ha abrazado fuerte .</gams:textualContent><rel:isPartOf rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh" /></aaif:Entry><aaif:Phrase rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En1377Ph1"><aaif:subject rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh#En1377Ph1Su1" /><aaif:verb rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh#En1377Ph1Ve1" /><aaif:adverb rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh#En1377Ph1Ad1" /><aaif:text> El me ha abrazado fuerte </aaif:text><aaif:annoText> [s|El|ms] me ha [v|abrazado|abrazar|ts] [a|fuerte|fuerte|auvnmnnn] </aaif:annoText></aaif:Phrase><aaif:Subject rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En1377Ph1Su1"><aaif:text>El</aaif:text><aaif:position rdf:datatype="http://www.w3.org/2001/XMLSchema#int">1</aaif:position><aaif:gender rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Masculine" /><aaif:number rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Singular" /><aaif:overt rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</aaif:overt></aaif:Subject><aaif:Verb rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En1377Ph1Ve1"><aaif:text>abrazado</aaif:text><aaif:lemma rdf:resource="https://gams.uni-graz.at/o:aaif.lemma#abrazar" /><aaif:position rdf:datatype="http://www.w3.org/2001/XMLSchema#int">2</aaif:position><aaif:coordinated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:coordinated><aaif:partOfText rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</aaif:partOfText><aaif:syntacticConstruction rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Transitive" /></aaif:Verb><aaif:Adverb rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En1377Ph1Ad1"><aaif:text>fuerte</aaif:text><aaif:lemma rdf:resource="https://gams.uni-graz.at/o:aaif.lemma#fuerte" /><aaif:position rdf:datatype="http://www.w3.org/2001/XMLSchema#int">3</aaif:position><aaif:coordinated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:coordinated><aaif:morphosyntacticStructure rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Adjective" /><aaif:inflection rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Uninflected" /><aaif:attributionTarget rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Verb" /><aaif:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:modified><aaif:semanticClassification rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Manner" /><aaif:reduplicated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:reduplicated><aaif:prepositionalPhrase rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:prepositionalPhrase></aaif:Adverb><aaif:Entry rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En1378"><aaif:phrase rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh#En1378Ph1" /><aaif:source rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh.bibl#Cnde489" /><gams:textualContent>El coronel guardó en el bolsillo la hoja clandestina. Álvaro  apostó fuerte al once.</gams:textualContent><rel:isPartOf rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh" /></aaif:Entry><aaif:Phrase rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En1378Ph1"><aaif:subject rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh#En1378Ph1Su1" /><aaif:verb rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh#En1378Ph1Ve1" /><aaif:adverb rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh#En1378Ph1Ad1" /><aaif:text> Álvaro  apostó fuerte al once</aaif:text><aaif:annoText> [s|Álvaro|ms]  [v|apostó|apostar|is] [a|fuerte|fuerte|auvnmnnn] al once</aaif:annoText></aaif:Phrase><aaif:Subject rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En1378Ph1Su1"><aaif:text>Álvaro</aaif:text><aaif:position rdf:datatype="http://www.w3.org/2001/XMLSchema#int">1</aaif:position><aaif:gender rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Masculine" /><aaif:number rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Singular" /><aaif:overt rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</aaif:overt></aaif:Subject><aaif:Verb rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En1378Ph1Ve1"><aaif:text>apostó</aaif:text><aaif:lemma rdf:resource="https://gams.uni-graz.at/o:aaif.lemma#apostar" /><aaif:position rdf:datatype="http://www.w3.org/2001/XMLSchema#int">2</aaif:position><aaif:coordinated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:coordinated><aaif:partOfText rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</aaif:partOfText><aaif:syntacticConstruction rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Intransitive" /></aaif:Verb><aaif:Adverb rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En1378Ph1Ad1"><aaif:text>fuerte</aaif:text><aaif:lemma rdf:resource="https://gams.uni-graz.at/o:aaif.lemma#fuerte" /><aaif:position rdf:datatype="http://www.w3.org/2001/XMLSchema#int">3</aaif:position><aaif:coordinated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:coordinated><aaif:morphosyntacticStructure rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Adjective" /><aaif:inflection rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Uninflected" /><aaif:attributionTarget rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Verb" /><aaif:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:modified><aaif:semanticClassification rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Manner" /><aaif:reduplicated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:reduplicated><aaif:prepositionalPhrase rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:prepositionalPhrase></aaif:Adverb><aaif:Entry rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En1379"><aaif:phrase rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh#En1379Ph1" /><aaif:source rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh.bibl#Cnde490" /><gams:textualContent>«Aparte de algunos kilos de más que tenés ahora, lo que más extraño en vos es que te rías fuerte .Antes te mandabas el más criminal de los chistes con una cara de velorio que era sensacional.»</gams:textualContent><rel:isPartOf rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh" /></aaif:Entry><aaif:Phrase rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En1379Ph1"><aaif:verb rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh#En1379Ph1Ve1" /><aaif:adverb rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh#En1379Ph1Ad1" /><aaif:text>que te rías fuerte .</aaif:text><aaif:annoText>que te [v|rías|reír|rs] [a|fuerte|fuerte|auvnmnnn] .</aaif:annoText></aaif:Phrase><aaif:Verb rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En1379Ph1Ve1"><aaif:text>rías</aaif:text><aaif:lemma rdf:resource="https://gams.uni-graz.at/o:aaif.lemma#reír" /><aaif:position rdf:datatype="http://www.w3.org/2001/XMLSchema#int">1</aaif:position><aaif:coordinated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:coordinated><aaif:partOfText rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</aaif:partOfText><aaif:syntacticConstruction rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Reflexive" /></aaif:Verb><aaif:Adverb rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En1379Ph1Ad1"><aaif:text>fuerte</aaif:text><aaif:lemma rdf:resource="https://gams.uni-graz.at/o:aaif.lemma#fuerte" /><aaif:position rdf:datatype="http://www.w3.org/2001/XMLSchema#int">2</aaif:position><aaif:coordinated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:coordinated><aaif:morphosyntacticStructure rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Adjective" /><aaif:inflection rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Uninflected" /><aaif:attributionTarget rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Verb" /><aaif:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:modified><aaif:semanticClassification rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Manner" /><aaif:reduplicated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:reduplicated><aaif:prepositionalPhrase rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:prepositionalPhrase></aaif:Adverb><aaif:Entry rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En1380"><aaif:phrase rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh#En1380Ph1" /><aaif:source rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh.bibl#Cnde260" /><gams:textualContent>¡Pobre!¡Jha..., político!—furfulló la vieja hamacando fuerte al Corazón de Jesús—.¡Cuándo van a aprender nuestros hombres a no meterse!</gams:textualContent><rel:isPartOf rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh" /></aaif:Entry><aaif:Phrase rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En1380Ph1"><aaif:verb rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh#En1380Ph1Ve1" /><aaif:adverb rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh#En1380Ph1Ad1" /><aaif:text>furfulló la vieja hamacando fuerte al Corazón de Jesús</aaif:text><aaif:annoText>furfulló la vieja [v|hamacando|hamacar|ts] [a|fuerte|fuerte|auvnmnnn] al Corazón de Jesús</aaif:annoText></aaif:Phrase><aaif:Verb rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En1380Ph1Ve1"><aaif:text>hamacando</aaif:text><aaif:lemma rdf:resource="https://gams.uni-graz.at/o:aaif.lemma#hamacar" /><aaif:position rdf:datatype="http://www.w3.org/2001/XMLSchema#int">1</aaif:position><aaif:coordinated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:coordinated><aaif:partOfText rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</aaif:partOfText><aaif:syntacticConstruction rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Transitive" /></aaif:Verb><aaif:Adverb rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En1380Ph1Ad1"><aaif:text>fuerte</aaif:text><aaif:lemma rdf:resource="https://gams.uni-graz.at/o:aaif.lemma#fuerte" /><aaif:position rdf:datatype="http://www.w3.org/2001/XMLSchema#int">2</aaif:position><aaif:coordinated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:coordinated><aaif:morphosyntacticStructure rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Adjective" /><aaif:inflection rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Uninflected" /><aaif:attributionTarget rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Verb" /><aaif:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:modified><aaif:semanticClassification rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Manner" /><aaif:reduplicated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:reduplicated><aaif:prepositionalPhrase rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:prepositionalPhrase></aaif:Adverb><aaif:Entry rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En1381"><aaif:phrase rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh#En1381Ph1" /><aaif:source rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh.bibl#Cnde260" /><gams:textualContent>volviéndola casi fúnebre.Asegurados por torzales a un guayabo, los caballos sin desensillar pastaban los raquíticos yuyos resollando fuerte  a cada rato para expeler las chinches de monte que se les metían por los ollares.</gams:textualContent><rel:isPartOf rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh" /></aaif:Entry><aaif:Phrase rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En1381Ph1"><aaif:verb rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh#En1381Ph1Ve1" /><aaif:adverb rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh#En1381Ph1Ad1" /><aaif:text>los caballos sin desensillar pastaban los raquíticos yuyos resollando fuerte </aaif:text><aaif:annoText>los caballos sin desensillar pastaban los raquíticos yuyos [v|resollando|resollar|is] [a|fuerte|fuerte|auvnmnnn] </aaif:annoText></aaif:Phrase><aaif:Verb rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En1381Ph1Ve1"><aaif:text>resollando</aaif:text><aaif:lemma rdf:resource="https://gams.uni-graz.at/o:aaif.lemma#resollar" /><aaif:position rdf:datatype="http://www.w3.org/2001/XMLSchema#int">1</aaif:position><aaif:coordinated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:coordinated><aaif:partOfText rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</aaif:partOfText><aaif:syntacticConstruction rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Intransitive" /></aaif:Verb><aaif:Adverb rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En1381Ph1Ad1"><aaif:text>fuerte</aaif:text><aaif:lemma rdf:resource="https://gams.uni-graz.at/o:aaif.lemma#fuerte" /><aaif:position rdf:datatype="http://www.w3.org/2001/XMLSchema#int">2</aaif:position><aaif:coordinated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:coordinated><aaif:morphosyntacticStructure rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Adjective" /><aaif:inflection rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Uninflected" /><aaif:attributionTarget rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Verb" /><aaif:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:modified><aaif:semanticClassification rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Manner" /><aaif:reduplicated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:reduplicated><aaif:prepositionalPhrase rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:prepositionalPhrase></aaif:Adverb><aaif:Entry rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En1382"><aaif:phrase rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh#En1382Ph1" /><aaif:source rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh.bibl#Cnde260" /><gams:textualContent>Me encontré riendo fuerte , histéricamente, hasta las lágrimas.</gams:textualContent><rel:isPartOf rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh" /></aaif:Entry><aaif:Phrase rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En1382Ph1"><aaif:verb rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh#En1382Ph1Ve1" /><aaif:adverb rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh#En1382Ph1Ad1" /><aaif:text>Me encontré riendo fuerte , histéricamente</aaif:text><aaif:annoText>Me encontré [v|riendo|reír|rs] [a|fuerte|fuerte|auvnmnnC] , histéricamente</aaif:annoText></aaif:Phrase><aaif:Verb rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En1382Ph1Ve1"><aaif:text>riendo</aaif:text><aaif:lemma rdf:resource="https://gams.uni-graz.at/o:aaif.lemma#reír" /><aaif:position rdf:datatype="http://www.w3.org/2001/XMLSchema#int">1</aaif:position><aaif:coordinated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:coordinated><aaif:partOfText rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</aaif:partOfText><aaif:syntacticConstruction rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Reflexive" /></aaif:Verb><aaif:Adverb rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En1382Ph1Ad1"><aaif:text>fuerte</aaif:text><aaif:lemma rdf:resource="https://gams.uni-graz.at/o:aaif.lemma#fuerte" /><aaif:position rdf:datatype="http://www.w3.org/2001/XMLSchema#int">2</aaif:position><aaif:coordinated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</aaif:coordinated><aaif:morphosyntacticStructure rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Adjective" /><aaif:inflection rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Uninflected" /><aaif:attributionTarget rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Verb" /><aaif:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:modified><aaif:semanticClassification rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Manner" /><aaif:reduplicated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:reduplicated><aaif:prepositionalPhrase rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:prepositionalPhrase></aaif:Adverb><aaif:Entry rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En1383"><aaif:phrase rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh#En1383Ph1" /><aaif:source rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh.bibl#Cnde50" /><gams:textualContent>de confidencia.«Abajo de estas ventanas pasé tantas noches con una mano en el revólver o cerca, pisando fuerte , a la vez ajeno y desdeñoso y provocando siempre inútilmente.»</gams:textualContent><rel:isPartOf rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh" /></aaif:Entry><aaif:Phrase rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En1383Ph1"><aaif:verb rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh#En1383Ph1Ve1" /><aaif:adverb rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh#En1383Ph1Ad1" /><aaif:text>pasé tantas noches con una mano en el revólver o cerca, pisando fuerte </aaif:text><aaif:annoText>pasé tantas noches con una mano en el revólver o cerca, [v|pisando|pisar|is] [a|fuerte|fuerte|auvnmnnn] </aaif:annoText></aaif:Phrase><aaif:Verb rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En1383Ph1Ve1"><aaif:text>pisando</aaif:text><aaif:lemma rdf:resource="https://gams.uni-graz.at/o:aaif.lemma#pisar" /><aaif:position rdf:datatype="http://www.w3.org/2001/XMLSchema#int">1</aaif:position><aaif:coordinated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:coordinated><aaif:partOfText rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</aaif:partOfText><aaif:syntacticConstruction rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Intransitive" /></aaif:Verb><aaif:Adverb rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En1383Ph1Ad1"><aaif:text>fuerte</aaif:text><aaif:lemma rdf:resource="https://gams.uni-graz.at/o:aaif.lemma#fuerte" /><aaif:position rdf:datatype="http://www.w3.org/2001/XMLSchema#int">2</aaif:position><aaif:coordinated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:coordinated><aaif:morphosyntacticStructure rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Adjective" /><aaif:inflection rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Uninflected" /><aaif:attributionTarget rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Verb" /><aaif:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:modified><aaif:semanticClassification rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Manner" /><aaif:reduplicated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:reduplicated><aaif:prepositionalPhrase rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:prepositionalPhrase></aaif:Adverb><aaif:Entry rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En1384"><aaif:phrase rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh#En1384Ph1" /><aaif:source rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh.bibl#Cnde412" /><gams:textualContent>hacían los últimos preparativos.La lona, dijo Bucich, con su pecho apagado, sabés, puede llover fuerte .Ataban las riendas, apoyando una pierna sobre el camión, haciendo fuerza.Pasaban obreros, conversando,</gams:textualContent><rel:isPartOf rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh" /></aaif:Entry><aaif:Phrase rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En1384Ph1"><aaif:verb rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh#En1384Ph1Ve1" /><aaif:adverb rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh#En1384Ph1Ad1" /><aaif:text>puede llover fuerte </aaif:text><aaif:annoText>puede [v|llover|llover|is] [a|fuerte|fuerte|auvnmnnn] </aaif:annoText></aaif:Phrase><aaif:Verb rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En1384Ph1Ve1"><aaif:text>llover</aaif:text><aaif:lemma rdf:resource="https://gams.uni-graz.at/o:aaif.lemma#llover" /><aaif:position rdf:datatype="http://www.w3.org/2001/XMLSchema#int">1</aaif:position><aaif:coordinated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:coordinated><aaif:partOfText rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</aaif:partOfText><aaif:syntacticConstruction rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Intransitive" /></aaif:Verb><aaif:Adverb rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En1384Ph1Ad1"><aaif:text>fuerte</aaif:text><aaif:lemma rdf:resource="https://gams.uni-graz.at/o:aaif.lemma#fuerte" /><aaif:position rdf:datatype="http://www.w3.org/2001/XMLSchema#int">2</aaif:position><aaif:coordinated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:coordinated><aaif:morphosyntacticStructure rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Adjective" /><aaif:inflection rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Uninflected" /><aaif:attributionTarget rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Verb" /><aaif:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:modified><aaif:semanticClassification rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Manner" /><aaif:reduplicated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:reduplicated><aaif:prepositionalPhrase rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:prepositionalPhrase></aaif:Adverb><aaif:Entry rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En1385"><aaif:phrase rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh#En1385Ph1" /><aaif:source rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh.bibl#Cnde52" /><gams:textualContent>los editus Ursae.Son cosas que no se adquieren así no más.Sólo hacia 1400 comenzaron a pisar fuerte , con su Ranuccio III, senador de Roma, que merced a los papas Martín IV y Eugenio IV redondeó un considerable</gams:textualContent><rel:isPartOf rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh" /></aaif:Entry><aaif:Phrase rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En1385Ph1"><aaif:verb rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh#En1385Ph1Ve1" /><aaif:adverb rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh#En1385Ph1Ad1" /><aaif:text>Sólo hacia 1400 comenzaron a pisar fuerte </aaif:text><aaif:annoText>Sólo hacia 1400 comenzaron a [v|pisar|pisar|is] [a|fuerte|fuerte|auvnmnnn] </aaif:annoText></aaif:Phrase><aaif:Verb rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En1385Ph1Ve1"><aaif:text>pisar</aaif:text><aaif:lemma rdf:resource="https://gams.uni-graz.at/o:aaif.lemma#pisar" /><aaif:position rdf:datatype="http://www.w3.org/2001/XMLSchema#int">1</aaif:position><aaif:coordinated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:coordinated><aaif:partOfText rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</aaif:partOfText><aaif:syntacticConstruction rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Intransitive" /></aaif:Verb><aaif:Adverb rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En1385Ph1Ad1"><aaif:text>fuerte</aaif:text><aaif:lemma rdf:resource="https://gams.uni-graz.at/o:aaif.lemma#fuerte" /><aaif:position rdf:datatype="http://www.w3.org/2001/XMLSchema#int">2</aaif:position><aaif:coordinated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:coordinated><aaif:morphosyntacticStructure rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Adjective" /><aaif:inflection rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Uninflected" /><aaif:attributionTarget rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Verb" /><aaif:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:modified><aaif:semanticClassification rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Manner" /><aaif:reduplicated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:reduplicated><aaif:prepositionalPhrase rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:prepositionalPhrase></aaif:Adverb><aaif:Entry rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En1386"><aaif:phrase rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh#En1386Ph1" /><aaif:source rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh.bibl#Cnde262" /><gams:textualContent>que se había enterado del asunto de las indemnizaciones, así que no quedaba otro remedio que empezar a pegarle fuerte al trabajo, de paso les venía bien como práctica.</gams:textualContent><rel:isPartOf rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh" /></aaif:Entry><aaif:Phrase rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En1386Ph1"><aaif:verb rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh#En1386Ph1Ve1" /><aaif:adverb rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh#En1386Ph1Ad1" /><aaif:text>no quedaba otro remedio que empezar a pegarle fuerte al trabajo</aaif:text><aaif:annoText>no quedaba otro remedio que empezar a [v|pegarle|pegar|ts] [a|fuerte|fuerte|auvnmnnn] al trabajo</aaif:annoText></aaif:Phrase><aaif:Verb rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En1386Ph1Ve1"><aaif:text>pegarle</aaif:text><aaif:lemma rdf:resource="https://gams.uni-graz.at/o:aaif.lemma#pegar" /><aaif:position rdf:datatype="http://www.w3.org/2001/XMLSchema#int">1</aaif:position><aaif:coordinated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:coordinated><aaif:partOfText rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</aaif:partOfText><aaif:syntacticConstruction rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Transitive" /></aaif:Verb><aaif:Adverb rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En1386Ph1Ad1"><aaif:text>fuerte</aaif:text><aaif:lemma rdf:resource="https://gams.uni-graz.at/o:aaif.lemma#fuerte" /><aaif:position rdf:datatype="http://www.w3.org/2001/XMLSchema#int">2</aaif:position><aaif:coordinated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:coordinated><aaif:morphosyntacticStructure rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Adjective" /><aaif:inflection rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Uninflected" /><aaif:attributionTarget rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Verb" /><aaif:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:modified><aaif:semanticClassification rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Manner" /><aaif:reduplicated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:reduplicated><aaif:prepositionalPhrase rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:prepositionalPhrase></aaif:Adverb><aaif:Entry rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En1387"><aaif:phrase rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh#En1387Ph1" /><aaif:source rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh.bibl#Cnde262" /><gams:textualContent>— Vaya a domir, don López —dijo Oliveira, respirando fuerte .</gams:textualContent><rel:isPartOf rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh" /></aaif:Entry><aaif:Phrase rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En1387Ph1"><aaif:verb rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh#En1387Ph1Ve1" /><aaif:adverb rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh#En1387Ph1Ad1" /><aaif:text>dijo Oliveira, respirando fuerte </aaif:text><aaif:annoText>dijo Oliveira, [v|respirando|respirar|is] [a|fuerte|fuerte|auvnmnnn] </aaif:annoText></aaif:Phrase><aaif:Verb rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En1387Ph1Ve1"><aaif:text>respirando</aaif:text><aaif:lemma rdf:resource="https://gams.uni-graz.at/o:aaif.lemma#respirar" /><aaif:position rdf:datatype="http://www.w3.org/2001/XMLSchema#int">1</aaif:position><aaif:coordinated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:coordinated><aaif:partOfText rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</aaif:partOfText><aaif:syntacticConstruction rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Intransitive" /></aaif:Verb><aaif:Adverb rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En1387Ph1Ad1"><aaif:text>fuerte</aaif:text><aaif:lemma rdf:resource="https://gams.uni-graz.at/o:aaif.lemma#fuerte" /><aaif:position rdf:datatype="http://www.w3.org/2001/XMLSchema#int">2</aaif:position><aaif:coordinated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:coordinated><aaif:morphosyntacticStructure rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Adjective" /><aaif:inflection rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Uninflected" /><aaif:attributionTarget rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Verb" /><aaif:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:modified><aaif:semanticClassification rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Manner" /><aaif:reduplicated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:reduplicated><aaif:prepositionalPhrase rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:prepositionalPhrase></aaif:Adverb><aaif:Entry rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En1388"><aaif:phrase rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh#En1388Ph1" /><aaif:source rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh.bibl#Cnde263" /><gams:textualContent>no la llores, que fue la gran bandolera, enterrador: no la llores) y comencé a practicar fuerte  y a darle a los cueros y en una semana estaba sacando el sonido parejito, dulce, sabroso y</gams:textualContent><rel:isPartOf rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh" /></aaif:Entry><aaif:Phrase rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En1388Ph1"><aaif:verb rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh#En1388Ph1Ve1" /><aaif:adverb rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh#En1388Ph1Ad1" /><aaif:text>comencé a practicar fuerte </aaif:text><aaif:annoText>comencé a [v|practicar|practicar|is] [a|fuerte|fuerte|auvnmnnn] </aaif:annoText></aaif:Phrase><aaif:Verb rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En1388Ph1Ve1"><aaif:text>practicar</aaif:text><aaif:lemma rdf:resource="https://gams.uni-graz.at/o:aaif.lemma#practicar" /><aaif:position rdf:datatype="http://www.w3.org/2001/XMLSchema#int">1</aaif:position><aaif:coordinated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:coordinated><aaif:partOfText rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</aaif:partOfText><aaif:syntacticConstruction rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Intransitive" /></aaif:Verb><aaif:Adverb rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En1388Ph1Ad1"><aaif:text>fuerte</aaif:text><aaif:lemma rdf:resource="https://gams.uni-graz.at/o:aaif.lemma#fuerte" /><aaif:position rdf:datatype="http://www.w3.org/2001/XMLSchema#int">2</aaif:position><aaif:coordinated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:coordinated><aaif:morphosyntacticStructure rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Adjective" /><aaif:inflection rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Uninflected" /><aaif:attributionTarget rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Verb" /><aaif:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:modified><aaif:semanticClassification rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Manner" /><aaif:reduplicated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:reduplicated><aaif:prepositionalPhrase rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:prepositionalPhrase></aaif:Adverb><aaif:Entry rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En1389"><aaif:phrase rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh#En1389Ph1" /><aaif:source rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh.bibl#Cnde263" /><gams:textualContent>garita de la vieja muralla, estaba un día enseñando a mi hermano a montar bicicleta y lo empujé , fuerte , y salió disparado y chocó contra un banco y se clavó el manubrio en el pecho y se desmayó</gams:textualContent><rel:isPartOf rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh" /></aaif:Entry><aaif:Phrase rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En1389Ph1"><aaif:verb rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh#En1389Ph1Ve1" /><aaif:adverb rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh#En1389Ph1Ad1" /><aaif:text>lo empujé , fuerte </aaif:text><aaif:annoText>lo [v|empujé|empujar|ts] , [a|fuerte|fuerte|auvnmnnn] </aaif:annoText></aaif:Phrase><aaif:Verb rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En1389Ph1Ve1"><aaif:text>empujé</aaif:text><aaif:lemma rdf:resource="https://gams.uni-graz.at/o:aaif.lemma#empujar" /><aaif:position rdf:datatype="http://www.w3.org/2001/XMLSchema#int">1</aaif:position><aaif:coordinated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:coordinated><aaif:partOfText rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</aaif:partOfText><aaif:syntacticConstruction rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Transitive" /></aaif:Verb><aaif:Adverb rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En1389Ph1Ad1"><aaif:text>fuerte</aaif:text><aaif:lemma rdf:resource="https://gams.uni-graz.at/o:aaif.lemma#fuerte" /><aaif:position rdf:datatype="http://www.w3.org/2001/XMLSchema#int">2</aaif:position><aaif:coordinated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:coordinated><aaif:morphosyntacticStructure rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Adjective" /><aaif:inflection rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Uninflected" /><aaif:attributionTarget rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Verb" /><aaif:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:modified><aaif:semanticClassification rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Manner" /><aaif:reduplicated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:reduplicated><aaif:prepositionalPhrase rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:prepositionalPhrase></aaif:Adverb><aaif:Entry rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En1390"><aaif:phrase rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh#En1390Ph1" /><aaif:source rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh.bibl#Cnde263" /><gams:textualContent>¿No lo dije?Frenamos violentamente en la Calle Doce porque pusieron la luz roja.Tuve que agarrarme fuerte .</gams:textualContent><rel:isPartOf rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh" /></aaif:Entry><aaif:Phrase rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En1390Ph1"><aaif:verb rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh#En1390Ph1Ve1" /><aaif:adverb rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh#En1390Ph1Ad1" /><aaif:text>Tuve que agarrarme fuerte </aaif:text><aaif:annoText>Tuve que [v|agarrarme|agarrar|rs] [a|fuerte|fuerte|auvnmnnn] </aaif:annoText></aaif:Phrase><aaif:Verb rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En1390Ph1Ve1"><aaif:text>agarrarme</aaif:text><aaif:lemma rdf:resource="https://gams.uni-graz.at/o:aaif.lemma#agarrar" /><aaif:position rdf:datatype="http://www.w3.org/2001/XMLSchema#int">1</aaif:position><aaif:coordinated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:coordinated><aaif:partOfText rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</aaif:partOfText><aaif:syntacticConstruction rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Reflexive" /></aaif:Verb><aaif:Adverb rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En1390Ph1Ad1"><aaif:text>fuerte</aaif:text><aaif:lemma rdf:resource="https://gams.uni-graz.at/o:aaif.lemma#fuerte" /><aaif:position rdf:datatype="http://www.w3.org/2001/XMLSchema#int">2</aaif:position><aaif:coordinated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:coordinated><aaif:morphosyntacticStructure rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Adjective" /><aaif:inflection rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Uninflected" /><aaif:attributionTarget rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Verb" /><aaif:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:modified><aaif:semanticClassification rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Manner" /><aaif:reduplicated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:reduplicated><aaif:prepositionalPhrase rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:prepositionalPhrase></aaif:Adverb><aaif:Entry rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En1391"><aaif:phrase rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh#En1391Ph1" /><aaif:source rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh.bibl#Cnde263" /><gams:textualContent>violencia porque un arria de perros atravesaba la avenida, llevados por tres hombres de uniforme rojo que tenían , fuertes , en las manos, las traíllas.</gams:textualContent><rel:isPartOf rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh" /></aaif:Entry><aaif:Phrase rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En1391Ph1"><aaif:verb rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh#En1391Ph1Ve1" /><aaif:adverb rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh#En1391Ph1Ad1" /><aaif:text>llevados por tres hombres de uniforme rojo que tenían , fuertes , en las manos, las traíllas</aaif:text><aaif:annoText>llevados por tres hombres de uniforme rojo que [v|tenían|tener|ts] , [a|fuertes|fuerte|apsnmnnn] , en las manos, las traíllas</aaif:annoText></aaif:Phrase><aaif:Verb rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En1391Ph1Ve1"><aaif:text>tenían</aaif:text><aaif:lemma rdf:resource="https://gams.uni-graz.at/o:aaif.lemma#tener" /><aaif:position rdf:datatype="http://www.w3.org/2001/XMLSchema#int">1</aaif:position><aaif:coordinated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:coordinated><aaif:partOfText rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</aaif:partOfText><aaif:syntacticConstruction rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Transitive" /></aaif:Verb><aaif:Adverb rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En1391Ph1Ad1"><aaif:text>fuertes</aaif:text><aaif:lemma rdf:resource="https://gams.uni-graz.at/o:aaif.lemma#fuerte" /><aaif:position rdf:datatype="http://www.w3.org/2001/XMLSchema#int">2</aaif:position><aaif:coordinated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:coordinated><aaif:morphosyntacticStructure rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Adjective" /><aaif:inflection rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#MasculinePlural" /><aaif:attributionTarget rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Verb" /><aaif:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:modified><aaif:semanticClassification rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Manner" /><aaif:reduplicated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:reduplicated><aaif:prepositionalPhrase rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:prepositionalPhrase></aaif:Adverb><aaif:Entry rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En1392"><aaif:phrase rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh#En1392Ph1" /><aaif:source rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh.bibl#Cnde230" /><gams:textualContent>un murmullo empezó a resonar desde el sitio que ocupaban los criollos. Fray Servando lució muy grandioso cuando  pateó  fuerte detrás del altar para imponer el respeto necesario.Y muchas damas se desmayaron ante aquella prueba de viril</gams:textualContent><rel:isPartOf rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh" /></aaif:Entry><aaif:Phrase rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En1392Ph1"><aaif:subject rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh#En1392Ph1Su1" /><aaif:verb rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh#En1392Ph1Ve1" /><aaif:adverb rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh#En1392Ph1Ad1" /><aaif:text> Fray Servando lució muy grandioso cuando  pateó  fuerte detrás del altar</aaif:text><aaif:annoText> [s|Fray Servando|ms] lució muy grandioso cuando  [v|pateó|patear|is]  [a|fuerte|fuerte|auvnmnnn] detrás del altar</aaif:annoText></aaif:Phrase><aaif:Subject rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En1392Ph1Su1"><aaif:text>Fray Servando</aaif:text><aaif:position rdf:datatype="http://www.w3.org/2001/XMLSchema#int">1</aaif:position><aaif:gender rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Masculine" /><aaif:number rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Singular" /><aaif:overt rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</aaif:overt></aaif:Subject><aaif:Verb rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En1392Ph1Ve1"><aaif:text>pateó</aaif:text><aaif:lemma rdf:resource="https://gams.uni-graz.at/o:aaif.lemma#patear" /><aaif:position rdf:datatype="http://www.w3.org/2001/XMLSchema#int">2</aaif:position><aaif:coordinated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:coordinated><aaif:partOfText rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</aaif:partOfText><aaif:syntacticConstruction rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Intransitive" /></aaif:Verb><aaif:Adverb rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En1392Ph1Ad1"><aaif:text>fuerte</aaif:text><aaif:lemma rdf:resource="https://gams.uni-graz.at/o:aaif.lemma#fuerte" /><aaif:position rdf:datatype="http://www.w3.org/2001/XMLSchema#int">3</aaif:position><aaif:coordinated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:coordinated><aaif:morphosyntacticStructure rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Adjective" /><aaif:inflection rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Uninflected" /><aaif:attributionTarget rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Verb" /><aaif:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:modified><aaif:semanticClassification rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Manner" /><aaif:reduplicated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:reduplicated><aaif:prepositionalPhrase rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:prepositionalPhrase></aaif:Adverb><aaif:Entry rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En1393"><aaif:phrase rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh#En1393Ph1" /><aaif:source rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh.bibl#Cnde53" /><gams:textualContent>desde hacía algún tiempo, prefería la ruidosa mesa de  los solteros que pasaban de la treintena y que jugaban fuerte  (a veces a peseta el tanto) al ramiro, o al julepe, o al cuarenta y dos</gams:textualContent><rel:isPartOf rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh" /></aaif:Entry><aaif:Phrase rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En1393Ph1"><aaif:subject rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh#En1393Ph1Su1" /><aaif:verb rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh#En1393Ph1Ve1" /><aaif:adverb rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh#En1393Ph1Ad1" /><aaif:text> los solteros que pasaban de la treintena y que jugaban fuerte </aaif:text><aaif:annoText> [s|los solteros|mp] que pasaban de la treintena y que [v|jugaban|jugar|is] [a|fuerte|fuerte|auvnmnnn] </aaif:annoText></aaif:Phrase><aaif:Subject rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En1393Ph1Su1"><aaif:text>los solteros</aaif:text><aaif:position rdf:datatype="http://www.w3.org/2001/XMLSchema#int">1</aaif:position><aaif:gender rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Masculine" /><aaif:number rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Plural" /><aaif:overt rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</aaif:overt></aaif:Subject><aaif:Verb rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En1393Ph1Ve1"><aaif:text>jugaban</aaif:text><aaif:lemma rdf:resource="https://gams.uni-graz.at/o:aaif.lemma#jugar" /><aaif:position rdf:datatype="http://www.w3.org/2001/XMLSchema#int">2</aaif:position><aaif:coordinated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:coordinated><aaif:partOfText rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</aaif:partOfText><aaif:syntacticConstruction rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Intransitive" /></aaif:Verb><aaif:Adverb rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En1393Ph1Ad1"><aaif:text>fuerte</aaif:text><aaif:lemma rdf:resource="https://gams.uni-graz.at/o:aaif.lemma#fuerte" /><aaif:position rdf:datatype="http://www.w3.org/2001/XMLSchema#int">3</aaif:position><aaif:coordinated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:coordinated><aaif:morphosyntacticStructure rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Adjective" /><aaif:inflection rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Uninflected" /><aaif:attributionTarget rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Verb" /><aaif:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:modified><aaif:semanticClassification rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Manner" /><aaif:reduplicated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:reduplicated><aaif:prepositionalPhrase rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:prepositionalPhrase></aaif:Adverb><aaif:Entry rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En1394"><aaif:phrase rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh#En1394Ph1" /><aaif:source rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh.bibl#Cnde53" /><gams:textualContent>Llevaba unos zapatos blancos de tacón alto que Manolo nunca le había visto. El sol  pegaba fuerte en la pared trasera del jardín, mientras rodeaban el chalet, y ella iba a su lado en silencio</gams:textualContent><rel:isPartOf rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh" /></aaif:Entry><aaif:Phrase rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En1394Ph1"><aaif:subject rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh#En1394Ph1Su1" /><aaif:verb rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh#En1394Ph1Ve1" /><aaif:adverb rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh#En1394Ph1Ad1" /><aaif:text> El sol  pegaba fuerte en la pared trasera del jardín</aaif:text><aaif:annoText> [s|El sol|ms]  [v|pegaba|pegar|is] [a|fuerte|fuerte|auvnmnnn] en la pared trasera del jardín</aaif:annoText></aaif:Phrase><aaif:Subject rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En1394Ph1Su1"><aaif:text>El sol</aaif:text><aaif:position rdf:datatype="http://www.w3.org/2001/XMLSchema#int">1</aaif:position><aaif:gender rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Masculine" /><aaif:number rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Singular" /><aaif:overt rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</aaif:overt></aaif:Subject><aaif:Verb rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En1394Ph1Ve1"><aaif:text>pegaba</aaif:text><aaif:lemma rdf:resource="https://gams.uni-graz.at/o:aaif.lemma#pegar" /><aaif:position rdf:datatype="http://www.w3.org/2001/XMLSchema#int">2</aaif:position><aaif:coordinated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:coordinated><aaif:partOfText rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</aaif:partOfText><aaif:syntacticConstruction rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Intransitive" /></aaif:Verb><aaif:Adverb rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En1394Ph1Ad1"><aaif:text>fuerte</aaif:text><aaif:lemma rdf:resource="https://gams.uni-graz.at/o:aaif.lemma#fuerte" /><aaif:position rdf:datatype="http://www.w3.org/2001/XMLSchema#int">3</aaif:position><aaif:coordinated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:coordinated><aaif:morphosyntacticStructure rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Adjective" /><aaif:inflection rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Uninflected" /><aaif:attributionTarget rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Verb" /><aaif:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:modified><aaif:semanticClassification rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Manner" /><aaif:reduplicated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:reduplicated><aaif:prepositionalPhrase rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:prepositionalPhrase></aaif:Adverb><aaif:Entry rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En1395"><aaif:phrase rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh#En1395Ph1" /><aaif:source rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh.bibl#Cnde53" /><gams:textualContent>jamás había conducido a ninguna parte.Era por la mañana, cerca de las once, y  el sol  pegaba fuerte .El ruido de la fábrica le devolvía a Manolo la nostalgia invernal de cierto callejear y la turbadora imagen</gams:textualContent><rel:isPartOf rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh" /></aaif:Entry><aaif:Phrase rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En1395Ph1"><aaif:subject rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh#En1395Ph1Su1" /><aaif:verb rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh#En1395Ph1Ve1" /><aaif:adverb rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh#En1395Ph1Ad1" /><aaif:text> el sol  pegaba fuerte </aaif:text><aaif:annoText> [s|el sol|ms]  [v|pegaba|pegar|is] [a|fuerte|fuerte|auvnmnnn] </aaif:annoText></aaif:Phrase><aaif:Subject rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En1395Ph1Su1"><aaif:text>el sol</aaif:text><aaif:position rdf:datatype="http://www.w3.org/2001/XMLSchema#int">1</aaif:position><aaif:gender rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Masculine" /><aaif:number rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Singular" /><aaif:overt rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</aaif:overt></aaif:Subject><aaif:Verb rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En1395Ph1Ve1"><aaif:text>pegaba</aaif:text><aaif:lemma rdf:resource="https://gams.uni-graz.at/o:aaif.lemma#pegar" /><aaif:position rdf:datatype="http://www.w3.org/2001/XMLSchema#int">2</aaif:position><aaif:coordinated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:coordinated><aaif:partOfText rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</aaif:partOfText><aaif:syntacticConstruction rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Intransitive" /></aaif:Verb><aaif:Adverb rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En1395Ph1Ad1"><aaif:text>fuerte</aaif:text><aaif:lemma rdf:resource="https://gams.uni-graz.at/o:aaif.lemma#fuerte" /><aaif:position rdf:datatype="http://www.w3.org/2001/XMLSchema#int">3</aaif:position><aaif:coordinated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:coordinated><aaif:morphosyntacticStructure rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Adjective" /><aaif:inflection rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Uninflected" /><aaif:attributionTarget rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Verb" /><aaif:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:modified><aaif:semanticClassification rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Manner" /><aaif:reduplicated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:reduplicated><aaif:prepositionalPhrase rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:prepositionalPhrase></aaif:Adverb><aaif:Entry rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En1396"><aaif:phrase rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh#En1396Ph1" /><aaif:source rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh.bibl#Cnde53" /><gams:textualContent>suelo muy despacio, decía: “Ven, ven aquí, échate a mi lado, así, abrázame fuerte ...Y ahora escucha, Teresa”.</gams:textualContent><rel:isPartOf rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh" /></aaif:Entry><aaif:Phrase rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En1396Ph1"><aaif:verb rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh#En1396Ph1Ve1" /><aaif:adverb rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh#En1396Ph1Ad1" /><aaif:text>Ven, ven aquí, échate a mi lado, así, abrázame fuerte </aaif:text><aaif:annoText>Ven, ven aquí, échate a mi lado, así, [v|abrázame|abrazar|ts] [a|fuerte|fuerte|auvnmnnn] </aaif:annoText></aaif:Phrase><aaif:Verb rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En1396Ph1Ve1"><aaif:text>abrázame</aaif:text><aaif:lemma rdf:resource="https://gams.uni-graz.at/o:aaif.lemma#abrazar" /><aaif:position rdf:datatype="http://www.w3.org/2001/XMLSchema#int">1</aaif:position><aaif:coordinated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:coordinated><aaif:partOfText rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</aaif:partOfText><aaif:syntacticConstruction rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Transitive" /></aaif:Verb><aaif:Adverb rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En1396Ph1Ad1"><aaif:text>fuerte</aaif:text><aaif:lemma rdf:resource="https://gams.uni-graz.at/o:aaif.lemma#fuerte" /><aaif:position rdf:datatype="http://www.w3.org/2001/XMLSchema#int">2</aaif:position><aaif:coordinated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:coordinated><aaif:morphosyntacticStructure rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Adjective" /><aaif:inflection rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Uninflected" /><aaif:attributionTarget rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Verb" /><aaif:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:modified><aaif:semanticClassification rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Manner" /><aaif:reduplicated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:reduplicated><aaif:prepositionalPhrase rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:prepositionalPhrase></aaif:Adverb><aaif:Entry rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En1397"><aaif:phrase rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh#En1397Ph1" /><aaif:source rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh.bibl#Cnde53" /><gams:textualContent>a través de la leve tela de la camisa una ternura de bestezuela asustada.”¡Agárrate, niña , agárrate fuerte !”, le gritaba él.La muchacha no dijo nada en todo el rato: le abrazaba.</gams:textualContent><rel:isPartOf rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh" /></aaif:Entry><aaif:Phrase rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En1397Ph1"><aaif:subject rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh#En1397Ph1Su1" /><aaif:verb rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh#En1397Ph1Ve1" /><aaif:adverb rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh#En1397Ph1Ad1" /><aaif:text>¡Agárrate, niña , agárrate fuerte </aaif:text><aaif:annoText>¡Agárrate, [s|niña|fs] , [v|agárrate|agarrar|rs] [a|fuerte|fuerte|auvnmnnn] </aaif:annoText></aaif:Phrase><aaif:Subject rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En1397Ph1Su1"><aaif:text>niña</aaif:text><aaif:position rdf:datatype="http://www.w3.org/2001/XMLSchema#int">1</aaif:position><aaif:gender rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Feminine" /><aaif:number rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Singular" /><aaif:overt rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</aaif:overt></aaif:Subject><aaif:Verb rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En1397Ph1Ve1"><aaif:text>agárrate</aaif:text><aaif:lemma rdf:resource="https://gams.uni-graz.at/o:aaif.lemma#agarrar" /><aaif:position rdf:datatype="http://www.w3.org/2001/XMLSchema#int">2</aaif:position><aaif:coordinated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:coordinated><aaif:partOfText rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</aaif:partOfText><aaif:syntacticConstruction rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Reflexive" /></aaif:Verb><aaif:Adverb rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En1397Ph1Ad1"><aaif:text>fuerte</aaif:text><aaif:lemma rdf:resource="https://gams.uni-graz.at/o:aaif.lemma#fuerte" /><aaif:position rdf:datatype="http://www.w3.org/2001/XMLSchema#int">3</aaif:position><aaif:coordinated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:coordinated><aaif:morphosyntacticStructure rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Adjective" /><aaif:inflection rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Uninflected" /><aaif:attributionTarget rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Verb" /><aaif:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:modified><aaif:semanticClassification rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Manner" /><aaif:reduplicated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:reduplicated><aaif:prepositionalPhrase rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:prepositionalPhrase></aaif:Adverb><aaif:Entry rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En1398"><aaif:phrase rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh#En1398Ph1" /><aaif:source rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh.bibl#Cnde119" /><gams:textualContent> Tosió  fuerte aunque sintió que tenía que aguantarse, pero algo, probablemente arena, como en la boca y los labios</gams:textualContent><rel:isPartOf rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh" /></aaif:Entry><aaif:Phrase rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En1398Ph1"><aaif:verb rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh#En1398Ph1Ve1" /><aaif:adverb rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh#En1398Ph1Ad1" /><aaif:text> Tosió  fuerte aunque sintió que tenía que aguantarse</aaif:text><aaif:annoText> [v|Tosió|toser|is]  [a|fuerte|fuerte|auvnmnnn] aunque sintió que tenía que aguantarse</aaif:annoText></aaif:Phrase><aaif:Verb rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En1398Ph1Ve1"><aaif:text>Tosió</aaif:text><aaif:lemma rdf:resource="https://gams.uni-graz.at/o:aaif.lemma#toser" /><aaif:position rdf:datatype="http://www.w3.org/2001/XMLSchema#int">1</aaif:position><aaif:coordinated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:coordinated><aaif:partOfText rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</aaif:partOfText><aaif:syntacticConstruction rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Intransitive" /></aaif:Verb><aaif:Adverb rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En1398Ph1Ad1"><aaif:text>fuerte</aaif:text><aaif:lemma rdf:resource="https://gams.uni-graz.at/o:aaif.lemma#fuerte" /><aaif:position rdf:datatype="http://www.w3.org/2001/XMLSchema#int">2</aaif:position><aaif:coordinated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:coordinated><aaif:morphosyntacticStructure rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Adjective" /><aaif:inflection rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Uninflected" /><aaif:attributionTarget rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Verb" /><aaif:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:modified><aaif:semanticClassification rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Manner" /><aaif:reduplicated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:reduplicated><aaif:prepositionalPhrase rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:prepositionalPhrase></aaif:Adverb><aaif:Entry rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En1399"><aaif:phrase rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh#En1399Ph1" /><aaif:source rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh.bibl#Cnde119" /><gams:textualContent>oficiales en silencio, también las de la tropa—.Bien —vuelve a repetir, respira hondo , tose fuerte , escupe con energía siguiendo con la mirada el recorrido del salivazo.Avanza unos pasos, frota la</gams:textualContent><rel:isPartOf rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh" /></aaif:Entry><aaif:Phrase rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En1399Ph1"><aaif:verb rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh#En1399Ph1Ve1" /><aaif:verb rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh#En1399Ph1Ve2" /><aaif:adverb rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh#En1399Ph1Ad1" /><aaif:adverb rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh#En1399Ph1Ad2" /><aaif:text>vuelve a repetir, respira hondo , tose fuerte </aaif:text><aaif:annoText>vuelve a repetir, [v|respira|respirar|is] [a|hondo|hondo|auvnmnnn] , [v|tose|toser|is] [a|fuerte|fuerte|auvnmnnn] </aaif:annoText></aaif:Phrase><aaif:Verb rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En1399Ph1Ve1"><aaif:text>respira</aaif:text><aaif:lemma rdf:resource="https://gams.uni-graz.at/o:aaif.lemma#respirar" /><aaif:position rdf:datatype="http://www.w3.org/2001/XMLSchema#int">1</aaif:position><aaif:coordinated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:coordinated><aaif:partOfText rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</aaif:partOfText><aaif:syntacticConstruction rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Intransitive" /></aaif:Verb><aaif:Verb rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En1399Ph1Ve2"><aaif:text>tose</aaif:text><aaif:lemma rdf:resource="https://gams.uni-graz.at/o:aaif.lemma#toser" /><aaif:position rdf:datatype="http://www.w3.org/2001/XMLSchema#int">3</aaif:position><aaif:coordinated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:coordinated><aaif:partOfText rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</aaif:partOfText><aaif:syntacticConstruction rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Intransitive" /></aaif:Verb><aaif:Adverb rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En1399Ph1Ad1"><aaif:text>hondo</aaif:text><aaif:lemma rdf:resource="https://gams.uni-graz.at/o:aaif.lemma#hondo" /><aaif:position rdf:datatype="http://www.w3.org/2001/XMLSchema#int">2</aaif:position><aaif:coordinated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:coordinated><aaif:morphosyntacticStructure rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Adjective" /><aaif:inflection rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Uninflected" /><aaif:attributionTarget rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Verb" /><aaif:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:modified><aaif:semanticClassification rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Manner" /><aaif:reduplicated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:reduplicated><aaif:prepositionalPhrase rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:prepositionalPhrase></aaif:Adverb><aaif:Adverb rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En1399Ph1Ad2"><aaif:text>fuerte</aaif:text><aaif:lemma rdf:resource="https://gams.uni-graz.at/o:aaif.lemma#fuerte" /><aaif:position rdf:datatype="http://www.w3.org/2001/XMLSchema#int">4</aaif:position><aaif:coordinated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:coordinated><aaif:morphosyntacticStructure rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Adjective" /><aaif:inflection rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Uninflected" /><aaif:attributionTarget rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Verb" /><aaif:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:modified><aaif:semanticClassification rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Manner" /><aaif:reduplicated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:reduplicated><aaif:prepositionalPhrase rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:prepositionalPhrase></aaif:Adverb><aaif:Entry rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En1400"><aaif:phrase rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh#En1400Ph1" /><aaif:source rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh.bibl#Cnde528" /><gams:textualContent>hacía tiempo una Flauta que ya nadie tocaba, hasta que un día un Burro que paseaba por ahí resopló fuerte sobre ella haciéndola producir el sonido más dulce de su vida, es decir, de la vida del</gams:textualContent><rel:isPartOf rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh" /></aaif:Entry><aaif:Phrase rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En1400Ph1"><aaif:subject rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh#En1400Ph1Su1" /><aaif:verb rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh#En1400Ph1Ve1" /><aaif:adverb rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh#En1400Ph1Ad1" /><aaif:text>hasta que un día un Burro que paseaba por ahí resopló fuerte sobre ella</aaif:text><aaif:annoText>hasta que un día [s|un Burro|ms] que paseaba por ahí [v|resopló|respolar|is] [a|fuerte|fuerte|auvnmnnn] sobre ella</aaif:annoText></aaif:Phrase><aaif:Subject rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En1400Ph1Su1"><aaif:text>un Burro</aaif:text><aaif:position rdf:datatype="http://www.w3.org/2001/XMLSchema#int">1</aaif:position><aaif:gender rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Masculine" /><aaif:number rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Singular" /><aaif:overt rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</aaif:overt></aaif:Subject><aaif:Verb rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En1400Ph1Ve1"><aaif:text>resopló</aaif:text><aaif:lemma rdf:resource="https://gams.uni-graz.at/o:aaif.lemma#respolar" /><aaif:position rdf:datatype="http://www.w3.org/2001/XMLSchema#int">2</aaif:position><aaif:coordinated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:coordinated><aaif:partOfText rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</aaif:partOfText><aaif:syntacticConstruction rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Intransitive" /></aaif:Verb><aaif:Adverb rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En1400Ph1Ad1"><aaif:text>fuerte</aaif:text><aaif:lemma rdf:resource="https://gams.uni-graz.at/o:aaif.lemma#fuerte" /><aaif:position rdf:datatype="http://www.w3.org/2001/XMLSchema#int">3</aaif:position><aaif:coordinated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:coordinated><aaif:morphosyntacticStructure rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Adjective" /><aaif:inflection rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Uninflected" /><aaif:attributionTarget rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Verb" /><aaif:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:modified><aaif:semanticClassification rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Manner" /><aaif:reduplicated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:reduplicated><aaif:prepositionalPhrase rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:prepositionalPhrase></aaif:Adverb><aaif:Entry rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En1401"><aaif:phrase rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh#En1401Ph1" /><aaif:source rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh.bibl#Cnde55" /><gams:textualContent>Sólo que el examen de ingreso era tan difícil, se presentaban montones y entraban poquísimos.Pero él chancaría fuerte , papá, y a lo mejor ingresaba.El senador estaba contento de que hubiera terminado el colegio sin</gams:textualContent><rel:isPartOf rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh" /></aaif:Entry><aaif:Phrase rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En1401Ph1"><aaif:subject rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh#En1401Ph1Su1" /><aaif:verb rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh#En1401Ph1Ve1" /><aaif:adverb rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh#En1401Ph1Ad1" /><aaif:text>Pero él chancaría fuerte </aaif:text><aaif:annoText>Pero [s|él|ms] [v|chancaría|chancar|is] [a|fuerte|fuerte|auvnmnnn] </aaif:annoText></aaif:Phrase><aaif:Subject rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En1401Ph1Su1"><aaif:text>él</aaif:text><aaif:position rdf:datatype="http://www.w3.org/2001/XMLSchema#int">1</aaif:position><aaif:gender rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Masculine" /><aaif:number rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Singular" /><aaif:overt rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</aaif:overt></aaif:Subject><aaif:Verb rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En1401Ph1Ve1"><aaif:text>chancaría</aaif:text><aaif:lemma rdf:resource="https://gams.uni-graz.at/o:aaif.lemma#chancar" /><aaif:position rdf:datatype="http://www.w3.org/2001/XMLSchema#int">2</aaif:position><aaif:coordinated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:coordinated><aaif:partOfText rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</aaif:partOfText><aaif:syntacticConstruction rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Intransitive" /></aaif:Verb><aaif:Adverb rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En1401Ph1Ad1"><aaif:text>fuerte</aaif:text><aaif:lemma rdf:resource="https://gams.uni-graz.at/o:aaif.lemma#fuerte" /><aaif:position rdf:datatype="http://www.w3.org/2001/XMLSchema#int">3</aaif:position><aaif:coordinated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:coordinated><aaif:morphosyntacticStructure rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Adjective" /><aaif:inflection rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Uninflected" /><aaif:attributionTarget rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Verb" /><aaif:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:modified><aaif:semanticClassification rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Manner" /><aaif:reduplicated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:reduplicated><aaif:prepositionalPhrase rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:prepositionalPhrase></aaif:Adverb><aaif:Entry rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En1402"><aaif:phrase rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh#En1402Ph1" /><aaif:source rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh.bibl#Cnde55" /><gams:textualContent>ingresar a Arquitectura mejor no se arriesgaba este año, que se matriculara en los cursos de Pre y estudiara fuerte , y así el próximo año entrarás seguro: ¿qué le parecía, pecoso?Bestial, papá,</gams:textualContent><rel:isPartOf rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh" /></aaif:Entry><aaif:Phrase rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En1402Ph1"><aaif:verb rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh#En1402Ph1Ve1" /><aaif:adverb rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh#En1402Ph1Ad1" /><aaif:text>que se matriculara en los cursos de Pre y estudiara fuerte </aaif:text><aaif:annoText>que se matriculara en los cursos de Pre y [v|estudiara|estudiar|is] [a|fuerte|fuerte|auvnmnnn] </aaif:annoText></aaif:Phrase><aaif:Verb rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En1402Ph1Ve1"><aaif:text>estudiara</aaif:text><aaif:lemma rdf:resource="https://gams.uni-graz.at/o:aaif.lemma#estudiar" /><aaif:position rdf:datatype="http://www.w3.org/2001/XMLSchema#int">1</aaif:position><aaif:coordinated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:coordinated><aaif:partOfText rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</aaif:partOfText><aaif:syntacticConstruction rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Intransitive" /></aaif:Verb><aaif:Adverb rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En1402Ph1Ad1"><aaif:text>fuerte</aaif:text><aaif:lemma rdf:resource="https://gams.uni-graz.at/o:aaif.lemma#fuerte" /><aaif:position rdf:datatype="http://www.w3.org/2001/XMLSchema#int">2</aaif:position><aaif:coordinated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:coordinated><aaif:morphosyntacticStructure rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Adjective" /><aaif:inflection rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Uninflected" /><aaif:attributionTarget rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Verb" /><aaif:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:modified><aaif:semanticClassification rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Manner" /><aaif:reduplicated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:reduplicated><aaif:prepositionalPhrase rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:prepositionalPhrase></aaif:Adverb><aaif:Entry rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En1403"><aaif:phrase rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh#En1403Ph1" /><aaif:source rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh.bibl#Cnde55" /><gams:textualContent>Todavía no eras, piensa, querías ser comunista.Sentía su corazón golpeando fuerte  y estaba maravillado: en San Marcos no se estudia nada, flaco, sólo se hacía política, era una</gams:textualContent><rel:isPartOf rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh" /></aaif:Entry><aaif:Phrase rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En1403Ph1"><aaif:verb rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh#En1403Ph1Ve1" /><aaif:adverb rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh#En1403Ph1Ad1" /><aaif:text>Sentía su corazón golpeando fuerte </aaif:text><aaif:annoText>Sentía su corazón [v|golpeando|golpear|is] [a|fuerte|fuerte|auvnmnnn] </aaif:annoText></aaif:Phrase><aaif:Verb rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En1403Ph1Ve1"><aaif:text>golpeando</aaif:text><aaif:lemma rdf:resource="https://gams.uni-graz.at/o:aaif.lemma#golpear" /><aaif:position rdf:datatype="http://www.w3.org/2001/XMLSchema#int">1</aaif:position><aaif:coordinated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:coordinated><aaif:partOfText rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</aaif:partOfText><aaif:syntacticConstruction rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Intransitive" /></aaif:Verb><aaif:Adverb rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En1403Ph1Ad1"><aaif:text>fuerte</aaif:text><aaif:lemma rdf:resource="https://gams.uni-graz.at/o:aaif.lemma#fuerte" /><aaif:position rdf:datatype="http://www.w3.org/2001/XMLSchema#int">2</aaif:position><aaif:coordinated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:coordinated><aaif:morphosyntacticStructure rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Adjective" /><aaif:inflection rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Uninflected" /><aaif:attributionTarget rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Verb" /><aaif:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:modified><aaif:semanticClassification rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Manner" /><aaif:reduplicated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:reduplicated><aaif:prepositionalPhrase rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:prepositionalPhrase></aaif:Adverb><aaif:Entry rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En1404"><aaif:phrase rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh#En1404Ph1" /><aaif:source rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh.bibl#Cnde55" /><gams:textualContent>— Pues mejor se desaparece de aquí porque tengo malas pulgas, tú ya sabes —colérico ahora, respirando fuerte —.De repente me caliento y le meto bala.Te lo quería advertir, por si acaso.</gams:textualContent><rel:isPartOf rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh" /></aaif:Entry><aaif:Phrase rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En1404Ph1"><aaif:verb rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh#En1404Ph1Ve1" /><aaif:adverb rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh#En1404Ph1Ad1" /><aaif:text>colérico ahora, respirando fuerte </aaif:text><aaif:annoText>colérico ahora, [v|respirando|respirar|is] [a|fuerte|fuerte|auvnmnnn] </aaif:annoText></aaif:Phrase><aaif:Verb rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En1404Ph1Ve1"><aaif:text>respirando</aaif:text><aaif:lemma rdf:resource="https://gams.uni-graz.at/o:aaif.lemma#respirar" /><aaif:position rdf:datatype="http://www.w3.org/2001/XMLSchema#int">1</aaif:position><aaif:coordinated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:coordinated><aaif:partOfText rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</aaif:partOfText><aaif:syntacticConstruction rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Intransitive" /></aaif:Verb><aaif:Adverb rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En1404Ph1Ad1"><aaif:text>fuerte</aaif:text><aaif:lemma rdf:resource="https://gams.uni-graz.at/o:aaif.lemma#fuerte" /><aaif:position rdf:datatype="http://www.w3.org/2001/XMLSchema#int">2</aaif:position><aaif:coordinated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:coordinated><aaif:morphosyntacticStructure rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Adjective" /><aaif:inflection rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Uninflected" /><aaif:attributionTarget rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Verb" /><aaif:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:modified><aaif:semanticClassification rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Manner" /><aaif:reduplicated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:reduplicated><aaif:prepositionalPhrase rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:prepositionalPhrase></aaif:Adverb><aaif:Entry rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En1405"><aaif:phrase rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh#En1405Ph1" /><aaif:source rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh.bibl#Cnde55" /><gams:textualContent>?Pura risa con él, miraditas y coqueterías, y de pronto, sin darse cuenta, su boca dijo fuerte , mirando a las dos mujeres, no a él: está bien ¿dónde vamos a ir?Ambrosio</gams:textualContent><rel:isPartOf rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh" /></aaif:Entry><aaif:Phrase rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En1405Ph1"><aaif:subject rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh#En1405Ph1Su1" /><aaif:verb rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh#En1405Ph1Ve1" /><aaif:adverb rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh#En1405Ph1Ad1" /><aaif:text>sin darse cuenta, su boca dijo fuerte </aaif:text><aaif:annoText>sin darse cuenta, [s|su boca|ms] [v|dijo|decir|ts] [a|fuerte|fuerte|auvnmnnn] </aaif:annoText></aaif:Phrase><aaif:Subject rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En1405Ph1Su1"><aaif:text>su boca</aaif:text><aaif:position rdf:datatype="http://www.w3.org/2001/XMLSchema#int">1</aaif:position><aaif:gender rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Masculine" /><aaif:number rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Singular" /><aaif:overt rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</aaif:overt></aaif:Subject><aaif:Verb rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En1405Ph1Ve1"><aaif:text>dijo</aaif:text><aaif:lemma rdf:resource="https://gams.uni-graz.at/o:aaif.lemma#decir" /><aaif:position rdf:datatype="http://www.w3.org/2001/XMLSchema#int">2</aaif:position><aaif:coordinated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:coordinated><aaif:partOfText rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</aaif:partOfText><aaif:syntacticConstruction rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Transitive" /></aaif:Verb><aaif:Adverb rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En1405Ph1Ad1"><aaif:text>fuerte</aaif:text><aaif:lemma rdf:resource="https://gams.uni-graz.at/o:aaif.lemma#fuerte" /><aaif:position rdf:datatype="http://www.w3.org/2001/XMLSchema#int">3</aaif:position><aaif:coordinated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:coordinated><aaif:morphosyntacticStructure rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Adjective" /><aaif:inflection rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Uninflected" /><aaif:attributionTarget rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Verb" /><aaif:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:modified><aaif:semanticClassification rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Manner" /><aaif:reduplicated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:reduplicated><aaif:prepositionalPhrase rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:prepositionalPhrase></aaif:Adverb><aaif:Entry rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En1406"><aaif:phrase rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh#En1406Ph1" /><aaif:source rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh.bibl#Cnde55" /><gams:textualContent>la pista.Se mezclaron con las parejas, abrazados, y nunca terminaba la música. Ambrosio la apretaba fuerte , Ambrosio le daba un empujón a un borracho que la había rozado, Ambrosio la besaba en el cuello</gams:textualContent><rel:isPartOf rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh" /></aaif:Entry><aaif:Phrase rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En1406Ph1"><aaif:subject rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh#En1406Ph1Su1" /><aaif:verb rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh#En1406Ph1Ve1" /><aaif:adverb rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh#En1406Ph1Ad1" /><aaif:text> Ambrosio la apretaba fuerte </aaif:text><aaif:annoText> [s|Ambrosio|ms] la [v|apretaba|apretar|ts] [a|fuerte|fuerte|auvnmnnn] </aaif:annoText></aaif:Phrase><aaif:Subject rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En1406Ph1Su1"><aaif:text>Ambrosio</aaif:text><aaif:position rdf:datatype="http://www.w3.org/2001/XMLSchema#int">1</aaif:position><aaif:gender rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Masculine" /><aaif:number rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Singular" /><aaif:overt rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</aaif:overt></aaif:Subject><aaif:Verb rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En1406Ph1Ve1"><aaif:text>apretaba</aaif:text><aaif:lemma rdf:resource="https://gams.uni-graz.at/o:aaif.lemma#apretar" /><aaif:position rdf:datatype="http://www.w3.org/2001/XMLSchema#int">2</aaif:position><aaif:coordinated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:coordinated><aaif:partOfText rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</aaif:partOfText><aaif:syntacticConstruction rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Transitive" /></aaif:Verb><aaif:Adverb rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En1406Ph1Ad1"><aaif:text>fuerte</aaif:text><aaif:lemma rdf:resource="https://gams.uni-graz.at/o:aaif.lemma#fuerte" /><aaif:position rdf:datatype="http://www.w3.org/2001/XMLSchema#int">3</aaif:position><aaif:coordinated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:coordinated><aaif:morphosyntacticStructure rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Adjective" /><aaif:inflection rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Uninflected" /><aaif:attributionTarget rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Verb" /><aaif:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:modified><aaif:semanticClassification rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Manner" /><aaif:reduplicated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:reduplicated><aaif:prepositionalPhrase rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:prepositionalPhrase></aaif:Adverb><aaif:Entry rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En1407"><aaif:phrase rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh#En1407Ph1" /><aaif:source rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh.bibl#Cnde55" /><gams:textualContent>Qué pasaba, Amalia.El señor se había ido de viaje, señora, y el corazón le latió fuerte , le había dejado una cartita arriba.No cambió de color, no se movió.La miraba muy</gams:textualContent><rel:isPartOf rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh" /></aaif:Entry><aaif:Phrase rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En1407Ph1"><aaif:subject rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh#En1407Ph1Su1" /><aaif:verb rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh#En1407Ph1Ve1" /><aaif:adverb rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh#En1407Ph1Ad1" /><aaif:text>y el corazón le latió fuerte </aaif:text><aaif:annoText>y [s|el corazón|ms] le [v|latió|latir|is] [a|fuerte|fuerte|auvnmnnn] </aaif:annoText></aaif:Phrase><aaif:Subject rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En1407Ph1Su1"><aaif:text>el corazón</aaif:text><aaif:position rdf:datatype="http://www.w3.org/2001/XMLSchema#int">1</aaif:position><aaif:gender rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Masculine" /><aaif:number rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Singular" /><aaif:overt rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</aaif:overt></aaif:Subject><aaif:Verb rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En1407Ph1Ve1"><aaif:text>latió</aaif:text><aaif:lemma rdf:resource="https://gams.uni-graz.at/o:aaif.lemma#latir" /><aaif:position rdf:datatype="http://www.w3.org/2001/XMLSchema#int">2</aaif:position><aaif:coordinated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:coordinated><aaif:partOfText rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</aaif:partOfText><aaif:syntacticConstruction rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Intransitive" /></aaif:Verb><aaif:Adverb rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En1407Ph1Ad1"><aaif:text>fuerte</aaif:text><aaif:lemma rdf:resource="https://gams.uni-graz.at/o:aaif.lemma#fuerte" /><aaif:position rdf:datatype="http://www.w3.org/2001/XMLSchema#int">3</aaif:position><aaif:coordinated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:coordinated><aaif:morphosyntacticStructure rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Adjective" /><aaif:inflection rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Uninflected" /><aaif:attributionTarget rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Verb" /><aaif:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:modified><aaif:semanticClassification rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Manner" /><aaif:reduplicated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:reduplicated><aaif:prepositionalPhrase rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:prepositionalPhrase></aaif:Adverb><aaif:Entry rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En1408"><aaif:phrase rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh#En1408Ph1" /><aaif:source rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh.bibl#Cnde55" /><gams:textualContent>había cambiado: las caras.Observaba ansiosamente a hombres y mujeres y había sentido que el pecho le latía fuerte  al ver acercarse a una figura cansada y descalza, con un sombrero de paja y un bastón que</gams:textualContent><rel:isPartOf rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh" /></aaif:Entry><aaif:Phrase rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En1408Ph1"><aaif:subject rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh#En1408Ph1Su1" /><aaif:verb rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh#En1408Ph1Ve1" /><aaif:adverb rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh#En1408Ph1Ad1" /><aaif:text>había sentido que el pecho le latía fuerte </aaif:text><aaif:annoText>había sentido que [s|el pecho|ms] le [v|latía|latir|is] [a|fuerte|fuerte|auvnmnnn] </aaif:annoText></aaif:Phrase><aaif:Subject rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En1408Ph1Su1"><aaif:text>el pecho</aaif:text><aaif:position rdf:datatype="http://www.w3.org/2001/XMLSchema#int">1</aaif:position><aaif:gender rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Masculine" /><aaif:number rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Singular" /><aaif:overt rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</aaif:overt></aaif:Subject><aaif:Verb rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En1408Ph1Ve1"><aaif:text>latía</aaif:text><aaif:lemma rdf:resource="https://gams.uni-graz.at/o:aaif.lemma#latir" /><aaif:position rdf:datatype="http://www.w3.org/2001/XMLSchema#int">2</aaif:position><aaif:coordinated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:coordinated><aaif:partOfText rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</aaif:partOfText><aaif:syntacticConstruction rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Intransitive" /></aaif:Verb><aaif:Adverb rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En1408Ph1Ad1"><aaif:text>fuerte</aaif:text><aaif:lemma rdf:resource="https://gams.uni-graz.at/o:aaif.lemma#fuerte" /><aaif:position rdf:datatype="http://www.w3.org/2001/XMLSchema#int">3</aaif:position><aaif:coordinated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:coordinated><aaif:morphosyntacticStructure rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Adjective" /><aaif:inflection rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Uninflected" /><aaif:attributionTarget rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Verb" /><aaif:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:modified><aaif:semanticClassification rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Manner" /><aaif:reduplicated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:reduplicated><aaif:prepositionalPhrase rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:prepositionalPhrase></aaif:Adverb><aaif:Entry rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En1409"><aaif:phrase rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh#En1409Ph1" /><aaif:source rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh.bibl#Cnde529" /><gams:textualContent>acercó.Yo estaba con mi madre y mi tía: nos cruzamos con unos muchachones y uno le dijo fuerte a los otros:</gams:textualContent><rel:isPartOf rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh" /></aaif:Entry><aaif:Phrase rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En1409Ph1"><aaif:subject rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh#En1409Ph1Su1" /><aaif:verb rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh#En1409Ph1Ve1" /><aaif:adverb rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh#En1409Ph1Ad1" /><aaif:text>nos cruzamos con unos muchachones y uno le dijo fuerte a los otros</aaif:text><aaif:annoText>nos cruzamos con unos muchachones y [s|uno|ms] le [v|dijo|decir|ts] [a|fuerte|fuerte|auvnmnnn] a los otros</aaif:annoText></aaif:Phrase><aaif:Subject rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En1409Ph1Su1"><aaif:text>uno</aaif:text><aaif:position rdf:datatype="http://www.w3.org/2001/XMLSchema#int">1</aaif:position><aaif:gender rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Masculine" /><aaif:number rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Singular" /><aaif:overt rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</aaif:overt></aaif:Subject><aaif:Verb rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En1409Ph1Ve1"><aaif:text>dijo</aaif:text><aaif:lemma rdf:resource="https://gams.uni-graz.at/o:aaif.lemma#decir" /><aaif:position rdf:datatype="http://www.w3.org/2001/XMLSchema#int">2</aaif:position><aaif:coordinated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:coordinated><aaif:partOfText rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</aaif:partOfText><aaif:syntacticConstruction rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Transitive" /></aaif:Verb><aaif:Adverb rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En1409Ph1Ad1"><aaif:text>fuerte</aaif:text><aaif:lemma rdf:resource="https://gams.uni-graz.at/o:aaif.lemma#fuerte" /><aaif:position rdf:datatype="http://www.w3.org/2001/XMLSchema#int">3</aaif:position><aaif:coordinated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:coordinated><aaif:morphosyntacticStructure rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Adjective" /><aaif:inflection rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Uninflected" /><aaif:attributionTarget rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Verb" /><aaif:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:modified><aaif:semanticClassification rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Manner" /><aaif:reduplicated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:reduplicated><aaif:prepositionalPhrase rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:prepositionalPhrase></aaif:Adverb><aaif:Entry rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En1410"><aaif:phrase rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh#En1410Ph1" /><aaif:source rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh.bibl#Cnde6" /><gams:textualContent>, con muchas clases y jardines para lo del fútbol con Morales.Y es que tenían que entrenar fuerte  para que los más grandazos del Inmaculado Corazón jugaran y le ganaran a los más chiquitos del Santa María,</gams:textualContent><rel:isPartOf rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh" /></aaif:Entry><aaif:Phrase rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En1410Ph1"><aaif:verb rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh#En1410Ph1Ve1" /><aaif:adverb rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh#En1410Ph1Ad1" /><aaif:text>Y es que tenían que entrenar fuerte </aaif:text><aaif:annoText>Y es que tenían que [v|entrenar|entrenar|is] [a|fuerte|fuerte|auvnmnnn] </aaif:annoText></aaif:Phrase><aaif:Verb rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En1410Ph1Ve1"><aaif:text>entrenar</aaif:text><aaif:lemma rdf:resource="https://gams.uni-graz.at/o:aaif.lemma#entrenar" /><aaif:position rdf:datatype="http://www.w3.org/2001/XMLSchema#int">1</aaif:position><aaif:coordinated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:coordinated><aaif:partOfText rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</aaif:partOfText><aaif:syntacticConstruction rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Intransitive" /></aaif:Verb><aaif:Adverb rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En1410Ph1Ad1"><aaif:text>fuerte</aaif:text><aaif:lemma rdf:resource="https://gams.uni-graz.at/o:aaif.lemma#fuerte" /><aaif:position rdf:datatype="http://www.w3.org/2001/XMLSchema#int">2</aaif:position><aaif:coordinated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:coordinated><aaif:morphosyntacticStructure rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Adjective" /><aaif:inflection rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Uninflected" /><aaif:attributionTarget rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Verb" /><aaif:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:modified><aaif:semanticClassification rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Manner" /><aaif:reduplicated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:reduplicated><aaif:prepositionalPhrase rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:prepositionalPhrase></aaif:Adverb><aaif:Entry rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En1411"><aaif:phrase rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh#En1411Ph1" /><aaif:source rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh.bibl#Cnde6" /><gams:textualContent>las semanas que precedían a la feria y durante ésta; los limeños querían ser bien entendidos para poder discutir fuerte  durante el mes de octubre y parte de noviembre, después qué mierda y hasta el año entrante.Pero</gams:textualContent><rel:isPartOf rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh" /></aaif:Entry><aaif:Phrase rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En1411Ph1"><aaif:verb rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh#En1411Ph1Ve1" /><aaif:adverb rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh#En1411Ph1Ad1" /><aaif:text>los limeños querían ser bien entendidos para poder discutir fuerte </aaif:text><aaif:annoText>los limeños querían ser bien entendidos para poder [v|discutir|discutir|is] [a|fuerte|fuerte|auvnmnnn] </aaif:annoText></aaif:Phrase><aaif:Verb rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En1411Ph1Ve1"><aaif:text>discutir</aaif:text><aaif:lemma rdf:resource="https://gams.uni-graz.at/o:aaif.lemma#discutir" /><aaif:position rdf:datatype="http://www.w3.org/2001/XMLSchema#int">1</aaif:position><aaif:coordinated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:coordinated><aaif:partOfText rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</aaif:partOfText><aaif:syntacticConstruction rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Intransitive" /></aaif:Verb><aaif:Adverb rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En1411Ph1Ad1"><aaif:text>fuerte</aaif:text><aaif:lemma rdf:resource="https://gams.uni-graz.at/o:aaif.lemma#fuerte" /><aaif:position rdf:datatype="http://www.w3.org/2001/XMLSchema#int">2</aaif:position><aaif:coordinated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:coordinated><aaif:morphosyntacticStructure rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Adjective" /><aaif:inflection rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Uninflected" /><aaif:attributionTarget rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Verb" /><aaif:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:modified><aaif:semanticClassification rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Manner" /><aaif:reduplicated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:reduplicated><aaif:prepositionalPhrase rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:prepositionalPhrase></aaif:Adverb><aaif:Entry rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En1412"><aaif:phrase rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh#En1412Ph1" /><aaif:source rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh.bibl#Cnde6" /><gams:textualContent>— ¡Perfecto!—exclamó Juan Lucas—.Se acabó el piano.A éste le estaba dando fuerte por el arte —agregó, mirando a Capone.</gams:textualContent><rel:isPartOf rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh" /></aaif:Entry><aaif:Phrase rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En1412Ph1"><aaif:verb rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh#En1412Ph1Ve1" /><aaif:adverb rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh#En1412Ph1Ad1" /><aaif:text>A éste le estaba dando fuerte por el arte</aaif:text><aaif:annoText>A éste le estaba [v|dando|dar|is] [a|fuerte|fuerte|auvnmnnn] por el arte</aaif:annoText></aaif:Phrase><aaif:Verb rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En1412Ph1Ve1"><aaif:text>dando</aaif:text><aaif:lemma rdf:resource="https://gams.uni-graz.at/o:aaif.lemma#dar" /><aaif:position rdf:datatype="http://www.w3.org/2001/XMLSchema#int">1</aaif:position><aaif:coordinated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:coordinated><aaif:partOfText rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</aaif:partOfText><aaif:syntacticConstruction rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Intransitive" /></aaif:Verb><aaif:Adverb rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En1412Ph1Ad1"><aaif:text>fuerte</aaif:text><aaif:lemma rdf:resource="https://gams.uni-graz.at/o:aaif.lemma#fuerte" /><aaif:position rdf:datatype="http://www.w3.org/2001/XMLSchema#int">2</aaif:position><aaif:coordinated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:coordinated><aaif:morphosyntacticStructure rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Adjective" /><aaif:inflection rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Uninflected" /><aaif:attributionTarget rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Verb" /><aaif:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:modified><aaif:semanticClassification rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Manner" /><aaif:reduplicated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:reduplicated><aaif:prepositionalPhrase rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:prepositionalPhrase></aaif:Adverb><aaif:Entry rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En1413"><aaif:phrase rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh#En1413Ph1" /><aaif:source rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh.bibl#Cnde6" /><gams:textualContent>que despedía la plancha eléctrica, era agradable, se mezclaba con el calor del sol que seguía quemando fuerte por la ventana, que por momentos dibujaba chispas en los vidrios, ahora que ella se había puesto frente a la</gams:textualContent><rel:isPartOf rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh" /></aaif:Entry><aaif:Phrase rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En1413Ph1"><aaif:verb rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh#En1413Ph1Ve1" /><aaif:adverb rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh#En1413Ph1Ad1" /><aaif:text>el calor del sol que seguía quemando fuerte por la ventana</aaif:text><aaif:annoText>el calor del sol que seguía [v|quemando|quemar|is] [a|fuerte|fuerte|auvnmnnn] por la ventana</aaif:annoText></aaif:Phrase><aaif:Verb rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En1413Ph1Ve1"><aaif:text>quemando</aaif:text><aaif:lemma rdf:resource="https://gams.uni-graz.at/o:aaif.lemma#quemar" /><aaif:position rdf:datatype="http://www.w3.org/2001/XMLSchema#int">1</aaif:position><aaif:coordinated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:coordinated><aaif:partOfText rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</aaif:partOfText><aaif:syntacticConstruction rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Intransitive" /></aaif:Verb><aaif:Adverb rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En1413Ph1Ad1"><aaif:text>fuerte</aaif:text><aaif:lemma rdf:resource="https://gams.uni-graz.at/o:aaif.lemma#fuerte" /><aaif:position rdf:datatype="http://www.w3.org/2001/XMLSchema#int">2</aaif:position><aaif:coordinated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:coordinated><aaif:morphosyntacticStructure rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Adjective" /><aaif:inflection rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Uninflected" /><aaif:attributionTarget rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Verb" /><aaif:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:modified><aaif:semanticClassification rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Manner" /><aaif:reduplicated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:reduplicated><aaif:prepositionalPhrase rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:prepositionalPhrase></aaif:Adverb><aaif:Entry rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En1414"><aaif:phrase rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh#En1414Ph1" /><aaif:source rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh.bibl#Cnde6" /><gams:textualContent>«¡Ajá!», gritó, de pronto, Pericote Siles.Tonelada volteó creyendo haberlo pisado fuerte , pero se encontró con que el otro había sacado el pie y avanzaba feliz entre la gente para abrazarse</gams:textualContent><rel:isPartOf rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh" /></aaif:Entry><aaif:Phrase rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En1414Ph1"><aaif:verb rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh#En1414Ph1Ve1" /><aaif:adverb rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh#En1414Ph1Ad1" /><aaif:text>Tonelada volteó creyendo haberlo pisado fuerte </aaif:text><aaif:annoText>Tonelada volteó creyendo haberlo [v|pisado|pisar|ts] [a|fuerte|fuerte|auvnmnnn] </aaif:annoText></aaif:Phrase><aaif:Verb rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En1414Ph1Ve1"><aaif:text>pisado</aaif:text><aaif:lemma rdf:resource="https://gams.uni-graz.at/o:aaif.lemma#pisar" /><aaif:position rdf:datatype="http://www.w3.org/2001/XMLSchema#int">1</aaif:position><aaif:coordinated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:coordinated><aaif:partOfText rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</aaif:partOfText><aaif:syntacticConstruction rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Transitive" /></aaif:Verb><aaif:Adverb rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En1414Ph1Ad1"><aaif:text>fuerte</aaif:text><aaif:lemma rdf:resource="https://gams.uni-graz.at/o:aaif.lemma#fuerte" /><aaif:position rdf:datatype="http://www.w3.org/2001/XMLSchema#int">2</aaif:position><aaif:coordinated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:coordinated><aaif:morphosyntacticStructure rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Adjective" /><aaif:inflection rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Uninflected" /><aaif:attributionTarget rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Verb" /><aaif:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:modified><aaif:semanticClassification rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Manner" /><aaif:reduplicated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:reduplicated><aaif:prepositionalPhrase rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:prepositionalPhrase></aaif:Adverb><aaif:Entry rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En1415"><aaif:phrase rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh#En1415Ph1" /><aaif:source rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh.bibl#Cnde187" /><gams:textualContent>sus carreras detrás de la pelota.¡Buena, Ricardo!¡Chutéala, Mito!Córrele, córrele fuerte , Lucho, pásala, ahora, chutéala, ya, gol, goooool, agudo chillido de la Mirella</gams:textualContent><rel:isPartOf rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh" /></aaif:Entry><aaif:Phrase rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En1415Ph1"><aaif:verb rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh#En1415Ph1Ve1" /><aaif:adverb rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh#En1415Ph1Ad1" /><aaif:text>Córrele, córrele fuerte , Lucho</aaif:text><aaif:annoText>Córrele, [v|córrele|correr|ts] [a|fuerte|fuerte|auvnmnnn] , Lucho</aaif:annoText></aaif:Phrase><aaif:Verb rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En1415Ph1Ve1"><aaif:text>córrele</aaif:text><aaif:lemma rdf:resource="https://gams.uni-graz.at/o:aaif.lemma#correr" /><aaif:position rdf:datatype="http://www.w3.org/2001/XMLSchema#int">1</aaif:position><aaif:coordinated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:coordinated><aaif:partOfText rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</aaif:partOfText><aaif:syntacticConstruction rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Transitive" /></aaif:Verb><aaif:Adverb rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En1415Ph1Ad1"><aaif:text>fuerte</aaif:text><aaif:lemma rdf:resource="https://gams.uni-graz.at/o:aaif.lemma#fuerte" /><aaif:position rdf:datatype="http://www.w3.org/2001/XMLSchema#int">2</aaif:position><aaif:coordinated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:coordinated><aaif:morphosyntacticStructure rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Adjective" /><aaif:inflection rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Uninflected" /><aaif:attributionTarget rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Verb" /><aaif:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:modified><aaif:semanticClassification rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Manner" /><aaif:reduplicated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:reduplicated><aaif:prepositionalPhrase rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:prepositionalPhrase></aaif:Adverb><aaif:Entry rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En1416"><aaif:phrase rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh#En1416Ph1" /><aaif:source rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh.bibl#Cnde187" /><gams:textualContent>pasearse por el sótano con la guagua en brazos, palmoteándole la espalda para que eche el flato.Iris, pégale fuerte en la espalda a esa vieja cochina mira que si no echa el flato después se hincha y llora y</gams:textualContent><rel:isPartOf rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh" /></aaif:Entry><aaif:Phrase rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En1416Ph1"><aaif:verb rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh#En1416Ph1Ve1" /><aaif:adverb rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh#En1416Ph1Ad1" /><aaif:text>Iris, pégale fuerte en la espalda a esa vieja cochina</aaif:text><aaif:annoText>Iris, [v|pégale|pegar|ts] [a|fuerte|fuerte|auvnmnnn] en la espalda a esa vieja cochina</aaif:annoText></aaif:Phrase><aaif:Verb rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En1416Ph1Ve1"><aaif:text>pégale</aaif:text><aaif:lemma rdf:resource="https://gams.uni-graz.at/o:aaif.lemma#pegar" /><aaif:position rdf:datatype="http://www.w3.org/2001/XMLSchema#int">1</aaif:position><aaif:coordinated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:coordinated><aaif:partOfText rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</aaif:partOfText><aaif:syntacticConstruction rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Transitive" /></aaif:Verb><aaif:Adverb rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En1416Ph1Ad1"><aaif:text>fuerte</aaif:text><aaif:lemma rdf:resource="https://gams.uni-graz.at/o:aaif.lemma#fuerte" /><aaif:position rdf:datatype="http://www.w3.org/2001/XMLSchema#int">2</aaif:position><aaif:coordinated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:coordinated><aaif:morphosyntacticStructure rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Adjective" /><aaif:inflection rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Uninflected" /><aaif:attributionTarget rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Verb" /><aaif:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:modified><aaif:semanticClassification rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Manner" /><aaif:reduplicated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:reduplicated><aaif:prepositionalPhrase rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:prepositionalPhrase></aaif:Adverb><aaif:Entry rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En1417"><aaif:phrase rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh#En1417Ph1" /><aaif:source rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh.bibl#Cnde415" /><gams:textualContent>Era tanta la influencia que ejercía sobre la gente que se tranquilizaron y siguió su perorata.La verdad es que La Trucha se había metido en su sala y cerrado el balcón.¡Dichoso Cabañal de hace sesenta años!, y aun cincuenta, con su café, su dominó y su julepe; algún que otro valiente, sus pescadores y sus cigarreras , que iban en la "perrera" (por los cinco céntimos que costaba el pasaje) hasta la Glorieta cuando todavía la Fábrica de Tabacos estaba en la actual Audiencia, hablando y oliendo fuerte ;viejas, gordas, viejas gordas, hablando a más y mejor, gritando de un extremo a otro del remolque;fondonas, bigotudas, muchas desdentadas, todas pechugonas, con sus entrepanes con tortilla de patatas, longanizas, morcillas, "atún, tomaca y pimiento" aderezado con piñones.Alguna que otra comiendo "tramusos" y cacahuetes.Todas impregnadas de tabaco fuerte.</gams:textualContent><rel:isPartOf rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh" /></aaif:Entry><aaif:Phrase rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En1417Ph1"><aaif:subject rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh#En1417Ph1Su1" /><aaif:verb rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh#En1417Ph1Ve1" /><aaif:verb rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh#En1417Ph1Ve2" /><aaif:adverb rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh#En1417Ph1Ad1" /><aaif:text> algún que otro valiente, sus pescadores y sus cigarreras , que iban en la \"perrera\" (por los cinco céntimos que costaba el pasaje) hasta la Glorieta cuando todavía la Fábrica de Tabacos estaba en la actual Audiencia, hablando y oliendo fuerte </aaif:text><aaif:annoText> [s|algún que otro valiente, sus pescadores y sus cigarreras|mp] , que iban en la \"perrera\" (por los cinco céntimos que costaba el pasaje) hasta la Glorieta cuando todavía la Fábrica de Tabacos estaba en la actual Audiencia, [v|hablando|hablar|is] y [v|oliendo|oler|is] [a|fuerte|fuerte|auvnmnnn] </aaif:annoText></aaif:Phrase><aaif:Subject rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En1417Ph1Su1"><aaif:text>algún que otro valiente, sus pescadores y sus cigarreras</aaif:text><aaif:position rdf:datatype="http://www.w3.org/2001/XMLSchema#int">1</aaif:position><aaif:gender rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Masculine" /><aaif:number rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Plural" /><aaif:overt rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</aaif:overt></aaif:Subject><aaif:Verb rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En1417Ph1Ve1"><aaif:text>hablando</aaif:text><aaif:lemma rdf:resource="https://gams.uni-graz.at/o:aaif.lemma#hablar" /><aaif:position rdf:datatype="http://www.w3.org/2001/XMLSchema#int">2</aaif:position><aaif:coordinated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</aaif:coordinated><aaif:partOfText rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</aaif:partOfText><aaif:syntacticConstruction rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Intransitive" /></aaif:Verb><aaif:Verb rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En1417Ph1Ve2"><aaif:text>oliendo</aaif:text><aaif:lemma rdf:resource="https://gams.uni-graz.at/o:aaif.lemma#oler" /><aaif:position rdf:datatype="http://www.w3.org/2001/XMLSchema#int">3</aaif:position><aaif:coordinated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</aaif:coordinated><aaif:partOfText rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</aaif:partOfText><aaif:syntacticConstruction rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Intransitive" /></aaif:Verb><aaif:Adverb rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En1417Ph1Ad1"><aaif:text>fuerte</aaif:text><aaif:lemma rdf:resource="https://gams.uni-graz.at/o:aaif.lemma#fuerte" /><aaif:position rdf:datatype="http://www.w3.org/2001/XMLSchema#int">4</aaif:position><aaif:coordinated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:coordinated><aaif:morphosyntacticStructure rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Adjective" /><aaif:inflection rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Uninflected" /><aaif:attributionTarget rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Verb" /><aaif:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:modified><aaif:semanticClassification rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Manner" /><aaif:reduplicated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:reduplicated><aaif:prepositionalPhrase rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:prepositionalPhrase></aaif:Adverb><aaif:Entry rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En1418"><aaif:phrase rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh#En1418Ph1" /><aaif:source rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh.bibl#Cnde530" /><gams:textualContent>, él tiene callos en las manos, me hace cosquilla con esos callos tan duros ¡cómo le chumbó fuerte al perro!si un día el patrón se me quiere aprovechar yo corro y lo llamo a Pancho</gams:textualContent><rel:isPartOf rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh" /></aaif:Entry><aaif:Phrase rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En1418Ph1"><aaif:verb rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh#En1418Ph1Ve1" /><aaif:adverb rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh#En1418Ph1Ad1" /><aaif:text>¡cómo le chumbó fuerte al perro!</aaif:text><aaif:annoText>¡cómo le [v|chumbó|chumbar|ts] [a|fuerte|fuerte|auvnmnnn] al perro!</aaif:annoText></aaif:Phrase><aaif:Verb rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En1418Ph1Ve1"><aaif:text>chumbó</aaif:text><aaif:lemma rdf:resource="https://gams.uni-graz.at/o:aaif.lemma#chumbar" /><aaif:position rdf:datatype="http://www.w3.org/2001/XMLSchema#int">1</aaif:position><aaif:coordinated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:coordinated><aaif:partOfText rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</aaif:partOfText><aaif:syntacticConstruction rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Transitive" /></aaif:Verb><aaif:Adverb rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En1418Ph1Ad1"><aaif:text>fuerte</aaif:text><aaif:lemma rdf:resource="https://gams.uni-graz.at/o:aaif.lemma#fuerte" /><aaif:position rdf:datatype="http://www.w3.org/2001/XMLSchema#int">2</aaif:position><aaif:coordinated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:coordinated><aaif:morphosyntacticStructure rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Adjective" /><aaif:inflection rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Uninflected" /><aaif:attributionTarget rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Verb" /><aaif:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:modified><aaif:semanticClassification rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Manner" /><aaif:reduplicated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:reduplicated><aaif:prepositionalPhrase rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:prepositionalPhrase></aaif:Adverb><aaif:Entry rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En1419"><aaif:phrase rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh#En1419Ph1" /><aaif:source rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh.bibl#Cnde530" /><gams:textualContent>si un día el patrón se me quiere aprovechar yo corro y lo llamo a Pancho, se olvidó de ponerse ballenitas en el cuello, se le levantan las puntas, cuando lo vea otra vez le voy a dar ballenitas del patrón, ay qué linda cosquillita, qué besos fuertes que da, ¿será cierto que me quiere?me da carne de gallina después que me besa fuerte y me acaricia despacito...</gams:textualContent><rel:isPartOf rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh" /></aaif:Entry><aaif:Phrase rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En1419Ph1"><aaif:verb rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh#En1419Ph1Ve1" /><aaif:adverb rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh#En1419Ph1Ad1" /><aaif:text>después que me besa fuerte y me acaricia despacito</aaif:text><aaif:annoText>después que me [v|besa|besar|ts] [a|fuerte|fuerte|auvnmnnn] y me acaricia despacito</aaif:annoText></aaif:Phrase><aaif:Verb rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En1419Ph1Ve1"><aaif:text>besa</aaif:text><aaif:lemma rdf:resource="https://gams.uni-graz.at/o:aaif.lemma#besar" /><aaif:position rdf:datatype="http://www.w3.org/2001/XMLSchema#int">1</aaif:position><aaif:coordinated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:coordinated><aaif:partOfText rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</aaif:partOfText><aaif:syntacticConstruction rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Transitive" /></aaif:Verb><aaif:Adverb rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En1419Ph1Ad1"><aaif:text>fuerte</aaif:text><aaif:lemma rdf:resource="https://gams.uni-graz.at/o:aaif.lemma#fuerte" /><aaif:position rdf:datatype="http://www.w3.org/2001/XMLSchema#int">2</aaif:position><aaif:coordinated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:coordinated><aaif:morphosyntacticStructure rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Adjective" /><aaif:inflection rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Uninflected" /><aaif:attributionTarget rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Verb" /><aaif:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:modified><aaif:semanticClassification rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Manner" /><aaif:reduplicated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:reduplicated><aaif:prepositionalPhrase rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:prepositionalPhrase></aaif:Adverb><aaif:Entry rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En1420"><aaif:phrase rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh#En1420Ph1" /><aaif:source rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh.bibl#Cnde57" /><gams:textualContent>de Dios!» Y salió.Entonces,  Bastida se acercó a un rincón de la biblioteca,  agarró  fuerte y tiró de un barrote labrado: todo un panel se desencajó y giró como una puerta.Quedaba al descubierto</gams:textualContent><rel:isPartOf rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh" /></aaif:Entry><aaif:Phrase rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En1420Ph1"><aaif:subject rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh#En1420Ph1Su1" /><aaif:verb rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh#En1420Ph1Ve1" /><aaif:adverb rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh#En1420Ph1Ad1" /><aaif:text> Bastida se acercó a un rincón de la biblioteca,  agarró  fuerte y tiró de un barrote labrado</aaif:text><aaif:annoText> [s|Bastida|us] se acercó a un rincón de la biblioteca,  [v|agarró|agarrar|ts]  [a|fuerte|fuerte|auvnmnnn] y tiró de un barrote labrado</aaif:annoText></aaif:Phrase><aaif:Subject rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En1420Ph1Su1"><aaif:text>Bastida</aaif:text><aaif:position rdf:datatype="http://www.w3.org/2001/XMLSchema#int">1</aaif:position><aaif:gender rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Undefined" /><aaif:number rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Singular" /><aaif:overt rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</aaif:overt></aaif:Subject><aaif:Verb rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En1420Ph1Ve1"><aaif:text>agarró</aaif:text><aaif:lemma rdf:resource="https://gams.uni-graz.at/o:aaif.lemma#agarrar" /><aaif:position rdf:datatype="http://www.w3.org/2001/XMLSchema#int">2</aaif:position><aaif:coordinated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:coordinated><aaif:partOfText rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</aaif:partOfText><aaif:syntacticConstruction rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Transitive" /></aaif:Verb><aaif:Adverb rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En1420Ph1Ad1"><aaif:text>fuerte</aaif:text><aaif:lemma rdf:resource="https://gams.uni-graz.at/o:aaif.lemma#fuerte" /><aaif:position rdf:datatype="http://www.w3.org/2001/XMLSchema#int">3</aaif:position><aaif:coordinated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:coordinated><aaif:morphosyntacticStructure rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Adjective" /><aaif:inflection rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Uninflected" /><aaif:attributionTarget rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Verb" /><aaif:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:modified><aaif:semanticClassification rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Manner" /><aaif:reduplicated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:reduplicated><aaif:prepositionalPhrase rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:prepositionalPhrase></aaif:Adverb><aaif:Entry rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En1421"><aaif:phrase rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh#En1421Ph1" /><aaif:source rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh.bibl#Cnde57" /><gams:textualContent>.«Joseíño, debe de ser muy temprano todavía.»  Él se encogió de hombros, y respiró fuerte .Llegaban al portal, abierto.«José», dijo Julia.«No preguntes.Después</gams:textualContent><rel:isPartOf rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh" /></aaif:Entry><aaif:Phrase rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En1421Ph1"><aaif:subject rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh#En1421Ph1Su1" /><aaif:verb rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh#En1421Ph1Ve1" /><aaif:adverb rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh#En1421Ph1Ad1" /><aaif:text> Él se encogió de hombros, y respiró fuerte </aaif:text><aaif:annoText> [s|Él|ms] se encogió de hombros, y [v|respiró|respirar|is] [a|fuerte|fuerte|auvnmnnn] </aaif:annoText></aaif:Phrase><aaif:Subject rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En1421Ph1Su1"><aaif:text>Él</aaif:text><aaif:position rdf:datatype="http://www.w3.org/2001/XMLSchema#int">1</aaif:position><aaif:gender rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Masculine" /><aaif:number rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Singular" /><aaif:overt rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</aaif:overt></aaif:Subject><aaif:Verb rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En1421Ph1Ve1"><aaif:text>respiró</aaif:text><aaif:lemma rdf:resource="https://gams.uni-graz.at/o:aaif.lemma#respirar" /><aaif:position rdf:datatype="http://www.w3.org/2001/XMLSchema#int">2</aaif:position><aaif:coordinated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:coordinated><aaif:partOfText rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</aaif:partOfText><aaif:syntacticConstruction rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Intransitive" /></aaif:Verb><aaif:Adverb rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En1421Ph1Ad1"><aaif:text>fuerte</aaif:text><aaif:lemma rdf:resource="https://gams.uni-graz.at/o:aaif.lemma#fuerte" /><aaif:position rdf:datatype="http://www.w3.org/2001/XMLSchema#int">3</aaif:position><aaif:coordinated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:coordinated><aaif:morphosyntacticStructure rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Adjective" /><aaif:inflection rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Uninflected" /><aaif:attributionTarget rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Verb" /><aaif:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:modified><aaif:semanticClassification rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Manner" /><aaif:reduplicated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:reduplicated><aaif:prepositionalPhrase rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:prepositionalPhrase></aaif:Adverb><aaif:Entry rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En1422"><aaif:phrase rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh#En1422Ph1" /><aaif:source rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh.bibl#Cnde58" /><gams:textualContent>frente a mi lugar habitual en la mesa, ocupó éste y comenzó a llenarme un plato—. Desayuna  fuerte  y te encontrarás mejor.¿Te has duchado?No, parece que no te has duchado.Es</gams:textualContent><rel:isPartOf rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh" /></aaif:Entry><aaif:Phrase rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En1422Ph1"><aaif:verb rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh#En1422Ph1Ve1" /><aaif:adverb rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh#En1422Ph1Ad1" /><aaif:text> Desayuna  fuerte </aaif:text><aaif:annoText> [v|Desayuna|desayunar|is]  [a|fuerte|fuerte|auonmnnn] </aaif:annoText></aaif:Phrase><aaif:Verb rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En1422Ph1Ve1"><aaif:text>Desayuna</aaif:text><aaif:lemma rdf:resource="https://gams.uni-graz.at/o:aaif.lemma#desayunar" /><aaif:position rdf:datatype="http://www.w3.org/2001/XMLSchema#int">1</aaif:position><aaif:coordinated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:coordinated><aaif:partOfText rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</aaif:partOfText><aaif:syntacticConstruction rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Intransitive" /></aaif:Verb><aaif:Adverb rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En1422Ph1Ad1"><aaif:text>fuerte</aaif:text><aaif:lemma rdf:resource="https://gams.uni-graz.at/o:aaif.lemma#fuerte" /><aaif:position rdf:datatype="http://www.w3.org/2001/XMLSchema#int">2</aaif:position><aaif:coordinated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:coordinated><aaif:morphosyntacticStructure rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Adjective" /><aaif:inflection rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Uninflected" /><aaif:attributionTarget rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#VerbObject" /><aaif:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:modified><aaif:semanticClassification rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Manner" /><aaif:reduplicated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:reduplicated><aaif:prepositionalPhrase rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:prepositionalPhrase></aaif:Adverb><aaif:Entry rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En1423"><aaif:phrase rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh#En1423Ph1" /><aaif:source rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh.bibl#Cnde58" /><gams:textualContent>Es verdad....tú también te acuerdas —se detuvo ante la vería—.Espera.Huele, huele fuerte .Igual que entonces, ¿verdad?—dejó de aspirar el húmedo aire, el olor de la</gams:textualContent><rel:isPartOf rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh" /></aaif:Entry><aaif:Phrase rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En1423Ph1"><aaif:verb rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh#En1423Ph1Ve1" /><aaif:adverb rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh#En1423Ph1Ad1" /><aaif:text>Huele, huele fuerte </aaif:text><aaif:annoText>Huele, [v|huele|oler|is] [a|fuerte|fuerte|auvnmnnn] </aaif:annoText></aaif:Phrase><aaif:Verb rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En1423Ph1Ve1"><aaif:text>huele</aaif:text><aaif:lemma rdf:resource="https://gams.uni-graz.at/o:aaif.lemma#oler" /><aaif:position rdf:datatype="http://www.w3.org/2001/XMLSchema#int">1</aaif:position><aaif:coordinated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:coordinated><aaif:partOfText rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</aaif:partOfText><aaif:syntacticConstruction rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Intransitive" /></aaif:Verb><aaif:Adverb rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En1423Ph1Ad1"><aaif:text>fuerte</aaif:text><aaif:lemma rdf:resource="https://gams.uni-graz.at/o:aaif.lemma#fuerte" /><aaif:position rdf:datatype="http://www.w3.org/2001/XMLSchema#int">2</aaif:position><aaif:coordinated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:coordinated><aaif:morphosyntacticStructure rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Adjective" /><aaif:inflection rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Uninflected" /><aaif:attributionTarget rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Verb" /><aaif:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:modified><aaif:semanticClassification rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Manner" /><aaif:reduplicated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:reduplicated><aaif:prepositionalPhrase rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:prepositionalPhrase></aaif:Adverb><aaif:Entry rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En1424"><aaif:phrase rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh#En1424Ph1" /><aaif:source rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh.bibl#Cnde58" /><gams:textualContent> Mary  rió fuerte , casi bailando de excitación.</gams:textualContent><rel:isPartOf rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh" /></aaif:Entry><aaif:Phrase rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En1424Ph1"><aaif:subject rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh#En1424Ph1Su1" /><aaif:verb rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh#En1424Ph1Ve1" /><aaif:adverb rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh#En1424Ph1Ad1" /><aaif:text> Mary  rió fuerte </aaif:text><aaif:annoText> [s|Mary|fs]  [v|rió|reír|is] [a|fuerte|fuerte|auvnmnnn] </aaif:annoText></aaif:Phrase><aaif:Subject rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En1424Ph1Su1"><aaif:text>Mary</aaif:text><aaif:position rdf:datatype="http://www.w3.org/2001/XMLSchema#int">1</aaif:position><aaif:gender rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Feminine" /><aaif:number rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Singular" /><aaif:overt rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</aaif:overt></aaif:Subject><aaif:Verb rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En1424Ph1Ve1"><aaif:text>rió</aaif:text><aaif:lemma rdf:resource="https://gams.uni-graz.at/o:aaif.lemma#reír" /><aaif:position rdf:datatype="http://www.w3.org/2001/XMLSchema#int">2</aaif:position><aaif:coordinated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:coordinated><aaif:partOfText rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</aaif:partOfText><aaif:syntacticConstruction rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Intransitive" /></aaif:Verb><aaif:Adverb rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En1424Ph1Ad1"><aaif:text>fuerte</aaif:text><aaif:lemma rdf:resource="https://gams.uni-graz.at/o:aaif.lemma#fuerte" /><aaif:position rdf:datatype="http://www.w3.org/2001/XMLSchema#int">3</aaif:position><aaif:coordinated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:coordinated><aaif:morphosyntacticStructure rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Adjective" /><aaif:inflection rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Uninflected" /><aaif:attributionTarget rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Verb" /><aaif:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:modified><aaif:semanticClassification rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Manner" /><aaif:reduplicated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:reduplicated><aaif:prepositionalPhrase rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:prepositionalPhrase></aaif:Adverb><aaif:Entry rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En1425"><aaif:phrase rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh#En1425Ph1" /><aaif:source rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh.bibl#Cnde58" /><gams:textualContent> José María , apoyado en su automóvil, rió fuerte .Pablo, incapaz de contener una sonrisa, le dio una palmada, quizá demasiado enérgica, en el</gams:textualContent><rel:isPartOf rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh" /></aaif:Entry><aaif:Phrase rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En1425Ph1"><aaif:subject rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh#En1425Ph1Su1" /><aaif:verb rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh#En1425Ph1Ve1" /><aaif:adverb rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh#En1425Ph1Ad1" /><aaif:text> José María , apoyado en su automóvil, rió fuerte </aaif:text><aaif:annoText> [s|José María|ms] , apoyado en su automóvil, [v|rió|reír|is] [a|fuerte|fuerte|auvnmnnn] </aaif:annoText></aaif:Phrase><aaif:Subject rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En1425Ph1Su1"><aaif:text>José María</aaif:text><aaif:position rdf:datatype="http://www.w3.org/2001/XMLSchema#int">1</aaif:position><aaif:gender rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Masculine" /><aaif:number rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Singular" /><aaif:overt rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</aaif:overt></aaif:Subject><aaif:Verb rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En1425Ph1Ve1"><aaif:text>rió</aaif:text><aaif:lemma rdf:resource="https://gams.uni-graz.at/o:aaif.lemma#reír" /><aaif:position rdf:datatype="http://www.w3.org/2001/XMLSchema#int">2</aaif:position><aaif:coordinated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:coordinated><aaif:partOfText rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</aaif:partOfText><aaif:syntacticConstruction rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Intransitive" /></aaif:Verb><aaif:Adverb rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En1425Ph1Ad1"><aaif:text>fuerte</aaif:text><aaif:lemma rdf:resource="https://gams.uni-graz.at/o:aaif.lemma#fuerte" /><aaif:position rdf:datatype="http://www.w3.org/2001/XMLSchema#int">3</aaif:position><aaif:coordinated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:coordinated><aaif:morphosyntacticStructure rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Adjective" /><aaif:inflection rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Uninflected" /><aaif:attributionTarget rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Verb" /><aaif:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:modified><aaif:semanticClassification rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Manner" /><aaif:reduplicated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:reduplicated><aaif:prepositionalPhrase rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:prepositionalPhrase></aaif:Adverb><aaif:Entry rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En1426"><aaif:phrase rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh#En1426Ph1" /><aaif:source rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh.bibl#Cnde531" /><gams:textualContent>habían permanecido anclados después del Congreso Cultural de 1968. Había una mesa de jóvenes checos, que bebían fuerte los sábados en la noche y no se mezclaban con nadie.En otra mesa solía divisarse a Pierre Gollendorf,</gams:textualContent><rel:isPartOf rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh" /></aaif:Entry><aaif:Phrase rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En1426Ph1"><aaif:verb rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh#En1426Ph1Ve1" /><aaif:adverb rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh#En1426Ph1Ad1" /><aaif:text>Había una mesa de jóvenes checos, que bebían fuerte los sábados en la noche</aaif:text><aaif:annoText>Había una mesa de jóvenes checos, que [v|bebían|beber|is] [a|fuerte|fuerte|auonmnnn] los sábados en la noche</aaif:annoText></aaif:Phrase><aaif:Verb rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En1426Ph1Ve1"><aaif:text>bebían</aaif:text><aaif:lemma rdf:resource="https://gams.uni-graz.at/o:aaif.lemma#beber" /><aaif:position rdf:datatype="http://www.w3.org/2001/XMLSchema#int">1</aaif:position><aaif:coordinated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:coordinated><aaif:partOfText rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</aaif:partOfText><aaif:syntacticConstruction rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Intransitive" /></aaif:Verb><aaif:Adverb rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En1426Ph1Ad1"><aaif:text>fuerte</aaif:text><aaif:lemma rdf:resource="https://gams.uni-graz.at/o:aaif.lemma#fuerte" /><aaif:position rdf:datatype="http://www.w3.org/2001/XMLSchema#int">2</aaif:position><aaif:coordinated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:coordinated><aaif:morphosyntacticStructure rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Adjective" /><aaif:inflection rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Uninflected" /><aaif:attributionTarget rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#VerbObject" /><aaif:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:modified><aaif:semanticClassification rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Manner" /><aaif:reduplicated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:reduplicated><aaif:prepositionalPhrase rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:prepositionalPhrase></aaif:Adverb><aaif:Entry rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En1427"><aaif:phrase rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh#En1427Ph1" /><aaif:source rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh.bibl#Cnde532" /><gams:textualContent>otro extremo del cuarto, listos para huir siempre hacia cosas fútiles.Y tosen, fuman, hablan fuerte , temerosos del silencio como de un enemigo que al menor descuido pudiera echarse sobre ellos, adherirse</gams:textualContent><rel:isPartOf rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh" /></aaif:Entry><aaif:Phrase rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En1427Ph1"><aaif:verb rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh#En1427Ph1Ve1" /><aaif:adverb rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh#En1427Ph1Ad1" /><aaif:text>Y tosen, fuman, hablan fuerte </aaif:text><aaif:annoText>Y tosen, fuman, [v|hablan|hablar|is] [a|fuerte|fuerte|auvnmnnn] </aaif:annoText></aaif:Phrase><aaif:Verb rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En1427Ph1Ve1"><aaif:text>hablan</aaif:text><aaif:lemma rdf:resource="https://gams.uni-graz.at/o:aaif.lemma#hablar" /><aaif:position rdf:datatype="http://www.w3.org/2001/XMLSchema#int">1</aaif:position><aaif:coordinated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:coordinated><aaif:partOfText rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</aaif:partOfText><aaif:syntacticConstruction rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Intransitive" /></aaif:Verb><aaif:Adverb rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En1427Ph1Ad1"><aaif:text>fuerte</aaif:text><aaif:lemma rdf:resource="https://gams.uni-graz.at/o:aaif.lemma#fuerte" /><aaif:position rdf:datatype="http://www.w3.org/2001/XMLSchema#int">2</aaif:position><aaif:coordinated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:coordinated><aaif:morphosyntacticStructure rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Adjective" /><aaif:inflection rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Uninflected" /><aaif:attributionTarget rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Verb" /><aaif:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:modified><aaif:semanticClassification rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Manner" /><aaif:reduplicated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:reduplicated><aaif:prepositionalPhrase rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:prepositionalPhrase></aaif:Adverb><aaif:Entry rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En1428"><aaif:phrase rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh#En1428Ph1" /><aaif:source rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh.bibl#Cnde532" /><gams:textualContent>su primera novela con la que entra en el círculo de nuestra narrativa contemporánea “a la española, pisando fuerte ”, como se dice en el verso de Octavio Paz.Pero sí podemos asegurar que ya estaba presente,</gams:textualContent><rel:isPartOf rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh" /></aaif:Entry><aaif:Phrase rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En1428Ph1"><aaif:verb rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh#En1428Ph1Ve1" /><aaif:adverb rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh#En1428Ph1Ad1" /><aaif:text>a la española, pisando fuerte </aaif:text><aaif:annoText>a la española, [v|pisando|pisar|is] [a|fuerte|fuerte|auvnmnnn] </aaif:annoText></aaif:Phrase><aaif:Verb rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En1428Ph1Ve1"><aaif:text>pisando</aaif:text><aaif:lemma rdf:resource="https://gams.uni-graz.at/o:aaif.lemma#pisar" /><aaif:position rdf:datatype="http://www.w3.org/2001/XMLSchema#int">1</aaif:position><aaif:coordinated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:coordinated><aaif:partOfText rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</aaif:partOfText><aaif:syntacticConstruction rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Intransitive" /></aaif:Verb><aaif:Adverb rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En1428Ph1Ad1"><aaif:text>fuerte</aaif:text><aaif:lemma rdf:resource="https://gams.uni-graz.at/o:aaif.lemma#fuerte" /><aaif:position rdf:datatype="http://www.w3.org/2001/XMLSchema#int">2</aaif:position><aaif:coordinated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:coordinated><aaif:morphosyntacticStructure rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Adjective" /><aaif:inflection rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Uninflected" /><aaif:attributionTarget rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Verb" /><aaif:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:modified><aaif:semanticClassification rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Manner" /><aaif:reduplicated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:reduplicated><aaif:prepositionalPhrase rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:prepositionalPhrase></aaif:Adverb><aaif:Entry rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En1429"><aaif:phrase rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh#En1429Ph1" /><aaif:source rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh.bibl#Cnde179" /><gams:textualContent>cuando pregúntame si ya lo tenía incrustado.Así como bueno, olvídate, no, no sabes...Me abrazó fuertísimo  y empezó a decir toneladas de cosas.Deveras eres hermosa, por ejemplo, déjame ver en tus ojos</gams:textualContent><rel:isPartOf rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh" /></aaif:Entry><aaif:Phrase rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En1429Ph1"><aaif:verb rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh#En1429Ph1Ve1" /><aaif:adverb rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh#En1429Ph1Ad1" /><aaif:text>Me abrazó fuertísimo </aaif:text><aaif:annoText>Me [v|abrazó|abrazar|ts] [a|fuertísimo|fuerte|auvnmnnn] </aaif:annoText></aaif:Phrase><aaif:Verb rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En1429Ph1Ve1"><aaif:text>abrazó</aaif:text><aaif:lemma rdf:resource="https://gams.uni-graz.at/o:aaif.lemma#abrazar" /><aaif:position rdf:datatype="http://www.w3.org/2001/XMLSchema#int">1</aaif:position><aaif:coordinated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:coordinated><aaif:partOfText rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</aaif:partOfText><aaif:syntacticConstruction rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Transitive" /></aaif:Verb><aaif:Adverb rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En1429Ph1Ad1"><aaif:text>fuertísimo</aaif:text><aaif:lemma rdf:resource="https://gams.uni-graz.at/o:aaif.lemma#fuerte" /><aaif:position rdf:datatype="http://www.w3.org/2001/XMLSchema#int">2</aaif:position><aaif:coordinated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:coordinated><aaif:morphosyntacticStructure rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Adjective" /><aaif:inflection rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Uninflected" /><aaif:attributionTarget rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Verb" /><aaif:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:modified><aaif:semanticClassification rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Manner" /><aaif:reduplicated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:reduplicated><aaif:prepositionalPhrase rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:prepositionalPhrase></aaif:Adverb><aaif:Entry rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En1430"><aaif:phrase rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh#En1430Ph1" /><aaif:source rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh.bibl#Cnde179" /><gams:textualContent>, y como no la oía ¿no te importa que se le aventó a las piernas y lo abrazó fuertísimo ?Y decía no Mauricio, no, ya no le pegues.Entonces Andrés agarró a Mauricio por la</gams:textualContent><rel:isPartOf rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh" /></aaif:Entry><aaif:Phrase rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En1430Ph1"><aaif:verb rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh#En1430Ph1Ve1" /><aaif:adverb rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh#En1430Ph1Ad1" /><aaif:text>lo abrazó fuertísimo </aaif:text><aaif:annoText>lo [v|abrazó|abrazar|ts] [a|fuertísimo|fuerte|auvnmnnn] </aaif:annoText></aaif:Phrase><aaif:Verb rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En1430Ph1Ve1"><aaif:text>abrazó</aaif:text><aaif:lemma rdf:resource="https://gams.uni-graz.at/o:aaif.lemma#abrazar" /><aaif:position rdf:datatype="http://www.w3.org/2001/XMLSchema#int">1</aaif:position><aaif:coordinated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:coordinated><aaif:partOfText rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</aaif:partOfText><aaif:syntacticConstruction rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Transitive" /></aaif:Verb><aaif:Adverb rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En1430Ph1Ad1"><aaif:text>fuertísimo</aaif:text><aaif:lemma rdf:resource="https://gams.uni-graz.at/o:aaif.lemma#fuerte" /><aaif:position rdf:datatype="http://www.w3.org/2001/XMLSchema#int">2</aaif:position><aaif:coordinated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:coordinated><aaif:morphosyntacticStructure rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Adjective" /><aaif:inflection rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Uninflected" /><aaif:attributionTarget rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Verb" /><aaif:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:modified><aaif:semanticClassification rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Manner" /><aaif:reduplicated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:reduplicated><aaif:prepositionalPhrase rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:prepositionalPhrase></aaif:Adverb><aaif:Entry rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En1431"><aaif:phrase rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh#En1431Ph1" /><aaif:source rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh.bibl#Cnde179" /><gams:textualContent>El cadáver de mi tío reptaba hacia mí, mutilado y lleno de lodo.Mercedes decía no te rías fuerte , idiota.Florencia me descubrió desahuciada y creyó que realmente estaba molestísima.Entonces le dijo a Tito ya</gams:textualContent><rel:isPartOf rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh" /></aaif:Entry><aaif:Phrase rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En1431Ph1"><aaif:verb rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh#En1431Ph1Ve1" /><aaif:adverb rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh#En1431Ph1Ad1" /><aaif:text>no te rías fuerte , idiota</aaif:text><aaif:annoText>no te [v|rías|reír|rs] [a|fuerte|fuerte|auvnmnnn] , idiota</aaif:annoText></aaif:Phrase><aaif:Verb rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En1431Ph1Ve1"><aaif:text>rías</aaif:text><aaif:lemma rdf:resource="https://gams.uni-graz.at/o:aaif.lemma#reír" /><aaif:position rdf:datatype="http://www.w3.org/2001/XMLSchema#int">1</aaif:position><aaif:coordinated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:coordinated><aaif:partOfText rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</aaif:partOfText><aaif:syntacticConstruction rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Reflexive" /></aaif:Verb><aaif:Adverb rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En1431Ph1Ad1"><aaif:text>fuerte</aaif:text><aaif:lemma rdf:resource="https://gams.uni-graz.at/o:aaif.lemma#fuerte" /><aaif:position rdf:datatype="http://www.w3.org/2001/XMLSchema#int">2</aaif:position><aaif:coordinated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:coordinated><aaif:morphosyntacticStructure rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Adjective" /><aaif:inflection rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Uninflected" /><aaif:attributionTarget rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Verb" /><aaif:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:modified><aaif:semanticClassification rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Manner" /><aaif:reduplicated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:reduplicated><aaif:prepositionalPhrase rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:prepositionalPhrase></aaif:Adverb><aaif:Entry rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En1432"><aaif:phrase rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh#En1432Ph1" /><aaif:source rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh.bibl#Cnde441" /><gams:textualContent>la compañía, consérvese a disposición de cualquier empleado de la compañía, era cuando entrabas en el Metro batiendo fuerte las puertas de hierro, inmenso útero latiente de multitud, de olores, de vendedoras, de carteles,</gams:textualContent><rel:isPartOf rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh" /></aaif:Entry><aaif:Phrase rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En1432Ph1"><aaif:verb rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh#En1432Ph1Ve1" /><aaif:adverb rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh#En1432Ph1Ad1" /><aaif:text>entrabas en el Metro batiendo fuerte las puertas de hierro</aaif:text><aaif:annoText>entrabas en el Metro [v|batiendo|batir|ts] [a|fuerte|fuerte|auvnmnnn] las puertas de hierro</aaif:annoText></aaif:Phrase><aaif:Verb rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En1432Ph1Ve1"><aaif:text>batiendo</aaif:text><aaif:lemma rdf:resource="https://gams.uni-graz.at/o:aaif.lemma#batir" /><aaif:position rdf:datatype="http://www.w3.org/2001/XMLSchema#int">1</aaif:position><aaif:coordinated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:coordinated><aaif:partOfText rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</aaif:partOfText><aaif:syntacticConstruction rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Transitive" /></aaif:Verb><aaif:Adverb rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En1432Ph1Ad1"><aaif:text>fuerte</aaif:text><aaif:lemma rdf:resource="https://gams.uni-graz.at/o:aaif.lemma#fuerte" /><aaif:position rdf:datatype="http://www.w3.org/2001/XMLSchema#int">2</aaif:position><aaif:coordinated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:coordinated><aaif:morphosyntacticStructure rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Adjective" /><aaif:inflection rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Uninflected" /><aaif:attributionTarget rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Verb" /><aaif:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:modified><aaif:semanticClassification rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Manner" /><aaif:reduplicated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:reduplicated><aaif:prepositionalPhrase rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:prepositionalPhrase></aaif:Adverb><aaif:Entry rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En1433"><aaif:phrase rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh#En1433Ph1" /><aaif:source rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh.bibl#Cnde288" /><gams:textualContent>y lo mira, lo acaricia, se le acurruca en los brazos, pero cuando  él la quiere abrazar fuerte y besarla ella se le escurre y apenas si le deja rozarle los labios con los labios de él.Le</gams:textualContent><rel:isPartOf rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh" /></aaif:Entry><aaif:Phrase rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En1433Ph1"><aaif:subject rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh#En1433Ph1Su1" /><aaif:verb rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh#En1433Ph1Ve1" /><aaif:adverb rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh#En1433Ph1Ad1" /><aaif:text> él la quiere abrazar fuerte y besarla</aaif:text><aaif:annoText> [s|él|ms] la quiere [v|abrazar|abrazar|ts] [a|fuerte|fuerte|auvnmnnn] y besarla</aaif:annoText></aaif:Phrase><aaif:Subject rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En1433Ph1Su1"><aaif:text>él</aaif:text><aaif:position rdf:datatype="http://www.w3.org/2001/XMLSchema#int">1</aaif:position><aaif:gender rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Masculine" /><aaif:number rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Singular" /><aaif:overt rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</aaif:overt></aaif:Subject><aaif:Verb rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En1433Ph1Ve1"><aaif:text>abrazar</aaif:text><aaif:lemma rdf:resource="https://gams.uni-graz.at/o:aaif.lemma#abrazar" /><aaif:position rdf:datatype="http://www.w3.org/2001/XMLSchema#int">2</aaif:position><aaif:coordinated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:coordinated><aaif:partOfText rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</aaif:partOfText><aaif:syntacticConstruction rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Transitive" /></aaif:Verb><aaif:Adverb rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En1433Ph1Ad1"><aaif:text>fuerte</aaif:text><aaif:lemma rdf:resource="https://gams.uni-graz.at/o:aaif.lemma#fuerte" /><aaif:position rdf:datatype="http://www.w3.org/2001/XMLSchema#int">3</aaif:position><aaif:coordinated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:coordinated><aaif:morphosyntacticStructure rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Adjective" /><aaif:inflection rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Uninflected" /><aaif:attributionTarget rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Verb" /><aaif:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:modified><aaif:semanticClassification rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Manner" /><aaif:reduplicated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:reduplicated><aaif:prepositionalPhrase rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:prepositionalPhrase></aaif:Adverb><aaif:Entry rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En1434"><aaif:phrase rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh#En1434Ph1" /><aaif:source rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh.bibl#Cnde533" /><gams:textualContent>A ratos corre, a ratos camina.Siempre adelante.Se cansa, lleva ya treinta kilómetros y  el sol  pega fuerte por los campos resecos y pardos.No se detiene un momento.Cuando la fatiga es muy grande,</gams:textualContent><rel:isPartOf rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh" /></aaif:Entry><aaif:Phrase rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En1434Ph1"><aaif:subject rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh#En1434Ph1Su1" /><aaif:verb rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh#En1434Ph1Ve1" /><aaif:adverb rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh#En1434Ph1Ad1" /><aaif:text> el sol  pega fuerte por los campos resecos y pardos</aaif:text><aaif:annoText> [s|el sol|ms]  [v|pega|pegar|is] [a|fuerte|fuerte|auvnmnnn] por los campos resecos y pardos</aaif:annoText></aaif:Phrase><aaif:Subject rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En1434Ph1Su1"><aaif:text>el sol</aaif:text><aaif:position rdf:datatype="http://www.w3.org/2001/XMLSchema#int">1</aaif:position><aaif:gender rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Masculine" /><aaif:number rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Singular" /><aaif:overt rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</aaif:overt></aaif:Subject><aaif:Verb rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En1434Ph1Ve1"><aaif:text>pega</aaif:text><aaif:lemma rdf:resource="https://gams.uni-graz.at/o:aaif.lemma#pegar" /><aaif:position rdf:datatype="http://www.w3.org/2001/XMLSchema#int">2</aaif:position><aaif:coordinated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:coordinated><aaif:partOfText rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</aaif:partOfText><aaif:syntacticConstruction rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Intransitive" /></aaif:Verb><aaif:Adverb rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En1434Ph1Ad1"><aaif:text>fuerte</aaif:text><aaif:lemma rdf:resource="https://gams.uni-graz.at/o:aaif.lemma#fuerte" /><aaif:position rdf:datatype="http://www.w3.org/2001/XMLSchema#int">3</aaif:position><aaif:coordinated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:coordinated><aaif:morphosyntacticStructure rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Adjective" /><aaif:inflection rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Uninflected" /><aaif:attributionTarget rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Verb" /><aaif:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:modified><aaif:semanticClassification rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Manner" /><aaif:reduplicated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:reduplicated><aaif:prepositionalPhrase rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:prepositionalPhrase></aaif:Adverb><aaif:Entry rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En1435"><aaif:phrase rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh#En1435Ph1" /><aaif:source rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh.bibl#Cnde534" /><gams:textualContent>GARRAFONA ¡ Tirad  fuerte !¡No dejéis que se nos vaya a pique antes de tiempo!</gams:textualContent><rel:isPartOf rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh" /></aaif:Entry><aaif:Phrase rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En1435Ph1"><aaif:verb rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh#En1435Ph1Ve1" /><aaif:adverb rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh#En1435Ph1Ad1" /><aaif:text> Tirad  fuerte </aaif:text><aaif:annoText> [v|Tirad|tirar|is]  [a|fuerte|fuerte|auvnmnnn] </aaif:annoText></aaif:Phrase><aaif:Verb rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En1435Ph1Ve1"><aaif:text>Tirad</aaif:text><aaif:lemma rdf:resource="https://gams.uni-graz.at/o:aaif.lemma#tirar" /><aaif:position rdf:datatype="http://www.w3.org/2001/XMLSchema#int">1</aaif:position><aaif:coordinated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:coordinated><aaif:partOfText rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</aaif:partOfText><aaif:syntacticConstruction rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Intransitive" /></aaif:Verb><aaif:Adverb rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En1435Ph1Ad1"><aaif:text>fuerte</aaif:text><aaif:lemma rdf:resource="https://gams.uni-graz.at/o:aaif.lemma#fuerte" /><aaif:position rdf:datatype="http://www.w3.org/2001/XMLSchema#int">2</aaif:position><aaif:coordinated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:coordinated><aaif:morphosyntacticStructure rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Adjective" /><aaif:inflection rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Uninflected" /><aaif:attributionTarget rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Verb" /><aaif:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:modified><aaif:semanticClassification rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Manner" /><aaif:reduplicated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:reduplicated><aaif:prepositionalPhrase rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:prepositionalPhrase></aaif:Adverb><aaif:Entry rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En1436"><aaif:phrase rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh#En1436Ph1" /><aaif:source rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh.bibl#Cnde60" /><gams:textualContent>entre boletín y boletín, de mi cuento erótico-picaresco sobre la tragedia del senador arequipeño.Me proponía trabajar fuerte  en él esa noche, pero Javier vino a buscarme después de El Panamericano y me llevó a una sesión</gams:textualContent><rel:isPartOf rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh" /></aaif:Entry><aaif:Phrase rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En1436Ph1"><aaif:verb rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh#En1436Ph1Ve1" /><aaif:adverb rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh#En1436Ph1Ad1" /><aaif:text>Me proponía trabajar fuerte </aaif:text><aaif:annoText>Me proponía [v|trabajar|trabajar|is] [a|fuerte|fuerte|auvnmnnn] </aaif:annoText></aaif:Phrase><aaif:Verb rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En1436Ph1Ve1"><aaif:text>trabajar</aaif:text><aaif:lemma rdf:resource="https://gams.uni-graz.at/o:aaif.lemma#trabajar" /><aaif:position rdf:datatype="http://www.w3.org/2001/XMLSchema#int">1</aaif:position><aaif:coordinated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:coordinated><aaif:partOfText rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</aaif:partOfText><aaif:syntacticConstruction rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Intransitive" /></aaif:Verb><aaif:Adverb rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En1436Ph1Ad1"><aaif:text>fuerte</aaif:text><aaif:lemma rdf:resource="https://gams.uni-graz.at/o:aaif.lemma#fuerte" /><aaif:position rdf:datatype="http://www.w3.org/2001/XMLSchema#int">2</aaif:position><aaif:coordinated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:coordinated><aaif:morphosyntacticStructure rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Adjective" /><aaif:inflection rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Uninflected" /><aaif:attributionTarget rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Verb" /><aaif:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:modified><aaif:semanticClassification rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Manner" /><aaif:reduplicated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:reduplicated><aaif:prepositionalPhrase rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:prepositionalPhrase></aaif:Adverb><aaif:Entry rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En1437"><aaif:phrase rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh#En1437Ph1" /><aaif:source rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh.bibl#Cnde60" /><gams:textualContent>Y, para que fuera más creíble, dio unas carreritas de un lado a otro, zapateando fuerte .Luego pegó la cara al tabique del depósito y gritó, a voz en cuello:</gams:textualContent><rel:isPartOf rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh" /></aaif:Entry><aaif:Phrase rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En1437Ph1"><aaif:verb rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh#En1437Ph1Ve1" /><aaif:adverb rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh#En1437Ph1Ad1" /><aaif:text>dio unas carreritas de un lado a otro, zapateando fuerte </aaif:text><aaif:annoText>dio unas carreritas de un lado a otro, [v|zapateando|zapatear|is] [a|fuerte|fuerte|auvnmnnn] </aaif:annoText></aaif:Phrase><aaif:Verb rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En1437Ph1Ve1"><aaif:text>zapateando</aaif:text><aaif:lemma rdf:resource="https://gams.uni-graz.at/o:aaif.lemma#zapatear" /><aaif:position rdf:datatype="http://www.w3.org/2001/XMLSchema#int">1</aaif:position><aaif:coordinated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:coordinated><aaif:partOfText rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</aaif:partOfText><aaif:syntacticConstruction rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Intransitive" /></aaif:Verb><aaif:Adverb rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En1437Ph1Ad1"><aaif:text>fuerte</aaif:text><aaif:lemma rdf:resource="https://gams.uni-graz.at/o:aaif.lemma#fuerte" /><aaif:position rdf:datatype="http://www.w3.org/2001/XMLSchema#int">2</aaif:position><aaif:coordinated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:coordinated><aaif:morphosyntacticStructure rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Adjective" /><aaif:inflection rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Uninflected" /><aaif:attributionTarget rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Verb" /><aaif:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:modified><aaif:semanticClassification rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Manner" /><aaif:reduplicated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:reduplicated><aaif:prepositionalPhrase rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:prepositionalPhrase></aaif:Adverb><aaif:Entry rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En1438"><aaif:phrase rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh#En1438Ph1" /><aaif:source rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh.bibl#Cnde492" /><gams:textualContent>feliz.Pero decía que no se debía indemnizar a los “barones del estaño”.Y protestaba fuerte  e insistía con las personas que se reunían en nuestra vivienda: “¿Cómo les vamos a indemnizar?</gams:textualContent><rel:isPartOf rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh" /></aaif:Entry><aaif:Phrase rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En1438Ph1"><aaif:verb rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh#En1438Ph1Ve1" /><aaif:adverb rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh#En1438Ph1Ad1" /><aaif:text>Y protestaba fuerte </aaif:text><aaif:annoText>Y [v|protestaba|protestar|is] [a|fuerte|fuerte|auvnmnnn] </aaif:annoText></aaif:Phrase><aaif:Verb rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En1438Ph1Ve1"><aaif:text>protestaba</aaif:text><aaif:lemma rdf:resource="https://gams.uni-graz.at/o:aaif.lemma#protestar" /><aaif:position rdf:datatype="http://www.w3.org/2001/XMLSchema#int">1</aaif:position><aaif:coordinated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:coordinated><aaif:partOfText rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</aaif:partOfText><aaif:syntacticConstruction rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Intransitive" /></aaif:Verb><aaif:Adverb rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En1438Ph1Ad1"><aaif:text>fuerte</aaif:text><aaif:lemma rdf:resource="https://gams.uni-graz.at/o:aaif.lemma#fuerte" /><aaif:position rdf:datatype="http://www.w3.org/2001/XMLSchema#int">2</aaif:position><aaif:coordinated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:coordinated><aaif:morphosyntacticStructure rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Adjective" /><aaif:inflection rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Uninflected" /><aaif:attributionTarget rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Verb" /><aaif:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:modified><aaif:semanticClassification rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Manner" /><aaif:reduplicated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:reduplicated><aaif:prepositionalPhrase rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:prepositionalPhrase></aaif:Adverb><aaif:Entry rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En1439"><aaif:phrase rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh#En1439Ph1" /><aaif:source rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh.bibl#Cnde492" /><gams:textualContent>es grande y fuerte.Pero un día, después de tanto luchar,  tú lo agarras y le pegas fuerte  y le quitas a tu muñequita.Y tu muñequita otra vez es tuya.Pero, después de tantos años</gams:textualContent><rel:isPartOf rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh" /></aaif:Entry><aaif:Phrase rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En1439Ph1"><aaif:subject rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh#En1439Ph1Su1" /><aaif:verb rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh#En1439Ph1Ve1" /><aaif:adverb rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh#En1439Ph1Ad1" /><aaif:text> tú lo agarras y le pegas fuerte </aaif:text><aaif:annoText> [s|tú|ms] lo agarras y le [v|pegas|pegar|ts] [a|fuerte|fuerte|auvnmnnn] </aaif:annoText></aaif:Phrase><aaif:Subject rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En1439Ph1Su1"><aaif:text>tú</aaif:text><aaif:position rdf:datatype="http://www.w3.org/2001/XMLSchema#int">1</aaif:position><aaif:gender rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Masculine" /><aaif:number rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Singular" /><aaif:overt rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:overt></aaif:Subject><aaif:Verb rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En1439Ph1Ve1"><aaif:text>pegas</aaif:text><aaif:lemma rdf:resource="https://gams.uni-graz.at/o:aaif.lemma#pegar" /><aaif:position rdf:datatype="http://www.w3.org/2001/XMLSchema#int">2</aaif:position><aaif:coordinated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:coordinated><aaif:partOfText rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</aaif:partOfText><aaif:syntacticConstruction rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Transitive" /></aaif:Verb><aaif:Adverb rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En1439Ph1Ad1"><aaif:text>fuerte</aaif:text><aaif:lemma rdf:resource="https://gams.uni-graz.at/o:aaif.lemma#fuerte" /><aaif:position rdf:datatype="http://www.w3.org/2001/XMLSchema#int">3</aaif:position><aaif:coordinated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:coordinated><aaif:morphosyntacticStructure rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Adjective" /><aaif:inflection rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Uninflected" /><aaif:attributionTarget rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Verb" /><aaif:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:modified><aaif:semanticClassification rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Manner" /><aaif:reduplicated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:reduplicated><aaif:prepositionalPhrase rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:prepositionalPhrase></aaif:Adverb><aaif:Entry rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En1440"><aaif:phrase rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh#En1440Ph1" /><aaif:source rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh.bibl#Cnde492" /><gams:textualContent>Una noche me pegaron fuerte , mi papá y ella .Habían vuelto a la casa borrachos, los dos.Entonces mis hermanas me</gams:textualContent><rel:isPartOf rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh" /></aaif:Entry><aaif:Phrase rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En1440Ph1"><aaif:subject rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh#En1440Ph1Su1" /><aaif:verb rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh#En1440Ph1Ve1" /><aaif:adverb rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh#En1440Ph1Ad1" /><aaif:text>Una noche me pegaron fuerte , mi papá y ella </aaif:text><aaif:annoText>Una noche me [v|pegaron|pegar|ts] [a|fuerte|fuerte|auvnmnnn] , [s|mi papá y ella|mp] </aaif:annoText></aaif:Phrase><aaif:Subject rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En1440Ph1Su1"><aaif:text>mi papá y ella</aaif:text><aaif:position rdf:datatype="http://www.w3.org/2001/XMLSchema#int">3</aaif:position><aaif:gender rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Masculine" /><aaif:number rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Plural" /><aaif:overt rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</aaif:overt></aaif:Subject><aaif:Verb rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En1440Ph1Ve1"><aaif:text>pegaron</aaif:text><aaif:lemma rdf:resource="https://gams.uni-graz.at/o:aaif.lemma#pegar" /><aaif:position rdf:datatype="http://www.w3.org/2001/XMLSchema#int">1</aaif:position><aaif:coordinated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:coordinated><aaif:partOfText rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</aaif:partOfText><aaif:syntacticConstruction rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Transitive" /></aaif:Verb><aaif:Adverb rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En1440Ph1Ad1"><aaif:text>fuerte</aaif:text><aaif:lemma rdf:resource="https://gams.uni-graz.at/o:aaif.lemma#fuerte" /><aaif:position rdf:datatype="http://www.w3.org/2001/XMLSchema#int">2</aaif:position><aaif:coordinated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:coordinated><aaif:morphosyntacticStructure rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Adjective" /><aaif:inflection rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Uninflected" /><aaif:attributionTarget rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Verb" /><aaif:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:modified><aaif:semanticClassification rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Manner" /><aaif:reduplicated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:reduplicated><aaif:prepositionalPhrase rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:prepositionalPhrase></aaif:Adverb><aaif:Entry rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En1441"><aaif:phrase rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh#En1441Ph1" /><aaif:source rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh.bibl#Cnde492" /><gams:textualContent>Estaban por amarrarme las manos como lo habían hecho con los hombres, pero mi hijita empezó a llorar fuerte .</gams:textualContent><rel:isPartOf rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh" /></aaif:Entry><aaif:Phrase rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En1441Ph1"><aaif:subject rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh#En1441Ph1Su1" /><aaif:verb rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh#En1441Ph1Ve1" /><aaif:adverb rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh#En1441Ph1Ad1" /><aaif:text>pero mi hijita empezó a llorar fuerte </aaif:text><aaif:annoText>pero [s|mi hijita|fs] empezó a [v|llorar|llorar|is] [a|fuerte|fuerte|auvnmnnn] </aaif:annoText></aaif:Phrase><aaif:Subject rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En1441Ph1Su1"><aaif:text>mi hijita</aaif:text><aaif:position rdf:datatype="http://www.w3.org/2001/XMLSchema#int">1</aaif:position><aaif:gender rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Feminine" /><aaif:number rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Singular" /><aaif:overt rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</aaif:overt></aaif:Subject><aaif:Verb rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En1441Ph1Ve1"><aaif:text>llorar</aaif:text><aaif:lemma rdf:resource="https://gams.uni-graz.at/o:aaif.lemma#llorar" /><aaif:position rdf:datatype="http://www.w3.org/2001/XMLSchema#int">2</aaif:position><aaif:coordinated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:coordinated><aaif:partOfText rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</aaif:partOfText><aaif:syntacticConstruction rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Intransitive" /></aaif:Verb><aaif:Adverb rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En1441Ph1Ad1"><aaif:text>fuerte</aaif:text><aaif:lemma rdf:resource="https://gams.uni-graz.at/o:aaif.lemma#fuerte" /><aaif:position rdf:datatype="http://www.w3.org/2001/XMLSchema#int">3</aaif:position><aaif:coordinated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:coordinated><aaif:morphosyntacticStructure rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Adjective" /><aaif:inflection rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Uninflected" /><aaif:attributionTarget rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Verb" /><aaif:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:modified><aaif:semanticClassification rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Manner" /><aaif:reduplicated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:reduplicated><aaif:prepositionalPhrase rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:prepositionalPhrase></aaif:Adverb><aaif:Entry rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En1442"><aaif:phrase rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh#En1442Ph1" /><aaif:source rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh.bibl#Cnde492" /><gams:textualContent>Finalmente, hablé fuerte a mis hijos:</gams:textualContent><rel:isPartOf rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh" /></aaif:Entry><aaif:Phrase rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En1442Ph1"><aaif:verb rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh#En1442Ph1Ve1" /><aaif:adverb rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh#En1442Ph1Ad1" /><aaif:text>Finalmente, hablé fuerte a mis hijos</aaif:text><aaif:annoText>Finalmente, [v|hablé|hablar|is] [a|fuerte|fuerte|auvnmnnn] a mis hijos</aaif:annoText></aaif:Phrase><aaif:Verb rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En1442Ph1Ve1"><aaif:text>hablé</aaif:text><aaif:lemma rdf:resource="https://gams.uni-graz.at/o:aaif.lemma#hablar" /><aaif:position rdf:datatype="http://www.w3.org/2001/XMLSchema#int">1</aaif:position><aaif:coordinated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:coordinated><aaif:partOfText rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</aaif:partOfText><aaif:syntacticConstruction rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Intransitive" /></aaif:Verb><aaif:Adverb rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En1442Ph1Ad1"><aaif:text>fuerte</aaif:text><aaif:lemma rdf:resource="https://gams.uni-graz.at/o:aaif.lemma#fuerte" /><aaif:position rdf:datatype="http://www.w3.org/2001/XMLSchema#int">2</aaif:position><aaif:coordinated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:coordinated><aaif:morphosyntacticStructure rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Adjective" /><aaif:inflection rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Uninflected" /><aaif:attributionTarget rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Verb" /><aaif:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:modified><aaif:semanticClassification rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Manner" /><aaif:reduplicated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:reduplicated><aaif:prepositionalPhrase rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:prepositionalPhrase></aaif:Adverb><aaif:Entry rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En1443"><aaif:phrase rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh#En1443Ph1" /><aaif:source rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh.bibl#Cnde492" /><gams:textualContent>me animaba a dejarme observar.No quería y no quería.Me cubría y me cubría, me aseguraba fuerte en la cama...A ratos me parecía que me querían botar en ese barranco, así...y nuevamente perdía</gams:textualContent><rel:isPartOf rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh" /></aaif:Entry><aaif:Phrase rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En1443Ph1"><aaif:verb rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh#En1443Ph1Ve1" /><aaif:adverb rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh#En1443Ph1Ad1" /><aaif:text>me aseguraba fuerte en la cama</aaif:text><aaif:annoText>me [v|aseguraba|asegurar|rs] [a|fuerte|fuerte|auvnmnnn] en la cama</aaif:annoText></aaif:Phrase><aaif:Verb rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En1443Ph1Ve1"><aaif:text>aseguraba</aaif:text><aaif:lemma rdf:resource="https://gams.uni-graz.at/o:aaif.lemma#asegurar" /><aaif:position rdf:datatype="http://www.w3.org/2001/XMLSchema#int">1</aaif:position><aaif:coordinated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:coordinated><aaif:partOfText rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</aaif:partOfText><aaif:syntacticConstruction rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Reflexive" /></aaif:Verb><aaif:Adverb rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En1443Ph1Ad1"><aaif:text>fuerte</aaif:text><aaif:lemma rdf:resource="https://gams.uni-graz.at/o:aaif.lemma#fuerte" /><aaif:position rdf:datatype="http://www.w3.org/2001/XMLSchema#int">2</aaif:position><aaif:coordinated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:coordinated><aaif:morphosyntacticStructure rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Adjective" /><aaif:inflection rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Uninflected" /><aaif:attributionTarget rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Verb" /><aaif:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:modified><aaif:semanticClassification rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Manner" /><aaif:reduplicated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:reduplicated><aaif:prepositionalPhrase rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:prepositionalPhrase></aaif:Adverb><aaif:Entry rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En1444"><aaif:phrase rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh#En1444Ph1" /><aaif:source rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh.bibl#Cnde492" /><gams:textualContent>Muchas represalias tomaron.A los últimos delegados de base que apresaron, los apalearon fuerte , y bala en boca los hicieron denunciar a los dirigentes, diciendo: “Ellos son pagados del</gams:textualContent><rel:isPartOf rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh" /></aaif:Entry><aaif:Phrase rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En1444Ph1"><aaif:verb rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh#En1444Ph1Ve1" /><aaif:adverb rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh#En1444Ph1Ad1" /><aaif:text>A los últimos delegados de base que apresaron, los apalearon fuerte </aaif:text><aaif:annoText>A los últimos delegados de base que apresaron, los [v|apalearon|apalear|ts] [a|fuerte|fuerte|auvnmnnn] </aaif:annoText></aaif:Phrase><aaif:Verb rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En1444Ph1Ve1"><aaif:text>apalearon</aaif:text><aaif:lemma rdf:resource="https://gams.uni-graz.at/o:aaif.lemma#apalear" /><aaif:position rdf:datatype="http://www.w3.org/2001/XMLSchema#int">1</aaif:position><aaif:coordinated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:coordinated><aaif:partOfText rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</aaif:partOfText><aaif:syntacticConstruction rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Transitive" /></aaif:Verb><aaif:Adverb rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En1444Ph1Ad1"><aaif:text>fuerte</aaif:text><aaif:lemma rdf:resource="https://gams.uni-graz.at/o:aaif.lemma#fuerte" /><aaif:position rdf:datatype="http://www.w3.org/2001/XMLSchema#int">2</aaif:position><aaif:coordinated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:coordinated><aaif:morphosyntacticStructure rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Adjective" /><aaif:inflection rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Uninflected" /><aaif:attributionTarget rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Verb" /><aaif:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:modified><aaif:semanticClassification rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Manner" /><aaif:reduplicated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:reduplicated><aaif:prepositionalPhrase rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:prepositionalPhrase></aaif:Adverb><aaif:Entry rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En1445"><aaif:phrase rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh#En1445Ph1" /><aaif:source rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh.bibl#Cnde492" /><gams:textualContent>Llegó al hospital una compañera totalmente herida, con un hematoma grande; la habían golpeado fuerte  los agentes  y tuvieron que operarla.Unas señoras llegaron y nos dijeron: “¿Cómo vamos aceptar de</gams:textualContent><rel:isPartOf rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh" /></aaif:Entry><aaif:Phrase rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En1445Ph1"><aaif:subject rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh#En1445Ph1Su1" /><aaif:verb rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh#En1445Ph1Ve1" /><aaif:adverb rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh#En1445Ph1Ad1" /><aaif:text>la habían golpeado fuerte  los agentes </aaif:text><aaif:annoText>la habían [v|golpeado|golpear|ts] [a|fuerte|fuerte|auvnmnnn]  [s|los agentes|mp] </aaif:annoText></aaif:Phrase><aaif:Subject rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En1445Ph1Su1"><aaif:text>los agentes</aaif:text><aaif:position rdf:datatype="http://www.w3.org/2001/XMLSchema#int">3</aaif:position><aaif:gender rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Masculine" /><aaif:number rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Plural" /><aaif:overt rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</aaif:overt></aaif:Subject><aaif:Verb rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En1445Ph1Ve1"><aaif:text>golpeado</aaif:text><aaif:lemma rdf:resource="https://gams.uni-graz.at/o:aaif.lemma#golpear" /><aaif:position rdf:datatype="http://www.w3.org/2001/XMLSchema#int">1</aaif:position><aaif:coordinated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:coordinated><aaif:partOfText rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</aaif:partOfText><aaif:syntacticConstruction rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Transitive" /></aaif:Verb><aaif:Adverb rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En1445Ph1Ad1"><aaif:text>fuerte</aaif:text><aaif:lemma rdf:resource="https://gams.uni-graz.at/o:aaif.lemma#fuerte" /><aaif:position rdf:datatype="http://www.w3.org/2001/XMLSchema#int">2</aaif:position><aaif:coordinated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:coordinated><aaif:morphosyntacticStructure rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Adjective" /><aaif:inflection rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Uninflected" /><aaif:attributionTarget rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Verb" /><aaif:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:modified><aaif:semanticClassification rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Manner" /><aaif:reduplicated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:reduplicated><aaif:prepositionalPhrase rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:prepositionalPhrase></aaif:Adverb><aaif:Entry rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En1446"><aaif:phrase rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh#En1446Ph1" /><aaif:source rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh.bibl#Cnde61" /><gams:textualContent>Me senté en la cama, con la toalla en las rodillas. El agua  repiqueteaba fuerte contra el piso de cemento del baño.Me quedé sentado un rato largo, pensando en nada y</gams:textualContent><rel:isPartOf rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh" /></aaif:Entry><aaif:Phrase rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En1446Ph1"><aaif:subject rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh#En1446Ph1Su1" /><aaif:verb rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh#En1446Ph1Ve1" /><aaif:adverb rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh#En1446Ph1Ad1" /><aaif:text> El agua  repiqueteaba fuerte contra el piso</aaif:text><aaif:annoText> [s|El agua|fs]  [v|repiqueteaba|repiquetear|is] [a|fuerte|fuerte|auvnmnnn] contra el piso</aaif:annoText></aaif:Phrase><aaif:Subject rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En1446Ph1Su1"><aaif:text>El agua</aaif:text><aaif:position rdf:datatype="http://www.w3.org/2001/XMLSchema#int">1</aaif:position><aaif:gender rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Feminine" /><aaif:number rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Singular" /><aaif:overt rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</aaif:overt></aaif:Subject><aaif:Verb rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En1446Ph1Ve1"><aaif:text>repiqueteaba</aaif:text><aaif:lemma rdf:resource="https://gams.uni-graz.at/o:aaif.lemma#repiquetear" /><aaif:position rdf:datatype="http://www.w3.org/2001/XMLSchema#int">2</aaif:position><aaif:coordinated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:coordinated><aaif:partOfText rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</aaif:partOfText><aaif:syntacticConstruction rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Intransitive" /></aaif:Verb><aaif:Adverb rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En1446Ph1Ad1"><aaif:text>fuerte</aaif:text><aaif:lemma rdf:resource="https://gams.uni-graz.at/o:aaif.lemma#fuerte" /><aaif:position rdf:datatype="http://www.w3.org/2001/XMLSchema#int">3</aaif:position><aaif:coordinated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:coordinated><aaif:morphosyntacticStructure rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Adjective" /><aaif:inflection rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Uninflected" /><aaif:attributionTarget rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Verb" /><aaif:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:modified><aaif:semanticClassification rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Manner" /><aaif:reduplicated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:reduplicated><aaif:prepositionalPhrase rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:prepositionalPhrase></aaif:Adverb><aaif:Entry rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En1447"><aaif:phrase rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh#En1447Ph1" /><aaif:source rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh.bibl#Cnde61" /><gams:textualContent>tuerto para siempre.Mamá, que no aceptaba quejas, nos curaba las heridas: ella nos enseñó a morder fuerte y no achicarnos.Mi hermano Guillermo, que siempre fue de poco hablar, se batía a trompadas contra</gams:textualContent><rel:isPartOf rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh" /></aaif:Entry><aaif:Phrase rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En1447Ph1"><aaif:verb rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh#En1447Ph1Ve1" /><aaif:adverb rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh#En1447Ph1Ad1" /><aaif:text>ella nos enseñó a morder fuerte y no achicarnos</aaif:text><aaif:annoText>ella nos enseñó a [v|morder|morder|is] [a|fuerte|fuerte|auvnmnnn] y no achicarnos</aaif:annoText></aaif:Phrase><aaif:Verb rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En1447Ph1Ve1"><aaif:text>morder</aaif:text><aaif:lemma rdf:resource="https://gams.uni-graz.at/o:aaif.lemma#morder" /><aaif:position rdf:datatype="http://www.w3.org/2001/XMLSchema#int">1</aaif:position><aaif:coordinated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:coordinated><aaif:partOfText rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</aaif:partOfText><aaif:syntacticConstruction rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Intransitive" /></aaif:Verb><aaif:Adverb rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En1447Ph1Ad1"><aaif:text>fuerte</aaif:text><aaif:lemma rdf:resource="https://gams.uni-graz.at/o:aaif.lemma#fuerte" /><aaif:position rdf:datatype="http://www.w3.org/2001/XMLSchema#int">2</aaif:position><aaif:coordinated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:coordinated><aaif:morphosyntacticStructure rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Adjective" /><aaif:inflection rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Uninflected" /><aaif:attributionTarget rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Verb" /><aaif:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:modified><aaif:semanticClassification rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Manner" /><aaif:reduplicated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:reduplicated><aaif:prepositionalPhrase rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:prepositionalPhrase></aaif:Adverb><aaif:Entry rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En1448"><aaif:phrase rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh#En1448Ph1" /><aaif:source rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh.bibl#Cnde61" /><gams:textualContent>eso.No le pregunté por qué no se iba para que no me preguntara por qué no me iba yo. Silba  fuerte  el niño  cuando pasa por la puerta del cementerio.</gams:textualContent><rel:isPartOf rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh" /></aaif:Entry><aaif:Phrase rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En1448Ph1"><aaif:subject rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh#En1448Ph1Su1" /><aaif:verb rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh#En1448Ph1Ve1" /><aaif:adverb rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh#En1448Ph1Ad1" /><aaif:text> Silba  fuerte  el niño </aaif:text><aaif:annoText> [v|Silba|silbar|is]  [a|fuerte|fuerte|auvnmnnn]  [s|el niño|ms] </aaif:annoText></aaif:Phrase><aaif:Subject rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En1448Ph1Su1"><aaif:text>el niño</aaif:text><aaif:position rdf:datatype="http://www.w3.org/2001/XMLSchema#int">3</aaif:position><aaif:gender rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Masculine" /><aaif:number rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Singular" /><aaif:overt rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</aaif:overt></aaif:Subject><aaif:Verb rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En1448Ph1Ve1"><aaif:text>Silba</aaif:text><aaif:lemma rdf:resource="https://gams.uni-graz.at/o:aaif.lemma#silbar" /><aaif:position rdf:datatype="http://www.w3.org/2001/XMLSchema#int">1</aaif:position><aaif:coordinated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:coordinated><aaif:partOfText rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</aaif:partOfText><aaif:syntacticConstruction rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Intransitive" /></aaif:Verb><aaif:Adverb rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En1448Ph1Ad1"><aaif:text>fuerte</aaif:text><aaif:lemma rdf:resource="https://gams.uni-graz.at/o:aaif.lemma#fuerte" /><aaif:position rdf:datatype="http://www.w3.org/2001/XMLSchema#int">2</aaif:position><aaif:coordinated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:coordinated><aaif:morphosyntacticStructure rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Adjective" /><aaif:inflection rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Uninflected" /><aaif:attributionTarget rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Verb" /><aaif:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:modified><aaif:semanticClassification rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Manner" /><aaif:reduplicated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:reduplicated><aaif:prepositionalPhrase rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:prepositionalPhrase></aaif:Adverb><aaif:Entry rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En1449"><aaif:phrase rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh#En1449Ph1" /><aaif:source rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh.bibl#Cnde61" /><gams:textualContent>A la noche siguiente llovió fuerte en Buenos Aires.No estábamos juntos.Pasamos la noche en vela, bajo techos diferentes, en distintos barrios,</gams:textualContent><rel:isPartOf rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh" /></aaif:Entry><aaif:Phrase rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En1449Ph1"><aaif:verb rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh#En1449Ph1Ve1" /><aaif:adverb rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh#En1449Ph1Ad1" /><aaif:text>A la noche siguiente llovió fuerte en Buenos Aires</aaif:text><aaif:annoText>A la noche siguiente [v|llovió|llover|is] [a|fuerte|fuerte|auvnmnnn] en Buenos Aires</aaif:annoText></aaif:Phrase><aaif:Verb rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En1449Ph1Ve1"><aaif:text>llovió</aaif:text><aaif:lemma rdf:resource="https://gams.uni-graz.at/o:aaif.lemma#llover" /><aaif:position rdf:datatype="http://www.w3.org/2001/XMLSchema#int">1</aaif:position><aaif:coordinated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:coordinated><aaif:partOfText rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</aaif:partOfText><aaif:syntacticConstruction rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Intransitive" /></aaif:Verb><aaif:Adverb rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En1449Ph1Ad1"><aaif:text>fuerte</aaif:text><aaif:lemma rdf:resource="https://gams.uni-graz.at/o:aaif.lemma#fuerte" /><aaif:position rdf:datatype="http://www.w3.org/2001/XMLSchema#int">2</aaif:position><aaif:coordinated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:coordinated><aaif:morphosyntacticStructure rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Adjective" /><aaif:inflection rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Uninflected" /><aaif:attributionTarget rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Verb" /><aaif:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:modified><aaif:semanticClassification rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Manner" /><aaif:reduplicated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:reduplicated><aaif:prepositionalPhrase rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:prepositionalPhrase></aaif:Adverb><aaif:Entry rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En1450"><aaif:phrase rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh#En1450Ph1" /><aaif:source rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh.bibl#Cnde535" /><gams:textualContent>Puesto a jugar fuerte , y tal vez para disipar su aburrimiento, el Diablo se instaló en el Vaticano.Durante dos siglos —</gams:textualContent><rel:isPartOf rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh" /></aaif:Entry><aaif:Phrase rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En1450Ph1"><aaif:subject rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh#En1450Ph1Su1" /><aaif:verb rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh#En1450Ph1Ve1" /><aaif:adverb rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh#En1450Ph1Ad1" /><aaif:text>Puesto a jugar fuerte , y tal vez para disipar su aburrimiento, el Diablo se instaló en el Vaticano</aaif:text><aaif:annoText>Puesto a [v|jugar|jugar|is] [a|fuerte|fuerte|auvnmnnn] , y tal vez para disipar su aburrimiento, [s|el Diablo|ms] se instaló en el Vaticano</aaif:annoText></aaif:Phrase><aaif:Subject rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En1450Ph1Su1"><aaif:text>el Diablo</aaif:text><aaif:position rdf:datatype="http://www.w3.org/2001/XMLSchema#int">3</aaif:position><aaif:gender rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Masculine" /><aaif:number rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Singular" /><aaif:overt rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</aaif:overt></aaif:Subject><aaif:Verb rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En1450Ph1Ve1"><aaif:text>jugar</aaif:text><aaif:lemma rdf:resource="https://gams.uni-graz.at/o:aaif.lemma#jugar" /><aaif:position rdf:datatype="http://www.w3.org/2001/XMLSchema#int">1</aaif:position><aaif:coordinated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:coordinated><aaif:partOfText rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</aaif:partOfText><aaif:syntacticConstruction rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Intransitive" /></aaif:Verb><aaif:Adverb rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En1450Ph1Ad1"><aaif:text>fuerte</aaif:text><aaif:lemma rdf:resource="https://gams.uni-graz.at/o:aaif.lemma#fuerte" /><aaif:position rdf:datatype="http://www.w3.org/2001/XMLSchema#int">2</aaif:position><aaif:coordinated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:coordinated><aaif:morphosyntacticStructure rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Adjective" /><aaif:inflection rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Uninflected" /><aaif:attributionTarget rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Verb" /><aaif:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:modified><aaif:semanticClassification rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Manner" /><aaif:reduplicated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:reduplicated><aaif:prepositionalPhrase rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:prepositionalPhrase></aaif:Adverb><aaif:Entry rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En1451"><aaif:phrase rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh#En1451Ph1" /><aaif:source rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh.bibl#Cnde62" /><gams:textualContent>en que con los cinco o seis mil pesos que pudiera obtener se sentiría suficientemente seguro para iniciar la brecha  pisando  fuerte y sacando el pecho, como hacen los que triunfan.Pensaba eso y le iba dando tiempo a su</gams:textualContent><rel:isPartOf rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh" /></aaif:Entry><aaif:Phrase rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En1451Ph1"><aaif:verb rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh#En1451Ph1Ve1" /><aaif:adverb rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh#En1451Ph1Ad1" /><aaif:text> pisando  fuerte y sacando el pecho</aaif:text><aaif:annoText> [v|pisando|pisar|is]  [a|fuerte|fuerte|auvnmnnn] y sacando el pecho</aaif:annoText></aaif:Phrase><aaif:Verb rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En1451Ph1Ve1"><aaif:text>pisando</aaif:text><aaif:lemma rdf:resource="https://gams.uni-graz.at/o:aaif.lemma#pisar" /><aaif:position rdf:datatype="http://www.w3.org/2001/XMLSchema#int">1</aaif:position><aaif:coordinated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:coordinated><aaif:partOfText rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</aaif:partOfText><aaif:syntacticConstruction rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Intransitive" /></aaif:Verb><aaif:Adverb rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En1451Ph1Ad1"><aaif:text>fuerte</aaif:text><aaif:lemma rdf:resource="https://gams.uni-graz.at/o:aaif.lemma#fuerte" /><aaif:position rdf:datatype="http://www.w3.org/2001/XMLSchema#int">2</aaif:position><aaif:coordinated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:coordinated><aaif:morphosyntacticStructure rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Adjective" /><aaif:inflection rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Uninflected" /><aaif:attributionTarget rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Verb" /><aaif:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:modified><aaif:semanticClassification rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Manner" /><aaif:reduplicated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:reduplicated><aaif:prepositionalPhrase rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:prepositionalPhrase></aaif:Adverb><aaif:Entry rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En1452"><aaif:phrase rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh#En1452Ph1" /><aaif:source rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh.bibl#Cnde62" /><gams:textualContent>qué contento estaba ese loco de Freddy.En el picó había un long play de Cortijo y  su combo  sonando fuerte  y Freddy se reía y lo bailaba mientras Wilson desde el suelo le decía tú eres el hombre del</gams:textualContent><rel:isPartOf rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh" /></aaif:Entry><aaif:Phrase rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En1452Ph1"><aaif:subject rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh#En1452Ph1Su1" /><aaif:verb rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh#En1452Ph1Ve1" /><aaif:adverb rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh#En1452Ph1Ad1" /><aaif:text> su combo  sonando fuerte </aaif:text><aaif:annoText> [s|su combo|ms]  [v|sonando|sonar|is] [a|fuerte|fuerte|auvnmnnn] </aaif:annoText></aaif:Phrase><aaif:Subject rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En1452Ph1Su1"><aaif:text>su combo</aaif:text><aaif:position rdf:datatype="http://www.w3.org/2001/XMLSchema#int">1</aaif:position><aaif:gender rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Masculine" /><aaif:number rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Singular" /><aaif:overt rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</aaif:overt></aaif:Subject><aaif:Verb rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En1452Ph1Ve1"><aaif:text>sonando</aaif:text><aaif:lemma rdf:resource="https://gams.uni-graz.at/o:aaif.lemma#sonar" /><aaif:position rdf:datatype="http://www.w3.org/2001/XMLSchema#int">2</aaif:position><aaif:coordinated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:coordinated><aaif:partOfText rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</aaif:partOfText><aaif:syntacticConstruction rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Intransitive" /></aaif:Verb><aaif:Adverb rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En1452Ph1Ad1"><aaif:text>fuerte</aaif:text><aaif:lemma rdf:resource="https://gams.uni-graz.at/o:aaif.lemma#fuerte" /><aaif:position rdf:datatype="http://www.w3.org/2001/XMLSchema#int">3</aaif:position><aaif:coordinated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:coordinated><aaif:morphosyntacticStructure rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Adjective" /><aaif:inflection rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Uninflected" /><aaif:attributionTarget rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Verb" /><aaif:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:modified><aaif:semanticClassification rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Manner" /><aaif:reduplicated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:reduplicated><aaif:prepositionalPhrase rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:prepositionalPhrase></aaif:Adverb><aaif:Entry rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En1453"><aaif:phrase rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh#En1453Ph1" /><aaif:source rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh.bibl#Cnde62" /><gams:textualContent>unos lagrimones enormes, en completo silencio, y después apoyó la cabeza en mi pecho y  yo la estreché fuerte , con mucho cariño y mucha pena, para que se desahogara, porque sabía muy bien que esa vez (</gams:textualContent><rel:isPartOf rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh" /></aaif:Entry><aaif:Phrase rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En1453Ph1"><aaif:subject rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh#En1453Ph1Su1" /><aaif:verb rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh#En1453Ph1Ve1" /><aaif:adverb rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh#En1453Ph1Ad1" /><aaif:text> yo la estreché fuerte </aaif:text><aaif:annoText> [s|yo|us] la [v|estreché|estrechar|ts] [a|fuerte|fuerte|auvnmnnn] </aaif:annoText></aaif:Phrase><aaif:Subject rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En1453Ph1Su1"><aaif:text>yo</aaif:text><aaif:position rdf:datatype="http://www.w3.org/2001/XMLSchema#int">1</aaif:position><aaif:gender rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Undefined" /><aaif:number rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Singular" /><aaif:overt rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</aaif:overt></aaif:Subject><aaif:Verb rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En1453Ph1Ve1"><aaif:text>estreché</aaif:text><aaif:lemma rdf:resource="https://gams.uni-graz.at/o:aaif.lemma#estrechar" /><aaif:position rdf:datatype="http://www.w3.org/2001/XMLSchema#int">2</aaif:position><aaif:coordinated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:coordinated><aaif:partOfText rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</aaif:partOfText><aaif:syntacticConstruction rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Transitive" /></aaif:Verb><aaif:Adverb rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En1453Ph1Ad1"><aaif:text>fuerte</aaif:text><aaif:lemma rdf:resource="https://gams.uni-graz.at/o:aaif.lemma#fuerte" /><aaif:position rdf:datatype="http://www.w3.org/2001/XMLSchema#int">3</aaif:position><aaif:coordinated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:coordinated><aaif:morphosyntacticStructure rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Adjective" /><aaif:inflection rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Uninflected" /><aaif:attributionTarget rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Verb" /><aaif:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:modified><aaif:semanticClassification rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Manner" /><aaif:reduplicated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:reduplicated><aaif:prepositionalPhrase rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:prepositionalPhrase></aaif:Adverb><aaif:Entry rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En1454"><aaif:phrase rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh#En1454Ph1" /><aaif:source rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh.bibl#Cnde62" /><gams:textualContent>notó de pronto que  las dos piernas de Carmelo hacía un momentito que rozaban las suyas y que ahora las apretaban fuerte , como en una tijereta de desasosiego, debajo de la mesa.Le hizo un poco de daño físico aquella</gams:textualContent><rel:isPartOf rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh" /></aaif:Entry><aaif:Phrase rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En1454Ph1"><aaif:subject rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh#En1454Ph1Su1" /><aaif:verb rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh#En1454Ph1Ve1" /><aaif:adverb rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh#En1454Ph1Ad1" /><aaif:text> las dos piernas de Carmelo hacía un momentito que rozaban las suyas y que ahora las apretaban fuerte </aaif:text><aaif:annoText> [s|las dos piernas de Carmelo|fp] hacía un momentito que rozaban las suyas y que ahora las [v|apretaban|apretar|ts] [a|fuerte|fuerte|auvnmnnn] </aaif:annoText></aaif:Phrase><aaif:Subject rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En1454Ph1Su1"><aaif:text>las dos piernas de Carmelo</aaif:text><aaif:position rdf:datatype="http://www.w3.org/2001/XMLSchema#int">1</aaif:position><aaif:gender rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Feminine" /><aaif:number rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Plural" /><aaif:overt rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</aaif:overt></aaif:Subject><aaif:Verb rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En1454Ph1Ve1"><aaif:text>apretaban</aaif:text><aaif:lemma rdf:resource="https://gams.uni-graz.at/o:aaif.lemma#apretar" /><aaif:position rdf:datatype="http://www.w3.org/2001/XMLSchema#int">2</aaif:position><aaif:coordinated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:coordinated><aaif:partOfText rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</aaif:partOfText><aaif:syntacticConstruction rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Transitive" /></aaif:Verb><aaif:Adverb rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En1454Ph1Ad1"><aaif:text>fuerte</aaif:text><aaif:lemma rdf:resource="https://gams.uni-graz.at/o:aaif.lemma#fuerte" /><aaif:position rdf:datatype="http://www.w3.org/2001/XMLSchema#int">3</aaif:position><aaif:coordinated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:coordinated><aaif:morphosyntacticStructure rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Adjective" /><aaif:inflection rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Uninflected" /><aaif:attributionTarget rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Verb" /><aaif:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:modified><aaif:semanticClassification rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Manner" /><aaif:reduplicated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:reduplicated><aaif:prepositionalPhrase rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:prepositionalPhrase></aaif:Adverb><aaif:Entry rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En1455"><aaif:phrase rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh#En1455Ph1" /><aaif:source rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh.bibl#Cnde62" /><gams:textualContent>frente, desnudo, jugaba con su recuerdo, cerraba los ojos debajo del agua y se lo imaginaba abrazándola fuerte en una habitación llena de espejos y frascos de perfume.Tanto soñó con él que apenas le dio tiempo</gams:textualContent><rel:isPartOf rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh" /></aaif:Entry><aaif:Phrase rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En1455Ph1"><aaif:verb rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh#En1455Ph1Ve1" /><aaif:adverb rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh#En1455Ph1Ad1" /><aaif:text>se lo imaginaba abrazándola fuerte en una habitación llena de espejos</aaif:text><aaif:annoText>se lo imaginaba [v|abrazándola|abrazar|ts] [a|fuerte|fuerte|auvnmnnn] en una habitación llena de espejos</aaif:annoText></aaif:Phrase><aaif:Verb rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En1455Ph1Ve1"><aaif:text>abrazándola</aaif:text><aaif:lemma rdf:resource="https://gams.uni-graz.at/o:aaif.lemma#abrazar" /><aaif:position rdf:datatype="http://www.w3.org/2001/XMLSchema#int">1</aaif:position><aaif:coordinated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:coordinated><aaif:partOfText rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</aaif:partOfText><aaif:syntacticConstruction rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Transitive" /></aaif:Verb><aaif:Adverb rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En1455Ph1Ad1"><aaif:text>fuerte</aaif:text><aaif:lemma rdf:resource="https://gams.uni-graz.at/o:aaif.lemma#fuerte" /><aaif:position rdf:datatype="http://www.w3.org/2001/XMLSchema#int">2</aaif:position><aaif:coordinated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:coordinated><aaif:morphosyntacticStructure rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Adjective" /><aaif:inflection rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Uninflected" /><aaif:attributionTarget rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Verb" /><aaif:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:modified><aaif:semanticClassification rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Manner" /><aaif:reduplicated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:reduplicated><aaif:prepositionalPhrase rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:prepositionalPhrase></aaif:Adverb><aaif:Entry rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En1456"><aaif:phrase rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh#En1456Ph1" /><aaif:source rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh.bibl#Cnde266" /><gams:textualContent>golpe, tenso y rígido, como acordándose.Yo me vi también en Rácing,  Mauro y Celina  prendidos fuerte en ese tango que ella canturreó después toda la noche y en el taxi de vuelta.</gams:textualContent><rel:isPartOf rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh" /></aaif:Entry><aaif:Phrase rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En1456Ph1"><aaif:subject rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh#En1456Ph1Su1" /><aaif:verb rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh#En1456Ph1Ve1" /><aaif:adverb rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh#En1456Ph1Ad1" /><aaif:text> Mauro y Celina  prendidos fuerte en ese tango</aaif:text><aaif:annoText> [s|Mauro y Celina|mp]  [v|prendidos|prender|is] [a|fuerte|fuerte|auvnmnnn] en ese tango</aaif:annoText></aaif:Phrase><aaif:Subject rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En1456Ph1Su1"><aaif:text>Mauro y Celina</aaif:text><aaif:position rdf:datatype="http://www.w3.org/2001/XMLSchema#int">1</aaif:position><aaif:gender rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Masculine" /><aaif:number rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Plural" /><aaif:overt rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</aaif:overt></aaif:Subject><aaif:Verb rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En1456Ph1Ve1"><aaif:text>prendidos</aaif:text><aaif:lemma rdf:resource="https://gams.uni-graz.at/o:aaif.lemma#prender" /><aaif:position rdf:datatype="http://www.w3.org/2001/XMLSchema#int">2</aaif:position><aaif:coordinated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:coordinated><aaif:partOfText rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</aaif:partOfText><aaif:syntacticConstruction rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Intransitive" /></aaif:Verb><aaif:Adverb rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En1456Ph1Ad1"><aaif:text>fuerte</aaif:text><aaif:lemma rdf:resource="https://gams.uni-graz.at/o:aaif.lemma#fuerte" /><aaif:position rdf:datatype="http://www.w3.org/2001/XMLSchema#int">3</aaif:position><aaif:coordinated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:coordinated><aaif:morphosyntacticStructure rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Adjective" /><aaif:inflection rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Uninflected" /><aaif:attributionTarget rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Verb" /><aaif:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:modified><aaif:semanticClassification rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Manner" /><aaif:reduplicated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:reduplicated><aaif:prepositionalPhrase rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:prepositionalPhrase></aaif:Adverb><aaif:Entry rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En1457"><aaif:phrase rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh#En1457Ph1" /><aaif:source rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh.bibl#Cnde266" /><gams:textualContent>tranquilo y casi desdeñoso.Inmediatamente me he puesto en el bolsillo la cara de circunstancias, limitándome a apretarle fuerte la mano a Johnny, encender un cigarrillo y esperar.</gams:textualContent><rel:isPartOf rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh" /></aaif:Entry><aaif:Phrase rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En1457Ph1"><aaif:verb rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh#En1457Ph1Ve1" /><aaif:adverb rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh#En1457Ph1Ad1" /><aaif:text>limitándome a apretarle fuerte la mano a Johnny</aaif:text><aaif:annoText>limitándome a [v|apretarle|apretar|ts] [a|fuerte|fuerte|auvnmnnn] la mano a Johnny</aaif:annoText></aaif:Phrase><aaif:Verb rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En1457Ph1Ve1"><aaif:text>apretarle</aaif:text><aaif:lemma rdf:resource="https://gams.uni-graz.at/o:aaif.lemma#apretar" /><aaif:position rdf:datatype="http://www.w3.org/2001/XMLSchema#int">1</aaif:position><aaif:coordinated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:coordinated><aaif:partOfText rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</aaif:partOfText><aaif:syntacticConstruction rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Transitive" /></aaif:Verb><aaif:Adverb rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En1457Ph1Ad1"><aaif:text>fuerte</aaif:text><aaif:lemma rdf:resource="https://gams.uni-graz.at/o:aaif.lemma#fuerte" /><aaif:position rdf:datatype="http://www.w3.org/2001/XMLSchema#int">2</aaif:position><aaif:coordinated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:coordinated><aaif:morphosyntacticStructure rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Adjective" /><aaif:inflection rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Uninflected" /><aaif:attributionTarget rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Verb" /><aaif:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:modified><aaif:semanticClassification rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Manner" /><aaif:reduplicated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:reduplicated><aaif:prepositionalPhrase rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:prepositionalPhrase></aaif:Adverb><aaif:Entry rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En1458"><aaif:phrase rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh#En1458Ph1" /><aaif:source rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh.bibl#Cnde268" /><gams:textualContent>mundo, los pájaros y las ranas en su paz, ella y yo en nuestro gozo.Nos mirábamos fuerte , muy blancos del polvillo de la harina, y ¡empezábamos a reírnos!Echábamos unos tragos,</gams:textualContent><rel:isPartOf rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh" /></aaif:Entry><aaif:Phrase rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En1458Ph1"><aaif:verb rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh#En1458Ph1Ve1" /><aaif:adverb rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh#En1458Ph1Ad1" /><aaif:text>Nos mirábamos fuerte </aaif:text><aaif:annoText>Nos [v|mirábamos|mirar|rs] [a|fuerte|fuerte|auvnmnnn] </aaif:annoText></aaif:Phrase><aaif:Verb rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En1458Ph1Ve1"><aaif:text>mirábamos</aaif:text><aaif:lemma rdf:resource="https://gams.uni-graz.at/o:aaif.lemma#mirar" /><aaif:position rdf:datatype="http://www.w3.org/2001/XMLSchema#int">1</aaif:position><aaif:coordinated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:coordinated><aaif:partOfText rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</aaif:partOfText><aaif:syntacticConstruction rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Reflexive" /></aaif:Verb><aaif:Adverb rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En1458Ph1Ad1"><aaif:text>fuerte</aaif:text><aaif:lemma rdf:resource="https://gams.uni-graz.at/o:aaif.lemma#fuerte" /><aaif:position rdf:datatype="http://www.w3.org/2001/XMLSchema#int">2</aaif:position><aaif:coordinated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:coordinated><aaif:morphosyntacticStructure rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Adjective" /><aaif:inflection rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Uninflected" /><aaif:attributionTarget rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Verb" /><aaif:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:modified><aaif:semanticClassification rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Manner" /><aaif:reduplicated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:reduplicated><aaif:prepositionalPhrase rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:prepositionalPhrase></aaif:Adverb><aaif:Entry rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En1459"><aaif:phrase rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh#En1459Ph1" /><aaif:source rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh.bibl#Cnde268" /><gams:textualContent>Se abrazan fuerte porque la muerte está ahí, al otro extremo del pasillo, a la vuelta de las esquinas de la vida</gams:textualContent><rel:isPartOf rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh" /></aaif:Entry><aaif:Phrase rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En1459Ph1"><aaif:verb rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh#En1459Ph1Ve1" /><aaif:adverb rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh#En1459Ph1Ad1" /><aaif:text>Se abrazan fuerte porque la muerte está ahí</aaif:text><aaif:annoText>Se [v|abrazan|abrazar|rs] [a|fuerte|fuerte|auvnmnnn] porque la muerte está ahí</aaif:annoText></aaif:Phrase><aaif:Verb rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En1459Ph1Ve1"><aaif:text>abrazan</aaif:text><aaif:lemma rdf:resource="https://gams.uni-graz.at/o:aaif.lemma#abrazar" /><aaif:position rdf:datatype="http://www.w3.org/2001/XMLSchema#int">1</aaif:position><aaif:coordinated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:coordinated><aaif:partOfText rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</aaif:partOfText><aaif:syntacticConstruction rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Reflexive" /></aaif:Verb><aaif:Adverb rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En1459Ph1Ad1"><aaif:text>fuerte</aaif:text><aaif:lemma rdf:resource="https://gams.uni-graz.at/o:aaif.lemma#fuerte" /><aaif:position rdf:datatype="http://www.w3.org/2001/XMLSchema#int">2</aaif:position><aaif:coordinated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:coordinated><aaif:morphosyntacticStructure rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Adjective" /><aaif:inflection rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Uninflected" /><aaif:attributionTarget rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Verb" /><aaif:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:modified><aaif:semanticClassification rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Manner" /><aaif:reduplicated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:reduplicated><aaif:prepositionalPhrase rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:prepositionalPhrase></aaif:Adverb><aaif:Entry rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En1460"><aaif:phrase rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh#En1460Ph1" /><aaif:source rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh.bibl#Cnde268" /><gams:textualContent>está ahí, al otro extremo del pasillo, a la vuelta de las esquinas de la vida.Se abrazan fuerte , unidos hoy por la compasión como otras noches por la carne.</gams:textualContent><rel:isPartOf rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh" /></aaif:Entry><aaif:Phrase rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En1460Ph1"><aaif:verb rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh#En1460Ph1Ve1" /><aaif:adverb rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh#En1460Ph1Ad1" /><aaif:text>Se abrazan fuerte , unidos hoy por la compasión</aaif:text><aaif:annoText>Se [v|abrazan|abrazar|rs] [a|fuerte|fuerte|auvnmnnn] , unidos hoy por la compasión</aaif:annoText></aaif:Phrase><aaif:Verb rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En1460Ph1Ve1"><aaif:text>abrazan</aaif:text><aaif:lemma rdf:resource="https://gams.uni-graz.at/o:aaif.lemma#abrazar" /><aaif:position rdf:datatype="http://www.w3.org/2001/XMLSchema#int">1</aaif:position><aaif:coordinated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:coordinated><aaif:partOfText rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</aaif:partOfText><aaif:syntacticConstruction rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Reflexive" /></aaif:Verb><aaif:Adverb rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En1460Ph1Ad1"><aaif:text>fuerte</aaif:text><aaif:lemma rdf:resource="https://gams.uni-graz.at/o:aaif.lemma#fuerte" /><aaif:position rdf:datatype="http://www.w3.org/2001/XMLSchema#int">2</aaif:position><aaif:coordinated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:coordinated><aaif:morphosyntacticStructure rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Adjective" /><aaif:inflection rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Uninflected" /><aaif:attributionTarget rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Verb" /><aaif:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:modified><aaif:semanticClassification rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Manner" /><aaif:reduplicated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:reduplicated><aaif:prepositionalPhrase rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:prepositionalPhrase></aaif:Adverb><aaif:Entry rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En1461"><aaif:phrase rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh#En1461Ph1" /><aaif:source rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh.bibl#Cnde67" /><gams:textualContent> Antonio ha aprovechado que Octavia y Parsimonia andan haciendo compras, viene y me enlaza fuerte , con sus brazos de oso, torpes.Su boca busca la mía y es un gesto de toro</gams:textualContent><rel:isPartOf rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh" /></aaif:Entry><aaif:Phrase rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En1461Ph1"><aaif:subject rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh#En1461Ph1Su1" /><aaif:verb rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh#En1461Ph1Ve1" /><aaif:adverb rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh#En1461Ph1Ad1" /><aaif:text> Antonio ha aprovechado que Octavia y Parsimonia andan haciendo compras, viene y me enlaza fuerte , con sus brazos de oso, torpes</aaif:text><aaif:annoText> [s|Antonio|ms] ha aprovechado que Octavia y Parsimonia andan haciendo compras, viene y me [v|enlaza|enlazar|ts] [a|fuerte|fuerte|auvnmnnn] , con sus brazos de oso, torpes</aaif:annoText></aaif:Phrase><aaif:Subject rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En1461Ph1Su1"><aaif:text>Antonio</aaif:text><aaif:position rdf:datatype="http://www.w3.org/2001/XMLSchema#int">1</aaif:position><aaif:gender rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Masculine" /><aaif:number rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Singular" /><aaif:overt rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</aaif:overt></aaif:Subject><aaif:Verb rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En1461Ph1Ve1"><aaif:text>enlaza</aaif:text><aaif:lemma rdf:resource="https://gams.uni-graz.at/o:aaif.lemma#enlazar" /><aaif:position rdf:datatype="http://www.w3.org/2001/XMLSchema#int">2</aaif:position><aaif:coordinated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:coordinated><aaif:partOfText rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</aaif:partOfText><aaif:syntacticConstruction rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Transitive" /></aaif:Verb><aaif:Adverb rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En1461Ph1Ad1"><aaif:text>fuerte</aaif:text><aaif:lemma rdf:resource="https://gams.uni-graz.at/o:aaif.lemma#fuerte" /><aaif:position rdf:datatype="http://www.w3.org/2001/XMLSchema#int">3</aaif:position><aaif:coordinated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:coordinated><aaif:morphosyntacticStructure rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Adjective" /><aaif:inflection rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Uninflected" /><aaif:attributionTarget rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Verb" /><aaif:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:modified><aaif:semanticClassification rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Manner" /><aaif:reduplicated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:reduplicated><aaif:prepositionalPhrase rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:prepositionalPhrase></aaif:Adverb><aaif:Entry rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En1462"><aaif:phrase rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh#En1462Ph1" /><aaif:source rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh.bibl#Cnde67" /><gams:textualContent>una tarde caliente en que las olas se estrellaban sin merced contra el tajamar, corrí con el ombligo apretado fuerte contra mi pecho, corrí con ese pedacito de carne muerta viva hasta el «swimming», adonde me</gams:textualContent><rel:isPartOf rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh" /></aaif:Entry><aaif:Phrase rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En1462Ph1"><aaif:subject rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh#En1462Ph1Su1" /><aaif:verb rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh#En1462Ph1Ve1" /><aaif:adverb rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh#En1462Ph1Ad1" /><aaif:text>corrí con el ombligo apretado fuerte contra mi pecho</aaif:text><aaif:annoText>corrí con [s|el ombligo|ms] [v|apretado|apretar|is] [a|fuerte|fuerte|auvnmnnn] contra mi pecho</aaif:annoText></aaif:Phrase><aaif:Subject rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En1462Ph1Su1"><aaif:text>el ombligo</aaif:text><aaif:position rdf:datatype="http://www.w3.org/2001/XMLSchema#int">1</aaif:position><aaif:gender rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Masculine" /><aaif:number rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Singular" /><aaif:overt rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</aaif:overt></aaif:Subject><aaif:Verb rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En1462Ph1Ve1"><aaif:text>apretado</aaif:text><aaif:lemma rdf:resource="https://gams.uni-graz.at/o:aaif.lemma#apretar" /><aaif:position rdf:datatype="http://www.w3.org/2001/XMLSchema#int">2</aaif:position><aaif:coordinated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:coordinated><aaif:partOfText rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</aaif:partOfText><aaif:syntacticConstruction rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Intransitive" /></aaif:Verb><aaif:Adverb rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En1462Ph1Ad1"><aaif:text>fuerte</aaif:text><aaif:lemma rdf:resource="https://gams.uni-graz.at/o:aaif.lemma#fuerte" /><aaif:position rdf:datatype="http://www.w3.org/2001/XMLSchema#int">3</aaif:position><aaif:coordinated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:coordinated><aaif:morphosyntacticStructure rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Adjective" /><aaif:inflection rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Uninflected" /><aaif:attributionTarget rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Verb" /><aaif:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:modified><aaif:semanticClassification rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Manner" /><aaif:reduplicated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:reduplicated><aaif:prepositionalPhrase rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:prepositionalPhrase></aaif:Adverb><aaif:Entry rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En1463"><aaif:phrase rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh#En1463Ph1" /><aaif:source rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh.bibl#Cnde68" /><gams:textualContent> Mario se puso los pantalones y los amarró fuerte con la soga.</gams:textualContent><rel:isPartOf rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh" /></aaif:Entry><aaif:Phrase rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En1463Ph1"><aaif:subject rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh#En1463Ph1Su1" /><aaif:verb rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh#En1463Ph1Ve1" /><aaif:adverb rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh#En1463Ph1Ad1" /><aaif:text> Mario se puso los pantalones y los amarró fuerte con la soga</aaif:text><aaif:annoText> [s|Mario|ms] se puso los pantalones y los [v|amarró|amarrar|ts] [a|fuerte|fuerte|auvnmnnn] con la soga</aaif:annoText></aaif:Phrase><aaif:Subject rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En1463Ph1Su1"><aaif:text>Mario</aaif:text><aaif:position rdf:datatype="http://www.w3.org/2001/XMLSchema#int">1</aaif:position><aaif:gender rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Masculine" /><aaif:number rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Singular" /><aaif:overt rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</aaif:overt></aaif:Subject><aaif:Verb rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En1463Ph1Ve1"><aaif:text>amarró</aaif:text><aaif:lemma rdf:resource="https://gams.uni-graz.at/o:aaif.lemma#amarrar" /><aaif:position rdf:datatype="http://www.w3.org/2001/XMLSchema#int">2</aaif:position><aaif:coordinated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:coordinated><aaif:partOfText rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</aaif:partOfText><aaif:syntacticConstruction rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Transitive" /></aaif:Verb><aaif:Adverb rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En1463Ph1Ad1"><aaif:text>fuerte</aaif:text><aaif:lemma rdf:resource="https://gams.uni-graz.at/o:aaif.lemma#fuerte" /><aaif:position rdf:datatype="http://www.w3.org/2001/XMLSchema#int">3</aaif:position><aaif:coordinated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:coordinated><aaif:morphosyntacticStructure rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Adjective" /><aaif:inflection rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Uninflected" /><aaif:attributionTarget rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Verb" /><aaif:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:modified><aaif:semanticClassification rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Manner" /><aaif:reduplicated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:reduplicated><aaif:prepositionalPhrase rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:prepositionalPhrase></aaif:Adverb><aaif:Entry rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En1464"><aaif:phrase rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh#En1464Ph1" /><aaif:source rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh.bibl#Cnde188" /><gams:textualContent>Se pasó nuevamente la mano por la cara y luego cerró fuerte el puño, el codo sobre la mesa, y el mentón sobre el puño para que Daughter le encontrara con</gams:textualContent><rel:isPartOf rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh" /></aaif:Entry><aaif:Phrase rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En1464Ph1"><aaif:verb rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh#En1464Ph1Ve1" /><aaif:adverb rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh#En1464Ph1Ad1" /><aaif:text>Se pasó nuevamente la mano por la cara y luego cerró fuerte el puño</aaif:text><aaif:annoText>Se pasó nuevamente la mano por la cara y luego [v|cerró|cerrar|ts] [a|fuerte|fuerte|auvnmnnn] el puño</aaif:annoText></aaif:Phrase><aaif:Verb rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En1464Ph1Ve1"><aaif:text>cerró</aaif:text><aaif:lemma rdf:resource="https://gams.uni-graz.at/o:aaif.lemma#cerrar" /><aaif:position rdf:datatype="http://www.w3.org/2001/XMLSchema#int">1</aaif:position><aaif:coordinated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:coordinated><aaif:partOfText rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</aaif:partOfText><aaif:syntacticConstruction rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Transitive" /></aaif:Verb><aaif:Adverb rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En1464Ph1Ad1"><aaif:text>fuerte</aaif:text><aaif:lemma rdf:resource="https://gams.uni-graz.at/o:aaif.lemma#fuerte" /><aaif:position rdf:datatype="http://www.w3.org/2001/XMLSchema#int">2</aaif:position><aaif:coordinated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:coordinated><aaif:morphosyntacticStructure rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Adjective" /><aaif:inflection rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Uninflected" /><aaif:attributionTarget rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Verb" /><aaif:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:modified><aaif:semanticClassification rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Manner" /><aaif:reduplicated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:reduplicated><aaif:prepositionalPhrase rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:prepositionalPhrase></aaif:Adverb><aaif:Entry rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En1465"><aaif:phrase rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh#En1465Ph1" /><aaif:source rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh.bibl#Cnde188" /><gams:textualContent> Apreté  fuertísimo .</gams:textualContent><rel:isPartOf rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh" /></aaif:Entry><aaif:Phrase rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En1465Ph1"><aaif:verb rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh#En1465Ph1Ve1" /><aaif:adverb rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh#En1465Ph1Ad1" /><aaif:text> Apreté  fuertísimo </aaif:text><aaif:annoText> [v|Apreté|apretar|is]  [a|fuertísimo|fuerte|auvnmnnn] </aaif:annoText></aaif:Phrase><aaif:Verb rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En1465Ph1Ve1"><aaif:text>Apreté</aaif:text><aaif:lemma rdf:resource="https://gams.uni-graz.at/o:aaif.lemma#apretar" /><aaif:position rdf:datatype="http://www.w3.org/2001/XMLSchema#int">1</aaif:position><aaif:coordinated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:coordinated><aaif:partOfText rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</aaif:partOfText><aaif:syntacticConstruction rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Intransitive" /></aaif:Verb><aaif:Adverb rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En1465Ph1Ad1"><aaif:text>fuertísimo</aaif:text><aaif:lemma rdf:resource="https://gams.uni-graz.at/o:aaif.lemma#fuerte" /><aaif:position rdf:datatype="http://www.w3.org/2001/XMLSchema#int">2</aaif:position><aaif:coordinated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:coordinated><aaif:morphosyntacticStructure rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Adjective" /><aaif:inflection rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Uninflected" /><aaif:attributionTarget rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Verb" /><aaif:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:modified><aaif:semanticClassification rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Manner" /><aaif:reduplicated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:reduplicated><aaif:prepositionalPhrase rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:prepositionalPhrase></aaif:Adverb><aaif:Entry rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En1466"><aaif:phrase rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh#En1466Ph1" /><aaif:source rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh.bibl#Cnde188" /><gams:textualContent>Se ganó un manotazo de Florence.Yo, en cambio, me gané las dos manos de Florence apretando fuertísimo el antebrazo de terciopelo negro de mi saco, mientras me clavaba los ojos de cuando nos quedaban sólo segundos</gams:textualContent><rel:isPartOf rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh" /></aaif:Entry><aaif:Phrase rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En1466Ph1"><aaif:verb rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh#En1466Ph1Ve1" /><aaif:adverb rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh#En1466Ph1Ad1" /><aaif:text>me gané las dos manos de Florence apretando fuertísimo el antebrazo</aaif:text><aaif:annoText>me gané las dos manos de Florence [v|apretando|apretar|ts] [a|fuertísimo|fuerte|auvnmnnn] el antebrazo</aaif:annoText></aaif:Phrase><aaif:Verb rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En1466Ph1Ve1"><aaif:text>apretando</aaif:text><aaif:lemma rdf:resource="https://gams.uni-graz.at/o:aaif.lemma#apretar" /><aaif:position rdf:datatype="http://www.w3.org/2001/XMLSchema#int">1</aaif:position><aaif:coordinated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:coordinated><aaif:partOfText rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</aaif:partOfText><aaif:syntacticConstruction rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Transitive" /></aaif:Verb><aaif:Adverb rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En1466Ph1Ad1"><aaif:text>fuertísimo</aaif:text><aaif:lemma rdf:resource="https://gams.uni-graz.at/o:aaif.lemma#fuerte" /><aaif:position rdf:datatype="http://www.w3.org/2001/XMLSchema#int">2</aaif:position><aaif:coordinated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:coordinated><aaif:morphosyntacticStructure rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Adjective" /><aaif:inflection rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Uninflected" /><aaif:attributionTarget rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Verb" /><aaif:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:modified><aaif:semanticClassification rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Manner" /><aaif:reduplicated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:reduplicated><aaif:prepositionalPhrase rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:prepositionalPhrase></aaif:Adverb><aaif:Entry rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En1467"><aaif:phrase rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh#En1467Ph1" /><aaif:source rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh.bibl#Cnde70" /><gams:textualContent>del pueblo mi madre me confió esta tediosa tarea: yo debía despertar a Etelvina todos los días tocándole fuerte en la puerta hasta que ella declarara que estaba despierta.Pero de ninguna manera debía yo entrar en su cuarto;</gams:textualContent><rel:isPartOf rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh" /></aaif:Entry><aaif:Phrase rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En1467Ph1"><aaif:verb rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh#En1467Ph1Ve1" /><aaif:adverb rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh#En1467Ph1Ad1" /><aaif:text>despertar a Etelvina todos los días tocándole fuerte en la puerta</aaif:text><aaif:annoText>despertar a Etelvina todos los días [v|tocándole|tocar|ts] [a|fuerte|fuerte|auvnmnnn] en la puerta</aaif:annoText></aaif:Phrase><aaif:Verb rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En1467Ph1Ve1"><aaif:text>tocándole</aaif:text><aaif:lemma rdf:resource="https://gams.uni-graz.at/o:aaif.lemma#tocar" /><aaif:position rdf:datatype="http://www.w3.org/2001/XMLSchema#int">1</aaif:position><aaif:coordinated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:coordinated><aaif:partOfText rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</aaif:partOfText><aaif:syntacticConstruction rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Transitive" /></aaif:Verb><aaif:Adverb rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En1467Ph1Ad1"><aaif:text>fuerte</aaif:text><aaif:lemma rdf:resource="https://gams.uni-graz.at/o:aaif.lemma#fuerte" /><aaif:position rdf:datatype="http://www.w3.org/2001/XMLSchema#int">2</aaif:position><aaif:coordinated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:coordinated><aaif:morphosyntacticStructure rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Adjective" /><aaif:inflection rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Uninflected" /><aaif:attributionTarget rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Verb" /><aaif:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:modified><aaif:semanticClassification rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Manner" /><aaif:reduplicated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:reduplicated><aaif:prepositionalPhrase rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:prepositionalPhrase></aaif:Adverb><aaif:Entry rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En1468"><aaif:phrase rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh#En1468Ph1" /><aaif:source rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh.bibl#Cnde70" /><gams:textualContent>lo que tuve que bajar hasta su boca, a borrar sus labios dibujados.Nos besamos: ella besaba fuerte , apasionada aparente, clavándome a veces los dientes en mi labio inferior.</gams:textualContent><rel:isPartOf rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh" /></aaif:Entry><aaif:Phrase rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En1468Ph1"><aaif:subject rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh#En1468Ph1Su1" /><aaif:verb rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh#En1468Ph1Ve1" /><aaif:adverb rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh#En1468Ph1Ad1" /><aaif:adverb rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh#En1468Ph1Ad2" /><aaif:text>Nos besamos: ella besaba fuerte , apasionada aparente</aaif:text><aaif:annoText>Nos besamos: [s|ella|fs] [v|besaba|besar|is] [a|fuerte|fuerte|auvnmnnC] , [a|apasionada|apasionado|afsnmnnC] aparente</aaif:annoText></aaif:Phrase><aaif:Subject rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En1468Ph1Su1"><aaif:text>ella</aaif:text><aaif:position rdf:datatype="http://www.w3.org/2001/XMLSchema#int">1</aaif:position><aaif:gender rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Feminine" /><aaif:number rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Singular" /><aaif:overt rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</aaif:overt></aaif:Subject><aaif:Verb rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En1468Ph1Ve1"><aaif:text>besaba</aaif:text><aaif:lemma rdf:resource="https://gams.uni-graz.at/o:aaif.lemma#besar" /><aaif:position rdf:datatype="http://www.w3.org/2001/XMLSchema#int">2</aaif:position><aaif:coordinated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:coordinated><aaif:partOfText rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</aaif:partOfText><aaif:syntacticConstruction rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Intransitive" /></aaif:Verb><aaif:Adverb rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En1468Ph1Ad1"><aaif:text>fuerte</aaif:text><aaif:lemma rdf:resource="https://gams.uni-graz.at/o:aaif.lemma#fuerte" /><aaif:position rdf:datatype="http://www.w3.org/2001/XMLSchema#int">3</aaif:position><aaif:coordinated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</aaif:coordinated><aaif:morphosyntacticStructure rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Adjective" /><aaif:inflection rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Uninflected" /><aaif:attributionTarget rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Verb" /><aaif:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:modified><aaif:semanticClassification rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Manner" /><aaif:reduplicated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:reduplicated><aaif:prepositionalPhrase rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:prepositionalPhrase></aaif:Adverb><aaif:Adverb rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En1468Ph1Ad2"><aaif:text>apasionada</aaif:text><aaif:lemma rdf:resource="https://gams.uni-graz.at/o:aaif.lemma#apasionado" /><aaif:position rdf:datatype="http://www.w3.org/2001/XMLSchema#int">4</aaif:position><aaif:coordinated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</aaif:coordinated><aaif:morphosyntacticStructure rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Adjective" /><aaif:inflection rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#FeminineSingular" /><aaif:attributionTarget rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Verb" /><aaif:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:modified><aaif:semanticClassification rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Manner" /><aaif:reduplicated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:reduplicated><aaif:prepositionalPhrase rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:prepositionalPhrase></aaif:Adverb><aaif:Entry rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En1469"><aaif:phrase rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh#En1469Ph1" /><aaif:source rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh.bibl#Cnde70" /><gams:textualContent>Yo respondía a sus besos con ansia lujuriosa, y al hacerlo me pasó el pie por toda la pantorrilla, deliberadamente,  su zapato  rozando fuerte mi pantalón.</gams:textualContent><rel:isPartOf rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh" /></aaif:Entry><aaif:Phrase rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En1469Ph1"><aaif:subject rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh#En1469Ph1Su1" /><aaif:verb rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh#En1469Ph1Ve1" /><aaif:adverb rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh#En1469Ph1Ad1" /><aaif:text> su zapato  rozando fuerte mi pantalón</aaif:text><aaif:annoText> [s|su zapato|ms]  [v|rozando|rozar|ts] [a|fuerte|fuerte|auvnmnnn] mi pantalón</aaif:annoText></aaif:Phrase><aaif:Subject rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En1469Ph1Su1"><aaif:text>su zapato</aaif:text><aaif:position rdf:datatype="http://www.w3.org/2001/XMLSchema#int">1</aaif:position><aaif:gender rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Masculine" /><aaif:number rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Singular" /><aaif:overt rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</aaif:overt></aaif:Subject><aaif:Verb rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En1469Ph1Ve1"><aaif:text>rozando</aaif:text><aaif:lemma rdf:resource="https://gams.uni-graz.at/o:aaif.lemma#rozar" /><aaif:position rdf:datatype="http://www.w3.org/2001/XMLSchema#int">2</aaif:position><aaif:coordinated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:coordinated><aaif:partOfText rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</aaif:partOfText><aaif:syntacticConstruction rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Transitive" /></aaif:Verb><aaif:Adverb rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En1469Ph1Ad1"><aaif:text>fuerte</aaif:text><aaif:lemma rdf:resource="https://gams.uni-graz.at/o:aaif.lemma#fuerte" /><aaif:position rdf:datatype="http://www.w3.org/2001/XMLSchema#int">3</aaif:position><aaif:coordinated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:coordinated><aaif:morphosyntacticStructure rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Adjective" /><aaif:inflection rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Uninflected" /><aaif:attributionTarget rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Verb" /><aaif:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:modified><aaif:semanticClassification rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Manner" /><aaif:reduplicated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:reduplicated><aaif:prepositionalPhrase rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:prepositionalPhrase></aaif:Adverb><aaif:Entry rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En1470"><aaif:phrase rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh#En1470Ph1" /><aaif:source rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh.bibl#Cnde70" /><gams:textualContent>¿o era espacio?—.Antes de llegar a la Calle 23 le di vueltas y la besé fuerte .Ella me devolvió el beso, con pintura pegajosa de extra.Ahora tengo que explicar que un poco</gams:textualContent><rel:isPartOf rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh" /></aaif:Entry><aaif:Phrase rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En1470Ph1"><aaif:verb rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh#En1470Ph1Ve1" /><aaif:adverb rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh#En1470Ph1Ad1" /><aaif:text>le di vueltas y la besé fuerte </aaif:text><aaif:annoText>le di vueltas y la [v|besé|besar|ts] [a|fuerte|fuerte|auvnmnnn] </aaif:annoText></aaif:Phrase><aaif:Verb rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En1470Ph1Ve1"><aaif:text>besé</aaif:text><aaif:lemma rdf:resource="https://gams.uni-graz.at/o:aaif.lemma#besar" /><aaif:position rdf:datatype="http://www.w3.org/2001/XMLSchema#int">1</aaif:position><aaif:coordinated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:coordinated><aaif:partOfText rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</aaif:partOfText><aaif:syntacticConstruction rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Transitive" /></aaif:Verb><aaif:Adverb rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En1470Ph1Ad1"><aaif:text>fuerte</aaif:text><aaif:lemma rdf:resource="https://gams.uni-graz.at/o:aaif.lemma#fuerte" /><aaif:position rdf:datatype="http://www.w3.org/2001/XMLSchema#int">2</aaif:position><aaif:coordinated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:coordinated><aaif:morphosyntacticStructure rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Adjective" /><aaif:inflection rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Uninflected" /><aaif:attributionTarget rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Verb" /><aaif:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:modified><aaif:semanticClassification rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Manner" /><aaif:reduplicated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:reduplicated><aaif:prepositionalPhrase rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:prepositionalPhrase></aaif:Adverb><aaif:Entry rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En1471"><aaif:phrase rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh#En1471Ph1" /><aaif:source rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh.bibl#Cnde70" /><gams:textualContent>Miércoles, 19 de agosto.Afortunadamente, los vientos que soplan fuerte nos permitieron alejarnos del escenario de la batalla.</gams:textualContent><rel:isPartOf rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh" /></aaif:Entry><aaif:Phrase rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En1471Ph1"><aaif:verb rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh#En1471Ph1Ve1" /><aaif:adverb rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh#En1471Ph1Ad1" /><aaif:text>los vientos que soplan fuerte nos permitieron alejarnos</aaif:text><aaif:annoText>los vientos que [v|soplan|soplar|is] [a|fuerte|fuerte|auvnmnnn] nos permitieron alejarnos</aaif:annoText></aaif:Phrase><aaif:Verb rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En1471Ph1Ve1"><aaif:text>soplan</aaif:text><aaif:lemma rdf:resource="https://gams.uni-graz.at/o:aaif.lemma#soplar" /><aaif:position rdf:datatype="http://www.w3.org/2001/XMLSchema#int">1</aaif:position><aaif:coordinated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:coordinated><aaif:partOfText rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</aaif:partOfText><aaif:syntacticConstruction rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Intransitive" /></aaif:Verb><aaif:Adverb rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En1471Ph1Ad1"><aaif:text>fuerte</aaif:text><aaif:lemma rdf:resource="https://gams.uni-graz.at/o:aaif.lemma#fuerte" /><aaif:position rdf:datatype="http://www.w3.org/2001/XMLSchema#int">2</aaif:position><aaif:coordinated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:coordinated><aaif:morphosyntacticStructure rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Adjective" /><aaif:inflection rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Uninflected" /><aaif:attributionTarget rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Verb" /><aaif:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:modified><aaif:semanticClassification rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Manner" /><aaif:reduplicated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:reduplicated><aaif:prepositionalPhrase rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:prepositionalPhrase></aaif:Adverb><aaif:Entry rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En1472"><aaif:phrase rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh#En1472Ph1" /><aaif:source rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh.bibl#Cnde536" /><gams:textualContent>gula y lujuria halló la muerte.&lt;lb/&gt;Si hacer quieres por él alguna cosa, &lt;lb/&gt;levanta el calañés, escupe fuerte , &lt;lb/&gt;reza un responso y cágate en la fosa.»</gams:textualContent><rel:isPartOf rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh" /></aaif:Entry><aaif:Phrase rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En1472Ph1"><aaif:verb rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh#En1472Ph1Ve1" /><aaif:adverb rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh#En1472Ph1Ad1" /><aaif:text>levanta el calañés, escupe fuerte </aaif:text><aaif:annoText>levanta el calañés, [v|escupe|escupir|is] [a|fuerte|fuerte|auvnmnnn] </aaif:annoText></aaif:Phrase><aaif:Verb rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En1472Ph1Ve1"><aaif:text>escupe</aaif:text><aaif:lemma rdf:resource="https://gams.uni-graz.at/o:aaif.lemma#escupir" /><aaif:position rdf:datatype="http://www.w3.org/2001/XMLSchema#int">1</aaif:position><aaif:coordinated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:coordinated><aaif:partOfText rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</aaif:partOfText><aaif:syntacticConstruction rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Intransitive" /></aaif:Verb><aaif:Adverb rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En1472Ph1Ad1"><aaif:text>fuerte</aaif:text><aaif:lemma rdf:resource="https://gams.uni-graz.at/o:aaif.lemma#fuerte" /><aaif:position rdf:datatype="http://www.w3.org/2001/XMLSchema#int">2</aaif:position><aaif:coordinated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:coordinated><aaif:morphosyntacticStructure rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Adjective" /><aaif:inflection rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Uninflected" /><aaif:attributionTarget rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Verb" /><aaif:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:modified><aaif:semanticClassification rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Manner" /><aaif:reduplicated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:reduplicated><aaif:prepositionalPhrase rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:prepositionalPhrase></aaif:Adverb><aaif:Entry rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En1473"><aaif:phrase rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh#En1473Ph1" /><aaif:source rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh.bibl#Cnde536" /><gams:textualContent>he mantenido una discreta vigilancia sobre el pájaro, y creo que el asunto ya está maduro para que podamos jugar fuerte .Tenemos en nuestra mano destapar un escándalo que lo lleve a la ruina, e incluso podemos hacerle pasar</gams:textualContent><rel:isPartOf rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh" /></aaif:Entry><aaif:Phrase rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En1473Ph1"><aaif:verb rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh#En1473Ph1Ve1" /><aaif:adverb rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh#En1473Ph1Ad1" /><aaif:text>para que podamos jugar fuerte </aaif:text><aaif:annoText>para que podamos [v|jugar|jugar|is] [a|fuerte|fuerte|auvnmnnn] </aaif:annoText></aaif:Phrase><aaif:Verb rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En1473Ph1Ve1"><aaif:text>jugar</aaif:text><aaif:lemma rdf:resource="https://gams.uni-graz.at/o:aaif.lemma#jugar" /><aaif:position rdf:datatype="http://www.w3.org/2001/XMLSchema#int">1</aaif:position><aaif:coordinated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:coordinated><aaif:partOfText rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</aaif:partOfText><aaif:syntacticConstruction rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Intransitive" /></aaif:Verb><aaif:Adverb rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En1473Ph1Ad1"><aaif:text>fuerte</aaif:text><aaif:lemma rdf:resource="https://gams.uni-graz.at/o:aaif.lemma#fuerte" /><aaif:position rdf:datatype="http://www.w3.org/2001/XMLSchema#int">2</aaif:position><aaif:coordinated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:coordinated><aaif:morphosyntacticStructure rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Adjective" /><aaif:inflection rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Uninflected" /><aaif:attributionTarget rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Verb" /><aaif:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:modified><aaif:semanticClassification rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Manner" /><aaif:reduplicated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:reduplicated><aaif:prepositionalPhrase rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:prepositionalPhrase></aaif:Adverb><aaif:Entry rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En1474"><aaif:phrase rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh#En1474Ph1" /><aaif:source rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh.bibl#Cnde537" /><gams:textualContent>y obligatorio huevo tibio.Mamá Elena la obligaba a comerlo.Ella sentía que el esófago se le cerraba fuerte, muy fuerte , incapaz de poder deglutir alimento alguno, hasta que su madre le propinaba un coscorrón que</gams:textualContent><rel:isPartOf rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh" /></aaif:Entry><aaif:Phrase rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En1474Ph1"><aaif:subject rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh#En1474Ph1Su1" /><aaif:verb rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh#En1474Ph1Ve1" /><aaif:adverb rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh#En1474Ph1Ad1" /><aaif:text>Ella sentía que el esófago se le cerraba fuerte, muy fuerte </aaif:text><aaif:annoText>Ella sentía que [s|el esófago|ms] se le [v|cerraba|cerrar|rs] fuerte, muy [a|fuerte|fuerte|auvmmrnn] </aaif:annoText></aaif:Phrase><aaif:Subject rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En1474Ph1Su1"><aaif:text>el esófago</aaif:text><aaif:position rdf:datatype="http://www.w3.org/2001/XMLSchema#int">1</aaif:position><aaif:gender rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Masculine" /><aaif:number rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Singular" /><aaif:overt rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</aaif:overt></aaif:Subject><aaif:Verb rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En1474Ph1Ve1"><aaif:text>cerraba</aaif:text><aaif:lemma rdf:resource="https://gams.uni-graz.at/o:aaif.lemma#cerrar" /><aaif:position rdf:datatype="http://www.w3.org/2001/XMLSchema#int">2</aaif:position><aaif:coordinated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:coordinated><aaif:partOfText rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</aaif:partOfText><aaif:syntacticConstruction rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Reflexive" /></aaif:Verb><aaif:Adverb rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En1474Ph1Ad1"><aaif:text>fuerte</aaif:text><aaif:lemma rdf:resource="https://gams.uni-graz.at/o:aaif.lemma#fuerte" /><aaif:position rdf:datatype="http://www.w3.org/2001/XMLSchema#int">3</aaif:position><aaif:coordinated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:coordinated><aaif:morphosyntacticStructure rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Adjective" /><aaif:inflection rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Uninflected" /><aaif:attributionTarget rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Verb" /><aaif:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</aaif:modified><aaif:semanticClassification rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Manner" /><aaif:reduplicated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</aaif:reduplicated><aaif:prepositionalPhrase rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:prepositionalPhrase></aaif:Adverb><aaif:Entry rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En1475"><aaif:phrase rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh#En1475Ph1" /><aaif:source rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh.bibl#Cnde495" /><gams:textualContent>ver así que sus inquietudes exigían de escenarios más ambiciosos, reales y viriles, con el tiempo también jugó fuerte , sin conceder al adversario la más leve ventaja.Luego, se entregaban nuevamente, con fervor de</gams:textualContent><rel:isPartOf rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh" /></aaif:Entry><aaif:Phrase rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En1475Ph1"><aaif:verb rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh#En1475Ph1Ve1" /><aaif:adverb rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh#En1475Ph1Ad1" /><aaif:text>sus inquietudes exigían de escenarios más ambiciosos, reales y viriles, con el tiempo también jugó fuerte </aaif:text><aaif:annoText>sus inquietudes exigían de escenarios más ambiciosos, reales y viriles, con el tiempo también [v|jugó|jugar|is] [a|fuerte|fuerte|auvnmnnn] </aaif:annoText></aaif:Phrase><aaif:Verb rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En1475Ph1Ve1"><aaif:text>jugó</aaif:text><aaif:lemma rdf:resource="https://gams.uni-graz.at/o:aaif.lemma#jugar" /><aaif:position rdf:datatype="http://www.w3.org/2001/XMLSchema#int">1</aaif:position><aaif:coordinated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:coordinated><aaif:partOfText rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</aaif:partOfText><aaif:syntacticConstruction rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Intransitive" /></aaif:Verb><aaif:Adverb rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En1475Ph1Ad1"><aaif:text>fuerte</aaif:text><aaif:lemma rdf:resource="https://gams.uni-graz.at/o:aaif.lemma#fuerte" /><aaif:position rdf:datatype="http://www.w3.org/2001/XMLSchema#int">2</aaif:position><aaif:coordinated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:coordinated><aaif:morphosyntacticStructure rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Adjective" /><aaif:inflection rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Uninflected" /><aaif:attributionTarget rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Verb" /><aaif:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:modified><aaif:semanticClassification rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Manner" /><aaif:reduplicated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:reduplicated><aaif:prepositionalPhrase rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:prepositionalPhrase></aaif:Adverb><aaif:Entry rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En1476"><aaif:phrase rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh#En1476Ph1" /><aaif:source rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh.bibl#Cnde495" /><gams:textualContent> Gil  aspiró fuerte , y sacando fuerza y solemnidad de un tono que amenazaba con quebrarse en sollozos, dijo:</gams:textualContent><rel:isPartOf rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh" /></aaif:Entry><aaif:Phrase rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En1476Ph1"><aaif:subject rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh#En1476Ph1Su1" /><aaif:verb rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh#En1476Ph1Ve1" /><aaif:adverb rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh#En1476Ph1Ad1" /><aaif:text> Gil  aspiró fuerte , y sacando fuerza y solemnidad</aaif:text><aaif:annoText> [s|Gil|ms]  [v|aspiró|aspirar|is] [a|fuerte|fuerte|auvnmnnn] , y sacando fuerza y solemnidad</aaif:annoText></aaif:Phrase><aaif:Subject rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En1476Ph1Su1"><aaif:text>Gil</aaif:text><aaif:position rdf:datatype="http://www.w3.org/2001/XMLSchema#int">1</aaif:position><aaif:gender rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Masculine" /><aaif:number rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Singular" /><aaif:overt rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</aaif:overt></aaif:Subject><aaif:Verb rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En1476Ph1Ve1"><aaif:text>aspiró</aaif:text><aaif:lemma rdf:resource="https://gams.uni-graz.at/o:aaif.lemma#aspirar" /><aaif:position rdf:datatype="http://www.w3.org/2001/XMLSchema#int">2</aaif:position><aaif:coordinated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:coordinated><aaif:partOfText rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</aaif:partOfText><aaif:syntacticConstruction rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Intransitive" /></aaif:Verb><aaif:Adverb rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En1476Ph1Ad1"><aaif:text>fuerte</aaif:text><aaif:lemma rdf:resource="https://gams.uni-graz.at/o:aaif.lemma#fuerte" /><aaif:position rdf:datatype="http://www.w3.org/2001/XMLSchema#int">3</aaif:position><aaif:coordinated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:coordinated><aaif:morphosyntacticStructure rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Adjective" /><aaif:inflection rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Uninflected" /><aaif:attributionTarget rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Verb" /><aaif:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:modified><aaif:semanticClassification rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Manner" /><aaif:reduplicated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:reduplicated><aaif:prepositionalPhrase rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:prepositionalPhrase></aaif:Adverb><aaif:Entry rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En1477"><aaif:phrase rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh#En1477Ph1" /><aaif:source rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh.bibl#Cnde74" /><gams:textualContent>sentir la presencia del peligro o tratar de reponerse de la derrota.«A mala suerte, envidar fuerte .»</gams:textualContent><rel:isPartOf rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh" /></aaif:Entry><aaif:Phrase rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En1477Ph1"><aaif:verb rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh#En1477Ph1Ve1" /><aaif:adverb rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh#En1477Ph1Ad1" /><aaif:text>A mala suerte, envidar fuerte </aaif:text><aaif:annoText>A mala suerte, [v|envidar|envidiar|ts] [a|fuerte|fuerte|auvnmnnn] </aaif:annoText></aaif:Phrase><aaif:Verb rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En1477Ph1Ve1"><aaif:text>envidar</aaif:text><aaif:lemma rdf:resource="https://gams.uni-graz.at/o:aaif.lemma#envidiar" /><aaif:position rdf:datatype="http://www.w3.org/2001/XMLSchema#int">1</aaif:position><aaif:coordinated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:coordinated><aaif:partOfText rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</aaif:partOfText><aaif:syntacticConstruction rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Transitive" /></aaif:Verb><aaif:Adverb rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En1477Ph1Ad1"><aaif:text>fuerte</aaif:text><aaif:lemma rdf:resource="https://gams.uni-graz.at/o:aaif.lemma#fuerte" /><aaif:position rdf:datatype="http://www.w3.org/2001/XMLSchema#int">2</aaif:position><aaif:coordinated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:coordinated><aaif:morphosyntacticStructure rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Adjective" /><aaif:inflection rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Uninflected" /><aaif:attributionTarget rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Verb" /><aaif:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:modified><aaif:semanticClassification rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Manner" /><aaif:reduplicated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:reduplicated><aaif:prepositionalPhrase rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:prepositionalPhrase></aaif:Adverb><aaif:Entry rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En1478"><aaif:phrase rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh#En1478Ph1" /><aaif:source rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh.bibl#Cnde133" /><gams:textualContent> El sol mañanero  picaba fuerte  y Héctor pidió a José Independiente Mondragón que le consiguiera un sombrero.El adolescente llegó poco después con un sombrero de</gams:textualContent><rel:isPartOf rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh" /></aaif:Entry><aaif:Phrase rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En1478Ph1"><aaif:subject rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh#En1478Ph1Su1" /><aaif:verb rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh#En1478Ph1Ve1" /><aaif:adverb rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh#En1478Ph1Ad1" /><aaif:text> El sol mañanero  picaba fuerte </aaif:text><aaif:annoText> [s|El sol mañanero|ms]  [v|picaba|picar|is] [a|fuerte|fuerte|auvnmnnn] </aaif:annoText></aaif:Phrase><aaif:Subject rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En1478Ph1Su1"><aaif:text>El sol mañanero</aaif:text><aaif:position rdf:datatype="http://www.w3.org/2001/XMLSchema#int">1</aaif:position><aaif:gender rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Masculine" /><aaif:number rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Singular" /><aaif:overt rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</aaif:overt></aaif:Subject><aaif:Verb rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En1478Ph1Ve1"><aaif:text>picaba</aaif:text><aaif:lemma rdf:resource="https://gams.uni-graz.at/o:aaif.lemma#picar" /><aaif:position rdf:datatype="http://www.w3.org/2001/XMLSchema#int">2</aaif:position><aaif:coordinated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:coordinated><aaif:partOfText rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</aaif:partOfText><aaif:syntacticConstruction rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Intransitive" /></aaif:Verb><aaif:Adverb rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En1478Ph1Ad1"><aaif:text>fuerte</aaif:text><aaif:lemma rdf:resource="https://gams.uni-graz.at/o:aaif.lemma#fuerte" /><aaif:position rdf:datatype="http://www.w3.org/2001/XMLSchema#int">3</aaif:position><aaif:coordinated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:coordinated><aaif:morphosyntacticStructure rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Adjective" /><aaif:inflection rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Uninflected" /><aaif:attributionTarget rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Verb" /><aaif:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:modified><aaif:semanticClassification rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Manner" /><aaif:reduplicated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:reduplicated><aaif:prepositionalPhrase rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:prepositionalPhrase></aaif:Adverb><aaif:Entry rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En1479"><aaif:phrase rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh#En1479Ph1" /><aaif:source rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh.bibl#Cnde189" /><gams:textualContent>ser adorable en toda su poética perversión y su genio.No quería que se me fuera, lo retuve fuerte  y después lo largué.No podía reclamarlo, ya; tenía que ayudarlo a irse.Para eso me</gams:textualContent><rel:isPartOf rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh" /></aaif:Entry><aaif:Phrase rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En1479Ph1"><aaif:verb rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh#En1479Ph1Ve1" /><aaif:adverb rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh#En1479Ph1Ad1" /><aaif:text>No quería que se me fuera, lo retuve fuerte </aaif:text><aaif:annoText>No quería que se me fuera, lo [v|retuve|retener|ts] [a|fuerte|fuerte|auvnmnnn] </aaif:annoText></aaif:Phrase><aaif:Verb rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En1479Ph1Ve1"><aaif:text>retuve</aaif:text><aaif:lemma rdf:resource="https://gams.uni-graz.at/o:aaif.lemma#retener" /><aaif:position rdf:datatype="http://www.w3.org/2001/XMLSchema#int">1</aaif:position><aaif:coordinated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:coordinated><aaif:partOfText rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</aaif:partOfText><aaif:syntacticConstruction rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Transitive" /></aaif:Verb><aaif:Adverb rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En1479Ph1Ad1"><aaif:text>fuerte</aaif:text><aaif:lemma rdf:resource="https://gams.uni-graz.at/o:aaif.lemma#fuerte" /><aaif:position rdf:datatype="http://www.w3.org/2001/XMLSchema#int">2</aaif:position><aaif:coordinated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:coordinated><aaif:morphosyntacticStructure rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Adjective" /><aaif:inflection rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Uninflected" /><aaif:attributionTarget rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Verb" /><aaif:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:modified><aaif:semanticClassification rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Manner" /><aaif:reduplicated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:reduplicated><aaif:prepositionalPhrase rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:prepositionalPhrase></aaif:Adverb><aaif:Entry rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En1480"><aaif:phrase rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh#En1480Ph1" /><aaif:source rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh.bibl#Cnde232" /><gams:textualContent>sombras petrificadas sus siluetas.El vuelo de las aves no hace más que erizar la rebelión a contrapelo. Alguien  ríe fuerte y barbota: ¡Sí...pájaros que vuelan arreculados por la tormenta!¡y nosotros, peor que</gams:textualContent><rel:isPartOf rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh" /></aaif:Entry><aaif:Phrase rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En1480Ph1"><aaif:subject rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh#En1480Ph1Su1" /><aaif:verb rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh#En1480Ph1Ve1" /><aaif:adverb rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh#En1480Ph1Ad1" /><aaif:text> Alguien  ríe fuerte y barbota</aaif:text><aaif:annoText> [s|Alguien|ms]  [v|ríe|reír|is] [a|fuerte|fuerte|auvnmnnn] y barbota</aaif:annoText></aaif:Phrase><aaif:Subject rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En1480Ph1Su1"><aaif:text>Alguien</aaif:text><aaif:position rdf:datatype="http://www.w3.org/2001/XMLSchema#int">1</aaif:position><aaif:gender rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Masculine" /><aaif:number rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Singular" /><aaif:overt rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</aaif:overt></aaif:Subject><aaif:Verb rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En1480Ph1Ve1"><aaif:text>ríe</aaif:text><aaif:lemma rdf:resource="https://gams.uni-graz.at/o:aaif.lemma#reír" /><aaif:position rdf:datatype="http://www.w3.org/2001/XMLSchema#int">2</aaif:position><aaif:coordinated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:coordinated><aaif:partOfText rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</aaif:partOfText><aaif:syntacticConstruction rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Intransitive" /></aaif:Verb><aaif:Adverb rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En1480Ph1Ad1"><aaif:text>fuerte</aaif:text><aaif:lemma rdf:resource="https://gams.uni-graz.at/o:aaif.lemma#fuerte" /><aaif:position rdf:datatype="http://www.w3.org/2001/XMLSchema#int">3</aaif:position><aaif:coordinated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:coordinated><aaif:morphosyntacticStructure rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Adjective" /><aaif:inflection rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Uninflected" /><aaif:attributionTarget rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Verb" /><aaif:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:modified><aaif:semanticClassification rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Manner" /><aaif:reduplicated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:reduplicated><aaif:prepositionalPhrase rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:prepositionalPhrase></aaif:Adverb><aaif:Entry rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En1481"><aaif:phrase rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh#En1481Ph1" /><aaif:source rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh.bibl#Cnde232" /><gams:textualContent>¡Oigan sus oídos lo que su boca dice y no trabaje desde ahora para su perdición!— resopló  fuerte  el seminarista .</gams:textualContent><rel:isPartOf rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh" /></aaif:Entry><aaif:Phrase rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En1481Ph1"><aaif:subject rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh#En1481Ph1Su1" /><aaif:verb rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh#En1481Ph1Ve1" /><aaif:adverb rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh#En1481Ph1Ad1" /><aaif:text> resopló  fuerte  el seminarista </aaif:text><aaif:annoText> [v|resopló|resoplar|ts]  [a|fuerte|fuerte|auvnmnnn]  [s|el seminarista|ms] </aaif:annoText></aaif:Phrase><aaif:Subject rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En1481Ph1Su1"><aaif:text>el seminarista</aaif:text><aaif:position rdf:datatype="http://www.w3.org/2001/XMLSchema#int">3</aaif:position><aaif:gender rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Masculine" /><aaif:number rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Singular" /><aaif:overt rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</aaif:overt></aaif:Subject><aaif:Verb rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En1481Ph1Ve1"><aaif:text>resopló</aaif:text><aaif:lemma rdf:resource="https://gams.uni-graz.at/o:aaif.lemma#resoplar" /><aaif:position rdf:datatype="http://www.w3.org/2001/XMLSchema#int">1</aaif:position><aaif:coordinated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:coordinated><aaif:partOfText rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</aaif:partOfText><aaif:syntacticConstruction rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Transitive" /></aaif:Verb><aaif:Adverb rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En1481Ph1Ad1"><aaif:text>fuerte</aaif:text><aaif:lemma rdf:resource="https://gams.uni-graz.at/o:aaif.lemma#fuerte" /><aaif:position rdf:datatype="http://www.w3.org/2001/XMLSchema#int">2</aaif:position><aaif:coordinated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:coordinated><aaif:morphosyntacticStructure rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Adjective" /><aaif:inflection rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Uninflected" /><aaif:attributionTarget rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Verb" /><aaif:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:modified><aaif:semanticClassification rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Manner" /><aaif:reduplicated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:reduplicated><aaif:prepositionalPhrase rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:prepositionalPhrase></aaif:Adverb><aaif:Entry rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En1482"><aaif:phrase rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh#En1482Ph1" /><aaif:source rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh.bibl#Cnde232" /><gams:textualContent>acerqué a mirar su ojo único de cíclope que reverberaba como fósforo en la penumbra.De súbito el cemí gritó fuerte y habló en su lengua con voz atronadora que parecía sonar bajo tierra o que venía hacia mí desde muy</gams:textualContent><rel:isPartOf rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh" /></aaif:Entry><aaif:Phrase rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En1482Ph1"><aaif:subject rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh#En1482Ph1Su1" /><aaif:verb rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh#En1482Ph1Ve1" /><aaif:adverb rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh#En1482Ph1Ad1" /><aaif:text>De súbito el cemí gritó fuerte y habló en su lengua</aaif:text><aaif:annoText>De súbito [s|el cemí|ms] [v|gritó|gritar|is] [a|fuerte|fuerte|auvnmnnn] y habló en su lengua</aaif:annoText></aaif:Phrase><aaif:Subject rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En1482Ph1Su1"><aaif:text>el cemí</aaif:text><aaif:position rdf:datatype="http://www.w3.org/2001/XMLSchema#int">1</aaif:position><aaif:gender rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Masculine" /><aaif:number rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Singular" /><aaif:overt rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</aaif:overt></aaif:Subject><aaif:Verb rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En1482Ph1Ve1"><aaif:text>gritó</aaif:text><aaif:lemma rdf:resource="https://gams.uni-graz.at/o:aaif.lemma#gritar" /><aaif:position rdf:datatype="http://www.w3.org/2001/XMLSchema#int">2</aaif:position><aaif:coordinated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:coordinated><aaif:partOfText rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</aaif:partOfText><aaif:syntacticConstruction rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Intransitive" /></aaif:Verb><aaif:Adverb rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En1482Ph1Ad1"><aaif:text>fuerte</aaif:text><aaif:lemma rdf:resource="https://gams.uni-graz.at/o:aaif.lemma#fuerte" /><aaif:position rdf:datatype="http://www.w3.org/2001/XMLSchema#int">3</aaif:position><aaif:coordinated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:coordinated><aaif:morphosyntacticStructure rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Adjective" /><aaif:inflection rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Uninflected" /><aaif:attributionTarget rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Verb" /><aaif:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:modified><aaif:semanticClassification rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Manner" /><aaif:reduplicated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:reduplicated><aaif:prepositionalPhrase rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:prepositionalPhrase></aaif:Adverb><aaif:Entry rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En1483"><aaif:phrase rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh#En1483Ph1" /><aaif:source rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh.bibl#Cnde233" /><gams:textualContent>que interesa a estos ingenuos entusiastas.La gente vive como riqueza propia este oro de la Corona. Hablan  fuerte , ríen.Ven en el oro su seguridad, el futuro de sus hijos.Es tiempo de pura</gams:textualContent><rel:isPartOf rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh" /></aaif:Entry><aaif:Phrase rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En1483Ph1"><aaif:verb rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh#En1483Ph1Ve1" /><aaif:adverb rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh#En1483Ph1Ad1" /><aaif:text> Hablan  fuerte , ríen</aaif:text><aaif:annoText> [v|Hablan|hablar|is]  [a|fuerte|fuerte|auvnmnnn] , ríen</aaif:annoText></aaif:Phrase><aaif:Verb rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En1483Ph1Ve1"><aaif:text>Hablan</aaif:text><aaif:lemma rdf:resource="https://gams.uni-graz.at/o:aaif.lemma#hablar" /><aaif:position rdf:datatype="http://www.w3.org/2001/XMLSchema#int">1</aaif:position><aaif:coordinated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:coordinated><aaif:partOfText rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</aaif:partOfText><aaif:syntacticConstruction rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Intransitive" /></aaif:Verb><aaif:Adverb rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En1483Ph1Ad1"><aaif:text>fuerte</aaif:text><aaif:lemma rdf:resource="https://gams.uni-graz.at/o:aaif.lemma#fuerte" /><aaif:position rdf:datatype="http://www.w3.org/2001/XMLSchema#int">2</aaif:position><aaif:coordinated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:coordinated><aaif:morphosyntacticStructure rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Adjective" /><aaif:inflection rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Uninflected" /><aaif:attributionTarget rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Verb" /><aaif:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:modified><aaif:semanticClassification rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Manner" /><aaif:reduplicated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:reduplicated><aaif:prepositionalPhrase rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:prepositionalPhrase></aaif:Adverb><aaif:Entry rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En1484"><aaif:phrase rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh#En1484Ph1" /><aaif:source rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh.bibl#Cnde233" /><gams:textualContent>como coturnos.Coturnos de esos de madera, que hacen caminar como muñecos a los actores y que retumban fuerte sobre el tablado de la escena.O son como zancos, también.Y uno se mueve oscilando en</gams:textualContent><rel:isPartOf rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh" /></aaif:Entry><aaif:Phrase rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En1484Ph1"><aaif:verb rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh#En1484Ph1Ve1" /><aaif:adverb rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh#En1484Ph1Ad1" /><aaif:text>Coturnos de esos de madera, que hacen caminar como muñecos a los actores y que retumban fuerte sobre el tablado</aaif:text><aaif:annoText>Coturnos de esos de madera, que hacen caminar como muñecos a los actores y que [v|retumban|retumbar|is] [a|fuerte|fuerte|auvnmnnn] sobre el tablado</aaif:annoText></aaif:Phrase><aaif:Verb rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En1484Ph1Ve1"><aaif:text>retumban</aaif:text><aaif:lemma rdf:resource="https://gams.uni-graz.at/o:aaif.lemma#retumbar" /><aaif:position rdf:datatype="http://www.w3.org/2001/XMLSchema#int">1</aaif:position><aaif:coordinated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:coordinated><aaif:partOfText rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</aaif:partOfText><aaif:syntacticConstruction rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Intransitive" /></aaif:Verb><aaif:Adverb rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En1484Ph1Ad1"><aaif:text>fuerte</aaif:text><aaif:lemma rdf:resource="https://gams.uni-graz.at/o:aaif.lemma#fuerte" /><aaif:position rdf:datatype="http://www.w3.org/2001/XMLSchema#int">2</aaif:position><aaif:coordinated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:coordinated><aaif:morphosyntacticStructure rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Adjective" /><aaif:inflection rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Uninflected" /><aaif:attributionTarget rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Verb" /><aaif:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:modified><aaif:semanticClassification rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Manner" /><aaif:reduplicated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:reduplicated><aaif:prepositionalPhrase rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:prepositionalPhrase></aaif:Adverb><aaif:Entry rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En1485"><aaif:phrase rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh#En1485Ph1" /><aaif:source rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh.bibl#Cnde76" /><gams:textualContent>Hablaba sin parar, odiándose por sentirse tan nerviosa. Felipe la acomodó seguro en su pecho ancho, apretándola fuerte .Podía sentir el vello negro y abundante a través de la camisa.Empezaron a mecerse.Confundidas las pieles.</gams:textualContent><rel:isPartOf rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh" /></aaif:Entry><aaif:Phrase rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En1485Ph1"><aaif:subject rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh#En1485Ph1Su1" /><aaif:verb rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh#En1485Ph1Ve1" /><aaif:adverb rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh#En1485Ph1Ad1" /><aaif:text> Felipe la acomodó seguro en su pecho ancho, apretándola fuerte </aaif:text><aaif:annoText> [s|Felipe|ms] la acomodó seguro en su pecho ancho, [v|apretándola|apretar|ts] [a|fuerte|fuerte|auvnmnnn] </aaif:annoText></aaif:Phrase><aaif:Subject rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En1485Ph1Su1"><aaif:text>Felipe</aaif:text><aaif:position rdf:datatype="http://www.w3.org/2001/XMLSchema#int">1</aaif:position><aaif:gender rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Masculine" /><aaif:number rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Singular" /><aaif:overt rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</aaif:overt></aaif:Subject><aaif:Verb rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En1485Ph1Ve1"><aaif:text>apretándola</aaif:text><aaif:lemma rdf:resource="https://gams.uni-graz.at/o:aaif.lemma#apretar" /><aaif:position rdf:datatype="http://www.w3.org/2001/XMLSchema#int">2</aaif:position><aaif:coordinated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:coordinated><aaif:partOfText rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</aaif:partOfText><aaif:syntacticConstruction rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Transitive" /></aaif:Verb><aaif:Adverb rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En1485Ph1Ad1"><aaif:text>fuerte</aaif:text><aaif:lemma rdf:resource="https://gams.uni-graz.at/o:aaif.lemma#fuerte" /><aaif:position rdf:datatype="http://www.w3.org/2001/XMLSchema#int">3</aaif:position><aaif:coordinated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:coordinated><aaif:morphosyntacticStructure rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Adjective" /><aaif:inflection rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Uninflected" /><aaif:attributionTarget rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Verb" /><aaif:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:modified><aaif:semanticClassification rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Manner" /><aaif:reduplicated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:reduplicated><aaif:prepositionalPhrase rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:prepositionalPhrase></aaif:Adverb><aaif:Entry rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En1486"><aaif:phrase rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh#En1486Ph1" /><aaif:source rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh.bibl#Cnde76" /><gams:textualContent>.Lo dijo por la necesidad de decirlo, de sacárselo de encima. Felipe manipulaba el torniquete, sujetándolo fuerte .La tela blanca se tornaba rojo; un rojo temible, vivo.</gams:textualContent><rel:isPartOf rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh" /></aaif:Entry><aaif:Phrase rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En1486Ph1"><aaif:subject rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh#En1486Ph1Su1" /><aaif:verb rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh#En1486Ph1Ve1" /><aaif:adverb rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh#En1486Ph1Ad1" /><aaif:text> Felipe manipulaba el torniquete, sujetándolo fuerte </aaif:text><aaif:annoText> [s|Felipe|ms] manipulaba el torniquete, [v|sujetándolo|sujetar|ts] [a|fuerte|fuerte|auvnmnnn] </aaif:annoText></aaif:Phrase><aaif:Subject rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En1486Ph1Su1"><aaif:text>Felipe</aaif:text><aaif:position rdf:datatype="http://www.w3.org/2001/XMLSchema#int">1</aaif:position><aaif:gender rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Masculine" /><aaif:number rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Singular" /><aaif:overt rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</aaif:overt></aaif:Subject><aaif:Verb rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En1486Ph1Ve1"><aaif:text>sujetándolo</aaif:text><aaif:lemma rdf:resource="https://gams.uni-graz.at/o:aaif.lemma#sujetar" /><aaif:position rdf:datatype="http://www.w3.org/2001/XMLSchema#int">2</aaif:position><aaif:coordinated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:coordinated><aaif:partOfText rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</aaif:partOfText><aaif:syntacticConstruction rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Transitive" /></aaif:Verb><aaif:Adverb rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En1486Ph1Ad1"><aaif:text>fuerte</aaif:text><aaif:lemma rdf:resource="https://gams.uni-graz.at/o:aaif.lemma#fuerte" /><aaif:position rdf:datatype="http://www.w3.org/2001/XMLSchema#int">3</aaif:position><aaif:coordinated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:coordinated><aaif:morphosyntacticStructure rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Adjective" /><aaif:inflection rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Uninflected" /><aaif:attributionTarget rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Verb" /><aaif:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:modified><aaif:semanticClassification rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Manner" /><aaif:reduplicated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:reduplicated><aaif:prepositionalPhrase rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:prepositionalPhrase></aaif:Adverb><aaif:Entry rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En1487"><aaif:phrase rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh#En1487Ph1" /><aaif:source rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh.bibl#Cnde76" /><gams:textualContent> Lavinia lo abrazó fuerte .Le daba pena verlo preocupado, observándola, temiendo que ella le dijera que no quería volver a verlo</gams:textualContent><rel:isPartOf rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh" /></aaif:Entry><aaif:Phrase rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En1487Ph1"><aaif:subject rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh#En1487Ph1Su1" /><aaif:verb rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh#En1487Ph1Ve1" /><aaif:adverb rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh#En1487Ph1Ad1" /><aaif:text> Lavinia lo abrazó fuerte </aaif:text><aaif:annoText> [s|Lavinia|fs] lo [v|abrazó|abrazar|ts] [a|fuerte|fuerte|auvnmnnn] </aaif:annoText></aaif:Phrase><aaif:Subject rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En1487Ph1Su1"><aaif:text>Lavinia</aaif:text><aaif:position rdf:datatype="http://www.w3.org/2001/XMLSchema#int">1</aaif:position><aaif:gender rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Feminine" /><aaif:number rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Singular" /><aaif:overt rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</aaif:overt></aaif:Subject><aaif:Verb rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En1487Ph1Ve1"><aaif:text>abrazó</aaif:text><aaif:lemma rdf:resource="https://gams.uni-graz.at/o:aaif.lemma#abrazar" /><aaif:position rdf:datatype="http://www.w3.org/2001/XMLSchema#int">2</aaif:position><aaif:coordinated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:coordinated><aaif:partOfText rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</aaif:partOfText><aaif:syntacticConstruction rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Transitive" /></aaif:Verb><aaif:Adverb rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En1487Ph1Ad1"><aaif:text>fuerte</aaif:text><aaif:lemma rdf:resource="https://gams.uni-graz.at/o:aaif.lemma#fuerte" /><aaif:position rdf:datatype="http://www.w3.org/2001/XMLSchema#int">3</aaif:position><aaif:coordinated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:coordinated><aaif:morphosyntacticStructure rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Adjective" /><aaif:inflection rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Uninflected" /><aaif:attributionTarget rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Verb" /><aaif:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:modified><aaif:semanticClassification rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Manner" /><aaif:reduplicated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:reduplicated><aaif:prepositionalPhrase rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:prepositionalPhrase></aaif:Adverb><aaif:Entry rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En1488"><aaif:phrase rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh#En1488Ph1" /><aaif:source rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh.bibl#Cnde76" /><gams:textualContent>El silencio retornó, denso.Afuera, el viento empezaba a soplar fuerte , moviendo las ramas del naranjo cuya sombra recorría la ventana, agitando dibujos negros en las paredes.</gams:textualContent><rel:isPartOf rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh" /></aaif:Entry><aaif:Phrase rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En1488Ph1"><aaif:subject rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh#En1488Ph1Su1" /><aaif:verb rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh#En1488Ph1Ve1" /><aaif:adverb rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh#En1488Ph1Ad1" /><aaif:text>Afuera, el viento empezaba a soplar fuerte </aaif:text><aaif:annoText>Afuera, [s|el viento|ms] empezaba a [v|soplar|soplar|is] [a|fuerte|fuerte|auvnmnnn] </aaif:annoText></aaif:Phrase><aaif:Subject rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En1488Ph1Su1"><aaif:text>el viento</aaif:text><aaif:position rdf:datatype="http://www.w3.org/2001/XMLSchema#int">1</aaif:position><aaif:gender rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Masculine" /><aaif:number rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Singular" /><aaif:overt rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</aaif:overt></aaif:Subject><aaif:Verb rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En1488Ph1Ve1"><aaif:text>soplar</aaif:text><aaif:lemma rdf:resource="https://gams.uni-graz.at/o:aaif.lemma#soplar" /><aaif:position rdf:datatype="http://www.w3.org/2001/XMLSchema#int">2</aaif:position><aaif:coordinated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:coordinated><aaif:partOfText rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</aaif:partOfText><aaif:syntacticConstruction rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Intransitive" /></aaif:Verb><aaif:Adverb rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En1488Ph1Ad1"><aaif:text>fuerte</aaif:text><aaif:lemma rdf:resource="https://gams.uni-graz.at/o:aaif.lemma#fuerte" /><aaif:position rdf:datatype="http://www.w3.org/2001/XMLSchema#int">3</aaif:position><aaif:coordinated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:coordinated><aaif:morphosyntacticStructure rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Adjective" /><aaif:inflection rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Uninflected" /><aaif:attributionTarget rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Verb" /><aaif:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:modified><aaif:semanticClassification rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Manner" /><aaif:reduplicated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:reduplicated><aaif:prepositionalPhrase rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:prepositionalPhrase></aaif:Adverb><aaif:Entry rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En1489"><aaif:phrase rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh#En1489Ph1" /><aaif:source rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh.bibl#Cnde76" /><gams:textualContent>sabía que no habría respuesta.Con sus dos manos, se apoyó sobre el pecho de Felipe, presionó fuerte , para arriba y para abajo, como más de una vez vio hacer a los camilleros en demostraciones de</gams:textualContent><rel:isPartOf rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh" /></aaif:Entry><aaif:Phrase rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En1489Ph1"><aaif:verb rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh#En1489Ph1Ve1" /><aaif:adverb rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh#En1489Ph1Ad1" /><aaif:text>se apoyó sobre el pecho de Felipe, presionó fuerte </aaif:text><aaif:annoText>se apoyó sobre el pecho de Felipe, [v|presionó|presionar|is] [a|fuerte|fuerte|auvnmnnn] </aaif:annoText></aaif:Phrase><aaif:Verb rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En1489Ph1Ve1"><aaif:text>presionó</aaif:text><aaif:lemma rdf:resource="https://gams.uni-graz.at/o:aaif.lemma#presionar" /><aaif:position rdf:datatype="http://www.w3.org/2001/XMLSchema#int">1</aaif:position><aaif:coordinated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:coordinated><aaif:partOfText rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</aaif:partOfText><aaif:syntacticConstruction rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Intransitive" /></aaif:Verb><aaif:Adverb rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En1489Ph1Ad1"><aaif:text>fuerte</aaif:text><aaif:lemma rdf:resource="https://gams.uni-graz.at/o:aaif.lemma#fuerte" /><aaif:position rdf:datatype="http://www.w3.org/2001/XMLSchema#int">2</aaif:position><aaif:coordinated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:coordinated><aaif:morphosyntacticStructure rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Adjective" /><aaif:inflection rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Uninflected" /><aaif:attributionTarget rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Verb" /><aaif:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:modified><aaif:semanticClassification rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Manner" /><aaif:reduplicated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:reduplicated><aaif:prepositionalPhrase rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:prepositionalPhrase></aaif:Adverb><aaif:Entry rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En1490"><aaif:phrase rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh#En1490Ph1" /><aaif:source rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh.bibl#Cnde234" /><gams:textualContent> El corazón de María Roberta  batió fuerte  y se ruborizó de placer con las palabras de Raúl.Se dejó besar en la mejilla, pero no</gams:textualContent><rel:isPartOf rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh" /></aaif:Entry><aaif:Phrase rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En1490Ph1"><aaif:subject rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh#En1490Ph1Su1" /><aaif:verb rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh#En1490Ph1Ve1" /><aaif:adverb rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh#En1490Ph1Ad1" /><aaif:text> El corazón de María Roberta  batió fuerte </aaif:text><aaif:annoText> [s|El corazón de María Roberta|ms]  [v|batió|batir|is] [a|fuerte|fuerte|auvnmnnn] </aaif:annoText></aaif:Phrase><aaif:Subject rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En1490Ph1Su1"><aaif:text>El corazón de María Roberta</aaif:text><aaif:position rdf:datatype="http://www.w3.org/2001/XMLSchema#int">1</aaif:position><aaif:gender rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Masculine" /><aaif:number rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Singular" /><aaif:overt rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</aaif:overt></aaif:Subject><aaif:Verb rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En1490Ph1Ve1"><aaif:text>batió</aaif:text><aaif:lemma rdf:resource="https://gams.uni-graz.at/o:aaif.lemma#batir" /><aaif:position rdf:datatype="http://www.w3.org/2001/XMLSchema#int">2</aaif:position><aaif:coordinated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:coordinated><aaif:partOfText rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</aaif:partOfText><aaif:syntacticConstruction rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Intransitive" /></aaif:Verb><aaif:Adverb rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En1490Ph1Ad1"><aaif:text>fuerte</aaif:text><aaif:lemma rdf:resource="https://gams.uni-graz.at/o:aaif.lemma#fuerte" /><aaif:position rdf:datatype="http://www.w3.org/2001/XMLSchema#int">3</aaif:position><aaif:coordinated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:coordinated><aaif:morphosyntacticStructure rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Adjective" /><aaif:inflection rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Uninflected" /><aaif:attributionTarget rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Verb" /><aaif:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:modified><aaif:semanticClassification rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Manner" /><aaif:reduplicated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:reduplicated><aaif:prepositionalPhrase rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:prepositionalPhrase></aaif:Adverb><aaif:Entry rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En1491"><aaif:phrase rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh#En1491Ph1" /><aaif:source rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh.bibl#Cnde78" /><gams:textualContent>el alcance de lo que Marcelo Chiriboga acababa de obtener, y cuál era su ruego. La Ruby también tragó fuerte .Su gran caja torácica quedó resonando un buen rato con el eco de las efusiones censuradas.</gams:textualContent><rel:isPartOf rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh" /></aaif:Entry><aaif:Phrase rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En1491Ph1"><aaif:subject rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh#En1491Ph1Su1" /><aaif:verb rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh#En1491Ph1Ve1" /><aaif:adverb rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh#En1491Ph1Ad1" /><aaif:text> La Ruby también tragó fuerte </aaif:text><aaif:annoText> [s|La Ruby|fs] también [v|tragó|tragar|is] [a|fuerte|fuerte|auvnmnnn] </aaif:annoText></aaif:Phrase><aaif:Subject rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En1491Ph1Su1"><aaif:text>La Ruby</aaif:text><aaif:position rdf:datatype="http://www.w3.org/2001/XMLSchema#int">1</aaif:position><aaif:gender rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Feminine" /><aaif:number rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Singular" /><aaif:overt rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</aaif:overt></aaif:Subject><aaif:Verb rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En1491Ph1Ve1"><aaif:text>tragó</aaif:text><aaif:lemma rdf:resource="https://gams.uni-graz.at/o:aaif.lemma#tragar" /><aaif:position rdf:datatype="http://www.w3.org/2001/XMLSchema#int">2</aaif:position><aaif:coordinated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:coordinated><aaif:partOfText rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</aaif:partOfText><aaif:syntacticConstruction rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Intransitive" /></aaif:Verb><aaif:Adverb rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En1491Ph1Ad1"><aaif:text>fuerte</aaif:text><aaif:lemma rdf:resource="https://gams.uni-graz.at/o:aaif.lemma#fuerte" /><aaif:position rdf:datatype="http://www.w3.org/2001/XMLSchema#int">3</aaif:position><aaif:coordinated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:coordinated><aaif:morphosyntacticStructure rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Adjective" /><aaif:inflection rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Uninflected" /><aaif:attributionTarget rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Verb" /><aaif:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:modified><aaif:semanticClassification rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Manner" /><aaif:reduplicated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:reduplicated><aaif:prepositionalPhrase rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:prepositionalPhrase></aaif:Adverb><aaif:Entry rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En1492"><aaif:phrase rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh#En1492Ph1" /><aaif:source rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh.bibl#Cnde134" /><gams:textualContent>sonido de unos golpes, pensé en decirle a mi padre que aconsejara a aquel marido que no le diera fuerte a su mujer, puesto que se podía morir.Pero mi padre soltó otra maldición y ya no pude decir</gams:textualContent><rel:isPartOf rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh" /></aaif:Entry><aaif:Phrase rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En1492Ph1"><aaif:verb rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh#En1492Ph1Ve1" /><aaif:adverb rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh#En1492Ph1Ad1" /><aaif:text>que aconsejara a aquel marido que no le diera fuerte a su mujer</aaif:text><aaif:annoText>que aconsejara a aquel marido que no le [v|diera|dar|is] [a|fuerte|fuerte|auvnmnnn] a su mujer</aaif:annoText></aaif:Phrase><aaif:Verb rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En1492Ph1Ve1"><aaif:text>diera</aaif:text><aaif:lemma rdf:resource="https://gams.uni-graz.at/o:aaif.lemma#dar" /><aaif:position rdf:datatype="http://www.w3.org/2001/XMLSchema#int">1</aaif:position><aaif:coordinated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:coordinated><aaif:partOfText rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</aaif:partOfText><aaif:syntacticConstruction rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Intransitive" /></aaif:Verb><aaif:Adverb rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En1492Ph1Ad1"><aaif:text>fuerte</aaif:text><aaif:lemma rdf:resource="https://gams.uni-graz.at/o:aaif.lemma#fuerte" /><aaif:position rdf:datatype="http://www.w3.org/2001/XMLSchema#int">2</aaif:position><aaif:coordinated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:coordinated><aaif:morphosyntacticStructure rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Adjective" /><aaif:inflection rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Uninflected" /><aaif:attributionTarget rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Verb" /><aaif:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:modified><aaif:semanticClassification rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Manner" /><aaif:reduplicated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:reduplicated><aaif:prepositionalPhrase rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:prepositionalPhrase></aaif:Adverb><aaif:Entry rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En1493"><aaif:phrase rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh#En1493Ph1" /><aaif:source rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh.bibl#Cnde134" /><gams:textualContent>Si ve un cangrejo cerca de una casa, llame al dueño, llámelo fuerte , porque ese bicho no anda solo.Los cangrejos se trabajan, se rellenan con el «daño»</gams:textualContent><rel:isPartOf rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh" /></aaif:Entry><aaif:Phrase rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En1493Ph1"><aaif:verb rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh#En1493Ph1Ve1" /><aaif:adverb rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh#En1493Ph1Ad1" /><aaif:text>Si ve un cangrejo cerca de una casa, llame al dueño, llámelo fuerte </aaif:text><aaif:annoText>Si ve un cangrejo cerca de una casa, llame al dueño, [v|llámelo|llamar|ts] [a|fuerte|fuerte|auvnmnnn] </aaif:annoText></aaif:Phrase><aaif:Verb rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En1493Ph1Ve1"><aaif:text>llámelo</aaif:text><aaif:lemma rdf:resource="https://gams.uni-graz.at/o:aaif.lemma#llamar" /><aaif:position rdf:datatype="http://www.w3.org/2001/XMLSchema#int">1</aaif:position><aaif:coordinated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:coordinated><aaif:partOfText rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</aaif:partOfText><aaif:syntacticConstruction rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Transitive" /></aaif:Verb><aaif:Adverb rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En1493Ph1Ad1"><aaif:text>fuerte</aaif:text><aaif:lemma rdf:resource="https://gams.uni-graz.at/o:aaif.lemma#fuerte" /><aaif:position rdf:datatype="http://www.w3.org/2001/XMLSchema#int">2</aaif:position><aaif:coordinated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:coordinated><aaif:morphosyntacticStructure rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Adjective" /><aaif:inflection rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Uninflected" /><aaif:attributionTarget rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Verb" /><aaif:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:modified><aaif:semanticClassification rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Manner" /><aaif:reduplicated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:reduplicated><aaif:prepositionalPhrase rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:prepositionalPhrase></aaif:Adverb><aaif:Entry rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En1494"><aaif:phrase rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh#En1494Ph1" /><aaif:source rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh.bibl#Cnde134" /><gams:textualContent>hijo iba con su tambor y cuando calculaba que la madre estaba lista para salir del fondo, tocaba fuerte , los golpes la ayudaban a encontrar el rumbo.</gams:textualContent><rel:isPartOf rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh" /></aaif:Entry><aaif:Phrase rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En1494Ph1"><aaif:verb rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh#En1494Ph1Ve1" /><aaif:adverb rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh#En1494Ph1Ad1" /><aaif:text>iba con su tambor y cuando calculaba que la madre estaba lista para salir del fondo, tocaba fuerte </aaif:text><aaif:annoText>iba con su tambor y cuando calculaba que la madre estaba lista para salir del fondo, [v|tocaba|tocar|is] [a|fuerte|fuerte|auvnmnnn] </aaif:annoText></aaif:Phrase><aaif:Verb rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En1494Ph1Ve1"><aaif:text>tocaba</aaif:text><aaif:lemma rdf:resource="https://gams.uni-graz.at/o:aaif.lemma#tocar" /><aaif:position rdf:datatype="http://www.w3.org/2001/XMLSchema#int">1</aaif:position><aaif:coordinated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:coordinated><aaif:partOfText rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</aaif:partOfText><aaif:syntacticConstruction rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Intransitive" /></aaif:Verb><aaif:Adverb rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En1494Ph1Ad1"><aaif:text>fuerte</aaif:text><aaif:lemma rdf:resource="https://gams.uni-graz.at/o:aaif.lemma#fuerte" /><aaif:position rdf:datatype="http://www.w3.org/2001/XMLSchema#int">2</aaif:position><aaif:coordinated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:coordinated><aaif:morphosyntacticStructure rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Adjective" /><aaif:inflection rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Uninflected" /><aaif:attributionTarget rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Verb" /><aaif:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:modified><aaif:semanticClassification rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Manner" /><aaif:reduplicated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:reduplicated><aaif:prepositionalPhrase rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:prepositionalPhrase></aaif:Adverb><aaif:Entry rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En1495"><aaif:phrase rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh#En1495Ph1" /><aaif:source rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh.bibl#Cnde134" /><gams:textualContent>, se acostumbró a pellizcarle las nalgas y abrazarla delante de todos, Carmelite luchaba por soltarse y él la apretaba fuerte  y la besaba en la boca.Era como un juego, un juego peligroso porque Paul fue el único</gams:textualContent><rel:isPartOf rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh" /></aaif:Entry><aaif:Phrase rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En1495Ph1"><aaif:subject rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh#En1495Ph1Su1" /><aaif:verb rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh#En1495Ph1Ve1" /><aaif:adverb rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh#En1495Ph1Ad1" /><aaif:text>Carmelite luchaba por soltarse y él la apretaba fuerte </aaif:text><aaif:annoText>Carmelite luchaba por soltarse y [s|él|ms] la [v|apretaba|apretar|ts] [a|fuerte|fuerte|auvnmnnn] </aaif:annoText></aaif:Phrase><aaif:Subject rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En1495Ph1Su1"><aaif:text>él</aaif:text><aaif:position rdf:datatype="http://www.w3.org/2001/XMLSchema#int">1</aaif:position><aaif:gender rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Masculine" /><aaif:number rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Singular" /><aaif:overt rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</aaif:overt></aaif:Subject><aaif:Verb rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En1495Ph1Ve1"><aaif:text>apretaba</aaif:text><aaif:lemma rdf:resource="https://gams.uni-graz.at/o:aaif.lemma#apretar" /><aaif:position rdf:datatype="http://www.w3.org/2001/XMLSchema#int">2</aaif:position><aaif:coordinated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:coordinated><aaif:partOfText rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</aaif:partOfText><aaif:syntacticConstruction rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Transitive" /></aaif:Verb><aaif:Adverb rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En1495Ph1Ad1"><aaif:text>fuerte</aaif:text><aaif:lemma rdf:resource="https://gams.uni-graz.at/o:aaif.lemma#fuerte" /><aaif:position rdf:datatype="http://www.w3.org/2001/XMLSchema#int">3</aaif:position><aaif:coordinated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:coordinated><aaif:morphosyntacticStructure rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Adjective" /><aaif:inflection rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Uninflected" /><aaif:attributionTarget rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Verb" /><aaif:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:modified><aaif:semanticClassification rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Manner" /><aaif:reduplicated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:reduplicated><aaif:prepositionalPhrase rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:prepositionalPhrase></aaif:Adverb><aaif:Entry rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En1496"><aaif:phrase rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh#En1496Ph1" /><aaif:source rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh.bibl#Cnde134" /><gams:textualContent>Tenga cuidado con la rana —fue lo último que le oí decir—,  agarre  fuerte a esa demonia.</gams:textualContent><rel:isPartOf rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh" /></aaif:Entry><aaif:Phrase rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En1496Ph1"><aaif:verb rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh#En1496Ph1Ve1" /><aaif:adverb rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh#En1496Ph1Ad1" /><aaif:text> agarre  fuerte a esa demonia</aaif:text><aaif:annoText> [v|agarre|agarrar|ts]  [a|fuerte|fuerte|auvnmnnn] a esa demonia</aaif:annoText></aaif:Phrase><aaif:Verb rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En1496Ph1Ve1"><aaif:text>agarre</aaif:text><aaif:lemma rdf:resource="https://gams.uni-graz.at/o:aaif.lemma#agarrar" /><aaif:position rdf:datatype="http://www.w3.org/2001/XMLSchema#int">1</aaif:position><aaif:coordinated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:coordinated><aaif:partOfText rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</aaif:partOfText><aaif:syntacticConstruction rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Transitive" /></aaif:Verb><aaif:Adverb rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En1496Ph1Ad1"><aaif:text>fuerte</aaif:text><aaif:lemma rdf:resource="https://gams.uni-graz.at/o:aaif.lemma#fuerte" /><aaif:position rdf:datatype="http://www.w3.org/2001/XMLSchema#int">2</aaif:position><aaif:coordinated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:coordinated><aaif:morphosyntacticStructure rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Adjective" /><aaif:inflection rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Uninflected" /><aaif:attributionTarget rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Verb" /><aaif:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:modified><aaif:semanticClassification rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Manner" /><aaif:reduplicated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:reduplicated><aaif:prepositionalPhrase rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:prepositionalPhrase></aaif:Adverb><aaif:Entry rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En1497"><aaif:phrase rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh#En1497Ph1" /><aaif:source rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh.bibl#Cnde538" /><gams:textualContent>Eran las seis y media de la tarde y  el sol todavía pegaba fuerte  cuando llegué.En la barra me zampé un primer whisky con unos maníes que me acercó don Terada.</gams:textualContent><rel:isPartOf rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh" /></aaif:Entry><aaif:Phrase rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En1497Ph1"><aaif:subject rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh#En1497Ph1Su1" /><aaif:verb rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh#En1497Ph1Ve1" /><aaif:adverb rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh#En1497Ph1Ad1" /><aaif:text> el sol todavía pegaba fuerte </aaif:text><aaif:annoText> [s|el sol|ms] todavía [v|pegaba|pegar|is] [a|fuerte|fuerte|auvnmnnn] </aaif:annoText></aaif:Phrase><aaif:Subject rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En1497Ph1Su1"><aaif:text>el sol</aaif:text><aaif:position rdf:datatype="http://www.w3.org/2001/XMLSchema#int">1</aaif:position><aaif:gender rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Masculine" /><aaif:number rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Singular" /><aaif:overt rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</aaif:overt></aaif:Subject><aaif:Verb rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En1497Ph1Ve1"><aaif:text>pegaba</aaif:text><aaif:lemma rdf:resource="https://gams.uni-graz.at/o:aaif.lemma#pegar" /><aaif:position rdf:datatype="http://www.w3.org/2001/XMLSchema#int">2</aaif:position><aaif:coordinated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:coordinated><aaif:partOfText rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</aaif:partOfText><aaif:syntacticConstruction rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Intransitive" /></aaif:Verb><aaif:Adverb rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En1497Ph1Ad1"><aaif:text>fuerte</aaif:text><aaif:lemma rdf:resource="https://gams.uni-graz.at/o:aaif.lemma#fuerte" /><aaif:position rdf:datatype="http://www.w3.org/2001/XMLSchema#int">3</aaif:position><aaif:coordinated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:coordinated><aaif:morphosyntacticStructure rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Adjective" /><aaif:inflection rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Uninflected" /><aaif:attributionTarget rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Verb" /><aaif:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:modified><aaif:semanticClassification rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Manner" /><aaif:reduplicated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:reduplicated><aaif:prepositionalPhrase rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:prepositionalPhrase></aaif:Adverb><aaif:Entry rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En1498"><aaif:phrase rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh#En1498Ph1" /><aaif:source rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh.bibl#Cnde538" /><gams:textualContent> Abrazame  fuerte , por favor —dice, pide, exige, y se acurruca en el pecho de él.</gams:textualContent><rel:isPartOf rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh" /></aaif:Entry><aaif:Phrase rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En1498Ph1"><aaif:verb rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh#En1498Ph1Ve1" /><aaif:adverb rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh#En1498Ph1Ad1" /><aaif:text> Abrazame  fuerte , por favor</aaif:text><aaif:annoText> [v|Abrazame|abrazar|ts]  [a|fuerte|fuerte|auvnmnnn] , por favor</aaif:annoText></aaif:Phrase><aaif:Verb rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En1498Ph1Ve1"><aaif:text>Abrazame</aaif:text><aaif:lemma rdf:resource="https://gams.uni-graz.at/o:aaif.lemma#abrazar" /><aaif:position rdf:datatype="http://www.w3.org/2001/XMLSchema#int">1</aaif:position><aaif:coordinated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:coordinated><aaif:partOfText rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</aaif:partOfText><aaif:syntacticConstruction rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Transitive" /></aaif:Verb><aaif:Adverb rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En1498Ph1Ad1"><aaif:text>fuerte</aaif:text><aaif:lemma rdf:resource="https://gams.uni-graz.at/o:aaif.lemma#fuerte" /><aaif:position rdf:datatype="http://www.w3.org/2001/XMLSchema#int">2</aaif:position><aaif:coordinated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:coordinated><aaif:morphosyntacticStructure rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Adjective" /><aaif:inflection rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Uninflected" /><aaif:attributionTarget rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Verb" /><aaif:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:modified><aaif:semanticClassification rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Manner" /><aaif:reduplicated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:reduplicated><aaif:prepositionalPhrase rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:prepositionalPhrase></aaif:Adverb><aaif:Entry rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En1499"><aaif:phrase rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh#En1499Ph1" /><aaif:source rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh.bibl#Cnde79" /><gams:textualContent>Patty tocó un timbre.Un hombre bajo, moreno, jorobado, entró a la dirección,. Olía  fuerte , como si no usara desodorante.</gams:textualContent><rel:isPartOf rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh" /></aaif:Entry><aaif:Phrase rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En1499Ph1"><aaif:verb rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh#En1499Ph1Ve1" /><aaif:adverb rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh#En1499Ph1Ad1" /><aaif:text> Olía  fuerte , como si no usara desodorante</aaif:text><aaif:annoText> [v|Olía|oler|is]  [a|fuerte|fuerte|auvnmnnn] , como si no usara desodorante</aaif:annoText></aaif:Phrase><aaif:Verb rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En1499Ph1Ve1"><aaif:text>Olía</aaif:text><aaif:lemma rdf:resource="https://gams.uni-graz.at/o:aaif.lemma#oler" /><aaif:position rdf:datatype="http://www.w3.org/2001/XMLSchema#int">1</aaif:position><aaif:coordinated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:coordinated><aaif:partOfText rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</aaif:partOfText><aaif:syntacticConstruction rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Intransitive" /></aaif:Verb><aaif:Adverb rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En1499Ph1Ad1"><aaif:text>fuerte</aaif:text><aaif:lemma rdf:resource="https://gams.uni-graz.at/o:aaif.lemma#fuerte" /><aaif:position rdf:datatype="http://www.w3.org/2001/XMLSchema#int">2</aaif:position><aaif:coordinated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:coordinated><aaif:morphosyntacticStructure rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Adjective" /><aaif:inflection rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Uninflected" /><aaif:attributionTarget rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Verb" /><aaif:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:modified><aaif:semanticClassification rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Manner" /><aaif:reduplicated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:reduplicated><aaif:prepositionalPhrase rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:prepositionalPhrase></aaif:Adverb><aaif:Entry rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En1500"><aaif:phrase rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh#En1500Ph1" /><aaif:source rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh.bibl#Cnde79" /><gams:textualContent>— Sóplame más —dijo, con los ojos cerrados—. Sóplame  fuerte , papito.</gams:textualContent><rel:isPartOf rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh" /></aaif:Entry><aaif:Phrase rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En1500Ph1"><aaif:verb rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh#En1500Ph1Ve1" /><aaif:adverb rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh#En1500Ph1Ad1" /><aaif:text> Sóplame  fuerte </aaif:text><aaif:annoText> [v|Sóplame|soplar|is]  [a|fuerte|fuerte|auvnmnnn] </aaif:annoText></aaif:Phrase><aaif:Verb rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En1500Ph1Ve1"><aaif:text>Sóplame</aaif:text><aaif:lemma rdf:resource="https://gams.uni-graz.at/o:aaif.lemma#soplar" /><aaif:position rdf:datatype="http://www.w3.org/2001/XMLSchema#int">1</aaif:position><aaif:coordinated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:coordinated><aaif:partOfText rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</aaif:partOfText><aaif:syntacticConstruction rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Intransitive" /></aaif:Verb><aaif:Adverb rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En1500Ph1Ad1"><aaif:text>fuerte</aaif:text><aaif:lemma rdf:resource="https://gams.uni-graz.at/o:aaif.lemma#fuerte" /><aaif:position rdf:datatype="http://www.w3.org/2001/XMLSchema#int">2</aaif:position><aaif:coordinated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:coordinated><aaif:morphosyntacticStructure rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Adjective" /><aaif:inflection rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Uninflected" /><aaif:attributionTarget rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Verb" /><aaif:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:modified><aaif:semanticClassification rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Manner" /><aaif:reduplicated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:reduplicated><aaif:prepositionalPhrase rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:prepositionalPhrase></aaif:Adverb><aaif:Entry rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En1501"><aaif:phrase rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh#En1501Ph1" /><aaif:source rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh.bibl#Cnde79" /><gams:textualContent>, no se ría.Me quiso cachar la chata de mierda.Me agarró la pistola y me sobó fuerte , con una maña tremenda.Nunca había visto yo mujer tan puta, Balbicito.Nunca.Se me</gams:textualContent><rel:isPartOf rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh" /></aaif:Entry><aaif:Phrase rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En1501Ph1"><aaif:verb rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh#En1501Ph1Ve1" /><aaif:adverb rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh#En1501Ph1Ad1" /><aaif:text>Me agarró la pistola y me sobó fuerte </aaif:text><aaif:annoText>Me agarró la pistola y me [v|sobó|sobar|ts] [a|fuerte|fuerte|auvnmnnn] </aaif:annoText></aaif:Phrase><aaif:Verb rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En1501Ph1Ve1"><aaif:text>sobó</aaif:text><aaif:lemma rdf:resource="https://gams.uni-graz.at/o:aaif.lemma#sobar" /><aaif:position rdf:datatype="http://www.w3.org/2001/XMLSchema#int">1</aaif:position><aaif:coordinated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:coordinated><aaif:partOfText rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</aaif:partOfText><aaif:syntacticConstruction rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Transitive" /></aaif:Verb><aaif:Adverb rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En1501Ph1Ad1"><aaif:text>fuerte</aaif:text><aaif:lemma rdf:resource="https://gams.uni-graz.at/o:aaif.lemma#fuerte" /><aaif:position rdf:datatype="http://www.w3.org/2001/XMLSchema#int">2</aaif:position><aaif:coordinated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:coordinated><aaif:morphosyntacticStructure rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Adjective" /><aaif:inflection rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Uninflected" /><aaif:attributionTarget rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Verb" /><aaif:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:modified><aaif:semanticClassification rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Manner" /><aaif:reduplicated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:reduplicated><aaif:prepositionalPhrase rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:prepositionalPhrase></aaif:Adverb><aaif:Entry rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En1502"><aaif:phrase rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh#En1502Ph1" /><aaif:source rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh.bibl#Cnde79" /><gams:textualContent>l periódico, por Dios que me corrí como cinco, seis cuadras del jirón de la Unión  tarareando  fuerte la canción de Rocky (y era tarde, ah, serían, qué, las tres de la mañana</gams:textualContent><rel:isPartOf rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh" /></aaif:Entry><aaif:Phrase rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En1502Ph1"><aaif:verb rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh#En1502Ph1Ve1" /><aaif:adverb rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh#En1502Ph1Ad1" /><aaif:text> tarareando  fuerte la canción de Rocky</aaif:text><aaif:annoText> [v|tarareando|tararear|ts]  [a|fuerte|fuerte|auvnmnnn] la canción de Rocky</aaif:annoText></aaif:Phrase><aaif:Verb rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En1502Ph1Ve1"><aaif:text>tarareando</aaif:text><aaif:lemma rdf:resource="https://gams.uni-graz.at/o:aaif.lemma#tararear" /><aaif:position rdf:datatype="http://www.w3.org/2001/XMLSchema#int">1</aaif:position><aaif:coordinated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:coordinated><aaif:partOfText rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</aaif:partOfText><aaif:syntacticConstruction rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Transitive" /></aaif:Verb><aaif:Adverb rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En1502Ph1Ad1"><aaif:text>fuerte</aaif:text><aaif:lemma rdf:resource="https://gams.uni-graz.at/o:aaif.lemma#fuerte" /><aaif:position rdf:datatype="http://www.w3.org/2001/XMLSchema#int">2</aaif:position><aaif:coordinated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:coordinated><aaif:morphosyntacticStructure rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Adjective" /><aaif:inflection rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Uninflected" /><aaif:attributionTarget rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Verb" /><aaif:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:modified><aaif:semanticClassification rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Manner" /><aaif:reduplicated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:reduplicated><aaif:prepositionalPhrase rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:prepositionalPhrase></aaif:Adverb><aaif:Entry rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En1503"><aaif:phrase rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh#En1503Ph1" /><aaif:source rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh.bibl#Cnde79" /><gams:textualContent>acaricia el sexo duro, él le toca los pechos con una mano.Están parados, nerviosos, respirando fuerte .</gams:textualContent><rel:isPartOf rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh" /></aaif:Entry><aaif:Phrase rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En1503Ph1"><aaif:verb rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh#En1503Ph1Ve1" /><aaif:adverb rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh#En1503Ph1Ad1" /><aaif:text>Están parados, nerviosos, respirando fuerte </aaif:text><aaif:annoText>Están parados, nerviosos, [v|respirando|respirar|is] [a|fuerte|fuerte|auvnmnnn] </aaif:annoText></aaif:Phrase><aaif:Verb rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En1503Ph1Ve1"><aaif:text>respirando</aaif:text><aaif:lemma rdf:resource="https://gams.uni-graz.at/o:aaif.lemma#respirar" /><aaif:position rdf:datatype="http://www.w3.org/2001/XMLSchema#int">1</aaif:position><aaif:coordinated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:coordinated><aaif:partOfText rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</aaif:partOfText><aaif:syntacticConstruction rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Intransitive" /></aaif:Verb><aaif:Adverb rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En1503Ph1Ad1"><aaif:text>fuerte</aaif:text><aaif:lemma rdf:resource="https://gams.uni-graz.at/o:aaif.lemma#fuerte" /><aaif:position rdf:datatype="http://www.w3.org/2001/XMLSchema#int">2</aaif:position><aaif:coordinated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:coordinated><aaif:morphosyntacticStructure rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Adjective" /><aaif:inflection rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Uninflected" /><aaif:attributionTarget rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Verb" /><aaif:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:modified><aaif:semanticClassification rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Manner" /><aaif:reduplicated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:reduplicated><aaif:prepositionalPhrase rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:prepositionalPhrase></aaif:Adverb><aaif:Entry rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En1504"><aaif:phrase rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh#En1504Ph1" /><aaif:source rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh.bibl#Cnde79" /><gams:textualContent>, los fotógrafos con sus cámaras en el pecho, Escollo, Moreno, Rodríguez, Tellería, todos empujando fuerte  y protestando y exigiendo mi quincena, carajo, mi quincena, yo no salgo de comisión si no me</gams:textualContent><rel:isPartOf rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh" /></aaif:Entry><aaif:Phrase rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En1504Ph1"><aaif:verb rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh#En1504Ph1Ve1" /><aaif:adverb rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh#En1504Ph1Ad1" /><aaif:text>los fotógrafos con sus cámaras en el pecho, Escollo, Moreno, Rodríguez, Tellería, todos empujando fuerte </aaif:text><aaif:annoText>los fotógrafos con sus cámaras en el pecho, Escollo, Moreno, Rodríguez, Tellería, todos [v|empujando|empujar|is] [a|fuerte|fuerte|auvnmnnn] </aaif:annoText></aaif:Phrase><aaif:Verb rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En1504Ph1Ve1"><aaif:text>empujando</aaif:text><aaif:lemma rdf:resource="https://gams.uni-graz.at/o:aaif.lemma#empujar" /><aaif:position rdf:datatype="http://www.w3.org/2001/XMLSchema#int">1</aaif:position><aaif:coordinated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:coordinated><aaif:partOfText rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</aaif:partOfText><aaif:syntacticConstruction rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Intransitive" /></aaif:Verb><aaif:Adverb rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En1504Ph1Ad1"><aaif:text>fuerte</aaif:text><aaif:lemma rdf:resource="https://gams.uni-graz.at/o:aaif.lemma#fuerte" /><aaif:position rdf:datatype="http://www.w3.org/2001/XMLSchema#int">2</aaif:position><aaif:coordinated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:coordinated><aaif:morphosyntacticStructure rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Adjective" /><aaif:inflection rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Uninflected" /><aaif:attributionTarget rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Verb" /><aaif:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:modified><aaif:semanticClassification rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Manner" /><aaif:reduplicated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:reduplicated><aaif:prepositionalPhrase rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:prepositionalPhrase></aaif:Adverb><aaif:Entry rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En1505"><aaif:phrase rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh#En1505Ph1" /><aaif:source rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh.bibl#Cnde79" /><gams:textualContent>, Susi —dice él, y trata de cerrar la mano, pero  ella no lo deja, aprieta fuerte  y sigue leyendo:</gams:textualContent><rel:isPartOf rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh" /></aaif:Entry><aaif:Phrase rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En1505Ph1"><aaif:subject rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh#En1505Ph1Su1" /><aaif:verb rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh#En1505Ph1Ve1" /><aaif:adverb rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh#En1505Ph1Ad1" /><aaif:text> ella no lo deja, aprieta fuerte </aaif:text><aaif:annoText> [s|ella|fs] no lo deja, [v|aprieta|apretar|is] [a|fuerte|fuerte|auvnmnnn] </aaif:annoText></aaif:Phrase><aaif:Subject rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En1505Ph1Su1"><aaif:text>ella</aaif:text><aaif:position rdf:datatype="http://www.w3.org/2001/XMLSchema#int">1</aaif:position><aaif:gender rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Feminine" /><aaif:number rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Singular" /><aaif:overt rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</aaif:overt></aaif:Subject><aaif:Verb rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En1505Ph1Ve1"><aaif:text>aprieta</aaif:text><aaif:lemma rdf:resource="https://gams.uni-graz.at/o:aaif.lemma#apretar" /><aaif:position rdf:datatype="http://www.w3.org/2001/XMLSchema#int">2</aaif:position><aaif:coordinated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:coordinated><aaif:partOfText rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</aaif:partOfText><aaif:syntacticConstruction rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Intransitive" /></aaif:Verb><aaif:Adverb rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En1505Ph1Ad1"><aaif:text>fuerte</aaif:text><aaif:lemma rdf:resource="https://gams.uni-graz.at/o:aaif.lemma#fuerte" /><aaif:position rdf:datatype="http://www.w3.org/2001/XMLSchema#int">3</aaif:position><aaif:coordinated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:coordinated><aaif:morphosyntacticStructure rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Adjective" /><aaif:inflection rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Uninflected" /><aaif:attributionTarget rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Verb" /><aaif:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:modified><aaif:semanticClassification rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Manner" /><aaif:reduplicated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:reduplicated><aaif:prepositionalPhrase rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:prepositionalPhrase></aaif:Adverb><aaif:Entry rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En1506"><aaif:phrase rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh#En1506Ph1" /><aaif:source rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh.bibl#Cnde79" /><gams:textualContent>nieto se da cuenta de que no debió decir nada, pero ya es tarde, o sea que  aprieta  fuerte el rosario y acelera las avemarías a ver si bate su récord.</gams:textualContent><rel:isPartOf rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh" /></aaif:Entry><aaif:Phrase rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En1506Ph1"><aaif:verb rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh#En1506Ph1Ve1" /><aaif:adverb rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh#En1506Ph1Ad1" /><aaif:text> aprieta  fuerte el rosario</aaif:text><aaif:annoText> [v|aprieta|apretar|ts]  [a|fuerte|fuerte|auvnmnnn] el rosario</aaif:annoText></aaif:Phrase><aaif:Verb rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En1506Ph1Ve1"><aaif:text>aprieta</aaif:text><aaif:lemma rdf:resource="https://gams.uni-graz.at/o:aaif.lemma#apretar" /><aaif:position rdf:datatype="http://www.w3.org/2001/XMLSchema#int">1</aaif:position><aaif:coordinated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:coordinated><aaif:partOfText rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</aaif:partOfText><aaif:syntacticConstruction rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Transitive" /></aaif:Verb><aaif:Adverb rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En1506Ph1Ad1"><aaif:text>fuerte</aaif:text><aaif:lemma rdf:resource="https://gams.uni-graz.at/o:aaif.lemma#fuerte" /><aaif:position rdf:datatype="http://www.w3.org/2001/XMLSchema#int">2</aaif:position><aaif:coordinated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:coordinated><aaif:morphosyntacticStructure rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Adjective" /><aaif:inflection rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Uninflected" /><aaif:attributionTarget rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Verb" /><aaif:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:modified><aaif:semanticClassification rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Manner" /><aaif:reduplicated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:reduplicated><aaif:prepositionalPhrase rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:prepositionalPhrase></aaif:Adverb><aaif:Entry rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En1507"><aaif:phrase rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh#En1507Ph1" /><aaif:source rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh.bibl#Cnde79" /><gams:textualContent>Te digo que no —le dice don Rafael , más fuerte , echando fuego por los ojos, agarrándole fuerte la mano, alejándola de la canasta—.Ni un centavo pones ahí.</gams:textualContent><rel:isPartOf rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh" /></aaif:Entry><aaif:Phrase rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En1507Ph1"><aaif:subject rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh#En1507Ph1Su1" /><aaif:verb rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh#En1507Ph1Ve1" /><aaif:adverb rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh#En1507Ph1Ad1" /><aaif:text>le dice don Rafael , más fuerte </aaif:text><aaif:annoText>le [v|dice|decir|ts] [s|don Rafael|ms] , más [a|fuerte|fuerte|auvmmnnn] </aaif:annoText></aaif:Phrase><aaif:Subject rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En1507Ph1Su1"><aaif:text>don Rafael</aaif:text><aaif:position rdf:datatype="http://www.w3.org/2001/XMLSchema#int">2</aaif:position><aaif:gender rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Masculine" /><aaif:number rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Singular" /><aaif:overt rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</aaif:overt></aaif:Subject><aaif:Verb rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En1507Ph1Ve1"><aaif:text>dice</aaif:text><aaif:lemma rdf:resource="https://gams.uni-graz.at/o:aaif.lemma#decir" /><aaif:position rdf:datatype="http://www.w3.org/2001/XMLSchema#int">1</aaif:position><aaif:coordinated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:coordinated><aaif:partOfText rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</aaif:partOfText><aaif:syntacticConstruction rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Transitive" /></aaif:Verb><aaif:Adverb rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En1507Ph1Ad1"><aaif:text>fuerte</aaif:text><aaif:lemma rdf:resource="https://gams.uni-graz.at/o:aaif.lemma#fuerte" /><aaif:position rdf:datatype="http://www.w3.org/2001/XMLSchema#int">3</aaif:position><aaif:coordinated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:coordinated><aaif:morphosyntacticStructure rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Adjective" /><aaif:inflection rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Uninflected" /><aaif:attributionTarget rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Verb" /><aaif:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</aaif:modified><aaif:semanticClassification rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Manner" /><aaif:reduplicated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:reduplicated><aaif:prepositionalPhrase rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:prepositionalPhrase></aaif:Adverb><aaif:Entry rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En1508"><aaif:phrase rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh#En1508Ph1" /><aaif:source rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh.bibl#Cnde79" /><gams:textualContent>y el cura sigue hablando allá lejos, en el altar, y  doña Inés cierra los ojos y aprieta fuerte, fortísimo , su rosario—.Dame mi plata o te rompo la cara, Larrañaga.</gams:textualContent><rel:isPartOf rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh" /></aaif:Entry><aaif:Phrase rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En1508Ph1"><aaif:subject rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh#En1508Ph1Su1" /><aaif:verb rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh#En1508Ph1Ve1" /><aaif:adverb rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh#En1508Ph1Ad1" /><aaif:text> doña Inés cierra los ojos y aprieta fuerte, fortísimo , su rosario</aaif:text><aaif:annoText> [s|doña Inés|fs] cierra los ojos y [v|aprieta|apretar|ts] fuerte, [a|fortísimo|fuerte|auvnmrnn] , su rosario</aaif:annoText></aaif:Phrase><aaif:Subject rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En1508Ph1Su1"><aaif:text>doña Inés</aaif:text><aaif:position rdf:datatype="http://www.w3.org/2001/XMLSchema#int">1</aaif:position><aaif:gender rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Feminine" /><aaif:number rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Singular" /><aaif:overt rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</aaif:overt></aaif:Subject><aaif:Verb rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En1508Ph1Ve1"><aaif:text>aprieta</aaif:text><aaif:lemma rdf:resource="https://gams.uni-graz.at/o:aaif.lemma#apretar" /><aaif:position rdf:datatype="http://www.w3.org/2001/XMLSchema#int">2</aaif:position><aaif:coordinated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:coordinated><aaif:partOfText rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</aaif:partOfText><aaif:syntacticConstruction rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Transitive" /></aaif:Verb><aaif:Adverb rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En1508Ph1Ad1"><aaif:text>fortísimo</aaif:text><aaif:lemma rdf:resource="https://gams.uni-graz.at/o:aaif.lemma#fuerte" /><aaif:position rdf:datatype="http://www.w3.org/2001/XMLSchema#int">3</aaif:position><aaif:coordinated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:coordinated><aaif:morphosyntacticStructure rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Adjective" /><aaif:inflection rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Uninflected" /><aaif:attributionTarget rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Verb" /><aaif:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:modified><aaif:semanticClassification rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Manner" /><aaif:reduplicated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</aaif:reduplicated><aaif:prepositionalPhrase rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:prepositionalPhrase></aaif:Adverb><aaif:Entry rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En1509"><aaif:phrase rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh#En1509Ph1" /><aaif:source rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh.bibl#Cnde271" /><gams:textualContent>».Ester llama a su primera taza de café.Gime y se queja con cada paso, suspira fuerte  para que América la oiga, se toma su tiempo en soltarse los rolos, peinarse el pelo, pintarse las</gams:textualContent><rel:isPartOf rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh" /></aaif:Entry><aaif:Phrase rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En1509Ph1"><aaif:verb rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh#En1509Ph1Ve1" /><aaif:adverb rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh#En1509Ph1Ad1" /><aaif:text>Gime y se queja con cada paso, suspira fuerte </aaif:text><aaif:annoText>Gime y se queja con cada paso, [v|suspira|suspirar|is] [a|fuerte|fuerte|auvnmnnn] </aaif:annoText></aaif:Phrase><aaif:Verb rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En1509Ph1Ve1"><aaif:text>suspira</aaif:text><aaif:lemma rdf:resource="https://gams.uni-graz.at/o:aaif.lemma#suspirar" /><aaif:position rdf:datatype="http://www.w3.org/2001/XMLSchema#int">1</aaif:position><aaif:coordinated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:coordinated><aaif:partOfText rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</aaif:partOfText><aaif:syntacticConstruction rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Intransitive" /></aaif:Verb><aaif:Adverb rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En1509Ph1Ad1"><aaif:text>fuerte</aaif:text><aaif:lemma rdf:resource="https://gams.uni-graz.at/o:aaif.lemma#fuerte" /><aaif:position rdf:datatype="http://www.w3.org/2001/XMLSchema#int">2</aaif:position><aaif:coordinated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:coordinated><aaif:morphosyntacticStructure rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Adjective" /><aaif:inflection rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Uninflected" /><aaif:attributionTarget rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Verb" /><aaif:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:modified><aaif:semanticClassification rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Manner" /><aaif:reduplicated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:reduplicated><aaif:prepositionalPhrase rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:prepositionalPhrase></aaif:Adverb><aaif:Entry rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En1510"><aaif:phrase rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh#En1510Ph1" /><aaif:source rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh.bibl#Cnde272" /><gams:textualContent>el bolsillo el papel con los teléfonos que el doctor le había dado y, sin querer, lo apretó fuerte entre los dedos.Sabía el camino: en poco tiempo se llegaba al alto de la Tribuna y</gams:textualContent><rel:isPartOf rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh" /></aaif:Entry><aaif:Phrase rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En1510Ph1"><aaif:verb rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh#En1510Ph1Ve1" /><aaif:adverb rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh#En1510Ph1Ad1" /><aaif:text>lo apretó fuerte entre los dedos</aaif:text><aaif:annoText>lo [v|apretó|apretar|ts] [a|fuerte|fuerte|auvnmnnn] entre los dedos</aaif:annoText></aaif:Phrase><aaif:Verb rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En1510Ph1Ve1"><aaif:text>apretó</aaif:text><aaif:lemma rdf:resource="https://gams.uni-graz.at/o:aaif.lemma#apretar" /><aaif:position rdf:datatype="http://www.w3.org/2001/XMLSchema#int">1</aaif:position><aaif:coordinated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:coordinated><aaif:partOfText rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</aaif:partOfText><aaif:syntacticConstruction rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Transitive" /></aaif:Verb><aaif:Adverb rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En1510Ph1Ad1"><aaif:text>fuerte</aaif:text><aaif:lemma rdf:resource="https://gams.uni-graz.at/o:aaif.lemma#fuerte" /><aaif:position rdf:datatype="http://www.w3.org/2001/XMLSchema#int">2</aaif:position><aaif:coordinated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:coordinated><aaif:morphosyntacticStructure rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Adjective" /><aaif:inflection rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Uninflected" /><aaif:attributionTarget rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Verb" /><aaif:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:modified><aaif:semanticClassification rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Manner" /><aaif:reduplicated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:reduplicated><aaif:prepositionalPhrase rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:prepositionalPhrase></aaif:Adverb><aaif:Entry rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En1511"><aaif:phrase rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh#En1511Ph1" /><aaif:source rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh.bibl#Cnde272" /><gams:textualContent>miró hacia el pupitre del hermano Hilario y lo vio recostado en el respaldar del sillón, respirando fuerte , moviendo la cabeza al ritmo de cada ronquido.Miro el reloj de la sala y comprobó que</gams:textualContent><rel:isPartOf rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh" /></aaif:Entry><aaif:Phrase rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En1511Ph1"><aaif:subject rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh#En1511Ph1Su1" /><aaif:verb rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh#En1511Ph1Ve1" /><aaif:adverb rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh#En1511Ph1Ad1" /><aaif:text>miró hacia el pupitre del hermano Hilario y lo vio recostado en el respaldar del sillón, respirando fuerte </aaif:text><aaif:annoText>miró hacia el pupitre del [s|hermano Hilario|ms] y lo vio recostado en el respaldar del sillón, [v|respirando|respirar|is] [a|fuerte|fuerte|auvnmnnn] </aaif:annoText></aaif:Phrase><aaif:Subject rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En1511Ph1Su1"><aaif:text>hermano Hilario</aaif:text><aaif:position rdf:datatype="http://www.w3.org/2001/XMLSchema#int">1</aaif:position><aaif:gender rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Masculine" /><aaif:number rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Singular" /><aaif:overt rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</aaif:overt></aaif:Subject><aaif:Verb rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En1511Ph1Ve1"><aaif:text>respirando</aaif:text><aaif:lemma rdf:resource="https://gams.uni-graz.at/o:aaif.lemma#respirar" /><aaif:position rdf:datatype="http://www.w3.org/2001/XMLSchema#int">2</aaif:position><aaif:coordinated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:coordinated><aaif:partOfText rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</aaif:partOfText><aaif:syntacticConstruction rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Intransitive" /></aaif:Verb><aaif:Adverb rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En1511Ph1Ad1"><aaif:text>fuerte</aaif:text><aaif:lemma rdf:resource="https://gams.uni-graz.at/o:aaif.lemma#fuerte" /><aaif:position rdf:datatype="http://www.w3.org/2001/XMLSchema#int">3</aaif:position><aaif:coordinated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:coordinated><aaif:morphosyntacticStructure rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Adjective" /><aaif:inflection rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Uninflected" /><aaif:attributionTarget rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Verb" /><aaif:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:modified><aaif:semanticClassification rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Manner" /><aaif:reduplicated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:reduplicated><aaif:prepositionalPhrase rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:prepositionalPhrase></aaif:Adverb><aaif:Entry rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En1512"><aaif:phrase rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh#En1512Ph1" /><aaif:source rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh.bibl#Cnde272" /><gams:textualContent>¡Fer!—se abrazan fuertísimo y Jaime comienza a sentir un río de sangre subiéndole por el cuello.</gams:textualContent><rel:isPartOf rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh" /></aaif:Entry><aaif:Phrase rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En1512Ph1"><aaif:verb rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh#En1512Ph1Ve1" /><aaif:adverb rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh#En1512Ph1Ad1" /><aaif:text>se abrazan fuertísimo y Jaime comienza a sentir un río de sangre</aaif:text><aaif:annoText>se [v|abrazan|abrazar|rs] [a|fuertísimo|fuerte|auvnmnnn] y Jaime comienza a sentir un río de sangre</aaif:annoText></aaif:Phrase><aaif:Verb rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En1512Ph1Ve1"><aaif:text>abrazan</aaif:text><aaif:lemma rdf:resource="https://gams.uni-graz.at/o:aaif.lemma#abrazar" /><aaif:position rdf:datatype="http://www.w3.org/2001/XMLSchema#int">1</aaif:position><aaif:coordinated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:coordinated><aaif:partOfText rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</aaif:partOfText><aaif:syntacticConstruction rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Reflexive" /></aaif:Verb><aaif:Adverb rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En1512Ph1Ad1"><aaif:text>fuertísimo</aaif:text><aaif:lemma rdf:resource="https://gams.uni-graz.at/o:aaif.lemma#fuerte" /><aaif:position rdf:datatype="http://www.w3.org/2001/XMLSchema#int">2</aaif:position><aaif:coordinated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:coordinated><aaif:morphosyntacticStructure rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Adjective" /><aaif:inflection rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Uninflected" /><aaif:attributionTarget rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Verb" /><aaif:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:modified><aaif:semanticClassification rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Manner" /><aaif:reduplicated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:reduplicated><aaif:prepositionalPhrase rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:prepositionalPhrase></aaif:Adverb><aaif:Entry rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En1513"><aaif:phrase rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh#En1513Ph1" /><aaif:source rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh.bibl#Cnde272" /><gams:textualContent>Se la dedico, señorita —Heberto le cogió la mano apretando fuerte  pero ella sintió miedo y se soltó ahí mismo.</gams:textualContent><rel:isPartOf rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh" /></aaif:Entry><aaif:Phrase rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En1513Ph1"><aaif:verb rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh#En1513Ph1Ve1" /><aaif:adverb rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh#En1513Ph1Ad1" /><aaif:text>Heberto le cogió la mano apretando fuerte </aaif:text><aaif:annoText>Heberto le cogió la mano [v|apretando|apretar|is] [a|fuerte|fuerte|auvnmnnn] </aaif:annoText></aaif:Phrase><aaif:Verb rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En1513Ph1Ve1"><aaif:text>apretando</aaif:text><aaif:lemma rdf:resource="https://gams.uni-graz.at/o:aaif.lemma#apretar" /><aaif:position rdf:datatype="http://www.w3.org/2001/XMLSchema#int">1</aaif:position><aaif:coordinated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:coordinated><aaif:partOfText rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</aaif:partOfText><aaif:syntacticConstruction rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Intransitive" /></aaif:Verb><aaif:Adverb rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En1513Ph1Ad1"><aaif:text>fuerte</aaif:text><aaif:lemma rdf:resource="https://gams.uni-graz.at/o:aaif.lemma#fuerte" /><aaif:position rdf:datatype="http://www.w3.org/2001/XMLSchema#int">2</aaif:position><aaif:coordinated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:coordinated><aaif:morphosyntacticStructure rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Adjective" /><aaif:inflection rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Uninflected" /><aaif:attributionTarget rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Verb" /><aaif:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:modified><aaif:semanticClassification rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Manner" /><aaif:reduplicated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:reduplicated><aaif:prepositionalPhrase rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:prepositionalPhrase></aaif:Adverb><aaif:Entry rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En1514"><aaif:phrase rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh#En1514Ph1" /><aaif:source rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh.bibl#Cnde272" /><gams:textualContent>botella de cerveza y alcanza por fin el auricular dándose cuenta de que está desnudo, de que  el sol  entra fuertísimo por la ventana.</gams:textualContent><rel:isPartOf rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh" /></aaif:Entry><aaif:Phrase rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En1514Ph1"><aaif:subject rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh#En1514Ph1Su1" /><aaif:verb rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh#En1514Ph1Ve1" /><aaif:adverb rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh#En1514Ph1Ad1" /><aaif:text> el sol  entra fuertísimo por la ventana</aaif:text><aaif:annoText> [s|el sol|ms]  [v|entra|entrar|is] [a|fuertísimo|fuerte|auvnmnnn] por la ventana</aaif:annoText></aaif:Phrase><aaif:Subject rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En1514Ph1Su1"><aaif:text>el sol</aaif:text><aaif:position rdf:datatype="http://www.w3.org/2001/XMLSchema#int">1</aaif:position><aaif:gender rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Masculine" /><aaif:number rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Singular" /><aaif:overt rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</aaif:overt></aaif:Subject><aaif:Verb rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En1514Ph1Ve1"><aaif:text>entra</aaif:text><aaif:lemma rdf:resource="https://gams.uni-graz.at/o:aaif.lemma#entrar" /><aaif:position rdf:datatype="http://www.w3.org/2001/XMLSchema#int">2</aaif:position><aaif:coordinated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:coordinated><aaif:partOfText rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</aaif:partOfText><aaif:syntacticConstruction rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Intransitive" /></aaif:Verb><aaif:Adverb rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En1514Ph1Ad1"><aaif:text>fuertísimo</aaif:text><aaif:lemma rdf:resource="https://gams.uni-graz.at/o:aaif.lemma#fuerte" /><aaif:position rdf:datatype="http://www.w3.org/2001/XMLSchema#int">3</aaif:position><aaif:coordinated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:coordinated><aaif:morphosyntacticStructure rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Adjective" /><aaif:inflection rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Uninflected" /><aaif:attributionTarget rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Verb" /><aaif:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:modified><aaif:semanticClassification rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Manner" /><aaif:reduplicated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:reduplicated><aaif:prepositionalPhrase rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:prepositionalPhrase></aaif:Adverb><aaif:Entry rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En1515"><aaif:phrase rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh#En1515Ph1" /><aaif:source rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh.bibl#Cnde272" /><gams:textualContent> El sol  pega fuerte , la familia del Simca se va.Un soldado revisa la parte de atrás del jeep y</gams:textualContent><rel:isPartOf rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh" /></aaif:Entry><aaif:Phrase rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En1515Ph1"><aaif:subject rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh#En1515Ph1Su1" /><aaif:verb rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh#En1515Ph1Ve1" /><aaif:adverb rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh#En1515Ph1Ad1" /><aaif:text> El sol  pega fuerte </aaif:text><aaif:annoText> [s|El sol|ms]  [v|pega|pegar|is] [a|fuerte|fuerte|auvnmnnn] </aaif:annoText></aaif:Phrase><aaif:Subject rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En1515Ph1Su1"><aaif:text>El sol</aaif:text><aaif:position rdf:datatype="http://www.w3.org/2001/XMLSchema#int">1</aaif:position><aaif:gender rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Masculine" /><aaif:number rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Singular" /><aaif:overt rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</aaif:overt></aaif:Subject><aaif:Verb rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En1515Ph1Ve1"><aaif:text>pega</aaif:text><aaif:lemma rdf:resource="https://gams.uni-graz.at/o:aaif.lemma#pegar" /><aaif:position rdf:datatype="http://www.w3.org/2001/XMLSchema#int">2</aaif:position><aaif:coordinated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:coordinated><aaif:partOfText rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</aaif:partOfText><aaif:syntacticConstruction rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Intransitive" /></aaif:Verb><aaif:Adverb rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En1515Ph1Ad1"><aaif:text>fuerte</aaif:text><aaif:lemma rdf:resource="https://gams.uni-graz.at/o:aaif.lemma#fuerte" /><aaif:position rdf:datatype="http://www.w3.org/2001/XMLSchema#int">3</aaif:position><aaif:coordinated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:coordinated><aaif:morphosyntacticStructure rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Adjective" /><aaif:inflection rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Uninflected" /><aaif:attributionTarget rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Verb" /><aaif:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:modified><aaif:semanticClassification rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Manner" /><aaif:reduplicated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:reduplicated><aaif:prepositionalPhrase rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:prepositionalPhrase></aaif:Adverb><aaif:Entry rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En1516"><aaif:phrase rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh#En1516Ph1" /><aaif:source rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh.bibl#Cnde272" /><gams:textualContent>Tengo miedo, Arturo, vámonos de aquí —lo abraza fuerte .</gams:textualContent><rel:isPartOf rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh" /></aaif:Entry><aaif:Phrase rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En1516Ph1"><aaif:verb rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh#En1516Ph1Ve1" /><aaif:adverb rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh#En1516Ph1Ad1" /><aaif:text>lo abraza fuerte </aaif:text><aaif:annoText>lo [v|abraza|abrazar|ts] [a|fuerte|fuerte|auvnmnnn] </aaif:annoText></aaif:Phrase><aaif:Verb rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En1516Ph1Ve1"><aaif:text>abraza</aaif:text><aaif:lemma rdf:resource="https://gams.uni-graz.at/o:aaif.lemma#abrazar" /><aaif:position rdf:datatype="http://www.w3.org/2001/XMLSchema#int">1</aaif:position><aaif:coordinated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:coordinated><aaif:partOfText rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</aaif:partOfText><aaif:syntacticConstruction rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Transitive" /></aaif:Verb><aaif:Adverb rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En1516Ph1Ad1"><aaif:text>fuerte</aaif:text><aaif:lemma rdf:resource="https://gams.uni-graz.at/o:aaif.lemma#fuerte" /><aaif:position rdf:datatype="http://www.w3.org/2001/XMLSchema#int">2</aaif:position><aaif:coordinated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:coordinated><aaif:morphosyntacticStructure rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Adjective" /><aaif:inflection rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Uninflected" /><aaif:attributionTarget rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Verb" /><aaif:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:modified><aaif:semanticClassification rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Manner" /><aaif:reduplicated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:reduplicated><aaif:prepositionalPhrase rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:prepositionalPhrase></aaif:Adverb><aaif:Entry rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En1517"><aaif:phrase rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh#En1517Ph1" /><aaif:source rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh.bibl#Cnde272" /><gams:textualContent>Sí, pero no te asustes que no es nada malo —la abrazó fuerte .</gams:textualContent><rel:isPartOf rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh" /></aaif:Entry><aaif:Phrase rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En1517Ph1"><aaif:verb rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh#En1517Ph1Ve1" /><aaif:adverb rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh#En1517Ph1Ad1" /><aaif:text>la abrazó fuerte </aaif:text><aaif:annoText>la [v|abrazó|abrazar|ts] [a|fuerte|fuerte|auvnmnnn] </aaif:annoText></aaif:Phrase><aaif:Verb rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En1517Ph1Ve1"><aaif:text>abrazó</aaif:text><aaif:lemma rdf:resource="https://gams.uni-graz.at/o:aaif.lemma#abrazar" /><aaif:position rdf:datatype="http://www.w3.org/2001/XMLSchema#int">1</aaif:position><aaif:coordinated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:coordinated><aaif:partOfText rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</aaif:partOfText><aaif:syntacticConstruction rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Transitive" /></aaif:Verb><aaif:Adverb rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En1517Ph1Ad1"><aaif:text>fuerte</aaif:text><aaif:lemma rdf:resource="https://gams.uni-graz.at/o:aaif.lemma#fuerte" /><aaif:position rdf:datatype="http://www.w3.org/2001/XMLSchema#int">2</aaif:position><aaif:coordinated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:coordinated><aaif:morphosyntacticStructure rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Adjective" /><aaif:inflection rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Uninflected" /><aaif:attributionTarget rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Verb" /><aaif:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:modified><aaif:semanticClassification rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Manner" /><aaif:reduplicated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:reduplicated><aaif:prepositionalPhrase rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:prepositionalPhrase></aaif:Adverb><aaif:Entry rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En1518"><aaif:phrase rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh#En1518Ph1" /><aaif:source rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh.bibl#Cnde272" /><gams:textualContent>y dijo «al terminal» con voz temblona; hizo el viaje con la niña alzada,  abrazándola  fuerte , viendo en cada cara un rostro enemigo, en cada esquina un peligro, y además miró al</gams:textualContent><rel:isPartOf rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh" /></aaif:Entry><aaif:Phrase rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En1518Ph1"><aaif:verb rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh#En1518Ph1Ve1" /><aaif:adverb rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh#En1518Ph1Ad1" /><aaif:text> abrazándola  fuerte </aaif:text><aaif:annoText> [v|abrazándola|abrazar|ts]  [a|fuerte|fuerte|auvnmnnn] </aaif:annoText></aaif:Phrase><aaif:Verb rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En1518Ph1Ve1"><aaif:text>abrazándola</aaif:text><aaif:lemma rdf:resource="https://gams.uni-graz.at/o:aaif.lemma#abrazar" /><aaif:position rdf:datatype="http://www.w3.org/2001/XMLSchema#int">1</aaif:position><aaif:coordinated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:coordinated><aaif:partOfText rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</aaif:partOfText><aaif:syntacticConstruction rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Transitive" /></aaif:Verb><aaif:Adverb rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En1518Ph1Ad1"><aaif:text>fuerte</aaif:text><aaif:lemma rdf:resource="https://gams.uni-graz.at/o:aaif.lemma#fuerte" /><aaif:position rdf:datatype="http://www.w3.org/2001/XMLSchema#int">2</aaif:position><aaif:coordinated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:coordinated><aaif:morphosyntacticStructure rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Adjective" /><aaif:inflection rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Uninflected" /><aaif:attributionTarget rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Verb" /><aaif:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:modified><aaif:semanticClassification rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Manner" /><aaif:reduplicated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:reduplicated><aaif:prepositionalPhrase rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:prepositionalPhrase></aaif:Adverb><aaif:Entry rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En1519"><aaif:phrase rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh#En1519Ph1" /><aaif:source rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh.bibl#Cnde272" /><gams:textualContent>si se coge alguna enfermedad qué, ah?— Tati se fue tomando el café a sorbitos, respirando fuerte  por la impresión al ver el salón del Cobra, la casa donde Claudia trabajaba; una barra</gams:textualContent><rel:isPartOf rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh" /></aaif:Entry><aaif:Phrase rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En1519Ph1"><aaif:subject rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh#En1519Ph1Su1" /><aaif:verb rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh#En1519Ph1Ve1" /><aaif:adverb rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh#En1519Ph1Ad1" /><aaif:text> Tati se fue tomando el café a sorbitos, respirando fuerte </aaif:text><aaif:annoText> [s|Tati|fs] se fue tomando el café a sorbitos, [v|respirando|respirar|is] [a|fuerte|fuerte|auvnmnnn] </aaif:annoText></aaif:Phrase><aaif:Subject rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En1519Ph1Su1"><aaif:text>Tati</aaif:text><aaif:position rdf:datatype="http://www.w3.org/2001/XMLSchema#int">1</aaif:position><aaif:gender rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Feminine" /><aaif:number rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Singular" /><aaif:overt rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</aaif:overt></aaif:Subject><aaif:Verb rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En1519Ph1Ve1"><aaif:text>respirando</aaif:text><aaif:lemma rdf:resource="https://gams.uni-graz.at/o:aaif.lemma#respirar" /><aaif:position rdf:datatype="http://www.w3.org/2001/XMLSchema#int">2</aaif:position><aaif:coordinated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:coordinated><aaif:partOfText rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</aaif:partOfText><aaif:syntacticConstruction rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Intransitive" /></aaif:Verb><aaif:Adverb rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En1519Ph1Ad1"><aaif:text>fuerte</aaif:text><aaif:lemma rdf:resource="https://gams.uni-graz.at/o:aaif.lemma#fuerte" /><aaif:position rdf:datatype="http://www.w3.org/2001/XMLSchema#int">3</aaif:position><aaif:coordinated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:coordinated><aaif:morphosyntacticStructure rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Adjective" /><aaif:inflection rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Uninflected" /><aaif:attributionTarget rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Verb" /><aaif:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:modified><aaif:semanticClassification rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Manner" /><aaif:reduplicated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:reduplicated><aaif:prepositionalPhrase rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:prepositionalPhrase></aaif:Adverb><aaif:Entry rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En1520"><aaif:phrase rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh#En1520Ph1" /><aaif:source rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh.bibl#Cnde80" /><gams:textualContent>Pero Piva no fue más que la excepción que confirma la regla en un país donde soplaba fuerte  el huracán Anorexia  y el ciclón Bulimia azotaba sin miramientos el tallo y el talle de lánguidas vírgenes desesperadas por</gams:textualContent><rel:isPartOf rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh" /></aaif:Entry><aaif:Phrase rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En1520Ph1"><aaif:subject rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh#En1520Ph1Su1" /><aaif:verb rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh#En1520Ph1Ve1" /><aaif:adverb rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh#En1520Ph1Ad1" /><aaif:text>en un país donde soplaba fuerte  el huracán Anorexia </aaif:text><aaif:annoText>en un país donde [v|soplaba|soplar|is] [a|fuerte|fuerte|auvnmnnn]  [s|el huracán Anorexia|ms] </aaif:annoText></aaif:Phrase><aaif:Subject rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En1520Ph1Su1"><aaif:text>el huracán Anorexia</aaif:text><aaif:position rdf:datatype="http://www.w3.org/2001/XMLSchema#int">3</aaif:position><aaif:gender rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Masculine" /><aaif:number rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Singular" /><aaif:overt rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</aaif:overt></aaif:Subject><aaif:Verb rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En1520Ph1Ve1"><aaif:text>soplaba</aaif:text><aaif:lemma rdf:resource="https://gams.uni-graz.at/o:aaif.lemma#soplar" /><aaif:position rdf:datatype="http://www.w3.org/2001/XMLSchema#int">1</aaif:position><aaif:coordinated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:coordinated><aaif:partOfText rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</aaif:partOfText><aaif:syntacticConstruction rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Intransitive" /></aaif:Verb><aaif:Adverb rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En1520Ph1Ad1"><aaif:text>fuerte</aaif:text><aaif:lemma rdf:resource="https://gams.uni-graz.at/o:aaif.lemma#fuerte" /><aaif:position rdf:datatype="http://www.w3.org/2001/XMLSchema#int">2</aaif:position><aaif:coordinated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:coordinated><aaif:morphosyntacticStructure rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Adjective" /><aaif:inflection rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Uninflected" /><aaif:attributionTarget rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Verb" /><aaif:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:modified><aaif:semanticClassification rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Manner" /><aaif:reduplicated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:reduplicated><aaif:prepositionalPhrase rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:prepositionalPhrase></aaif:Adverb><aaif:Entry rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En1521"><aaif:phrase rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh#En1521Ph1" /><aaif:source rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh.bibl#Cnde80" /><gams:textualContent>el centro.Daniel mira primero el cadáver de una vieja que alguien dejó en el pasillo.Lo mira fuerte , bien fijo , con todos los ojos, pensando que si mira a un muerto antes —a cualquier</gams:textualContent><rel:isPartOf rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh" /></aaif:Entry><aaif:Phrase rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En1521Ph1"><aaif:verb rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh#En1521Ph1Ve1" /><aaif:adverb rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh#En1521Ph1Ad1" /><aaif:adverb rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh#En1521Ph1Ad2" /><aaif:text>Lo mira fuerte , bien fijo </aaif:text><aaif:annoText>Lo [v|mira|mirar|ts] [a|fuerte|fuerte|auvnmnnC] , bien [a|fijo|fijo|auvmmnnC] </aaif:annoText></aaif:Phrase><aaif:Verb rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En1521Ph1Ve1"><aaif:text>mira</aaif:text><aaif:lemma rdf:resource="https://gams.uni-graz.at/o:aaif.lemma#mirar" /><aaif:position rdf:datatype="http://www.w3.org/2001/XMLSchema#int">1</aaif:position><aaif:coordinated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:coordinated><aaif:partOfText rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</aaif:partOfText><aaif:syntacticConstruction rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Transitive" /></aaif:Verb><aaif:Adverb rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En1521Ph1Ad1"><aaif:text>fuerte</aaif:text><aaif:lemma rdf:resource="https://gams.uni-graz.at/o:aaif.lemma#fuerte" /><aaif:position rdf:datatype="http://www.w3.org/2001/XMLSchema#int">2</aaif:position><aaif:coordinated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</aaif:coordinated><aaif:morphosyntacticStructure rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Adjective" /><aaif:inflection rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Uninflected" /><aaif:attributionTarget rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Verb" /><aaif:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:modified><aaif:semanticClassification rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Manner" /><aaif:reduplicated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:reduplicated><aaif:prepositionalPhrase rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:prepositionalPhrase></aaif:Adverb><aaif:Adverb rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En1521Ph1Ad2"><aaif:text>fijo</aaif:text><aaif:lemma rdf:resource="https://gams.uni-graz.at/o:aaif.lemma#fijo" /><aaif:position rdf:datatype="http://www.w3.org/2001/XMLSchema#int">3</aaif:position><aaif:coordinated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</aaif:coordinated><aaif:morphosyntacticStructure rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Adjective" /><aaif:inflection rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Uninflected" /><aaif:attributionTarget rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Verb" /><aaif:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</aaif:modified><aaif:semanticClassification rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Manner" /><aaif:reduplicated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:reduplicated><aaif:prepositionalPhrase rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:prepositionalPhrase></aaif:Adverb><aaif:Entry rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En1522"><aaif:phrase rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh#En1522Ph1" /><aaif:source rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh.bibl#Cnde80" /><gams:textualContent>escucha demasiado. Hilda dice que «Sí... sí, papi... no te preocupes», y aprieta fuerte su almohadón y piensa en que hay que llegar rápido a casa para acostarse junto al lavarropas.Por más que no</gams:textualContent><rel:isPartOf rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh" /></aaif:Entry><aaif:Phrase rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En1522Ph1"><aaif:subject rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh#En1522Ph1Su1" /><aaif:verb rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh#En1522Ph1Ve1" /><aaif:adverb rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh#En1522Ph1Ad1" /><aaif:text> Hilda dice que «Sí... sí, papi... no te preocupes», y aprieta fuerte su almohadón</aaif:text><aaif:annoText> [s|Hilda|fs] dice que «Sí... sí, papi... no te preocupes», y [v|aprieta|apretar|ts] [a|fuerte|fuerte|auvnmnnn] su almohadón</aaif:annoText></aaif:Phrase><aaif:Subject rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En1522Ph1Su1"><aaif:text>Hilda</aaif:text><aaif:position rdf:datatype="http://www.w3.org/2001/XMLSchema#int">1</aaif:position><aaif:gender rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Feminine" /><aaif:number rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Singular" /><aaif:overt rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</aaif:overt></aaif:Subject><aaif:Verb rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En1522Ph1Ve1"><aaif:text>aprieta</aaif:text><aaif:lemma rdf:resource="https://gams.uni-graz.at/o:aaif.lemma#apretar" /><aaif:position rdf:datatype="http://www.w3.org/2001/XMLSchema#int">2</aaif:position><aaif:coordinated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:coordinated><aaif:partOfText rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</aaif:partOfText><aaif:syntacticConstruction rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Transitive" /></aaif:Verb><aaif:Adverb rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En1522Ph1Ad1"><aaif:text>fuerte</aaif:text><aaif:lemma rdf:resource="https://gams.uni-graz.at/o:aaif.lemma#fuerte" /><aaif:position rdf:datatype="http://www.w3.org/2001/XMLSchema#int">3</aaif:position><aaif:coordinated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:coordinated><aaif:morphosyntacticStructure rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Adjective" /><aaif:inflection rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Uninflected" /><aaif:attributionTarget rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Verb" /><aaif:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:modified><aaif:semanticClassification rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Manner" /><aaif:reduplicated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:reduplicated><aaif:prepositionalPhrase rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:prepositionalPhrase></aaif:Adverb><aaif:Entry rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En1523"><aaif:phrase rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh#En1523Ph1" /><aaif:source rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh.bibl#Cnde80" /><gams:textualContent>...Nos sentamos frente a los televisores.Vemos The X Files o Stargate o Dark Skies, nos reímos fuerte y largo .A veces, si se comete el error casi imperdonable de mencionar la película E.T., alguien rompe</gams:textualContent><rel:isPartOf rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh" /></aaif:Entry><aaif:Phrase rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En1523Ph1"><aaif:verb rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh#En1523Ph1Ve1" /><aaif:adverb rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh#En1523Ph1Ad1" /><aaif:adverb rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh#En1523Ph1Ad2" /><aaif:text>nos reímos fuerte y largo </aaif:text><aaif:annoText>nos [v|reímos|reír|rs] [a|fuerte|fuerte|auvnmnnC] y [a|largo|largo|auvntnnn] </aaif:annoText></aaif:Phrase><aaif:Verb rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En1523Ph1Ve1"><aaif:text>reímos</aaif:text><aaif:lemma rdf:resource="https://gams.uni-graz.at/o:aaif.lemma#reír" /><aaif:position rdf:datatype="http://www.w3.org/2001/XMLSchema#int">1</aaif:position><aaif:coordinated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:coordinated><aaif:partOfText rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</aaif:partOfText><aaif:syntacticConstruction rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Reflexive" /></aaif:Verb><aaif:Adverb rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En1523Ph1Ad1"><aaif:text>fuerte</aaif:text><aaif:lemma rdf:resource="https://gams.uni-graz.at/o:aaif.lemma#fuerte" /><aaif:position rdf:datatype="http://www.w3.org/2001/XMLSchema#int">2</aaif:position><aaif:coordinated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</aaif:coordinated><aaif:morphosyntacticStructure rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Adjective" /><aaif:inflection rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Uninflected" /><aaif:attributionTarget rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Verb" /><aaif:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:modified><aaif:semanticClassification rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Manner" /><aaif:reduplicated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:reduplicated><aaif:prepositionalPhrase rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:prepositionalPhrase></aaif:Adverb><aaif:Adverb rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En1523Ph1Ad2"><aaif:text>largo</aaif:text><aaif:lemma rdf:resource="https://gams.uni-graz.at/o:aaif.lemma#largo" /><aaif:position rdf:datatype="http://www.w3.org/2001/XMLSchema#int">3</aaif:position><aaif:coordinated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:coordinated><aaif:morphosyntacticStructure rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Adjective" /><aaif:inflection rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Uninflected" /><aaif:attributionTarget rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Verb" /><aaif:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:modified><aaif:semanticClassification rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Time" /><aaif:reduplicated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:reduplicated><aaif:prepositionalPhrase rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:prepositionalPhrase></aaif:Adverb><aaif:Entry rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En1524"><aaif:phrase rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh#En1524Ph1" /><aaif:source rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh.bibl#Cnde80" /><gams:textualContent>que si le habían cobrado más de mil dólares por esas tetas la habían estafado y que se las apreté fuerte para probar su consistencia y que hubo gritos y que me escoltaron a un asiento lejano bajo la mirada aterrorizada</gams:textualContent><rel:isPartOf rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh" /></aaif:Entry><aaif:Phrase rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En1524Ph1"><aaif:verb rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh#En1524Ph1Ve1" /><aaif:adverb rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh#En1524Ph1Ad1" /><aaif:text>se las apreté fuerte para probar su consistencia</aaif:text><aaif:annoText>se las [v|apreté|apretar|ts] [a|fuerte|fuerte|auvnmnnn] para probar su consistencia</aaif:annoText></aaif:Phrase><aaif:Verb rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En1524Ph1Ve1"><aaif:text>apreté</aaif:text><aaif:lemma rdf:resource="https://gams.uni-graz.at/o:aaif.lemma#apretar" /><aaif:position rdf:datatype="http://www.w3.org/2001/XMLSchema#int">1</aaif:position><aaif:coordinated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:coordinated><aaif:partOfText rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</aaif:partOfText><aaif:syntacticConstruction rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Transitive" /></aaif:Verb><aaif:Adverb rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En1524Ph1Ad1"><aaif:text>fuerte</aaif:text><aaif:lemma rdf:resource="https://gams.uni-graz.at/o:aaif.lemma#fuerte" /><aaif:position rdf:datatype="http://www.w3.org/2001/XMLSchema#int">2</aaif:position><aaif:coordinated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:coordinated><aaif:morphosyntacticStructure rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Adjective" /><aaif:inflection rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Uninflected" /><aaif:attributionTarget rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Verb" /><aaif:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:modified><aaif:semanticClassification rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Manner" /><aaif:reduplicated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:reduplicated><aaif:prepositionalPhrase rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:prepositionalPhrase></aaif:Adverb><aaif:Entry rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En1525"><aaif:phrase rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh#En1525Ph1" /><aaif:source rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh.bibl#Cnde81" /><gams:textualContent> Casagrande se rió fuerte :</gams:textualContent><rel:isPartOf rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh" /></aaif:Entry><aaif:Phrase rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En1525Ph1"><aaif:subject rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh#En1525Ph1Su1" /><aaif:verb rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh#En1525Ph1Ve1" /><aaif:adverb rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh#En1525Ph1Ad1" /><aaif:text> Casagrande se rió fuerte </aaif:text><aaif:annoText> [s|Casagrande|ms] se [v|rió|reír|rs] [a|fuerte|fuerte|auvnmnnn] </aaif:annoText></aaif:Phrase><aaif:Subject rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En1525Ph1Su1"><aaif:text>Casagrande</aaif:text><aaif:position rdf:datatype="http://www.w3.org/2001/XMLSchema#int">1</aaif:position><aaif:gender rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Masculine" /><aaif:number rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Singular" /><aaif:overt rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</aaif:overt></aaif:Subject><aaif:Verb rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En1525Ph1Ve1"><aaif:text>rió</aaif:text><aaif:lemma rdf:resource="https://gams.uni-graz.at/o:aaif.lemma#reír" /><aaif:position rdf:datatype="http://www.w3.org/2001/XMLSchema#int">2</aaif:position><aaif:coordinated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:coordinated><aaif:partOfText rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</aaif:partOfText><aaif:syntacticConstruction rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Reflexive" /></aaif:Verb><aaif:Adverb rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En1525Ph1Ad1"><aaif:text>fuerte</aaif:text><aaif:lemma rdf:resource="https://gams.uni-graz.at/o:aaif.lemma#fuerte" /><aaif:position rdf:datatype="http://www.w3.org/2001/XMLSchema#int">3</aaif:position><aaif:coordinated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:coordinated><aaif:morphosyntacticStructure rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Adjective" /><aaif:inflection rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Uninflected" /><aaif:attributionTarget rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Verb" /><aaif:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:modified><aaif:semanticClassification rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Manner" /><aaif:reduplicated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:reduplicated><aaif:prepositionalPhrase rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:prepositionalPhrase></aaif:Adverb><aaif:Entry rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En1526"><aaif:phrase rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh#En1526Ph1" /><aaif:source rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh.bibl#Cnde81" /><gams:textualContent>quedan cuarenta.Y se subió encima de ella, desnudo por completo, la apretó, se la comía,  respiraba  fuerte , se detuvo un segundo, quitó la mano de la desmayada, que se había venido como árbol talado</gams:textualContent><rel:isPartOf rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh" /></aaif:Entry><aaif:Phrase rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En1526Ph1"><aaif:verb rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh#En1526Ph1Ve1" /><aaif:adverb rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh#En1526Ph1Ad1" /><aaif:text> respiraba  fuerte </aaif:text><aaif:annoText> [v|respiraba|respirar|is]  [a|fuerte|fuerte|auvnmnnn] </aaif:annoText></aaif:Phrase><aaif:Verb rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En1526Ph1Ve1"><aaif:text>respiraba</aaif:text><aaif:lemma rdf:resource="https://gams.uni-graz.at/o:aaif.lemma#respirar" /><aaif:position rdf:datatype="http://www.w3.org/2001/XMLSchema#int">1</aaif:position><aaif:coordinated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:coordinated><aaif:partOfText rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</aaif:partOfText><aaif:syntacticConstruction rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Intransitive" /></aaif:Verb><aaif:Adverb rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En1526Ph1Ad1"><aaif:text>fuerte</aaif:text><aaif:lemma rdf:resource="https://gams.uni-graz.at/o:aaif.lemma#fuerte" /><aaif:position rdf:datatype="http://www.w3.org/2001/XMLSchema#int">2</aaif:position><aaif:coordinated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:coordinated><aaif:morphosyntacticStructure rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Adjective" /><aaif:inflection rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Uninflected" /><aaif:attributionTarget rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Verb" /><aaif:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:modified><aaif:semanticClassification rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Manner" /><aaif:reduplicated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:reduplicated><aaif:prepositionalPhrase rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:prepositionalPhrase></aaif:Adverb><aaif:Entry rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En1527"><aaif:phrase rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh#En1527Ph1" /><aaif:source rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh.bibl#Cnde81" /><gams:textualContent>cuerpo actuara con toda naturalidad, sin reprimirlo ni un segundo más.Optó por lo segundo y la abrazó fuerte , se colgó de su cintura y ni una protesta por parte de Andrea, y él apretó, y lo inevitable</gams:textualContent><rel:isPartOf rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh" /></aaif:Entry><aaif:Phrase rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En1527Ph1"><aaif:verb rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh#En1527Ph1Ve1" /><aaif:adverb rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh#En1527Ph1Ad1" /><aaif:text>la abrazó fuerte </aaif:text><aaif:annoText>la [v|abrazó|abrazar|ts] [a|fuerte|fuerte|auvnmnnn] </aaif:annoText></aaif:Phrase><aaif:Verb rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En1527Ph1Ve1"><aaif:text>abrazó</aaif:text><aaif:lemma rdf:resource="https://gams.uni-graz.at/o:aaif.lemma#abrazar" /><aaif:position rdf:datatype="http://www.w3.org/2001/XMLSchema#int">1</aaif:position><aaif:coordinated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:coordinated><aaif:partOfText rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</aaif:partOfText><aaif:syntacticConstruction rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Transitive" /></aaif:Verb><aaif:Adverb rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En1527Ph1Ad1"><aaif:text>fuerte</aaif:text><aaif:lemma rdf:resource="https://gams.uni-graz.at/o:aaif.lemma#fuerte" /><aaif:position rdf:datatype="http://www.w3.org/2001/XMLSchema#int">2</aaif:position><aaif:coordinated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:coordinated><aaif:morphosyntacticStructure rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Adjective" /><aaif:inflection rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Uninflected" /><aaif:attributionTarget rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Verb" /><aaif:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:modified><aaif:semanticClassification rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Manner" /><aaif:reduplicated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:reduplicated><aaif:prepositionalPhrase rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:prepositionalPhrase></aaif:Adverb><aaif:Entry rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En1528"><aaif:phrase rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh#En1528Ph1" /><aaif:source rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh.bibl#Cnde81" /><gams:textualContent>el mundo como un escenario. El escritor colombiano , nihilista de nacimiento, irreverente por vocación, lo abrazó fuerte  mientras reía a carcajadas.</gams:textualContent><rel:isPartOf rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh" /></aaif:Entry><aaif:Phrase rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En1528Ph1"><aaif:subject rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh#En1528Ph1Su1" /><aaif:verb rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh#En1528Ph1Ve1" /><aaif:adverb rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh#En1528Ph1Ad1" /><aaif:text> El escritor colombiano , nihilista de nacimiento, irreverente por vocación, lo abrazó fuerte </aaif:text><aaif:annoText> [s|El escritor colombiano|ms] , nihilista de nacimiento, irreverente por vocación, lo [v|abrazó|abrazar|ts] [a|fuerte|fuerte|auvnmnnn] </aaif:annoText></aaif:Phrase><aaif:Subject rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En1528Ph1Su1"><aaif:text>El escritor colombiano</aaif:text><aaif:position rdf:datatype="http://www.w3.org/2001/XMLSchema#int">1</aaif:position><aaif:gender rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Masculine" /><aaif:number rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Singular" /><aaif:overt rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</aaif:overt></aaif:Subject><aaif:Verb rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En1528Ph1Ve1"><aaif:text>abrazó</aaif:text><aaif:lemma rdf:resource="https://gams.uni-graz.at/o:aaif.lemma#abrazar" /><aaif:position rdf:datatype="http://www.w3.org/2001/XMLSchema#int">2</aaif:position><aaif:coordinated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:coordinated><aaif:partOfText rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</aaif:partOfText><aaif:syntacticConstruction rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Transitive" /></aaif:Verb><aaif:Adverb rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En1528Ph1Ad1"><aaif:text>fuerte</aaif:text><aaif:lemma rdf:resource="https://gams.uni-graz.at/o:aaif.lemma#fuerte" /><aaif:position rdf:datatype="http://www.w3.org/2001/XMLSchema#int">3</aaif:position><aaif:coordinated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:coordinated><aaif:morphosyntacticStructure rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Adjective" /><aaif:inflection rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Uninflected" /><aaif:attributionTarget rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Verb" /><aaif:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:modified><aaif:semanticClassification rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Manner" /><aaif:reduplicated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:reduplicated><aaif:prepositionalPhrase rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:prepositionalPhrase></aaif:Adverb><aaif:Entry rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En1529"><aaif:phrase rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh#En1529Ph1" /><aaif:source rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh.bibl#Cnde106" /><gams:textualContent>Suena el timbre de la puerta de calle.Queda repicando, vibrando fuerte en la ardiente mañana.</gams:textualContent><rel:isPartOf rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh" /></aaif:Entry><aaif:Phrase rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En1529Ph1"><aaif:verb rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh#En1529Ph1Ve1" /><aaif:adverb rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh#En1529Ph1Ad1" /><aaif:text>Queda repicando, vibrando fuerte en la ardiente mañana</aaif:text><aaif:annoText>Queda repicando, [v|vibrando|vibrar|is] [a|fuerte|fuerte|auvnmnnn] en la ardiente mañana</aaif:annoText></aaif:Phrase><aaif:Verb rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En1529Ph1Ve1"><aaif:text>vibrando</aaif:text><aaif:lemma rdf:resource="https://gams.uni-graz.at/o:aaif.lemma#vibrar" /><aaif:position rdf:datatype="http://www.w3.org/2001/XMLSchema#int">1</aaif:position><aaif:coordinated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:coordinated><aaif:partOfText rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</aaif:partOfText><aaif:syntacticConstruction rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Intransitive" /></aaif:Verb><aaif:Adverb rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En1529Ph1Ad1"><aaif:text>fuerte</aaif:text><aaif:lemma rdf:resource="https://gams.uni-graz.at/o:aaif.lemma#fuerte" /><aaif:position rdf:datatype="http://www.w3.org/2001/XMLSchema#int">2</aaif:position><aaif:coordinated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:coordinated><aaif:morphosyntacticStructure rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Adjective" /><aaif:inflection rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Uninflected" /><aaif:attributionTarget rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Verb" /><aaif:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:modified><aaif:semanticClassification rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Manner" /><aaif:reduplicated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:reduplicated><aaif:prepositionalPhrase rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:prepositionalPhrase></aaif:Adverb><aaif:Entry rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En1530"><aaif:phrase rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh#En1530Ph1" /><aaif:source rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh.bibl#Cnde106" /><gams:textualContent>esa escena, ese melodrama, Lucindita —dice, en la puerta del Jaragua.Tiene que hablar fuerte , porque la música que anima el casino de la primera planta apaga su voz—.Le he amargado</gams:textualContent><rel:isPartOf rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh" /></aaif:Entry><aaif:Phrase rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En1530Ph1"><aaif:verb rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh#En1530Ph1Ve1" /><aaif:adverb rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh#En1530Ph1Ad1" /><aaif:text>Tiene que hablar fuerte </aaif:text><aaif:annoText>Tiene que [v|hablar|hablar|is] [a|fuerte|fuerte|auvnmnnn] </aaif:annoText></aaif:Phrase><aaif:Verb rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En1530Ph1Ve1"><aaif:text>hablar</aaif:text><aaif:lemma rdf:resource="https://gams.uni-graz.at/o:aaif.lemma#hablar" /><aaif:position rdf:datatype="http://www.w3.org/2001/XMLSchema#int">1</aaif:position><aaif:coordinated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:coordinated><aaif:partOfText rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</aaif:partOfText><aaif:syntacticConstruction rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Intransitive" /></aaif:Verb><aaif:Adverb rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En1530Ph1Ad1"><aaif:text>fuerte</aaif:text><aaif:lemma rdf:resource="https://gams.uni-graz.at/o:aaif.lemma#fuerte" /><aaif:position rdf:datatype="http://www.w3.org/2001/XMLSchema#int">2</aaif:position><aaif:coordinated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:coordinated><aaif:morphosyntacticStructure rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Adjective" /><aaif:inflection rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Uninflected" /><aaif:attributionTarget rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Verb" /><aaif:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:modified><aaif:semanticClassification rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Manner" /><aaif:reduplicated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:reduplicated><aaif:prepositionalPhrase rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:prepositionalPhrase></aaif:Adverb><aaif:Entry rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En1531"><aaif:phrase rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh#En1531Ph1" /><aaif:source rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh.bibl#Cnde83" /><gams:textualContent>Andrés respondió con más atención y tomó los pechos de la muchacha en las manos.Los empezó a apretar fuerte  mientras ella se rozaba contra él excitándose terriblemente.Tiró la taza de quina al suelo y se encaramó</gams:textualContent><rel:isPartOf rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh" /></aaif:Entry><aaif:Phrase rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En1531Ph1"><aaif:verb rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh#En1531Ph1Ve1" /><aaif:adverb rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh#En1531Ph1Ad1" /><aaif:text>Los empezó a apretar fuerte </aaif:text><aaif:annoText>Los empezó a [v|apretar|apretar|ts] [a|fuerte|fuerte|auvnmnnn] </aaif:annoText></aaif:Phrase><aaif:Verb rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En1531Ph1Ve1"><aaif:text>apretar</aaif:text><aaif:lemma rdf:resource="https://gams.uni-graz.at/o:aaif.lemma#apretar" /><aaif:position rdf:datatype="http://www.w3.org/2001/XMLSchema#int">1</aaif:position><aaif:coordinated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:coordinated><aaif:partOfText rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</aaif:partOfText><aaif:syntacticConstruction rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Transitive" /></aaif:Verb><aaif:Adverb rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En1531Ph1Ad1"><aaif:text>fuerte</aaif:text><aaif:lemma rdf:resource="https://gams.uni-graz.at/o:aaif.lemma#fuerte" /><aaif:position rdf:datatype="http://www.w3.org/2001/XMLSchema#int">2</aaif:position><aaif:coordinated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:coordinated><aaif:morphosyntacticStructure rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Adjective" /><aaif:inflection rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Uninflected" /><aaif:attributionTarget rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Verb" /><aaif:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:modified><aaif:semanticClassification rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Manner" /><aaif:reduplicated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:reduplicated><aaif:prepositionalPhrase rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:prepositionalPhrase></aaif:Adverb><aaif:Entry rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En1532"><aaif:phrase rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh#En1532Ph1" /><aaif:source rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh.bibl#Cnde135" /><gams:textualContent>vida al sacarme del precipicio” Quintín no puede creerlo, mas  el brazo de Calixto lo aprieta fuerte y firmemente.Todos quedan en silencio.Viendo lo que ocurre, el campesino se despide, guiña un ojo</gams:textualContent><rel:isPartOf rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh" /></aaif:Entry><aaif:Phrase rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En1532Ph1"><aaif:subject rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh#En1532Ph1Su1" /><aaif:verb rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh#En1532Ph1Ve1" /><aaif:adverb rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh#En1532Ph1Ad1" /><aaif:text> el brazo de Calixto lo aprieta fuerte y firmemente</aaif:text><aaif:annoText> [s|el brazo de Calixto|ms] lo [v|aprieta|apretar|ts] [a|fuerte|fuerte|auvnmnnC] y firmemente</aaif:annoText></aaif:Phrase><aaif:Subject rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En1532Ph1Su1"><aaif:text>el brazo de Calixto</aaif:text><aaif:position rdf:datatype="http://www.w3.org/2001/XMLSchema#int">1</aaif:position><aaif:gender rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Masculine" /><aaif:number rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Singular" /><aaif:overt rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</aaif:overt></aaif:Subject><aaif:Verb rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En1532Ph1Ve1"><aaif:text>aprieta</aaif:text><aaif:lemma rdf:resource="https://gams.uni-graz.at/o:aaif.lemma#apretar" /><aaif:position rdf:datatype="http://www.w3.org/2001/XMLSchema#int">2</aaif:position><aaif:coordinated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:coordinated><aaif:partOfText rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</aaif:partOfText><aaif:syntacticConstruction rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Transitive" /></aaif:Verb><aaif:Adverb rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En1532Ph1Ad1"><aaif:text>fuerte</aaif:text><aaif:lemma rdf:resource="https://gams.uni-graz.at/o:aaif.lemma#fuerte" /><aaif:position rdf:datatype="http://www.w3.org/2001/XMLSchema#int">3</aaif:position><aaif:coordinated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</aaif:coordinated><aaif:morphosyntacticStructure rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Adjective" /><aaif:inflection rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Uninflected" /><aaif:attributionTarget rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Verb" /><aaif:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:modified><aaif:semanticClassification rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Manner" /><aaif:reduplicated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:reduplicated><aaif:prepositionalPhrase rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:prepositionalPhrase></aaif:Adverb><aaif:Entry rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En1533"><aaif:phrase rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh#En1533Ph1" /><aaif:source rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh.bibl#Cnde19" /><gams:textualContent>se nutre del manjar de los séres inmortales.Contempla hácia el crepúsculo una nubecilla purpurina que se mueve graciosa por el cielo, y se imagina que un Serafín está viajando en ese carro de las Musas: adónde</gams:textualContent><rel:isPartOf rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh" /></aaif:Entry><aaif:Phrase rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En1533Ph1"><aaif:verb rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh#En1533Ph1Ve1" /><aaif:adverb rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh#En1533Ph1Ad1" /><aaif:text>Contempla hácia el crepúsculo una nubecilla purpurina que se mueve graciosa por el cielo</aaif:text><aaif:annoText>Contempla hácia el crepúsculo una nubecilla purpurina que se [v|mueve|mover|rs] [a|graciosa|gracioso|afvnmnnn] por el cielo</aaif:annoText></aaif:Phrase><aaif:Verb rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En1533Ph1Ve1"><aaif:text>mueve</aaif:text><aaif:lemma rdf:resource="https://gams.uni-graz.at/o:aaif.lemma#mover" /><aaif:position rdf:datatype="http://www.w3.org/2001/XMLSchema#int">1</aaif:position><aaif:coordinated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:coordinated><aaif:partOfText rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</aaif:partOfText><aaif:syntacticConstruction rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Reflexive" /></aaif:Verb><aaif:Adverb rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En1533Ph1Ad1"><aaif:text>graciosa</aaif:text><aaif:lemma rdf:resource="https://gams.uni-graz.at/o:aaif.lemma#gracioso" /><aaif:position rdf:datatype="http://www.w3.org/2001/XMLSchema#int">2</aaif:position><aaif:coordinated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:coordinated><aaif:morphosyntacticStructure rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Adjective" /><aaif:inflection rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#FeminineSingular" /><aaif:attributionTarget rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Verb" /><aaif:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:modified><aaif:semanticClassification rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Manner" /><aaif:reduplicated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:reduplicated><aaif:prepositionalPhrase rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:prepositionalPhrase></aaif:Adverb><aaif:Entry rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En1534"><aaif:phrase rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh#En1534Ph1" /><aaif:source rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh.bibl#Cnde6" /><gams:textualContent>, a ver Canou, con brouche de ouro, y ellos jajajajajajajaja, porque también  la Madre Superiora  pronunciaba graciosísimo el castellano, si la oyera la profe, pero ahora todo dependía de Cano y Cano volteó triste donde</gams:textualContent><rel:isPartOf rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh" /></aaif:Entry><aaif:Phrase rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En1534Ph1"><aaif:subject rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh#En1534Ph1Su1" /><aaif:verb rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh#En1534Ph1Ve1" /><aaif:adverb rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh#En1534Ph1Ad1" /><aaif:text> la Madre Superiora  pronunciaba graciosísimo el castellano</aaif:text><aaif:annoText> [s|la Madre Superiora|fs]  [v|pronunciaba|pronunciar|ts] [a|graciosísimo|gracioso|auvnmnnn] el castellano</aaif:annoText></aaif:Phrase><aaif:Subject rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En1534Ph1Su1"><aaif:text>la Madre Superiora</aaif:text><aaif:position rdf:datatype="http://www.w3.org/2001/XMLSchema#int">1</aaif:position><aaif:gender rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Feminine" /><aaif:number rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Singular" /><aaif:overt rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</aaif:overt></aaif:Subject><aaif:Verb rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En1534Ph1Ve1"><aaif:text>pronunciaba</aaif:text><aaif:lemma rdf:resource="https://gams.uni-graz.at/o:aaif.lemma#pronunciar" /><aaif:position rdf:datatype="http://www.w3.org/2001/XMLSchema#int">2</aaif:position><aaif:coordinated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:coordinated><aaif:partOfText rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</aaif:partOfText><aaif:syntacticConstruction rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Transitive" /></aaif:Verb><aaif:Adverb rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En1534Ph1Ad1"><aaif:text>graciosísimo</aaif:text><aaif:lemma rdf:resource="https://gams.uni-graz.at/o:aaif.lemma#gracioso" /><aaif:position rdf:datatype="http://www.w3.org/2001/XMLSchema#int">3</aaif:position><aaif:coordinated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:coordinated><aaif:morphosyntacticStructure rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Adjective" /><aaif:inflection rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Uninflected" /><aaif:attributionTarget rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Verb" /><aaif:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:modified><aaif:semanticClassification rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Manner" /><aaif:reduplicated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:reduplicated><aaif:prepositionalPhrase rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:prepositionalPhrase></aaif:Adverb><aaif:Entry rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En1535"><aaif:phrase rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh#En1535Ph1" /><aaif:source rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh.bibl#Cnde426" /><gams:textualContent>Llegó más amable que otras veces; y aunque no me miraba frente a frente,  su voz  sonaba grave , con cierta amabilidad para conmigo.Yo le manifesté que deseaba, por fin, volver a Londres, que</gams:textualContent><rel:isPartOf rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh" /></aaif:Entry><aaif:Phrase rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En1535Ph1"><aaif:subject rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh#En1535Ph1Su1" /><aaif:verb rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh#En1535Ph1Ve1" /><aaif:adverb rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh#En1535Ph1Ad1" /><aaif:text> su voz  sonaba grave , con cierta amabilidad para conmigo</aaif:text><aaif:annoText> [s|su voz|fs]  [v|sonaba|sonar|is] [a|grave|grave|auvnmnnC] , con cierta amabilidad para conmigo</aaif:annoText></aaif:Phrase><aaif:Subject rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En1535Ph1Su1"><aaif:text>su voz</aaif:text><aaif:position rdf:datatype="http://www.w3.org/2001/XMLSchema#int">1</aaif:position><aaif:gender rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Feminine" /><aaif:number rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Singular" /><aaif:overt rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</aaif:overt></aaif:Subject><aaif:Verb rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En1535Ph1Ve1"><aaif:text>sonaba</aaif:text><aaif:lemma rdf:resource="https://gams.uni-graz.at/o:aaif.lemma#sonar" /><aaif:position rdf:datatype="http://www.w3.org/2001/XMLSchema#int">2</aaif:position><aaif:coordinated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:coordinated><aaif:partOfText rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</aaif:partOfText><aaif:syntacticConstruction rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Intransitive" /></aaif:Verb><aaif:Adverb rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En1535Ph1Ad1"><aaif:text>grave</aaif:text><aaif:lemma rdf:resource="https://gams.uni-graz.at/o:aaif.lemma#grave" /><aaif:position rdf:datatype="http://www.w3.org/2001/XMLSchema#int">3</aaif:position><aaif:coordinated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</aaif:coordinated><aaif:morphosyntacticStructure rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Adjective" /><aaif:inflection rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Uninflected" /><aaif:attributionTarget rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Verb" /><aaif:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:modified><aaif:semanticClassification rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Manner" /><aaif:reduplicated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:reduplicated><aaif:prepositionalPhrase rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:prepositionalPhrase></aaif:Adverb><aaif:Entry rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En1536"><aaif:phrase rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh#En1536Ph1" /><aaif:source rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh.bibl#Cnde426" /><gams:textualContent>mis estudios; que si permanecía más tiempo en aquella casa, me moriría de tristeza... Su voz  resonó grave , con cierta amabilidad para conmigo: </gams:textualContent><rel:isPartOf rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh" /></aaif:Entry><aaif:Phrase rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En1536Ph1"><aaif:subject rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh#En1536Ph1Su1" /><aaif:verb rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh#En1536Ph1Ve1" /><aaif:adverb rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh#En1536Ph1Ad1" /><aaif:text> Su voz  resonó grave , con cierta amabilidad para conmigo:</aaif:text><aaif:annoText> [s|Su voz|fs]  [v|resonó|resonar|is] [a|grave|grave|auvnmnnC] , con cierta amabilidad para conmigo:</aaif:annoText></aaif:Phrase><aaif:Subject rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En1536Ph1Su1"><aaif:text>Su voz</aaif:text><aaif:position rdf:datatype="http://www.w3.org/2001/XMLSchema#int">1</aaif:position><aaif:gender rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Feminine" /><aaif:number rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Singular" /><aaif:overt rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</aaif:overt></aaif:Subject><aaif:Verb rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En1536Ph1Ve1"><aaif:text>resonó</aaif:text><aaif:lemma rdf:resource="https://gams.uni-graz.at/o:aaif.lemma#resonar" /><aaif:position rdf:datatype="http://www.w3.org/2001/XMLSchema#int">2</aaif:position><aaif:coordinated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:coordinated><aaif:partOfText rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</aaif:partOfText><aaif:syntacticConstruction rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Intransitive" /></aaif:Verb><aaif:Adverb rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En1536Ph1Ad1"><aaif:text>grave</aaif:text><aaif:lemma rdf:resource="https://gams.uni-graz.at/o:aaif.lemma#grave" /><aaif:position rdf:datatype="http://www.w3.org/2001/XMLSchema#int">3</aaif:position><aaif:coordinated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</aaif:coordinated><aaif:morphosyntacticStructure rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Adjective" /><aaif:inflection rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Uninflected" /><aaif:attributionTarget rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Verb" /><aaif:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:modified><aaif:semanticClassification rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Manner" /><aaif:reduplicated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:reduplicated><aaif:prepositionalPhrase rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:prepositionalPhrase></aaif:Adverb><aaif:Entry rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En1537"><aaif:phrase rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh#En1537Ph1" /><aaif:source rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh.bibl#Cnde87" /><gams:textualContent>Victoria lo miró perpleja, dejando caer su mandíbula, y Ángel Santiago se humedeció los labios sonrientes y tuvo la certeza de que su suerte se acrecentaba cada vez más en esa pequeña libertad de un día.Su ángel de la guarda había encontrado la ruta de vuelta a casa y le dictaba los pasos que tenía que seguir regalándole una inspiración tras otra.&lt;lb/&gt;— De la Mistral, precisamente — asintió grave  la maestra —.Ella quiere bailar nada menos que Los sonetos de la muerte.</gams:textualContent><rel:isPartOf rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh" /></aaif:Entry><aaif:Phrase rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En1537Ph1"><aaif:subject rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh#En1537Ph1Su1" /><aaif:verb rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh#En1537Ph1Ve1" /><aaif:adverb rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh#En1537Ph1Ad1" /><aaif:text>— De la Mistral, precisamente — asintió grave  la maestra </aaif:text><aaif:annoText>— De la Mistral, precisamente — [v|asintió|asentir|ts] [a|grave|grave|auvnmnnn]  [s|la maestra|fs] </aaif:annoText></aaif:Phrase><aaif:Subject rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En1537Ph1Su1"><aaif:text>la maestra</aaif:text><aaif:position rdf:datatype="http://www.w3.org/2001/XMLSchema#int">3</aaif:position><aaif:gender rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Feminine" /><aaif:number rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Singular" /><aaif:overt rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</aaif:overt></aaif:Subject><aaif:Verb rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En1537Ph1Ve1"><aaif:text>asintió</aaif:text><aaif:lemma rdf:resource="https://gams.uni-graz.at/o:aaif.lemma#asentir" /><aaif:position rdf:datatype="http://www.w3.org/2001/XMLSchema#int">1</aaif:position><aaif:coordinated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:coordinated><aaif:partOfText rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</aaif:partOfText><aaif:syntacticConstruction rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Transitive" /></aaif:Verb><aaif:Adverb rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En1537Ph1Ad1"><aaif:text>grave</aaif:text><aaif:lemma rdf:resource="https://gams.uni-graz.at/o:aaif.lemma#grave" /><aaif:position rdf:datatype="http://www.w3.org/2001/XMLSchema#int">2</aaif:position><aaif:coordinated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:coordinated><aaif:morphosyntacticStructure rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Adjective" /><aaif:inflection rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Uninflected" /><aaif:attributionTarget rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Verb" /><aaif:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:modified><aaif:semanticClassification rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Manner" /><aaif:reduplicated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:reduplicated><aaif:prepositionalPhrase rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:prepositionalPhrase></aaif:Adverb><aaif:Entry rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En1538"><aaif:phrase rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh#En1538Ph1" /><aaif:source rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh.bibl#Cnde106" /><gams:textualContent> La niña  asintió , grave .No se inquietaba, su confianza en él era ilimitada.¿Cómo podía ocurrirle algo malo a un</gams:textualContent><rel:isPartOf rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh" /></aaif:Entry><aaif:Phrase rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En1538Ph1"><aaif:subject rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh#En1538Ph1Su1" /><aaif:verb rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh#En1538Ph1Ve1" /><aaif:adverb rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh#En1538Ph1Ad1" /><aaif:text> La niña  asintió , grave .</aaif:text><aaif:annoText> [s|La niña|fs]  [v|asintió|asentir|is] , [a|grave|grave|auvnmnnn] .</aaif:annoText></aaif:Phrase><aaif:Subject rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En1538Ph1Su1"><aaif:text>La niña</aaif:text><aaif:position rdf:datatype="http://www.w3.org/2001/XMLSchema#int">1</aaif:position><aaif:gender rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Feminine" /><aaif:number rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Singular" /><aaif:overt rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</aaif:overt></aaif:Subject><aaif:Verb rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En1538Ph1Ve1"><aaif:text>asintió</aaif:text><aaif:lemma rdf:resource="https://gams.uni-graz.at/o:aaif.lemma#asentir" /><aaif:position rdf:datatype="http://www.w3.org/2001/XMLSchema#int">2</aaif:position><aaif:coordinated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:coordinated><aaif:partOfText rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</aaif:partOfText><aaif:syntacticConstruction rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Intransitive" /></aaif:Verb><aaif:Adverb rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En1538Ph1Ad1"><aaif:text>grave</aaif:text><aaif:lemma rdf:resource="https://gams.uni-graz.at/o:aaif.lemma#grave" /><aaif:position rdf:datatype="http://www.w3.org/2001/XMLSchema#int">3</aaif:position><aaif:coordinated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:coordinated><aaif:morphosyntacticStructure rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Adjective" /><aaif:inflection rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Uninflected" /><aaif:attributionTarget rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Verb" /><aaif:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:modified><aaif:semanticClassification rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Manner" /><aaif:reduplicated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:reduplicated><aaif:prepositionalPhrase rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:prepositionalPhrase></aaif:Adverb><aaif:Entry rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En1539"><aaif:phrase rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh#En1539Ph1" /><aaif:source rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh.bibl#Cnde268" /><gams:textualContent>— No te encampanes: me quiere a mí —se ufana el viejo, que continúa dirigiéndose a Zambrini—.Así, ¿sabes?, este verano en mi casa, con Hortensia y Brunettino, voy a vivir cada hora mucho más que los milaneses en un año...¡Brunettino!El día que me llame nonno daré la gran fiesta, ¡tengo unas ganas de oírle!...Y está a punto, a punto; aún me dará tiempo antes de la castañada.&lt;lb/&gt;Calla un instante y continúa , grave :&lt;lb/&gt;— Sí, tendré tiempo; en el pueblo se soltará...Y además, después...Después, ya me entiendes, Mauro...</gams:textualContent><rel:isPartOf rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh" /></aaif:Entry><aaif:Phrase rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En1539Ph1"><aaif:verb rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh#En1539Ph1Ve1" /><aaif:adverb rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh#En1539Ph1Ad1" /><aaif:text>Calla un instante y continúa , grave :</aaif:text><aaif:annoText>Calla un instante y [v|continúa|continuar|is] , [a|grave|grave|auvnmnnn] :</aaif:annoText></aaif:Phrase><aaif:Verb rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En1539Ph1Ve1"><aaif:text>continúa</aaif:text><aaif:lemma rdf:resource="https://gams.uni-graz.at/o:aaif.lemma#continuar" /><aaif:position rdf:datatype="http://www.w3.org/2001/XMLSchema#int">1</aaif:position><aaif:coordinated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:coordinated><aaif:partOfText rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</aaif:partOfText><aaif:syntacticConstruction rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Intransitive" /></aaif:Verb><aaif:Adverb rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En1539Ph1Ad1"><aaif:text>grave</aaif:text><aaif:lemma rdf:resource="https://gams.uni-graz.at/o:aaif.lemma#grave" /><aaif:position rdf:datatype="http://www.w3.org/2001/XMLSchema#int">2</aaif:position><aaif:coordinated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:coordinated><aaif:morphosyntacticStructure rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Adjective" /><aaif:inflection rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Uninflected" /><aaif:attributionTarget rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Verb" /><aaif:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:modified><aaif:semanticClassification rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Manner" /><aaif:reduplicated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:reduplicated><aaif:prepositionalPhrase rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:prepositionalPhrase></aaif:Adverb><aaif:Entry rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En1540"><aaif:phrase rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh#En1540Ph1" /><aaif:source rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh.bibl#Cnde6" /><gams:textualContent>— Hay que apuntar siempre a un blanco — dijo , grave .</gams:textualContent><rel:isPartOf rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh" /></aaif:Entry><aaif:Phrase rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En1540Ph1"><aaif:verb rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh#En1540Ph1Ve1" /><aaif:adverb rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh#En1540Ph1Ad1" /><aaif:text>— Hay que apuntar siempre a un blanco — dijo , grave .</aaif:text><aaif:annoText>— Hay que apuntar siempre a un blanco — [v|dijo|decir|ts] , [a|grave|grave|auvnmnnn] .</aaif:annoText></aaif:Phrase><aaif:Verb rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En1540Ph1Ve1"><aaif:text>dijo</aaif:text><aaif:lemma rdf:resource="https://gams.uni-graz.at/o:aaif.lemma#decir" /><aaif:position rdf:datatype="http://www.w3.org/2001/XMLSchema#int">1</aaif:position><aaif:coordinated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:coordinated><aaif:partOfText rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</aaif:partOfText><aaif:syntacticConstruction rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Transitive" /></aaif:Verb><aaif:Adverb rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En1540Ph1Ad1"><aaif:text>grave</aaif:text><aaif:lemma rdf:resource="https://gams.uni-graz.at/o:aaif.lemma#grave" /><aaif:position rdf:datatype="http://www.w3.org/2001/XMLSchema#int">2</aaif:position><aaif:coordinated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:coordinated><aaif:morphosyntacticStructure rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Adjective" /><aaif:inflection rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Uninflected" /><aaif:attributionTarget rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Verb" /><aaif:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:modified><aaif:semanticClassification rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Manner" /><aaif:reduplicated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:reduplicated><aaif:prepositionalPhrase rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:prepositionalPhrase></aaif:Adverb><aaif:Entry rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En1541"><aaif:phrase rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh#En1541Ph1" /><aaif:source rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh.bibl#Cnde403" /><gams:textualContent>Diógenes Laercio hubiese atribuido a su tocayo el del barril. Un lamento armonioso brotó del orinal: alzóse grave y descendió agudo , hasta morir en gotas finales de música.Entonces el filósofo devolvió el utensilio a su</gams:textualContent><rel:isPartOf rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh" /></aaif:Entry><aaif:Phrase rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En1541Ph1"><aaif:subject rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh#En1541Ph1Su1" /><aaif:verb rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh#En1541Ph1Ve1" /><aaif:verb rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh#En1541Ph1Ve2" /><aaif:adverb rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh#En1541Ph1Ad1" /><aaif:adverb rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh#En1541Ph1Ad2" /><aaif:text> Un lamento armonioso brotó del orinal: alzóse grave y descendió agudo </aaif:text><aaif:annoText> [s|Un lamento armonioso|ms] brotó del orinal: [v|alzóse|alzar|rs] [a|grave|grave|auvnmnnn] y [v|descendió|descender|is] [a|agudo|agudo|auvnmnnn] </aaif:annoText></aaif:Phrase><aaif:Subject rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En1541Ph1Su1"><aaif:text>Un lamento armonioso</aaif:text><aaif:position rdf:datatype="http://www.w3.org/2001/XMLSchema#int">1</aaif:position><aaif:gender rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Masculine" /><aaif:number rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Singular" /><aaif:overt rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</aaif:overt></aaif:Subject><aaif:Verb rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En1541Ph1Ve1"><aaif:text>alzóse</aaif:text><aaif:lemma rdf:resource="https://gams.uni-graz.at/o:aaif.lemma#alzar" /><aaif:position rdf:datatype="http://www.w3.org/2001/XMLSchema#int">2</aaif:position><aaif:coordinated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:coordinated><aaif:partOfText rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</aaif:partOfText><aaif:syntacticConstruction rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Reflexive" /></aaif:Verb><aaif:Verb rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En1541Ph1Ve2"><aaif:text>descendió</aaif:text><aaif:lemma rdf:resource="https://gams.uni-graz.at/o:aaif.lemma#descender" /><aaif:position rdf:datatype="http://www.w3.org/2001/XMLSchema#int">4</aaif:position><aaif:coordinated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:coordinated><aaif:partOfText rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</aaif:partOfText><aaif:syntacticConstruction rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Intransitive" /></aaif:Verb><aaif:Adverb rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En1541Ph1Ad1"><aaif:text>grave</aaif:text><aaif:lemma rdf:resource="https://gams.uni-graz.at/o:aaif.lemma#grave" /><aaif:position rdf:datatype="http://www.w3.org/2001/XMLSchema#int">3</aaif:position><aaif:coordinated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:coordinated><aaif:morphosyntacticStructure rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Adjective" /><aaif:inflection rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Uninflected" /><aaif:attributionTarget rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Verb" /><aaif:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:modified><aaif:semanticClassification rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Manner" /><aaif:reduplicated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:reduplicated><aaif:prepositionalPhrase rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:prepositionalPhrase></aaif:Adverb><aaif:Adverb rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En1541Ph1Ad2"><aaif:text>agudo</aaif:text><aaif:lemma rdf:resource="https://gams.uni-graz.at/o:aaif.lemma#agudo" /><aaif:position rdf:datatype="http://www.w3.org/2001/XMLSchema#int">5</aaif:position><aaif:coordinated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:coordinated><aaif:morphosyntacticStructure rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Adjective" /><aaif:inflection rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Uninflected" /><aaif:attributionTarget rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Verb" /><aaif:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:modified><aaif:semanticClassification rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Manner" /><aaif:reduplicated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:reduplicated><aaif:prepositionalPhrase rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:prepositionalPhrase></aaif:Adverb><aaif:Entry rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En1542"><aaif:phrase rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh#En1542Ph1" /><aaif:source rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh.bibl#Cnde427" /><gams:textualContent>Guarnición tosca deste escollo duro &lt;lb/&gt;troncos robustos son, a cuya greña &lt;lb/&gt;menos luz debe, menos aire puro, &lt;lb/&gt;la caverna profunda, que a la peña;&lt;lb/&gt;caliginoso lecho, el seno obscuro &lt;lb/&gt;ser, de la negra noche, nos lo enseña &lt;lb/&gt;infame turba de nocturnas aves, &lt;lb/&gt;gimiendo tristes y volando graves .</gams:textualContent><rel:isPartOf rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh" /></aaif:Entry><aaif:Phrase rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En1542Ph1"><aaif:verb rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh#En1542Ph1Ve1" /><aaif:adverb rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh#En1542Ph1Ad1" /><aaif:text>infame turba de nocturnas aves, &lt;lb\/&gt;gimiendo tristes y volando graves .</aaif:text><aaif:annoText>infame turba de nocturnas aves, &lt;lb\/&gt;gimiendo tristes y [v|volando|volar|is] [a|graves|grave|apsnmnnn] .</aaif:annoText></aaif:Phrase><aaif:Verb rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En1542Ph1Ve1"><aaif:text>volando</aaif:text><aaif:lemma rdf:resource="https://gams.uni-graz.at/o:aaif.lemma#volar" /><aaif:position rdf:datatype="http://www.w3.org/2001/XMLSchema#int">1</aaif:position><aaif:coordinated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:coordinated><aaif:partOfText rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</aaif:partOfText><aaif:syntacticConstruction rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Intransitive" /></aaif:Verb><aaif:Adverb rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En1542Ph1Ad1"><aaif:text>graves</aaif:text><aaif:lemma rdf:resource="https://gams.uni-graz.at/o:aaif.lemma#grave" /><aaif:position rdf:datatype="http://www.w3.org/2001/XMLSchema#int">2</aaif:position><aaif:coordinated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:coordinated><aaif:morphosyntacticStructure rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Adjective" /><aaif:inflection rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#MasculinePlural" /><aaif:attributionTarget rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Verb" /><aaif:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:modified><aaif:semanticClassification rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Manner" /><aaif:reduplicated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:reduplicated><aaif:prepositionalPhrase rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:prepositionalPhrase></aaif:Adverb><aaif:Entry rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En1543"><aaif:phrase rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh#En1543Ph1" /><aaif:source rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh.bibl#Cnde138" /><gams:textualContent>QUE Portugal mire humana &lt;lb/&gt;al Rey que en la tumba yace,&lt;lb/&gt;no es mucho, quando el enlaze&lt;lb/&gt;le hizo ser Padre, y hermano.&lt;lb/&gt;En este concepto sano,&lt;lb/&gt;y en este mar de amargura&lt;lb/&gt;toda su afliccion apura&lt;lb/&gt;para que logre dichoso&lt;lb/&gt;un Rey que fue tan piadoso&lt;lb/&gt;la gloria que siempre dura.</gams:textualContent><rel:isPartOf rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh" /></aaif:Entry><aaif:Phrase rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En1543Ph1"><aaif:subject rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh#En1543Ph1Su1" /><aaif:verb rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh#En1543Ph1Ve1" /><aaif:adverb rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh#En1543Ph1Ad1" /><aaif:text>QUE Portugal mire humana &lt;lb\/&gt;al Rey que en la tumba yace</aaif:text><aaif:annoText>QUE [s|Portugal|ms] [v|mire|mirar|ts] [a|humana|humano|afsnmnnn] &lt;lb\/&gt;al Rey que en la tumba yace</aaif:annoText></aaif:Phrase><aaif:Subject rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En1543Ph1Su1"><aaif:text>Portugal</aaif:text><aaif:position rdf:datatype="http://www.w3.org/2001/XMLSchema#int">1</aaif:position><aaif:gender rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Masculine" /><aaif:number rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Singular" /><aaif:overt rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</aaif:overt></aaif:Subject><aaif:Verb rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En1543Ph1Ve1"><aaif:text>mire</aaif:text><aaif:lemma rdf:resource="https://gams.uni-graz.at/o:aaif.lemma#mirar" /><aaif:position rdf:datatype="http://www.w3.org/2001/XMLSchema#int">2</aaif:position><aaif:coordinated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:coordinated><aaif:partOfText rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</aaif:partOfText><aaif:syntacticConstruction rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Transitive" /></aaif:Verb><aaif:Adverb rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En1543Ph1Ad1"><aaif:text>humana</aaif:text><aaif:lemma rdf:resource="https://gams.uni-graz.at/o:aaif.lemma#humano" /><aaif:position rdf:datatype="http://www.w3.org/2001/XMLSchema#int">3</aaif:position><aaif:coordinated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:coordinated><aaif:morphosyntacticStructure rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Adjective" /><aaif:inflection rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#FeminineSingular" /><aaif:attributionTarget rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Verb" /><aaif:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:modified><aaif:semanticClassification rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Manner" /><aaif:reduplicated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:reduplicated><aaif:prepositionalPhrase rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:prepositionalPhrase></aaif:Adverb><aaif:Entry rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En1544"><aaif:phrase rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh#En1544Ph1" /><aaif:source rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh.bibl#Cnde316" /><gams:textualContent>criado de casa,&lt;lb/&gt;y que el señor gusta desso.&lt;lb/&gt;Vestireys a vuestro gusto,&lt;lb/&gt;si en vestir justo consiste,&lt;lb/&gt;porque el oficial que os viste&lt;lb/&gt;jamas vistio sino al justo.&lt;lb/&gt;El mismo os viste que</gams:textualContent><rel:isPartOf rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh" /></aaif:Entry><aaif:Phrase rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En1544Ph1"><aaif:verb rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh#En1544Ph1Ve1" /><aaif:adverb rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh#En1544Ph1Ad1" /><aaif:text>si en vestir justo consiste</aaif:text><aaif:annoText>si en [v|vestir|vestir|is] [a|justo|justo|auonmnnn] consiste</aaif:annoText></aaif:Phrase><aaif:Verb rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En1544Ph1Ve1"><aaif:text>vestir</aaif:text><aaif:lemma rdf:resource="https://gams.uni-graz.at/o:aaif.lemma#vestir" /><aaif:position rdf:datatype="http://www.w3.org/2001/XMLSchema#int">1</aaif:position><aaif:coordinated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:coordinated><aaif:partOfText rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</aaif:partOfText><aaif:syntacticConstruction rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Intransitive" /></aaif:Verb><aaif:Adverb rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En1544Ph1Ad1"><aaif:text>justo</aaif:text><aaif:lemma rdf:resource="https://gams.uni-graz.at/o:aaif.lemma#justo" /><aaif:position rdf:datatype="http://www.w3.org/2001/XMLSchema#int">2</aaif:position><aaif:coordinated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:coordinated><aaif:morphosyntacticStructure rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Adjective" /><aaif:inflection rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Uninflected" /><aaif:attributionTarget rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#VerbObject" /><aaif:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:modified><aaif:semanticClassification rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Manner" /><aaif:reduplicated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:reduplicated><aaif:prepositionalPhrase rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:prepositionalPhrase></aaif:Adverb><aaif:Entry rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En1545"><aaif:phrase rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh#En1545Ph1" /><aaif:source rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh.bibl#Cnde428" /><gams:textualContent>quita de encima,&lt;lb/&gt;el Estambre se descubre,&lt;lb/&gt;de su color desdezia.&lt;lb/&gt;No se, que es vestirme justo ,&lt;lb/&gt;ni que es Sarzo ni que es Lima,&lt;lb/&gt;la Zayna manca de cobas:&lt;lb/&gt;ya Granos ni Quinas</gams:textualContent><rel:isPartOf rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh" /></aaif:Entry><aaif:Phrase rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En1545Ph1"><aaif:verb rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh#En1545Ph1Ve1" /><aaif:adverb rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh#En1545Ph1Ad1" /><aaif:text>No se, que es vestirme justo ,</aaif:text><aaif:annoText>No se, que es [v|vestirme|vestir|rs] [a|justo|justo|auonmnnn] ,</aaif:annoText></aaif:Phrase><aaif:Verb rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En1545Ph1Ve1"><aaif:text>vestirme</aaif:text><aaif:lemma rdf:resource="https://gams.uni-graz.at/o:aaif.lemma#vestir" /><aaif:position rdf:datatype="http://www.w3.org/2001/XMLSchema#int">1</aaif:position><aaif:coordinated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:coordinated><aaif:partOfText rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</aaif:partOfText><aaif:syntacticConstruction rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Reflexive" /></aaif:Verb><aaif:Adverb rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En1545Ph1Ad1"><aaif:text>justo</aaif:text><aaif:lemma rdf:resource="https://gams.uni-graz.at/o:aaif.lemma#justo" /><aaif:position rdf:datatype="http://www.w3.org/2001/XMLSchema#int">2</aaif:position><aaif:coordinated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:coordinated><aaif:morphosyntacticStructure rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Adjective" /><aaif:inflection rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Uninflected" /><aaif:attributionTarget rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#VerbObject" /><aaif:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:modified><aaif:semanticClassification rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Manner" /><aaif:reduplicated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:reduplicated><aaif:prepositionalPhrase rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:prepositionalPhrase></aaif:Adverb><aaif:Entry rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En1546"><aaif:phrase rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh#En1546Ph1" /><aaif:source rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh.bibl#Cnde428" /><gams:textualContent>le dize a Catalina.&lt;lb/&gt;Poco grano, y mucho Viento&lt;lb/&gt;derribara nuestra Espiga.&lt;lb/&gt;No quiero, que vistas justo ,&lt;lb/&gt;ni yo verme en agonia:&lt;lb/&gt;Antes quiero picolcayre:&lt;lb/&gt;que verte passar cruxia,&lt;lb/&gt;esto garla, y</gams:textualContent><rel:isPartOf rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh" /></aaif:Entry><aaif:Phrase rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En1546Ph1"><aaif:verb rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh#En1546Ph1Ve1" /><aaif:adverb rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh#En1546Ph1Ad1" /><aaif:text>No quiero, que vistas justo ,</aaif:text><aaif:annoText>No quiero, que [v|vistas|vestir|is] [a|justo|justo|auonmnnn] ,</aaif:annoText></aaif:Phrase><aaif:Verb rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En1546Ph1Ve1"><aaif:text>vistas</aaif:text><aaif:lemma rdf:resource="https://gams.uni-graz.at/o:aaif.lemma#vestir" /><aaif:position rdf:datatype="http://www.w3.org/2001/XMLSchema#int">1</aaif:position><aaif:coordinated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:coordinated><aaif:partOfText rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</aaif:partOfText><aaif:syntacticConstruction rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Intransitive" /></aaif:Verb><aaif:Adverb rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En1546Ph1Ad1"><aaif:text>justo</aaif:text><aaif:lemma rdf:resource="https://gams.uni-graz.at/o:aaif.lemma#justo" /><aaif:position rdf:datatype="http://www.w3.org/2001/XMLSchema#int">2</aaif:position><aaif:coordinated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:coordinated><aaif:morphosyntacticStructure rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Adjective" /><aaif:inflection rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Uninflected" /><aaif:attributionTarget rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#VerbObject" /><aaif:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:modified><aaif:semanticClassification rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Manner" /><aaif:reduplicated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:reduplicated><aaif:prepositionalPhrase rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:prepositionalPhrase></aaif:Adverb><aaif:Entry rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En1547"><aaif:phrase rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh#En1547Ph1" /><aaif:source rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh.bibl#Cnde430" /><gams:textualContent>, haciendo vuestras vidas y vuestras almas alimento de su desorden.¿Ahora había yo de volver a calzar justo y andar mirándome a la sombra, trotando con los ojos las azuteas y los terrados, suspirando de noche, </gams:textualContent><rel:isPartOf rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh" /></aaif:Entry><aaif:Phrase rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En1547Ph1"><aaif:verb rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh#En1547Ph1Ve1" /><aaif:adverb rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh#En1547Ph1Ad1" /><aaif:text>Ahora había yo de volver a calzar justo y andar mirándome a la sombra</aaif:text><aaif:annoText>Ahora había yo de volver a [v|calzar|calzar|is] [a|justo|justo|auonmnnn] y andar mirándome a la sombra</aaif:annoText></aaif:Phrase><aaif:Verb rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En1547Ph1Ve1"><aaif:text>calzar</aaif:text><aaif:lemma rdf:resource="https://gams.uni-graz.at/o:aaif.lemma#calzar" /><aaif:position rdf:datatype="http://www.w3.org/2001/XMLSchema#int">1</aaif:position><aaif:coordinated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:coordinated><aaif:partOfText rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</aaif:partOfText><aaif:syntacticConstruction rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Intransitive" /></aaif:Verb><aaif:Adverb rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En1547Ph1Ad1"><aaif:text>justo</aaif:text><aaif:lemma rdf:resource="https://gams.uni-graz.at/o:aaif.lemma#justo" /><aaif:position rdf:datatype="http://www.w3.org/2001/XMLSchema#int">2</aaif:position><aaif:coordinated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:coordinated><aaif:morphosyntacticStructure rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Adjective" /><aaif:inflection rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Uninflected" /><aaif:attributionTarget rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#VerbObject" /><aaif:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:modified><aaif:semanticClassification rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Manner" /><aaif:reduplicated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:reduplicated><aaif:prepositionalPhrase rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:prepositionalPhrase></aaif:Adverb><aaif:Entry rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En1548"><aaif:phrase rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh#En1548Ph1" /><aaif:source rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh.bibl#Cnde431" /><gams:textualContent>«Si yo no tengo razón&lt;lb/&gt;—prosiguió— de estar quejoso,&lt;lb/&gt;cuando de esta vida vaya,&lt;lb/&gt;no halle vida de retorno.&lt;lb/&gt;Han dado aquestos poetas&lt;lb/&gt;en perseguirme, de modo que&lt;lb/&gt;me he de perder con ellos&lt;lb/&gt;de cuantas veces me cobro.&lt;lb/&gt;Cuanto hay comparan conmigo,&lt;lb/&gt;y es un caso muy penoso&lt;lb/&gt;que yo sea sólo en el mundo&lt;lb/&gt;y a mí me lo mandan todo:&lt;lb/&gt;Fénix es quien muere justo , &lt;lb/&gt;y Fénix quien vive docto,&lt;lb/&gt;Fénix, la beldad de Lisi,&lt;lb/&gt;y Fénix quien mata un toro.&lt;lb/&gt;Nadie de fénix se libra.&lt;lb/&gt;Mira, hombre perezoso,&lt;lb/&gt;que has de convertirte en Fénix,&lt;lb/&gt;no estés a la virtud sordo.&lt;lb/&gt;Llamó al espárrago Fénix&lt;lb/&gt;un poeta, día estotro,&lt;lb/&gt;y, con mayor insolencia,&lt;lb/&gt;Fénix al diez de los bolos.&lt;lb/&gt;¿Soy yo, acaso, algún quemado?&lt;lb/&gt;¿No soy de solar famoso, </gams:textualContent><rel:isPartOf rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh" /></aaif:Entry><aaif:Phrase rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En1548Ph1"><aaif:subject rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh#En1548Ph1Su1" /><aaif:verb rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh#En1548Ph1Ve1" /><aaif:adverb rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh#En1548Ph1Ad1" /><aaif:text>Fénix es quien muere justo , &lt;lb\/&gt;y Fénix quien vive docto</aaif:text><aaif:annoText>Fénix es [s|quien|ms] [v|muere|morir|is] [a|justo|justo|ausnmnnn] , &lt;lb\/&gt;y Fénix quien vive docto</aaif:annoText></aaif:Phrase><aaif:Subject rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En1548Ph1Su1"><aaif:text>quien</aaif:text><aaif:position rdf:datatype="http://www.w3.org/2001/XMLSchema#int">1</aaif:position><aaif:gender rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Masculine" /><aaif:number rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Singular" /><aaif:overt rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</aaif:overt></aaif:Subject><aaif:Verb rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En1548Ph1Ve1"><aaif:text>muere</aaif:text><aaif:lemma rdf:resource="https://gams.uni-graz.at/o:aaif.lemma#morir" /><aaif:position rdf:datatype="http://www.w3.org/2001/XMLSchema#int">2</aaif:position><aaif:coordinated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:coordinated><aaif:partOfText rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</aaif:partOfText><aaif:syntacticConstruction rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Intransitive" /></aaif:Verb><aaif:Adverb rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En1548Ph1Ad1"><aaif:text>justo</aaif:text><aaif:lemma rdf:resource="https://gams.uni-graz.at/o:aaif.lemma#justo" /><aaif:position rdf:datatype="http://www.w3.org/2001/XMLSchema#int">3</aaif:position><aaif:coordinated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:coordinated><aaif:morphosyntacticStructure rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Adjective" /><aaif:inflection rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Uninflected" /><aaif:attributionTarget rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Verb" /><aaif:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:modified><aaif:semanticClassification rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Manner" /><aaif:reduplicated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:reduplicated><aaif:prepositionalPhrase rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:prepositionalPhrase></aaif:Adverb><aaif:Entry rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En1549"><aaif:phrase rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh#En1549Ph1" /><aaif:source rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh.bibl#Cnde432" /><gams:textualContent>legado Publio Silio, i de otros i aún más adelante estuvieron libres de latrocinios. La cuenta de Patérculo  viene justa , porque aviendo sido cónsules Marco Vinicio Quartino i Cayo Cassío Longino en el año de la fundación de Roma DCCLXXXIII, si quitamos</gams:textualContent><rel:isPartOf rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh" /></aaif:Entry><aaif:Phrase rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En1549Ph1"><aaif:subject rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh#En1549Ph1Su1" /><aaif:verb rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh#En1549Ph1Ve1" /><aaif:adverb rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh#En1549Ph1Ad1" /><aaif:text> La cuenta de Patérculo  viene justa </aaif:text><aaif:annoText> [s|La cuenta de Patérculo|fs]  [v|viene|venir|is] [a|justa|justo|afsnmnnn] </aaif:annoText></aaif:Phrase><aaif:Subject rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En1549Ph1Su1"><aaif:text>La cuenta de Patérculo</aaif:text><aaif:position rdf:datatype="http://www.w3.org/2001/XMLSchema#int">1</aaif:position><aaif:gender rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Feminine" /><aaif:number rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Singular" /><aaif:overt rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</aaif:overt></aaif:Subject><aaif:Verb rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En1549Ph1Ve1"><aaif:text>viene</aaif:text><aaif:lemma rdf:resource="https://gams.uni-graz.at/o:aaif.lemma#venir" /><aaif:position rdf:datatype="http://www.w3.org/2001/XMLSchema#int">2</aaif:position><aaif:coordinated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:coordinated><aaif:partOfText rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</aaif:partOfText><aaif:syntacticConstruction rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Intransitive" /></aaif:Verb><aaif:Adverb rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En1549Ph1Ad1"><aaif:text>justa</aaif:text><aaif:lemma rdf:resource="https://gams.uni-graz.at/o:aaif.lemma#justo" /><aaif:position rdf:datatype="http://www.w3.org/2001/XMLSchema#int">3</aaif:position><aaif:coordinated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:coordinated><aaif:morphosyntacticStructure rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Adjective" /><aaif:inflection rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#FeminineSingular" /><aaif:attributionTarget rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Verb" /><aaif:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:modified><aaif:semanticClassification rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Manner" /><aaif:reduplicated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:reduplicated><aaif:prepositionalPhrase rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:prepositionalPhrase></aaif:Adverb><aaif:Entry rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En1550"><aaif:phrase rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh#En1550Ph1" /><aaif:source rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh.bibl#Cnde433" /><gams:textualContent>y gruesa, atada con ayuda de dos nudos corredizos y que había servido para bajar el cajón: cabía justito  éste ;luego las palas el hoyo que habían cavado y que se iba ahora rellenando.Habría querido tener</gams:textualContent><rel:isPartOf rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh" /></aaif:Entry><aaif:Phrase rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En1550Ph1"><aaif:subject rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh#En1550Ph1Su1" /><aaif:verb rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh#En1550Ph1Ve1" /><aaif:adverb rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh#En1550Ph1Ad1" /><aaif:text>dos nudos corredizos y que había servido para bajar el cajón: cabía justito  éste </aaif:text><aaif:annoText>dos nudos corredizos y que había servido para bajar el cajón: [v|cabía|caber|is] [a|justito|justo|ausnlnnn]  [s|éste|ms] </aaif:annoText></aaif:Phrase><aaif:Subject rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En1550Ph1Su1"><aaif:text>éste</aaif:text><aaif:position rdf:datatype="http://www.w3.org/2001/XMLSchema#int">3</aaif:position><aaif:gender rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Masculine" /><aaif:number rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Singular" /><aaif:overt rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</aaif:overt></aaif:Subject><aaif:Verb rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En1550Ph1Ve1"><aaif:text>cabía</aaif:text><aaif:lemma rdf:resource="https://gams.uni-graz.at/o:aaif.lemma#caber" /><aaif:position rdf:datatype="http://www.w3.org/2001/XMLSchema#int">1</aaif:position><aaif:coordinated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:coordinated><aaif:partOfText rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</aaif:partOfText><aaif:syntacticConstruction rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Intransitive" /></aaif:Verb><aaif:Adverb rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En1550Ph1Ad1"><aaif:text>justito</aaif:text><aaif:lemma rdf:resource="https://gams.uni-graz.at/o:aaif.lemma#justo" /><aaif:position rdf:datatype="http://www.w3.org/2001/XMLSchema#int">2</aaif:position><aaif:coordinated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:coordinated><aaif:morphosyntacticStructure rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Adjective" /><aaif:inflection rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Uninflected" /><aaif:attributionTarget rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Verb" /><aaif:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:modified><aaif:semanticClassification rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Location" /><aaif:reduplicated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:reduplicated><aaif:prepositionalPhrase rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:prepositionalPhrase></aaif:Adverb><aaif:Entry rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En1551"><aaif:phrase rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh#En1551Ph1" /><aaif:source rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh.bibl#Cnde400" /><gams:textualContent>éste y la diestra péndula, sin la más leve vibración de nervios, ya con el hueco donde cabría justa  la empuñadura del revólver al cinto , Marcos Vargas no perdía de vista las manos del asesino ambidextro</gams:textualContent><rel:isPartOf rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh" /></aaif:Entry><aaif:Phrase rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En1551Ph1"><aaif:subject rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh#En1551Ph1Su1" /><aaif:verb rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh#En1551Ph1Ve1" /><aaif:adverb rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh#En1551Ph1Ad1" /><aaif:text>el hueco donde cabría justa  la empuñadura del revólver al cinto </aaif:text><aaif:annoText>el hueco donde [v|cabría|caber|is] [a|justa|justo|afsnlnnn]  [s|la empuñadura del revólver al cinto|fs] </aaif:annoText></aaif:Phrase><aaif:Subject rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En1551Ph1Su1"><aaif:text>la empuñadura del revólver al cinto</aaif:text><aaif:position rdf:datatype="http://www.w3.org/2001/XMLSchema#int">3</aaif:position><aaif:gender rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Feminine" /><aaif:number rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Singular" /><aaif:overt rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</aaif:overt></aaif:Subject><aaif:Verb rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En1551Ph1Ve1"><aaif:text>cabría</aaif:text><aaif:lemma rdf:resource="https://gams.uni-graz.at/o:aaif.lemma#caber" /><aaif:position rdf:datatype="http://www.w3.org/2001/XMLSchema#int">1</aaif:position><aaif:coordinated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:coordinated><aaif:partOfText rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</aaif:partOfText><aaif:syntacticConstruction rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Intransitive" /></aaif:Verb><aaif:Adverb rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En1551Ph1Ad1"><aaif:text>justa</aaif:text><aaif:lemma rdf:resource="https://gams.uni-graz.at/o:aaif.lemma#justo" /><aaif:position rdf:datatype="http://www.w3.org/2001/XMLSchema#int">2</aaif:position><aaif:coordinated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:coordinated><aaif:morphosyntacticStructure rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Adjective" /><aaif:inflection rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#FeminineSingular" /><aaif:attributionTarget rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Verb" /><aaif:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:modified><aaif:semanticClassification rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Location" /><aaif:reduplicated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:reduplicated><aaif:prepositionalPhrase rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:prepositionalPhrase></aaif:Adverb><aaif:Entry rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En1552"><aaif:phrase rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh#En1552Ph1" /><aaif:source rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh.bibl#Cnde116" /><gams:textualContent>Pobre rubio, lindo pibe.Me daba no sé qué cuando nos saludamos, el tipo chamuyó una cosa que andá a entendéle, y parecía que te iba a salir a pelear con galera.El patrón no te vayás a creer que estaba muy tranquilo, te puedo decir que él nunca se daba cuenta de cómo yo lo palpitaba.Pobre trompa, se creía que no me daba cuenta.Che, y el príncipe ahí abajo, eso fue grande, a la primera finta que me hace el rubio le largo la derecha en gancho y se la meto justo justo.Te juro que me quedé frío cuando lo vi patas arriba.Qué manera de dormir, pobre tipo .Esa vez no me dio gusto ganar, más lindo hubiera sido una linda agarrada, cuatro o cinco vueltas como con el Tani o con el yoni aquel, Herman se llamaba, uno que venía con un auto colorado y una pinta bárbara.Cobró, pero fue lindo.Qué leñada, mama mía.No quería aflojar y tenía más mañas que...Ahora que para mañas el Brujo, che.De dónde me lo fueron a sacar a ése.Era uruguayo, sabés, ya estaba acabado pero era peor que los otros, se te pegaba como sanguijuela y andá sacártelo de encima.Meta forcejeo, y el tipo con el guante por los ojos, pucha me daba una bronca.Al final lo fajé feo, me dejó un claro y lo entré con unas ganas...Muñeco al suelo, pibe.Muñeco al suelo fastrás...</gams:textualContent><rel:isPartOf rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh" /></aaif:Entry><aaif:Phrase rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En1552Ph1"><aaif:verb rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh#En1552Ph1Ve1" /><aaif:adverb rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh#En1552Ph1Ad1" /><aaif:text>le largo la derecha en gancho y se la meto justo justo.</aaif:text><aaif:annoText>le largo la derecha en gancho y se la [v|meto|meter|ts] [a|justo|justo|auvnlrnn] justo.</aaif:annoText></aaif:Phrase><aaif:Verb rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En1552Ph1Ve1"><aaif:text>meto</aaif:text><aaif:lemma rdf:resource="https://gams.uni-graz.at/o:aaif.lemma#meter" /><aaif:position rdf:datatype="http://www.w3.org/2001/XMLSchema#int">1</aaif:position><aaif:coordinated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:coordinated><aaif:partOfText rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</aaif:partOfText><aaif:syntacticConstruction rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Transitive" /></aaif:Verb><aaif:Adverb rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En1552Ph1Ad1"><aaif:text>justo</aaif:text><aaif:lemma rdf:resource="https://gams.uni-graz.at/o:aaif.lemma#justo" /><aaif:position rdf:datatype="http://www.w3.org/2001/XMLSchema#int">2</aaif:position><aaif:coordinated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:coordinated><aaif:morphosyntacticStructure rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Adjective" /><aaif:inflection rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Uninflected" /><aaif:attributionTarget rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Verb" /><aaif:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:modified><aaif:semanticClassification rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Location" /><aaif:reduplicated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</aaif:reduplicated><aaif:prepositionalPhrase rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:prepositionalPhrase></aaif:Adverb><aaif:Entry rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En1553"><aaif:phrase rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh#En1553Ph1" /><aaif:source rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh.bibl#Cnde51" /><gams:textualContent>— Llegas  justo —dijo Molly—.Necesitábamos un hombre para el paseo a Chosica.Ahora estamos completos, ocho parejas</gams:textualContent><rel:isPartOf rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh" /></aaif:Entry><aaif:Phrase rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En1553Ph1"><aaif:verb rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh#En1553Ph1Ve1" /><aaif:adverb rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh#En1553Ph1Ad1" /><aaif:text>— Llegas  justo —dijo Molly</aaif:text><aaif:annoText>— [v|Llegas|llegar|is]  [a|justo|justo|auvntnnn] —dijo Molly</aaif:annoText></aaif:Phrase><aaif:Verb rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En1553Ph1Ve1"><aaif:text>Llegas</aaif:text><aaif:lemma rdf:resource="https://gams.uni-graz.at/o:aaif.lemma#llegar" /><aaif:position rdf:datatype="http://www.w3.org/2001/XMLSchema#int">1</aaif:position><aaif:coordinated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:coordinated><aaif:partOfText rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</aaif:partOfText><aaif:syntacticConstruction rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Intransitive" /></aaif:Verb><aaif:Adverb rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En1553Ph1Ad1"><aaif:text>justo</aaif:text><aaif:lemma rdf:resource="https://gams.uni-graz.at/o:aaif.lemma#justo" /><aaif:position rdf:datatype="http://www.w3.org/2001/XMLSchema#int">2</aaif:position><aaif:coordinated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:coordinated><aaif:morphosyntacticStructure rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Adjective" /><aaif:inflection rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Uninflected" /><aaif:attributionTarget rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Verb" /><aaif:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:modified><aaif:semanticClassification rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Time" /><aaif:reduplicated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:reduplicated><aaif:prepositionalPhrase rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:prepositionalPhrase></aaif:Adverb><aaif:Entry rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En1554"><aaif:phrase rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh#En1554Ph1" /><aaif:source rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh.bibl#Cnde434" /><gams:textualContent>Si salíamos a las cinco en punto y corríamos por la avenida Pardo como alma que lleva el diablo,  alcanzaban  justito la salida de las chicas del Colegio La Reparación.Nos parábamos en la esquina y fíjate, ahí</gams:textualContent><rel:isPartOf rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh" /></aaif:Entry><aaif:Phrase rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En1554Ph1"><aaif:verb rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh#En1554Ph1Ve1" /><aaif:adverb rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh#En1554Ph1Ad1" /><aaif:text> alcanzaban  justito la salida de las chicas del Colegio</aaif:text><aaif:annoText> [v|alcanzaban|alcanzar|ts]  [a|justito|justo|auvntnnn] la salida de las chicas del Colegio</aaif:annoText></aaif:Phrase><aaif:Verb rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En1554Ph1Ve1"><aaif:text>alcanzaban</aaif:text><aaif:lemma rdf:resource="https://gams.uni-graz.at/o:aaif.lemma#alcanzar" /><aaif:position rdf:datatype="http://www.w3.org/2001/XMLSchema#int">1</aaif:position><aaif:coordinated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:coordinated><aaif:partOfText rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</aaif:partOfText><aaif:syntacticConstruction rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Transitive" /></aaif:Verb><aaif:Adverb rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En1554Ph1Ad1"><aaif:text>justito</aaif:text><aaif:lemma rdf:resource="https://gams.uni-graz.at/o:aaif.lemma#justo" /><aaif:position rdf:datatype="http://www.w3.org/2001/XMLSchema#int">2</aaif:position><aaif:coordinated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:coordinated><aaif:morphosyntacticStructure rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Adjective" /><aaif:inflection rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Uninflected" /><aaif:attributionTarget rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Verb" /><aaif:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:modified><aaif:semanticClassification rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Time" /><aaif:reduplicated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:reduplicated><aaif:prepositionalPhrase rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:prepositionalPhrase></aaif:Adverb><aaif:Entry rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En1555"><aaif:phrase rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh#En1555Ph1" /><aaif:source rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh.bibl#Cnde58" /><gams:textualContent>— Verás...Son las nueve y yo te llamaba, porque he tenido la idea de no ir a la oficina —con su endiablada agilidad de muchacha, ejecutó unos saltos, de rodillas—.Siempre que me ayudes —la mantuve quieta a diez centímetros de distancia—.Hace una eternidad que no estoy enfermo.Oficialmente.Como hoy es viernes, puedo concederme un largo fin de semana.Para lo que me pagan...&lt;lb/&gt;— Has de abandonar ese empleo, si no pagan justo .&lt;lb/&gt;— Y, encima, pretenden que trabaje y que trabaje cuidadosamente.Ayer mismo...Bueno, no quiero aburrirte con historias de oficina.Se trata de que tú...</gams:textualContent><rel:isPartOf rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh" /></aaif:Entry><aaif:Phrase rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En1555Ph1"><aaif:verb rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh#En1555Ph1Ve1" /><aaif:adverb rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh#En1555Ph1Ad1" /><aaif:text>Has de abandonar ese empleo, si no pagan justo .</aaif:text><aaif:annoText>Has de abandonar ese empleo, si no [v|pagan|pagar|is] [a|justo|justo|auvnmnnn] .</aaif:annoText></aaif:Phrase><aaif:Verb rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En1555Ph1Ve1"><aaif:text>pagan</aaif:text><aaif:lemma rdf:resource="https://gams.uni-graz.at/o:aaif.lemma#pagar" /><aaif:position rdf:datatype="http://www.w3.org/2001/XMLSchema#int">1</aaif:position><aaif:coordinated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:coordinated><aaif:partOfText rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</aaif:partOfText><aaif:syntacticConstruction rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Intransitive" /></aaif:Verb><aaif:Adverb rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En1555Ph1Ad1"><aaif:text>justo</aaif:text><aaif:lemma rdf:resource="https://gams.uni-graz.at/o:aaif.lemma#justo" /><aaif:position rdf:datatype="http://www.w3.org/2001/XMLSchema#int">2</aaif:position><aaif:coordinated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:coordinated><aaif:morphosyntacticStructure rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Adjective" /><aaif:inflection rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Uninflected" /><aaif:attributionTarget rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Verb" /><aaif:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:modified><aaif:semanticClassification rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Manner" /><aaif:reduplicated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:reduplicated><aaif:prepositionalPhrase rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:prepositionalPhrase></aaif:Adverb><aaif:Entry rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En1556"><aaif:phrase rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh#En1556Ph1" /><aaif:source rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh.bibl#Cnde280" /><gams:textualContent>al cariño de vuestro agrado, o a la violenta afición de vuestra sangre?Podeis querer mas vivir pobres , y justos ; que ricos con injusticia?Podeis servir puestos con trabajos mas que serviros del puesto</gams:textualContent><rel:isPartOf rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh" /></aaif:Entry><aaif:Phrase rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En1556Ph1"><aaif:verb rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh#En1556Ph1Ve1" /><aaif:adverb rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh#En1556Ph1Ad1" /><aaif:adverb rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh#En1556Ph1Ad2" /><aaif:text>Podeis querer mas vivir pobres , y justos ; que ricos con injusticia</aaif:text><aaif:annoText>Podeis querer mas [v|vivir|vivir|is] [a|pobres|pobre|apsnmnnC] , y [a|justos|justo|apsnmnnC] ; que ricos con injusticia</aaif:annoText></aaif:Phrase><aaif:Verb rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En1556Ph1Ve1"><aaif:text>vivir</aaif:text><aaif:lemma rdf:resource="https://gams.uni-graz.at/o:aaif.lemma#vivir" /><aaif:position rdf:datatype="http://www.w3.org/2001/XMLSchema#int">1</aaif:position><aaif:coordinated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:coordinated><aaif:partOfText rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</aaif:partOfText><aaif:syntacticConstruction rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Intransitive" /></aaif:Verb><aaif:Adverb rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En1556Ph1Ad1"><aaif:text>pobres</aaif:text><aaif:lemma rdf:resource="https://gams.uni-graz.at/o:aaif.lemma#pobre" /><aaif:position rdf:datatype="http://www.w3.org/2001/XMLSchema#int">2</aaif:position><aaif:coordinated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</aaif:coordinated><aaif:morphosyntacticStructure rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Adjective" /><aaif:inflection rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#MasculinePlural" /><aaif:attributionTarget rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Verb" /><aaif:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:modified><aaif:semanticClassification rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Manner" /><aaif:reduplicated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:reduplicated><aaif:prepositionalPhrase rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:prepositionalPhrase></aaif:Adverb><aaif:Adverb rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En1556Ph1Ad2"><aaif:text>justos</aaif:text><aaif:lemma rdf:resource="https://gams.uni-graz.at/o:aaif.lemma#justo" /><aaif:position rdf:datatype="http://www.w3.org/2001/XMLSchema#int">3</aaif:position><aaif:coordinated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</aaif:coordinated><aaif:morphosyntacticStructure rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Adjective" /><aaif:inflection rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#MasculinePlural" /><aaif:attributionTarget rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Verb" /><aaif:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:modified><aaif:semanticClassification rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Manner" /><aaif:reduplicated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:reduplicated><aaif:prepositionalPhrase rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:prepositionalPhrase></aaif:Adverb><aaif:Entry rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En1557"><aaif:phrase rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh#En1557Ph1" /><aaif:source rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh.bibl#Cnde9" /><gams:textualContent> Huye sin percibirse, lento , el día ,&lt;lb/&gt;y la hora secreta y recatada&lt;lb/&gt;con silencio se acerca, y, despreciada, *</gams:textualContent><rel:isPartOf rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh" /></aaif:Entry><aaif:Phrase rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En1557Ph1"><aaif:subject rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh#En1557Ph1Su1" /><aaif:verb rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh#En1557Ph1Ve1" /><aaif:adverb rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh#En1557Ph1Ad1" /><aaif:text> Huye sin percibirse, lento , el día </aaif:text><aaif:annoText> [v|Huye|huir|is] sin percibirse, [a|lento|lento|auvnmnnn] , [s|el día|ms] </aaif:annoText></aaif:Phrase><aaif:Subject rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En1557Ph1Su1"><aaif:text>el día</aaif:text><aaif:position rdf:datatype="http://www.w3.org/2001/XMLSchema#int">3</aaif:position><aaif:gender rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Masculine" /><aaif:number rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Singular" /><aaif:overt rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</aaif:overt></aaif:Subject><aaif:Verb rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En1557Ph1Ve1"><aaif:text>Huye</aaif:text><aaif:lemma rdf:resource="https://gams.uni-graz.at/o:aaif.lemma#huir" /><aaif:position rdf:datatype="http://www.w3.org/2001/XMLSchema#int">1</aaif:position><aaif:coordinated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:coordinated><aaif:partOfText rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</aaif:partOfText><aaif:syntacticConstruction rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Intransitive" /></aaif:Verb><aaif:Adverb rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En1557Ph1Ad1"><aaif:text>lento</aaif:text><aaif:lemma rdf:resource="https://gams.uni-graz.at/o:aaif.lemma#lento" /><aaif:position rdf:datatype="http://www.w3.org/2001/XMLSchema#int">2</aaif:position><aaif:coordinated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:coordinated><aaif:morphosyntacticStructure rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Adjective" /><aaif:inflection rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Uninflected" /><aaif:attributionTarget rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Verb" /><aaif:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:modified><aaif:semanticClassification rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Manner" /><aaif:reduplicated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:reduplicated><aaif:prepositionalPhrase rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:prepositionalPhrase></aaif:Adverb><aaif:Entry rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En1558"><aaif:phrase rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh#En1558Ph1" /><aaif:source rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh.bibl#Cnde10" /><gams:textualContent>Como suele crecer lento &lt;lb/&gt; el pimpollo , tanto, que&lt;lb/&gt;ninguno crecer le ve,&lt;lb/&gt;y todos ven el aumento,&lt;lb/&gt;así acá en</gams:textualContent><rel:isPartOf rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh" /></aaif:Entry><aaif:Phrase rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En1558Ph1"><aaif:subject rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh#En1558Ph1Su1" /><aaif:verb rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh#En1558Ph1Ve1" /><aaif:adverb rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh#En1558Ph1Ad1" /><aaif:text>Como suele crecer lento &lt;lb\/&gt; el pimpollo </aaif:text><aaif:annoText>Como suele [v|crecer|crecer|is] [a|lento|lento|auvnmnnn] &lt;lb\/&gt; [s|el pimpollo|ms] </aaif:annoText></aaif:Phrase><aaif:Subject rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En1558Ph1Su1"><aaif:text>el pimpollo</aaif:text><aaif:position rdf:datatype="http://www.w3.org/2001/XMLSchema#int">3</aaif:position><aaif:gender rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Masculine" /><aaif:number rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Singular" /><aaif:overt rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</aaif:overt></aaif:Subject><aaif:Verb rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En1558Ph1Ve1"><aaif:text>crecer</aaif:text><aaif:lemma rdf:resource="https://gams.uni-graz.at/o:aaif.lemma#crecer" /><aaif:position rdf:datatype="http://www.w3.org/2001/XMLSchema#int">1</aaif:position><aaif:coordinated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:coordinated><aaif:partOfText rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</aaif:partOfText><aaif:syntacticConstruction rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Intransitive" /></aaif:Verb><aaif:Adverb rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En1558Ph1Ad1"><aaif:text>lento</aaif:text><aaif:lemma rdf:resource="https://gams.uni-graz.at/o:aaif.lemma#lento" /><aaif:position rdf:datatype="http://www.w3.org/2001/XMLSchema#int">2</aaif:position><aaif:coordinated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:coordinated><aaif:morphosyntacticStructure rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Adjective" /><aaif:inflection rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Uninflected" /><aaif:attributionTarget rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Verb" /><aaif:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:modified><aaif:semanticClassification rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Manner" /><aaif:reduplicated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:reduplicated><aaif:prepositionalPhrase rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:prepositionalPhrase></aaif:Adverb><aaif:Entry rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En1559"><aaif:phrase rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh#En1559Ph1" /><aaif:source rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh.bibl#Cnde11" /><gams:textualContent>anheléis a este ardor;que si autoriza,&lt;lb/&gt;aniquila también el sol ¡oh rosas !&lt;lb/&gt; Naced y vivid lentas ;no en la prisa&lt;lb/&gt;os consumáis, floridas mariposas,&lt;lb/&gt;que es anhelar arder, buscar ceniza.</gams:textualContent><rel:isPartOf rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh" /></aaif:Entry><aaif:Phrase rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En1559Ph1"><aaif:subject rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh#En1559Ph1Su1" /><aaif:verb rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh#En1559Ph1Ve1" /><aaif:verb rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh#En1559Ph1Ve2" /><aaif:adverb rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh#En1559Ph1Ad1" /><aaif:text>¡oh rosas !&lt;lb\/&gt; Naced y vivid lentas </aaif:text><aaif:annoText>¡oh [s|rosas|fp] !&lt;lb\/&gt; [v|Naced|nacer|is] y [v|vivid|vivir|is] [a|lentas|lento|axsnmnnn] </aaif:annoText></aaif:Phrase><aaif:Subject rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En1559Ph1Su1"><aaif:text>rosas</aaif:text><aaif:position rdf:datatype="http://www.w3.org/2001/XMLSchema#int">1</aaif:position><aaif:gender rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Feminine" /><aaif:number rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Plural" /><aaif:overt rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</aaif:overt></aaif:Subject><aaif:Verb rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En1559Ph1Ve1"><aaif:text>Naced</aaif:text><aaif:lemma rdf:resource="https://gams.uni-graz.at/o:aaif.lemma#nacer" /><aaif:position rdf:datatype="http://www.w3.org/2001/XMLSchema#int">2</aaif:position><aaif:coordinated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</aaif:coordinated><aaif:partOfText rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</aaif:partOfText><aaif:syntacticConstruction rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Intransitive" /></aaif:Verb><aaif:Verb rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En1559Ph1Ve2"><aaif:text>vivid</aaif:text><aaif:lemma rdf:resource="https://gams.uni-graz.at/o:aaif.lemma#vivir" /><aaif:position rdf:datatype="http://www.w3.org/2001/XMLSchema#int">3</aaif:position><aaif:coordinated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</aaif:coordinated><aaif:partOfText rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</aaif:partOfText><aaif:syntacticConstruction rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Intransitive" /></aaif:Verb><aaif:Adverb rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En1559Ph1Ad1"><aaif:text>lentas</aaif:text><aaif:lemma rdf:resource="https://gams.uni-graz.at/o:aaif.lemma#lento" /><aaif:position rdf:datatype="http://www.w3.org/2001/XMLSchema#int">4</aaif:position><aaif:coordinated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:coordinated><aaif:morphosyntacticStructure rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Adjective" /><aaif:inflection rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#FemininePlural" /><aaif:attributionTarget rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Verb" /><aaif:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:modified><aaif:semanticClassification rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Manner" /><aaif:reduplicated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:reduplicated><aaif:prepositionalPhrase rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:prepositionalPhrase></aaif:Adverb><aaif:Entry rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En1560"><aaif:phrase rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh#En1560Ph1" /><aaif:source rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh.bibl#Cnde12" /><gams:textualContent>á nuestros oídos tenebroso,&lt;lb/&gt;Cual son historias de remotos tiempos&lt;lb/&gt;Antes que amaneciera luz del canto.&lt;lb/&gt; Desvanecióse  lento al fin cual niebla&lt;lb/&gt;Que los rayos del sol en la colina&lt;lb/&gt;Derriten, ¡oh Malvina!</gams:textualContent><rel:isPartOf rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh" /></aaif:Entry><aaif:Phrase rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En1560Ph1"><aaif:verb rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh#En1560Ph1Ve1" /><aaif:adverb rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh#En1560Ph1Ad1" /><aaif:text> Desvanecióse  lento al fin cual niebla</aaif:text><aaif:annoText> [v|Desvanecióse|desvanecer|rs]  [a|lento|lento|auvnmnnn] al fin cual niebla</aaif:annoText></aaif:Phrase><aaif:Verb rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En1560Ph1Ve1"><aaif:text>Desvanecióse</aaif:text><aaif:lemma rdf:resource="https://gams.uni-graz.at/o:aaif.lemma#desvanecer" /><aaif:position rdf:datatype="http://www.w3.org/2001/XMLSchema#int">1</aaif:position><aaif:coordinated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:coordinated><aaif:partOfText rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</aaif:partOfText><aaif:syntacticConstruction rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Reflexive" /></aaif:Verb><aaif:Adverb rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En1560Ph1Ad1"><aaif:text>lento</aaif:text><aaif:lemma rdf:resource="https://gams.uni-graz.at/o:aaif.lemma#lento" /><aaif:position rdf:datatype="http://www.w3.org/2001/XMLSchema#int">2</aaif:position><aaif:coordinated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:coordinated><aaif:morphosyntacticStructure rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Adjective" /><aaif:inflection rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Uninflected" /><aaif:attributionTarget rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Verb" /><aaif:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:modified><aaif:semanticClassification rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Manner" /><aaif:reduplicated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:reduplicated><aaif:prepositionalPhrase rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:prepositionalPhrase></aaif:Adverb><aaif:Entry rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En1561"><aaif:phrase rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh#En1561Ph1" /><aaif:source rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh.bibl#Cnde14" /><gams:textualContent>las celestes ruedas la armonía;&lt;lb/&gt;Cuyo volante al sol los pasos cuenta;&lt;lb/&gt;Y cuya mano fiel girando lenta &lt;lb/&gt;Nos avisa las horas que escondida&lt;lb/&gt;Roba el ala del tiempo á nuestra vida;&lt;lb/&gt;Aqui lo transportó,</gams:textualContent><rel:isPartOf rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh" /></aaif:Entry><aaif:Phrase rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En1561Ph1"><aaif:verb rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh#En1561Ph1Ve1" /><aaif:adverb rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh#En1561Ph1Ad1" /><aaif:text>Y cuya mano fiel girando lenta &lt;lb\/&gt;Nos avisa las horas que escondida</aaif:text><aaif:annoText>Y cuya mano fiel [v|girando|girar|is] [a|lenta|lento|afsnmnnn] &lt;lb\/&gt;Nos avisa las horas que escondida</aaif:annoText></aaif:Phrase><aaif:Verb rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En1561Ph1Ve1"><aaif:text>girando</aaif:text><aaif:lemma rdf:resource="https://gams.uni-graz.at/o:aaif.lemma#girar" /><aaif:position rdf:datatype="http://www.w3.org/2001/XMLSchema#int">1</aaif:position><aaif:coordinated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:coordinated><aaif:partOfText rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</aaif:partOfText><aaif:syntacticConstruction rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Intransitive" /></aaif:Verb><aaif:Adverb rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En1561Ph1Ad1"><aaif:text>lenta</aaif:text><aaif:lemma rdf:resource="https://gams.uni-graz.at/o:aaif.lemma#lento" /><aaif:position rdf:datatype="http://www.w3.org/2001/XMLSchema#int">2</aaif:position><aaif:coordinated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:coordinated><aaif:morphosyntacticStructure rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Adjective" /><aaif:inflection rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#FeminineSingular" /><aaif:attributionTarget rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Verb" /><aaif:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:modified><aaif:semanticClassification rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Manner" /><aaif:reduplicated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:reduplicated><aaif:prepositionalPhrase rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:prepositionalPhrase></aaif:Adverb><aaif:Entry rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En1562"><aaif:phrase rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh#En1562Ph1" /><aaif:source rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh.bibl#Cnde15" /><gams:textualContent>Sólo se vía en las rizadas ondas&lt;lb/&gt;Vibrar el resplandor de las estrellas,&lt;lb/&gt;O relucir luciérnaga encendida&lt;lb/&gt; Girando  lenta entre el ramaje oscuro.&lt;lb/&gt;Toda otra luz estaba ya apagada.&lt;lb/&gt;Dafni entregado a su amorosa pena</gams:textualContent><rel:isPartOf rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh" /></aaif:Entry><aaif:Phrase rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En1562Ph1"><aaif:verb rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh#En1562Ph1Ve1" /><aaif:adverb rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh#En1562Ph1Ad1" /><aaif:text>O relucir luciérnaga encendida&lt;lb\/&gt; Girando  lenta entre el ramaje oscuro</aaif:text><aaif:annoText>O relucir luciérnaga encendida&lt;lb\/&gt; [v|Girando|girar|is]  [a|lenta|lento|afsnmnnn] entre el ramaje oscuro</aaif:annoText></aaif:Phrase><aaif:Verb rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En1562Ph1Ve1"><aaif:text>Girando</aaif:text><aaif:lemma rdf:resource="https://gams.uni-graz.at/o:aaif.lemma#girar" /><aaif:position rdf:datatype="http://www.w3.org/2001/XMLSchema#int">1</aaif:position><aaif:coordinated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:coordinated><aaif:partOfText rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</aaif:partOfText><aaif:syntacticConstruction rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Intransitive" /></aaif:Verb><aaif:Adverb rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En1562Ph1Ad1"><aaif:text>lenta</aaif:text><aaif:lemma rdf:resource="https://gams.uni-graz.at/o:aaif.lemma#lento" /><aaif:position rdf:datatype="http://www.w3.org/2001/XMLSchema#int">2</aaif:position><aaif:coordinated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:coordinated><aaif:morphosyntacticStructure rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Adjective" /><aaif:inflection rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#FeminineSingular" /><aaif:attributionTarget rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Verb" /><aaif:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:modified><aaif:semanticClassification rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Manner" /><aaif:reduplicated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:reduplicated><aaif:prepositionalPhrase rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:prepositionalPhrase></aaif:Adverb><aaif:Entry rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En1563"><aaif:phrase rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh#En1563Ph1" /><aaif:source rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh.bibl#Cnde16" /><gams:textualContent>de nombres propios, y éste fue el objeto del famoso manifiesto.Los absolutistas vieron que habían andado lentos y esperaron la suya; los liberales vieron que habían andado más lentos todavía, y quisieron resarcir ya tarde</gams:textualContent><rel:isPartOf rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh" /></aaif:Entry><aaif:Phrase rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En1563Ph1"><aaif:verb rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh#En1563Ph1Ve1" /><aaif:adverb rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh#En1563Ph1Ad1" /><aaif:text>Los absolutistas vieron que habían andado lentos y esperaron la suya</aaif:text><aaif:annoText>Los absolutistas vieron que [v|habían andado|andar|is] [a|lentos|lento|apsnmnnn] y esperaron la suya</aaif:annoText></aaif:Phrase><aaif:Verb rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En1563Ph1Ve1"><aaif:text>habían andado</aaif:text><aaif:lemma rdf:resource="https://gams.uni-graz.at/o:aaif.lemma#andar" /><aaif:position rdf:datatype="http://www.w3.org/2001/XMLSchema#int">1</aaif:position><aaif:coordinated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:coordinated><aaif:partOfText rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</aaif:partOfText><aaif:syntacticConstruction rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Intransitive" /></aaif:Verb><aaif:Adverb rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En1563Ph1Ad1"><aaif:text>lentos</aaif:text><aaif:lemma rdf:resource="https://gams.uni-graz.at/o:aaif.lemma#lento" /><aaif:position rdf:datatype="http://www.w3.org/2001/XMLSchema#int">2</aaif:position><aaif:coordinated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:coordinated><aaif:morphosyntacticStructure rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Adjective" /><aaif:inflection rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#MasculinePlural" /><aaif:attributionTarget rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Verb" /><aaif:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:modified><aaif:semanticClassification rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Manner" /><aaif:reduplicated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:reduplicated><aaif:prepositionalPhrase rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:prepositionalPhrase></aaif:Adverb><aaif:Entry rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En1564"><aaif:phrase rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh#En1564Ph1" /><aaif:source rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh.bibl#Cnde17" /><gams:textualContent>sereno, una vida de pasiones desenfrenadas es como un día de tormenta.Mira esas nubes que llegan , lentas y oscuras , a interponerse entre el sol y la tierra.Son como el deber, que se interpone</gams:textualContent><rel:isPartOf rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh" /></aaif:Entry><aaif:Phrase rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En1564Ph1"><aaif:verb rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh#En1564Ph1Ve1" /><aaif:adverb rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh#En1564Ph1Ad1" /><aaif:adverb rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh#En1564Ph1Ad2" /><aaif:text>Mira esas nubes que llegan , lentas y oscuras ,</aaif:text><aaif:annoText>Mira esas nubes que [v|llegan|llegar|is] , [a|lentas|lento|axsnmnnC] y [a|oscuras|oscuro|axsnmnnC] ,</aaif:annoText></aaif:Phrase><aaif:Verb rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En1564Ph1Ve1"><aaif:text>llegan</aaif:text><aaif:lemma rdf:resource="https://gams.uni-graz.at/o:aaif.lemma#llegar" /><aaif:position rdf:datatype="http://www.w3.org/2001/XMLSchema#int">1</aaif:position><aaif:coordinated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:coordinated><aaif:partOfText rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</aaif:partOfText><aaif:syntacticConstruction rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Intransitive" /></aaif:Verb><aaif:Adverb rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En1564Ph1Ad1"><aaif:text>lentas</aaif:text><aaif:lemma rdf:resource="https://gams.uni-graz.at/o:aaif.lemma#lento" /><aaif:position rdf:datatype="http://www.w3.org/2001/XMLSchema#int">2</aaif:position><aaif:coordinated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</aaif:coordinated><aaif:morphosyntacticStructure rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Adjective" /><aaif:inflection rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#FemininePlural" /><aaif:attributionTarget rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Verb" /><aaif:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:modified><aaif:semanticClassification rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Manner" /><aaif:reduplicated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:reduplicated><aaif:prepositionalPhrase rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:prepositionalPhrase></aaif:Adverb><aaif:Adverb rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En1564Ph1Ad2"><aaif:text>oscuras</aaif:text><aaif:lemma rdf:resource="https://gams.uni-graz.at/o:aaif.lemma#oscuro" /><aaif:position rdf:datatype="http://www.w3.org/2001/XMLSchema#int">3</aaif:position><aaif:coordinated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</aaif:coordinated><aaif:morphosyntacticStructure rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Adjective" /><aaif:inflection rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#FemininePlural" /><aaif:attributionTarget rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Verb" /><aaif:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:modified><aaif:semanticClassification rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Manner" /><aaif:reduplicated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:reduplicated><aaif:prepositionalPhrase rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:prepositionalPhrase></aaif:Adverb><aaif:Entry rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En1565"><aaif:phrase rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh#En1565Ph1" /><aaif:source rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh.bibl#Cnde18" /><gams:textualContent>los matorrales y desaparecían, o vagaban un instante sobre las aguas estancadas e inmóviles. Millares de luciérnagas  recorrían lentas el seno tenebroso de la selva, como pequeñas estrellas volantes; a veces se prendían en la suelta cabellera de</gams:textualContent><rel:isPartOf rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh" /></aaif:Entry><aaif:Phrase rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En1565Ph1"><aaif:subject rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh#En1565Ph1Su1" /><aaif:verb rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh#En1565Ph1Ve1" /><aaif:adverb rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh#En1565Ph1Ad1" /><aaif:text> Millares de luciérnagas  recorrían lentas el seno tenebroso de la selva</aaif:text><aaif:annoText> [s|Millares de luciérnagas|fp]  [v|recorrían|recorrer|ts] [a|lentas|lento|axsnmnnn] el seno tenebroso de la selva</aaif:annoText></aaif:Phrase><aaif:Subject rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En1565Ph1Su1"><aaif:text>Millares de luciérnagas</aaif:text><aaif:position rdf:datatype="http://www.w3.org/2001/XMLSchema#int">1</aaif:position><aaif:gender rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Feminine" /><aaif:number rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Plural" /><aaif:overt rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</aaif:overt></aaif:Subject><aaif:Verb rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En1565Ph1Ve1"><aaif:text>recorrían</aaif:text><aaif:lemma rdf:resource="https://gams.uni-graz.at/o:aaif.lemma#recorrer" /><aaif:position rdf:datatype="http://www.w3.org/2001/XMLSchema#int">2</aaif:position><aaif:coordinated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:coordinated><aaif:partOfText rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</aaif:partOfText><aaif:syntacticConstruction rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Transitive" /></aaif:Verb><aaif:Adverb rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En1565Ph1Ad1"><aaif:text>lentas</aaif:text><aaif:lemma rdf:resource="https://gams.uni-graz.at/o:aaif.lemma#lento" /><aaif:position rdf:datatype="http://www.w3.org/2001/XMLSchema#int">3</aaif:position><aaif:coordinated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:coordinated><aaif:morphosyntacticStructure rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Adjective" /><aaif:inflection rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#FemininePlural" /><aaif:attributionTarget rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Verb" /><aaif:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:modified><aaif:semanticClassification rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Manner" /><aaif:reduplicated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:reduplicated><aaif:prepositionalPhrase rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:prepositionalPhrase></aaif:Adverb><aaif:Entry rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En1566"><aaif:phrase rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh#En1566Ph1" /><aaif:source rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh.bibl#Cnde19" /><gams:textualContent>que tu espíritu voló á incorporarse en el eterno.Muerto estás: la frente perforada, los sesos escurriendo lentos hácia las mejillas, la sangre cuajada en los rizos de tus sienes dan harto en qué se aflija el</gams:textualContent><rel:isPartOf rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh" /></aaif:Entry><aaif:Phrase rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En1566Ph1"><aaif:verb rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh#En1566Ph1Ve1" /><aaif:adverb rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh#En1566Ph1Ad1" /><aaif:text>Muerto estás: la frente perforada, los sesos escurriendo lentos hácia las mejillas</aaif:text><aaif:annoText>Muerto estás: la frente perforada, los sesos [v|escurriendo|escurrir|is] [a|lentos|lento|apsnmnnn] hácia las mejillas</aaif:annoText></aaif:Phrase><aaif:Verb rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En1566Ph1Ve1"><aaif:text>escurriendo</aaif:text><aaif:lemma rdf:resource="https://gams.uni-graz.at/o:aaif.lemma#escurrir" /><aaif:position rdf:datatype="http://www.w3.org/2001/XMLSchema#int">1</aaif:position><aaif:coordinated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:coordinated><aaif:partOfText rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</aaif:partOfText><aaif:syntacticConstruction rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Intransitive" /></aaif:Verb><aaif:Adverb rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En1566Ph1Ad1"><aaif:text>lentos</aaif:text><aaif:lemma rdf:resource="https://gams.uni-graz.at/o:aaif.lemma#lento" /><aaif:position rdf:datatype="http://www.w3.org/2001/XMLSchema#int">2</aaif:position><aaif:coordinated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:coordinated><aaif:morphosyntacticStructure rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Adjective" /><aaif:inflection rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#MasculinePlural" /><aaif:attributionTarget rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Verb" /><aaif:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:modified><aaif:semanticClassification rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Manner" /><aaif:reduplicated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:reduplicated><aaif:prepositionalPhrase rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:prepositionalPhrase></aaif:Adverb><aaif:Entry rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En1567"><aaif:phrase rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh#En1567Ph1" /><aaif:source rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh.bibl#Cnde20" /><gams:textualContent>Avanzaba la mañana con un sol radiante:  jirones de vapores flotaban en los bajos y ascendían lentos para desvanecerse pronto, presagiando un día puro y sereno</gams:textualContent><rel:isPartOf rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh" /></aaif:Entry><aaif:Phrase rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En1567Ph1"><aaif:subject rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh#En1567Ph1Su1" /><aaif:verb rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh#En1567Ph1Ve1" /><aaif:adverb rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh#En1567Ph1Ad1" /><aaif:text> jirones de vapores flotaban en los bajos y ascendían lentos para desvanecerse pronto</aaif:text><aaif:annoText> [s|jirones de vapores|mp] flotaban en los bajos y [v|ascendían|ascender|is] [a|lentos|lento|apsnmnnn] para desvanecerse pronto</aaif:annoText></aaif:Phrase><aaif:Subject rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En1567Ph1Su1"><aaif:text>jirones de vapores</aaif:text><aaif:position rdf:datatype="http://www.w3.org/2001/XMLSchema#int">1</aaif:position><aaif:gender rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Masculine" /><aaif:number rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Plural" /><aaif:overt rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</aaif:overt></aaif:Subject><aaif:Verb rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En1567Ph1Ve1"><aaif:text>ascendían</aaif:text><aaif:lemma rdf:resource="https://gams.uni-graz.at/o:aaif.lemma#ascender" /><aaif:position rdf:datatype="http://www.w3.org/2001/XMLSchema#int">2</aaif:position><aaif:coordinated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:coordinated><aaif:partOfText rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</aaif:partOfText><aaif:syntacticConstruction rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Intransitive" /></aaif:Verb><aaif:Adverb rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En1567Ph1Ad1"><aaif:text>lentos</aaif:text><aaif:lemma rdf:resource="https://gams.uni-graz.at/o:aaif.lemma#lento" /><aaif:position rdf:datatype="http://www.w3.org/2001/XMLSchema#int">3</aaif:position><aaif:coordinated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:coordinated><aaif:morphosyntacticStructure rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Adjective" /><aaif:inflection rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#MasculinePlural" /><aaif:attributionTarget rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Verb" /><aaif:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:modified><aaif:semanticClassification rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Manner" /><aaif:reduplicated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:reduplicated><aaif:prepositionalPhrase rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:prepositionalPhrase></aaif:Adverb><aaif:Entry rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En1568"><aaif:phrase rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh#En1568Ph1" /><aaif:source rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh.bibl#Cnde21" /><gams:textualContent>espera: es forzoso vivir, aunque el alma se oponga, encariñada con su amiga la muerte. Pasaban  lentas  las horas del día , y tanto Ponte como su paisana no podían apartar su atención de todo ruido</gams:textualContent><rel:isPartOf rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh" /></aaif:Entry><aaif:Phrase rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En1568Ph1"><aaif:subject rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh#En1568Ph1Su1" /><aaif:verb rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh#En1568Ph1Ve1" /><aaif:adverb rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh#En1568Ph1Ad1" /><aaif:text> Pasaban  lentas  las horas del día </aaif:text><aaif:annoText> [v|Pasaban|pasar|is]  [a|lentas|lento|axsnmnnn]  [s|las horas del día|fp] </aaif:annoText></aaif:Phrase><aaif:Subject rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En1568Ph1Su1"><aaif:text>las horas del día</aaif:text><aaif:position rdf:datatype="http://www.w3.org/2001/XMLSchema#int">3</aaif:position><aaif:gender rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Feminine" /><aaif:number rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Plural" /><aaif:overt rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</aaif:overt></aaif:Subject><aaif:Verb rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En1568Ph1Ve1"><aaif:text>Pasaban</aaif:text><aaif:lemma rdf:resource="https://gams.uni-graz.at/o:aaif.lemma#pasar" /><aaif:position rdf:datatype="http://www.w3.org/2001/XMLSchema#int">1</aaif:position><aaif:coordinated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:coordinated><aaif:partOfText rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</aaif:partOfText><aaif:syntacticConstruction rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Intransitive" /></aaif:Verb><aaif:Adverb rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En1568Ph1Ad1"><aaif:text>lentas</aaif:text><aaif:lemma rdf:resource="https://gams.uni-graz.at/o:aaif.lemma#lento" /><aaif:position rdf:datatype="http://www.w3.org/2001/XMLSchema#int">2</aaif:position><aaif:coordinated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:coordinated><aaif:morphosyntacticStructure rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Adjective" /><aaif:inflection rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#FemininePlural" /><aaif:attributionTarget rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Verb" /><aaif:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:modified><aaif:semanticClassification rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Manner" /><aaif:reduplicated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:reduplicated><aaif:prepositionalPhrase rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:prepositionalPhrase></aaif:Adverb><aaif:Entry rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En1569"><aaif:phrase rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh#En1569Ph1" /><aaif:source rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh.bibl#Cnde22" /><gams:textualContent>...Todos los pasajeros estábamos en la borda agitando en el aire nuestros pañuelos; subía y bajaba lenta en la popa, la bandera azul y blanca ;hervía el agua atrás, y en la superficie d</gams:textualContent><rel:isPartOf rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh" /></aaif:Entry><aaif:Phrase rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En1569Ph1"><aaif:subject rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh#En1569Ph1Su1" /><aaif:verb rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh#En1569Ph1Ve1" /><aaif:verb rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh#En1569Ph1Ve2" /><aaif:adverb rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh#En1569Ph1Ad1" /><aaif:text> subía y bajaba lenta en la popa, la bandera azul y blanca </aaif:text><aaif:annoText> [v|subía|subir|is] y [v|bajaba|bajar|is] [a|lenta|lento|afsnmnnn] en la popa, [s|la bandera azul y blanca|fs] </aaif:annoText></aaif:Phrase><aaif:Subject rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En1569Ph1Su1"><aaif:text>la bandera azul y blanca</aaif:text><aaif:position rdf:datatype="http://www.w3.org/2001/XMLSchema#int">4</aaif:position><aaif:gender rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Feminine" /><aaif:number rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Singular" /><aaif:overt rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</aaif:overt></aaif:Subject><aaif:Verb rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En1569Ph1Ve1"><aaif:text>subía</aaif:text><aaif:lemma rdf:resource="https://gams.uni-graz.at/o:aaif.lemma#subir" /><aaif:position rdf:datatype="http://www.w3.org/2001/XMLSchema#int">1</aaif:position><aaif:coordinated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</aaif:coordinated><aaif:partOfText rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</aaif:partOfText><aaif:syntacticConstruction rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Intransitive" /></aaif:Verb><aaif:Verb rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En1569Ph1Ve2"><aaif:text>bajaba</aaif:text><aaif:lemma rdf:resource="https://gams.uni-graz.at/o:aaif.lemma#bajar" /><aaif:position rdf:datatype="http://www.w3.org/2001/XMLSchema#int">2</aaif:position><aaif:coordinated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</aaif:coordinated><aaif:partOfText rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</aaif:partOfText><aaif:syntacticConstruction rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Intransitive" /></aaif:Verb><aaif:Adverb rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En1569Ph1Ad1"><aaif:text>lenta</aaif:text><aaif:lemma rdf:resource="https://gams.uni-graz.at/o:aaif.lemma#lento" /><aaif:position rdf:datatype="http://www.w3.org/2001/XMLSchema#int">3</aaif:position><aaif:coordinated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:coordinated><aaif:morphosyntacticStructure rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Adjective" /><aaif:inflection rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#FeminineSingular" /><aaif:attributionTarget rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Verb" /><aaif:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:modified><aaif:semanticClassification rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Manner" /><aaif:reduplicated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:reduplicated><aaif:prepositionalPhrase rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:prepositionalPhrase></aaif:Adverb><aaif:Entry rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En1570"><aaif:phrase rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh#En1570Ph1" /><aaif:source rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh.bibl#Cnde24" /><gams:textualContent>El carraspeo persistente de una tos rasga los aires; los golpes espaciados de una maza de esparto, resuenan lentos .</gams:textualContent><rel:isPartOf rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh" /></aaif:Entry><aaif:Phrase rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En1570Ph1"><aaif:subject rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh#En1570Ph1Su1" /><aaif:verb rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh#En1570Ph1Ve1" /><aaif:adverb rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh#En1570Ph1Ad1" /><aaif:text> los golpes espaciados de una maza de esparto, resuenan lentos .</aaif:text><aaif:annoText> [s|los golpes|mp] espaciados de una maza de esparto, [v|resuenan|resonar|is] [a|lentos|lento|apsnmnnn] .</aaif:annoText></aaif:Phrase><aaif:Subject rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En1570Ph1Su1"><aaif:text>los golpes</aaif:text><aaif:position rdf:datatype="http://www.w3.org/2001/XMLSchema#int">1</aaif:position><aaif:gender rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Masculine" /><aaif:number rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Plural" /><aaif:overt rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</aaif:overt></aaif:Subject><aaif:Verb rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En1570Ph1Ve1"><aaif:text>resuenan</aaif:text><aaif:lemma rdf:resource="https://gams.uni-graz.at/o:aaif.lemma#resonar" /><aaif:position rdf:datatype="http://www.w3.org/2001/XMLSchema#int">2</aaif:position><aaif:coordinated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:coordinated><aaif:partOfText rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</aaif:partOfText><aaif:syntacticConstruction rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Intransitive" /></aaif:Verb><aaif:Adverb rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En1570Ph1Ad1"><aaif:text>lentos</aaif:text><aaif:lemma rdf:resource="https://gams.uni-graz.at/o:aaif.lemma#lento" /><aaif:position rdf:datatype="http://www.w3.org/2001/XMLSchema#int">3</aaif:position><aaif:coordinated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:coordinated><aaif:morphosyntacticStructure rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Adjective" /><aaif:inflection rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#MasculinePlural" /><aaif:attributionTarget rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Verb" /><aaif:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:modified><aaif:semanticClassification rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Manner" /><aaif:reduplicated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:reduplicated><aaif:prepositionalPhrase rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:prepositionalPhrase></aaif:Adverb><aaif:Entry rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En1571"><aaif:phrase rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh#En1571Ph1" /><aaif:source rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh.bibl#Cnde24" /><gams:textualContent>San Cayetano, las Monjas...Las campanas tocan en multiforme campaneo. El humo blanco de las mil chimeneas  asciende lento en derechas columnas.En las blanquecinas vetas de los caminos pululan, rebullen, hormiguean negros trazos que se</gams:textualContent><rel:isPartOf rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh" /></aaif:Entry><aaif:Phrase rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En1571Ph1"><aaif:subject rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh#En1571Ph1Su1" /><aaif:verb rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh#En1571Ph1Ve1" /><aaif:adverb rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh#En1571Ph1Ad1" /><aaif:text> El humo blanco de las mil chimeneas  asciende lento en derechas columnas.</aaif:text><aaif:annoText> [s|El humo blanco de las mil chimeneas|ms]  [v|asciende|ascender|is] [a|lento|lento|auvnmnnn] en derechas columnas.</aaif:annoText></aaif:Phrase><aaif:Subject rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En1571Ph1Su1"><aaif:text>El humo blanco de las mil chimeneas</aaif:text><aaif:position rdf:datatype="http://www.w3.org/2001/XMLSchema#int">1</aaif:position><aaif:gender rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Masculine" /><aaif:number rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Singular" /><aaif:overt rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</aaif:overt></aaif:Subject><aaif:Verb rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En1571Ph1Ve1"><aaif:text>asciende</aaif:text><aaif:lemma rdf:resource="https://gams.uni-graz.at/o:aaif.lemma#ascender" /><aaif:position rdf:datatype="http://www.w3.org/2001/XMLSchema#int">2</aaif:position><aaif:coordinated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:coordinated><aaif:partOfText rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</aaif:partOfText><aaif:syntacticConstruction rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Intransitive" /></aaif:Verb><aaif:Adverb rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En1571Ph1Ad1"><aaif:text>lento</aaif:text><aaif:lemma rdf:resource="https://gams.uni-graz.at/o:aaif.lemma#lento" /><aaif:position rdf:datatype="http://www.w3.org/2001/XMLSchema#int">3</aaif:position><aaif:coordinated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:coordinated><aaif:morphosyntacticStructure rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Adjective" /><aaif:inflection rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Uninflected" /><aaif:attributionTarget rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Verb" /><aaif:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:modified><aaif:semanticClassification rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Manner" /><aaif:reduplicated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:reduplicated><aaif:prepositionalPhrase rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:prepositionalPhrase></aaif:Adverb><aaif:Entry rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En1572"><aaif:phrase rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh#En1572Ph1" /><aaif:source rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh.bibl#Cnde24" /><gams:textualContent>corriendo poco á poco, marca sobre el aljofifado pavimento un vivo cuadro.A lo lejos, las campanadas de las doce caen lentas .En la iglesia Nueva suena el grave tintineo del Ave María.Puche cruza las manos y murmura</gams:textualContent><rel:isPartOf rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh" /></aaif:Entry><aaif:Phrase rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En1572Ph1"><aaif:subject rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh#En1572Ph1Su1" /><aaif:verb rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh#En1572Ph1Ve1" /><aaif:adverb rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh#En1572Ph1Ad1" /><aaif:text>A lo lejos, las campanadas de las doce caen lentas </aaif:text><aaif:annoText>A lo lejos, [s|las campanadas de las doce|fp] [v|caen|caer|is] [a|lentas|lento|axsnmnnn] </aaif:annoText></aaif:Phrase><aaif:Subject rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En1572Ph1Su1"><aaif:text>las campanadas de las doce</aaif:text><aaif:position rdf:datatype="http://www.w3.org/2001/XMLSchema#int">1</aaif:position><aaif:gender rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Feminine" /><aaif:number rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Plural" /><aaif:overt rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</aaif:overt></aaif:Subject><aaif:Verb rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En1572Ph1Ve1"><aaif:text>caen</aaif:text><aaif:lemma rdf:resource="https://gams.uni-graz.at/o:aaif.lemma#caer" /><aaif:position rdf:datatype="http://www.w3.org/2001/XMLSchema#int">2</aaif:position><aaif:coordinated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:coordinated><aaif:partOfText rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</aaif:partOfText><aaif:syntacticConstruction rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Intransitive" /></aaif:Verb><aaif:Adverb rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En1572Ph1Ad1"><aaif:text>lentas</aaif:text><aaif:lemma rdf:resource="https://gams.uni-graz.at/o:aaif.lemma#lento" /><aaif:position rdf:datatype="http://www.w3.org/2001/XMLSchema#int">3</aaif:position><aaif:coordinated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:coordinated><aaif:morphosyntacticStructure rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Adjective" /><aaif:inflection rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#FemininePlural" /><aaif:attributionTarget rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Verb" /><aaif:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:modified><aaif:semanticClassification rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Manner" /><aaif:reduplicated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:reduplicated><aaif:prepositionalPhrase rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:prepositionalPhrase></aaif:Adverb><aaif:Entry rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En1573"><aaif:phrase rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh#En1573Ph1" /><aaif:source rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh.bibl#Cnde24" /><gams:textualContent>suenan pasos precipitados sobre la acera, y pasa un labriego envuelto en una manta.Y las horas transcurren lentas , eternas ...</gams:textualContent><rel:isPartOf rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh" /></aaif:Entry><aaif:Phrase rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En1573Ph1"><aaif:subject rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh#En1573Ph1Su1" /><aaif:verb rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh#En1573Ph1Ve1" /><aaif:adverb rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh#En1573Ph1Ad1" /><aaif:adverb rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh#En1573Ph1Ad2" /><aaif:text>Y las horas transcurren lentas , eternas ...</aaif:text><aaif:annoText>Y [s|las horas|fp] [v|transcurren|transcurrir|is] [a|lentas|lento|axsnmnnC] , [a|eternas|eterno|afsnmnnC] ...</aaif:annoText></aaif:Phrase><aaif:Subject rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En1573Ph1Su1"><aaif:text>las horas</aaif:text><aaif:position rdf:datatype="http://www.w3.org/2001/XMLSchema#int">1</aaif:position><aaif:gender rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Feminine" /><aaif:number rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Plural" /><aaif:overt rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</aaif:overt></aaif:Subject><aaif:Verb rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En1573Ph1Ve1"><aaif:text>transcurren</aaif:text><aaif:lemma rdf:resource="https://gams.uni-graz.at/o:aaif.lemma#transcurrir" /><aaif:position rdf:datatype="http://www.w3.org/2001/XMLSchema#int">2</aaif:position><aaif:coordinated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:coordinated><aaif:partOfText rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</aaif:partOfText><aaif:syntacticConstruction rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Intransitive" /></aaif:Verb><aaif:Adverb rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En1573Ph1Ad1"><aaif:text>lentas</aaif:text><aaif:lemma rdf:resource="https://gams.uni-graz.at/o:aaif.lemma#lento" /><aaif:position rdf:datatype="http://www.w3.org/2001/XMLSchema#int">3</aaif:position><aaif:coordinated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</aaif:coordinated><aaif:morphosyntacticStructure rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Adjective" /><aaif:inflection rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#FemininePlural" /><aaif:attributionTarget rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Verb" /><aaif:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:modified><aaif:semanticClassification rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Manner" /><aaif:reduplicated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:reduplicated><aaif:prepositionalPhrase rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:prepositionalPhrase></aaif:Adverb><aaif:Adverb rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En1573Ph1Ad2"><aaif:text>eternas</aaif:text><aaif:lemma rdf:resource="https://gams.uni-graz.at/o:aaif.lemma#eterno" /><aaif:position rdf:datatype="http://www.w3.org/2001/XMLSchema#int">4</aaif:position><aaif:coordinated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</aaif:coordinated><aaif:morphosyntacticStructure rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Adjective" /><aaif:inflection rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#FeminineSingular" /><aaif:attributionTarget rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Verb" /><aaif:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:modified><aaif:semanticClassification rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Manner" /><aaif:reduplicated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:reduplicated><aaif:prepositionalPhrase rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:prepositionalPhrase></aaif:Adverb><aaif:Entry rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En1574"><aaif:phrase rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh#En1574Ph1" /><aaif:source rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh.bibl#Cnde24" /><gams:textualContent>El P.Lasalde ha callado. Sus palabras  han caído lentas , solemnes , abrumadoras sobre el maestro.Y el maestro ha pensado que sus lecturas, sus libros,</gams:textualContent><rel:isPartOf rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh" /></aaif:Entry><aaif:Phrase rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En1574Ph1"><aaif:subject rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh#En1574Ph1Su1" /><aaif:verb rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh#En1574Ph1Ve1" /><aaif:adverb rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh#En1574Ph1Ad1" /><aaif:adverb rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh#En1574Ph1Ad2" /><aaif:adverb rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh#En1574Ph1Ad3" /><aaif:text> Sus palabras  han caído lentas , solemnes , abrumadoras sobre el maestro.</aaif:text><aaif:annoText> [s|Sus palabras|fp]  [v|han caído|caer|is] [a|lentas|lento|axsnmnnC] , [a|solemnes|solemne|axsnmnnC] , [a|abrumadoras|abrumador|axsnmnnC] sobre el maestro.</aaif:annoText></aaif:Phrase><aaif:Subject rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En1574Ph1Su1"><aaif:text>Sus palabras</aaif:text><aaif:position rdf:datatype="http://www.w3.org/2001/XMLSchema#int">1</aaif:position><aaif:gender rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Feminine" /><aaif:number rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Plural" /><aaif:overt rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</aaif:overt></aaif:Subject><aaif:Verb rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En1574Ph1Ve1"><aaif:text>han caído</aaif:text><aaif:lemma rdf:resource="https://gams.uni-graz.at/o:aaif.lemma#caer" /><aaif:position rdf:datatype="http://www.w3.org/2001/XMLSchema#int">2</aaif:position><aaif:coordinated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:coordinated><aaif:partOfText rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</aaif:partOfText><aaif:syntacticConstruction rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Intransitive" /></aaif:Verb><aaif:Adverb rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En1574Ph1Ad1"><aaif:text>lentas</aaif:text><aaif:lemma rdf:resource="https://gams.uni-graz.at/o:aaif.lemma#lento" /><aaif:position rdf:datatype="http://www.w3.org/2001/XMLSchema#int">3</aaif:position><aaif:coordinated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</aaif:coordinated><aaif:morphosyntacticStructure rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Adjective" /><aaif:inflection rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#FemininePlural" /><aaif:attributionTarget rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Verb" /><aaif:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:modified><aaif:semanticClassification rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Manner" /><aaif:reduplicated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:reduplicated><aaif:prepositionalPhrase rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:prepositionalPhrase></aaif:Adverb><aaif:Adverb rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En1574Ph1Ad2"><aaif:text>solemnes</aaif:text><aaif:lemma rdf:resource="https://gams.uni-graz.at/o:aaif.lemma#solemne" /><aaif:position rdf:datatype="http://www.w3.org/2001/XMLSchema#int">4</aaif:position><aaif:coordinated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</aaif:coordinated><aaif:morphosyntacticStructure rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Adjective" /><aaif:inflection rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#FemininePlural" /><aaif:attributionTarget rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Verb" /><aaif:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:modified><aaif:semanticClassification rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Manner" /><aaif:reduplicated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:reduplicated><aaif:prepositionalPhrase rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:prepositionalPhrase></aaif:Adverb><aaif:Adverb rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En1574Ph1Ad3"><aaif:text>abrumadoras</aaif:text><aaif:lemma rdf:resource="https://gams.uni-graz.at/o:aaif.lemma#abrumador" /><aaif:position rdf:datatype="http://www.w3.org/2001/XMLSchema#int">5</aaif:position><aaif:coordinated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</aaif:coordinated><aaif:morphosyntacticStructure rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Adjective" /><aaif:inflection rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#FemininePlural" /><aaif:attributionTarget rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Verb" /><aaif:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:modified><aaif:semanticClassification rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Manner" /><aaif:reduplicated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:reduplicated><aaif:prepositionalPhrase rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:prepositionalPhrase></aaif:Adverb><aaif:Entry rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En1575"><aaif:phrase rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh#En1575Ph1" /><aaif:source rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh.bibl#Cnde24" /><gams:textualContent>Son las once.A lo lejos, en el santuario, tintinean campanadas graves, campanadas agudas, campanadas que suenan lentas y se apagan en largas vibraciones.El sol entra violentamente por el ancho ventano y hace brillar los pintorescos</gams:textualContent><rel:isPartOf rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh" /></aaif:Entry><aaif:Phrase rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En1575Ph1"><aaif:verb rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh#En1575Ph1Ve1" /><aaif:adverb rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh#En1575Ph1Ad1" /><aaif:text>campanadas que suenan lentas y se apagan en largas vibraciones</aaif:text><aaif:annoText>campanadas que [v|suenan|sonar|is] [a|lentas|lento|axsnmnnn] y se apagan en largas vibraciones</aaif:annoText></aaif:Phrase><aaif:Verb rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En1575Ph1Ve1"><aaif:text>suenan</aaif:text><aaif:lemma rdf:resource="https://gams.uni-graz.at/o:aaif.lemma#sonar" /><aaif:position rdf:datatype="http://www.w3.org/2001/XMLSchema#int">1</aaif:position><aaif:coordinated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:coordinated><aaif:partOfText rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</aaif:partOfText><aaif:syntacticConstruction rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Intransitive" /></aaif:Verb><aaif:Adverb rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En1575Ph1Ad1"><aaif:text>lentas</aaif:text><aaif:lemma rdf:resource="https://gams.uni-graz.at/o:aaif.lemma#lento" /><aaif:position rdf:datatype="http://www.w3.org/2001/XMLSchema#int">2</aaif:position><aaif:coordinated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:coordinated><aaif:morphosyntacticStructure rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Adjective" /><aaif:inflection rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#FemininePlural" /><aaif:attributionTarget rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Verb" /><aaif:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:modified><aaif:semanticClassification rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Manner" /><aaif:reduplicated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:reduplicated><aaif:prepositionalPhrase rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:prepositionalPhrase></aaif:Adverb><aaif:Entry rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En1576"><aaif:phrase rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh#En1576Ph1" /><aaif:source rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh.bibl#Cnde24" /><gams:textualContent>unas matas, y en una de estas matas el maestro ha estado mirando atentamente un respetable coleóptero que subía lento y filosófico .Tiene este personaje seis patas; su cabeza es negra, y negro es el caparazón en</gams:textualContent><rel:isPartOf rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh" /></aaif:Entry><aaif:Phrase rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En1576Ph1"><aaif:verb rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh#En1576Ph1Ve1" /><aaif:adverb rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh#En1576Ph1Ad1" /><aaif:adverb rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh#En1576Ph1Ad2" /><aaif:text>un respetable coleóptero que subía lento y filosófico </aaif:text><aaif:annoText>un respetable coleóptero que [v|subía|subir|is] [a|lento|lento|auvnmnnC] y [a|filosófico|filosófico|ausnmnnC] </aaif:annoText></aaif:Phrase><aaif:Verb rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En1576Ph1Ve1"><aaif:text>subía</aaif:text><aaif:lemma rdf:resource="https://gams.uni-graz.at/o:aaif.lemma#subir" /><aaif:position rdf:datatype="http://www.w3.org/2001/XMLSchema#int">1</aaif:position><aaif:coordinated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:coordinated><aaif:partOfText rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</aaif:partOfText><aaif:syntacticConstruction rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Intransitive" /></aaif:Verb><aaif:Adverb rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En1576Ph1Ad1"><aaif:text>lento</aaif:text><aaif:lemma rdf:resource="https://gams.uni-graz.at/o:aaif.lemma#lento" /><aaif:position rdf:datatype="http://www.w3.org/2001/XMLSchema#int">2</aaif:position><aaif:coordinated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</aaif:coordinated><aaif:morphosyntacticStructure rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Adjective" /><aaif:inflection rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Uninflected" /><aaif:attributionTarget rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Verb" /><aaif:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:modified><aaif:semanticClassification rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Manner" /><aaif:reduplicated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:reduplicated><aaif:prepositionalPhrase rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:prepositionalPhrase></aaif:Adverb><aaif:Adverb rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En1576Ph1Ad2"><aaif:text>filosófico</aaif:text><aaif:lemma rdf:resource="https://gams.uni-graz.at/o:aaif.lemma#filosófico" /><aaif:position rdf:datatype="http://www.w3.org/2001/XMLSchema#int">3</aaif:position><aaif:coordinated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</aaif:coordinated><aaif:morphosyntacticStructure rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Adjective" /><aaif:inflection rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Uninflected" /><aaif:attributionTarget rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Verb" /><aaif:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:modified><aaif:semanticClassification rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Manner" /><aaif:reduplicated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:reduplicated><aaif:prepositionalPhrase rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:prepositionalPhrase></aaif:Adverb><aaif:Entry rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En1577"><aaif:phrase rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh#En1577Ph1" /><aaif:source rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh.bibl#Cnde24" /><gams:textualContent>La llanura se esfuma tétrica.Y en el cielo una enorme nube roja en forma de fantástica nave camina lenta .</gams:textualContent><rel:isPartOf rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh" /></aaif:Entry><aaif:Phrase rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En1577Ph1"><aaif:subject rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh#En1577Ph1Su1" /><aaif:verb rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh#En1577Ph1Ve1" /><aaif:adverb rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh#En1577Ph1Ad1" /><aaif:text>Y en el cielo una enorme nube roja en forma de fantástica nave camina lenta .</aaif:text><aaif:annoText>Y en el cielo [s|una enorme nube roja en forma de fantástica nave|fs] [v|camina|caminar|is] [a|lenta|lento|afvnmnnn] .</aaif:annoText></aaif:Phrase><aaif:Subject rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En1577Ph1Su1"><aaif:text>una enorme nube roja en forma de fantástica nave</aaif:text><aaif:position rdf:datatype="http://www.w3.org/2001/XMLSchema#int">1</aaif:position><aaif:gender rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Feminine" /><aaif:number rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Singular" /><aaif:overt rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</aaif:overt></aaif:Subject><aaif:Verb rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En1577Ph1Ve1"><aaif:text>camina</aaif:text><aaif:lemma rdf:resource="https://gams.uni-graz.at/o:aaif.lemma#caminar" /><aaif:position rdf:datatype="http://www.w3.org/2001/XMLSchema#int">2</aaif:position><aaif:coordinated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:coordinated><aaif:partOfText rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</aaif:partOfText><aaif:syntacticConstruction rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Intransitive" /></aaif:Verb><aaif:Adverb rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En1577Ph1Ad1"><aaif:text>lenta</aaif:text><aaif:lemma rdf:resource="https://gams.uni-graz.at/o:aaif.lemma#lento" /><aaif:position rdf:datatype="http://www.w3.org/2001/XMLSchema#int">3</aaif:position><aaif:coordinated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:coordinated><aaif:morphosyntacticStructure rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Adjective" /><aaif:inflection rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#FeminineSingular" /><aaif:attributionTarget rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Verb" /><aaif:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:modified><aaif:semanticClassification rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Manner" /><aaif:reduplicated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:reduplicated><aaif:prepositionalPhrase rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:prepositionalPhrase></aaif:Adverb><aaif:Entry rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En1578"><aaif:phrase rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh#En1578Ph1" /><aaif:source rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh.bibl#Cnde25" /><gams:textualContent>de repugnancia a la yema batida con azúcar y jerez, y después, que  dos lágrimas se deslizaban , lentas , por las mejillas enflaquecidas.</gams:textualContent><rel:isPartOf rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh" /></aaif:Entry><aaif:Phrase rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En1578Ph1"><aaif:subject rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh#En1578Ph1Su1" /><aaif:verb rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh#En1578Ph1Ve1" /><aaif:adverb rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh#En1578Ph1Ad1" /><aaif:text> dos lágrimas se deslizaban , lentas , por las mejillas enflaquecidas</aaif:text><aaif:annoText> [s|dos lágrimas|fp] se [v|deslizaban|deslizar|rs] , [a|lentas|lento|axsnmnnn] , por las mejillas enflaquecidas</aaif:annoText></aaif:Phrase><aaif:Subject rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En1578Ph1Su1"><aaif:text>dos lágrimas</aaif:text><aaif:position rdf:datatype="http://www.w3.org/2001/XMLSchema#int">1</aaif:position><aaif:gender rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Feminine" /><aaif:number rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Plural" /><aaif:overt rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</aaif:overt></aaif:Subject><aaif:Verb rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En1578Ph1Ve1"><aaif:text>deslizaban</aaif:text><aaif:lemma rdf:resource="https://gams.uni-graz.at/o:aaif.lemma#deslizar" /><aaif:position rdf:datatype="http://www.w3.org/2001/XMLSchema#int">2</aaif:position><aaif:coordinated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:coordinated><aaif:partOfText rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</aaif:partOfText><aaif:syntacticConstruction rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Reflexive" /></aaif:Verb><aaif:Adverb rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En1578Ph1Ad1"><aaif:text>lentas</aaif:text><aaif:lemma rdf:resource="https://gams.uni-graz.at/o:aaif.lemma#lento" /><aaif:position rdf:datatype="http://www.w3.org/2001/XMLSchema#int">3</aaif:position><aaif:coordinated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:coordinated><aaif:morphosyntacticStructure rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Adjective" /><aaif:inflection rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#FemininePlural" /><aaif:attributionTarget rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Verb" /><aaif:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:modified><aaif:semanticClassification rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Manner" /><aaif:reduplicated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:reduplicated><aaif:prepositionalPhrase rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:prepositionalPhrase></aaif:Adverb><aaif:Entry rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En1579"><aaif:phrase rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh#En1579Ph1" /><aaif:source rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh.bibl#Cnde26" /><gams:textualContent>Dominando la arboleda negra, espantosa sobre el cielo de la tarde, una colosal cabeza de león miraba hacia la ciudad.Era una de esas fieras antediluvianas cuyos ejemplares, cada vez más raros, devastaban de tiempo en tiempo los montes Ródopes.* Mas nunca se había visto nada tan monstruoso, pues aquella cabeza dominaba los más altos árboles, mezclando a las hojas teñidas de crepúsculo las greñas de su melena.&lt;lb/&gt;Brillaban claramente sus enormes colmillos, percibíanse sus ojos fruncidos ante la luz, llegaba en el hálito de la brisa su olor bravío.Inmóvil entre la palpitación del follaje, herrumbrada por el sol casi hasta dorarse su gigantesca crin, alzábase ante el horizonte como uno de esos bloques en que el pelasgo, * contemporáneo de las montañas, esculpió sus bárbaras divinidades.&lt;lb/&gt;Y de repente empezó a andar , lento como el océano.Oíase el rumor de la fronda que su pecho apartaba, su aliento de fragua que iba sin duda a estremecer la ciudad cambiándose en rugido.&lt;lb/&gt;A pesar de su fuerza prodigiosa y de su número, los caballos sublevados no resistieron semejante aproximación.Un solo ímpetu los arrastró por la playa, en dirección a la Macedonia, levantando un verdadero huracán de arena y de espuma, pues no pocos disparábanse a través de las olas.</gams:textualContent><rel:isPartOf rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh" /></aaif:Entry><aaif:Phrase rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En1579Ph1"><aaif:verb rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh#En1579Ph1Ve1" /><aaif:adverb rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh#En1579Ph1Ad1" /><aaif:text>de repente empezó a andar , lento como el océano</aaif:text><aaif:annoText>de repente empezó a [v|andar|andar|is] , [a|lento|lento|auvnmnnn] como el océano</aaif:annoText></aaif:Phrase><aaif:Verb rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En1579Ph1Ve1"><aaif:text>andar</aaif:text><aaif:lemma rdf:resource="https://gams.uni-graz.at/o:aaif.lemma#andar" /><aaif:position rdf:datatype="http://www.w3.org/2001/XMLSchema#int">1</aaif:position><aaif:coordinated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:coordinated><aaif:partOfText rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</aaif:partOfText><aaif:syntacticConstruction rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Intransitive" /></aaif:Verb><aaif:Adverb rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En1579Ph1Ad1"><aaif:text>lento</aaif:text><aaif:lemma rdf:resource="https://gams.uni-graz.at/o:aaif.lemma#lento" /><aaif:position rdf:datatype="http://www.w3.org/2001/XMLSchema#int">2</aaif:position><aaif:coordinated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:coordinated><aaif:morphosyntacticStructure rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Adjective" /><aaif:inflection rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Uninflected" /><aaif:attributionTarget rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Verb" /><aaif:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:modified><aaif:semanticClassification rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Manner" /><aaif:reduplicated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:reduplicated><aaif:prepositionalPhrase rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:prepositionalPhrase></aaif:Adverb><aaif:Entry rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En1580"><aaif:phrase rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh#En1580Ph1" /><aaif:source rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh.bibl#Cnde27" /><gams:textualContent>chirriar de hojas secas,&lt;lb/&gt;Y fue como una ráfaga de un frío de ultratierra.&lt;lb/&gt; El sol , rompiendo lento una nube de plata,&lt;lb/&gt;Miróla extrañamente con su pupila extática.&lt;lb/&gt;Pasó...flotó una helada sensación de misterio</gams:textualContent><rel:isPartOf rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh" /></aaif:Entry><aaif:Phrase rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En1580Ph1"><aaif:subject rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh#En1580Ph1Su1" /><aaif:verb rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh#En1580Ph1Ve1" /><aaif:adverb rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh#En1580Ph1Ad1" /><aaif:text> El sol , rompiendo lento una nube de plata,</aaif:text><aaif:annoText> [s|El sol|ms] , [v|rompiendo|romper|ts] [a|lento|lento|auvnmnnn] una nube de plata,</aaif:annoText></aaif:Phrase><aaif:Subject rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En1580Ph1Su1"><aaif:text>El sol</aaif:text><aaif:position rdf:datatype="http://www.w3.org/2001/XMLSchema#int">1</aaif:position><aaif:gender rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Masculine" /><aaif:number rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Singular" /><aaif:overt rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</aaif:overt></aaif:Subject><aaif:Verb rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En1580Ph1Ve1"><aaif:text>rompiendo</aaif:text><aaif:lemma rdf:resource="https://gams.uni-graz.at/o:aaif.lemma#romper" /><aaif:position rdf:datatype="http://www.w3.org/2001/XMLSchema#int">2</aaif:position><aaif:coordinated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:coordinated><aaif:partOfText rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</aaif:partOfText><aaif:syntacticConstruction rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Transitive" /></aaif:Verb><aaif:Adverb rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En1580Ph1Ad1"><aaif:text>lento</aaif:text><aaif:lemma rdf:resource="https://gams.uni-graz.at/o:aaif.lemma#lento" /><aaif:position rdf:datatype="http://www.w3.org/2001/XMLSchema#int">3</aaif:position><aaif:coordinated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:coordinated><aaif:morphosyntacticStructure rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Adjective" /><aaif:inflection rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Uninflected" /><aaif:attributionTarget rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Verb" /><aaif:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:modified><aaif:semanticClassification rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Manner" /><aaif:reduplicated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:reduplicated><aaif:prepositionalPhrase rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:prepositionalPhrase></aaif:Adverb><aaif:Entry rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En1581"><aaif:phrase rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh#En1581Ph1" /><aaif:source rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh.bibl#Cnde28" /><gams:textualContent>Sin darse cuenta, emprendió Melchor el de su era. Iba  lento , obseso con la idea de aquella Petra que tendría que ser ahogada por sus manos.Se detuvo a</gams:textualContent><rel:isPartOf rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh" /></aaif:Entry><aaif:Phrase rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En1581Ph1"><aaif:verb rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh#En1581Ph1Ve1" /><aaif:adverb rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh#En1581Ph1Ad1" /><aaif:text> Iba  lento , obseso con la idea de aquella Petra</aaif:text><aaif:annoText> [v|Iba|ir|is]  [a|lento|lento|auvnmnnn] , obseso con la idea de aquella Petra</aaif:annoText></aaif:Phrase><aaif:Verb rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En1581Ph1Ve1"><aaif:text>Iba</aaif:text><aaif:lemma rdf:resource="https://gams.uni-graz.at/o:aaif.lemma#ir" /><aaif:position rdf:datatype="http://www.w3.org/2001/XMLSchema#int">1</aaif:position><aaif:coordinated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:coordinated><aaif:partOfText rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</aaif:partOfText><aaif:syntacticConstruction rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Intransitive" /></aaif:Verb><aaif:Adverb rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En1581Ph1Ad1"><aaif:text>lento</aaif:text><aaif:lemma rdf:resource="https://gams.uni-graz.at/o:aaif.lemma#lento" /><aaif:position rdf:datatype="http://www.w3.org/2001/XMLSchema#int">2</aaif:position><aaif:coordinated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:coordinated><aaif:morphosyntacticStructure rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Adjective" /><aaif:inflection rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Uninflected" /><aaif:attributionTarget rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Verb" /><aaif:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:modified><aaif:semanticClassification rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Manner" /><aaif:reduplicated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:reduplicated><aaif:prepositionalPhrase rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:prepositionalPhrase></aaif:Adverb><aaif:Entry rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En1582"><aaif:phrase rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh#En1582Ph1" /><aaif:source rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh.bibl#Cnde29" /><gams:textualContent>luto; tú llevas un deseo, nosotros un dolor...»— Y  los tres viejos se alejan , lentos y solemnes , lentos y profundos , arrastrando pesadamente los tres largos mantos negros, como tres martirios...Vuélvense</gams:textualContent><rel:isPartOf rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh" /></aaif:Entry><aaif:Phrase rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En1582Ph1"><aaif:subject rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh#En1582Ph1Su1" /><aaif:verb rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh#En1582Ph1Ve1" /><aaif:adverb rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh#En1582Ph1Ad1" /><aaif:adverb rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh#En1582Ph1Ad2" /><aaif:adverb rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh#En1582Ph1Ad3" /><aaif:text> los tres viejos se alejan , lentos y solemnes , lentos y profundos ,</aaif:text><aaif:annoText> [s|los tres viejos|mp] se [v|alejan|alejar|rs] , [a|lentos|lento|ausnmrnC] y [a|solemnes|solemne|apsnmnnC] , lentos y [a|profundos|profundo|apsnmnnC] ,</aaif:annoText></aaif:Phrase><aaif:Subject rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En1582Ph1Su1"><aaif:text>los tres viejos</aaif:text><aaif:position rdf:datatype="http://www.w3.org/2001/XMLSchema#int">1</aaif:position><aaif:gender rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Masculine" /><aaif:number rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Plural" /><aaif:overt rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</aaif:overt></aaif:Subject><aaif:Verb rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En1582Ph1Ve1"><aaif:text>alejan</aaif:text><aaif:lemma rdf:resource="https://gams.uni-graz.at/o:aaif.lemma#alejar" /><aaif:position rdf:datatype="http://www.w3.org/2001/XMLSchema#int">2</aaif:position><aaif:coordinated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:coordinated><aaif:partOfText rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</aaif:partOfText><aaif:syntacticConstruction rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Reflexive" /></aaif:Verb><aaif:Adverb rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En1582Ph1Ad1"><aaif:text>lentos</aaif:text><aaif:lemma rdf:resource="https://gams.uni-graz.at/o:aaif.lemma#lento" /><aaif:position rdf:datatype="http://www.w3.org/2001/XMLSchema#int">3</aaif:position><aaif:coordinated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</aaif:coordinated><aaif:morphosyntacticStructure rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Adjective" /><aaif:inflection rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Uninflected" /><aaif:attributionTarget rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Verb" /><aaif:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:modified><aaif:semanticClassification rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Manner" /><aaif:reduplicated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</aaif:reduplicated><aaif:prepositionalPhrase rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:prepositionalPhrase></aaif:Adverb><aaif:Adverb rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En1582Ph1Ad2"><aaif:text>solemnes</aaif:text><aaif:lemma rdf:resource="https://gams.uni-graz.at/o:aaif.lemma#solemne" /><aaif:position rdf:datatype="http://www.w3.org/2001/XMLSchema#int">4</aaif:position><aaif:coordinated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</aaif:coordinated><aaif:morphosyntacticStructure rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Adjective" /><aaif:inflection rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#MasculinePlural" /><aaif:attributionTarget rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Verb" /><aaif:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:modified><aaif:semanticClassification rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Manner" /><aaif:reduplicated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:reduplicated><aaif:prepositionalPhrase rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:prepositionalPhrase></aaif:Adverb><aaif:Adverb rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En1582Ph1Ad3"><aaif:text>profundos</aaif:text><aaif:lemma rdf:resource="https://gams.uni-graz.at/o:aaif.lemma#profundo" /><aaif:position rdf:datatype="http://www.w3.org/2001/XMLSchema#int">5</aaif:position><aaif:coordinated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</aaif:coordinated><aaif:morphosyntacticStructure rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Adjective" /><aaif:inflection rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#MasculinePlural" /><aaif:attributionTarget rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Verb" /><aaif:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:modified><aaif:semanticClassification rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Manner" /><aaif:reduplicated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:reduplicated><aaif:prepositionalPhrase rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:prepositionalPhrase></aaif:Adverb><aaif:Entry rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En1583"><aaif:phrase rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh#En1583Ph1" /><aaif:source rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh.bibl#Cnde30" /><gams:textualContent>, en la salita, aparecía ella de improviso por la escalera de mármol, con un farol encendido, andando lenta , imponente y muda .Era, vestida ella.de aquel modo, como si su desnudez se hubiese</gams:textualContent><rel:isPartOf rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh" /></aaif:Entry><aaif:Phrase rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En1583Ph1"><aaif:subject rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh#En1583Ph1Su1" /><aaif:verb rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh#En1583Ph1Ve1" /><aaif:adverb rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh#En1583Ph1Ad1" /><aaif:adverb rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh#En1583Ph1Ad2" /><aaif:adverb rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh#En1583Ph1Ad3" /><aaif:text>aparecía ella de improviso por la escalera de mármol, con un farol encendido, andando lenta , imponente y muda .</aaif:text><aaif:annoText>aparecía [s|ella|fs] de improviso por la escalera de mármol, con un farol encendido, [v|andando|andar|is] [a|lenta|lento|afsnmnnC] , [a|imponente|imponente|ausnmnnC] y [a|muda|mudo|afsnmnnC] .</aaif:annoText></aaif:Phrase><aaif:Subject rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En1583Ph1Su1"><aaif:text>ella</aaif:text><aaif:position rdf:datatype="http://www.w3.org/2001/XMLSchema#int">1</aaif:position><aaif:gender rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Feminine" /><aaif:number rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Singular" /><aaif:overt rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</aaif:overt></aaif:Subject><aaif:Verb rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En1583Ph1Ve1"><aaif:text>andando</aaif:text><aaif:lemma rdf:resource="https://gams.uni-graz.at/o:aaif.lemma#andar" /><aaif:position rdf:datatype="http://www.w3.org/2001/XMLSchema#int">2</aaif:position><aaif:coordinated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:coordinated><aaif:partOfText rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</aaif:partOfText><aaif:syntacticConstruction rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Intransitive" /></aaif:Verb><aaif:Adverb rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En1583Ph1Ad1"><aaif:text>lenta</aaif:text><aaif:lemma rdf:resource="https://gams.uni-graz.at/o:aaif.lemma#lento" /><aaif:position rdf:datatype="http://www.w3.org/2001/XMLSchema#int">3</aaif:position><aaif:coordinated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</aaif:coordinated><aaif:morphosyntacticStructure rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Adjective" /><aaif:inflection rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#FeminineSingular" /><aaif:attributionTarget rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Verb" /><aaif:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:modified><aaif:semanticClassification rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Manner" /><aaif:reduplicated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:reduplicated><aaif:prepositionalPhrase rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:prepositionalPhrase></aaif:Adverb><aaif:Adverb rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En1583Ph1Ad2"><aaif:text>imponente</aaif:text><aaif:lemma rdf:resource="https://gams.uni-graz.at/o:aaif.lemma#imponente" /><aaif:position rdf:datatype="http://www.w3.org/2001/XMLSchema#int">4</aaif:position><aaif:coordinated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</aaif:coordinated><aaif:morphosyntacticStructure rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Adjective" /><aaif:inflection rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Uninflected" /><aaif:attributionTarget rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Verb" /><aaif:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:modified><aaif:semanticClassification rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Manner" /><aaif:reduplicated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:reduplicated><aaif:prepositionalPhrase rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:prepositionalPhrase></aaif:Adverb><aaif:Adverb rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En1583Ph1Ad3"><aaif:text>muda</aaif:text><aaif:lemma rdf:resource="https://gams.uni-graz.at/o:aaif.lemma#mudo" /><aaif:position rdf:datatype="http://www.w3.org/2001/XMLSchema#int">5</aaif:position><aaif:coordinated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</aaif:coordinated><aaif:morphosyntacticStructure rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Adjective" /><aaif:inflection rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#FeminineSingular" /><aaif:attributionTarget rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Verb" /><aaif:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:modified><aaif:semanticClassification rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Manner" /><aaif:reduplicated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:reduplicated><aaif:prepositionalPhrase rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:prepositionalPhrase></aaif:Adverb><aaif:Entry rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En1584"><aaif:phrase rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh#En1584Ph1" /><aaif:source rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh.bibl#Cnde30" /><gams:textualContent>Sí.Yo sé que, a la caída de la tarde, cuando, entre las oropéndolas y los azahares, llego , lento y pensativo , por el naranjal solitario, al pino que arrulla tu muerte, tú, Platero, </gams:textualContent><rel:isPartOf rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh" /></aaif:Entry><aaif:Phrase rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En1584Ph1"><aaif:verb rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh#En1584Ph1Ve1" /><aaif:adverb rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh#En1584Ph1Ad1" /><aaif:adverb rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh#En1584Ph1Ad2" /><aaif:text>a la caída de la tarde, cuando, entre las oropéndolas y los azahares, llego , lento y pensativo , por el naranjal solitario</aaif:text><aaif:annoText>a la caída de la tarde, cuando, entre las oropéndolas y los azahares, [v|llego|llegar|is] , [a|lento|lento|ausnmnnC] y [a|pensativo|pensativo|ausnmnnC] , por el naranjal solitario</aaif:annoText></aaif:Phrase><aaif:Verb rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En1584Ph1Ve1"><aaif:text>llego</aaif:text><aaif:lemma rdf:resource="https://gams.uni-graz.at/o:aaif.lemma#llegar" /><aaif:position rdf:datatype="http://www.w3.org/2001/XMLSchema#int">1</aaif:position><aaif:coordinated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:coordinated><aaif:partOfText rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</aaif:partOfText><aaif:syntacticConstruction rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Intransitive" /></aaif:Verb><aaif:Adverb rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En1584Ph1Ad1"><aaif:text>lento</aaif:text><aaif:lemma rdf:resource="https://gams.uni-graz.at/o:aaif.lemma#lento" /><aaif:position rdf:datatype="http://www.w3.org/2001/XMLSchema#int">2</aaif:position><aaif:coordinated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</aaif:coordinated><aaif:morphosyntacticStructure rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Adjective" /><aaif:inflection rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Uninflected" /><aaif:attributionTarget rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Verb" /><aaif:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:modified><aaif:semanticClassification rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Manner" /><aaif:reduplicated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:reduplicated><aaif:prepositionalPhrase rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:prepositionalPhrase></aaif:Adverb><aaif:Adverb rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En1584Ph1Ad2"><aaif:text>pensativo</aaif:text><aaif:lemma rdf:resource="https://gams.uni-graz.at/o:aaif.lemma#pensativo" /><aaif:position rdf:datatype="http://www.w3.org/2001/XMLSchema#int">3</aaif:position><aaif:coordinated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</aaif:coordinated><aaif:morphosyntacticStructure rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Adjective" /><aaif:inflection rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Uninflected" /><aaif:attributionTarget rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Verb" /><aaif:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:modified><aaif:semanticClassification rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Manner" /><aaif:reduplicated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:reduplicated><aaif:prepositionalPhrase rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:prepositionalPhrase></aaif:Adverb><aaif:Entry rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En1585"><aaif:phrase rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh#En1585Ph1" /><aaif:source rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh.bibl#Cnde30" /><gams:textualContent>me lo dio abierto por la pájina de la muerte de Platero: «Es perfecto», me dijo lento .«Con esta sencillez debía usted escribir siempre.» Volvió a tenderme de pronto su mano también morada como</gams:textualContent><rel:isPartOf rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh" /></aaif:Entry><aaif:Phrase rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En1585Ph1"><aaif:verb rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh#En1585Ph1Ve1" /><aaif:adverb rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh#En1585Ph1Ad1" /><aaif:text>«Es perfecto», me dijo lento </aaif:text><aaif:annoText>«Es perfecto», me [v|dijo|decir|ts] [a|lento|lento|auvnmnnn] </aaif:annoText></aaif:Phrase><aaif:Verb rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En1585Ph1Ve1"><aaif:text>dijo</aaif:text><aaif:lemma rdf:resource="https://gams.uni-graz.at/o:aaif.lemma#decir" /><aaif:position rdf:datatype="http://www.w3.org/2001/XMLSchema#int">1</aaif:position><aaif:coordinated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:coordinated><aaif:partOfText rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</aaif:partOfText><aaif:syntacticConstruction rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Transitive" /></aaif:Verb><aaif:Adverb rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En1585Ph1Ad1"><aaif:text>lento</aaif:text><aaif:lemma rdf:resource="https://gams.uni-graz.at/o:aaif.lemma#lento" /><aaif:position rdf:datatype="http://www.w3.org/2001/XMLSchema#int">2</aaif:position><aaif:coordinated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:coordinated><aaif:morphosyntacticStructure rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Adjective" /><aaif:inflection rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Uninflected" /><aaif:attributionTarget rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Verb" /><aaif:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:modified><aaif:semanticClassification rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Manner" /><aaif:reduplicated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:reduplicated><aaif:prepositionalPhrase rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:prepositionalPhrase></aaif:Adverb><aaif:Entry rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En1586"><aaif:phrase rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh#En1586Ph1" /><aaif:source rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh.bibl#Cnde31" /><gams:textualContent>, apoyando sus enormes perchas en el limo del fondo, y a cuyo impulso las balsas se deslizaban lentas y silenciosas .A su paso, las gaviotas levantaban el vuelo lanzando agudos chillidos, los patos escapaban por</gams:textualContent><rel:isPartOf rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh" /></aaif:Entry><aaif:Phrase rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En1586Ph1"><aaif:subject rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh#En1586Ph1Su1" /><aaif:verb rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh#En1586Ph1Ve1" /><aaif:adverb rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh#En1586Ph1Ad1" /><aaif:adverb rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh#En1586Ph1Ad2" /><aaif:text>a cuyo impulso las balsas se deslizaban lentas y silenciosas .</aaif:text><aaif:annoText>a cuyo impulso [s|las balsas|fp] se [v|deslizaban|deslizar|rs] [a|lentas|lento|axsnmnnC] y [a|silenciosas|silenciosas|axsnmnnC] .</aaif:annoText></aaif:Phrase><aaif:Subject rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En1586Ph1Su1"><aaif:text>las balsas</aaif:text><aaif:position rdf:datatype="http://www.w3.org/2001/XMLSchema#int">1</aaif:position><aaif:gender rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Feminine" /><aaif:number rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Plural" /><aaif:overt rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</aaif:overt></aaif:Subject><aaif:Verb rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En1586Ph1Ve1"><aaif:text>deslizaban</aaif:text><aaif:lemma rdf:resource="https://gams.uni-graz.at/o:aaif.lemma#deslizar" /><aaif:position rdf:datatype="http://www.w3.org/2001/XMLSchema#int">2</aaif:position><aaif:coordinated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:coordinated><aaif:partOfText rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</aaif:partOfText><aaif:syntacticConstruction rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Reflexive" /></aaif:Verb><aaif:Adverb rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En1586Ph1Ad1"><aaif:text>lentas</aaif:text><aaif:lemma rdf:resource="https://gams.uni-graz.at/o:aaif.lemma#lento" /><aaif:position rdf:datatype="http://www.w3.org/2001/XMLSchema#int">3</aaif:position><aaif:coordinated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</aaif:coordinated><aaif:morphosyntacticStructure rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Adjective" /><aaif:inflection rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#FemininePlural" /><aaif:attributionTarget rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Verb" /><aaif:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:modified><aaif:semanticClassification rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Manner" /><aaif:reduplicated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:reduplicated><aaif:prepositionalPhrase rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:prepositionalPhrase></aaif:Adverb><aaif:Adverb rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En1586Ph1Ad2"><aaif:text>silenciosas</aaif:text><aaif:lemma rdf:resource="https://gams.uni-graz.at/o:aaif.lemma#silenciosas" /><aaif:position rdf:datatype="http://www.w3.org/2001/XMLSchema#int">4</aaif:position><aaif:coordinated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</aaif:coordinated><aaif:morphosyntacticStructure rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Adjective" /><aaif:inflection rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#FemininePlural" /><aaif:attributionTarget rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Verb" /><aaif:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:modified><aaif:semanticClassification rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Manner" /><aaif:reduplicated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:reduplicated><aaif:prepositionalPhrase rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:prepositionalPhrase></aaif:Adverb><aaif:Entry rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En1587"><aaif:phrase rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh#En1587Ph1" /><aaif:source rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh.bibl#Cnde32" /><gams:textualContent>paseando y dialogando dos sombras rezagadas, dos amigos en el cortejo fúnebre de Máximo Estrella.Hablan en voz baja y  caminan lentos , parecen almas imbuidas del respeto religioso de la muerte.El uno, viejo caballero con la barba</gams:textualContent><rel:isPartOf rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh" /></aaif:Entry><aaif:Phrase rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En1587Ph1"><aaif:verb rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh#En1587Ph1Ve1" /><aaif:adverb rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh#En1587Ph1Ad1" /><aaif:text>Hablan en voz baja y  caminan lentos </aaif:text><aaif:annoText>Hablan en voz baja y  [v|caminan|caminar|is] [a|lentos|lento|apsnmnnn] </aaif:annoText></aaif:Phrase><aaif:Verb rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En1587Ph1Ve1"><aaif:text>caminan</aaif:text><aaif:lemma rdf:resource="https://gams.uni-graz.at/o:aaif.lemma#caminar" /><aaif:position rdf:datatype="http://www.w3.org/2001/XMLSchema#int">1</aaif:position><aaif:coordinated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:coordinated><aaif:partOfText rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</aaif:partOfText><aaif:syntacticConstruction rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Intransitive" /></aaif:Verb><aaif:Adverb rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En1587Ph1Ad1"><aaif:text>lentos</aaif:text><aaif:lemma rdf:resource="https://gams.uni-graz.at/o:aaif.lemma#lento" /><aaif:position rdf:datatype="http://www.w3.org/2001/XMLSchema#int">2</aaif:position><aaif:coordinated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:coordinated><aaif:morphosyntacticStructure rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Adjective" /><aaif:inflection rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#MasculinePlural" /><aaif:attributionTarget rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Verb" /><aaif:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:modified><aaif:semanticClassification rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Manner" /><aaif:reduplicated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:reduplicated><aaif:prepositionalPhrase rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:prepositionalPhrase></aaif:Adverb><aaif:Entry rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En1588"><aaif:phrase rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh#En1588Ph1" /><aaif:source rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh.bibl#Cnde33" /><gams:textualContent>Esto cuando doña Bárbara viene , lenta , bajo la tenue sombra azul que proyectan los árboles.Y esto mismo cuando se revuelve: la costa</gams:textualContent><rel:isPartOf rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh" /></aaif:Entry><aaif:Phrase rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En1588Ph1"><aaif:subject rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh#En1588Ph1Su1" /><aaif:verb rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh#En1588Ph1Ve1" /><aaif:adverb rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh#En1588Ph1Ad1" /><aaif:text>cuando doña Bárbara viene , lenta , bajo la tenue sombra azul</aaif:text><aaif:annoText>cuando [s|doña Bárbara|fs] [v|viene|venir|is] , [a|lenta|lento|afsnmnnn] , bajo la tenue sombra azul</aaif:annoText></aaif:Phrase><aaif:Subject rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En1588Ph1Su1"><aaif:text>doña Bárbara</aaif:text><aaif:position rdf:datatype="http://www.w3.org/2001/XMLSchema#int">1</aaif:position><aaif:gender rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Feminine" /><aaif:number rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Singular" /><aaif:overt rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</aaif:overt></aaif:Subject><aaif:Verb rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En1588Ph1Ve1"><aaif:text>viene</aaif:text><aaif:lemma rdf:resource="https://gams.uni-graz.at/o:aaif.lemma#venir" /><aaif:position rdf:datatype="http://www.w3.org/2001/XMLSchema#int">2</aaif:position><aaif:coordinated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:coordinated><aaif:partOfText rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</aaif:partOfText><aaif:syntacticConstruction rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Intransitive" /></aaif:Verb><aaif:Adverb rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En1588Ph1Ad1"><aaif:text>lenta</aaif:text><aaif:lemma rdf:resource="https://gams.uni-graz.at/o:aaif.lemma#lento" /><aaif:position rdf:datatype="http://www.w3.org/2001/XMLSchema#int">3</aaif:position><aaif:coordinated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:coordinated><aaif:morphosyntacticStructure rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Adjective" /><aaif:inflection rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#FeminineSingular" /><aaif:attributionTarget rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Verb" /><aaif:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:modified><aaif:semanticClassification rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Manner" /><aaif:reduplicated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:reduplicated><aaif:prepositionalPhrase rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:prepositionalPhrase></aaif:Adverb><aaif:Entry rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En1589"><aaif:phrase rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh#En1589Ph1" /><aaif:source rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh.bibl#Cnde34" /><gams:textualContent>El río tenía un cauce negro, de alquitrán. El agua  iba lenta , desparramada , lisa , de orilla a orilla.Marchaba silencioso, con cautela.Iba como dormido en</gams:textualContent><rel:isPartOf rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh" /></aaif:Entry><aaif:Phrase rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En1589Ph1"><aaif:subject rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh#En1589Ph1Su1" /><aaif:verb rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh#En1589Ph1Ve1" /><aaif:adverb rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh#En1589Ph1Ad1" /><aaif:adverb rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh#En1589Ph1Ad2" /><aaif:adverb rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh#En1589Ph1Ad3" /><aaif:text> El agua  iba lenta , desparramada , lisa , de orilla a orilla.</aaif:text><aaif:annoText> [s|El agua|fs]  [v|iba|ir|is] [a|lenta|lento|afsnmnnC] , [a|desparramada|desparramado|afsnmnnC] , [a|lisa|liso|afsnmnnC] , de orilla a orilla.</aaif:annoText></aaif:Phrase><aaif:Subject rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En1589Ph1Su1"><aaif:text>El agua</aaif:text><aaif:position rdf:datatype="http://www.w3.org/2001/XMLSchema#int">1</aaif:position><aaif:gender rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Feminine" /><aaif:number rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Singular" /><aaif:overt rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</aaif:overt></aaif:Subject><aaif:Verb rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En1589Ph1Ve1"><aaif:text>iba</aaif:text><aaif:lemma rdf:resource="https://gams.uni-graz.at/o:aaif.lemma#ir" /><aaif:position rdf:datatype="http://www.w3.org/2001/XMLSchema#int">2</aaif:position><aaif:coordinated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:coordinated><aaif:partOfText rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</aaif:partOfText><aaif:syntacticConstruction rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Intransitive" /></aaif:Verb><aaif:Adverb rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En1589Ph1Ad1"><aaif:text>lenta</aaif:text><aaif:lemma rdf:resource="https://gams.uni-graz.at/o:aaif.lemma#lento" /><aaif:position rdf:datatype="http://www.w3.org/2001/XMLSchema#int">3</aaif:position><aaif:coordinated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</aaif:coordinated><aaif:morphosyntacticStructure rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Adjective" /><aaif:inflection rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#FeminineSingular" /><aaif:attributionTarget rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Verb" /><aaif:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:modified><aaif:semanticClassification rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Manner" /><aaif:reduplicated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:reduplicated><aaif:prepositionalPhrase rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:prepositionalPhrase></aaif:Adverb><aaif:Adverb rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En1589Ph1Ad2"><aaif:text>desparramada</aaif:text><aaif:lemma rdf:resource="https://gams.uni-graz.at/o:aaif.lemma#desparramado" /><aaif:position rdf:datatype="http://www.w3.org/2001/XMLSchema#int">4</aaif:position><aaif:coordinated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</aaif:coordinated><aaif:morphosyntacticStructure rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Adjective" /><aaif:inflection rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#FeminineSingular" /><aaif:attributionTarget rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Verb" /><aaif:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:modified><aaif:semanticClassification rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Manner" /><aaif:reduplicated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:reduplicated><aaif:prepositionalPhrase rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:prepositionalPhrase></aaif:Adverb><aaif:Adverb rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En1589Ph1Ad3"><aaif:text>lisa</aaif:text><aaif:lemma rdf:resource="https://gams.uni-graz.at/o:aaif.lemma#liso" /><aaif:position rdf:datatype="http://www.w3.org/2001/XMLSchema#int">5</aaif:position><aaif:coordinated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</aaif:coordinated><aaif:morphosyntacticStructure rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Adjective" /><aaif:inflection rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#FeminineSingular" /><aaif:attributionTarget rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Verb" /><aaif:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:modified><aaif:semanticClassification rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Manner" /><aaif:reduplicated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:reduplicated><aaif:prepositionalPhrase rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:prepositionalPhrase></aaif:Adverb><aaif:Entry rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En1590"><aaif:phrase rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh#En1590Ph1" /><aaif:source rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh.bibl#Cnde35" /><gams:textualContent>el follaje, de los árboles, las gentes que iban y venían sin prisa. Su mirada se desplazaba lenta .La plaza Mayor, los conventos, las calles, todas aquellas cosas que lo habían ayudado a descubrir</gams:textualContent><rel:isPartOf rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh" /></aaif:Entry><aaif:Phrase rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En1590Ph1"><aaif:subject rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh#En1590Ph1Su1" /><aaif:verb rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh#En1590Ph1Ve1" /><aaif:adverb rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh#En1590Ph1Ad1" /><aaif:text> Su mirada se desplazaba lenta .</aaif:text><aaif:annoText> [s|Su mirada|fs] se [v|desplazaba|desplazar|rs] [a|lenta|lento|afsnmnnn] .</aaif:annoText></aaif:Phrase><aaif:Subject rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En1590Ph1Su1"><aaif:text>Su mirada</aaif:text><aaif:position rdf:datatype="http://www.w3.org/2001/XMLSchema#int">1</aaif:position><aaif:gender rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Feminine" /><aaif:number rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Singular" /><aaif:overt rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</aaif:overt></aaif:Subject><aaif:Verb rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En1590Ph1Ve1"><aaif:text>desplazaba</aaif:text><aaif:lemma rdf:resource="https://gams.uni-graz.at/o:aaif.lemma#desplazar" /><aaif:position rdf:datatype="http://www.w3.org/2001/XMLSchema#int">2</aaif:position><aaif:coordinated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:coordinated><aaif:partOfText rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</aaif:partOfText><aaif:syntacticConstruction rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Reflexive" /></aaif:Verb><aaif:Adverb rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En1590Ph1Ad1"><aaif:text>lenta</aaif:text><aaif:lemma rdf:resource="https://gams.uni-graz.at/o:aaif.lemma#lento" /><aaif:position rdf:datatype="http://www.w3.org/2001/XMLSchema#int">3</aaif:position><aaif:coordinated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:coordinated><aaif:morphosyntacticStructure rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Adjective" /><aaif:inflection rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#FeminineSingular" /><aaif:attributionTarget rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Verb" /><aaif:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:modified><aaif:semanticClassification rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Manner" /><aaif:reduplicated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:reduplicated><aaif:prepositionalPhrase rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:prepositionalPhrase></aaif:Adverb><aaif:Entry rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En1591"><aaif:phrase rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh#En1591Ph1" /><aaif:source rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh.bibl#Cnde36" /><gams:textualContent>choquezuelas y suspiró.El ruido del coche se perdía entre los mil ruidos de la noche que avanzaba lenta , pausada , numismática .Creyó oír el vuelo de un pájaro.Salvaron una mordida de casas.Ladraban</gams:textualContent><rel:isPartOf rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh" /></aaif:Entry><aaif:Phrase rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En1591Ph1"><aaif:verb rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh#En1591Ph1Ve1" /><aaif:adverb rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh#En1591Ph1Ad1" /><aaif:adverb rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh#En1591Ph1Ad2" /><aaif:adverb rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh#En1591Ph1Ad3" /><aaif:text>El ruido del coche se perdía entre los mil ruidos de la noche que avanzaba lenta , pausada , numismática .</aaif:text><aaif:annoText>El ruido del coche se perdía entre los mil ruidos de la noche que [v|avanzaba|avanzar|is] [a|lenta|lento|afsnmnnC] , [a|pausada|pausado|afsnmnnC] , [a|numismática|numismático|afsnmnnC] .</aaif:annoText></aaif:Phrase><aaif:Verb rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En1591Ph1Ve1"><aaif:text>avanzaba</aaif:text><aaif:lemma rdf:resource="https://gams.uni-graz.at/o:aaif.lemma#avanzar" /><aaif:position rdf:datatype="http://www.w3.org/2001/XMLSchema#int">1</aaif:position><aaif:coordinated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:coordinated><aaif:partOfText rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</aaif:partOfText><aaif:syntacticConstruction rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Intransitive" /></aaif:Verb><aaif:Adverb rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En1591Ph1Ad1"><aaif:text>lenta</aaif:text><aaif:lemma rdf:resource="https://gams.uni-graz.at/o:aaif.lemma#lento" /><aaif:position rdf:datatype="http://www.w3.org/2001/XMLSchema#int">2</aaif:position><aaif:coordinated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</aaif:coordinated><aaif:morphosyntacticStructure rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Adjective" /><aaif:inflection rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#FeminineSingular" /><aaif:attributionTarget rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Verb" /><aaif:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:modified><aaif:semanticClassification rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Manner" /><aaif:reduplicated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:reduplicated><aaif:prepositionalPhrase rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:prepositionalPhrase></aaif:Adverb><aaif:Adverb rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En1591Ph1Ad2"><aaif:text>pausada</aaif:text><aaif:lemma rdf:resource="https://gams.uni-graz.at/o:aaif.lemma#pausado" /><aaif:position rdf:datatype="http://www.w3.org/2001/XMLSchema#int">3</aaif:position><aaif:coordinated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</aaif:coordinated><aaif:morphosyntacticStructure rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Adjective" /><aaif:inflection rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#FeminineSingular" /><aaif:attributionTarget rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Verb" /><aaif:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:modified><aaif:semanticClassification rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Manner" /><aaif:reduplicated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:reduplicated><aaif:prepositionalPhrase rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:prepositionalPhrase></aaif:Adverb><aaif:Adverb rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En1591Ph1Ad3"><aaif:text>numismática</aaif:text><aaif:lemma rdf:resource="https://gams.uni-graz.at/o:aaif.lemma#numismático" /><aaif:position rdf:datatype="http://www.w3.org/2001/XMLSchema#int">4</aaif:position><aaif:coordinated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</aaif:coordinated><aaif:morphosyntacticStructure rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Adjective" /><aaif:inflection rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#FeminineSingular" /><aaif:attributionTarget rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Verb" /><aaif:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:modified><aaif:semanticClassification rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Manner" /><aaif:reduplicated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:reduplicated><aaif:prepositionalPhrase rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:prepositionalPhrase></aaif:Adverb><aaif:Entry rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En1592"><aaif:phrase rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh#En1592Ph1" /><aaif:source rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh.bibl#Cnde37" /><gams:textualContent>Mares tristes,&lt;lb/&gt;apretados,&lt;lb/&gt;mueven&lt;lb/&gt;en él&lt;lb/&gt;sus olas.&lt;lb/&gt; Los paisajes&lt;lb/&gt;del día &lt;lb/&gt;lo navegan &lt;lb/&gt; lentos .&lt;lb/&gt;&lt;lb/&gt;Tímidas,&lt;lb/&gt;las primeras estrellas&lt;lb/&gt;lloran&lt;lb/&gt;su luz insabora&lt;lb/&gt;en la pupila fija.&lt;lb/&gt;En el fondo oscuro&lt;lb/&gt;largas</gams:textualContent><rel:isPartOf rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh" /></aaif:Entry><aaif:Phrase rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En1592Ph1"><aaif:subject rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh#En1592Ph1Su1" /><aaif:verb rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh#En1592Ph1Ve1" /><aaif:adverb rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh#En1592Ph1Ad1" /><aaif:text> Los paisajes&lt;lb\/&gt;del día &lt;lb\/&gt;lo navegan &lt;lb\/&gt; lentos .</aaif:text><aaif:annoText> [s|Los paisajes&lt;lb\/&gt;del día|mp] &lt;lb\/&gt;lo [v|navegan|navegar|ts] &lt;lb\/&gt; [a|lentos|lento|apsnmnnn] .</aaif:annoText></aaif:Phrase><aaif:Subject rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En1592Ph1Su1"><aaif:text>Los paisajes&lt;lb\/&gt;del día</aaif:text><aaif:position rdf:datatype="http://www.w3.org/2001/XMLSchema#int">1</aaif:position><aaif:gender rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Masculine" /><aaif:number rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Plural" /><aaif:overt rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</aaif:overt></aaif:Subject><aaif:Verb rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En1592Ph1Ve1"><aaif:text>navegan</aaif:text><aaif:lemma rdf:resource="https://gams.uni-graz.at/o:aaif.lemma#navegar" /><aaif:position rdf:datatype="http://www.w3.org/2001/XMLSchema#int">2</aaif:position><aaif:coordinated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:coordinated><aaif:partOfText rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</aaif:partOfText><aaif:syntacticConstruction rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Transitive" /></aaif:Verb><aaif:Adverb rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En1592Ph1Ad1"><aaif:text>lentos</aaif:text><aaif:lemma rdf:resource="https://gams.uni-graz.at/o:aaif.lemma#lento" /><aaif:position rdf:datatype="http://www.w3.org/2001/XMLSchema#int">3</aaif:position><aaif:coordinated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:coordinated><aaif:morphosyntacticStructure rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Adjective" /><aaif:inflection rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#MasculinePlural" /><aaif:attributionTarget rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Verb" /><aaif:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:modified><aaif:semanticClassification rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Manner" /><aaif:reduplicated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:reduplicated><aaif:prepositionalPhrase rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:prepositionalPhrase></aaif:Adverb><aaif:Entry rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En1593"><aaif:phrase rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh#En1593Ph1" /><aaif:source rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh.bibl#Cnde37" /><gams:textualContent>ha echado a andar&lt;lb/&gt;también,&lt;lb/&gt;mar adentro.&lt;lb/&gt;con pies&lt;lb/&gt;de felpa.&lt;lb/&gt;¿O lo ha tragado , lento ,&lt;lb/&gt; el bostezo neblinoso&lt;lb/&gt;de la tarde ?...&lt;lb/&gt;Planchadas&lt;lb/&gt;contra el horizonte&lt;lb/&gt;están las chimeneas:&lt;lb/&gt;sus horquillas cazan</gams:textualContent><rel:isPartOf rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh" /></aaif:Entry><aaif:Phrase rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En1593Ph1"><aaif:subject rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh#En1593Ph1Su1" /><aaif:verb rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh#En1593Ph1Ve1" /><aaif:adverb rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh#En1593Ph1Ad1" /><aaif:text>¿O lo ha tragado , lento ,&lt;lb\/&gt; el bostezo neblinoso&lt;lb\/&gt;de la tarde ?</aaif:text><aaif:annoText>¿O lo [v|ha tragado|tragar|ts] , [a|lento|lento|auvnmnnn] ,&lt;lb\/&gt; [s|el bostezo neblinoso&lt;lb\/&gt;de la tarde|ms] ?</aaif:annoText></aaif:Phrase><aaif:Subject rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En1593Ph1Su1"><aaif:text>el bostezo neblinoso&lt;lb\/&gt;de la tarde</aaif:text><aaif:position rdf:datatype="http://www.w3.org/2001/XMLSchema#int">3</aaif:position><aaif:gender rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Masculine" /><aaif:number rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Singular" /><aaif:overt rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</aaif:overt></aaif:Subject><aaif:Verb rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En1593Ph1Ve1"><aaif:text>ha tragado</aaif:text><aaif:lemma rdf:resource="https://gams.uni-graz.at/o:aaif.lemma#tragar" /><aaif:position rdf:datatype="http://www.w3.org/2001/XMLSchema#int">1</aaif:position><aaif:coordinated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:coordinated><aaif:partOfText rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</aaif:partOfText><aaif:syntacticConstruction rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Transitive" /></aaif:Verb><aaif:Adverb rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En1593Ph1Ad1"><aaif:text>lento</aaif:text><aaif:lemma rdf:resource="https://gams.uni-graz.at/o:aaif.lemma#lento" /><aaif:position rdf:datatype="http://www.w3.org/2001/XMLSchema#int">2</aaif:position><aaif:coordinated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:coordinated><aaif:morphosyntacticStructure rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Adjective" /><aaif:inflection rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Uninflected" /><aaif:attributionTarget rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Verb" /><aaif:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:modified><aaif:semanticClassification rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Manner" /><aaif:reduplicated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:reduplicated><aaif:prepositionalPhrase rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:prepositionalPhrase></aaif:Adverb><aaif:Entry rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En1594"><aaif:phrase rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh#En1594Ph1" /><aaif:source rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh.bibl#Cnde38" /><gams:textualContent>Los ojos de Bárbara se han quedado quietos. La luz de la luna sigue manando lenta , invadiendo los rincones, creciendo hasta espaciarse sobre las sábanas, sobre la inmóvil frente pensativa...</gams:textualContent><rel:isPartOf rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh" /></aaif:Entry><aaif:Phrase rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En1594Ph1"><aaif:subject rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh#En1594Ph1Su1" /><aaif:verb rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh#En1594Ph1Ve1" /><aaif:adverb rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh#En1594Ph1Ad1" /><aaif:text> La luz de la luna sigue manando lenta , invadiendo los rincones</aaif:text><aaif:annoText> [s|La luz de la luna|fs] sigue [v|manando|manar|is] [a|lenta|lento|afsnmnnn] , invadiendo los rincones</aaif:annoText></aaif:Phrase><aaif:Subject rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En1594Ph1Su1"><aaif:text>La luz de la luna</aaif:text><aaif:position rdf:datatype="http://www.w3.org/2001/XMLSchema#int">1</aaif:position><aaif:gender rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Feminine" /><aaif:number rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Singular" /><aaif:overt rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</aaif:overt></aaif:Subject><aaif:Verb rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En1594Ph1Ve1"><aaif:text>manando</aaif:text><aaif:lemma rdf:resource="https://gams.uni-graz.at/o:aaif.lemma#manar" /><aaif:position rdf:datatype="http://www.w3.org/2001/XMLSchema#int">2</aaif:position><aaif:coordinated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:coordinated><aaif:partOfText rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</aaif:partOfText><aaif:syntacticConstruction rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Intransitive" /></aaif:Verb><aaif:Adverb rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En1594Ph1Ad1"><aaif:text>lenta</aaif:text><aaif:lemma rdf:resource="https://gams.uni-graz.at/o:aaif.lemma#lento" /><aaif:position rdf:datatype="http://www.w3.org/2001/XMLSchema#int">3</aaif:position><aaif:coordinated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:coordinated><aaif:morphosyntacticStructure rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Adjective" /><aaif:inflection rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#FeminineSingular" /><aaif:attributionTarget rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Verb" /><aaif:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:modified><aaif:semanticClassification rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Manner" /><aaif:reduplicated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:reduplicated><aaif:prepositionalPhrase rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:prepositionalPhrase></aaif:Adverb><aaif:Entry rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En1595"><aaif:phrase rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh#En1595Ph1" /><aaif:source rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh.bibl#Cnde38" /><gams:textualContent>Y Bárbara sacudía lenta su melena ondulada.Y miraba, miraba infinitamente con sus ojos, cada día más anchos, cada día</gams:textualContent><rel:isPartOf rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh" /></aaif:Entry><aaif:Phrase rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En1595Ph1"><aaif:subject rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh#En1595Ph1Su1" /><aaif:verb rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh#En1595Ph1Ve1" /><aaif:adverb rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh#En1595Ph1Ad1" /><aaif:text>Y Bárbara sacudía lenta su melena ondulada.</aaif:text><aaif:annoText>Y [s|Bárbara|fs] [v|sacudía|sacudir|ts] [a|lenta|lento|afvnmnnn] su melena ondulada.</aaif:annoText></aaif:Phrase><aaif:Subject rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En1595Ph1Su1"><aaif:text>Bárbara</aaif:text><aaif:position rdf:datatype="http://www.w3.org/2001/XMLSchema#int">1</aaif:position><aaif:gender rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Feminine" /><aaif:number rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Singular" /><aaif:overt rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</aaif:overt></aaif:Subject><aaif:Verb rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En1595Ph1Ve1"><aaif:text>sacudía</aaif:text><aaif:lemma rdf:resource="https://gams.uni-graz.at/o:aaif.lemma#sacudir" /><aaif:position rdf:datatype="http://www.w3.org/2001/XMLSchema#int">2</aaif:position><aaif:coordinated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:coordinated><aaif:partOfText rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</aaif:partOfText><aaif:syntacticConstruction rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Transitive" /></aaif:Verb><aaif:Adverb rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En1595Ph1Ad1"><aaif:text>lenta</aaif:text><aaif:lemma rdf:resource="https://gams.uni-graz.at/o:aaif.lemma#lento" /><aaif:position rdf:datatype="http://www.w3.org/2001/XMLSchema#int">3</aaif:position><aaif:coordinated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:coordinated><aaif:morphosyntacticStructure rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Adjective" /><aaif:inflection rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#FeminineSingular" /><aaif:attributionTarget rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Verb" /><aaif:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:modified><aaif:semanticClassification rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Manner" /><aaif:reduplicated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:reduplicated><aaif:prepositionalPhrase rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:prepositionalPhrase></aaif:Adverb><aaif:Entry rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En1596"><aaif:phrase rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh#En1596Ph1" /><aaif:source rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh.bibl#Cnde39" /><gams:textualContent>cigarrillo y de la chimenea.&lt;lb/&gt;La noche surge envuelta en su manto de polvo.&lt;lb/&gt; El polvo  asciende , lento .&lt;lb/&gt;Y de un cielo impasible,&lt;lb/&gt;cada vez más cercano y más compacto,&lt;lb/&gt;llueve ceniza.</gams:textualContent><rel:isPartOf rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh" /></aaif:Entry><aaif:Phrase rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En1596Ph1"><aaif:subject rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh#En1596Ph1Su1" /><aaif:verb rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh#En1596Ph1Ve1" /><aaif:adverb rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh#En1596Ph1Ad1" /><aaif:text> El polvo  asciende , lento .</aaif:text><aaif:annoText> [s|El polvo|ms]  [v|asciende|ascender|is] , [a|lento|lento|auvnmnnn] .</aaif:annoText></aaif:Phrase><aaif:Subject rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En1596Ph1Su1"><aaif:text>El polvo</aaif:text><aaif:position rdf:datatype="http://www.w3.org/2001/XMLSchema#int">1</aaif:position><aaif:gender rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Masculine" /><aaif:number rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Singular" /><aaif:overt rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</aaif:overt></aaif:Subject><aaif:Verb rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En1596Ph1Ve1"><aaif:text>asciende</aaif:text><aaif:lemma rdf:resource="https://gams.uni-graz.at/o:aaif.lemma#ascender" /><aaif:position rdf:datatype="http://www.w3.org/2001/XMLSchema#int">2</aaif:position><aaif:coordinated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:coordinated><aaif:partOfText rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</aaif:partOfText><aaif:syntacticConstruction rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Intransitive" /></aaif:Verb><aaif:Adverb rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En1596Ph1Ad1"><aaif:text>lento</aaif:text><aaif:lemma rdf:resource="https://gams.uni-graz.at/o:aaif.lemma#lento" /><aaif:position rdf:datatype="http://www.w3.org/2001/XMLSchema#int">3</aaif:position><aaif:coordinated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:coordinated><aaif:morphosyntacticStructure rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Adjective" /><aaif:inflection rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Uninflected" /><aaif:attributionTarget rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Verb" /><aaif:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:modified><aaif:semanticClassification rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Manner" /><aaif:reduplicated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:reduplicated><aaif:prepositionalPhrase rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:prepositionalPhrase></aaif:Adverb><aaif:Entry rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En1597"><aaif:phrase rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh#En1597Ph1" /><aaif:source rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh.bibl#Cnde40" /><gams:textualContent>Delante de mi pecho&lt;lb/&gt;la mazorcada tienden.&lt;lb/&gt;De la voz y los modos&lt;lb/&gt;gracia tolteca llueve.&lt;lb/&gt; La casta  come lento ,&lt;lb/&gt;como el venado bebe.&lt;lb/&gt;Dorados son el hombre,&lt;lb/&gt;el bocado, el aceite,</gams:textualContent><rel:isPartOf rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh" /></aaif:Entry><aaif:Phrase rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En1597Ph1"><aaif:subject rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh#En1597Ph1Su1" /><aaif:verb rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh#En1597Ph1Ve1" /><aaif:adverb rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh#En1597Ph1Ad1" /><aaif:text> La casta  come lento </aaif:text><aaif:annoText> [s|La casta|fs]  [v|come|comer|is] [a|lento|lento|auvnmnnn] </aaif:annoText></aaif:Phrase><aaif:Subject rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En1597Ph1Su1"><aaif:text>La casta</aaif:text><aaif:position rdf:datatype="http://www.w3.org/2001/XMLSchema#int">1</aaif:position><aaif:gender rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Feminine" /><aaif:number rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Singular" /><aaif:overt rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</aaif:overt></aaif:Subject><aaif:Verb rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En1597Ph1Ve1"><aaif:text>come</aaif:text><aaif:lemma rdf:resource="https://gams.uni-graz.at/o:aaif.lemma#comer" /><aaif:position rdf:datatype="http://www.w3.org/2001/XMLSchema#int">2</aaif:position><aaif:coordinated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:coordinated><aaif:partOfText rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</aaif:partOfText><aaif:syntacticConstruction rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Intransitive" /></aaif:Verb><aaif:Adverb rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En1597Ph1Ad1"><aaif:text>lento</aaif:text><aaif:lemma rdf:resource="https://gams.uni-graz.at/o:aaif.lemma#lento" /><aaif:position rdf:datatype="http://www.w3.org/2001/XMLSchema#int">3</aaif:position><aaif:coordinated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:coordinated><aaif:morphosyntacticStructure rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Adjective" /><aaif:inflection rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Uninflected" /><aaif:attributionTarget rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Verb" /><aaif:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:modified><aaif:semanticClassification rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Manner" /><aaif:reduplicated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:reduplicated><aaif:prepositionalPhrase rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:prepositionalPhrase></aaif:Adverb><aaif:Entry rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En1598"><aaif:phrase rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh#En1598Ph1" /><aaif:source rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh.bibl#Cnde40" /><gams:textualContent>que era mi huerto.&lt;lb/&gt;La miro como la miraba;&lt;lb/&gt;me da un extraño pensamiento,&lt;lb/&gt;Y juego , lenta , con esa agua&lt;lb/&gt;como con pez o con misterio.&lt;lb/&gt;Pienso en umbral donde dejé&lt;lb/&gt;pasos alegres que ya</gams:textualContent><rel:isPartOf rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh" /></aaif:Entry><aaif:Phrase rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En1598Ph1"><aaif:verb rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh#En1598Ph1Ve1" /><aaif:adverb rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh#En1598Ph1Ad1" /><aaif:text>Y juego , lenta , con esa agua&lt;lb\/&gt;como con pez o con misterio.</aaif:text><aaif:annoText>Y [v|juego|jugar|is] , [a|lenta|lento|afsnmnnn] , con esa agua&lt;lb\/&gt;como con pez o con misterio.</aaif:annoText></aaif:Phrase><aaif:Verb rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En1598Ph1Ve1"><aaif:text>juego</aaif:text><aaif:lemma rdf:resource="https://gams.uni-graz.at/o:aaif.lemma#jugar" /><aaif:position rdf:datatype="http://www.w3.org/2001/XMLSchema#int">1</aaif:position><aaif:coordinated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:coordinated><aaif:partOfText rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</aaif:partOfText><aaif:syntacticConstruction rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Intransitive" /></aaif:Verb><aaif:Adverb rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En1598Ph1Ad1"><aaif:text>lenta</aaif:text><aaif:lemma rdf:resource="https://gams.uni-graz.at/o:aaif.lemma#lento" /><aaif:position rdf:datatype="http://www.w3.org/2001/XMLSchema#int">2</aaif:position><aaif:coordinated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:coordinated><aaif:morphosyntacticStructure rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Adjective" /><aaif:inflection rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#FeminineSingular" /><aaif:attributionTarget rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Verb" /><aaif:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:modified><aaif:semanticClassification rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Manner" /><aaif:reduplicated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:reduplicated><aaif:prepositionalPhrase rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:prepositionalPhrase></aaif:Adverb><aaif:Entry rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En1599"><aaif:phrase rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh#En1599Ph1" /><aaif:source rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh.bibl#Cnde41" /><gams:textualContent>: la enfermedad que llevaba en su cuerpo era inexorable; estaba sentenciada y  la hora fatal se fue aproximando lenta pero firme .Así llegó a la postración, a la inercia, a esa triste agonía de los tuberculosos</gams:textualContent><rel:isPartOf rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh" /></aaif:Entry><aaif:Phrase rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En1599Ph1"><aaif:subject rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh#En1599Ph1Su1" /><aaif:verb rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh#En1599Ph1Ve1" /><aaif:adverb rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh#En1599Ph1Ad1" /><aaif:adverb rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh#En1599Ph1Ad2" /><aaif:text> la hora fatal se fue aproximando lenta pero firme .</aaif:text><aaif:annoText> [s|la hora fatal|fs] se fue [v|aproximando|aproximar|rs] [a|lenta|lento|afsnmnnC] pero [a|firme|firme|ausnmnnC] .</aaif:annoText></aaif:Phrase><aaif:Subject rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En1599Ph1Su1"><aaif:text>la hora fatal</aaif:text><aaif:position rdf:datatype="http://www.w3.org/2001/XMLSchema#int">1</aaif:position><aaif:gender rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Feminine" /><aaif:number rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Singular" /><aaif:overt rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</aaif:overt></aaif:Subject><aaif:Verb rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En1599Ph1Ve1"><aaif:text>aproximando</aaif:text><aaif:lemma rdf:resource="https://gams.uni-graz.at/o:aaif.lemma#aproximar" /><aaif:position rdf:datatype="http://www.w3.org/2001/XMLSchema#int">2</aaif:position><aaif:coordinated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:coordinated><aaif:partOfText rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</aaif:partOfText><aaif:syntacticConstruction rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Reflexive" /></aaif:Verb><aaif:Adverb rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En1599Ph1Ad1"><aaif:text>lenta</aaif:text><aaif:lemma rdf:resource="https://gams.uni-graz.at/o:aaif.lemma#lento" /><aaif:position rdf:datatype="http://www.w3.org/2001/XMLSchema#int">3</aaif:position><aaif:coordinated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</aaif:coordinated><aaif:morphosyntacticStructure rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Adjective" /><aaif:inflection rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#FeminineSingular" /><aaif:attributionTarget rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Verb" /><aaif:modified rdf:datatype="http://www.w3.org/2001/XM