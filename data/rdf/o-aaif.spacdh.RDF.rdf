artOf rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh" /></aaif:Entry><aaif:Phrase rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En935Ph1"><aaif:subject rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh#En935Ph1Su1" /><aaif:verb rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh#En935Ph1Ve1" /><aaif:adverb rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh#En935Ph1Ad1" /><aaif:adverb rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh#En935Ph1Ad2" /><aaif:text>En el austero reposo de la cámara episcopal penetraba claro y ancho  el ambiente agrícola </aaif:text><aaif:annoText>En el austero reposo de la cámara episcopal [v|penetraba|penetrar|is] [a|claro|claro|auvnmnnC] y [a|ancho|ancho|auvnlnnC]  [s|el ambiente agrícola|ms] </aaif:annoText></aaif:Phrase><aaif:Subject rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En935Ph1Su1"><aaif:text>el ambiente agrícola</aaif:text><aaif:position rdf:datatype="http://www.w3.org/2001/XMLSchema#int">4</aaif:position><aaif:gender rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Masculine" /><aaif:number rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Singular" /><aaif:overt rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</aaif:overt></aaif:Subject><aaif:Verb rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En935Ph1Ve1"><aaif:text>penetraba</aaif:text><aaif:lemma rdf:resource="https://gams.uni-graz.at/o:aaif.lemma#penetrar" /><aaif:position rdf:datatype="http://www.w3.org/2001/XMLSchema#int">1</aaif:position><aaif:coordinated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:coordinated><aaif:partOfText rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</aaif:partOfText><aaif:syntacticConstruction rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Intransitive" /></aaif:Verb><aaif:Adverb rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En935Ph1Ad1"><aaif:text>claro</aaif:text><aaif:lemma rdf:resource="https://gams.uni-graz.at/o:aaif.lemma#claro" /><aaif:position rdf:datatype="http://www.w3.org/2001/XMLSchema#int">2</aaif:position><aaif:coordinated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</aaif:coordinated><aaif:morphosyntacticStructure rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Adjective" /><aaif:inflection rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Uninflected" /><aaif:attributionTarget rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Verb" /><aaif:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:modified><aaif:semanticClassification rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Manner" /><aaif:reduplicated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:reduplicated><aaif:prepositionalPhrase rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:prepositionalPhrase></aaif:Adverb><aaif:Adverb rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En935Ph1Ad2"><aaif:text>ancho</aaif:text><aaif:lemma rdf:resource="https://gams.uni-graz.at/o:aaif.lemma#ancho" /><aaif:position rdf:datatype="http://www.w3.org/2001/XMLSchema#int">3</aaif:position><aaif:coordinated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</aaif:coordinated><aaif:morphosyntacticStructure rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Adjective" /><aaif:inflection rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Uninflected" /><aaif:attributionTarget rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Verb" /><aaif:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:modified><aaif:semanticClassification rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Location" /><aaif:reduplicated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:reduplicated><aaif:prepositionalPhrase rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:prepositionalPhrase></aaif:Adverb><aaif:Entry rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En936"><aaif:phrase rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh#En936Ph1" /><aaif:source rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh.bibl#Cnde396" /><gams:textualContent>, si no afilas la uña y te sacudes la mangana y la sandez.Soy amiga del hablar claro .Despierta o, desde luego, te auguro que terminaréis, Belarmino y tú, en un asilo de caridad</gams:textualContent><rel:isPartOf rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh" /></aaif:Entry><aaif:Phrase rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En936Ph1"><aaif:verb rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh#En936Ph1Ve1" /><aaif:adverb rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh#En936Ph1Ad1" /><aaif:text>Soy amiga del hablar claro .</aaif:text><aaif:annoText>Soy amiga del [v|hablar|hablar|is] [a|claro|claro|auvnmnnn] .</aaif:annoText></aaif:Phrase><aaif:Verb rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En936Ph1Ve1"><aaif:text>hablar</aaif:text><aaif:lemma rdf:resource="https://gams.uni-graz.at/o:aaif.lemma#hablar" /><aaif:position rdf:datatype="http://www.w3.org/2001/XMLSchema#int">1</aaif:position><aaif:coordinated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:coordinated><aaif:partOfText rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</aaif:partOfText><aaif:syntacticConstruction rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Intransitive" /></aaif:Verb><aaif:Adverb rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En936Ph1Ad1"><aaif:text>claro</aaif:text><aaif:lemma rdf:resource="https://gams.uni-graz.at/o:aaif.lemma#claro" /><aaif:position rdf:datatype="http://www.w3.org/2001/XMLSchema#int">2</aaif:position><aaif:coordinated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:coordinated><aaif:morphosyntacticStructure rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Adjective" /><aaif:inflection rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Uninflected" /><aaif:attributionTarget rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Verb" /><aaif:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:modified><aaif:semanticClassification rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Manner" /><aaif:reduplicated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:reduplicated><aaif:prepositionalPhrase rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:prepositionalPhrase></aaif:Adverb><aaif:Entry rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En937"><aaif:phrase rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh#En937Ph1" /><aaif:source rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh.bibl#Cnde172" /><gams:textualContent>Sin embargo —replicó—, mis compatriotas algo me deben.Pues que usted se va, puedo hablarle claro : he tenido la diplomacia de enamorar a los enemigos, aparentando esgrimir el rebenque para que hubiera un verdugo menos</gams:textualContent><rel:isPartOf rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh" /></aaif:Entry><aaif:Phrase rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En937Ph1"><aaif:verb rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh#En937Ph1Ve1" /><aaif:adverb rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh#En937Ph1Ad1" /><aaif:text>puedo hablarle claro :</aaif:text><aaif:annoText>puedo [v|hablarle|hablar|is] [a|claro|claro|auvnmnnn] :</aaif:annoText></aaif:Phrase><aaif:Verb rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En937Ph1Ve1"><aaif:text>hablarle</aaif:text><aaif:lemma rdf:resource="https://gams.uni-graz.at/o:aaif.lemma#hablar" /><aaif:position rdf:datatype="http://www.w3.org/2001/XMLSchema#int">1</aaif:position><aaif:coordinated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:coordinated><aaif:partOfText rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</aaif:partOfText><aaif:syntacticConstruction rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Intransitive" /></aaif:Verb><aaif:Adverb rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En937Ph1Ad1"><aaif:text>claro</aaif:text><aaif:lemma rdf:resource="https://gams.uni-graz.at/o:aaif.lemma#claro" /><aaif:position rdf:datatype="http://www.w3.org/2001/XMLSchema#int">2</aaif:position><aaif:coordinated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:coordinated><aaif:morphosyntacticStructure rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Adjective" /><aaif:inflection rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Uninflected" /><aaif:attributionTarget rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Verb" /><aaif:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:modified><aaif:semanticClassification rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Manner" /><aaif:reduplicated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:reduplicated><aaif:prepositionalPhrase rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:prepositionalPhrase></aaif:Adverb><aaif:Entry rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En938"><aaif:phrase rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh#En938Ph1" /><aaif:source rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh.bibl#Cnde397" /><gams:textualContent>el ideal.La sencillez del arte nos permite orientarnos mejor en las complejidades de la vida. Veremos  claro , se levantará el día, desaparecerán las incertidumbres, cantarán los pájaros, se alegrará el mundo: llegará</gams:textualContent><rel:isPartOf rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh" /></aaif:Entry><aaif:Phrase rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En938Ph1"><aaif:verb rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh#En938Ph1Ve1" /><aaif:adverb rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh#En938Ph1Ad1" /><aaif:text> Veremos  claro , se levantará el día</aaif:text><aaif:annoText> [v|Veremos|ver|is]  [a|claro|claro|auvnmnnn] , se levantará el día</aaif:annoText></aaif:Phrase><aaif:Verb rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En938Ph1Ve1"><aaif:text>Veremos</aaif:text><aaif:lemma rdf:resource="https://gams.uni-graz.at/o:aaif.lemma#ver" /><aaif:position rdf:datatype="http://www.w3.org/2001/XMLSchema#int">1</aaif:position><aaif:coordinated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:coordinated><aaif:partOfText rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</aaif:partOfText><aaif:syntacticConstruction rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Intransitive" /></aaif:Verb><aaif:Adverb rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En938Ph1Ad1"><aaif:text>claro</aaif:text><aaif:lemma rdf:resource="https://gams.uni-graz.at/o:aaif.lemma#claro" /><aaif:position rdf:datatype="http://www.w3.org/2001/XMLSchema#int">2</aaif:position><aaif:coordinated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:coordinated><aaif:morphosyntacticStructure rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Adjective" /><aaif:inflection rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Uninflected" /><aaif:attributionTarget rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Verb" /><aaif:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:modified><aaif:semanticClassification rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Manner" /><aaif:reduplicated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:reduplicated><aaif:prepositionalPhrase rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:prepositionalPhrase></aaif:Adverb><aaif:Entry rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En939"><aaif:phrase rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh#En939Ph1" /><aaif:source rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh.bibl#Cnde398" /><gams:textualContent>, más o menos reservadas, predicaron varias veces contra los agüeros y las supersticiones; pero ni expusieron bien ni explicaron claro ni concretaron los casos ni los fieles les creyeron.El Padre Lugo, sacerdote seráfico por su bondad e</gams:textualContent><rel:isPartOf rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh" /></aaif:Entry><aaif:Phrase rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En939Ph1"><aaif:verb rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh#En939Ph1Ve1" /><aaif:adverb rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh#En939Ph1Ad1" /><aaif:text>ni expusieron bien ni explicaron claro ni concretaron los casos</aaif:text><aaif:annoText>ni expusieron bien ni [v|explicaron|explicar|is] [a|claro|claro|auvnmnnn] ni concretaron los casos</aaif:annoText></aaif:Phrase><aaif:Verb rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En939Ph1Ve1"><aaif:text>explicaron</aaif:text><aaif:lemma rdf:resource="https://gams.uni-graz.at/o:aaif.lemma#explicar" /><aaif:position rdf:datatype="http://www.w3.org/2001/XMLSchema#int">1</aaif:position><aaif:coordinated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:coordinated><aaif:partOfText rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</aaif:partOfText><aaif:syntacticConstruction rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Intransitive" /></aaif:Verb><aaif:Adverb rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En939Ph1Ad1"><aaif:text>claro</aaif:text><aaif:lemma rdf:resource="https://gams.uni-graz.at/o:aaif.lemma#claro" /><aaif:position rdf:datatype="http://www.w3.org/2001/XMLSchema#int">2</aaif:position><aaif:coordinated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:coordinated><aaif:morphosyntacticStructure rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Adjective" /><aaif:inflection rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Uninflected" /><aaif:attributionTarget rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Verb" /><aaif:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:modified><aaif:semanticClassification rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Manner" /><aaif:reduplicated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:reduplicated><aaif:prepositionalPhrase rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:prepositionalPhrase></aaif:Adverb><aaif:Entry rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En940"><aaif:phrase rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh#En940Ph1" /><aaif:source rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh.bibl#Cnde398" /><gams:textualContent>cómo, cuándo y dónde, y ninguno de los tres profesores sabe decirle nada.Y ahora lo veía claro : era obra de un Ayudado y cada número una brujería.</gams:textualContent><rel:isPartOf rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh" /></aaif:Entry><aaif:Phrase rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En940Ph1"><aaif:verb rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh#En940Ph1Ve1" /><aaif:adverb rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh#En940Ph1Ad1" /><aaif:text>Y ahora lo veía claro :</aaif:text><aaif:annoText>Y ahora lo [v|veía|ver|ts] [a|claro|claro|auvnmnnn] :</aaif:annoText></aaif:Phrase><aaif:Verb rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En940Ph1Ve1"><aaif:text>veía</aaif:text><aaif:lemma rdf:resource="https://gams.uni-graz.at/o:aaif.lemma#ver" /><aaif:position rdf:datatype="http://www.w3.org/2001/XMLSchema#int">1</aaif:position><aaif:coordinated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:coordinated><aaif:partOfText rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</aaif:partOfText><aaif:syntacticConstruction rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Transitive" /></aaif:Verb><aaif:Adverb rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En940Ph1Ad1"><aaif:text>claro</aaif:text><aaif:lemma rdf:resource="https://gams.uni-graz.at/o:aaif.lemma#claro" /><aaif:position rdf:datatype="http://www.w3.org/2001/XMLSchema#int">2</aaif:position><aaif:coordinated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:coordinated><aaif:morphosyntacticStructure rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Adjective" /><aaif:inflection rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Uninflected" /><aaif:attributionTarget rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Verb" /><aaif:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:modified><aaif:semanticClassification rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Manner" /><aaif:reduplicated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:reduplicated><aaif:prepositionalPhrase rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:prepositionalPhrase></aaif:Adverb><aaif:Entry rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En941"><aaif:phrase rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh#En941Ph1" /><aaif:source rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh.bibl#Cnde398" /><gams:textualContent>No hemos comprendido bien sus deseos ni sus intenciones.Ya lo veo claro .Su Majestad no quiere sabios aquí; pero tanta ignorancia, tampoco.Ya voy viendo que las mujeres</gams:textualContent><rel:isPartOf rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh" /></aaif:Entry><aaif:Phrase rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En941Ph1"><aaif:verb rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh#En941Ph1Ve1" /><aaif:adverb rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh#En941Ph1Ad1" /><aaif:text>Ya lo veo claro .</aaif:text><aaif:annoText>Ya lo [v|veo|ver|ts] [a|claro|claro|auvnmnnn] .</aaif:annoText></aaif:Phrase><aaif:Verb rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En941Ph1Ve1"><aaif:text>veo</aaif:text><aaif:lemma rdf:resource="https://gams.uni-graz.at/o:aaif.lemma#ver" /><aaif:position rdf:datatype="http://www.w3.org/2001/XMLSchema#int">1</aaif:position><aaif:coordinated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:coordinated><aaif:partOfText rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</aaif:partOfText><aaif:syntacticConstruction rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Transitive" /></aaif:Verb><aaif:Adverb rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En941Ph1Ad1"><aaif:text>claro</aaif:text><aaif:lemma rdf:resource="https://gams.uni-graz.at/o:aaif.lemma#claro" /><aaif:position rdf:datatype="http://www.w3.org/2001/XMLSchema#int">2</aaif:position><aaif:coordinated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:coordinated><aaif:morphosyntacticStructure rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Adjective" /><aaif:inflection rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Uninflected" /><aaif:attributionTarget rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Verb" /><aaif:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:modified><aaif:semanticClassification rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Manner" /><aaif:reduplicated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:reduplicated><aaif:prepositionalPhrase rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:prepositionalPhrase></aaif:Adverb><aaif:Entry rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En942"><aaif:phrase rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh#En942Ph1" /><aaif:source rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh.bibl#Cnde398" /><gams:textualContent> “Eso es argumentar por hacer ejercicio. La palabra lo dice claro .Si su Majestad la nombró ‘Marquesa de Yolombó’, es para que coja todo el marco de estas</gams:textualContent><rel:isPartOf rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh" /></aaif:Entry><aaif:Phrase rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En942Ph1"><aaif:subject rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh#En942Ph1Su1" /><aaif:verb rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh#En942Ph1Ve1" /><aaif:adverb rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh#En942Ph1Ad1" /><aaif:text> La palabra lo dice claro .</aaif:text><aaif:annoText> [s|La palabra|fs] lo [v|dice|decir|ts] [a|claro|claro|auvnmnnn] .</aaif:annoText></aaif:Phrase><aaif:Subject rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En942Ph1Su1"><aaif:text>La palabra</aaif:text><aaif:position rdf:datatype="http://www.w3.org/2001/XMLSchema#int">1</aaif:position><aaif:gender rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Feminine" /><aaif:number rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Singular" /><aaif:overt rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</aaif:overt></aaif:Subject><aaif:Verb rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En942Ph1Ve1"><aaif:text>dice</aaif:text><aaif:lemma rdf:resource="https://gams.uni-graz.at/o:aaif.lemma#decir" /><aaif:position rdf:datatype="http://www.w3.org/2001/XMLSchema#int">2</aaif:position><aaif:coordinated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:coordinated><aaif:partOfText rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</aaif:partOfText><aaif:syntacticConstruction rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Transitive" /></aaif:Verb><aaif:Adverb rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En942Ph1Ad1"><aaif:text>claro</aaif:text><aaif:lemma rdf:resource="https://gams.uni-graz.at/o:aaif.lemma#claro" /><aaif:position rdf:datatype="http://www.w3.org/2001/XMLSchema#int">3</aaif:position><aaif:coordinated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:coordinated><aaif:morphosyntacticStructure rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Adjective" /><aaif:inflection rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Uninflected" /><aaif:attributionTarget rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Verb" /><aaif:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:modified><aaif:semanticClassification rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Manner" /><aaif:reduplicated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:reduplicated><aaif:prepositionalPhrase rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:prepositionalPhrase></aaif:Adverb><aaif:Entry rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En943"><aaif:phrase rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh#En943Ph1" /><aaif:source rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh.bibl#Cnde33" /><gams:textualContent>Hundió la frente ardorosa entre las manos ateridas y así permaneció largo rato, en silencio y sin pensamientos.Chisporroteó con más fuerza la llama de la lamparilla, ya para extinguirse, y a los oídos alucinados de doña Bárbara llegó clara y distinta esta frase : - Si quieres que él venga a ti, entrega tus obras.</gams:textualContent><rel:isPartOf rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh" /></aaif:Entry><aaif:Phrase rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En943Ph1"><aaif:subject rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh#En943Ph1Su1" /><aaif:verb rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh#En943Ph1Ve1" /><aaif:adverb rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh#En943Ph1Ad1" /><aaif:adverb rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh#En943Ph1Ad2" /><aaif:text>a los oídos alucinados de doña Bárbara llegó clara y distinta esta frase :</aaif:text><aaif:annoText>a los oídos alucinados de doña Bárbara [v|llegó|llegar|is] [a|clara|claro|afsnmnnC] y [a|distinta|distinto|afsnmnnC] [s|esta frase|fs] :</aaif:annoText></aaif:Phrase><aaif:Subject rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En943Ph1Su1"><aaif:text>esta frase</aaif:text><aaif:position rdf:datatype="http://www.w3.org/2001/XMLSchema#int">4</aaif:position><aaif:gender rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Feminine" /><aaif:number rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Singular" /><aaif:overt rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</aaif:overt></aaif:Subject><aaif:Verb rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En943Ph1Ve1"><aaif:text>llegó</aaif:text><aaif:lemma rdf:resource="https://gams.uni-graz.at/o:aaif.lemma#llegar" /><aaif:position rdf:datatype="http://www.w3.org/2001/XMLSchema#int">1</aaif:position><aaif:coordinated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:coordinated><aaif:partOfText rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</aaif:partOfText><aaif:syntacticConstruction rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Intransitive" /></aaif:Verb><aaif:Adverb rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En943Ph1Ad1"><aaif:text>clara</aaif:text><aaif:lemma rdf:resource="https://gams.uni-graz.at/o:aaif.lemma#claro" /><aaif:position rdf:datatype="http://www.w3.org/2001/XMLSchema#int">2</aaif:position><aaif:coordinated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</aaif:coordinated><aaif:morphosyntacticStructure rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Adjective" /><aaif:inflection rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#FeminineSingular" /><aaif:attributionTarget rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Verb" /><aaif:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:modified><aaif:semanticClassification rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Manner" /><aaif:reduplicated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:reduplicated><aaif:prepositionalPhrase rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:prepositionalPhrase></aaif:Adverb><aaif:Adverb rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En943Ph1Ad2"><aaif:text>distinta</aaif:text><aaif:lemma rdf:resource="https://gams.uni-graz.at/o:aaif.lemma#distinto" /><aaif:position rdf:datatype="http://www.w3.org/2001/XMLSchema#int">3</aaif:position><aaif:coordinated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</aaif:coordinated><aaif:morphosyntacticStructure rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Adjective" /><aaif:inflection rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#FeminineSingular" /><aaif:attributionTarget rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Verb" /><aaif:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:modified><aaif:semanticClassification rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Manner" /><aaif:reduplicated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:reduplicated><aaif:prepositionalPhrase rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:prepositionalPhrase></aaif:Adverb><aaif:Entry rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En944"><aaif:phrase rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh#En944Ph1" /><aaif:source rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh.bibl#Cnde33" /><gams:textualContent>, para cuando se le encandile poder seguir sin tropiezo con la remonta del que tenía cerrado y  ve  clarito en lo oscuro.</gams:textualContent><rel:isPartOf rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh" /></aaif:Entry><aaif:Phrase rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En944Ph1"><aaif:verb rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh#En944Ph1Ve1" /><aaif:adverb rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh#En944Ph1Ad1" /><aaif:text> ve  clarito en lo oscuro</aaif:text><aaif:annoText> [v|ve|ver|is]  [a|clarito|claro|auvnmnnn] en lo oscuro</aaif:annoText></aaif:Phrase><aaif:Verb rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En944Ph1Ve1"><aaif:text>ve</aaif:text><aaif:lemma rdf:resource="https://gams.uni-graz.at/o:aaif.lemma#ver" /><aaif:position rdf:datatype="http://www.w3.org/2001/XMLSchema#int">1</aaif:position><aaif:coordinated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:coordinated><aaif:partOfText rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</aaif:partOfText><aaif:syntacticConstruction rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Intransitive" /></aaif:Verb><aaif:Adverb rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En944Ph1Ad1"><aaif:text>clarito</aaif:text><aaif:lemma rdf:resource="https://gams.uni-graz.at/o:aaif.lemma#claro" /><aaif:position rdf:datatype="http://www.w3.org/2001/XMLSchema#int">2</aaif:position><aaif:coordinated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:coordinated><aaif:morphosyntacticStructure rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Adjective" /><aaif:inflection rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Uninflected" /><aaif:attributionTarget rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Verb" /><aaif:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:modified><aaif:semanticClassification rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Manner" /><aaif:reduplicated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:reduplicated><aaif:prepositionalPhrase rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:prepositionalPhrase></aaif:Adverb><aaif:Entry rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En945"><aaif:phrase rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh#En945Ph1" /><aaif:source rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh.bibl#Cnde227" /><gams:textualContent>en Europa; pero era el hecho nativo, constitucional, de América.Piense el lector, para ver clara mi intención, en la conciencia de igualdad jurídica.Ese estado psicológico de sentirse amo y señor de sí</gams:textualContent><rel:isPartOf rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh" /></aaif:Entry><aaif:Phrase rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En945Ph1"><aaif:verb rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh#En945Ph1Ve1" /><aaif:adverb rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh#En945Ph1Ad1" /><aaif:text>Piense el lector, para ver clara mi intención,</aaif:text><aaif:annoText>Piense el lector, para [v|ver|ver|ts] [a|clara|claro|afonmnnn] mi intención,</aaif:annoText></aaif:Phrase><aaif:Verb rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En945Ph1Ve1"><aaif:text>ver</aaif:text><aaif:lemma rdf:resource="https://gams.uni-graz.at/o:aaif.lemma#ver" /><aaif:position rdf:datatype="http://www.w3.org/2001/XMLSchema#int">1</aaif:position><aaif:coordinated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:coordinated><aaif:partOfText rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</aaif:partOfText><aaif:syntacticConstruction rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Transitive" /></aaif:Verb><aaif:Adverb rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En945Ph1Ad1"><aaif:text>clara</aaif:text><aaif:lemma rdf:resource="https://gams.uni-graz.at/o:aaif.lemma#claro" /><aaif:position rdf:datatype="http://www.w3.org/2001/XMLSchema#int">2</aaif:position><aaif:coordinated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:coordinated><aaif:morphosyntacticStructure rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Adjective" /><aaif:inflection rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#FeminineSingular" /><aaif:attributionTarget rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#VerbObject" /><aaif:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:modified><aaif:semanticClassification rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Manner" /><aaif:reduplicated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:reduplicated><aaif:prepositionalPhrase rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:prepositionalPhrase></aaif:Adverb><aaif:Entry rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En946"><aaif:phrase rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh#En946Ph1" /><aaif:source rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh.bibl#Cnde34" /><gams:textualContent>y no necesitamos la luz eléctrica para nada.Usted come de ella y la defiende.Ya se ve claro .¡Pues así se le indigesten los alambres en el estómago!...La luz eléctrica no produce más</gams:textualContent><rel:isPartOf rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh" /></aaif:Entry><aaif:Phrase rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En946Ph1"><aaif:verb rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh#En946Ph1Ve1" /><aaif:adverb rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh#En946Ph1Ad1" /><aaif:text>Ya se ve claro .</aaif:text><aaif:annoText>Ya se [v|ve|ver|rs] [a|claro|claro|auvnmnnn] .</aaif:annoText></aaif:Phrase><aaif:Verb rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En946Ph1Ve1"><aaif:text>ve</aaif:text><aaif:lemma rdf:resource="https://gams.uni-graz.at/o:aaif.lemma#ver" /><aaif:position rdf:datatype="http://www.w3.org/2001/XMLSchema#int">1</aaif:position><aaif:coordinated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:coordinated><aaif:partOfText rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</aaif:partOfText><aaif:syntacticConstruction rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Reflexive" /></aaif:Verb><aaif:Adverb rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En946Ph1Ad1"><aaif:text>claro</aaif:text><aaif:lemma rdf:resource="https://gams.uni-graz.at/o:aaif.lemma#claro" /><aaif:position rdf:datatype="http://www.w3.org/2001/XMLSchema#int">2</aaif:position><aaif:coordinated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:coordinated><aaif:morphosyntacticStructure rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Adjective" /><aaif:inflection rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Uninflected" /><aaif:attributionTarget rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Verb" /><aaif:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:modified><aaif:semanticClassification rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Manner" /><aaif:reduplicated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:reduplicated><aaif:prepositionalPhrase rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:prepositionalPhrase></aaif:Adverb><aaif:Entry rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En947"><aaif:phrase rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh#En947Ph1" /><aaif:source rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh.bibl#Cnde34" /><gams:textualContent>se presentó allí.No hubo tiempo para explicaciones.Hay momentos en que no se necesitan.Se ve claro todo.</gams:textualContent><rel:isPartOf rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh" /></aaif:Entry><aaif:Phrase rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En947Ph1"><aaif:verb rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh#En947Ph1Ve1" /><aaif:adverb rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh#En947Ph1Ad1" /><aaif:text>Se ve claro todo.</aaif:text><aaif:annoText>Se [v|ve|ver|rs] [a|claro|claro|auvnmnnn] todo.</aaif:annoText></aaif:Phrase><aaif:Verb rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En947Ph1Ve1"><aaif:text>ve</aaif:text><aaif:lemma rdf:resource="https://gams.uni-graz.at/o:aaif.lemma#ver" /><aaif:position rdf:datatype="http://www.w3.org/2001/XMLSchema#int">1</aaif:position><aaif:coordinated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:coordinated><aaif:partOfText rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</aaif:partOfText><aaif:syntacticConstruction rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Reflexive" /></aaif:Verb><aaif:Adverb rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En947Ph1Ad1"><aaif:text>claro</aaif:text><aaif:lemma rdf:resource="https://gams.uni-graz.at/o:aaif.lemma#claro" /><aaif:position rdf:datatype="http://www.w3.org/2001/XMLSchema#int">2</aaif:position><aaif:coordinated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:coordinated><aaif:morphosyntacticStructure rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Adjective" /><aaif:inflection rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Uninflected" /><aaif:attributionTarget rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Verb" /><aaif:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:modified><aaif:semanticClassification rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Manner" /><aaif:reduplicated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:reduplicated><aaif:prepositionalPhrase rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:prepositionalPhrase></aaif:Adverb><aaif:Entry rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En948"><aaif:phrase rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh#En948Ph1" /><aaif:source rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh.bibl#Cnde255" /><gams:textualContent>primeras.Y yo, en aquel momento, estaba dominado por una impaciencia loca, que me impedía ver claro hasta qué punto había quedado ella contrariada por mi incomprensión.Pero me esforzaba en contenerla, sin atreverme a</gams:textualContent><rel:isPartOf rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh" /></aaif:Entry><aaif:Phrase rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En948Ph1"><aaif:verb rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh#En948Ph1Ve1" /><aaif:adverb rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh#En948Ph1Ad1" /><aaif:text>una impaciencia loca, que me impedía ver claro hasta qué punto había quedado ella contrariada por mi incomprensión</aaif:text><aaif:annoText>una impaciencia loca, que me impedía [v|ver|ver|ts] [a|claro|claro|auvnmnnn] hasta qué punto había quedado ella contrariada por mi incomprensión</aaif:annoText></aaif:Phrase><aaif:Verb rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En948Ph1Ve1"><aaif:text>ver</aaif:text><aaif:lemma rdf:resource="https://gams.uni-graz.at/o:aaif.lemma#ver" /><aaif:position rdf:datatype="http://www.w3.org/2001/XMLSchema#int">1</aaif:position><aaif:coordinated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:coordinated><aaif:partOfText rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</aaif:partOfText><aaif:syntacticConstruction rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Transitive" /></aaif:Verb><aaif:Adverb rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En948Ph1Ad1"><aaif:text>claro</aaif:text><aaif:lemma rdf:resource="https://gams.uni-graz.at/o:aaif.lemma#claro" /><aaif:position rdf:datatype="http://www.w3.org/2001/XMLSchema#int">2</aaif:position><aaif:coordinated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:coordinated><aaif:morphosyntacticStructure rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Adjective" /><aaif:inflection rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Uninflected" /><aaif:attributionTarget rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Verb" /><aaif:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:modified><aaif:semanticClassification rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Manner" /><aaif:reduplicated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:reduplicated><aaif:prepositionalPhrase rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:prepositionalPhrase></aaif:Adverb><aaif:Entry rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En949"><aaif:phrase rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh#En949Ph1" /><aaif:source rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh.bibl#Cnde255" /><gams:textualContent>Con trabajo encuentro en rincones casi inaccesibles de mi psique elementos para concebir clara la idea del suicidio.Creo que al querer delinear su curva no podré lograr el definitivo descenso</gams:textualContent><rel:isPartOf rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh" /></aaif:Entry><aaif:Phrase rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En949Ph1"><aaif:verb rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh#En949Ph1Ve1" /><aaif:adverb rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh#En949Ph1Ad1" /><aaif:text>elementos para concebir clara la idea del suicidio</aaif:text><aaif:annoText>elementos para [v|concebir|concebir|ts] [a|clara|claro|afonmnnn] la idea del suicidio</aaif:annoText></aaif:Phrase><aaif:Verb rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En949Ph1Ve1"><aaif:text>concebir</aaif:text><aaif:lemma rdf:resource="https://gams.uni-graz.at/o:aaif.lemma#concebir" /><aaif:position rdf:datatype="http://www.w3.org/2001/XMLSchema#int">1</aaif:position><aaif:coordinated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:coordinated><aaif:partOfText rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</aaif:partOfText><aaif:syntacticConstruction rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Transitive" /></aaif:Verb><aaif:Adverb rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En949Ph1Ad1"><aaif:text>clara</aaif:text><aaif:lemma rdf:resource="https://gams.uni-graz.at/o:aaif.lemma#claro" /><aaif:position rdf:datatype="http://www.w3.org/2001/XMLSchema#int">2</aaif:position><aaif:coordinated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:coordinated><aaif:morphosyntacticStructure rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Adjective" /><aaif:inflection rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#FeminineSingular" /><aaif:attributionTarget rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#VerbObject" /><aaif:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:modified><aaif:semanticClassification rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Manner" /><aaif:reduplicated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:reduplicated><aaif:prepositionalPhrase rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:prepositionalPhrase></aaif:Adverb><aaif:Entry rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En950"><aaif:phrase rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh#En950Ph1" /><aaif:source rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh.bibl#Cnde228" /><gams:textualContent>Chinchibirín Si te gano la partida, mi flecha te dará muerte y antes de que te enfríes por completo, te tomaré como un penacho de plumas de colores para sacudir el polvo de tus palabras engañadoras de los ríos y los lagos que ya no se ven claros como antes. &lt;lb/&gt; Huvaravix (Invisible).Soy todo oídos.Cada una de las hojas de estos árboles es una oreja mía.No perderé una sola palabra.</gams:textualContent><rel:isPartOf rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh" /></aaif:Entry><aaif:Phrase rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En950Ph1"><aaif:verb rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh#En950Ph1Ve1" /><aaif:adverb rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh#En950Ph1Ad1" /><aaif:text>de los ríos y los lagos que ya no se ven claros como antes.</aaif:text><aaif:annoText>de los ríos y los lagos que ya no se [v|ven|ver|rs] [a|claros|claro|apsnmnnn] como antes.</aaif:annoText></aaif:Phrase><aaif:Verb rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En950Ph1Ve1"><aaif:text>ven</aaif:text><aaif:lemma rdf:resource="https://gams.uni-graz.at/o:aaif.lemma#ver" /><aaif:position rdf:datatype="http://www.w3.org/2001/XMLSchema#int">1</aaif:position><aaif:coordinated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:coordinated><aaif:partOfText rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</aaif:partOfText><aaif:syntacticConstruction rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Reflexive" /></aaif:Verb><aaif:Adverb rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En950Ph1Ad1"><aaif:text>claros</aaif:text><aaif:lemma rdf:resource="https://gams.uni-graz.at/o:aaif.lemma#claro" /><aaif:position rdf:datatype="http://www.w3.org/2001/XMLSchema#int">2</aaif:position><aaif:coordinated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:coordinated><aaif:morphosyntacticStructure rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Adjective" /><aaif:inflection rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#MasculinePlural" /><aaif:attributionTarget rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Verb" /><aaif:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:modified><aaif:semanticClassification rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Manner" /><aaif:reduplicated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:reduplicated><aaif:prepositionalPhrase rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:prepositionalPhrase></aaif:Adverb><aaif:Entry rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En951"><aaif:phrase rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh#En951Ph1" /><aaif:source rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh.bibl#Cnde35" /><gams:textualContent>Por último, como si se lo estuvieran diciendo bajo el oído, se le reveló claro el sentido de las palabras.</gams:textualContent><rel:isPartOf rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh" /></aaif:Entry><aaif:Phrase rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En951Ph1"><aaif:verb rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh#En951Ph1Ve1" /><aaif:adverb rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh#En951Ph1Ad1" /><aaif:text>se le reveló claro el sentido de las palabras</aaif:text><aaif:annoText>se le [v|reveló|revelar|rs] [a|claro|claro|auonmnnn] el sentido de las palabras</aaif:annoText></aaif:Phrase><aaif:Verb rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En951Ph1Ve1"><aaif:text>reveló</aaif:text><aaif:lemma rdf:resource="https://gams.uni-graz.at/o:aaif.lemma#revelar" /><aaif:position rdf:datatype="http://www.w3.org/2001/XMLSchema#int">1</aaif:position><aaif:coordinated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:coordinated><aaif:partOfText rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</aaif:partOfText><aaif:syntacticConstruction rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Reflexive" /></aaif:Verb><aaif:Adverb rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En951Ph1Ad1"><aaif:text>claro</aaif:text><aaif:lemma rdf:resource="https://gams.uni-graz.at/o:aaif.lemma#claro" /><aaif:position rdf:datatype="http://www.w3.org/2001/XMLSchema#int">2</aaif:position><aaif:coordinated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:coordinated><aaif:morphosyntacticStructure rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Adjective" /><aaif:inflection rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Uninflected" /><aaif:attributionTarget rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#VerbObject" /><aaif:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:modified><aaif:semanticClassification rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Manner" /><aaif:reduplicated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:reduplicated><aaif:prepositionalPhrase rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:prepositionalPhrase></aaif:Adverb><aaif:Entry rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En952"><aaif:phrase rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh#En952Ph1" /><aaif:source rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh.bibl#Cnde256" /><gams:textualContent>«te voy a pegar ese botón», pero de ai no pasa.A mí me lo dijo clarito no má.«Amigos, güeno, pero si pretendés otra cosa apuntá pa’ otro lau.»</gams:textualContent><rel:isPartOf rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh" /></aaif:Entry><aaif:Phrase rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En952Ph1"><aaif:verb rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh#En952Ph1Ve1" /><aaif:adverb rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh#En952Ph1Ad1" /><aaif:text>A mí me lo dijo clarito no má.</aaif:text><aaif:annoText>A mí me lo [v|dijo|decir|ts] [a|clarito|claro|auvnmnnn] no má.</aaif:annoText></aaif:Phrase><aaif:Verb rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En952Ph1Ve1"><aaif:text>dijo</aaif:text><aaif:lemma rdf:resource="https://gams.uni-graz.at/o:aaif.lemma#decir" /><aaif:position rdf:datatype="http://www.w3.org/2001/XMLSchema#int">1</aaif:position><aaif:coordinated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:coordinated><aaif:partOfText rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</aaif:partOfText><aaif:syntacticConstruction rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Transitive" /></aaif:Verb><aaif:Adverb rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En952Ph1Ad1"><aaif:text>clarito</aaif:text><aaif:lemma rdf:resource="https://gams.uni-graz.at/o:aaif.lemma#claro" /><aaif:position rdf:datatype="http://www.w3.org/2001/XMLSchema#int">2</aaif:position><aaif:coordinated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:coordinated><aaif:morphosyntacticStructure rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Adjective" /><aaif:inflection rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Uninflected" /><aaif:attributionTarget rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Verb" /><aaif:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:modified><aaif:semanticClassification rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Manner" /><aaif:reduplicated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:reduplicated><aaif:prepositionalPhrase rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:prepositionalPhrase></aaif:Adverb><aaif:Entry rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En953"><aaif:phrase rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh#En953Ph1" /><aaif:source rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh.bibl#Cnde256" /><gams:textualContent>Te conosco la renguera.Hase tiempo que andas a las agachadas.Aquí tás entre machos, hablá clarito .</gams:textualContent><rel:isPartOf rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh" /></aaif:Entry><aaif:Phrase rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En953Ph1"><aaif:verb rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh#En953Ph1Ve1" /><aaif:adverb rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh#En953Ph1Ad1" /><aaif:text>Aquí tás entre machos, hablá clarito .</aaif:text><aaif:annoText>Aquí tás entre machos, [v|hablá|hablar|is] [a|clarito|claro|auvnmnnn] .</aaif:annoText></aaif:Phrase><aaif:Verb rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En953Ph1Ve1"><aaif:text>hablá</aaif:text><aaif:lemma rdf:resource="https://gams.uni-graz.at/o:aaif.lemma#hablar" /><aaif:position rdf:datatype="http://www.w3.org/2001/XMLSchema#int">1</aaif:position><aaif:coordinated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:coordinated><aaif:partOfText rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</aaif:partOfText><aaif:syntacticConstruction rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Intransitive" /></aaif:Verb><aaif:Adverb rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En953Ph1Ad1"><aaif:text>clarito</aaif:text><aaif:lemma rdf:resource="https://gams.uni-graz.at/o:aaif.lemma#claro" /><aaif:position rdf:datatype="http://www.w3.org/2001/XMLSchema#int">2</aaif:position><aaif:coordinated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:coordinated><aaif:morphosyntacticStructure rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Adjective" /><aaif:inflection rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Uninflected" /><aaif:attributionTarget rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Verb" /><aaif:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:modified><aaif:semanticClassification rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Manner" /><aaif:reduplicated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:reduplicated><aaif:prepositionalPhrase rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:prepositionalPhrase></aaif:Adverb><aaif:Entry rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En954"><aaif:phrase rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh#En954Ph1" /><aaif:source rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh.bibl#Cnde256" /><gams:textualContent>Salieron de la cocina, en comitiva caminaron unos cien pasos en dirección a la Tapera, hasta ver clarita la luz de Casilda.</gams:textualContent><rel:isPartOf rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh" /></aaif:Entry><aaif:Phrase rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En954Ph1"><aaif:verb rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh#En954Ph1Ve1" /><aaif:adverb rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh#En954Ph1Ad1" /><aaif:text>hasta ver clarita la luz de Casilda</aaif:text><aaif:annoText>hasta [v|ver|ver|ts] [a|clarita|claro|afonmnnn] la luz de Casilda</aaif:annoText></aaif:Phrase><aaif:Verb rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En954Ph1Ve1"><aaif:text>ver</aaif:text><aaif:lemma rdf:resource="https://gams.uni-graz.at/o:aaif.lemma#ver" /><aaif:position rdf:datatype="http://www.w3.org/2001/XMLSchema#int">1</aaif:position><aaif:coordinated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:coordinated><aaif:partOfText rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</aaif:partOfText><aaif:syntacticConstruction rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Transitive" /></aaif:Verb><aaif:Adverb rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En954Ph1Ad1"><aaif:text>clarita</aaif:text><aaif:lemma rdf:resource="https://gams.uni-graz.at/o:aaif.lemma#claro" /><aaif:position rdf:datatype="http://www.w3.org/2001/XMLSchema#int">2</aaif:position><aaif:coordinated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:coordinated><aaif:morphosyntacticStructure rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Adjective" /><aaif:inflection rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#FeminineSingular" /><aaif:attributionTarget rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#VerbObject" /><aaif:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:modified><aaif:semanticClassification rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Manner" /><aaif:reduplicated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:reduplicated><aaif:prepositionalPhrase rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:prepositionalPhrase></aaif:Adverb><aaif:Entry rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En955"><aaif:phrase rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh#En955Ph1" /><aaif:source rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh.bibl#Cnde256" /><gams:textualContent>Temo que la tome a mal.... pero puesto que usté l’ordena le hablaré clarito .Mire, compadre, tuitas las chinas son de la mesma laya.La má mansita, patea.</gams:textualContent><rel:isPartOf rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh" /></aaif:Entry><aaif:Phrase rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En955Ph1"><aaif:verb rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh#En955Ph1Ve1" /><aaif:adverb rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh#En955Ph1Ad1" /><aaif:text>puesto que usté l’ordena le hablaré clarito </aaif:text><aaif:annoText>puesto que usté l’ordena le [v|hablaré|hablar|is] [a|clarito|claro|auvnmnnn] </aaif:annoText></aaif:Phrase><aaif:Verb rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En955Ph1Ve1"><aaif:text>hablaré</aaif:text><aaif:lemma rdf:resource="https://gams.uni-graz.at/o:aaif.lemma#hablar" /><aaif:position rdf:datatype="http://www.w3.org/2001/XMLSchema#int">1</aaif:position><aaif:coordinated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:coordinated><aaif:partOfText rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</aaif:partOfText><aaif:syntacticConstruction rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Intransitive" /></aaif:Verb><aaif:Adverb rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En955Ph1Ad1"><aaif:text>clarito</aaif:text><aaif:lemma rdf:resource="https://gams.uni-graz.at/o:aaif.lemma#claro" /><aaif:position rdf:datatype="http://www.w3.org/2001/XMLSchema#int">2</aaif:position><aaif:coordinated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:coordinated><aaif:morphosyntacticStructure rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Adjective" /><aaif:inflection rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Uninflected" /><aaif:attributionTarget rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Verb" /><aaif:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:modified><aaif:semanticClassification rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Manner" /><aaif:reduplicated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:reduplicated><aaif:prepositionalPhrase rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:prepositionalPhrase></aaif:Adverb><aaif:Entry rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En956"><aaif:phrase rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh#En956Ph1" /><aaif:source rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh.bibl#Cnde36" /><gams:textualContent>¡ Hablá  claro , por amor de Dios!</gams:textualContent><rel:isPartOf rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh" /></aaif:Entry><aaif:Phrase rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En956Ph1"><aaif:verb rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh#En956Ph1Ve1" /><aaif:adverb rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh#En956Ph1Ad1" /><aaif:text>¡ Hablá  claro , por amor de Dios!</aaif:text><aaif:annoText>¡ [v|Hablá|hablar|is]  [a|claro|claro|auvnmnnn] , por amor de Dios!</aaif:annoText></aaif:Phrase><aaif:Verb rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En956Ph1Ve1"><aaif:text>Hablá</aaif:text><aaif:lemma rdf:resource="https://gams.uni-graz.at/o:aaif.lemma#hablar" /><aaif:position rdf:datatype="http://www.w3.org/2001/XMLSchema#int">1</aaif:position><aaif:coordinated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:coordinated><aaif:partOfText rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</aaif:partOfText><aaif:syntacticConstruction rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Intransitive" /></aaif:Verb><aaif:Adverb rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En956Ph1Ad1"><aaif:text>claro</aaif:text><aaif:lemma rdf:resource="https://gams.uni-graz.at/o:aaif.lemma#claro" /><aaif:position rdf:datatype="http://www.w3.org/2001/XMLSchema#int">2</aaif:position><aaif:coordinated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:coordinated><aaif:morphosyntacticStructure rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Adjective" /><aaif:inflection rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Uninflected" /><aaif:attributionTarget rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Verb" /><aaif:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:modified><aaif:semanticClassification rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Manner" /><aaif:reduplicated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:reduplicated><aaif:prepositionalPhrase rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:prepositionalPhrase></aaif:Adverb><aaif:Entry rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En957"><aaif:phrase rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh#En957Ph1" /><aaif:source rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh.bibl#Cnde36" /><gams:textualContent>oídos del patrón esas cosas y ya tuvo usted para no divertirse mucho.Debe aprovechar ahora y decirle claro lo que es y lo que no es; vaya una ocasión con más pelo que un elote.</gams:textualContent><rel:isPartOf rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh" /></aaif:Entry><aaif:Phrase rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En957Ph1"><aaif:verb rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh#En957Ph1Ve1" /><aaif:adverb rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh#En957Ph1Ad1" /><aaif:text>Debe aprovechar ahora y decirle claro lo que es y lo que no es</aaif:text><aaif:annoText>Debe aprovechar ahora y [v|decirle|decir|ts] [a|claro|claro|auvnmnnn] lo que es y lo que no es</aaif:annoText></aaif:Phrase><aaif:Verb rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En957Ph1Ve1"><aaif:text>decirle</aaif:text><aaif:lemma rdf:resource="https://gams.uni-graz.at/o:aaif.lemma#decir" /><aaif:position rdf:datatype="http://www.w3.org/2001/XMLSchema#int">1</aaif:position><aaif:coordinated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:coordinated><aaif:partOfText rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</aaif:partOfText><aaif:syntacticConstruction rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Transitive" /></aaif:Verb><aaif:Adverb rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En957Ph1Ad1"><aaif:text>claro</aaif:text><aaif:lemma rdf:resource="https://gams.uni-graz.at/o:aaif.lemma#claro" /><aaif:position rdf:datatype="http://www.w3.org/2001/XMLSchema#int">2</aaif:position><aaif:coordinated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:coordinated><aaif:morphosyntacticStructure rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Adjective" /><aaif:inflection rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Uninflected" /><aaif:attributionTarget rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Verb" /><aaif:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:modified><aaif:semanticClassification rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Manner" /><aaif:reduplicated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:reduplicated><aaif:prepositionalPhrase rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:prepositionalPhrase></aaif:Adverb><aaif:Entry rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En958"><aaif:phrase rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh#En958Ph1" /><aaif:source rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh.bibl#Cnde399" /><gams:textualContent>Cuando estaba aún el Capitán Beers en los Estados Unidos, “ la mayor parte de los panameños parecía ver claro lo que para mí lo fue desde el principio.Distintas personas, reiteradas veces, se me acercaron solicitando</gams:textualContent><rel:isPartOf rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh" /></aaif:Entry><aaif:Phrase rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En958Ph1"><aaif:subject rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh#En958Ph1Su1" /><aaif:verb rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh#En958Ph1Ve1" /><aaif:adverb rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh#En958Ph1Ad1" /><aaif:text> la mayor parte de los panameños parecía ver claro lo que para mí lo fue desde el principio</aaif:text><aaif:annoText> [s|la mayor parte de los panameños|fs] parecía [v|ver|ver|ts] [a|claro|claro|auvnmnnn] lo que para mí lo fue desde el principio</aaif:annoText></aaif:Phrase><aaif:Subject rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En958Ph1Su1"><aaif:text>la mayor parte de los panameños</aaif:text><aaif:position rdf:datatype="http://www.w3.org/2001/XMLSchema#int">1</aaif:position><aaif:gender rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Feminine" /><aaif:number rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Singular" /><aaif:overt rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</aaif:overt></aaif:Subject><aaif:Verb rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En958Ph1Ve1"><aaif:text>ver</aaif:text><aaif:lemma rdf:resource="https://gams.uni-graz.at/o:aaif.lemma#ver" /><aaif:position rdf:datatype="http://www.w3.org/2001/XMLSchema#int">2</aaif:position><aaif:coordinated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:coordinated><aaif:partOfText rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</aaif:partOfText><aaif:syntacticConstruction rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Transitive" /></aaif:Verb><aaif:Adverb rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En958Ph1Ad1"><aaif:text>claro</aaif:text><aaif:lemma rdf:resource="https://gams.uni-graz.at/o:aaif.lemma#claro" /><aaif:position rdf:datatype="http://www.w3.org/2001/XMLSchema#int">3</aaif:position><aaif:coordinated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:coordinated><aaif:morphosyntacticStructure rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Adjective" /><aaif:inflection rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Uninflected" /><aaif:attributionTarget rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Verb" /><aaif:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:modified><aaif:semanticClassification rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Manner" /><aaif:reduplicated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:reduplicated><aaif:prepositionalPhrase rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:prepositionalPhrase></aaif:Adverb><aaif:Entry rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En959"><aaif:phrase rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh#En959Ph1" /><aaif:source rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh.bibl#Cnde399" /><gams:textualContent>mucho tiempo médico de su batallón, que le siguiera tratando de estos asuntos. El Dr. Amador  habló bastante claro al General Huertas para que supiera del plan separatista que estaban desarrollando, pero no se atrevió a solicitarle</gams:textualContent><rel:isPartOf rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh" /></aaif:Entry><aaif:Phrase rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En959Ph1"><aaif:subject rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh#En959Ph1Su1" /><aaif:verb rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh#En959Ph1Ve1" /><aaif:adverb rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh#En959Ph1Ad1" /><aaif:text> El Dr. Amador  habló bastante claro al General Huertas</aaif:text><aaif:annoText> [s|El Dr. Amador|ms]  [v|habló|hablar|is] bastante [a|claro|claro|auvmmnnn] al General Huertas</aaif:annoText></aaif:Phrase><aaif:Subject rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En959Ph1Su1"><aaif:text>El Dr. Amador</aaif:text><aaif:position rdf:datatype="http://www.w3.org/2001/XMLSchema#int">1</aaif:position><aaif:gender rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Masculine" /><aaif:number rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Singular" /><aaif:overt rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</aaif:overt></aaif:Subject><aaif:Verb rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En959Ph1Ve1"><aaif:text>habló</aaif:text><aaif:lemma rdf:resource="https://gams.uni-graz.at/o:aaif.lemma#hablar" /><aaif:position rdf:datatype="http://www.w3.org/2001/XMLSchema#int">2</aaif:position><aaif:coordinated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:coordinated><aaif:partOfText rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</aaif:partOfText><aaif:syntacticConstruction rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Intransitive" /></aaif:Verb><aaif:Adverb rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En959Ph1Ad1"><aaif:text>claro</aaif:text><aaif:lemma rdf:resource="https://gams.uni-graz.at/o:aaif.lemma#claro" /><aaif:position rdf:datatype="http://www.w3.org/2001/XMLSchema#int">3</aaif:position><aaif:coordinated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:coordinated><aaif:morphosyntacticStructure rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Adjective" /><aaif:inflection rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Uninflected" /><aaif:attributionTarget rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Verb" /><aaif:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</aaif:modified><aaif:semanticClassification rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Manner" /><aaif:reduplicated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:reduplicated><aaif:prepositionalPhrase rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:prepositionalPhrase></aaif:Adverb><aaif:Entry rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En960"><aaif:phrase rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh#En960Ph1" /><aaif:source rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh.bibl#Cnde400" /><gams:textualContent>unos raticos de conversación.¿Por qué será eso, chico, que cuando una está enamorada todo lo ve clarito ?Tú te quedas callado, como ahora, por ejemplo, y yo veo clarito lo que que estás</gams:textualContent><rel:isPartOf rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh" /></aaif:Entry><aaif:Phrase rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En960Ph1"><aaif:verb rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh#En960Ph1Ve1" /><aaif:adverb rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh#En960Ph1Ad1" /><aaif:text>cuando una está enamorada todo lo ve clarito </aaif:text><aaif:annoText>cuando una está enamorada todo lo [v|ve|ver|ts] [a|clarito|claro|auvnmnnn] </aaif:annoText></aaif:Phrase><aaif:Verb rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En960Ph1Ve1"><aaif:text>ve</aaif:text><aaif:lemma rdf:resource="https://gams.uni-graz.at/o:aaif.lemma#ver" /><aaif:position rdf:datatype="http://www.w3.org/2001/XMLSchema#int">1</aaif:position><aaif:coordinated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:coordinated><aaif:partOfText rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</aaif:partOfText><aaif:syntacticConstruction rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Transitive" /></aaif:Verb><aaif:Adverb rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En960Ph1Ad1"><aaif:text>clarito</aaif:text><aaif:lemma rdf:resource="https://gams.uni-graz.at/o:aaif.lemma#claro" /><aaif:position rdf:datatype="http://www.w3.org/2001/XMLSchema#int">2</aaif:position><aaif:coordinated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:coordinated><aaif:morphosyntacticStructure rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Adjective" /><aaif:inflection rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Uninflected" /><aaif:attributionTarget rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Verb" /><aaif:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:modified><aaif:semanticClassification rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Manner" /><aaif:reduplicated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:reduplicated><aaif:prepositionalPhrase rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:prepositionalPhrase></aaif:Adverb><aaif:Entry rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En961"><aaif:phrase rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh#En961Ph1" /><aaif:source rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh.bibl#Cnde400" /><gams:textualContent>enamorada todo lo ve clarito?Tú te quedas callado, como ahora, por ejemplo, y  yo  veo clarito lo que que estás pensando.</gams:textualContent><rel:isPartOf rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh" /></aaif:Entry><aaif:Phrase rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En961Ph1"><aaif:subject rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh#En961Ph1Su1" /><aaif:verb rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh#En961Ph1Ve1" /><aaif:adverb rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh#En961Ph1Ad1" /><aaif:text> yo  veo clarito lo que que estás pensando</aaif:text><aaif:annoText> [s|yo|fs]  [v|veo|ver|ts] [a|clarito|claro|auvnmnnn] lo que que estás pensando</aaif:annoText></aaif:Phrase><aaif:Subject rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En961Ph1Su1"><aaif:text>yo</aaif:text><aaif:position rdf:datatype="http://www.w3.org/2001/XMLSchema#int">1</aaif:position><aaif:gender rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Feminine" /><aaif:number rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Singular" /><aaif:overt rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</aaif:overt></aaif:Subject><aaif:Verb rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En961Ph1Ve1"><aaif:text>veo</aaif:text><aaif:lemma rdf:resource="https://gams.uni-graz.at/o:aaif.lemma#ver" /><aaif:position rdf:datatype="http://www.w3.org/2001/XMLSchema#int">2</aaif:position><aaif:coordinated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:coordinated><aaif:partOfText rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</aaif:partOfText><aaif:syntacticConstruction rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Transitive" /></aaif:Verb><aaif:Adverb rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En961Ph1Ad1"><aaif:text>clarito</aaif:text><aaif:lemma rdf:resource="https://gams.uni-graz.at/o:aaif.lemma#claro" /><aaif:position rdf:datatype="http://www.w3.org/2001/XMLSchema#int">3</aaif:position><aaif:coordinated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:coordinated><aaif:morphosyntacticStructure rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Adjective" /><aaif:inflection rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Uninflected" /><aaif:attributionTarget rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Verb" /><aaif:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:modified><aaif:semanticClassification rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Manner" /><aaif:reduplicated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:reduplicated><aaif:prepositionalPhrase rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:prepositionalPhrase></aaif:Adverb><aaif:Entry rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En962"><aaif:phrase rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh#En962Ph1" /><aaif:source rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh.bibl#Cnde41" /><gams:textualContent>se quieren meter los machetes pa “amachinarte”, y tu tata, agora más que nunca lo veo clarito , de verdá, pues la pinta no miente, soy yo...yo, ¡un miserable, un canalla</gams:textualContent><rel:isPartOf rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh" /></aaif:Entry><aaif:Phrase rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En962Ph1"><aaif:verb rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh#En962Ph1Ve1" /><aaif:adverb rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh#En962Ph1Ad1" /><aaif:text>agora más que nunca lo veo clarito </aaif:text><aaif:annoText>agora más que nunca lo [v|veo|ver|ts] [a|clarito|claro|auvnmnnn] </aaif:annoText></aaif:Phrase><aaif:Verb rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En962Ph1Ve1"><aaif:text>veo</aaif:text><aaif:lemma rdf:resource="https://gams.uni-graz.at/o:aaif.lemma#ver" /><aaif:position rdf:datatype="http://www.w3.org/2001/XMLSchema#int">1</aaif:position><aaif:coordinated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:coordinated><aaif:partOfText rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</aaif:partOfText><aaif:syntacticConstruction rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Transitive" /></aaif:Verb><aaif:Adverb rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En962Ph1Ad1"><aaif:text>clarito</aaif:text><aaif:lemma rdf:resource="https://gams.uni-graz.at/o:aaif.lemma#claro" /><aaif:position rdf:datatype="http://www.w3.org/2001/XMLSchema#int">2</aaif:position><aaif:coordinated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:coordinated><aaif:morphosyntacticStructure rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Adjective" /><aaif:inflection rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Uninflected" /><aaif:attributionTarget rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Verb" /><aaif:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:modified><aaif:semanticClassification rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Manner" /><aaif:reduplicated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:reduplicated><aaif:prepositionalPhrase rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:prepositionalPhrase></aaif:Adverb><aaif:Entry rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En963"><aaif:phrase rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh#En963Ph1" /><aaif:source rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh.bibl#Cnde41" /><gams:textualContent>verdadero amor, pero, era ya demasiado tarde porque el nido estaba ocupado por la otra.Dispuso hablar claro y explicarle todo a Olinda.Ella comprendería y de nuevo marcharía al lado de los suyos.Sí, no había otra</gams:textualContent><rel:isPartOf rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh" /></aaif:Entry><aaif:Phrase rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En963Ph1"><aaif:verb rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh#En963Ph1Ve1" /><aaif:adverb rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh#En963Ph1Ad1" /><aaif:text>Dispuso hablar claro y explicarle todo a Olinda</aaif:text><aaif:annoText>Dispuso [v|hablar|hablar|is] [a|claro|claro|auvnmnnn] y explicarle todo a Olinda</aaif:annoText></aaif:Phrase><aaif:Verb rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En963Ph1Ve1"><aaif:text>hablar</aaif:text><aaif:lemma rdf:resource="https://gams.uni-graz.at/o:aaif.lemma#hablar" /><aaif:position rdf:datatype="http://www.w3.org/2001/XMLSchema#int">1</aaif:position><aaif:coordinated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:coordinated><aaif:partOfText rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</aaif:partOfText><aaif:syntacticConstruction rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Intransitive" /></aaif:Verb><aaif:Adverb rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En963Ph1Ad1"><aaif:text>claro</aaif:text><aaif:lemma rdf:resource="https://gams.uni-graz.at/o:aaif.lemma#claro" /><aaif:position rdf:datatype="http://www.w3.org/2001/XMLSchema#int">2</aaif:position><aaif:coordinated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:coordinated><aaif:morphosyntacticStructure rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Adjective" /><aaif:inflection rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Uninflected" /><aaif:attributionTarget rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Verb" /><aaif:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:modified><aaif:semanticClassification rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Manner" /><aaif:reduplicated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:reduplicated><aaif:prepositionalPhrase rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:prepositionalPhrase></aaif:Adverb><aaif:Entry rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En964"><aaif:phrase rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh#En964Ph1" /><aaif:source rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh.bibl#Cnde401" /><gams:textualContent>¿No ves?Aquí tienes los resultaos de hablar claro y de irse po lo alto.¿Quiénes son las autoridades superiores?Los Ministros...El Presidente les</gams:textualContent><rel:isPartOf rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh" /></aaif:Entry><aaif:Phrase rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En964Ph1"><aaif:verb rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh#En964Ph1Ve1" /><aaif:adverb rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh#En964Ph1Ad1" /><aaif:text>Aquí tienes los resultaos de hablar claro y de irse po lo alto</aaif:text><aaif:annoText>Aquí tienes los resultaos de [v|hablar|hablar|is] [a|claro|claro|auvnmnnn] y de irse po lo alto</aaif:annoText></aaif:Phrase><aaif:Verb rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En964Ph1Ve1"><aaif:text>hablar</aaif:text><aaif:lemma rdf:resource="https://gams.uni-graz.at/o:aaif.lemma#hablar" /><aaif:position rdf:datatype="http://www.w3.org/2001/XMLSchema#int">1</aaif:position><aaif:coordinated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:coordinated><aaif:partOfText rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</aaif:partOfText><aaif:syntacticConstruction rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Intransitive" /></aaif:Verb><aaif:Adverb rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En964Ph1Ad1"><aaif:text>claro</aaif:text><aaif:lemma rdf:resource="https://gams.uni-graz.at/o:aaif.lemma#claro" /><aaif:position rdf:datatype="http://www.w3.org/2001/XMLSchema#int">2</aaif:position><aaif:coordinated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:coordinated><aaif:morphosyntacticStructure rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Adjective" /><aaif:inflection rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Uninflected" /><aaif:attributionTarget rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Verb" /><aaif:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:modified><aaif:semanticClassification rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Manner" /><aaif:reduplicated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:reduplicated><aaif:prepositionalPhrase rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:prepositionalPhrase></aaif:Adverb><aaif:Entry rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En965"><aaif:phrase rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh#En965Ph1" /><aaif:source rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh.bibl#Cnde43" /><gams:textualContent>Por eso no la tragué desde que entró.A mí me gusta la gente que pisa fuerte y habla claro .(Se fija en él.) Pero, ¿qué le pasa, mi amo?...</gams:textualContent><rel:isPartOf rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh" /></aaif:Entry><aaif:Phrase rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En965Ph1"><aaif:verb rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh#En965Ph1Ve1" /><aaif:verb rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh#En965Ph1Ve2" /><aaif:adverb rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh#En965Ph1Ad1" /><aaif:adverb rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh#En965Ph1Ad2" /><aaif:text>A mí me gusta la gente que pisa fuerte y habla claro </aaif:text><aaif:annoText>A mí me gusta la gente que [v|pisa|pisar|is] [a|fuerte|fuerte|auvnmnnn] y [v|habla|hablar|is] [a|claro|claro|auvnmnnn] </aaif:annoText></aaif:Phrase><aaif:Verb rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En965Ph1Ve1"><aaif:text>pisa</aaif:text><aaif:lemma rdf:resource="https://gams.uni-graz.at/o:aaif.lemma#pisar" /><aaif:position rdf:datatype="http://www.w3.org/2001/XMLSchema#int">1</aaif:position><aaif:coordinated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:coordinated><aaif:partOfText rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</aaif:partOfText><aaif:syntacticConstruction rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Intransitive" /></aaif:Verb><aaif:Verb rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En965Ph1Ve2"><aaif:text>habla</aaif:text><aaif:lemma rdf:resource="https://gams.uni-graz.at/o:aaif.lemma#hablar" /><aaif:position rdf:datatype="http://www.w3.org/2001/XMLSchema#int">3</aaif:position><aaif:coordinated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:coordinated><aaif:partOfText rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</aaif:partOfText><aaif:syntacticConstruction rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Intransitive" /></aaif:Verb><aaif:Adverb rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En965Ph1Ad1"><aaif:text>fuerte</aaif:text><aaif:lemma rdf:resource="https://gams.uni-graz.at/o:aaif.lemma#fuerte" /><aaif:position rdf:datatype="http://www.w3.org/2001/XMLSchema#int">2</aaif:position><aaif:coordinated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:coordinated><aaif:morphosyntacticStructure rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Adjective" /><aaif:inflection rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Uninflected" /><aaif:attributionTarget rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Verb" /><aaif:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:modified><aaif:semanticClassification rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Manner" /><aaif:reduplicated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:reduplicated><aaif:prepositionalPhrase rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:prepositionalPhrase></aaif:Adverb><aaif:Adverb rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En965Ph1Ad2"><aaif:text>claro</aaif:text><aaif:lemma rdf:resource="https://gams.uni-graz.at/o:aaif.lemma#claro" /><aaif:position rdf:datatype="http://www.w3.org/2001/XMLSchema#int">4</aaif:position><aaif:coordinated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:coordinated><aaif:morphosyntacticStructure rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Adjective" /><aaif:inflection rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Uninflected" /><aaif:attributionTarget rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Verb" /><aaif:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:modified><aaif:semanticClassification rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Manner" /><aaif:reduplicated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:reduplicated><aaif:prepositionalPhrase rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:prepositionalPhrase></aaif:Adverb><aaif:Entry rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En966"><aaif:phrase rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh#En966Ph1" /><aaif:source rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh.bibl#Cnde43" /><gams:textualContent>Abuelo No puede ser...Tiene que haber algo.Algo que quizá tú misma no ves claro todavía.Que se está formando dentro, como esas nubes de pena que de pronto estallan...¡y que</gams:textualContent><rel:isPartOf rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh" /></aaif:Entry><aaif:Phrase rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En966Ph1"><aaif:subject rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh#En966Ph1Su1" /><aaif:verb rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh#En966Ph1Ve1" /><aaif:adverb rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh#En966Ph1Ad1" /><aaif:text>Algo que quizá tú misma no ves claro todavía</aaif:text><aaif:annoText>Algo que quizá [s|tú misma|fs] no [v|ves|ver|ts] [a|claro|claro|auvnmnnn] todavía</aaif:annoText></aaif:Phrase><aaif:Subject rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En966Ph1Su1"><aaif:text>tú misma</aaif:text><aaif:position rdf:datatype="http://www.w3.org/2001/XMLSchema#int">1</aaif:position><aaif:gender rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Feminine" /><aaif:number rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Singular" /><aaif:overt rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</aaif:overt></aaif:Subject><aaif:Verb rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En966Ph1Ve1"><aaif:text>ves</aaif:text><aaif:lemma rdf:resource="https://gams.uni-graz.at/o:aaif.lemma#ver" /><aaif:position rdf:datatype="http://www.w3.org/2001/XMLSchema#int">2</aaif:position><aaif:coordinated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:coordinated><aaif:partOfText rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</aaif:partOfText><aaif:syntacticConstruction rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Transitive" /></aaif:Verb><aaif:Adverb rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En966Ph1Ad1"><aaif:text>claro</aaif:text><aaif:lemma rdf:resource="https://gams.uni-graz.at/o:aaif.lemma#claro" /><aaif:position rdf:datatype="http://www.w3.org/2001/XMLSchema#int">3</aaif:position><aaif:coordinated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:coordinated><aaif:morphosyntacticStructure rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Adjective" /><aaif:inflection rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Uninflected" /><aaif:attributionTarget rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Verb" /><aaif:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:modified><aaif:semanticClassification rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Manner" /><aaif:reduplicated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:reduplicated><aaif:prepositionalPhrase rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:prepositionalPhrase></aaif:Adverb><aaif:Entry rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En967"><aaif:phrase rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh#En967Ph1" /><aaif:source rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh.bibl#Cnde258" /><gams:textualContent>de Angustias.El balcón estaba muy cerca.Casi sentía la respiración de ellos dos. Sus voces  venían clarísimas a mis oídos sobre el gran fondo de silencios que sofocaba a los lejanos estallidos de los cohetes y a</gams:textualContent><rel:isPartOf rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh" /></aaif:Entry><aaif:Phrase rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En967Ph1"><aaif:subject rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh#En967Ph1Su1" /><aaif:verb rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh#En967Ph1Ve1" /><aaif:adverb rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh#En967Ph1Ad1" /><aaif:text> Sus voces  venían clarísimas a mis oídos</aaif:text><aaif:annoText> [s|Sus voces|fp]  [v|venían|venir|is] [a|clarísimas|claro|axsnmnnn] a mis oídos</aaif:annoText></aaif:Phrase><aaif:Subject rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En967Ph1Su1"><aaif:text>Sus voces</aaif:text><aaif:position rdf:datatype="http://www.w3.org/2001/XMLSchema#int">1</aaif:position><aaif:gender rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Feminine" /><aaif:number rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Plural" /><aaif:overt rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</aaif:overt></aaif:Subject><aaif:Verb rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En967Ph1Ve1"><aaif:text>venían</aaif:text><aaif:lemma rdf:resource="https://gams.uni-graz.at/o:aaif.lemma#venir" /><aaif:position rdf:datatype="http://www.w3.org/2001/XMLSchema#int">2</aaif:position><aaif:coordinated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:coordinated><aaif:partOfText rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</aaif:partOfText><aaif:syntacticConstruction rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Intransitive" /></aaif:Verb><aaif:Adverb rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En967Ph1Ad1"><aaif:text>clarísimas</aaif:text><aaif:lemma rdf:resource="https://gams.uni-graz.at/o:aaif.lemma#claro" /><aaif:position rdf:datatype="http://www.w3.org/2001/XMLSchema#int">3</aaif:position><aaif:coordinated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:coordinated><aaif:morphosyntacticStructure rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Adjective" /><aaif:inflection rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#FemininePlural" /><aaif:attributionTarget rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Verb" /><aaif:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:modified><aaif:semanticClassification rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Manner" /><aaif:reduplicated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:reduplicated><aaif:prepositionalPhrase rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:prepositionalPhrase></aaif:Adverb><aaif:Entry rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En968"><aaif:phrase rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh#En968Ph1" /><aaif:source rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh.bibl#Cnde2" /><gams:textualContent>“...Vírgenes y Viudas...¡me voy a condenar por su causa, por usted, lo veo claro , puesto que Dios no quiso concederme morir como mártir, como monje, como eremita, y subir al</gams:textualContent><rel:isPartOf rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh" /></aaif:Entry><aaif:Phrase rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En968Ph1"><aaif:verb rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh#En968Ph1Ve1" /><aaif:adverb rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh#En968Ph1Ad1" /><aaif:text>me voy a condenar por su causa, por usted, lo veo claro </aaif:text><aaif:annoText>me voy a condenar por su causa, por usted, lo [v|veo|ver|ts] [a|claro|claro|auvnmnnn] </aaif:annoText></aaif:Phrase><aaif:Verb rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En968Ph1Ve1"><aaif:text>veo</aaif:text><aaif:lemma rdf:resource="https://gams.uni-graz.at/o:aaif.lemma#ver" /><aaif:position rdf:datatype="http://www.w3.org/2001/XMLSchema#int">1</aaif:position><aaif:coordinated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:coordinated><aaif:partOfText rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</aaif:partOfText><aaif:syntacticConstruction rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Transitive" /></aaif:Verb><aaif:Adverb rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En968Ph1Ad1"><aaif:text>claro</aaif:text><aaif:lemma rdf:resource="https://gams.uni-graz.at/o:aaif.lemma#claro" /><aaif:position rdf:datatype="http://www.w3.org/2001/XMLSchema#int">2</aaif:position><aaif:coordinated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:coordinated><aaif:morphosyntacticStructure rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Adjective" /><aaif:inflection rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Uninflected" /><aaif:attributionTarget rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Verb" /><aaif:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:modified><aaif:semanticClassification rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Manner" /><aaif:reduplicated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:reduplicated><aaif:prepositionalPhrase rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:prepositionalPhrase></aaif:Adverb><aaif:Entry rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En969"><aaif:phrase rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh#En969Ph1" /><aaif:source rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh.bibl#Cnde2" /><gams:textualContent>hubiera cantado si hubieran podido obrar conforme a sus sentimientos, sin andarse escondiendo.No más porque nosotros vemos claro , es por lo que nos critican; y porque somos francos.Esta situación, se lo repito,</gams:textualContent><rel:isPartOf rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh" /></aaif:Entry><aaif:Phrase rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En969Ph1"><aaif:subject rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh#En969Ph1Su1" /><aaif:verb rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh#En969Ph1Ve1" /><aaif:adverb rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh#En969Ph1Ad1" /><aaif:text>porque nosotros vemos claro </aaif:text><aaif:annoText>porque [s|nosotros|mp] [v|vemos|ver|is] [a|claro|claro|auvnmnnn] </aaif:annoText></aaif:Phrase><aaif:Subject rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En969Ph1Su1"><aaif:text>nosotros</aaif:text><aaif:position rdf:datatype="http://www.w3.org/2001/XMLSchema#int">1</aaif:position><aaif:gender rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Masculine" /><aaif:number rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Plural" /><aaif:overt rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</aaif:overt></aaif:Subject><aaif:Verb rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En969Ph1Ve1"><aaif:text>vemos</aaif:text><aaif:lemma rdf:resource="https://gams.uni-graz.at/o:aaif.lemma#ver" /><aaif:position rdf:datatype="http://www.w3.org/2001/XMLSchema#int">2</aaif:position><aaif:coordinated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:coordinated><aaif:partOfText rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</aaif:partOfText><aaif:syntacticConstruction rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Intransitive" /></aaif:Verb><aaif:Adverb rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En969Ph1Ad1"><aaif:text>claro</aaif:text><aaif:lemma rdf:resource="https://gams.uni-graz.at/o:aaif.lemma#claro" /><aaif:position rdf:datatype="http://www.w3.org/2001/XMLSchema#int">3</aaif:position><aaif:coordinated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:coordinated><aaif:morphosyntacticStructure rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Adjective" /><aaif:inflection rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Uninflected" /><aaif:attributionTarget rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Verb" /><aaif:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:modified><aaif:semanticClassification rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Manner" /><aaif:reduplicated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:reduplicated><aaif:prepositionalPhrase rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:prepositionalPhrase></aaif:Adverb><aaif:Entry rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En970"><aaif:phrase rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh#En970Ph1" /><aaif:source rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh.bibl#Cnde2" /><gams:textualContent>— No, es que quiso hablar claro y poner las peras a veinticinco, deseando que luego no fueran a venir las dificultades.Trae órdenes terminantes</gams:textualContent><rel:isPartOf rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh" /></aaif:Entry><aaif:Phrase rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En970Ph1"><aaif:verb rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh#En970Ph1Ve1" /><aaif:adverb rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh#En970Ph1Ad1" /><aaif:text>es que quiso hablar claro y poner las peras a veinticinco</aaif:text><aaif:annoText>es que quiso [v|hablar|hablar|is] [a|claro|claro|auvnmnnn] y poner las peras a veinticinco</aaif:annoText></aaif:Phrase><aaif:Verb rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En970Ph1Ve1"><aaif:text>hablar</aaif:text><aaif:lemma rdf:resource="https://gams.uni-graz.at/o:aaif.lemma#hablar" /><aaif:position rdf:datatype="http://www.w3.org/2001/XMLSchema#int">1</aaif:position><aaif:coordinated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:coordinated><aaif:partOfText rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</aaif:partOfText><aaif:syntacticConstruction rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Intransitive" /></aaif:Verb><aaif:Adverb rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En970Ph1Ad1"><aaif:text>claro</aaif:text><aaif:lemma rdf:resource="https://gams.uni-graz.at/o:aaif.lemma#claro" /><aaif:position rdf:datatype="http://www.w3.org/2001/XMLSchema#int">2</aaif:position><aaif:coordinated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:coordinated><aaif:morphosyntacticStructure rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Adjective" /><aaif:inflection rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Uninflected" /><aaif:attributionTarget rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Verb" /><aaif:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:modified><aaif:semanticClassification rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Manner" /><aaif:reduplicated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:reduplicated><aaif:prepositionalPhrase rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:prepositionalPhrase></aaif:Adverb><aaif:Entry rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En971"><aaif:phrase rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh#En971Ph1" /><aaif:source rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh.bibl#Cnde45" /><gams:textualContent>Don José Ortega y Gasset —continúa— ha subido varias veces a mi torreón.Allí confesaba él que fué donde vió claro el secreto del arte moderno...Ascendía con bellas damas y hombres inteligentes...Mi alegría mayor fué verle</gams:textualContent><rel:isPartOf rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh" /></aaif:Entry><aaif:Phrase rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En971Ph1"><aaif:verb rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh#En971Ph1Ve1" /><aaif:adverb rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh#En971Ph1Ad1" /><aaif:text>Allí confesaba él que fué donde vió claro el secreto del arte moderno</aaif:text><aaif:annoText>Allí confesaba él que fué donde [v|vió|ver|ts] [a|claro|claro|auvnmnnn] el secreto del arte moderno</aaif:annoText></aaif:Phrase><aaif:Verb rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En971Ph1Ve1"><aaif:text>vió</aaif:text><aaif:lemma rdf:resource="https://gams.uni-graz.at/o:aaif.lemma#ver" /><aaif:position rdf:datatype="http://www.w3.org/2001/XMLSchema#int">1</aaif:position><aaif:coordinated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:coordinated><aaif:partOfText rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</aaif:partOfText><aaif:syntacticConstruction rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Transitive" /></aaif:Verb><aaif:Adverb rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En971Ph1Ad1"><aaif:text>claro</aaif:text><aaif:lemma rdf:resource="https://gams.uni-graz.at/o:aaif.lemma#claro" /><aaif:position rdf:datatype="http://www.w3.org/2001/XMLSchema#int">2</aaif:position><aaif:coordinated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:coordinated><aaif:morphosyntacticStructure rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Adjective" /><aaif:inflection rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Uninflected" /><aaif:attributionTarget rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Verb" /><aaif:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:modified><aaif:semanticClassification rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Manner" /><aaif:reduplicated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:reduplicated><aaif:prepositionalPhrase rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:prepositionalPhrase></aaif:Adverb><aaif:Entry rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En972"><aaif:phrase rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh#En972Ph1" /><aaif:source rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh.bibl#Cnde402" /><gams:textualContent>no sé lo que pienso?Si pudiera decir con palabras claras lo que siento, sería casi como pensar claro .¿No es cierto?</gams:textualContent><rel:isPartOf rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh" /></aaif:Entry><aaif:Phrase rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En972Ph1"><aaif:verb rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh#En972Ph1Ve1" /><aaif:adverb rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh#En972Ph1Ad1" /><aaif:text>Si pudiera decir con palabras claras lo que siento, sería casi como pensar claro .</aaif:text><aaif:annoText>Si pudiera decir con palabras claras lo que siento, sería casi como [v|pensar|pensar|is] [a|claro|claro|auvnmnnn] .</aaif:annoText></aaif:Phrase><aaif:Verb rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En972Ph1Ve1"><aaif:text>pensar</aaif:text><aaif:lemma rdf:resource="https://gams.uni-graz.at/o:aaif.lemma#pensar" /><aaif:position rdf:datatype="http://www.w3.org/2001/XMLSchema#int">1</aaif:position><aaif:coordinated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:coordinated><aaif:partOfText rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</aaif:partOfText><aaif:syntacticConstruction rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Intransitive" /></aaif:Verb><aaif:Adverb rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En972Ph1Ad1"><aaif:text>claro</aaif:text><aaif:lemma rdf:resource="https://gams.uni-graz.at/o:aaif.lemma#claro" /><aaif:position rdf:datatype="http://www.w3.org/2001/XMLSchema#int">2</aaif:position><aaif:coordinated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:coordinated><aaif:morphosyntacticStructure rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Adjective" /><aaif:inflection rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Uninflected" /><aaif:attributionTarget rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Verb" /><aaif:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:modified><aaif:semanticClassification rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Manner" /><aaif:reduplicated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:reduplicated><aaif:prepositionalPhrase rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:prepositionalPhrase></aaif:Adverb><aaif:Entry rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En973"><aaif:phrase rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh#En973Ph1" /><aaif:source rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh.bibl#Cnde402" /><gams:textualContent>Me callé un momento y pensé, tratando de ver claro .Después agregué:</gams:textualContent><rel:isPartOf rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh" /></aaif:Entry><aaif:Phrase rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En973Ph1"><aaif:verb rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh#En973Ph1Ve1" /><aaif:adverb rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh#En973Ph1Ad1" /><aaif:text>Me callé un momento y pensé, tratando de ver claro .</aaif:text><aaif:annoText>Me callé un momento y pensé, tratando de [v|ver|ver|is] [a|claro|claro|auvnmnnn] .</aaif:annoText></aaif:Phrase><aaif:Verb rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En973Ph1Ve1"><aaif:text>ver</aaif:text><aaif:lemma rdf:resource="https://gams.uni-graz.at/o:aaif.lemma#ver" /><aaif:position rdf:datatype="http://www.w3.org/2001/XMLSchema#int">1</aaif:position><aaif:coordinated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:coordinated><aaif:partOfText rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</aaif:partOfText><aaif:syntacticConstruction rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Intransitive" /></aaif:Verb><aaif:Adverb rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En973Ph1Ad1"><aaif:text>claro</aaif:text><aaif:lemma rdf:resource="https://gams.uni-graz.at/o:aaif.lemma#claro" /><aaif:position rdf:datatype="http://www.w3.org/2001/XMLSchema#int">2</aaif:position><aaif:coordinated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:coordinated><aaif:morphosyntacticStructure rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Adjective" /><aaif:inflection rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Uninflected" /><aaif:attributionTarget rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Verb" /><aaif:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:modified><aaif:semanticClassification rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Manner" /><aaif:reduplicated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:reduplicated><aaif:prepositionalPhrase rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:prepositionalPhrase></aaif:Adverb><aaif:Entry rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En974"><aaif:phrase rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh#En974Ph1" /><aaif:source rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh.bibl#Cnde403" /><gams:textualContent>inmóvil en el umbral y con los ojos dolorosamente abiertos.Entonces Juan José retardó su marcha, deseoso de ver claro en sí mismo antes de llegar a la mujer.Pero, si demorado era su andar, a la</gams:textualContent><rel:isPartOf rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh" /></aaif:Entry><aaif:Phrase rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En974Ph1"><aaif:verb rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh#En974Ph1Ve1" /><aaif:adverb rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh#En974Ph1Ad1" /><aaif:text>Juan José retardó su marcha, deseoso de ver claro en sí mismo antes de llegar a la mujer</aaif:text><aaif:annoText>Juan José retardó su marcha, deseoso de [v|ver|ver|ts] [a|claro|claro|auvnmnnn] en sí mismo antes de llegar a la mujer</aaif:annoText></aaif:Phrase><aaif:Verb rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En974Ph1Ve1"><aaif:text>ver</aaif:text><aaif:lemma rdf:resource="https://gams.uni-graz.at/o:aaif.lemma#ver" /><aaif:position rdf:datatype="http://www.w3.org/2001/XMLSchema#int">1</aaif:position><aaif:coordinated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:coordinated><aaif:partOfText rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</aaif:partOfText><aaif:syntacticConstruction rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Transitive" /></aaif:Verb><aaif:Adverb rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En974Ph1Ad1"><aaif:text>claro</aaif:text><aaif:lemma rdf:resource="https://gams.uni-graz.at/o:aaif.lemma#claro" /><aaif:position rdf:datatype="http://www.w3.org/2001/XMLSchema#int">2</aaif:position><aaif:coordinated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:coordinated><aaif:morphosyntacticStructure rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Adjective" /><aaif:inflection rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Uninflected" /><aaif:attributionTarget rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Verb" /><aaif:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:modified><aaif:semanticClassification rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Manner" /><aaif:reduplicated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:reduplicated><aaif:prepositionalPhrase rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:prepositionalPhrase></aaif:Adverb><aaif:Entry rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En975"><aaif:phrase rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh#En975Ph1" /><aaif:source rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh.bibl#Cnde404" /><gams:textualContent>No siga, compadre Goyo —dijo Revolorio, sacudiéndose la tierra de la cara, parpadeó para ver claro , y con medias escupidas para no tragar tierra—, que ahora a mí me toca cargar un poco</gams:textualContent><rel:isPartOf rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh" /></aaif:Entry><aaif:Phrase rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En975Ph1"><aaif:verb rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh#En975Ph1Ve1" /><aaif:adverb rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh#En975Ph1Ad1" /><aaif:text>dijo Revolorio, sacudiéndose la tierra de la cara, parpadeó para ver claro </aaif:text><aaif:annoText>dijo Revolorio, sacudiéndose la tierra de la cara, parpadeó para [v|ver|ver|is] [a|claro|claro|auvnmnnn] </aaif:annoText></aaif:Phrase><aaif:Verb rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En975Ph1Ve1"><aaif:text>ver</aaif:text><aaif:lemma rdf:resource="https://gams.uni-graz.at/o:aaif.lemma#ver" /><aaif:position rdf:datatype="http://www.w3.org/2001/XMLSchema#int">1</aaif:position><aaif:coordinated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:coordinated><aaif:partOfText rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</aaif:partOfText><aaif:syntacticConstruction rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Intransitive" /></aaif:Verb><aaif:Adverb rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En975Ph1Ad1"><aaif:text>claro</aaif:text><aaif:lemma rdf:resource="https://gams.uni-graz.at/o:aaif.lemma#claro" /><aaif:position rdf:datatype="http://www.w3.org/2001/XMLSchema#int">2</aaif:position><aaif:coordinated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:coordinated><aaif:morphosyntacticStructure rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Adjective" /><aaif:inflection rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Uninflected" /><aaif:attributionTarget rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Verb" /><aaif:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:modified><aaif:semanticClassification rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Manner" /><aaif:reduplicated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:reduplicated><aaif:prepositionalPhrase rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:prepositionalPhrase></aaif:Adverb><aaif:Entry rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En976"><aaif:phrase rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh#En976Ph1" /><aaif:source rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh.bibl#Cnde404" /><gams:textualContent>¡Sé franco, vos, Jenizaro; mejor me decís claro que tengo pacto con el Diablo, que por eso no vamos a peliar!</gams:textualContent><rel:isPartOf rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh" /></aaif:Entry><aaif:Phrase rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En976Ph1"><aaif:verb rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh#En976Ph1Ve1" /><aaif:adverb rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh#En976Ph1Ad1" /><aaif:text>mejor me decís claro que tengo pacto con el Diablo</aaif:text><aaif:annoText>mejor me [v|decís|decir|ts] [a|claro|claro|auvnmnnn] que tengo pacto con el Diablo</aaif:annoText></aaif:Phrase><aaif:Verb rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En976Ph1Ve1"><aaif:text>decís</aaif:text><aaif:lemma rdf:resource="https://gams.uni-graz.at/o:aaif.lemma#decir" /><aaif:position rdf:datatype="http://www.w3.org/2001/XMLSchema#int">1</aaif:position><aaif:coordinated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:coordinated><aaif:partOfText rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</aaif:partOfText><aaif:syntacticConstruction rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Transitive" /></aaif:Verb><aaif:Adverb rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En976Ph1Ad1"><aaif:text>claro</aaif:text><aaif:lemma rdf:resource="https://gams.uni-graz.at/o:aaif.lemma#claro" /><aaif:position rdf:datatype="http://www.w3.org/2001/XMLSchema#int">2</aaif:position><aaif:coordinated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:coordinated><aaif:morphosyntacticStructure rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Adjective" /><aaif:inflection rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Uninflected" /><aaif:attributionTarget rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Verb" /><aaif:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:modified><aaif:semanticClassification rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Manner" /><aaif:reduplicated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:reduplicated><aaif:prepositionalPhrase rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:prepositionalPhrase></aaif:Adverb><aaif:Entry rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En977"><aaif:phrase rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh#En977Ph1" /><aaif:source rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh.bibl#Cnde405" /><gams:textualContent>que los que así piensan no han leído la estrofa 4.ª?¿O quieren también omitirla? Yo  creo claro como la luz del día que armonía musical humana y armonía celeste no eran para Fray Luis sino aspectos de una misma cosa, y ambos sólo reflejo y consecuencia de la armonía divina.Del mismo modo que música y astronomía eran hermanas para los pitagóricos (es Platón, nada menos, quien se lo hace decir a Sócrates) 52.En la República, comp.Burnet, obra cit., pág.85.</gams:textualContent><rel:isPartOf rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh" /></aaif:Entry><aaif:Phrase rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En977Ph1"><aaif:subject rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh#En977Ph1Su1" /><aaif:verb rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh#En977Ph1Ve1" /><aaif:adverb rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh#En977Ph1Ad1" /><aaif:text> Yo  creo claro como la luz del día que armonía musical humana y armonía celeste no eran para Fray Luis sino aspectos de una misma cosa</aaif:text><aaif:annoText> [s|Yo|ms]  [v|creo|creer|ts] [a|claro|claro|auonmnnn] como la luz del día que armonía musical humana y armonía celeste no eran para Fray Luis sino aspectos de una misma cosa</aaif:annoText></aaif:Phrase><aaif:Subject rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En977Ph1Su1"><aaif:text>Yo</aaif:text><aaif:position rdf:datatype="http://www.w3.org/2001/XMLSchema#int">1</aaif:position><aaif:gender rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Masculine" /><aaif:number rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Singular" /><aaif:overt rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</aaif:overt></aaif:Subject><aaif:Verb rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En977Ph1Ve1"><aaif:text>creo</aaif:text><aaif:lemma rdf:resource="https://gams.uni-graz.at/o:aaif.lemma#creer" /><aaif:position rdf:datatype="http://www.w3.org/2001/XMLSchema#int">2</aaif:position><aaif:coordinated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:coordinated><aaif:partOfText rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</aaif:partOfText><aaif:syntacticConstruction rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Transitive" /></aaif:Verb><aaif:Adverb rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En977Ph1Ad1"><aaif:text>claro</aaif:text><aaif:lemma rdf:resource="https://gams.uni-graz.at/o:aaif.lemma#claro" /><aaif:position rdf:datatype="http://www.w3.org/2001/XMLSchema#int">3</aaif:position><aaif:coordinated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:coordinated><aaif:morphosyntacticStructure rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Adjective" /><aaif:inflection rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Uninflected" /><aaif:attributionTarget rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#VerbObject" /><aaif:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:modified><aaif:semanticClassification rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Manner" /><aaif:reduplicated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:reduplicated><aaif:prepositionalPhrase rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:prepositionalPhrase></aaif:Adverb><aaif:Entry rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En978"><aaif:phrase rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh#En978Ph1" /><aaif:source rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh.bibl#Cnde49" /><gams:textualContent>pensamiento original”?Si existe, no lo esperemos de Quevedo ni de ningún poeta.Pero,  hablemos  claro (porque el equívoco hiede): esperémoslo también, sólo en cierto sentido y siempre en disolución, de</gams:textualContent><rel:isPartOf rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh" /></aaif:Entry><aaif:Phrase rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En978Ph1"><aaif:verb rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh#En978Ph1Ve1" /><aaif:adverb rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh#En978Ph1Ad1" /><aaif:text> hablemos  claro (porque el equívoco hiede):</aaif:text><aaif:annoText> [v|hablemos|hablar|is]  [a|claro|claro|auvnmnnn] (porque el equívoco hiede):</aaif:annoText></aaif:Phrase><aaif:Verb rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En978Ph1Ve1"><aaif:text>hablemos</aaif:text><aaif:lemma rdf:resource="https://gams.uni-graz.at/o:aaif.lemma#hablar" /><aaif:position rdf:datatype="http://www.w3.org/2001/XMLSchema#int">1</aaif:position><aaif:coordinated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:coordinated><aaif:partOfText rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</aaif:partOfText><aaif:syntacticConstruction rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Intransitive" /></aaif:Verb><aaif:Adverb rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En978Ph1Ad1"><aaif:text>claro</aaif:text><aaif:lemma rdf:resource="https://gams.uni-graz.at/o:aaif.lemma#claro" /><aaif:position rdf:datatype="http://www.w3.org/2001/XMLSchema#int">2</aaif:position><aaif:coordinated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:coordinated><aaif:morphosyntacticStructure rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Adjective" /><aaif:inflection rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Uninflected" /><aaif:attributionTarget rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Verb" /><aaif:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:modified><aaif:semanticClassification rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Manner" /><aaif:reduplicated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:reduplicated><aaif:prepositionalPhrase rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:prepositionalPhrase></aaif:Adverb><aaif:Entry rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En979"><aaif:phrase rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh#En979Ph1" /><aaif:source rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh.bibl#Cnde406" /><gams:textualContent>Doña Rosa suspiró ligeramente.&lt;lb/&gt; - ¡Qué tonta soy!Delante de Hitler, no me hubiera atrevido ni a levantar la voz...&lt;lb/&gt; A doña Rosa le preocupa la suerte de las armas alemanas.Lee con toda atención, día a día, el parte del cuartel general del Führer, y relaciona, por una serie de vagos presentimientos que no se atreve a intentar ver claros , el destino de la Wehrmacht con el destino de su café.&lt;lb/&gt; Vega compra el periódico.Su vecino le pregunta: &lt;lb/&gt; - ¿Buenas noticias?&lt;lb/&gt; Vega es un ecléctico.&lt;lb/&gt; - Según para quién.&lt;lb/&gt; El echador sigue diciendo ¡voy!y arrastrando los pies por el suelo del café.</gams:textualContent><rel:isPartOf rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh" /></aaif:Entry><aaif:Phrase rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En979Ph1"><aaif:verb rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh#En979Ph1Ve1" /><aaif:adverb rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh#En979Ph1Ad1" /><aaif:text>por una serie de vagos presentimientos que no se atreve a intentar ver claros </aaif:text><aaif:annoText>por una serie de vagos presentimientos que no se atreve a intentar [v|ver|ver|ts] [a|claros|claro|aponmnnn] </aaif:annoText></aaif:Phrase><aaif:Verb rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En979Ph1Ve1"><aaif:text>ver</aaif:text><aaif:lemma rdf:resource="https://gams.uni-graz.at/o:aaif.lemma#ver" /><aaif:position rdf:datatype="http://www.w3.org/2001/XMLSchema#int">1</aaif:position><aaif:coordinated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:coordinated><aaif:partOfText rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</aaif:partOfText><aaif:syntacticConstruction rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Transitive" /></aaif:Verb><aaif:Adverb rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En979Ph1Ad1"><aaif:text>claros</aaif:text><aaif:lemma rdf:resource="https://gams.uni-graz.at/o:aaif.lemma#claro" /><aaif:position rdf:datatype="http://www.w3.org/2001/XMLSchema#int">2</aaif:position><aaif:coordinated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:coordinated><aaif:morphosyntacticStructure rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Adjective" /><aaif:inflection rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#MasculinePlural" /><aaif:attributionTarget rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#VerbObject" /><aaif:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:modified><aaif:semanticClassification rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Manner" /><aaif:reduplicated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:reduplicated><aaif:prepositionalPhrase rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:prepositionalPhrase></aaif:Adverb><aaif:Entry rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En980"><aaif:phrase rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh#En980Ph1" /><aaif:source rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh.bibl#Cnde406" /><gams:textualContent>Era una manera muy discreta de darle a entender a su mujer que era una imbécil, pero sin decírselo claro .</gams:textualContent><rel:isPartOf rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh" /></aaif:Entry><aaif:Phrase rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En980Ph1"><aaif:verb rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh#En980Ph1Ve1" /><aaif:adverb rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh#En980Ph1Ad1" /><aaif:text>pero sin decírselo claro .</aaif:text><aaif:annoText>pero sin [v|decírselo|decir|ts] [a|claro|claro|auvnmnnn] .</aaif:annoText></aaif:Phrase><aaif:Verb rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En980Ph1Ve1"><aaif:text>decírselo</aaif:text><aaif:lemma rdf:resource="https://gams.uni-graz.at/o:aaif.lemma#decir" /><aaif:position rdf:datatype="http://www.w3.org/2001/XMLSchema#int">1</aaif:position><aaif:coordinated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:coordinated><aaif:partOfText rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</aaif:partOfText><aaif:syntacticConstruction rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Transitive" /></aaif:Verb><aaif:Adverb rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En980Ph1Ad1"><aaif:text>claro</aaif:text><aaif:lemma rdf:resource="https://gams.uni-graz.at/o:aaif.lemma#claro" /><aaif:position rdf:datatype="http://www.w3.org/2001/XMLSchema#int">2</aaif:position><aaif:coordinated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:coordinated><aaif:morphosyntacticStructure rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Adjective" /><aaif:inflection rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Uninflected" /><aaif:attributionTarget rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Verb" /><aaif:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:modified><aaif:semanticClassification rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Manner" /><aaif:reduplicated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:reduplicated><aaif:prepositionalPhrase rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:prepositionalPhrase></aaif:Adverb><aaif:Entry rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En981"><aaif:phrase rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh#En981Ph1" /><aaif:source rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh.bibl#Cnde406" /><gams:textualContent>escupe con fuerza y se para, el cuerpo apoyado contra la gris pared de una casa.Nada ve claro  y hay momentos en los que no sabe si está vivo o muerto.</gams:textualContent><rel:isPartOf rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh" /></aaif:Entry><aaif:Phrase rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En981Ph1"><aaif:verb rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh#En981Ph1Ve1" /><aaif:adverb rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh#En981Ph1Ad1" /><aaif:text>Nada ve claro </aaif:text><aaif:annoText>Nada [v|ve|ver|ts] [a|claro|claro|auvnmnnn] </aaif:annoText></aaif:Phrase><aaif:Verb rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En981Ph1Ve1"><aaif:text>ve</aaif:text><aaif:lemma rdf:resource="https://gams.uni-graz.at/o:aaif.lemma#ver" /><aaif:position rdf:datatype="http://www.w3.org/2001/XMLSchema#int">1</aaif:position><aaif:coordinated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:coordinated><aaif:partOfText rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</aaif:partOfText><aaif:syntacticConstruction rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Transitive" /></aaif:Verb><aaif:Adverb rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En981Ph1Ad1"><aaif:text>claro</aaif:text><aaif:lemma rdf:resource="https://gams.uni-graz.at/o:aaif.lemma#claro" /><aaif:position rdf:datatype="http://www.w3.org/2001/XMLSchema#int">2</aaif:position><aaif:coordinated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:coordinated><aaif:morphosyntacticStructure rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Adjective" /><aaif:inflection rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Uninflected" /><aaif:attributionTarget rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Verb" /><aaif:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:modified><aaif:semanticClassification rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Manner" /><aaif:reduplicated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:reduplicated><aaif:prepositionalPhrase rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:prepositionalPhrase></aaif:Adverb><aaif:Entry rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En982"><aaif:phrase rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh#En982Ph1" /><aaif:source rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh.bibl#Cnde407" /><gams:textualContent>aquel mal ejemplo.Ella no se acuerda.Le da vueltas a todos sus * recuerdos y no ve claro dónde * estuvo su mal o el pecado de nacerle una hija tras otra con la misma mala costumbre.</gams:textualContent><rel:isPartOf rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh" /></aaif:Entry><aaif:Phrase rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En982Ph1"><aaif:verb rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh#En982Ph1Ve1" /><aaif:adverb rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh#En982Ph1Ad1" /><aaif:text>no ve claro dónde * estuvo su mal</aaif:text><aaif:annoText>no [v|ve|ver|ts] [a|claro|claro|auvnmnnn] dónde * estuvo su mal</aaif:annoText></aaif:Phrase><aaif:Verb rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En982Ph1Ve1"><aaif:text>ve</aaif:text><aaif:lemma rdf:resource="https://gams.uni-graz.at/o:aaif.lemma#ver" /><aaif:position rdf:datatype="http://www.w3.org/2001/XMLSchema#int">1</aaif:position><aaif:coordinated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:coordinated><aaif:partOfText rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</aaif:partOfText><aaif:syntacticConstruction rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Transitive" /></aaif:Verb><aaif:Adverb rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En982Ph1Ad1"><aaif:text>claro</aaif:text><aaif:lemma rdf:resource="https://gams.uni-graz.at/o:aaif.lemma#claro" /><aaif:position rdf:datatype="http://www.w3.org/2001/XMLSchema#int">2</aaif:position><aaif:coordinated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:coordinated><aaif:morphosyntacticStructure rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Adjective" /><aaif:inflection rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Uninflected" /><aaif:attributionTarget rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Verb" /><aaif:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:modified><aaif:semanticClassification rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Manner" /><aaif:reduplicated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:reduplicated><aaif:prepositionalPhrase rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:prepositionalPhrase></aaif:Adverb><aaif:Entry rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En983"><aaif:phrase rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh#En983Ph1" /><aaif:source rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh.bibl#Cnde287" /><gams:textualContent>un minero muerto.Susana San Juan, hija de un minero muerto en las minas de La Andrómeda.*  Veía  claro .”Tendré que ir allá a morir”, * pensó.Luego dijo: </gams:textualContent><rel:isPartOf rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh" /></aaif:Entry><aaif:Phrase rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En983Ph1"><aaif:verb rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh#En983Ph1Ve1" /><aaif:adverb rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh#En983Ph1Ad1" /><aaif:text> Veía  claro .</aaif:text><aaif:annoText> [v|Veía|ver|is]  [a|claro|claro|auvnmnnn] .</aaif:annoText></aaif:Phrase><aaif:Verb rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En983Ph1Ve1"><aaif:text>Veía</aaif:text><aaif:lemma rdf:resource="https://gams.uni-graz.at/o:aaif.lemma#ver" /><aaif:position rdf:datatype="http://www.w3.org/2001/XMLSchema#int">1</aaif:position><aaif:coordinated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:coordinated><aaif:partOfText rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</aaif:partOfText><aaif:syntacticConstruction rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Intransitive" /></aaif:Verb><aaif:Adverb rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En983Ph1Ad1"><aaif:text>claro</aaif:text><aaif:lemma rdf:resource="https://gams.uni-graz.at/o:aaif.lemma#claro" /><aaif:position rdf:datatype="http://www.w3.org/2001/XMLSchema#int">2</aaif:position><aaif:coordinated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:coordinated><aaif:morphosyntacticStructure rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Adjective" /><aaif:inflection rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Uninflected" /><aaif:attributionTarget rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Verb" /><aaif:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:modified><aaif:semanticClassification rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Manner" /><aaif:reduplicated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:reduplicated><aaif:prepositionalPhrase rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:prepositionalPhrase></aaif:Adverb><aaif:Entry rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En984"><aaif:phrase rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh#En984Ph1" /><aaif:source rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh.bibl#Cnde408" /><gams:textualContent>caminar.Caminarás sin descanso hasta caer vencido en la carrera.No quiero ocultarte nada; si te hablo claro , si parezco cruel es porque quiero salvarte del remordimiento en los días postreros.Mira —y me</gams:textualContent><rel:isPartOf rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh" /></aaif:Entry><aaif:Phrase rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En984Ph1"><aaif:verb rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh#En984Ph1Ve1" /><aaif:adverb rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh#En984Ph1Ad1" /><aaif:text>si te hablo claro , si parezco cruel es porque quiero salvarte</aaif:text><aaif:annoText>si te [v|hablo|hablar|is] [a|claro|claro|auvnmnnn] , si parezco cruel es porque quiero salvarte</aaif:annoText></aaif:Phrase><aaif:Verb rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En984Ph1Ve1"><aaif:text>hablo</aaif:text><aaif:lemma rdf:resource="https://gams.uni-graz.at/o:aaif.lemma#hablar" /><aaif:position rdf:datatype="http://www.w3.org/2001/XMLSchema#int">1</aaif:position><aaif:coordinated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:coordinated><aaif:partOfText rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</aaif:partOfText><aaif:syntacticConstruction rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Intransitive" /></aaif:Verb><aaif:Adverb rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En984Ph1Ad1"><aaif:text>claro</aaif:text><aaif:lemma rdf:resource="https://gams.uni-graz.at/o:aaif.lemma#claro" /><aaif:position rdf:datatype="http://www.w3.org/2001/XMLSchema#int">2</aaif:position><aaif:coordinated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:coordinated><aaif:morphosyntacticStructure rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Adjective" /><aaif:inflection rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Uninflected" /><aaif:attributionTarget rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Verb" /><aaif:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:modified><aaif:semanticClassification rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Manner" /><aaif:reduplicated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:reduplicated><aaif:prepositionalPhrase rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:prepositionalPhrase></aaif:Adverb><aaif:Entry rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En985"><aaif:phrase rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh#En985Ph1" /><aaif:source rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh.bibl#Cnde408" /><gams:textualContent>Tal enigma aclaróse (por lo menos, las autoridades y el pueblo creyeron ver claro ) con la explicación ofrecida por el Perito en risas de ese gran pueblo.Después de examinar la risa</gams:textualContent><rel:isPartOf rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh" /></aaif:Entry><aaif:Phrase rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En985Ph1"><aaif:subject rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh#En985Ph1Su1" /><aaif:verb rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh#En985Ph1Ve1" /><aaif:adverb rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh#En985Ph1Ad1" /><aaif:text>por lo menos, las autoridades y el pueblo creyeron ver claro </aaif:text><aaif:annoText>por lo menos, [s|las autoridades y el pueblo|mp] creyeron [v|ver|ver|is] [a|claro|claro|auvnmnnn] </aaif:annoText></aaif:Phrase><aaif:Subject rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En985Ph1Su1"><aaif:text>las autoridades y el pueblo</aaif:text><aaif:position rdf:datatype="http://www.w3.org/2001/XMLSchema#int">1</aaif:position><aaif:gender rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Masculine" /><aaif:number rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Plural" /><aaif:overt rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:overt></aaif:Subject><aaif:Verb rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En985Ph1Ve1"><aaif:text>ver</aaif:text><aaif:lemma rdf:resource="https://gams.uni-graz.at/o:aaif.lemma#ver" /><aaif:position rdf:datatype="http://www.w3.org/2001/XMLSchema#int">2</aaif:position><aaif:coordinated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:coordinated><aaif:partOfText rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</aaif:partOfText><aaif:syntacticConstruction rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Intransitive" /></aaif:Verb><aaif:Adverb rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En985Ph1Ad1"><aaif:text>claro</aaif:text><aaif:lemma rdf:resource="https://gams.uni-graz.at/o:aaif.lemma#claro" /><aaif:position rdf:datatype="http://www.w3.org/2001/XMLSchema#int">3</aaif:position><aaif:coordinated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:coordinated><aaif:morphosyntacticStructure rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Adjective" /><aaif:inflection rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Uninflected" /><aaif:attributionTarget rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Verb" /><aaif:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:modified><aaif:semanticClassification rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Manner" /><aaif:reduplicated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:reduplicated><aaif:prepositionalPhrase rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:prepositionalPhrase></aaif:Adverb><aaif:Entry rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En986"><aaif:phrase rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh#En986Ph1" /><aaif:source rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh.bibl#Cnde176" /><gams:textualContent>Será un buen hombre, no lo pongo en cuarentena, pero yo no lo entiendo, no lo veo claro ...</gams:textualContent><rel:isPartOf rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh" /></aaif:Entry><aaif:Phrase rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En986Ph1"><aaif:verb rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh#En986Ph1Ve1" /><aaif:adverb rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh#En986Ph1Ad1" /><aaif:text>pero yo no lo entiendo, no lo veo claro </aaif:text><aaif:annoText>pero yo no lo entiendo, no lo [v|veo|ver|ts] [a|claro|claro|auvnmnnn] </aaif:annoText></aaif:Phrase><aaif:Verb rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En986Ph1Ve1"><aaif:text>veo</aaif:text><aaif:lemma rdf:resource="https://gams.uni-graz.at/o:aaif.lemma#ver" /><aaif:position rdf:datatype="http://www.w3.org/2001/XMLSchema#int">1</aaif:position><aaif:coordinated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:coordinated><aaif:partOfText rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</aaif:partOfText><aaif:syntacticConstruction rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Transitive" /></aaif:Verb><aaif:Adverb rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En986Ph1Ad1"><aaif:text>claro</aaif:text><aaif:lemma rdf:resource="https://gams.uni-graz.at/o:aaif.lemma#claro" /><aaif:position rdf:datatype="http://www.w3.org/2001/XMLSchema#int">2</aaif:position><aaif:coordinated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:coordinated><aaif:morphosyntacticStructure rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Adjective" /><aaif:inflection rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Uninflected" /><aaif:attributionTarget rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Verb" /><aaif:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:modified><aaif:semanticClassification rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Manner" /><aaif:reduplicated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:reduplicated><aaif:prepositionalPhrase rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:prepositionalPhrase></aaif:Adverb><aaif:Entry rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En987"><aaif:phrase rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh#En987Ph1" /><aaif:source rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh.bibl#Cnde176" /><gams:textualContent>—Lo que yo no acabo de ver claro —dijo Paulina— es la vida que se traen, ni lo que piensan para el porvenir.Llevan</gams:textualContent><rel:isPartOf rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh" /></aaif:Entry><aaif:Phrase rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En987Ph1"><aaif:subject rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh#En987Ph1Su1" /><aaif:verb rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh#En987Ph1Ve1" /><aaif:adverb rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh#En987Ph1Ad1" /><aaif:text>Lo que yo no acabo de ver claro —dijo Paulina— es la vida que se traen</aaif:text><aaif:annoText>Lo que [s|yo|fs] no acabo de [v|ver|ver|ts] [a|claro|claro|auvnmnnn] —dijo Paulina— es la vida que se traen</aaif:annoText></aaif:Phrase><aaif:Subject rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En987Ph1Su1"><aaif:text>yo</aaif:text><aaif:position rdf:datatype="http://www.w3.org/2001/XMLSchema#int">1</aaif:position><aaif:gender rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Feminine" /><aaif:number rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Singular" /><aaif:overt rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</aaif:overt></aaif:Subject><aaif:Verb rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En987Ph1Ve1"><aaif:text>ver</aaif:text><aaif:lemma rdf:resource="https://gams.uni-graz.at/o:aaif.lemma#ver" /><aaif:position rdf:datatype="http://www.w3.org/2001/XMLSchema#int">2</aaif:position><aaif:coordinated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:coordinated><aaif:partOfText rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</aaif:partOfText><aaif:syntacticConstruction rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Transitive" /></aaif:Verb><aaif:Adverb rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En987Ph1Ad1"><aaif:text>claro</aaif:text><aaif:lemma rdf:resource="https://gams.uni-graz.at/o:aaif.lemma#claro" /><aaif:position rdf:datatype="http://www.w3.org/2001/XMLSchema#int">3</aaif:position><aaif:coordinated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:coordinated><aaif:morphosyntacticStructure rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Adjective" /><aaif:inflection rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Uninflected" /><aaif:attributionTarget rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Verb" /><aaif:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:modified><aaif:semanticClassification rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Manner" /><aaif:reduplicated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:reduplicated><aaif:prepositionalPhrase rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:prepositionalPhrase></aaif:Adverb><aaif:Entry rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En988"><aaif:phrase rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh#En988Ph1" /><aaif:phrase rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh#En988Ph2" /><aaif:source rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh.bibl#Cnde176" /><gams:textualContent>-Mujer, estábamos los tres juntos.&lt;lb/&gt; -Pues ahora estamos dos.Contra menos bultos, más claridad, ¿no crees?&lt;lb/&gt; -¿Más claridad?Hija mía, yo lo veo todo turbio .Con el vino que tengo, no te creas que veo ya nada claro .-Ah, ni yo -dijo ella riendo.&lt;lb/&gt; Le acercaba la cara y añadía: &lt;lb/&gt; -Estoy un poco alegre, ¿sabes?-le brillaban los ojos-.Tú déjalo al Dani, si tiene ganas de echarse un sueñecillo, allá él.Ha dicho que le estorbamos.Oye, Tito.&lt;lb/&gt; </gams:textualContent><rel:isPartOf rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh" /></aaif:Entry><aaif:Phrase rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En988Ph1"><aaif:verb rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh#En988Ph1Ve1" /><aaif:adverb rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh#En988Ph1Ad1" /><aaif:text>yo lo veo todo turbio .</aaif:text><aaif:annoText>yo lo [v|veo|ver|ts] todo [a|turbio|turbio|auvnmnnn] .</aaif:annoText></aaif:Phrase><aaif:Verb rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En988Ph1Ve1"><aaif:text>veo</aaif:text><aaif:lemma rdf:resource="https://gams.uni-graz.at/o:aaif.lemma#ver" /><aaif:position rdf:datatype="http://www.w3.org/2001/XMLSchema#int">1</aaif:position><aaif:coordinated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:coordinated><aaif:partOfText rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</aaif:partOfText><aaif:syntacticConstruction rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Transitive" /></aaif:Verb><aaif:Adverb rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En988Ph1Ad1"><aaif:text>turbio</aaif:text><aaif:lemma rdf:resource="https://gams.uni-graz.at/o:aaif.lemma#turbio" /><aaif:position rdf:datatype="http://www.w3.org/2001/XMLSchema#int">2</aaif:position><aaif:coordinated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:coordinated><aaif:morphosyntacticStructure rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Adjective" /><aaif:inflection rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Uninflected" /><aaif:attributionTarget rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Verb" /><aaif:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:modified><aaif:semanticClassification rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Manner" /><aaif:reduplicated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:reduplicated><aaif:prepositionalPhrase rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:prepositionalPhrase></aaif:Adverb><aaif:Phrase rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En988Ph2"><aaif:verb rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh#En988Ph2Ve1" /><aaif:adverb rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh#En988Ph2Ad1" /><aaif:text>no te creas que veo ya nada claro .</aaif:text><aaif:annoText>no te creas que [v|veo|ver|ts] ya nada [a|claro|claro|auvnmnnn] .</aaif:annoText></aaif:Phrase><aaif:Verb rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En988Ph2Ve1"><aaif:text>veo</aaif:text><aaif:lemma rdf:resource="https://gams.uni-graz.at/o:aaif.lemma#ver" /><aaif:position rdf:datatype="http://www.w3.org/2001/XMLSchema#int">1</aaif:position><aaif:coordinated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:coordinated><aaif:partOfText rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</aaif:partOfText><aaif:syntacticConstruction rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Transitive" /></aaif:Verb><aaif:Adverb rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En988Ph2Ad1"><aaif:text>claro</aaif:text><aaif:lemma rdf:resource="https://gams.uni-graz.at/o:aaif.lemma#claro" /><aaif:position rdf:datatype="http://www.w3.org/2001/XMLSchema#int">2</aaif:position><aaif:coordinated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:coordinated><aaif:morphosyntacticStructure rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Adjective" /><aaif:inflection rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Uninflected" /><aaif:attributionTarget rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Verb" /><aaif:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:modified><aaif:semanticClassification rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Manner" /><aaif:reduplicated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:reduplicated><aaif:prepositionalPhrase rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:prepositionalPhrase></aaif:Adverb><aaif:Entry rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En989"><aaif:phrase rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh#En989Ph1" /><aaif:source rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh.bibl#Cnde209" /><gams:textualContent>de ello.Impresión de balbuceo...es en verdad un nacimiento.Todo es de otro modo.–  Veo  claro también, ahora, en mis improvisaciones.Otra metáfora inversa a la anterior: la de un mundo que</gams:textualContent><rel:isPartOf rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh" /></aaif:Entry><aaif:Phrase rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En989Ph1"><aaif:verb rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh#En989Ph1Ve1" /><aaif:adverb rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh#En989Ph1Ad1" /><aaif:text> Veo  claro también, ahora, en mis improvisaciones</aaif:text><aaif:annoText> [v|Veo|ver|is]  [a|claro|claro|auvnmnnn] también, ahora, en mis improvisaciones</aaif:annoText></aaif:Phrase><aaif:Verb rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En989Ph1Ve1"><aaif:text>Veo</aaif:text><aaif:lemma rdf:resource="https://gams.uni-graz.at/o:aaif.lemma#ver" /><aaif:position rdf:datatype="http://www.w3.org/2001/XMLSchema#int">1</aaif:position><aaif:coordinated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:coordinated><aaif:partOfText rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</aaif:partOfText><aaif:syntacticConstruction rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Intransitive" /></aaif:Verb><aaif:Adverb rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En989Ph1Ad1"><aaif:text>claro</aaif:text><aaif:lemma rdf:resource="https://gams.uni-graz.at/o:aaif.lemma#claro" /><aaif:position rdf:datatype="http://www.w3.org/2001/XMLSchema#int">2</aaif:position><aaif:coordinated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:coordinated><aaif:morphosyntacticStructure rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Adjective" /><aaif:inflection rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Uninflected" /><aaif:attributionTarget rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Verb" /><aaif:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:modified><aaif:semanticClassification rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Manner" /><aaif:reduplicated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:reduplicated><aaif:prepositionalPhrase rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:prepositionalPhrase></aaif:Adverb><aaif:Entry rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En990"><aaif:phrase rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh#En990Ph1" /><aaif:source rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh.bibl#Cnde209" /><gams:textualContent>, en cuanto “realidad expresa”, el estado a que llegué sabiendo que eran las tres?Lo vemos claro : todas estas obras son fuentes de nuevas posibilidades para la existencia humana; nuevas posibilidades de fruición estética,</gams:textualContent><rel:isPartOf rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh" /></aaif:Entry><aaif:Phrase rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En990Ph1"><aaif:verb rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh#En990Ph1Ve1" /><aaif:adverb rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh#En990Ph1Ad1" /><aaif:text>Lo vemos claro : todas estas obras son fuentes de nuevas posibilidades</aaif:text><aaif:annoText>Lo [v|vemos|ver|ts] [a|claro|claro|auvnmnnn] : todas estas obras son fuentes de nuevas posibilidades</aaif:annoText></aaif:Phrase><aaif:Verb rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En990Ph1Ve1"><aaif:text>vemos</aaif:text><aaif:lemma rdf:resource="https://gams.uni-graz.at/o:aaif.lemma#ver" /><aaif:position rdf:datatype="http://www.w3.org/2001/XMLSchema#int">1</aaif:position><aaif:coordinated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:coordinated><aaif:partOfText rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</aaif:partOfText><aaif:syntacticConstruction rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Transitive" /></aaif:Verb><aaif:Adverb rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En990Ph1Ad1"><aaif:text>claro</aaif:text><aaif:lemma rdf:resource="https://gams.uni-graz.at/o:aaif.lemma#claro" /><aaif:position rdf:datatype="http://www.w3.org/2001/XMLSchema#int">2</aaif:position><aaif:coordinated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:coordinated><aaif:morphosyntacticStructure rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Adjective" /><aaif:inflection rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Uninflected" /><aaif:attributionTarget rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Verb" /><aaif:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:modified><aaif:semanticClassification rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Manner" /><aaif:reduplicated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:reduplicated><aaif:prepositionalPhrase rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:prepositionalPhrase></aaif:Adverb><aaif:Entry rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En991"><aaif:phrase rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh#En991Ph1" /><aaif:source rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh.bibl#Cnde209" /><gams:textualContent>¿Qué sentido tiene este decir?Ahora lo vemos claro .Quien aguarda, desespera, porque no hay espera enteramente exenta de inseguridad y desesperanza.Quien desespera, </gams:textualContent><rel:isPartOf rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh" /></aaif:Entry><aaif:Phrase rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En991Ph1"><aaif:verb rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh#En991Ph1Ve1" /><aaif:adverb rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh#En991Ph1Ad1" /><aaif:text>Ahora lo vemos claro .</aaif:text><aaif:annoText>Ahora lo [v|vemos|ver|ts] [a|claro|claro|auvnmnnn] .</aaif:annoText></aaif:Phrase><aaif:Verb rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En991Ph1Ve1"><aaif:text>vemos</aaif:text><aaif:lemma rdf:resource="https://gams.uni-graz.at/o:aaif.lemma#ver" /><aaif:position rdf:datatype="http://www.w3.org/2001/XMLSchema#int">1</aaif:position><aaif:coordinated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:coordinated><aaif:partOfText rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</aaif:partOfText><aaif:syntacticConstruction rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Transitive" /></aaif:Verb><aaif:Adverb rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En991Ph1Ad1"><aaif:text>claro</aaif:text><aaif:lemma rdf:resource="https://gams.uni-graz.at/o:aaif.lemma#claro" /><aaif:position rdf:datatype="http://www.w3.org/2001/XMLSchema#int">2</aaif:position><aaif:coordinated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:coordinated><aaif:morphosyntacticStructure rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Adjective" /><aaif:inflection rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Uninflected" /><aaif:attributionTarget rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Verb" /><aaif:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:modified><aaif:semanticClassification rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Manner" /><aaif:reduplicated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:reduplicated><aaif:prepositionalPhrase rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:prepositionalPhrase></aaif:Adverb><aaif:Entry rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En992"><aaif:phrase rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh#En992Ph1" /><aaif:source rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh.bibl#Cnde49" /><gams:textualContent>, las mejillas coloradas, los ojos en el techo, notar el gozo que iba experimentando en hacerme ver claras las cosas de su casa.Como si dijera bien una lección.Se puso a contarme viejas historias.</gams:textualContent><rel:isPartOf rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh" /></aaif:Entry><aaif:Phrase rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En992Ph1"><aaif:verb rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh#En992Ph1Ve1" /><aaif:adverb rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh#En992Ph1Ad1" /><aaif:text>el gozo que iba experimentando en hacerme ver claras las cosas de su casa</aaif:text><aaif:annoText>el gozo que iba experimentando en hacerme [v|ver|ver|ts] [a|claras|claro|axonmnnn] las cosas de su casa</aaif:annoText></aaif:Phrase><aaif:Verb rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En992Ph1Ve1"><aaif:text>ver</aaif:text><aaif:lemma rdf:resource="https://gams.uni-graz.at/o:aaif.lemma#ver" /><aaif:position rdf:datatype="http://www.w3.org/2001/XMLSchema#int">1</aaif:position><aaif:coordinated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:coordinated><aaif:partOfText rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</aaif:partOfText><aaif:syntacticConstruction rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Transitive" /></aaif:Verb><aaif:Adverb rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En992Ph1Ad1"><aaif:text>claras</aaif:text><aaif:lemma rdf:resource="https://gams.uni-graz.at/o:aaif.lemma#claro" /><aaif:position rdf:datatype="http://www.w3.org/2001/XMLSchema#int">2</aaif:position><aaif:coordinated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:coordinated><aaif:morphosyntacticStructure rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Adjective" /><aaif:inflection rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#FemininePlural" /><aaif:attributionTarget rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#VerbObject" /><aaif:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:modified><aaif:semanticClassification rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Manner" /><aaif:reduplicated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:reduplicated><aaif:prepositionalPhrase rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:prepositionalPhrase></aaif:Adverb><aaif:Entry rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En993"><aaif:phrase rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh#En993Ph1" /><aaif:source rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh.bibl#Cnde410" /><gams:textualContent>Pax Bolón. &lt;lb/&gt; Dejadme orar, aunque ya veo claro &lt;lb/&gt; que no sabéis vosotros mismos a qué dioses &lt;lb/&gt; debe implorar ahora el señor de Acallan-Tixchel. &lt;lb/&gt; No quiero faltarle a</gams:textualContent><rel:isPartOf rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh" /></aaif:Entry><aaif:Phrase rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En993Ph1"><aaif:verb rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh#En993Ph1Ve1" /><aaif:adverb rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh#En993Ph1Ad1" /><aaif:text>Dejadme orar, aunque ya veo claro &lt;lb\/&gt; que no sabéis vosotros mismos</aaif:text><aaif:annoText>Dejadme orar, aunque ya [v|veo|ver|ts] [a|claro|claro|auvnmnnn] &lt;lb\/&gt; que no sabéis vosotros mismos</aaif:annoText></aaif:Phrase><aaif:Verb rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En993Ph1Ve1"><aaif:text>veo</aaif:text><aaif:lemma rdf:resource="https://gams.uni-graz.at/o:aaif.lemma#ver" /><aaif:position rdf:datatype="http://www.w3.org/2001/XMLSchema#int">1</aaif:position><aaif:coordinated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:coordinated><aaif:partOfText rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</aaif:partOfText><aaif:syntacticConstruction rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Transitive" /></aaif:Verb><aaif:Adverb rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En993Ph1Ad1"><aaif:text>claro</aaif:text><aaif:lemma rdf:resource="https://gams.uni-graz.at/o:aaif.lemma#claro" /><aaif:position rdf:datatype="http://www.w3.org/2001/XMLSchema#int">2</aaif:position><aaif:coordinated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:coordinated><aaif:morphosyntacticStructure rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Adjective" /><aaif:inflection rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Uninflected" /><aaif:attributionTarget rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Verb" /><aaif:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:modified><aaif:semanticClassification rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Manner" /><aaif:reduplicated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:reduplicated><aaif:prepositionalPhrase rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:prepositionalPhrase></aaif:Adverb><aaif:Entry rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En994"><aaif:phrase rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh#En994Ph1" /><aaif:source rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh.bibl#Cnde260" /><gams:textualContent>¿Quién?—los ojos encarnados del capitán se clavaron en él, como si trataran de ver claro una desvaída silueta.</gams:textualContent><rel:isPartOf rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh" /></aaif:Entry><aaif:Phrase rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En994Ph1"><aaif:verb rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh#En994Ph1Ve1" /><aaif:adverb rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh#En994Ph1Ad1" /><aaif:text>los ojos encarnados del capitán se clavaron en él, como si trataran de ver claro una desvaída silueta</aaif:text><aaif:annoText>los ojos encarnados del capitán se clavaron en él, como si trataran de [v|ver|ver|ts] [a|claro|claro|auvnmnnn] una desvaída silueta</aaif:annoText></aaif:Phrase><aaif:Verb rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En994Ph1Ve1"><aaif:text>ver</aaif:text><aaif:lemma rdf:resource="https://gams.uni-graz.at/o:aaif.lemma#ver" /><aaif:position rdf:datatype="http://www.w3.org/2001/XMLSchema#int">1</aaif:position><aaif:coordinated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:coordinated><aaif:partOfText rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</aaif:partOfText><aaif:syntacticConstruction rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Transitive" /></aaif:Verb><aaif:Adverb rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En994Ph1Ad1"><aaif:text>claro</aaif:text><aaif:lemma rdf:resource="https://gams.uni-graz.at/o:aaif.lemma#claro" /><aaif:position rdf:datatype="http://www.w3.org/2001/XMLSchema#int">2</aaif:position><aaif:coordinated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:coordinated><aaif:morphosyntacticStructure rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Adjective" /><aaif:inflection rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Uninflected" /><aaif:attributionTarget rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Verb" /><aaif:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:modified><aaif:semanticClassification rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Manner" /><aaif:reduplicated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:reduplicated><aaif:prepositionalPhrase rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:prepositionalPhrase></aaif:Adverb><aaif:Entry rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En995"><aaif:phrase rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh#En995Ph1" /><aaif:source rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh.bibl#Cnde411" /><gams:textualContent>teólogo ilustra sus definiciones basadas en autoridades de distintas épocas con casos modernos.* Lo que yo no veo claro , después de leído el libro, es qué necesidad tuvo el autor de poner a las hormigas como espejo</gams:textualContent><rel:isPartOf rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh" /></aaif:Entry><aaif:Phrase rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En995Ph1"><aaif:subject rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh#En995Ph1Su1" /><aaif:verb rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh#En995Ph1Ve1" /><aaif:adverb rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh#En995Ph1Ad1" /><aaif:text>Lo que yo no veo claro , después de leído el libro, es qué necesidad tuvo el autor</aaif:text><aaif:annoText>Lo que [s|yo|us] no [v|veo|ver|ts] [a|claro|claro|auvnmnnn] , después de leído el libro, es qué necesidad tuvo el autor</aaif:annoText></aaif:Phrase><aaif:Subject rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En995Ph1Su1"><aaif:text>yo</aaif:text><aaif:position rdf:datatype="http://www.w3.org/2001/XMLSchema#int">1</aaif:position><aaif:gender rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Undefined" /><aaif:number rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Singular" /><aaif:overt rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:overt></aaif:Subject><aaif:Verb rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En995Ph1Ve1"><aaif:text>veo</aaif:text><aaif:lemma rdf:resource="https://gams.uni-graz.at/o:aaif.lemma#ver" /><aaif:position rdf:datatype="http://www.w3.org/2001/XMLSchema#int">2</aaif:position><aaif:coordinated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:coordinated><aaif:partOfText rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</aaif:partOfText><aaif:syntacticConstruction rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Transitive" /></aaif:Verb><aaif:Adverb rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En995Ph1Ad1"><aaif:text>claro</aaif:text><aaif:lemma rdf:resource="https://gams.uni-graz.at/o:aaif.lemma#claro" /><aaif:position rdf:datatype="http://www.w3.org/2001/XMLSchema#int">3</aaif:position><aaif:coordinated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:coordinated><aaif:morphosyntacticStructure rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Adjective" /><aaif:inflection rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Uninflected" /><aaif:attributionTarget rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Verb" /><aaif:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:modified><aaif:semanticClassification rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Manner" /><aaif:reduplicated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:reduplicated><aaif:prepositionalPhrase rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:prepositionalPhrase></aaif:Adverb><aaif:Entry rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En996"><aaif:phrase rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh#En996Ph1" /><aaif:source rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh.bibl#Cnde411" /><gams:textualContent>creencias mitológicas más que con un Satanismo formal.Así, por ejemplo, en Escocia. Ello se ve claro en el conocido proceso de Bessie Dunlop, dirigido por jueces protestantes.Esta mujer, natural de Lyne, cerca de</gams:textualContent><rel:isPartOf rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh" /></aaif:Entry><aaif:Phrase rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En996Ph1"><aaif:subject rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh#En996Ph1Su1" /><aaif:verb rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh#En996Ph1Ve1" /><aaif:adverb rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh#En996Ph1Ad1" /><aaif:text> Ello se ve claro en el conocido proceso de Bessie Dunlop</aaif:text><aaif:annoText> [s|Ello|ms] se [v|ve|ver|rs] [a|claro|claro|auvnmnnn] en el conocido proceso de Bessie Dunlop</aaif:annoText></aaif:Phrase><aaif:Subject rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En996Ph1Su1"><aaif:text>Ello</aaif:text><aaif:position rdf:datatype="http://www.w3.org/2001/XMLSchema#int">1</aaif:position><aaif:gender rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Masculine" /><aaif:number rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Singular" /><aaif:overt rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</aaif:overt></aaif:Subject><aaif:Verb rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En996Ph1Ve1"><aaif:text>ve</aaif:text><aaif:lemma rdf:resource="https://gams.uni-graz.at/o:aaif.lemma#ver" /><aaif:position rdf:datatype="http://www.w3.org/2001/XMLSchema#int">2</aaif:position><aaif:coordinated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:coordinated><aaif:partOfText rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</aaif:partOfText><aaif:syntacticConstruction rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Reflexive" /></aaif:Verb><aaif:Adverb rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En996Ph1Ad1"><aaif:text>claro</aaif:text><aaif:lemma rdf:resource="https://gams.uni-graz.at/o:aaif.lemma#claro" /><aaif:position rdf:datatype="http://www.w3.org/2001/XMLSchema#int">3</aaif:position><aaif:coordinated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:coordinated><aaif:morphosyntacticStructure rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Adjective" /><aaif:inflection rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Uninflected" /><aaif:attributionTarget rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Verb" /><aaif:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:modified><aaif:semanticClassification rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Manner" /><aaif:reduplicated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:reduplicated><aaif:prepositionalPhrase rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:prepositionalPhrase></aaif:Adverb><aaif:Entry rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En997"><aaif:phrase rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh#En997Ph1" /><aaif:source rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh.bibl#Cnde411" /><gams:textualContent>Fue un precursor de tiempos más modernos y, de una manera u otra, intuyó algo que hoy día vemos claro , a saber: que el problema de la Brujería no se aclara a la luz de puros análisis racionalistas</gams:textualContent><rel:isPartOf rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh" /></aaif:Entry><aaif:Phrase rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En997Ph1"><aaif:verb rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh#En997Ph1Ve1" /><aaif:adverb rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh#En997Ph1Ad1" /><aaif:text>intuyó algo que hoy día vemos claro , a saber:</aaif:text><aaif:annoText>intuyó algo que hoy día [v|vemos|ver|ts] [a|claro|claro|auvnmnnn] , a saber:</aaif:annoText></aaif:Phrase><aaif:Verb rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En997Ph1Ve1"><aaif:text>vemos</aaif:text><aaif:lemma rdf:resource="https://gams.uni-graz.at/o:aaif.lemma#ver" /><aaif:position rdf:datatype="http://www.w3.org/2001/XMLSchema#int">1</aaif:position><aaif:coordinated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:coordinated><aaif:partOfText rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</aaif:partOfText><aaif:syntacticConstruction rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Transitive" /></aaif:Verb><aaif:Adverb rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En997Ph1Ad1"><aaif:text>claro</aaif:text><aaif:lemma rdf:resource="https://gams.uni-graz.at/o:aaif.lemma#claro" /><aaif:position rdf:datatype="http://www.w3.org/2001/XMLSchema#int">2</aaif:position><aaif:coordinated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:coordinated><aaif:morphosyntacticStructure rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Adjective" /><aaif:inflection rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Uninflected" /><aaif:attributionTarget rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Verb" /><aaif:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:modified><aaif:semanticClassification rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Manner" /><aaif:reduplicated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:reduplicated><aaif:prepositionalPhrase rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:prepositionalPhrase></aaif:Adverb><aaif:Entry rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En998"><aaif:phrase rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh#En998Ph1" /><aaif:source rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh.bibl#Cnde412" /><gams:textualContent>— No, Martín, no es ningún experimento.A Marcos Molina yo no lo quería, ahora lo veo claro .Con vos es distinto.Y, cosa curiosa, que yo misma no me lo explico: necesito</gams:textualContent><rel:isPartOf rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh" /></aaif:Entry><aaif:Phrase rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En998Ph1"><aaif:verb rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh#En998Ph1Ve1" /><aaif:adverb rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh#En998Ph1Ad1" /><aaif:text>A Marcos Molina yo no lo quería, ahora lo veo claro .</aaif:text><aaif:annoText>A Marcos Molina yo no lo quería, ahora lo [v|veo|ver|ts] [a|claro|claro|auvnmnnn] .</aaif:annoText></aaif:Phrase><aaif:Verb rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En998Ph1Ve1"><aaif:text>veo</aaif:text><aaif:lemma rdf:resource="https://gams.uni-graz.at/o:aaif.lemma#ver" /><aaif:position rdf:datatype="http://www.w3.org/2001/XMLSchema#int">1</aaif:position><aaif:coordinated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:coordinated><aaif:partOfText rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</aaif:partOfText><aaif:syntacticConstruction rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Transitive" /></aaif:Verb><aaif:Adverb rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En998Ph1Ad1"><aaif:text>claro</aaif:text><aaif:lemma rdf:resource="https://gams.uni-graz.at/o:aaif.lemma#claro" /><aaif:position rdf:datatype="http://www.w3.org/2001/XMLSchema#int">2</aaif:position><aaif:coordinated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:coordinated><aaif:morphosyntacticStructure rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Adjective" /><aaif:inflection rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Uninflected" /><aaif:attributionTarget rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Verb" /><aaif:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:modified><aaif:semanticClassification rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Manner" /><aaif:reduplicated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:reduplicated><aaif:prepositionalPhrase rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:prepositionalPhrase></aaif:Adverb><aaif:Entry rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En999"><aaif:phrase rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh#En999Ph1" /><aaif:source rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh.bibl#Cnde412" /><gams:textualContent>No, tampoco Martín veía claro , y en verdad nunca pudo explicarse ni la forma ni el desarrollo de aquel progreso, aunque cada vez más</gams:textualContent><rel:isPartOf rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh" /></aaif:Entry><aaif:Phrase rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En999Ph1"><aaif:subject rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh#En999Ph1Su1" /><aaif:verb rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh#En999Ph1Ve1" /><aaif:adverb rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh#En999Ph1Ad1" /><aaif:text>tampoco Martín veía claro </aaif:text><aaif:annoText>tampoco [s|Martín|ms] [v|veía|ver|is] [a|claro|claro|auvnmnnn] </aaif:annoText></aaif:Phrase><aaif:Subject rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En999Ph1Su1"><aaif:text>Martín</aaif:text><aaif:position rdf:datatype="http://www.w3.org/2001/XMLSchema#int">1</aaif:position><aaif:gender rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Masculine" /><aaif:number rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Singular" /><aaif:overt rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</aaif:overt></aaif:Subject><aaif:Verb rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En999Ph1Ve1"><aaif:text>veía</aaif:text><aaif:lemma rdf:resource="https://gams.uni-graz.at/o:aaif.lemma#ver" /><aaif:position rdf:datatype="http://www.w3.org/2001/XMLSchema#int">2</aaif:position><aaif:coordinated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:coordinated><aaif:partOfText rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</aaif:partOfText><aaif:syntacticConstruction rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Intransitive" /></aaif:Verb><aaif:Adverb rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En999Ph1Ad1"><aaif:text>claro</aaif:text><aaif:lemma rdf:resource="https://gams.uni-graz.at/o:aaif.lemma#claro" /><aaif:position rdf:datatype="http://www.w3.org/2001/XMLSchema#int">3</aaif:position><aaif:coordinated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:coordinated><aaif:morphosyntacticStructure rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Adjective" /><aaif:inflection rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Uninflected" /><aaif:attributionTarget rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Verb" /><aaif:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:modified><aaif:semanticClassification rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Manner" /><aaif:reduplicated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:reduplicated><aaif:prepositionalPhrase rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:prepositionalPhrase></aaif:Adverb><aaif:Entry rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En1000"><aaif:phrase rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh#En1000Ph1" /><aaif:source rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh.bibl#Cnde412" /><gams:textualContent>un típico fenómeno del universo en que nacen y crecen nuestras más turbias obsesiones. Yo mismo no veo claro aquel episodio porque pasaba uno de esos períodos en que vivir me costaba un gran esfuerzo, en que me</gams:textualContent><rel:isPartOf rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh" /></aaif:Entry><aaif:Phrase rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En1000Ph1"><aaif:subject rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh#En1000Ph1Su1" /><aaif:verb rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh#En1000Ph1Ve1" /><aaif:adverb rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh#En1000Ph1Ad1" /><aaif:text> Yo mismo no veo claro aquel episodio</aaif:text><aaif:annoText> [s|Yo mismo|ms] no [v|veo|ver|ts] [a|claro|claro|auvnmnnn] aquel episodio</aaif:annoText></aaif:Phrase><aaif:Subject rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En1000Ph1Su1"><aaif:text>Yo mismo</aaif:text><aaif:position rdf:datatype="http://www.w3.org/2001/XMLSchema#int">1</aaif:position><aaif:gender rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Masculine" /><aaif:number rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Singular" /><aaif:overt rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</aaif:overt></aaif:Subject><aaif:Verb rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En1000Ph1Ve1"><aaif:text>veo</aaif:text><aaif:lemma rdf:resource="https://gams.uni-graz.at/o:aaif.lemma#ver" /><aaif:position rdf:datatype="http://www.w3.org/2001/XMLSchema#int">2</aaif:position><aaif:coordinated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:coordinated><aaif:partOfText rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</aaif:partOfText><aaif:syntacticConstruction rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Transitive" /></aaif:Verb><aaif:Adverb rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En1000Ph1Ad1"><aaif:text>claro</aaif:text><aaif:lemma rdf:resource="https://gams.uni-graz.at/o:aaif.lemma#claro" /><aaif:position rdf:datatype="http://www.w3.org/2001/XMLSchema#int">3</aaif:position><aaif:coordinated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:coordinated><aaif:morphosyntacticStructure rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Adjective" /><aaif:inflection rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Uninflected" /><aaif:attributionTarget rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Verb" /><aaif:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:modified><aaif:semanticClassification rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Manner" /><aaif:reduplicated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:reduplicated><aaif:prepositionalPhrase rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:prepositionalPhrase></aaif:Adverb><aaif:Entry rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En1001"><aaif:phrase rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh#En1001Ph1" /><aaif:source rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh.bibl#Cnde412" /><gams:textualContent>siguiente.Me aterraba la idea de que Fernando fuera más lejos por el mismo camino, aunque no veía claro por qué, aunque comprendía que de por medio estaba la figura de Georgina.¿Por qué ella no había negado apenas yo</gams:textualContent><rel:isPartOf rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh" /></aaif:Entry><aaif:Phrase rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En1001Ph1"><aaif:verb rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh#En1001Ph1Ve1" /><aaif:adverb rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh#En1001Ph1Ad1" /><aaif:text>aunque no veía claro por qué</aaif:text><aaif:annoText>aunque no [v|veía|ver|ts] [a|claro|claro|auvnmnnn] por qué</aaif:annoText></aaif:Phrase><aaif:Verb rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En1001Ph1Ve1"><aaif:text>veía</aaif:text><aaif:lemma rdf:resource="https://gams.uni-graz.at/o:aaif.lemma#ver" /><aaif:position rdf:datatype="http://www.w3.org/2001/XMLSchema#int">1</aaif:position><aaif:coordinated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:coordinated><aaif:partOfText rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</aaif:partOfText><aaif:syntacticConstruction rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Transitive" /></aaif:Verb><aaif:Adverb rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En1001Ph1Ad1"><aaif:text>claro</aaif:text><aaif:lemma rdf:resource="https://gams.uni-graz.at/o:aaif.lemma#claro" /><aaif:position rdf:datatype="http://www.w3.org/2001/XMLSchema#int">2</aaif:position><aaif:coordinated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:coordinated><aaif:morphosyntacticStructure rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Adjective" /><aaif:inflection rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Uninflected" /><aaif:attributionTarget rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Verb" /><aaif:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:modified><aaif:semanticClassification rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Manner" /><aaif:reduplicated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:reduplicated><aaif:prepositionalPhrase rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:prepositionalPhrase></aaif:Adverb><aaif:Entry rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En1002"><aaif:phrase rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh#En1002Ph1" /><aaif:source rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh.bibl#Cnde51" /><gams:textualContent>a tal hora, pasar hacia las aulas, para apropiarse indebidamente del examen de Química.”  Escriba  claro .”Hago esta declaración a pedido del teniente Remigio Huarina, que descubrió al autor del robo</gams:textualContent><rel:isPartOf rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh" /></aaif:Entry><aaif:Phrase rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En1002Ph1"><aaif:verb rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh#En1002Ph1Ve1" /><aaif:adverb rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh#En1002Ph1Ad1" /><aaif:text> Escriba  claro .</aaif:text><aaif:annoText> [v|Escriba|escribir|is]  [a|claro|claro|auvnmnnn] .</aaif:annoText></aaif:Phrase><aaif:Verb rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En1002Ph1Ve1"><aaif:text>Escriba</aaif:text><aaif:lemma rdf:resource="https://gams.uni-graz.at/o:aaif.lemma#escribir" /><aaif:position rdf:datatype="http://www.w3.org/2001/XMLSchema#int">1</aaif:position><aaif:coordinated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:coordinated><aaif:partOfText rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</aaif:partOfText><aaif:syntacticConstruction rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Intransitive" /></aaif:Verb><aaif:Adverb rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En1002Ph1Ad1"><aaif:text>claro</aaif:text><aaif:lemma rdf:resource="https://gams.uni-graz.at/o:aaif.lemma#claro" /><aaif:position rdf:datatype="http://www.w3.org/2001/XMLSchema#int">2</aaif:position><aaif:coordinated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:coordinated><aaif:morphosyntacticStructure rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Adjective" /><aaif:inflection rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Uninflected" /><aaif:attributionTarget rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Verb" /><aaif:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:modified><aaif:semanticClassification rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Manner" /><aaif:reduplicated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:reduplicated><aaif:prepositionalPhrase rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:prepositionalPhrase></aaif:Adverb><aaif:Entry rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En1003"><aaif:phrase rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh#En1003Ph1" /><aaif:source rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh.bibl#Cnde51" /><gams:textualContent>— No te entiendo, Bebe. Háblame  claro , por favor.</gams:textualContent><rel:isPartOf rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh" /></aaif:Entry><aaif:Phrase rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En1003Ph1"><aaif:verb rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh#En1003Ph1Ve1" /><aaif:adverb rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh#En1003Ph1Ad1" /><aaif:text> Háblame  claro , por favor.</aaif:text><aaif:annoText> [v|Háblame|hablar|is]  [a|claro|claro|auvnmnnn] , por favor.</aaif:annoText></aaif:Phrase><aaif:Verb rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En1003Ph1Ve1"><aaif:text>Háblame</aaif:text><aaif:lemma rdf:resource="https://gams.uni-graz.at/o:aaif.lemma#hablar" /><aaif:position rdf:datatype="http://www.w3.org/2001/XMLSchema#int">1</aaif:position><aaif:coordinated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:coordinated><aaif:partOfText rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</aaif:partOfText><aaif:syntacticConstruction rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Intransitive" /></aaif:Verb><aaif:Adverb rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En1003Ph1Ad1"><aaif:text>claro</aaif:text><aaif:lemma rdf:resource="https://gams.uni-graz.at/o:aaif.lemma#claro" /><aaif:position rdf:datatype="http://www.w3.org/2001/XMLSchema#int">2</aaif:position><aaif:coordinated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:coordinated><aaif:morphosyntacticStructure rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Adjective" /><aaif:inflection rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Uninflected" /><aaif:attributionTarget rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Verb" /><aaif:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:modified><aaif:semanticClassification rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Manner" /><aaif:reduplicated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:reduplicated><aaif:prepositionalPhrase rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:prepositionalPhrase></aaif:Adverb><aaif:Entry rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En1004"><aaif:phrase rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh#En1004Ph1" /><aaif:source rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh.bibl#Cnde51" /><gams:textualContent>manchara el piso de la cuadra.Pero el muy porfiado no quiso, es un maricón, para hablar claro .Se quedó sentado en su cama y lo empujé, sólo para que se levantara, cadete, y los</gams:textualContent><rel:isPartOf rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh" /></aaif:Entry><aaif:Phrase rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En1004Ph1"><aaif:verb rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh#En1004Ph1Ve1" /><aaif:adverb rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh#En1004Ph1Ad1" /><aaif:text>Pero el muy porfiado no quiso, es un maricón, para hablar claro .</aaif:text><aaif:annoText>Pero el muy porfiado no quiso, es un maricón, para [v|hablar|hablar|is] [a|claro|claro|auvnmnnn] .</aaif:annoText></aaif:Phrase><aaif:Verb rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En1004Ph1Ve1"><aaif:text>hablar</aaif:text><aaif:lemma rdf:resource="https://gams.uni-graz.at/o:aaif.lemma#hablar" /><aaif:position rdf:datatype="http://www.w3.org/2001/XMLSchema#int">1</aaif:position><aaif:coordinated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:coordinated><aaif:partOfText rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</aaif:partOfText><aaif:syntacticConstruction rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Intransitive" /></aaif:Verb><aaif:Adverb rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En1004Ph1Ad1"><aaif:text>claro</aaif:text><aaif:lemma rdf:resource="https://gams.uni-graz.at/o:aaif.lemma#claro" /><aaif:position rdf:datatype="http://www.w3.org/2001/XMLSchema#int">2</aaif:position><aaif:coordinated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:coordinated><aaif:morphosyntacticStructure rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Adjective" /><aaif:inflection rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Uninflected" /><aaif:attributionTarget rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Verb" /><aaif:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:modified><aaif:semanticClassification rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Manner" /><aaif:reduplicated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:reduplicated><aaif:prepositionalPhrase rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:prepositionalPhrase></aaif:Adverb><aaif:Entry rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En1005"><aaif:phrase rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh#En1005Ph1" /><aaif:source rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh.bibl#Cnde51" /><gams:textualContent>mí también —dijo el capitán—.Los exámenes serán fuertes, cada vez hay menos vacantes. Hablemos  claro , Gamboa.Usted y yo tenemos excelentes fojas de servicio.Ni una sola sombra.Y nos harán responsables</gams:textualContent><rel:isPartOf rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh" /></aaif:Entry><aaif:Phrase rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En1005Ph1"><aaif:verb rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh#En1005Ph1Ve1" /><aaif:adverb rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh#En1005Ph1Ad1" /><aaif:text> Hablemos  claro , Gamboa.</aaif:text><aaif:annoText> [v|Hablemos|hablar|is]  [a|claro|claro|auvnmnnn] , Gamboa.</aaif:annoText></aaif:Phrase><aaif:Verb rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En1005Ph1Ve1"><aaif:text>Hablemos</aaif:text><aaif:lemma rdf:resource="https://gams.uni-graz.at/o:aaif.lemma#hablar" /><aaif:position rdf:datatype="http://www.w3.org/2001/XMLSchema#int">1</aaif:position><aaif:coordinated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:coordinated><aaif:partOfText rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</aaif:partOfText><aaif:syntacticConstruction rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Intransitive" /></aaif:Verb><aaif:Adverb rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En1005Ph1Ad1"><aaif:text>claro</aaif:text><aaif:lemma rdf:resource="https://gams.uni-graz.at/o:aaif.lemma#claro" /><aaif:position rdf:datatype="http://www.w3.org/2001/XMLSchema#int">2</aaif:position><aaif:coordinated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:coordinated><aaif:morphosyntacticStructure rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Adjective" /><aaif:inflection rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Uninflected" /><aaif:attributionTarget rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Verb" /><aaif:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:modified><aaif:semanticClassification rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Manner" /><aaif:reduplicated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:reduplicated><aaif:prepositionalPhrase rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:prepositionalPhrase></aaif:Adverb><aaif:Entry rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En1006"><aaif:phrase rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh#En1006Ph1" /><aaif:source rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh.bibl#Cnde52" /><gams:textualContent>eso lo que Bomarzo exigía?Pues Orsini sería su padre.Cuando alcancé a la obvia conclusión, vi claro  y, como en un juego cuyas piezas se arman velozmente al ubicar en su seno la que servirá</gams:textualContent><rel:isPartOf rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh" /></aaif:Entry><aaif:Phrase rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En1006Ph1"><aaif:verb rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh#En1006Ph1Ve1" /><aaif:adverb rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh#En1006Ph1Ad1" /><aaif:text>Cuando alcancé a la obvia conclusión, vi claro </aaif:text><aaif:annoText>Cuando alcancé a la obvia conclusión, [v|vi|ver|is] [a|claro|claro|auvnmnnn] </aaif:annoText></aaif:Phrase><aaif:Verb rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En1006Ph1Ve1"><aaif:text>vi</aaif:text><aaif:lemma rdf:resource="https://gams.uni-graz.at/o:aaif.lemma#ver" /><aaif:position rdf:datatype="http://www.w3.org/2001/XMLSchema#int">1</aaif:position><aaif:coordinated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:coordinated><aaif:partOfText rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</aaif:partOfText><aaif:syntacticConstruction rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Intransitive" /></aaif:Verb><aaif:Adverb rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En1006Ph1Ad1"><aaif:text>claro</aaif:text><aaif:lemma rdf:resource="https://gams.uni-graz.at/o:aaif.lemma#claro" /><aaif:position rdf:datatype="http://www.w3.org/2001/XMLSchema#int">2</aaif:position><aaif:coordinated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:coordinated><aaif:morphosyntacticStructure rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Adjective" /><aaif:inflection rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Uninflected" /><aaif:attributionTarget rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Verb" /><aaif:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:modified><aaif:semanticClassification rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Manner" /><aaif:reduplicated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:reduplicated><aaif:prepositionalPhrase rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:prepositionalPhrase></aaif:Adverb><aaif:Entry rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En1007"><aaif:phrase rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh#En1007Ph1" /><aaif:source rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh.bibl#Cnde261" /><gams:textualContent>...sí, seguro...y algo más, para hablar claro : si ustedes se muestran débiles, yo y mis asociados de plano colocamos nuestros capitales fuera de México.</gams:textualContent><rel:isPartOf rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh" /></aaif:Entry><aaif:Phrase rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En1007Ph1"><aaif:verb rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh#En1007Ph1Ve1" /><aaif:adverb rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh#En1007Ph1Ad1" /><aaif:text>y algo más, para hablar claro :</aaif:text><aaif:annoText>y algo más, para [v|hablar|hablar|is] [a|claro|claro|auvnmnnn] :</aaif:annoText></aaif:Phrase><aaif:Verb rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En1007Ph1Ve1"><aaif:text>hablar</aaif:text><aaif:lemma rdf:resource="https://gams.uni-graz.at/o:aaif.lemma#hablar" /><aaif:position rdf:datatype="http://www.w3.org/2001/XMLSchema#int">1</aaif:position><aaif:coordinated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:coordinated><aaif:partOfText rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</aaif:partOfText><aaif:syntacticConstruction rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Intransitive" /></aaif:Verb><aaif:Adverb rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En1007Ph1Ad1"><aaif:text>claro</aaif:text><aaif:lemma rdf:resource="https://gams.uni-graz.at/o:aaif.lemma#claro" /><aaif:position rdf:datatype="http://www.w3.org/2001/XMLSchema#int">2</aaif:position><aaif:coordinated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:coordinated><aaif:morphosyntacticStructure rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Adjective" /><aaif:inflection rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Uninflected" /><aaif:attributionTarget rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Verb" /><aaif:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:modified><aaif:semanticClassification rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Manner" /><aaif:reduplicated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:reduplicated><aaif:prepositionalPhrase rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:prepositionalPhrase></aaif:Adverb><aaif:Entry rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En1008"><aaif:phrase rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh#En1008Ph1" /><aaif:source rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh.bibl#Cnde261" /><gams:textualContent>Usted y todos esos muertos que se quedaron en el cañón formaban un destacamento de exploración,  eso se veía claro .Eso quiere decir que el grueso de las tropas no andaban lejos.Hasta se olieron la ruta que</gams:textualContent><rel:isPartOf rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh" /></aaif:Entry><aaif:Phrase rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En1008Ph1"><aaif:subject rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh#En1008Ph1Su1" /><aaif:verb rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh#En1008Ph1Ve1" /><aaif:adverb rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh#En1008Ph1Ad1" /><aaif:text> eso se veía claro .</aaif:text><aaif:annoText> [s|eso|ms] se [v|veía|ver|rs] [a|claro|claro|auvnmnnn] .</aaif:annoText></aaif:Phrase><aaif:Subject rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En1008Ph1Su1"><aaif:text>eso</aaif:text><aaif:position rdf:datatype="http://www.w3.org/2001/XMLSchema#int">1</aaif:position><aaif:gender rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Masculine" /><aaif:number rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Singular" /><aaif:overt rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</aaif:overt></aaif:Subject><aaif:Verb rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En1008Ph1Ve1"><aaif:text>veía</aaif:text><aaif:lemma rdf:resource="https://gams.uni-graz.at/o:aaif.lemma#ver" /><aaif:position rdf:datatype="http://www.w3.org/2001/XMLSchema#int">2</aaif:position><aaif:coordinated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:coordinated><aaif:partOfText rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</aaif:partOfText><aaif:syntacticConstruction rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Reflexive" /></aaif:Verb><aaif:Adverb rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En1008Ph1Ad1"><aaif:text>claro</aaif:text><aaif:lemma rdf:resource="https://gams.uni-graz.at/o:aaif.lemma#claro" /><aaif:position rdf:datatype="http://www.w3.org/2001/XMLSchema#int">3</aaif:position><aaif:coordinated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:coordinated><aaif:morphosyntacticStructure rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Adjective" /><aaif:inflection rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Uninflected" /><aaif:attributionTarget rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Verb" /><aaif:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:modified><aaif:semanticClassification rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Manner" /><aaif:reduplicated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:reduplicated><aaif:prepositionalPhrase rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:prepositionalPhrase></aaif:Adverb><aaif:Entry rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En1009"><aaif:phrase rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh#En1009Ph1" /><aaif:source rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh.bibl#Cnde262" /><gams:textualContent>, preguntémonos si la empresa hay que acometerla desde arriba o desde abajo (pero qué bien, estoy pensando clarito , el vodka las clava como mariposas en el cartón, A es A, a rose is a rose</gams:textualContent><rel:isPartOf rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh" /></aaif:Entry><aaif:Phrase rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En1009Ph1"><aaif:verb rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh#En1009Ph1Ve1" /><aaif:adverb rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh#En1009Ph1Ad1" /><aaif:text>pero qué bien, estoy pensando clarito ,</aaif:text><aaif:annoText>pero qué bien, [v|estoy pensando|pensar|is] [a|clarito|claro|auvnmnnn] ,</aaif:annoText></aaif:Phrase><aaif:Verb rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En1009Ph1Ve1"><aaif:text>estoy pensando</aaif:text><aaif:lemma rdf:resource="https://gams.uni-graz.at/o:aaif.lemma#pensar" /><aaif:position rdf:datatype="http://www.w3.org/2001/XMLSchema#int">1</aaif:position><aaif:coordinated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:coordinated><aaif:partOfText rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</aaif:partOfText><aaif:syntacticConstruction rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Intransitive" /></aaif:Verb><aaif:Adverb rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En1009Ph1Ad1"><aaif:text>clarito</aaif:text><aaif:lemma rdf:resource="https://gams.uni-graz.at/o:aaif.lemma#claro" /><aaif:position rdf:datatype="http://www.w3.org/2001/XMLSchema#int">2</aaif:position><aaif:coordinated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:coordinated><aaif:morphosyntacticStructure rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Adjective" /><aaif:inflection rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Uninflected" /><aaif:attributionTarget rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Verb" /><aaif:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:modified><aaif:semanticClassification rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Manner" /><aaif:reduplicated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:reduplicated><aaif:prepositionalPhrase rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:prepositionalPhrase></aaif:Adverb><aaif:Entry rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En1010"><aaif:phrase rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh#En1010Ph1" /><aaif:source rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh.bibl#Cnde262" /><gams:textualContent>quizá, pero falso como absoluto.La claridad es una exigencia intelectual y nada más.Ojalá pudiéramos saber claro , entender claro al margen de la ciencia y la razón.Y cuando digo «ojalá»,</gams:textualContent><rel:isPartOf rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh" /></aaif:Entry><aaif:Phrase rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En1010Ph1"><aaif:verb rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh#En1010Ph1Ve1" /><aaif:verb rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh#En1010Ph1Ve2" /><aaif:adverb rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh#En1010Ph1Ad1" /><aaif:adverb rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh#En1010Ph1Ad2" /><aaif:text>Ojalá pudiéramos saber claro , entender claro al margen de la ciencia y la razón.</aaif:text><aaif:annoText>Ojalá pudiéramos [v|saber|saber|is] [a|claro|claro|auvnmnnn] , [v|entender|entender|is] [a|claro|claro|auvnmnnn] al margen de la ciencia y la razón.</aaif:annoText></aaif:Phrase><aaif:Verb rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En1010Ph1Ve1"><aaif:text>saber</aaif:text><aaif:lemma rdf:resource="https://gams.uni-graz.at/o:aaif.lemma#saber" /><aaif:position rdf:datatype="http://www.w3.org/2001/XMLSchema#int">1</aaif:position><aaif:coordinated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:coordinated><aaif:partOfText rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</aaif:partOfText><aaif:syntacticConstruction rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Intransitive" /></aaif:Verb><aaif:Verb rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En1010Ph1Ve2"><aaif:text>entender</aaif:text><aaif:lemma rdf:resource="https://gams.uni-graz.at/o:aaif.lemma#entender" /><aaif:position rdf:datatype="http://www.w3.org/2001/XMLSchema#int">3</aaif:position><aaif:coordinated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:coordinated><aaif:partOfText rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</aaif:partOfText><aaif:syntacticConstruction rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Intransitive" /></aaif:Verb><aaif:Adverb rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En1010Ph1Ad1"><aaif:text>claro</aaif:text><aaif:lemma rdf:resource="https://gams.uni-graz.at/o:aaif.lemma#claro" /><aaif:position rdf:datatype="http://www.w3.org/2001/XMLSchema#int">2</aaif:position><aaif:coordinated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:coordinated><aaif:morphosyntacticStructure rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Adjective" /><aaif:inflection rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Uninflected" /><aaif:attributionTarget rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Verb" /><aaif:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:modified><aaif:semanticClassification rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Manner" /><aaif:reduplicated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:reduplicated><aaif:prepositionalPhrase rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:prepositionalPhrase></aaif:Adverb><aaif:Adverb rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En1010Ph1Ad2"><aaif:text>claro</aaif:text><aaif:lemma rdf:resource="https://gams.uni-graz.at/o:aaif.lemma#claro" /><aaif:position rdf:datatype="http://www.w3.org/2001/XMLSchema#int">4</aaif:position><aaif:coordinated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:coordinated><aaif:morphosyntacticStructure rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Adjective" /><aaif:inflection rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Uninflected" /><aaif:attributionTarget rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Verb" /><aaif:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:modified><aaif:semanticClassification rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Manner" /><aaif:reduplicated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:reduplicated><aaif:prepositionalPhrase rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:prepositionalPhrase></aaif:Adverb><aaif:Entry rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En1011"><aaif:phrase rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh#En1011Ph1" /><aaif:source rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh.bibl#Cnde263" /><gams:textualContent> La voz de Arsenio Cué en la realidad de la cinta o de la parodia grita , clarito , Mierda eso no es Guillén ni un carajo y se oye la voz de Silvestre, la voz de</gams:textualContent><rel:isPartOf rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh" /></aaif:Entry><aaif:Phrase rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En1011Ph1"><aaif:subject rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh#En1011Ph1Su1" /><aaif:verb rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh#En1011Ph1Ve1" /><aaif:adverb rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh#En1011Ph1Ad1" /><aaif:text> La voz de Arsenio Cué en la realidad de la cinta o de la parodia grita , clarito , Mierda eso no es Guillén ni un carajo</aaif:text><aaif:annoText> [s|La voz de Arsenio Cué|fs] en la realidad de la cinta o de la parodia [v|grita|gritar|ts] , [a|clarito|claro|auvnmnnn] , Mierda eso no es Guillén ni un carajo</aaif:annoText></aaif:Phrase><aaif:Subject rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En1011Ph1Su1"><aaif:text>La voz de Arsenio Cué</aaif:text><aaif:position rdf:datatype="http://www.w3.org/2001/XMLSchema#int">1</aaif:position><aaif:gender rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Feminine" /><aaif:number rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Singular" /><aaif:overt rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</aaif:overt></aaif:Subject><aaif:Verb rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En1011Ph1Ve1"><aaif:text>grita</aaif:text><aaif:lemma rdf:resource="https://gams.uni-graz.at/o:aaif.lemma#gritar" /><aaif:position rdf:datatype="http://www.w3.org/2001/XMLSchema#int">2</aaif:position><aaif:coordinated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:coordinated><aaif:partOfText rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</aaif:partOfText><aaif:syntacticConstruction rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Transitive" /></aaif:Verb><aaif:Adverb rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En1011Ph1Ad1"><aaif:text>clarito</aaif:text><aaif:lemma rdf:resource="https://gams.uni-graz.at/o:aaif.lemma#claro" /><aaif:position rdf:datatype="http://www.w3.org/2001/XMLSchema#int">3</aaif:position><aaif:coordinated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:coordinated><aaif:morphosyntacticStructure rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Adjective" /><aaif:inflection rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Uninflected" /><aaif:attributionTarget rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Verb" /><aaif:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:modified><aaif:semanticClassification rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Manner" /><aaif:reduplicated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:reduplicated><aaif:prepositionalPhrase rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:prepositionalPhrase></aaif:Adverb><aaif:Entry rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En1012"><aaif:phrase rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh#En1012Ph1" /><aaif:source rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh.bibl#Cnde263" /><gams:textualContent>en el estrecho canal del puerto, casi navegaba contra el tránsito, por la calle, y vi claro su nombre, Phaon, y del mar del tiempo llegaba la voz educada para el aire de</gams:textualContent><rel:isPartOf rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh" /></aaif:Entry><aaif:Phrase rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En1012Ph1"><aaif:verb rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh#En1012Ph1Ve1" /><aaif:adverb rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh#En1012Ph1Ad1" /><aaif:text>y vi claro su nombre, Phaon,</aaif:text><aaif:annoText>y [v|vi|ver|ts] [a|claro|claro|auvnmnnn] su nombre, Phaon,</aaif:annoText></aaif:Phrase><aaif:Verb rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En1012Ph1Ve1"><aaif:text>vi</aaif:text><aaif:lemma rdf:resource="https://gams.uni-graz.at/o:aaif.lemma#ver" /><aaif:position rdf:datatype="http://www.w3.org/2001/XMLSchema#int">1</aaif:position><aaif:coordinated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:coordinated><aaif:partOfText rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</aaif:partOfText><aaif:syntacticConstruction rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Transitive" /></aaif:Verb><aaif:Adverb rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En1012Ph1Ad1"><aaif:text>claro</aaif:text><aaif:lemma rdf:resource="https://gams.uni-graz.at/o:aaif.lemma#claro" /><aaif:position rdf:datatype="http://www.w3.org/2001/XMLSchema#int">2</aaif:position><aaif:coordinated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:coordinated><aaif:morphosyntacticStructure rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Adjective" /><aaif:inflection rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Uninflected" /><aaif:attributionTarget rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Verb" /><aaif:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:modified><aaif:semanticClassification rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Manner" /><aaif:reduplicated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:reduplicated><aaif:prepositionalPhrase rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:prepositionalPhrase></aaif:Adverb><aaif:Entry rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En1013"><aaif:phrase rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh#En1013Ph1" /><aaif:source rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh.bibl#Cnde263" /><gams:textualContent>—  Habla  claro .</gams:textualContent><rel:isPartOf rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh" /></aaif:Entry><aaif:Phrase rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En1013Ph1"><aaif:verb rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh#En1013Ph1Ve1" /><aaif:adverb rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh#En1013Ph1Ad1" /><aaif:text> Habla  claro .</aaif:text><aaif:annoText> [v|Habla|hablar|is]  [a|claro|claro|auvnmnnn] .</aaif:annoText></aaif:Phrase><aaif:Verb rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En1013Ph1Ve1"><aaif:text>Habla</aaif:text><aaif:lemma rdf:resource="https://gams.uni-graz.at/o:aaif.lemma#hablar" /><aaif:position rdf:datatype="http://www.w3.org/2001/XMLSchema#int">1</aaif:position><aaif:coordinated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:coordinated><aaif:partOfText rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</aaif:partOfText><aaif:syntacticConstruction rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Intransitive" /></aaif:Verb><aaif:Adverb rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En1013Ph1Ad1"><aaif:text>claro</aaif:text><aaif:lemma rdf:resource="https://gams.uni-graz.at/o:aaif.lemma#claro" /><aaif:position rdf:datatype="http://www.w3.org/2001/XMLSchema#int">2</aaif:position><aaif:coordinated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:coordinated><aaif:morphosyntacticStructure rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Adjective" /><aaif:inflection rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Uninflected" /><aaif:attributionTarget rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Verb" /><aaif:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:modified><aaif:semanticClassification rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Manner" /><aaif:reduplicated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:reduplicated><aaif:prepositionalPhrase rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:prepositionalPhrase></aaif:Adverb><aaif:Entry rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En1014"><aaif:phrase rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh#En1014Ph1" /><aaif:source rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh.bibl#Cnde53" /><gams:textualContent>de pura seducción personal, a la cual el Cardenal era particularmente sensible.Pero todo esto no se vio claro hasta más adelante</gams:textualContent><rel:isPartOf rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh" /></aaif:Entry><aaif:Phrase rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En1014Ph1"><aaif:subject rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh#En1014Ph1Su1" /><aaif:verb rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh#En1014Ph1Ve1" /><aaif:adverb rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh#En1014Ph1Ad1" /><aaif:text>Pero todo esto no se vio claro hasta más adelante</aaif:text><aaif:annoText>Pero [s|todo esto|ms] no se [v|vio|ver|rs] [a|claro|claro|auvnmnnn] hasta más adelante</aaif:annoText></aaif:Phrase><aaif:Subject rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En1014Ph1Su1"><aaif:text>todo esto</aaif:text><aaif:position rdf:datatype="http://www.w3.org/2001/XMLSchema#int">1</aaif:position><aaif:gender rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Masculine" /><aaif:number rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Singular" /><aaif:overt rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</aaif:overt></aaif:Subject><aaif:Verb rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En1014Ph1Ve1"><aaif:text>vio</aaif:text><aaif:lemma rdf:resource="https://gams.uni-graz.at/o:aaif.lemma#ver" /><aaif:position rdf:datatype="http://www.w3.org/2001/XMLSchema#int">2</aaif:position><aaif:coordinated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:coordinated><aaif:partOfText rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</aaif:partOfText><aaif:syntacticConstruction rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Reflexive" /></aaif:Verb><aaif:Adverb rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En1014Ph1Ad1"><aaif:text>claro</aaif:text><aaif:lemma rdf:resource="https://gams.uni-graz.at/o:aaif.lemma#claro" /><aaif:position rdf:datatype="http://www.w3.org/2001/XMLSchema#int">3</aaif:position><aaif:coordinated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:coordinated><aaif:morphosyntacticStructure rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Adjective" /><aaif:inflection rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Uninflected" /><aaif:attributionTarget rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Verb" /><aaif:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:modified><aaif:semanticClassification rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Manner" /><aaif:reduplicated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:reduplicated><aaif:prepositionalPhrase rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:prepositionalPhrase></aaif:Adverb><aaif:Entry rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En1015"><aaif:phrase rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh#En1015Ph1" /><aaif:source rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh.bibl#Cnde53" /><gams:textualContent>Pero ahora insistía él: &lt;lb/&gt; - Nunca hablo de política porque sí, Tere.Sólo te diré una cosa: las repercusiones de la crisis general del capitalismo es algo que no siempre sabemos captar nosotros, los señoritos, por una fatal cuestión de perspectiva, pero dentro de cinco años se verá clarísimo .Las cosas no han hecho más que empezar.&lt;lb/&gt; - ¿Crisis?-dijo ella son asombro-.¡Estás tú bien, hijo!No hay tal crisis.La falta de iniciativa y el inmovilismo de la oposición burguesa, suponiendo que haya tal oposición, porque yo sólo conozco cuatro gatos, y tú eres uno de ellos...</gams:textualContent><rel:isPartOf rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh" /></aaif:Entry><aaif:Phrase rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En1015Ph1"><aaif:verb rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh#En1015Ph1Ve1" /><aaif:adverb rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh#En1015Ph1Ad1" /><aaif:text>las repercusiones de la crisis general del capitalismo es algo que no siempre sabemos captar nosotros, los señoritos, por una fatal cuestión de perspectiva, pero dentro de cinco años se verá clarísimo .</aaif:text><aaif:annoText>las repercusiones de la crisis general del capitalismo es algo que no siempre sabemos captar nosotros, los señoritos, por una fatal cuestión de perspectiva, pero dentro de cinco años se [v|verá|ver|rs] [a|clarísimo|claro|auvnmnnn] .</aaif:annoText></aaif:Phrase><aaif:Verb rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En1015Ph1Ve1"><aaif:text>verá</aaif:text><aaif:lemma rdf:resource="https://gams.uni-graz.at/o:aaif.lemma#ver" /><aaif:position rdf:datatype="http://www.w3.org/2001/XMLSchema#int">1</aaif:position><aaif:coordinated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:coordinated><aaif:partOfText rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</aaif:partOfText><aaif:syntacticConstruction rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Reflexive" /></aaif:Verb><aaif:Adverb rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En1015Ph1Ad1"><aaif:text>clarísimo</aaif:text><aaif:lemma rdf:resource="https://gams.uni-graz.at/o:aaif.lemma#claro" /><aaif:position rdf:datatype="http://www.w3.org/2001/XMLSchema#int">2</aaif:position><aaif:coordinated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:coordinated><aaif:morphosyntacticStructure rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Adjective" /><aaif:inflection rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Uninflected" /><aaif:attributionTarget rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Verb" /><aaif:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:modified><aaif:semanticClassification rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Manner" /><aaif:reduplicated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:reduplicated><aaif:prepositionalPhrase rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:prepositionalPhrase></aaif:Adverb><aaif:Entry rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En1016"><aaif:phrase rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh#En1016Ph1" /><aaif:source rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh.bibl#Cnde53" /><gams:textualContent>revista, porque fijó toda su atención en una página, mientras decía—: Pero seamos prácticos y hablemos claro , que para eso somos amigos.Vamos a ver, ¿qué hay entre nosotros?Amistad y nada</gams:textualContent><rel:isPartOf rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh" /></aaif:Entry><aaif:Phrase rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En1016Ph1"><aaif:verb rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh#En1016Ph1Ve1" /><aaif:adverb rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh#En1016Ph1Ad1" /><aaif:text>Pero seamos prácticos y hablemos claro ,</aaif:text><aaif:annoText>Pero seamos prácticos y [v|hablemos|hablar|is] [a|claro|claro|auvnmnnn] ,</aaif:annoText></aaif:Phrase><aaif:Verb rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En1016Ph1Ve1"><aaif:text>hablemos</aaif:text><aaif:lemma rdf:resource="https://gams.uni-graz.at/o:aaif.lemma#hablar" /><aaif:position rdf:datatype="http://www.w3.org/2001/XMLSchema#int">1</aaif:position><aaif:coordinated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:coordinated><aaif:partOfText rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</aaif:partOfText><aaif:syntacticConstruction rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Intransitive" /></aaif:Verb><aaif:Adverb rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En1016Ph1Ad1"><aaif:text>claro</aaif:text><aaif:lemma rdf:resource="https://gams.uni-graz.at/o:aaif.lemma#claro" /><aaif:position rdf:datatype="http://www.w3.org/2001/XMLSchema#int">2</aaif:position><aaif:coordinated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:coordinated><aaif:morphosyntacticStructure rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Adjective" /><aaif:inflection rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Uninflected" /><aaif:attributionTarget rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Verb" /><aaif:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:modified><aaif:semanticClassification rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Manner" /><aaif:reduplicated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:reduplicated><aaif:prepositionalPhrase rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:prepositionalPhrase></aaif:Adverb><aaif:Entry rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En1017"><aaif:phrase rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh#En1017Ph1" /><aaif:source rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh.bibl#Cnde177" /><gams:textualContent>llegaba, siempre con tus crucigramas, calamidad, que la pones a una la cabeza loca, en vez de hablar claro .Lo mismo que con los héroes de los dos lados, o que sin un acto de expiación colectivo</gams:textualContent><rel:isPartOf rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh" /></aaif:Entry><aaif:Phrase rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En1017Ph1"><aaif:verb rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh#En1017Ph1Ve1" /><aaif:adverb rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh#En1017Ph1Ad1" /><aaif:text>en vez de hablar claro </aaif:text><aaif:annoText>en vez de [v|hablar|hablar|is] [a|claro|claro|auvnmnnn] </aaif:annoText></aaif:Phrase><aaif:Verb rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En1017Ph1Ve1"><aaif:text>hablar</aaif:text><aaif:lemma rdf:resource="https://gams.uni-graz.at/o:aaif.lemma#hablar" /><aaif:position rdf:datatype="http://www.w3.org/2001/XMLSchema#int">1</aaif:position><aaif:coordinated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:coordinated><aaif:partOfText rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</aaif:partOfText><aaif:syntacticConstruction rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Intransitive" /></aaif:Verb><aaif:Adverb rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En1017Ph1Ad1"><aaif:text>claro</aaif:text><aaif:lemma rdf:resource="https://gams.uni-graz.at/o:aaif.lemma#claro" /><aaif:position rdf:datatype="http://www.w3.org/2001/XMLSchema#int">2</aaif:position><aaif:coordinated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:coordinated><aaif:morphosyntacticStructure rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Adjective" /><aaif:inflection rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Uninflected" /><aaif:attributionTarget rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Verb" /><aaif:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:modified><aaif:semanticClassification rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Manner" /><aaif:reduplicated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:reduplicated><aaif:prepositionalPhrase rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:prepositionalPhrase></aaif:Adverb><aaif:Entry rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En1018"><aaif:phrase rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh#En1018Ph1" /><aaif:source rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh.bibl#Cnde177" /><gams:textualContent>paletos viven en condiciones infrahumanas, pero, ¿puede saberse qué es lo que pretendéis?¡Si hablarais claro de una vez!Porque si a los paletos les ponen ascensor y calefacción, dejarían de ser paletos, ¿no</gams:textualContent><rel:isPartOf rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh" /></aaif:Entry><aaif:Phrase rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En1018Ph1"><aaif:verb rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh#En1018Ph1Ve1" /><aaif:adverb rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh#En1018Ph1Ad1" /><aaif:text>¡Si hablarais claro de una vez!</aaif:text><aaif:annoText>¡Si [v|hablarais|hablar|is] [a|claro|claro|auvnmnnn] de una vez!</aaif:annoText></aaif:Phrase><aaif:Verb rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En1018Ph1Ve1"><aaif:text>hablarais</aaif:text><aaif:lemma rdf:resource="https://gams.uni-graz.at/o:aaif.lemma#hablar" /><aaif:position rdf:datatype="http://www.w3.org/2001/XMLSchema#int">1</aaif:position><aaif:coordinated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:coordinated><aaif:partOfText rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</aaif:partOfText><aaif:syntacticConstruction rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Intransitive" /></aaif:Verb><aaif:Adverb rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En1018Ph1Ad1"><aaif:text>claro</aaif:text><aaif:lemma rdf:resource="https://gams.uni-graz.at/o:aaif.lemma#claro" /><aaif:position rdf:datatype="http://www.w3.org/2001/XMLSchema#int">2</aaif:position><aaif:coordinated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:coordinated><aaif:morphosyntacticStructure rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Adjective" /><aaif:inflection rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Uninflected" /><aaif:attributionTarget rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Verb" /><aaif:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:modified><aaif:semanticClassification rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Manner" /><aaif:reduplicated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:reduplicated><aaif:prepositionalPhrase rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:prepositionalPhrase></aaif:Adverb><aaif:Entry rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En1019"><aaif:phrase rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh#En1019Ph1" /><aaif:source rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh.bibl#Cnde177" /><gams:textualContent>te estaba saliendo todo lo que no salió a su tiempo, ése es otro cantar, pero que hable claro , sin tanto rodeo, al pan, pan y al vino, vino, que los médicos</gams:textualContent><rel:isPartOf rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh" /></aaif:Entry><aaif:Phrase rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En1019Ph1"><aaif:verb rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh#En1019Ph1Ve1" /><aaif:adverb rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh#En1019Ph1Ad1" /><aaif:text>pero que hable claro , sin tanto rodeo</aaif:text><aaif:annoText>pero que [v|hable|hablar|is] [a|claro|claro|auvnmnnn] , sin tanto rodeo</aaif:annoText></aaif:Phrase><aaif:Verb rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En1019Ph1Ve1"><aaif:text>hable</aaif:text><aaif:lemma rdf:resource="https://gams.uni-graz.at/o:aaif.lemma#hablar" /><aaif:position rdf:datatype="http://www.w3.org/2001/XMLSchema#int">1</aaif:position><aaif:coordinated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:coordinated><aaif:partOfText rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</aaif:partOfText><aaif:syntacticConstruction rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Intransitive" /></aaif:Verb><aaif:Adverb rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En1019Ph1Ad1"><aaif:text>claro</aaif:text><aaif:lemma rdf:resource="https://gams.uni-graz.at/o:aaif.lemma#claro" /><aaif:position rdf:datatype="http://www.w3.org/2001/XMLSchema#int">2</aaif:position><aaif:coordinated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:coordinated><aaif:morphosyntacticStructure rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Adjective" /><aaif:inflection rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Uninflected" /><aaif:attributionTarget rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Verb" /><aaif:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:modified><aaif:semanticClassification rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Manner" /><aaif:reduplicated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:reduplicated><aaif:prepositionalPhrase rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:prepositionalPhrase></aaif:Adverb><aaif:Entry rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En1020"><aaif:phrase rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh#En1020Ph1" /><aaif:source rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh.bibl#Cnde413" /><gams:textualContent>- No, si no estoy enojada ¿Por qué voy a estar? Pero que vengan a pedirme un favor no más. Van a ver. No, claro, si yo encuentro que tienen toda la razón de no habernos convidado... Pero van a ver si quieren que yo los ayude con un empeño para la Caja Habitacional o con una tarjeta para el hospital..., esperen no más, entonces sí que se las voy a cantar claro . &lt;lb/&gt; A cantar claro y después, naturalmente, a adueñarse de los destinos de Fausto y la Mirella y la Maruxa Jacqueline -seguro que hasta conseguía que le cambiaran el nombre: Angélica era el nombre que ella propiciaba. Toca la bocina. Si Fausto abre la puerta, pretendo que no ha pasado nada. Al fin y al cabo él me hizo un favor personal no invitándome al matrimonio ni al bautizo porque yo no hubiera ido, y así me ahorré un desaire a la Violeta.</gams:textualContent><rel:isPartOf rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh" /></aaif:Entry><aaif:Phrase rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En1020Ph1"><aaif:verb rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh#En1020Ph1Ve1" /><aaif:adverb rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh#En1020Ph1Ad1" /><aaif:text>entonces sí que se las voy a cantar claro .</aaif:text><aaif:annoText>entonces sí que se las voy a [v|cantar|cantar|ts] [a|claro|claro|auvnmnnn] .</aaif:annoText></aaif:Phrase><aaif:Verb rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En1020Ph1Ve1"><aaif:text>cantar</aaif:text><aaif:lemma rdf:resource="https://gams.uni-graz.at/o:aaif.lemma#cantar" /><aaif:position rdf:datatype="http://www.w3.org/2001/XMLSchema#int">1</aaif:position><aaif:coordinated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:coordinated><aaif:partOfText rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</aaif:partOfText><aaif:syntacticConstruction rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Transitive" /></aaif:Verb><aaif:Adverb rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En1020Ph1Ad1"><aaif:text>claro</aaif:text><aaif:lemma rdf:resource="https://gams.uni-graz.at/o:aaif.lemma#claro" /><aaif:position rdf:datatype="http://www.w3.org/2001/XMLSchema#int">2</aaif:position><aaif:coordinated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:coordinated><aaif:morphosyntacticStructure rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Adjective" /><aaif:inflection rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Uninflected" /><aaif:attributionTarget rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Verb" /><aaif:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:modified><aaif:semanticClassification rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Manner" /><aaif:reduplicated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:reduplicated><aaif:prepositionalPhrase rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:prepositionalPhrase></aaif:Adverb><aaif:Entry rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En1021"><aaif:phrase rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh#En1021Ph1" /><aaif:source rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh.bibl#Cnde413" /><gams:textualContent>a tocar, los alientos fétidos, las manos pegajosas de mugre. La Chepa da trastabillones, no ve claro , no veo nada ahora, estoy con los pies en una poza de barro, más allá salgo,</gams:textualContent><rel:isPartOf rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh" /></aaif:Entry><aaif:Phrase rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En1021Ph1"><aaif:subject rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh#En1021Ph1Su1" /><aaif:verb rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh#En1021Ph1Ve1" /><aaif:adverb rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh#En1021Ph1Ad1" /><aaif:text> La Chepa da trastabillones, no ve claro , no veo nada ahora</aaif:text><aaif:annoText> [s|La Chepa|fs] da trastabillones, no [v|ve|ver|is] [a|claro|claro|auvnmnnn] , no veo nada ahora</aaif:annoText></aaif:Phrase><aaif:Subject rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En1021Ph1Su1"><aaif:text>La Chepa</aaif:text><aaif:position rdf:datatype="http://www.w3.org/2001/XMLSchema#int">1</aaif:position><aaif:gender rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Feminine" /><aaif:number rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Singular" /><aaif:overt rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</aaif:overt></aaif:Subject><aaif:Verb rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En1021Ph1Ve1"><aaif:text>ve</aaif:text><aaif:lemma rdf:resource="https://gams.uni-graz.at/o:aaif.lemma#ver" /><aaif:position rdf:datatype="http://www.w3.org/2001/XMLSchema#int">2</aaif:position><aaif:coordinated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:coordinated><aaif:partOfText rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</aaif:partOfText><aaif:syntacticConstruction rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Intransitive" /></aaif:Verb><aaif:Adverb rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En1021Ph1Ad1"><aaif:text>claro</aaif:text><aaif:lemma rdf:resource="https://gams.uni-graz.at/o:aaif.lemma#claro" /><aaif:position rdf:datatype="http://www.w3.org/2001/XMLSchema#int">3</aaif:position><aaif:coordinated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:coordinated><aaif:morphosyntacticStructure rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Adjective" /><aaif:inflection rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Uninflected" /><aaif:attributionTarget rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Verb" /><aaif:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:modified><aaif:semanticClassification rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Manner" /><aaif:reduplicated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:reduplicated><aaif:prepositionalPhrase rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:prepositionalPhrase></aaif:Adverb><aaif:Entry rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En1022"><aaif:phrase rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh#En1022Ph1" /><aaif:source rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh.bibl#Cnde414" /><gams:textualContent>alimentar su fiebre».Todo el curso de la guerra civil en la comarca de Región empieza a verse claro  cuando se comprende que, en más de un aspecto, es un paradigma a escala menor y a un</gams:textualContent><rel:isPartOf rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh" /></aaif:Entry><aaif:Phrase rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En1022Ph1"><aaif:verb rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh#En1022Ph1Ve1" /><aaif:adverb rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh#En1022Ph1Ad1" /><aaif:text>Todo el curso de la guerra civil en la comarca de Región empieza a verse claro </aaif:text><aaif:annoText>Todo el curso de la guerra civil en la comarca de Región empieza a [v|verse|ver|rs] [a|claro|claro|auvnmnnn] </aaif:annoText></aaif:Phrase><aaif:Verb rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En1022Ph1Ve1"><aaif:text>verse</aaif:text><aaif:lemma rdf:resource="https://gams.uni-graz.at/o:aaif.lemma#ver" /><aaif:position rdf:datatype="http://www.w3.org/2001/XMLSchema#int">1</aaif:position><aaif:coordinated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:coordinated><aaif:partOfText rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</aaif:partOfText><aaif:syntacticConstruction rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Reflexive" /></aaif:Verb><aaif:Adverb rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En1022Ph1Ad1"><aaif:text>claro</aaif:text><aaif:lemma rdf:resource="https://gams.uni-graz.at/o:aaif.lemma#claro" /><aaif:position rdf:datatype="http://www.w3.org/2001/XMLSchema#int">2</aaif:position><aaif:coordinated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:coordinated><aaif:morphosyntacticStructure rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Adjective" /><aaif:inflection rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Uninflected" /><aaif:attributionTarget rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Verb" /><aaif:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:modified><aaif:semanticClassification rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Manner" /><aaif:reduplicated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:reduplicated><aaif:prepositionalPhrase rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:prepositionalPhrase></aaif:Adverb><aaif:Entry rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En1023"><aaif:phrase rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh#En1023Ph1" /><aaif:source rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh.bibl#Cnde414" /><gams:textualContent>consiste en determinar la fatalidad sino solamente de ocultarla...Cuando ya no hay remedio, cuántas cosas se ven claras : cuando al cabo de los años se pregunta uno por el fundamento de aquella moral que abortó tantas cosas —que</gams:textualContent><rel:isPartOf rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh" /></aaif:Entry><aaif:Phrase rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En1023Ph1"><aaif:verb rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh#En1023Ph1Ve1" /><aaif:adverb rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh#En1023Ph1Ad1" /><aaif:text>cuántas cosas se ven claras </aaif:text><aaif:annoText>cuántas cosas se [v|ven|ver|rs] [a|claras|claro|axonmnnn] </aaif:annoText></aaif:Phrase><aaif:Verb rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En1023Ph1Ve1"><aaif:text>ven</aaif:text><aaif:lemma rdf:resource="https://gams.uni-graz.at/o:aaif.lemma#ver" /><aaif:position rdf:datatype="http://www.w3.org/2001/XMLSchema#int">1</aaif:position><aaif:coordinated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:coordinated><aaif:partOfText rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</aaif:partOfText><aaif:syntacticConstruction rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Reflexive" /></aaif:Verb><aaif:Adverb rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En1023Ph1Ad1"><aaif:text>claras</aaif:text><aaif:lemma rdf:resource="https://gams.uni-graz.at/o:aaif.lemma#claro" /><aaif:position rdf:datatype="http://www.w3.org/2001/XMLSchema#int">2</aaif:position><aaif:coordinated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:coordinated><aaif:morphosyntacticStructure rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Adjective" /><aaif:inflection rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#FemininePlural" /><aaif:attributionTarget rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#VerbObject" /><aaif:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:modified><aaif:semanticClassification rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Manner" /><aaif:reduplicated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:reduplicated><aaif:prepositionalPhrase rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:prepositionalPhrase></aaif:Adverb><aaif:Entry rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En1024"><aaif:phrase rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh#En1024Ph1" /><aaif:source rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh.bibl#Cnde119" /><gams:textualContent>era imprescindible eso—.Cuando usted habla de la política del Ejército, hay algo que no veo claro .Usted me perdonará.</gams:textualContent><rel:isPartOf rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh" /></aaif:Entry><aaif:Phrase rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En1024Ph1"><aaif:verb rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh#En1024Ph1Ve1" /><aaif:adverb rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh#En1024Ph1Ad1" /><aaif:text>hay algo que no veo claro </aaif:text><aaif:annoText>hay algo que no [v|veo|ver|ts] [a|claro|claro|auvnmnnn] </aaif:annoText></aaif:Phrase><aaif:Verb rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En1024Ph1Ve1"><aaif:text>veo</aaif:text><aaif:lemma rdf:resource="https://gams.uni-graz.at/o:aaif.lemma#ver" /><aaif:position rdf:datatype="http://www.w3.org/2001/XMLSchema#int">1</aaif:position><aaif:coordinated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:coordinated><aaif:partOfText rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</aaif:partOfText><aaif:syntacticConstruction rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Transitive" /></aaif:Verb><aaif:Adverb rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En1024Ph1Ad1"><aaif:text>claro</aaif:text><aaif:lemma rdf:resource="https://gams.uni-graz.at/o:aaif.lemma#claro" /><aaif:position rdf:datatype="http://www.w3.org/2001/XMLSchema#int">2</aaif:position><aaif:coordinated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:coordinated><aaif:morphosyntacticStructure rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Adjective" /><aaif:inflection rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Uninflected" /><aaif:attributionTarget rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Verb" /><aaif:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:modified><aaif:semanticClassification rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Manner" /><aaif:reduplicated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:reduplicated><aaif:prepositionalPhrase rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:prepositionalPhrase></aaif:Adverb><aaif:Entry rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En1025"><aaif:phrase rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh#En1025Ph1" /><aaif:source rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh.bibl#Cnde119" /><gams:textualContent>— Los de Boca —alza la voz—.¿O no hablo claro ?</gams:textualContent><rel:isPartOf rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh" /></aaif:Entry><aaif:Phrase rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En1025Ph1"><aaif:verb rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh#En1025Ph1Ve1" /><aaif:adverb rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh#En1025Ph1Ad1" /><aaif:text>¿O no hablo claro ?</aaif:text><aaif:annoText>¿O no [v|hablo|hablar|is] [a|claro|claro|auvnmnnn] ?</aaif:annoText></aaif:Phrase><aaif:Verb rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En1025Ph1Ve1"><aaif:text>hablo</aaif:text><aaif:lemma rdf:resource="https://gams.uni-graz.at/o:aaif.lemma#hablar" /><aaif:position rdf:datatype="http://www.w3.org/2001/XMLSchema#int">1</aaif:position><aaif:coordinated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:coordinated><aaif:partOfText rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</aaif:partOfText><aaif:syntacticConstruction rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Intransitive" /></aaif:Verb><aaif:Adverb rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En1025Ph1Ad1"><aaif:text>claro</aaif:text><aaif:lemma rdf:resource="https://gams.uni-graz.at/o:aaif.lemma#claro" /><aaif:position rdf:datatype="http://www.w3.org/2001/XMLSchema#int">2</aaif:position><aaif:coordinated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:coordinated><aaif:morphosyntacticStructure rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Adjective" /><aaif:inflection rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Uninflected" /><aaif:attributionTarget rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Verb" /><aaif:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:modified><aaif:semanticClassification rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Manner" /><aaif:reduplicated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:reduplicated><aaif:prepositionalPhrase rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:prepositionalPhrase></aaif:Adverb><aaif:Entry rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En1026"><aaif:phrase rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh#En1026Ph1" /><aaif:source rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh.bibl#Cnde55" /><gams:textualContent>sol y fue a la bodega de la esquina.No se había olvidado del número, lo recordaba clarito .Pero contestó una voz de chiquilla que no conocía: no, ahí no vivía ninguna señorita Queta.</gams:textualContent><rel:isPartOf rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh" /></aaif:Entry><aaif:Phrase rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En1026Ph1"><aaif:verb rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh#En1026Ph1Ve1" /><aaif:adverb rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh#En1026Ph1Ad1" /><aaif:text>No se había olvidado del número, lo recordaba clarito .</aaif:text><aaif:annoText>No se había olvidado del número, lo [v|recordaba|recordar|ts] [a|clarito|claro|auvnmnnn] .</aaif:annoText></aaif:Phrase><aaif:Verb rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En1026Ph1Ve1"><aaif:text>recordaba</aaif:text><aaif:lemma rdf:resource="https://gams.uni-graz.at/o:aaif.lemma#recordar" /><aaif:position rdf:datatype="http://www.w3.org/2001/XMLSchema#int">1</aaif:position><aaif:coordinated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:coordinated><aaif:partOfText rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</aaif:partOfText><aaif:syntacticConstruction rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Transitive" /></aaif:Verb><aaif:Adverb rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En1026Ph1Ad1"><aaif:text>clarito</aaif:text><aaif:lemma rdf:resource="https://gams.uni-graz.at/o:aaif.lemma#claro" /><aaif:position rdf:datatype="http://www.w3.org/2001/XMLSchema#int">2</aaif:position><aaif:coordinated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:coordinated><aaif:morphosyntacticStructure rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Adjective" /><aaif:inflection rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Uninflected" /><aaif:attributionTarget rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Verb" /><aaif:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:modified><aaif:semanticClassification rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Manner" /><aaif:reduplicated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:reduplicated><aaif:prepositionalPhrase rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:prepositionalPhrase></aaif:Adverb><aaif:Entry rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En1027"><aaif:phrase rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh#En1027Ph1" /><aaif:source rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh.bibl#Cnde55" /><gams:textualContent>Y por qué no se va a poder?—dijo Trifulcio—.¿ El Molina ése no lo explicó clarito ?</gams:textualContent><rel:isPartOf rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh" /></aaif:Entry><aaif:Phrase rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En1027Ph1"><aaif:subject rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh#En1027Ph1Su1" /><aaif:verb rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh#En1027Ph1Ve1" /><aaif:adverb rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh#En1027Ph1Ad1" /><aaif:text>¿ El Molina ése no lo explicó clarito ?</aaif:text><aaif:annoText>¿ [s|El Molina ése|ms] no lo [v|explicó|explicar|ts] [a|clarito|claro|auvnmnnn] ?</aaif:annoText></aaif:Phrase><aaif:Subject rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En1027Ph1Su1"><aaif:text>El Molina ése</aaif:text><aaif:position rdf:datatype="http://www.w3.org/2001/XMLSchema#int">1</aaif:position><aaif:gender rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Masculine" /><aaif:number rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Singular" /><aaif:overt rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</aaif:overt></aaif:Subject><aaif:Verb rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En1027Ph1Ve1"><aaif:text>explicó</aaif:text><aaif:lemma rdf:resource="https://gams.uni-graz.at/o:aaif.lemma#explicar" /><aaif:position rdf:datatype="http://www.w3.org/2001/XMLSchema#int">2</aaif:position><aaif:coordinated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:coordinated><aaif:partOfText rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</aaif:partOfText><aaif:syntacticConstruction rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Transitive" /></aaif:Verb><aaif:Adverb rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En1027Ph1Ad1"><aaif:text>clarito</aaif:text><aaif:lemma rdf:resource="https://gams.uni-graz.at/o:aaif.lemma#claro" /><aaif:position rdf:datatype="http://www.w3.org/2001/XMLSchema#int">3</aaif:position><aaif:coordinated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:coordinated><aaif:morphosyntacticStructure rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Adjective" /><aaif:inflection rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Uninflected" /><aaif:attributionTarget rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Verb" /><aaif:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:modified><aaif:semanticClassification rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Manner" /><aaif:reduplicated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:reduplicated><aaif:prepositionalPhrase rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:prepositionalPhrase></aaif:Adverb><aaif:Entry rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En1028"><aaif:phrase rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh#En1028Ph1" /><aaif:source rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh.bibl#Cnde6" /><gams:textualContent>pobre, lo asustaba pensar que podía verse envuelto en un lío mayor.Y los gritos seguían,  escuchaba  clarito los alaridos de las mujeres, se estaban matando allá arriba.Nilda le había arañado íntegra la cara a</gams:textualContent><rel:isPartOf rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh" /></aaif:Entry><aaif:Phrase rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En1028Ph1"><aaif:verb rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh#En1028Ph1Ve1" /><aaif:adverb rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh#En1028Ph1Ad1" /><aaif:text> escuchaba  clarito los alaridos de las mujeres</aaif:text><aaif:annoText> [v|escuchaba|escuchar|ts]  [a|clarito|claro|auvnmnnn] los alaridos de las mujeres</aaif:annoText></aaif:Phrase><aaif:Verb rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En1028Ph1Ve1"><aaif:text>escuchaba</aaif:text><aaif:lemma rdf:resource="https://gams.uni-graz.at/o:aaif.lemma#escuchar" /><aaif:position rdf:datatype="http://www.w3.org/2001/XMLSchema#int">1</aaif:position><aaif:coordinated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:coordinated><aaif:partOfText rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</aaif:partOfText><aaif:syntacticConstruction rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Transitive" /></aaif:Verb><aaif:Adverb rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En1028Ph1Ad1"><aaif:text>clarito</aaif:text><aaif:lemma rdf:resource="https://gams.uni-graz.at/o:aaif.lemma#claro" /><aaif:position rdf:datatype="http://www.w3.org/2001/XMLSchema#int">2</aaif:position><aaif:coordinated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:coordinated><aaif:morphosyntacticStructure rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Adjective" /><aaif:inflection rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Uninflected" /><aaif:attributionTarget rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Verb" /><aaif:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:modified><aaif:semanticClassification rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Manner" /><aaif:reduplicated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:reduplicated><aaif:prepositionalPhrase rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:prepositionalPhrase></aaif:Adverb><aaif:Entry rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En1029"><aaif:phrase rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh#En1029Ph1" /><aaif:source rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh.bibl#Cnde6" /><gams:textualContent>O sea que este año te toca a ti — pronunció clarito , al ver a Julius.</gams:textualContent><rel:isPartOf rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh" /></aaif:Entry><aaif:Phrase rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En1029Ph1"><aaif:verb rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh#En1029Ph1Ve1" /><aaif:adverb rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh#En1029Ph1Ad1" /><aaif:text>O sea que este año te toca a ti — pronunció clarito </aaif:text><aaif:annoText>O sea que este año te toca a ti — [v|pronunció|pronunciar|ts] [a|clarito|claro|auvnmnnn] </aaif:annoText></aaif:Phrase><aaif:Verb rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En1029Ph1Ve1"><aaif:text>pronunció</aaif:text><aaif:lemma rdf:resource="https://gams.uni-graz.at/o:aaif.lemma#pronunciar" /><aaif:position rdf:datatype="http://www.w3.org/2001/XMLSchema#int">1</aaif:position><aaif:coordinated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:coordinated><aaif:partOfText rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</aaif:partOfText><aaif:syntacticConstruction rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Transitive" /></aaif:Verb><aaif:Adverb rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En1029Ph1Ad1"><aaif:text>clarito</aaif:text><aaif:lemma rdf:resource="https://gams.uni-graz.at/o:aaif.lemma#claro" /><aaif:position rdf:datatype="http://www.w3.org/2001/XMLSchema#int">2</aaif:position><aaif:coordinated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:coordinated><aaif:morphosyntacticStructure rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Adjective" /><aaif:inflection rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Uninflected" /><aaif:attributionTarget rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Verb" /><aaif:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:modified><aaif:semanticClassification rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Manner" /><aaif:reduplicated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:reduplicated><aaif:prepositionalPhrase rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:prepositionalPhrase></aaif:Adverb><aaif:Entry rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En1030"><aaif:phrase rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh#En1030Ph1" /><aaif:source rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh.bibl#Cnde6" /><gams:textualContent>al padre Brown, demasiada risa, no sabía muy bien qué, justo lo estaba observando cuando escuchó clarito la voz de su mamá, volteó, se le perdió entre la gente, pero algo le había oído</gams:textualContent><rel:isPartOf rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh" /></aaif:Entry><aaif:Phrase rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En1030Ph1"><aaif:verb rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh#En1030Ph1Ve1" /><aaif:adverb rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh#En1030Ph1Ad1" /><aaif:text>cuando escuchó clarito la voz de su mamá</aaif:text><aaif:annoText>cuando [v|escuchó|escuchar|ts] [a|clarito|claro|auvnmnnn] la voz de su mamá</aaif:annoText></aaif:Phrase><aaif:Verb rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En1030Ph1Ve1"><aaif:text>escuchó</aaif:text><aaif:lemma rdf:resource="https://gams.uni-graz.at/o:aaif.lemma#escuchar" /><aaif:position rdf:datatype="http://www.w3.org/2001/XMLSchema#int">1</aaif:position><aaif:coordinated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:coordinated><aaif:partOfText rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</aaif:partOfText><aaif:syntacticConstruction rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Transitive" /></aaif:Verb><aaif:Adverb rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En1030Ph1Ad1"><aaif:text>clarito</aaif:text><aaif:lemma rdf:resource="https://gams.uni-graz.at/o:aaif.lemma#claro" /><aaif:position rdf:datatype="http://www.w3.org/2001/XMLSchema#int">2</aaif:position><aaif:coordinated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:coordinated><aaif:morphosyntacticStructure rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Adjective" /><aaif:inflection rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Uninflected" /><aaif:attributionTarget rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Verb" /><aaif:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:modified><aaif:semanticClassification rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Manner" /><aaif:reduplicated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:reduplicated><aaif:prepositionalPhrase rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:prepositionalPhrase></aaif:Adverb><aaif:Entry rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En1031"><aaif:phrase rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh#En1031Ph1" /><aaif:source rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh.bibl#Cnde6" /><gams:textualContent>sólo quedaba el árbol.Julius se trasladó mentalmente donde Cano y desde ahí se miró: se le veía clarito detrás del árbol.Prefirió salir corriendo pero se encontró con la ramita en su camino, lápiz estaba</gams:textualContent><rel:isPartOf rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh" /></aaif:Entry><aaif:Phrase rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En1031Ph1"><aaif:verb rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh#En1031Ph1Ve1" /><aaif:adverb rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh#En1031Ph1Ad1" /><aaif:text>se le veía clarito detrás del árbol.</aaif:text><aaif:annoText>se le [v|veía|ver|ts] [a|clarito|claro|auvnmnnn] detrás del árbol.</aaif:annoText></aaif:Phrase><aaif:Verb rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En1031Ph1Ve1"><aaif:text>veía</aaif:text><aaif:lemma rdf:resource="https://gams.uni-graz.at/o:aaif.lemma#ver" /><aaif:position rdf:datatype="http://www.w3.org/2001/XMLSchema#int">1</aaif:position><aaif:coordinated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:coordinated><aaif:partOfText rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</aaif:partOfText><aaif:syntacticConstruction rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Transitive" /></aaif:Verb><aaif:Adverb rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En1031Ph1Ad1"><aaif:text>clarito</aaif:text><aaif:lemma rdf:resource="https://gams.uni-graz.at/o:aaif.lemma#claro" /><aaif:position rdf:datatype="http://www.w3.org/2001/XMLSchema#int">2</aaif:position><aaif:coordinated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:coordinated><aaif:morphosyntacticStructure rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Adjective" /><aaif:inflection rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Uninflected" /><aaif:attributionTarget rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Verb" /><aaif:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:modified><aaif:semanticClassification rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Manner" /><aaif:reduplicated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:reduplicated><aaif:prepositionalPhrase rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:prepositionalPhrase></aaif:Adverb><aaif:Entry rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En1032"><aaif:phrase rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh#En1032Ph1" /><aaif:source rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh.bibl#Cnde6" /><gams:textualContent>No de que ella saliera, eso era otra cosa.Pero por primera vez en su vida  él  veía clarito que Juan Lucas tenía la culpa.Siempre creía tener razón y siempre la tenía porque era más alto y hablaba</gams:textualContent><rel:isPartOf rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh" /></aaif:Entry><aaif:Phrase rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En1032Ph1"><aaif:subject rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh#En1032Ph1Su1" /><aaif:verb rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh#En1032Ph1Ve1" /><aaif:adverb rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh#En1032Ph1Ad1" /><aaif:text> él  veía clarito que Juan Lucas tenía la culpa</aaif:text><aaif:annoText> [s|él|ms]  [v|veía|ver|ts] [a|clarito|claro|auvnmnnn] que Juan Lucas tenía la culpa</aaif:annoText></aaif:Phrase><aaif:Subject rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En1032Ph1Su1"><aaif:text>él</aaif:text><aaif:position rdf:datatype="http://www.w3.org/2001/XMLSchema#int">1</aaif:position><aaif:gender rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Masculine" /><aaif:number rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Singular" /><aaif:overt rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</aaif:overt></aaif:Subject><aaif:Verb rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En1032Ph1Ve1"><aaif:text>veía</aaif:text><aaif:lemma rdf:resource="https://gams.uni-graz.at/o:aaif.lemma#ver" /><aaif:position rdf:datatype="http://www.w3.org/2001/XMLSchema#int">2</aaif:position><aaif:coordinated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:coordinated><aaif:partOfText rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</aaif:partOfText><aaif:syntacticConstruction rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Transitive" /></aaif:Verb><aaif:Adverb rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En1032Ph1Ad1"><aaif:text>clarito</aaif:text><aaif:lemma rdf:resource="https://gams.uni-graz.at/o:aaif.lemma#claro" /><aaif:position rdf:datatype="http://www.w3.org/2001/XMLSchema#int">3</aaif:position><aaif:coordinated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:coordinated><aaif:morphosyntacticStructure rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Adjective" /><aaif:inflection rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Uninflected" /><aaif:attributionTarget rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Verb" /><aaif:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:modified><aaif:semanticClassification rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Manner" /><aaif:reduplicated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:reduplicated><aaif:prepositionalPhrase rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:prepositionalPhrase></aaif:Adverb><aaif:Entry rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En1033"><aaif:phrase rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh#En1033Ph1" /><aaif:source rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh.bibl#Cnde6" /><gams:textualContent>cómo se incorporaba lentamente, y cómo volvía caer sobre el borde acolchado de la barra...Entonces sí veía clarito las otras tardes en la playa, en Ancón, en una fiesta una noche, todo acababa de suceder</gams:textualContent><rel:isPartOf rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh" /></aaif:Entry><aaif:Phrase rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En1033Ph1"><aaif:verb rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh#En1033Ph1Ve1" /><aaif:adverb rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh#En1033Ph1Ad1" /><aaif:text>Entonces sí veía clarito las otras tardes en la playa</aaif:text><aaif:annoText>Entonces sí [v|veía|ver|ts] [a|clarito|claro|auvnmnnn] las otras tardes en la playa</aaif:annoText></aaif:Phrase><aaif:Verb rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En1033Ph1Ve1"><aaif:text>veía</aaif:text><aaif:lemma rdf:resource="https://gams.uni-graz.at/o:aaif.lemma#ver" /><aaif:position rdf:datatype="http://www.w3.org/2001/XMLSchema#int">1</aaif:position><aaif:coordinated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:coordinated><aaif:partOfText rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</aaif:partOfText><aaif:syntacticConstruction rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Transitive" /></aaif:Verb><aaif:Adverb rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En1033Ph1Ad1"><aaif:text>clarito</aaif:text><aaif:lemma rdf:resource="https://gams.uni-graz.at/o:aaif.lemma#claro" /><aaif:position rdf:datatype="http://www.w3.org/2001/XMLSchema#int">2</aaif:position><aaif:coordinated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:coordinated><aaif:morphosyntacticStructure rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Adjective" /><aaif:inflection rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Uninflected" /><aaif:attributionTarget rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Verb" /><aaif:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:modified><aaif:semanticClassification rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Manner" /><aaif:reduplicated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:reduplicated><aaif:prepositionalPhrase rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:prepositionalPhrase></aaif:Adverb><aaif:Entry rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En1034"><aaif:phrase rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh#En1034Ph1" /><aaif:source rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh.bibl#Cnde187" /><gams:textualContent>sí, siento la brisa que la acaricia y mi mano que toca mi mejilla, adiós Romualdo,  hablo  claro y alto , veo la ciudad rodeándome tan benigna como la Casa porque nadie podrá descubrirme bajo este disfraz.</gams:textualContent><rel:isPartOf rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh" /></aaif:Entry><aaif:Phrase rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En1034Ph1"><aaif:verb rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh#En1034Ph1Ve1" /><aaif:adverb rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh#En1034Ph1Ad1" /><aaif:adverb rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh#En1034Ph1Ad2" /><aaif:text> hablo  claro y alto </aaif:text><aaif:annoText> [v|hablo|hablar|is]  [a|claro|claro|auvnmnnC] y [a|alto|alto|auvnmnnC] </aaif:annoText></aaif:Phrase><aaif:Verb rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En1034Ph1Ve1"><aaif:text>hablo</aaif:text><aaif:lemma rdf:resource="https://gams.uni-graz.at/o:aaif.lemma#hablar" /><aaif:position rdf:datatype="http://www.w3.org/2001/XMLSchema#int">1</aaif:position><aaif:coordinated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:coordinated><aaif:partOfText rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</aaif:partOfText><aaif:syntacticConstruction rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Intransitive" /></aaif:Verb><aaif:Adverb rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En1034Ph1Ad1"><aaif:text>claro</aaif:text><aaif:lemma rdf:resource="https://gams.uni-graz.at/o:aaif.lemma#claro" /><aaif:position rdf:datatype="http://www.w3.org/2001/XMLSchema#int">2</aaif:position><aaif:coordinated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</aaif:coordinated><aaif:morphosyntacticStructure rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Adjective" /><aaif:inflection rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Uninflected" /><aaif:attributionTarget rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Verb" /><aaif:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:modified><aaif:semanticClassification rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Manner" /><aaif:reduplicated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:reduplicated><aaif:prepositionalPhrase rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:prepositionalPhrase></aaif:Adverb><aaif:Adverb rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En1034Ph1Ad2"><aaif:text>alto</aaif:text><aaif:lemma rdf:resource="https://gams.uni-graz.at/o:aaif.lemma#alto" /><aaif:position rdf:datatype="http://www.w3.org/2001/XMLSchema#int">3</aaif:position><aaif:coordinated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</aaif:coordinated><aaif:morphosyntacticStructure rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Adjective" /><aaif:inflection rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Uninflected" /><aaif:attributionTarget rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Verb" /><aaif:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:modified><aaif:semanticClassification rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Manner" /><aaif:reduplicated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:reduplicated><aaif:prepositionalPhrase rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:prepositionalPhrase></aaif:Adverb><aaif:Entry rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En1035"><aaif:phrase rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh#En1035Ph1" /><aaif:source rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh.bibl#Cnde187" /><gams:textualContent>Las risas venían de todas partes.Eran, además, no sólo risas sino que cuchicheos, murmuraciones, monstruos que corrían de puerta en puerta cargados con la noticia, carcajadas ahogadas reventando, la centralita telefónica más ocupada que nunca, la operadora comentando, interviniendo para corregir versiones de los que hablaban para citarse según sus categorías o amistades, reírse de él, desmenuzar la noticia, jugar con ella, destruir definitivamente su autoridad, el ruido de los telefonazos mezclado con las carcajadas y con el canto de las ranas,  oyó claro, clarísimo , el tartamudeo de Melchor relatando algo... pero no: no era el tartamudeo de Melchor, no, era el bote y rebote de la pelota en la cancha de tennis donde Melchor y Melisa concluían una partida antes que se agotara la luz.No.Los monstruos no estaban reunidos hablando de él.</gams:textualContent><rel:isPartOf rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh" /></aaif:Entry><aaif:Phrase rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En1035Ph1"><aaif:verb rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh#En1035Ph1Ve1" /><aaif:adverb rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh#En1035Ph1Ad1" /><aaif:text> oyó claro, clarísimo , el tartamudeo de Melchor relatando algo</aaif:text><aaif:annoText> [v|oyó|oír|ts] claro, [a|clarísimo|claro|auvnmrnn] , el tartamudeo de Melchor relatando algo</aaif:annoText></aaif:Phrase><aaif:Verb rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En1035Ph1Ve1"><aaif:text>oyó</aaif:text><aaif:lemma rdf:resource="https://gams.uni-graz.at/o:aaif.lemma#oír" /><aaif:position rdf:datatype="http://www.w3.org/2001/XMLSchema#int">1</aaif:position><aaif:coordinated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:coordinated><aaif:partOfText rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</aaif:partOfText><aaif:syntacticConstruction rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Transitive" /></aaif:Verb><aaif:Adverb rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En1035Ph1Ad1"><aaif:text>clarísimo</aaif:text><aaif:lemma rdf:resource="https://gams.uni-graz.at/o:aaif.lemma#claro" /><aaif:position rdf:datatype="http://www.w3.org/2001/XMLSchema#int">2</aaif:position><aaif:coordinated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:coordinated><aaif:morphosyntacticStructure rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Adjective" /><aaif:inflection rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Uninflected" /><aaif:attributionTarget rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Verb" /><aaif:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:modified><aaif:semanticClassification rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Manner" /><aaif:reduplicated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</aaif:reduplicated><aaif:prepositionalPhrase rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:prepositionalPhrase></aaif:Adverb><aaif:Entry rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En1036"><aaif:phrase rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh#En1036Ph1" /><aaif:source rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh.bibl#Cnde187" /><gams:textualContent>— Ya no te entiendo...  habla  claro ...</gams:textualContent><rel:isPartOf rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh" /></aaif:Entry><aaif:Phrase rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En1036Ph1"><aaif:verb rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh#En1036Ph1Ve1" /><aaif:adverb rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh#En1036Ph1Ad1" /><aaif:text> habla  claro </aaif:text><aaif:annoText> [v|habla|hablar|is]  [a|claro|claro|auvnmnnn] </aaif:annoText></aaif:Phrase><aaif:Verb rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En1036Ph1Ve1"><aaif:text>habla</aaif:text><aaif:lemma rdf:resource="https://gams.uni-graz.at/o:aaif.lemma#hablar" /><aaif:position rdf:datatype="http://www.w3.org/2001/XMLSchema#int">1</aaif:position><aaif:coordinated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:coordinated><aaif:partOfText rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</aaif:partOfText><aaif:syntacticConstruction rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Intransitive" /></aaif:Verb><aaif:Adverb rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En1036Ph1Ad1"><aaif:text>claro</aaif:text><aaif:lemma rdf:resource="https://gams.uni-graz.at/o:aaif.lemma#claro" /><aaif:position rdf:datatype="http://www.w3.org/2001/XMLSchema#int">2</aaif:position><aaif:coordinated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:coordinated><aaif:morphosyntacticStructure rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Adjective" /><aaif:inflection rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Uninflected" /><aaif:attributionTarget rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Verb" /><aaif:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:modified><aaif:semanticClassification rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Manner" /><aaif:reduplicated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:reduplicated><aaif:prepositionalPhrase rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:prepositionalPhrase></aaif:Adverb><aaif:Entry rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En1037"><aaif:phrase rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh#En1037Ph1" /><aaif:source rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh.bibl#Cnde187" /><gams:textualContent>— No te entiendo, Emperatriz, mejor habla claro .Te advierto que esta es la última conversación que tú y yo vamos a tener sobre ciertos puntos.</gams:textualContent><rel:isPartOf rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh" /></aaif:Entry><aaif:Phrase rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En1037Ph1"><aaif:verb rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh#En1037Ph1Ve1" /><aaif:adverb rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh#En1037Ph1Ad1" /><aaif:text>No te entiendo, Emperatriz, mejor habla claro .</aaif:text><aaif:annoText>No te entiendo, Emperatriz, mejor [v|habla|hablar|is] [a|claro|claro|auvnmnnn] .</aaif:annoText></aaif:Phrase><aaif:Verb rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En1037Ph1Ve1"><aaif:text>habla</aaif:text><aaif:lemma rdf:resource="https://gams.uni-graz.at/o:aaif.lemma#hablar" /><aaif:position rdf:datatype="http://www.w3.org/2001/XMLSchema#int">1</aaif:position><aaif:coordinated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:coordinated><aaif:partOfText rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</aaif:partOfText><aaif:syntacticConstruction rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Intransitive" /></aaif:Verb><aaif:Adverb rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En1037Ph1Ad1"><aaif:text>claro</aaif:text><aaif:lemma rdf:resource="https://gams.uni-graz.at/o:aaif.lemma#claro" /><aaif:position rdf:datatype="http://www.w3.org/2001/XMLSchema#int">2</aaif:position><aaif:coordinated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:coordinated><aaif:morphosyntacticStructure rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Adjective" /><aaif:inflection rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Uninflected" /><aaif:attributionTarget rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Verb" /><aaif:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:modified><aaif:semanticClassification rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Manner" /><aaif:reduplicated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:reduplicated><aaif:prepositionalPhrase rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:prepositionalPhrase></aaif:Adverb><aaif:Entry rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En1038"><aaif:phrase rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh#En1038Ph1" /><aaif:source rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh.bibl#Cnde415" /><gams:textualContent>Fruit, más algo de petróleo, cobre y azufre.Aquí, en Europa, los únicos que vieron claro el porvenir fueron Stalin y Franco.A los dos todo les salió a pedir de boca.</gams:textualContent><rel:isPartOf rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh" /></aaif:Entry><aaif:Phrase rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En1038Ph1"><aaif:subject rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh#En1038Ph1Su1" /><aaif:verb rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh#En1038Ph1Ve1" /><aaif:adverb rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh#En1038Ph1Ad1" /><aaif:text>Aquí, en Europa, los únicos que vieron claro el porvenir fueron Stalin y Franco.</aaif:text><aaif:annoText>Aquí, en Europa, [s|los únicos|mp] que [v|vieron|ver|ts] [a|claro|claro|auvnmnnn] el porvenir fueron Stalin y Franco.</aaif:annoText></aaif:Phrase><aaif:Subject rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En1038Ph1Su1"><aaif:text>los únicos</aaif:text><aaif:position rdf:datatype="http://www.w3.org/2001/XMLSchema#int">1</aaif:position><aaif:gender rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Masculine" /><aaif:number rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Plural" /><aaif:overt rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</aaif:overt></aaif:Subject><aaif:Verb rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En1038Ph1Ve1"><aaif:text>vieron</aaif:text><aaif:lemma rdf:resource="https://gams.uni-graz.at/o:aaif.lemma#ver" /><aaif:position rdf:datatype="http://www.w3.org/2001/XMLSchema#int">2</aaif:position><aaif:coordinated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:coordinated><aaif:partOfText rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</aaif:partOfText><aaif:syntacticConstruction rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Transitive" /></aaif:Verb><aaif:Adverb rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En1038Ph1Ad1"><aaif:text>claro</aaif:text><aaif:lemma rdf:resource="https://gams.uni-graz.at/o:aaif.lemma#claro" /><aaif:position rdf:datatype="http://www.w3.org/2001/XMLSchema#int">3</aaif:position><aaif:coordinated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:coordinated><aaif:morphosyntacticStructure rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Adjective" /><aaif:inflection rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Uninflected" /><aaif:attributionTarget rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Verb" /><aaif:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:modified><aaif:semanticClassification rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Manner" /><aaif:reduplicated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:reduplicated><aaif:prepositionalPhrase rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:prepositionalPhrase></aaif:Adverb><aaif:Entry rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En1039"><aaif:phrase rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh#En1039Ph1" /><aaif:source rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh.bibl#Cnde616" /><gams:textualContent>Pero ella insistió:&lt;lb/&gt;— ¡Los soñé clarito , con sus pelos amarillos!</gams:textualContent><rel:isPartOf rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh" /></aaif:Entry><aaif:Phrase rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En1039Ph1"><aaif:verb rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh#En1039Ph1Ve1" /><aaif:adverb rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh#En1039Ph1Ad1" /><aaif:text>¡Los soñé clarito , con sus pelos amarillos!</aaif:text><aaif:annoText>¡Los [v|soñé|soñar|ts] [a|clarito|claro|auvnmnnn] , con sus pelos amarillos!</aaif:annoText></aaif:Phrase><aaif:Verb rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En1039Ph1Ve1"><aaif:text>soñé</aaif:text><aaif:lemma rdf:resource="https://gams.uni-graz.at/o:aaif.lemma#soñar" /><aaif:position rdf:datatype="http://www.w3.org/2001/XMLSchema#int">1</aaif:position><aaif:coordinated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:coordinated><aaif:partOfText rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</aaif:partOfText><aaif:syntacticConstruction rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Transitive" /></aaif:Verb><aaif:Adverb rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En1039Ph1Ad1"><aaif:text>clarito</aaif:text><aaif:lemma rdf:resource="https://gams.uni-graz.at/o:aaif.lemma#claro" /><aaif:position rdf:datatype="http://www.w3.org/2001/XMLSchema#int">2</aaif:position><aaif:coordinated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:coordinated><aaif:morphosyntacticStructure rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Adjective" /><aaif:inflection rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Uninflected" /><aaif:attributionTarget rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Verb" /><aaif:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:modified><aaif:semanticClassification rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Manner" /><aaif:reduplicated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:reduplicated><aaif:prepositionalPhrase rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:prepositionalPhrase></aaif:Adverb><aaif:Entry rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En1040"><aaif:phrase rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh#En1040Ph1" /><aaif:source rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh.bibl#Cnde120" /><gams:textualContent>paso del tiempo y mañanas como aquélla, en la que todavía sigo metido, pero es que  recuerdo  clarito que fue camino al Barrio Latino cuando se me vino a la mente lo del perro callejero que </gams:textualContent><rel:isPartOf rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh" /></aaif:Entry><aaif:Phrase rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En1040Ph1"><aaif:verb rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh#En1040Ph1Ve1" /><aaif:adverb rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh#En1040Ph1Ad1" /><aaif:text> recuerdo  clarito que fue camino al Barrio Latino</aaif:text><aaif:annoText> [v|recuerdo|recordar|ts]  [a|clarito|claro|auvnmnnn] que fue camino al Barrio Latino</aaif:annoText></aaif:Phrase><aaif:Verb rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En1040Ph1Ve1"><aaif:text>recuerdo</aaif:text><aaif:lemma rdf:resource="https://gams.uni-graz.at/o:aaif.lemma#recordar" /><aaif:position rdf:datatype="http://www.w3.org/2001/XMLSchema#int">1</aaif:position><aaif:coordinated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:coordinated><aaif:partOfText rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</aaif:partOfText><aaif:syntacticConstruction rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Transitive" /></aaif:Verb><aaif:Adverb rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En1040Ph1Ad1"><aaif:text>clarito</aaif:text><aaif:lemma rdf:resource="https://gams.uni-graz.at/o:aaif.lemma#claro" /><aaif:position rdf:datatype="http://www.w3.org/2001/XMLSchema#int">2</aaif:position><aaif:coordinated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:coordinated><aaif:morphosyntacticStructure rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Adjective" /><aaif:inflection rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Uninflected" /><aaif:attributionTarget rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Verb" /><aaif:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:modified><aaif:semanticClassification rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Manner" /><aaif:reduplicated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:reduplicated><aaif:prepositionalPhrase rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:prepositionalPhrase></aaif:Adverb><aaif:Entry rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En1041"><aaif:phrase rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh#En1041Ph1" /><aaif:source rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh.bibl#Cnde120" /><gams:textualContent>rebotando yo donde Inés, que me mandó también a la mierda por no tener pantalones.Lo recuerdo clarito : estábamos cansados del viaje pero se notaba que, &lt;lb/&gt;en medio del pleito y de todo,</gams:textualContent><rel:isPartOf rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh" /></aaif:Entry><aaif:Phrase rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En1041Ph1"><aaif:verb rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh#En1041Ph1Ve1" /><aaif:adverb rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh#En1041Ph1Ad1" /><aaif:text>Lo recuerdo clarito :</aaif:text><aaif:annoText>Lo [v|recuerdo|recordar|ts] [a|clarito|claro|auvnmnnn] :</aaif:annoText></aaif:Phrase><aaif:Verb rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En1041Ph1Ve1"><aaif:text>recuerdo</aaif:text><aaif:lemma rdf:resource="https://gams.uni-graz.at/o:aaif.lemma#recordar" /><aaif:position rdf:datatype="http://www.w3.org/2001/XMLSchema#int">1</aaif:position><aaif:coordinated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:coordinated><aaif:partOfText rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</aaif:partOfText><aaif:syntacticConstruction rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Transitive" /></aaif:Verb><aaif:Adverb rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En1041Ph1Ad1"><aaif:text>clarito</aaif:text><aaif:lemma rdf:resource="https://gams.uni-graz.at/o:aaif.lemma#claro" /><aaif:position rdf:datatype="http://www.w3.org/2001/XMLSchema#int">2</aaif:position><aaif:coordinated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:coordinated><aaif:morphosyntacticStructure rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Adjective" /><aaif:inflection rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Uninflected" /><aaif:attributionTarget rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Verb" /><aaif:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:modified><aaif:semanticClassification rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Manner" /><aaif:reduplicated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:reduplicated><aaif:prepositionalPhrase rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:prepositionalPhrase></aaif:Adverb><aaif:Entry rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En1042"><aaif:phrase rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh#En1042Ph1" /><aaif:source rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh.bibl#Cnde62" /><gams:textualContent>encendida de Marco Antonio Muñiz.Lo dejaba, pero también le paraba los pies y en cuanto se embullaba se las cantaba claro : bájate de esa nube, que yo no &lt;lb/&gt;estoy por eso.Con hombres como Pancho Bigote no había que</gams:textualContent><rel:isPartOf rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh" /></aaif:Entry><aaif:Phrase rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En1042Ph1"><aaif:verb rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh#En1042Ph1Ve1" /><aaif:adverb rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh#En1042Ph1Ad1" /><aaif:text>se las cantaba claro : bájate de esa nube</aaif:text><aaif:annoText>se las [v|cantaba|cantar|ts] [a|claro|claro|auvnmnnn] : bájate de esa nube</aaif:annoText></aaif:Phrase><aaif:Verb rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En1042Ph1Ve1"><aaif:text>cantaba</aaif:text><aaif:lemma rdf:resource="https://gams.uni-graz.at/o:aaif.lemma#cantar" /><aaif:position rdf:datatype="http://www.w3.org/2001/XMLSchema#int">1</aaif:position><aaif:coordinated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:coordinated><aaif:partOfText rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</aaif:partOfText><aaif:syntacticConstruction rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Transitive" /></aaif:Verb><aaif:Adverb rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En1042Ph1Ad1"><aaif:text>claro</aaif:text><aaif:lemma rdf:resource="https://gams.uni-graz.at/o:aaif.lemma#claro" /><aaif:position rdf:datatype="http://www.w3.org/2001/XMLSchema#int">2</aaif:position><aaif:coordinated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:coordinated><aaif:morphosyntacticStructure rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Adjective" /><aaif:inflection rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Uninflected" /><aaif:attributionTarget rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Verb" /><aaif:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:modified><aaif:semanticClassification rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Manner" /><aaif:reduplicated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:reduplicated><aaif:prepositionalPhrase rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:prepositionalPhrase></aaif:Adverb><aaif:Entry rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En1043"><aaif:phrase rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh#En1043Ph1" /><aaif:source rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh.bibl#Cnde538" /><gams:textualContent>encima lo vendiste después del último ciclo de Fellini, a la mañana siguiente de Amarcord, me acuerdo clarito  —reprochó el Perro, doctor en Medicina.</gams:textualContent><rel:isPartOf rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh" /></aaif:Entry><aaif:Phrase rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En1043Ph1"><aaif:verb rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh#En1043Ph1Ve1" /><aaif:adverb rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh#En1043Ph1Ad1" /><aaif:text>me acuerdo clarito </aaif:text><aaif:annoText>me [v|acuerdo|acordar|rs] [a|clarito|claro|auvnmnnn] </aaif:annoText></aaif:Phrase><aaif:Verb rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En1043Ph1Ve1"><aaif:text>acuerdo</aaif:text><aaif:lemma rdf:resource="https://gams.uni-graz.at/o:aaif.lemma#acordar" /><aaif:position rdf:datatype="http://www.w3.org/2001/XMLSchema#int">1</aaif:position><aaif:coordinated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:coordinated><aaif:partOfText rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</aaif:partOfText><aaif:syntacticConstruction rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Reflexive" /></aaif:Verb><aaif:Adverb rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En1043Ph1Ad1"><aaif:text>clarito</aaif:text><aaif:lemma rdf:resource="https://gams.uni-graz.at/o:aaif.lemma#claro" /><aaif:position rdf:datatype="http://www.w3.org/2001/XMLSchema#int">2</aaif:position><aaif:coordinated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:coordinated><aaif:morphosyntacticStructure rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Adjective" /><aaif:inflection rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Uninflected" /><aaif:attributionTarget rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Verb" /><aaif:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:modified><aaif:semanticClassification rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Manner" /><aaif:reduplicated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:reduplicated><aaif:prepositionalPhrase rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:prepositionalPhrase></aaif:Adverb><aaif:Entry rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En1044"><aaif:phrase rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh#En1044Ph1" /><aaif:source rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh.bibl#Cnde617" /><gams:textualContent>Ni Leonardo ni Diego se hallaban en aptitud de leer claro en el semblante de sus amigas lo que pasaba en sus espíritus, cuando llegó el momento de saludarse, según el modo frío y rígido que piden las costumbres cubanas, esto es, sin el significativo apretón de manos.</gams:textualContent><rel:isPartOf rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh" /></aaif:Entry><aaif:Phrase rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En1044Ph1"><aaif:verb rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh#En1044Ph1Ve1" /><aaif:adverb rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh#En1044Ph1Ad1" /><aaif:text>aptitud de leer claro en el semblante de sus amigas</aaif:text><aaif:annoText>aptitud de [v|leer|leer|ts] [a|claro|claro|auvnmnnn] en el semblante de sus amigas</aaif:annoText></aaif:Phrase><aaif:Verb rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En1044Ph1Ve1"><aaif:text>leer</aaif:text><aaif:lemma rdf:resource="https://gams.uni-graz.at/o:aaif.lemma#leer" /><aaif:position rdf:datatype="http://www.w3.org/2001/XMLSchema#int">1</aaif:position><aaif:coordinated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:coordinated><aaif:partOfText rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</aaif:partOfText><aaif:syntacticConstruction rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Transitive" /></aaif:Verb><aaif:Adverb rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En1044Ph1Ad1"><aaif:text>claro</aaif:text><aaif:lemma rdf:resource="https://gams.uni-graz.at/o:aaif.lemma#claro" /><aaif:position rdf:datatype="http://www.w3.org/2001/XMLSchema#int">2</aaif:position><aaif:coordinated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:coordinated><aaif:morphosyntacticStructure rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Adjective" /><aaif:inflection rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Uninflected" /><aaif:attributionTarget rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Verb" /><aaif:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:modified><aaif:semanticClassification rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Manner" /><aaif:reduplicated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:reduplicated><aaif:prepositionalPhrase rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:prepositionalPhrase></aaif:Adverb><aaif:Entry rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En1045"><aaif:phrase rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh#En1045Ph1" /><aaif:source rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh.bibl#Cnde60" /><gams:textualContent>una rápida ojeada, como para verificar si yo estaba realmente ahí, y en sus ojos se podía leer clarísimo que todavía no le cabía en la cabeza que la hubiera besado.La tía Olga estaba ya cansada y</gams:textualContent><rel:isPartOf rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh" /></aaif:Entry><aaif:Phrase rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En1045Ph1"><aaif:verb rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh#En1045Ph1Ve1" /><aaif:adverb rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh#En1045Ph1Ad1" /><aaif:text>en sus ojos se podía leer clarísimo que todavía no le cabía en la cabeza que la hubiera besado</aaif:text><aaif:annoText>en sus ojos se podía [v|leer|leer|rs] [a|clarísimo|claro|auvnmnnn] que todavía no le cabía en la cabeza que la hubiera besado</aaif:annoText></aaif:Phrase><aaif:Verb rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En1045Ph1Ve1"><aaif:text>leer</aaif:text><aaif:lemma rdf:resource="https://gams.uni-graz.at/o:aaif.lemma#leer" /><aaif:position rdf:datatype="http://www.w3.org/2001/XMLSchema#int">1</aaif:position><aaif:coordinated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:coordinated><aaif:partOfText rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</aaif:partOfText><aaif:syntacticConstruction rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Reflexive" /></aaif:Verb><aaif:Adverb rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En1045Ph1Ad1"><aaif:text>clarísimo</aaif:text><aaif:lemma rdf:resource="https://gams.uni-graz.at/o:aaif.lemma#claro" /><aaif:position rdf:datatype="http://www.w3.org/2001/XMLSchema#int">2</aaif:position><aaif:coordinated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:coordinated><aaif:morphosyntacticStructure rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Adjective" /><aaif:inflection rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Uninflected" /><aaif:attributionTarget rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Verb" /><aaif:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:modified><aaif:semanticClassification rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Manner" /><aaif:reduplicated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:reduplicated><aaif:prepositionalPhrase rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:prepositionalPhrase></aaif:Adverb><aaif:Entry rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En1046"><aaif:phrase rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh#En1046Ph1" /><aaif:source rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh.bibl#Cnde288" /><gams:textualContent>— ¿De veras?&lt;lb/&gt;— Sí, me acuerdo clarito clarito de muchas.</gams:textualContent><rel:isPartOf rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh" /></aaif:Entry><aaif:Phrase rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En1046Ph1"><aaif:verb rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh#En1046Ph1Ve1" /><aaif:adverb rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh#En1046Ph1Ad1" /><aaif:text>Sí, me acuerdo clarito clarito de muchas.</aaif:text><aaif:annoText>Sí, me [v|acuerdo|acordar|rs] clarito [a|clarito|claro|auvnmrnn] de muchas.</aaif:annoText></aaif:Phrase><aaif:Verb rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En1046Ph1Ve1"><aaif:text>acuerdo</aaif:text><aaif:lemma rdf:resource="https://gams.uni-graz.at/o:aaif.lemma#acordar" /><aaif:position rdf:datatype="http://www.w3.org/2001/XMLSchema#int">1</aaif:position><aaif:coordinated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:coordinated><aaif:partOfText rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</aaif:partOfText><aaif:syntacticConstruction rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Reflexive" /></aaif:Verb><aaif:Adverb rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En1046Ph1Ad1"><aaif:text>clarito</aaif:text><aaif:lemma rdf:resource="https://gams.uni-graz.at/o:aaif.lemma#claro" /><aaif:position rdf:datatype="http://www.w3.org/2001/XMLSchema#int">2</aaif:position><aaif:coordinated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:coordinated><aaif:morphosyntacticStructure rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Adjective" /><aaif:inflection rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Uninflected" /><aaif:attributionTarget rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Verb" /><aaif:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:modified><aaif:semanticClassification rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Manner" /><aaif:reduplicated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</aaif:reduplicated><aaif:prepositionalPhrase rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:prepositionalPhrase></aaif:Adverb><aaif:Entry rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En1047"><aaif:phrase rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh#En1047Ph1" /><aaif:source rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh.bibl#Cnde158" /><gams:textualContent>Petimetre 2.º  Vamos  claros ;&lt;lb/&gt;todos somos tus amigos;&lt;lb/&gt;tu ventura celebramos&lt;lb/&gt;con deseo que la logres&lt;lb/&gt;barata y por muchos años</gams:textualContent><rel:isPartOf rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh" /></aaif:Entry><aaif:Phrase rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En1047Ph1"><aaif:verb rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh#En1047Ph1Ve1" /><aaif:adverb rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh#En1047Ph1Ad1" /><aaif:text> Vamos  claros ;&lt;lb\/&gt;todos somos tus amigos</aaif:text><aaif:annoText> [v|Vamos|ir|is]  [a|claros|claro|apsnmnnn] ;&lt;lb\/&gt;todos somos tus amigos</aaif:annoText></aaif:Phrase><aaif:Verb rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En1047Ph1Ve1"><aaif:text>Vamos</aaif:text><aaif:lemma rdf:resource="https://gams.uni-graz.at/o:aaif.lemma#ir" /><aaif:position rdf:datatype="http://www.w3.org/2001/XMLSchema#int">1</aaif:position><aaif:coordinated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:coordinated><aaif:partOfText rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</aaif:partOfText><aaif:syntacticConstruction rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Intransitive" /></aaif:Verb><aaif:Adverb rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En1047Ph1Ad1"><aaif:text>claros</aaif:text><aaif:lemma rdf:resource="https://gams.uni-graz.at/o:aaif.lemma#claro" /><aaif:position rdf:datatype="http://www.w3.org/2001/XMLSchema#int">2</aaif:position><aaif:coordinated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:coordinated><aaif:morphosyntacticStructure rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Adjective" /><aaif:inflection rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#MasculinePlural" /><aaif:attributionTarget rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Verb" /><aaif:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:modified><aaif:semanticClassification rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Manner" /><aaif:reduplicated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:reduplicated><aaif:prepositionalPhrase rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:prepositionalPhrase></aaif:Adverb><aaif:Entry rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En1048"><aaif:phrase rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh#En1048Ph1" /><aaif:source rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh.bibl#Cnde111" /><gams:textualContent>verían en el cielo estrellas que jamás se habían visto y que sin él no podrían verse;que  advertirían  distintas y claras las manchas que en la cara de la luna se mienten ojos y boca y en el cerco</gams:textualContent><rel:isPartOf rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh" /></aaif:Entry><aaif:Phrase rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En1048Ph1"><aaif:verb rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh#En1048Ph1Ve1" /><aaif:adverb rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh#En1048Ph1Ad1" /><aaif:adverb rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh#En1048Ph1Ad2" /><aaif:text> advertirían  distintas y claras las manchas</aaif:text><aaif:annoText> [v|advertirían|advertir|ts]  [a|distintas|distinto|axonmnnC] y [a|claras|claro|axonmnnC] las manchas</aaif:annoText></aaif:Phrase><aaif:Verb rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En1048Ph1Ve1"><aaif:text>advertirían</aaif:text><aaif:lemma rdf:resource="https://gams.uni-graz.at/o:aaif.lemma#advertir" /><aaif:position rdf:datatype="http://www.w3.org/2001/XMLSchema#int">1</aaif:position><aaif:coordinated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:coordinated><aaif:partOfText rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</aaif:partOfText><aaif:syntacticConstruction rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Transitive" /></aaif:Verb><aaif:Adverb rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En1048Ph1Ad1"><aaif:text>distintas</aaif:text><aaif:lemma rdf:resource="https://gams.uni-graz.at/o:aaif.lemma#distinto" /><aaif:position rdf:datatype="http://www.w3.org/2001/XMLSchema#int">2</aaif:position><aaif:coordinated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</aaif:coordinated><aaif:morphosyntacticStructure rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Adjective" /><aaif:inflection rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#FemininePlural" /><aaif:attributionTarget rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#VerbObject" /><aaif:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:modified><aaif:semanticClassification rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Manner" /><aaif:reduplicated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:reduplicated><aaif:prepositionalPhrase rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:prepositionalPhrase></aaif:Adverb><aaif:Adverb rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En1048Ph1Ad2"><aaif:text>claras</aaif:text><aaif:lemma rdf:resource="https://gams.uni-graz.at/o:aaif.lemma#claro" /><aaif:position rdf:datatype="http://www.w3.org/2001/XMLSchema#int">3</aaif:position><aaif:coordinated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</aaif:coordinated><aaif:morphosyntacticStructure rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Adjective" /><aaif:inflection rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#FemininePlural" /><aaif:attributionTarget rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#VerbObject" /><aaif:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:modified><aaif:semanticClassification rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Manner" /><aaif:reduplicated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:reduplicated><aaif:prepositionalPhrase rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:prepositionalPhrase></aaif:Adverb><aaif:Entry rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En1049"><aaif:phrase rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh#En1049Ph1" /><aaif:source rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh.bibl#Cnde28" /><gams:textualContent>¡Oh, era un tímido moral!¡Era un mísero indeciso, y más, justamente, para los momentos, para las urgencias de las grandes decisiones!La simple traición de un respeto, habíale impuesto, de instintivo modo, entregándole atado de pies y manos a don Pedro.Veíalo ahora.Sin necesidad de violencia, pudo contestarle mejor y mantenerse frente a él en plena dignidad.¡Ah, si siempre las respuestas a las frases o a los hechos pudieran aplazarse a la semana, por ejemplo, tras una larga reflexión!...«Don Pedro —hubiese debido responderle , correcto diplomático , seguro de sí mismo—, al irregular procedimiento que usted propone...» Mas, ya ¿a qué quebrarse la cabeza?...Su vencido...Un concejal, aquel tonto de Sidoro, que para mayor escarnio, con sus greñas de anarquista y sus lecturas de El Motín, era amigo de don Pedro y poeta de sus jueves; un triunfo electoral por sorpresa (la verdad), a esto reducido, y un plan de competencias de dinero que Octavio no tendría, expuesto y avisado previamente por el cacique millonario para las nuevas luchas de elecciones...Desfallecía, sí, ¡bah!, desfallecía; se quitaba de delante las hojas de papel en que pensaba reaccionarse, y aun acaso ante el pueblo sincerarse (¡ingenuo!) con discursos o proclamas..., y blando, triste, amargadísimo, sacaba sus retratos de mujeres, L'Or du Rhin, la Olga Stelly, la Mado Yot, la Gaby Vilvert...</gams:textualContent><rel:isPartOf rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh" /></aaif:Entry><aaif:Phrase rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En1049Ph1"><aaif:verb rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh#En1049Ph1Ve1" /><aaif:adverb rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh#En1049Ph1Ad1" /><aaif:adverb rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh#En1049Ph1Ad2" /><aaif:text>hubiese debido responderle , correcto diplomático , seguro de sí mismo</aaif:text><aaif:annoText>hubiese debido [v|responderle|responder|is] , [a|correcto|correcto|auvnmnnC] [a|diplomático|diplomático|auvnmnnC] , seguro de sí mismo</aaif:annoText></aaif:Phrase><aaif:Verb rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En1049Ph1Ve1"><aaif:text>responderle</aaif:text><aaif:lemma rdf:resource="https://gams.uni-graz.at/o:aaif.lemma#responder" /><aaif:position rdf:datatype="http://www.w3.org/2001/XMLSchema#int">1</aaif:position><aaif:coordinated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:coordinated><aaif:partOfText rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</aaif:partOfText><aaif:syntacticConstruction rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Intransitive" /></aaif:Verb><aaif:Adverb rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En1049Ph1Ad1"><aaif:text>correcto</aaif:text><aaif:lemma rdf:resource="https://gams.uni-graz.at/o:aaif.lemma#correcto" /><aaif:position rdf:datatype="http://www.w3.org/2001/XMLSchema#int">2</aaif:position><aaif:coordinated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</aaif:coordinated><aaif:morphosyntacticStructure rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Adjective" /><aaif:inflection rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Uninflected" /><aaif:attributionTarget rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Verb" /><aaif:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:modified><aaif:semanticClassification rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Manner" /><aaif:reduplicated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:reduplicated><aaif:prepositionalPhrase rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:prepositionalPhrase></aaif:Adverb><aaif:Adverb rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En1049Ph1Ad2"><aaif:text>diplomático</aaif:text><aaif:lemma rdf:resource="https://gams.uni-graz.at/o:aaif.lemma#diplomático" /><aaif:position rdf:datatype="http://www.w3.org/2001/XMLSchema#int">3</aaif:position><aaif:coordinated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</aaif:coordinated><aaif:morphosyntacticStructure rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Adjective" /><aaif:inflection rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Uninflected" /><aaif:attributionTarget rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Verb" /><aaif:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:modified><aaif:semanticClassification rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Manner" /><aaif:reduplicated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:reduplicated><aaif:prepositionalPhrase rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:prepositionalPhrase></aaif:Adverb><aaif:Entry rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En1050"><aaif:phrase rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh#En1050Ph1" /><aaif:source rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh.bibl#Cnde408" /><gams:textualContent>oficial se contrajo levemente y con su mano abatió el aire rechazando algo inexistente; pero se contuvo, secundando correctísimo :</gams:textualContent><rel:isPartOf rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh" /></aaif:Entry><aaif:Phrase rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En1050Ph1"><aaif:verb rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh#En1050Ph1Ve1" /><aaif:adverb rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh#En1050Ph1Ad1" /><aaif:text>pero se contuvo, secundando correctísimo :</aaif:text><aaif:annoText>pero se contuvo, [v|secundando|secundar|ts] [a|correctísimo|correcto|auvnmnnn] :</aaif:annoText></aaif:Phrase><aaif:Verb rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En1050Ph1Ve1"><aaif:text>secundando</aaif:text><aaif:lemma rdf:resource="https://gams.uni-graz.at/o:aaif.lemma#secundar" /><aaif:position rdf:datatype="http://www.w3.org/2001/XMLSchema#int">1</aaif:position><aaif:coordinated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:coordinated><aaif:partOfText rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</aaif:partOfText><aaif:syntacticConstruction rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Transitive" /></aaif:Verb><aaif:Adverb rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En1050Ph1Ad1"><aaif:text>correctísimo</aaif:text><aaif:lemma rdf:resource="https://gams.uni-graz.at/o:aaif.lemma#correcto" /><aaif:position rdf:datatype="http://www.w3.org/2001/XMLSchema#int">2</aaif:position><aaif:coordinated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:coordinated><aaif:morphosyntacticStructure rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Adjective" /><aaif:inflection rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Uninflected" /><aaif:attributionTarget rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Verb" /><aaif:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:modified><aaif:semanticClassification rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Manner" /><aaif:reduplicated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:reduplicated><aaif:prepositionalPhrase rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:prepositionalPhrase></aaif:Adverb><aaif:Entry rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En1051"><aaif:phrase rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh#En1051Ph1" /><aaif:source rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh.bibl#Cnde80" /><gams:textualContent>Creo recordar que, cuando se nos aparecía un nombre que nos sonaba correcto , nos poníamos de pie e íbamos hasta la cuna y lo mirábamos fijo.Se lo decíamos a Baby en</gams:textualContent><rel:isPartOf rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh" /></aaif:Entry><aaif:Phrase rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En1051Ph1"><aaif:verb rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh#En1051Ph1Ve1" /><aaif:adverb rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh#En1051Ph1Ad1" /><aaif:text>cuando se nos aparecía un nombre que nos sonaba correcto </aaif:text><aaif:annoText>cuando se nos aparecía un nombre que nos [v|sonaba|sonar|is] [a|correcto|correcto|ausnmnnn] </aaif:annoText></aaif:Phrase><aaif:Verb rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En1051Ph1Ve1"><aaif:text>sonaba</aaif:text><aaif:lemma rdf:resource="https://gams.uni-graz.at/o:aaif.lemma#sonar" /><aaif:position rdf:datatype="http://www.w3.org/2001/XMLSchema#int">1</aaif:position><aaif:coordinated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:coordinated><aaif:partOfText rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</aaif:partOfText><aaif:syntacticConstruction rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Intransitive" /></aaif:Verb><aaif:Adverb rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En1051Ph1Ad1"><aaif:text>correcto</aaif:text><aaif:lemma rdf:resource="https://gams.uni-graz.at/o:aaif.lemma#correcto" /><aaif:position rdf:datatype="http://www.w3.org/2001/XMLSchema#int">2</aaif:position><aaif:coordinated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:coordinated><aaif:morphosyntacticStructure rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Adjective" /><aaif:inflection rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Uninflected" /><aaif:attributionTarget rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Verb" /><aaif:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:modified><aaif:semanticClassification rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Manner" /><aaif:reduplicated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:reduplicated><aaif:prepositionalPhrase rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:prepositionalPhrase></aaif:Adverb><aaif:Entry rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En1052"><aaif:phrase rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh#En1052Ph1" /><aaif:source rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh.bibl#Cnde87" /><gams:textualContent> Las fotos  salieron correctas .Vergara Grey pagó dos mil por cada una y mientras se alejaban en dirección a la estación Mapocho, filtrándose entre cúmulos de</gams:textualContent><rel:isPartOf rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh" /></aaif:Entry><aaif:Phrase rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En1052Ph1"><aaif:subject rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh#En1052Ph1Su1" /><aaif:verb rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh#En1052Ph1Ve1" /><aaif:adverb rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh#En1052Ph1Ad1" /><aaif:text> Las fotos  salieron correctas </aaif:text><aaif:annoText> [s|Las fotos|fp]  [v|salieron|salir|is] [a|correctas|correcto|axsnmnnn] </aaif:annoText></aaif:Phrase><aaif:Subject rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En1052Ph1Su1"><aaif:text>Las fotos</aaif:text><aaif:position rdf:datatype="http://www.w3.org/2001/XMLSchema#int">1</aaif:position><aaif:gender rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Feminine" /><aaif:number rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Plural" /><aaif:overt rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</aaif:overt></aaif:Subject><aaif:Verb rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En1052Ph1Ve1"><aaif:text>salieron</aaif:text><aaif:lemma rdf:resource="https://gams.uni-graz.at/o:aaif.lemma#salir" /><aaif:position rdf:datatype="http://www.w3.org/2001/XMLSchema#int">2</aaif:position><aaif:coordinated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:coordinated><aaif:partOfText rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</aaif:partOfText><aaif:syntacticConstruction rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Intransitive" /></aaif:Verb><aaif:Adverb rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En1052Ph1Ad1"><aaif:text>correctas</aaif:text><aaif:lemma rdf:resource="https://gams.uni-graz.at/o:aaif.lemma#correcto" /><aaif:position rdf:datatype="http://www.w3.org/2001/XMLSchema#int">3</aaif:position><aaif:coordinated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:coordinated><aaif:morphosyntacticStructure rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Adjective" /><aaif:inflection rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#FemininePlural" /><aaif:attributionTarget rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Verb" /><aaif:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:modified><aaif:semanticClassification rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Manner" /><aaif:reduplicated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:reduplicated><aaif:prepositionalPhrase rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:prepositionalPhrase></aaif:Adverb><aaif:Entry rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En1053"><aaif:phrase rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh#En1053Ph1" /><aaif:source rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh.bibl#Cnde94" /><gams:textualContent>que si de vida desespero, &lt;lb/&gt;yo pierdo cuanto bien de vos espero &lt;lb/&gt;y ansí ando en lo que siento diferente . &lt;lb/&gt;En esta diferencia mis sentidos&lt;lb/&gt;están, en vuestra ausencia, y en porfía; &lt;lb/&gt;</gams:textualContent><rel:isPartOf rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh" /></aaif:Entry><aaif:Phrase rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En1053Ph1"><aaif:verb rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh#En1053Ph1Ve1" /><aaif:adverb rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh#En1053Ph1Ad1" /><aaif:text>y ansí ando en lo que siento diferente </aaif:text><aaif:annoText>y ansí ando en lo que [v|siento|sentir|ts] [a|diferente|diferente|auonmnnn] </aaif:annoText></aaif:Phrase><aaif:Verb rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En1053Ph1Ve1"><aaif:text>siento</aaif:text><aaif:lemma rdf:resource="https://gams.uni-graz.at/o:aaif.lemma#sentir" /><aaif:position rdf:datatype="http://www.w3.org/2001/XMLSchema#int">1</aaif:position><aaif:coordinated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:coordinated><aaif:partOfText rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</aaif:partOfText><aaif:syntacticConstruction rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Transitive" /></aaif:Verb><aaif:Adverb rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En1053Ph1Ad1"><aaif:text>diferente</aaif:text><aaif:lemma rdf:resource="https://gams.uni-graz.at/o:aaif.lemma#diferente" /><aaif:position rdf:datatype="http://www.w3.org/2001/XMLSchema#int">2</aaif:position><aaif:coordinated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:coordinated><aaif:morphosyntacticStructure rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Adjective" /><aaif:inflection rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Uninflected" /><aaif:attributionTarget rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#VerbObject" /><aaif:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:modified><aaif:semanticClassification rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Manner" /><aaif:reduplicated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:reduplicated><aaif:prepositionalPhrase rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:prepositionalPhrase></aaif:Adverb><aaif:Entry rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En1054"><aaif:phrase rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh#En1054Ph1" /><aaif:source rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh.bibl#Cnde128" /><gams:textualContent>o provincia, y pensamos o juzgamos que la una está apartada de la otra mil leguas, por nombrarla differente , como ya avemos dicho de las tierras que conversan españoles y otras naciones que tratan en pescados.Y</gams:textualContent><rel:isPartOf rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh" /></aaif:Entry><aaif:Phrase rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En1054Ph1"><aaif:verb rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh#En1054Ph1Ve1" /><aaif:adverb rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh#En1054Ph1Ad1" /><aaif:text>por nombrarla differente </aaif:text><aaif:annoText>por [v|nombrarla|nombrar|ts] [a|differente|diferente|auvnmnnn] </aaif:annoText></aaif:Phrase><aaif:Verb rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En1054Ph1Ve1"><aaif:text>nombrarla</aaif:text><aaif:lemma rdf:resource="https://gams.uni-graz.at/o:aaif.lemma#nombrar" /><aaif:position rdf:datatype="http://www.w3.org/2001/XMLSchema#int">1</aaif:position><aaif:coordinated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:coordinated><aaif:partOfText rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</aaif:partOfText><aaif:syntacticConstruction rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Transitive" /></aaif:Verb><aaif:Adverb rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En1054Ph1Ad1"><aaif:text>differente</aaif:text><aaif:lemma rdf:resource="https://gams.uni-graz.at/o:aaif.lemma#diferente" /><aaif:position rdf:datatype="http://www.w3.org/2001/XMLSchema#int">2</aaif:position><aaif:coordinated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:coordinated><aaif:morphosyntacticStructure rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Adjective" /><aaif:inflection rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Uninflected" /><aaif:attributionTarget rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Verb" /><aaif:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:modified><aaif:semanticClassification rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Manner" /><aaif:reduplicated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:reduplicated><aaif:prepositionalPhrase rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:prepositionalPhrase></aaif:Adverb><aaif:Entry rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En1055"><aaif:phrase rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh#En1055Ph1" /><aaif:source rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh.bibl#Cnde9" /><gams:textualContent>opaco de la tierra, &lt;lb/&gt;y menor que éste el que a la luna cierra &lt;lb/&gt;las tres caras que muestra diferente , &lt;lb/&gt;&lt;lb/&gt;ya la vemos menguante, ya creciente, &lt;lb/&gt;ya en la sombra el eclipse nos la entierra;</gams:textualContent><rel:isPartOf rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh" /></aaif:Entry><aaif:Phrase rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En1055Ph1"><aaif:verb rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh#En1055Ph1Ve1" /><aaif:adverb rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh#En1055Ph1Ad1" /><aaif:text>las tres caras que muestra diferente </aaif:text><aaif:annoText>las tres caras que [v|muestra|mostrar|ts] [a|diferente|diferente|auvnmnnn] </aaif:annoText></aaif:Phrase><aaif:Verb rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En1055Ph1Ve1"><aaif:text>muestra</aaif:text><aaif:lemma rdf:resource="https://gams.uni-graz.at/o:aaif.lemma#mostrar" /><aaif:position rdf:datatype="http://www.w3.org/2001/XMLSchema#int">1</aaif:position><aaif:coordinated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:coordinated><aaif:partOfText rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</aaif:partOfText><aaif:syntacticConstruction rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Transitive" /></aaif:Verb><aaif:Adverb rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En1055Ph1Ad1"><aaif:text>diferente</aaif:text><aaif:lemma rdf:resource="https://gams.uni-graz.at/o:aaif.lemma#diferente" /><aaif:position rdf:datatype="http://www.w3.org/2001/XMLSchema#int">2</aaif:position><aaif:coordinated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:coordinated><aaif:morphosyntacticStructure rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Adjective" /><aaif:inflection rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Uninflected" /><aaif:attributionTarget rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Verb" /><aaif:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:modified><aaif:semanticClassification rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Manner" /><aaif:reduplicated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:reduplicated><aaif:prepositionalPhrase rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:prepositionalPhrase></aaif:Adverb><aaif:Entry rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En1056"><aaif:phrase rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh#En1056Ph1" /><aaif:source rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh.bibl#Cnde7" /><gams:textualContent>Liptote es parte de esta figura, y es cuando por palabras contrarias sin ironía sinificamos diferente , y casi siempre se hace por negaciones, y colegimos lo afirmativo; como es aquello de Virgilio:</gams:textualContent><rel:isPartOf rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh" /></aaif:Entry><aaif:Phrase rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En1056Ph1"><aaif:verb rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh#En1056Ph1Ve1" /><aaif:adverb rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh#En1056Ph1Ad1" /><aaif:text>Liptote es parte de esta figura, y es cuando por palabras contrarias sin ironía sinificamos diferente </aaif:text><aaif:annoText>Liptote es parte de esta figura, y es cuando por palabras contrarias sin ironía [v|sinificamos|significar|is] [a|diferente|diferente|auvnmnnn] </aaif:annoText></aaif:Phrase><aaif:Verb rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En1056Ph1Ve1"><aaif:text>sinificamos</aaif:text><aaif:lemma rdf:resource="https://gams.uni-graz.at/o:aaif.lemma#significar" /><aaif:position rdf:datatype="http://www.w3.org/2001/XMLSchema#int">1</aaif:position><aaif:coordinated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:coordinated><aaif:partOfText rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</aaif:partOfText><aaif:syntacticConstruction rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Intransitive" /></aaif:Verb><aaif:Adverb rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En1056Ph1Ad1"><aaif:text>diferente</aaif:text><aaif:lemma rdf:resource="https://gams.uni-graz.at/o:aaif.lemma#diferente" /><aaif:position rdf:datatype="http://www.w3.org/2001/XMLSchema#int">2</aaif:position><aaif:coordinated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:coordinated><aaif:morphosyntacticStructure rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Adjective" /><aaif:inflection rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Uninflected" /><aaif:attributionTarget rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Verb" /><aaif:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:modified><aaif:semanticClassification rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Manner" /><aaif:reduplicated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:reduplicated><aaif:prepositionalPhrase rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:prepositionalPhrase></aaif:Adverb><aaif:Entry rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En1057"><aaif:phrase rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh#En1057Ph1" /><aaif:source rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh.bibl#Cnde129" /><gams:textualContent>mundano atrevimiento, enseñando con sus escritos  la fuerza con que persuade la mentira aunque con fingidas apariencias se represente diferente de lo que es.En este libro no hay proposición sujeta a censura cristiana, ni política, ni</gams:textualContent><rel:isPartOf rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh" /></aaif:Entry><aaif:Phrase rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En1057Ph1"><aaif:subject rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh#En1057Ph1Su1" /><aaif:verb rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh#En1057Ph1Ve1" /><aaif:adverb rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh#En1057Ph1Ad1" /><aaif:text> la fuerza con que persuade la mentira aunque con fingidas apariencias se represente diferente de lo que es</aaif:text><aaif:annoText> [s|la fuerza con que persuade la mentira|fs] aunque con fingidas apariencias se [v|represente|representar|rs] [a|diferente|diferente|ausnmnnn] de lo que es</aaif:annoText></aaif:Phrase><aaif:Subject rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En1057Ph1Su1"><aaif:text>la fuerza con que persuade la mentira</aaif:text><aaif:position rdf:datatype="http://www.w3.org/2001/XMLSchema#int">1</aaif:position><aaif:gender rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Feminine" /><aaif:number rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Singular" /><aaif:overt rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</aaif:overt></aaif:Subject><aaif:Verb rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En1057Ph1Ve1"><aaif:text>represente</aaif:text><aaif:lemma rdf:resource="https://gams.uni-graz.at/o:aaif.lemma#representar" /><aaif:position rdf:datatype="http://www.w3.org/2001/XMLSchema#int">2</aaif:position><aaif:coordinated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:coordinated><aaif:partOfText rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</aaif:partOfText><aaif:syntacticConstruction rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Reflexive" /></aaif:Verb><aaif:Adverb rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En1057Ph1Ad1"><aaif:text>diferente</aaif:text><aaif:lemma rdf:resource="https://gams.uni-graz.at/o:aaif.lemma#diferente" /><aaif:position rdf:datatype="http://www.w3.org/2001/XMLSchema#int">3</aaif:position><aaif:coordinated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:coordinated><aaif:morphosyntacticStructure rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Adjective" /><aaif:inflection rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Uninflected" /><aaif:attributionTarget rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Verb" /><aaif:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:modified><aaif:semanticClassification rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Manner" /><aaif:reduplicated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:reduplicated><aaif:prepositionalPhrase rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:prepositionalPhrase></aaif:Adverb><aaif:Entry rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En1058"><aaif:phrase rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh#En1058Ph1" /><aaif:source rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh.bibl#Cnde130" /><gams:textualContent>Sol la comadre de la reina, en un machuelo, con su criado detrás.Acordóseme de mi madre, por las muchas veces que solía venir a tales horas de la misma manera.Llegamos a ella y díjola el juez: &lt;lb/&gt;- Apéese vmd.y véngase con nosotros, que le importa la vida.&lt;lb/&gt;La pobre quedó muerta cuando la bajamos del machuelo y lo entregamos al criado, diciéndole que se fuese a su casa, lo que él hizo de buena gana.&lt;lb/&gt;- Señores -dijo la comadre-, ¿dónde me llevan?&lt;lb/&gt;El juez respondió: - No tema, que no ha de recebir agravio de ninguno, sino mucho beneficio y provecho.&lt;lb/&gt;Vendámosla los ojos y quedó la pobre verdadera comadre del tacto.&lt;lb/&gt;Yo la dije: - Madre mía, aquí lleva el amparo de todas las comadres del orbe;sosiegue su espíritu y crea que la fuerza de la honra nos obliga a ser descorteses.&lt;lb/&gt;— Ya estoy en el caso —dijo ella—; entendí  diferente .Guíen donde llevaren gusto, que las mujeres de mi oficio están sujetas a semejantes fortunas.</gams:textualContent><rel:isPartOf rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh" /></aaif:Entry><aaif:Phrase rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En1058Ph1"><aaif:verb rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh#En1058Ph1Ve1" /><aaif:adverb rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh#En1058Ph1Ad1" /><aaif:text> entendí  diferente </aaif:text><aaif:annoText> [v|entendí|entender|is]  [a|diferente|diferente|auvnmnnn] </aaif:annoText></aaif:Phrase><aaif:Verb rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En1058Ph1Ve1"><aaif:text>entendí</aaif:text><aaif:lemma rdf:resource="https://gams.uni-graz.at/o:aaif.lemma#entender" /><aaif:position rdf:datatype="http://www.w3.org/2001/XMLSchema#int">1</aaif:position><aaif:coordinated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:coordinated><aaif:partOfText rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</aaif:partOfText><aaif:syntacticConstruction rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Intransitive" /></aaif:Verb><aaif:Adverb rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En1058Ph1Ad1"><aaif:text>diferente</aaif:text><aaif:lemma rdf:resource="https://gams.uni-graz.at/o:aaif.lemma#diferente" /><aaif:position rdf:datatype="http://www.w3.org/2001/XMLSchema#int">2</aaif:position><aaif:coordinated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:coordinated><aaif:morphosyntacticStructure rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Adjective" /><aaif:inflection rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Uninflected" /><aaif:attributionTarget rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Verb" /><aaif:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:modified><aaif:semanticClassification rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Manner" /><aaif:reduplicated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:reduplicated><aaif:prepositionalPhrase rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:prepositionalPhrase></aaif:Adverb><aaif:Entry rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En1059"><aaif:phrase rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh#En1059Ph1" /><aaif:source rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh.bibl#Cnde131" /><gams:textualContent>Pues Lísis, sola Lísis me contenta: &lt;lb/&gt;Ya pienso en un arroyo, dividido &lt;lb/&gt;En dos brazos que corren diferentes , &lt;lb/&gt;Cercado de menuda y fresca arena: &lt;lb/&gt;El uno lleva alegre sus corrientes &lt;lb/&gt;Por un prado de flores revestido</gams:textualContent><rel:isPartOf rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh" /></aaif:Entry><aaif:Phrase rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En1059Ph1"><aaif:verb rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh#En1059Ph1Ve1" /><aaif:adverb rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh#En1059Ph1Ad1" /><aaif:text>un arroyo, dividido &lt;lb\/&gt;En dos brazos que corren diferentes </aaif:text><aaif:annoText>un arroyo, dividido &lt;lb\/&gt;En dos brazos que [v|corren|correr|is] [a|diferentes|diferente|apsnmnnn] </aaif:annoText></aaif:Phrase><aaif:Verb rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En1059Ph1Ve1"><aaif:text>corren</aaif:text><aaif:lemma rdf:resource="https://gams.uni-graz.at/o:aaif.lemma#correr" /><aaif:position rdf:datatype="http://www.w3.org/2001/XMLSchema#int">1</aaif:position><aaif:coordinated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:coordinated><aaif:partOfText rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</aaif:partOfText><aaif:syntacticConstruction rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Intransitive" /></aaif:Verb><aaif:Adverb rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En1059Ph1Ad1"><aaif:text>diferentes</aaif:text><aaif:lemma rdf:resource="https://gams.uni-graz.at/o:aaif.lemma#diferente" /><aaif:position rdf:datatype="http://www.w3.org/2001/XMLSchema#int">2</aaif:position><aaif:coordinated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:coordinated><aaif:morphosyntacticStructure rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Adjective" /><aaif:inflection rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#MasculinePlural" /><aaif:attributionTarget rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Verb" /><aaif:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:modified><aaif:semanticClassification rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Manner" /><aaif:reduplicated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:reduplicated><aaif:prepositionalPhrase rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:prepositionalPhrase></aaif:Adverb><aaif:Entry rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En1060"><aaif:phrase rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh#En1060Ph1" /><aaif:phrase rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh#En1060Ph2" /><aaif:source rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh.bibl#Cnde45" /><gams:textualContent>— Es que a mí me gusta firmar variado . El que  firma diferente revela que es un ser original consciente y evolutivo, mientras que el estafador firma igual porque lleva dos meses imitando</gams:textualContent><rel:isPartOf rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh" /></aaif:Entry><aaif:Phrase rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En1060Ph1"><aaif:verb rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh#En1060Ph1Ve1" /><aaif:adverb rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh#En1060Ph1Ad1" /><aaif:text>Es que a mí me gusta firmar variado .</aaif:text><aaif:annoText>Es que a mí me gusta [v|firmar|firmar|is] [a|variado|variado|auvnmnnn] .</aaif:annoText></aaif:Phrase><aaif:Verb rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En1060Ph1Ve1"><aaif:text>firmar</aaif:text><aaif:lemma rdf:resource="https://gams.uni-graz.at/o:aaif.lemma#firmar" /><aaif:position rdf:datatype="http://www.w3.org/2001/XMLSchema#int">1</aaif:position><aaif:coordinated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:coordinated><aaif:partOfText rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</aaif:partOfText><aaif:syntacticConstruction rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Intransitive" /></aaif:Verb><aaif:Adverb rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En1060Ph1Ad1"><aaif:text>variado</aaif:text><aaif:lemma rdf:resource="https://gams.uni-graz.at/o:aaif.lemma#variado" /><aaif:position rdf:datatype="http://www.w3.org/2001/XMLSchema#int">2</aaif:position><aaif:coordinated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:coordinated><aaif:morphosyntacticStructure rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Adjective" /><aaif:inflection rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Uninflected" /><aaif:attributionTarget rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Verb" /><aaif:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:modified><aaif:semanticClassification rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Manner" /><aaif:reduplicated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:reduplicated><aaif:prepositionalPhrase rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:prepositionalPhrase></aaif:Adverb><aaif:Phrase rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En1060Ph2"><aaif:subject rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh#En1060Ph2Su1" /><aaif:verb rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh#En1060Ph2Ve1" /><aaif:adverb rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh#En1060Ph2Ad1" /><aaif:text> El que  firma diferente revela que es un ser original</aaif:text><aaif:annoText> [s|El que|ms]  [v|firma|firmar|is] [a|diferente|diferente|auvnmnnn] revela que es un ser original</aaif:annoText></aaif:Phrase><aaif:Subject rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En1060Ph2Su1"><aaif:text>El que</aaif:text><aaif:position rdf:datatype="http://www.w3.org/2001/XMLSchema#int">1</aaif:position><aaif:gender rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Masculine" /><aaif:number rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Singular" /><aaif:overt rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</aaif:overt></aaif:Subject><aaif:Verb rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En1060Ph2Ve1"><aaif:text>firma</aaif:text><aaif:lemma rdf:resource="https://gams.uni-graz.at/o:aaif.lemma#firmar" /><aaif:position rdf:datatype="http://www.w3.org/2001/XMLSchema#int">2</aaif:position><aaif:coordinated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:coordinated><aaif:partOfText rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</aaif:partOfText><aaif:syntacticConstruction rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Intransitive" /></aaif:Verb><aaif:Adverb rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En1060Ph2Ad1"><aaif:text>diferente</aaif:text><aaif:lemma rdf:resource="https://gams.uni-graz.at/o:aaif.lemma#diferente" /><aaif:position rdf:datatype="http://www.w3.org/2001/XMLSchema#int">3</aaif:position><aaif:coordinated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:coordinated><aaif:morphosyntacticStructure rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Adjective" /><aaif:inflection rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Uninflected" /><aaif:attributionTarget rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Verb" /><aaif:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:modified><aaif:semanticClassification rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Manner" /><aaif:reduplicated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:reduplicated><aaif:prepositionalPhrase rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:prepositionalPhrase></aaif:Adverb><aaif:Entry rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En1061"><aaif:phrase rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh#En1061Ph1" /><aaif:source rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh.bibl#Cnde132" /><gams:textualContent>que tu sudor, tu saliva y tus lágrimas apestaban a vinagre, te compré vinagres distintos para que cuando menos huelas diferente cada día —le dije—.Te traje un litro de vinagre de manzana, otro de vinagre de</gams:textualContent><rel:isPartOf rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh" /></aaif:Entry><aaif:Phrase rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En1061Ph1"><aaif:verb rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh#En1061Ph1Ve1" /><aaif:adverb rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh#En1061Ph1Ad1" /><aaif:text>para que cuando menos huelas diferente cada día</aaif:text><aaif:annoText>para que cuando menos [v|huelas|oler|is] [a|diferente|diferente|auvnmnnn] cada día</aaif:annoText></aaif:Phrase><aaif:Verb rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En1061Ph1Ve1"><aaif:text>huelas</aaif:text><aaif:lemma rdf:resource="https://gams.uni-graz.at/o:aaif.lemma#oler" /><aaif:position rdf:datatype="http://www.w3.org/2001/XMLSchema#int">1</aaif:position><aaif:coordinated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:coordinated><aaif:partOfText rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</aaif:partOfText><aaif:syntacticConstruction rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Intransitive" /></aaif:Verb><aaif:Adverb rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En1061Ph1Ad1"><aaif:text>diferente</aaif:text><aaif:lemma rdf:resource="https://gams.uni-graz.at/o:aaif.lemma#diferente" /><aaif:position rdf:datatype="http://www.w3.org/2001/XMLSchema#int">2</aaif:position><aaif:coordinated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:coordinated><aaif:morphosyntacticStructure rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Adjective" /><aaif:inflection rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Uninflected" /><aaif:attributionTarget rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Verb" /><aaif:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:modified><aaif:semanticClassification rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Manner" /><aaif:reduplicated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:reduplicated><aaif:prepositionalPhrase rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:prepositionalPhrase></aaif:Adverb><aaif:Entry rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En1062"><aaif:phrase rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh#En1062Ph1" /><aaif:source rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh.bibl#Cnde3" /><gams:textualContent>que si el gobierno del doctor Betancur ha tenido esta orientación, tendrán que venir  otros gobiernos que piensen diferente , que defiendan la democracia como se defiende en Inglaterra, como se defiende en los Estados Unidos.Pero si </gams:textualContent><rel:isPartOf rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh" /></aaif:Entry><aaif:Phrase rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En1062Ph1"><aaif:subject rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh#En1062Ph1Su1" /><aaif:verb rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh#En1062Ph1Ve1" /><aaif:adverb rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh#En1062Ph1Ad1" /><aaif:text> otros gobiernos que piensen diferente </aaif:text><aaif:annoText> [s|otros gobiernos|mp] que [v|piensen|pensar|is] [a|diferente|diferente|auvnmnnn] </aaif:annoText></aaif:Phrase><aaif:Subject rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En1062Ph1Su1"><aaif:text>otros gobiernos</aaif:text><aaif:position rdf:datatype="http://www.w3.org/2001/XMLSchema#int">1</aaif:position><aaif:gender rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Masculine" /><aaif:number rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Plural" /><aaif:overt rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</aaif:overt></aaif:Subject><aaif:Verb rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En1062Ph1Ve1"><aaif:text>piensen</aaif:text><aaif:lemma rdf:resource="https://gams.uni-graz.at/o:aaif.lemma#pensar" /><aaif:position rdf:datatype="http://www.w3.org/2001/XMLSchema#int">2</aaif:position><aaif:coordinated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:coordinated><aaif:partOfText rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</aaif:partOfText><aaif:syntacticConstruction rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Intransitive" /></aaif:Verb><aaif:Adverb rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En1062Ph1Ad1"><aaif:text>diferente</aaif:text><aaif:lemma rdf:resource="https://gams.uni-graz.at/o:aaif.lemma#diferente" /><aaif:position rdf:datatype="http://www.w3.org/2001/XMLSchema#int">3</aaif:position><aaif:coordinated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:coordinated><aaif:morphosyntacticStructure rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Adjective" /><aaif:inflection rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Uninflected" /><aaif:attributionTarget rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Verb" /><aaif:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:modified><aaif:semanticClassification rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Manner" /><aaif:reduplicated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:reduplicated><aaif:prepositionalPhrase rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:prepositionalPhrase></aaif:Adverb><aaif:Entry rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En1063"><aaif:phrase rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh#En1063Ph1" /><aaif:source rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh.bibl#Cnde67" /><gams:textualContent>en punto Mariestela se tensa.Pero es el alma que está tetanizada.Cambia de posición, se enrosca diferente .</gams:textualContent><rel:isPartOf rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh" /></aaif:Entry><aaif:Phrase rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En1063Ph1"><aaif:verb rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh#En1063Ph1Ve1" /><aaif:adverb rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh#En1063Ph1Ad1" /><aaif:text>se enrosca diferente </aaif:text><aaif:annoText>se [v|enrosca|enroscar|rs] [a|diferente|diferente|auvnmnnn] </aaif:annoText></aaif:Phrase><aaif:Verb rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En1063Ph1Ve1"><aaif:text>enrosca</aaif:text><aaif:lemma rdf:resource="https://gams.uni-graz.at/o:aaif.lemma#enroscar" /><aaif:position rdf:datatype="http://www.w3.org/2001/XMLSchema#int">1</aaif:position><aaif:coordinated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:coordinated><aaif:partOfText rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</aaif:partOfText><aaif:syntacticConstruction rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Reflexive" /></aaif:Verb><aaif:Adverb rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En1063Ph1Ad1"><aaif:text>diferente</aaif:text><aaif:lemma rdf:resource="https://gams.uni-graz.at/o:aaif.lemma#diferente" /><aaif:position rdf:datatype="http://www.w3.org/2001/XMLSchema#int">2</aaif:position><aaif:coordinated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:coordinated><aaif:morphosyntacticStructure rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Adjective" /><aaif:inflection rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Uninflected" /><aaif:attributionTarget rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Verb" /><aaif:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:modified><aaif:semanticClassification rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Manner" /><aaif:reduplicated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:reduplicated><aaif:prepositionalPhrase rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:prepositionalPhrase></aaif:Adverb><aaif:Entry rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En1064"><aaif:phrase rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh#En1064Ph1" /><aaif:source rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh.bibl#Cnde133" /><gams:textualContent> Sabían  diferente cuando no se veían.Más suaves, distintos.Las cosas eran otras; no sólo era que no </gams:textualContent><rel:isPartOf rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh" /></aaif:Entry><aaif:Phrase rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En1064Ph1"><aaif:verb rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh#En1064Ph1Ve1" /><aaif:adverb rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh#En1064Ph1Ad1" /><aaif:text> Sabían  diferente cuando no se veían</aaif:text><aaif:annoText> [v|Sabían|saber|is]  [a|diferente|diferente|auvnmnnn] cuando no se veían</aaif:annoText></aaif:Phrase><aaif:Verb rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En1064Ph1Ve1"><aaif:text>Sabían</aaif:text><aaif:lemma rdf:resource="https://gams.uni-graz.at/o:aaif.lemma#saber" /><aaif:position rdf:datatype="http://www.w3.org/2001/XMLSchema#int">1</aaif:position><aaif:coordinated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:coordinated><aaif:partOfText rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</aaif:partOfText><aaif:syntacticConstruction rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Intransitive" /></aaif:Verb><aaif:Adverb rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En1064Ph1Ad1"><aaif:text>diferente</aaif:text><aaif:lemma rdf:resource="https://gams.uni-graz.at/o:aaif.lemma#diferente" /><aaif:position rdf:datatype="http://www.w3.org/2001/XMLSchema#int">2</aaif:position><aaif:coordinated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:coordinated><aaif:morphosyntacticStructure rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Adjective" /><aaif:inflection rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Uninflected" /><aaif:attributionTarget rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Verb" /><aaif:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:modified><aaif:semanticClassification rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Manner" /><aaif:reduplicated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:reduplicated><aaif:prepositionalPhrase rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:prepositionalPhrase></aaif:Adverb><aaif:Entry rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En1065"><aaif:phrase rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh#En1065Ph1" /><aaif:source rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh.bibl#Cnde134" /><gams:textualContent>— Necesito esa rana — mi propia voz  sonaba diferente —.Diles que consigo la rana y me voy.</gams:textualContent><rel:isPartOf rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh" /></aaif:Entry><aaif:Phrase rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En1065Ph1"><aaif:subject rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh#En1065Ph1Su1" /><aaif:verb rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh#En1065Ph1Ve1" /><aaif:adverb rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh#En1065Ph1Ad1" /><aaif:text> mi propia voz  sonaba diferente </aaif:text><aaif:annoText> [s|mi propia voz|fs]  [v|sonaba|sonar|is] [a|diferente|diferente|auvnmnnn] </aaif:annoText></aaif:Phrase><aaif:Subject rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En1065Ph1Su1"><aaif:text>mi propia voz</aaif:text><aaif:position rdf:datatype="http://www.w3.org/2001/XMLSchema#int">1</aaif:position><aaif:gender rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Feminine" /><aaif:number rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Singular" /><aaif:overt rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</aaif:overt></aaif:Subject><aaif:Verb rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En1065Ph1Ve1"><aaif:text>sonaba</aaif:text><aaif:lemma rdf:resource="https://gams.uni-graz.at/o:aaif.lemma#sonar" /><aaif:position rdf:datatype="http://www.w3.org/2001/XMLSchema#int">2</aaif:position><aaif:coordinated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:coordinated><aaif:partOfText rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</aaif:partOfText><aaif:syntacticConstruction rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Intransitive" /></aaif:Verb><aaif:Adverb rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En1065Ph1Ad1"><aaif:text>diferente</aaif:text><aaif:lemma rdf:resource="https://gams.uni-graz.at/o:aaif.lemma#diferente" /><aaif:position rdf:datatype="http://www.w3.org/2001/XMLSchema#int">3</aaif:position><aaif:coordinated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:coordinated><aaif:morphosyntacticStructure rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Adjective" /><aaif:inflection rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Uninflected" /><aaif:attributionTarget rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Verb" /><aaif:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:modified><aaif:semanticClassification rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Manner" /><aaif:reduplicated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:reduplicated><aaif:prepositionalPhrase rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:prepositionalPhrase></aaif:Adverb><aaif:Entry rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En1066"><aaif:phrase rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh#En1066Ph1" /><aaif:source rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh.bibl#Cnde81" /><gams:textualContent>frase muy estadounidense de «Gracias a Dios que es viernes».La gente se nota feliz. Visten  diferente , ríen diferente  y hasta el ruido del viernes parece diferente, es distinto al ruido de lunes </gams:textualContent><rel:isPartOf rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh" /></aaif:Entry><aaif:Phrase rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En1066Ph1"><aaif:verb rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh#En1066Ph1Ve1" /><aaif:verb rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh#En1066Ph1Ve2" /><aaif:adverb rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh#En1066Ph1Ad1" /><aaif:adverb rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh#En1066Ph1Ad2" /><aaif:text> Visten  diferente , ríen diferente </aaif:text><aaif:annoText> [v|Visten|vestir|is]  [a|diferente|diferente|auvnmnnn] , [v|ríen|reír|is] [a|diferente|diferente|auvnmnnn] </aaif:annoText></aaif:Phrase><aaif:Verb rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En1066Ph1Ve1"><aaif:text>Visten</aaif:text><aaif:lemma rdf:resource="https://gams.uni-graz.at/o:aaif.lemma#vestir" /><aaif:position rdf:datatype="http://www.w3.org/2001/XMLSchema#int">1</aaif:position><aaif:coordinated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:coordinated><aaif:partOfText rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</aaif:partOfText><aaif:syntacticConstruction rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Intransitive" /></aaif:Verb><aaif:Verb rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En1066Ph1Ve2"><aaif:text>ríen</aaif:text><aaif:lemma rdf:resource="https://gams.uni-graz.at/o:aaif.lemma#reír" /><aaif:position rdf:datatype="http://www.w3.org/2001/XMLSchema#int">3</aaif:position><aaif:coordinated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:coordinated><aaif:partOfText rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</aaif:partOfText><aaif:syntacticConstruction rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Intransitive" /></aaif:Verb><aaif:Adverb rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En1066Ph1Ad1"><aaif:text>diferente</aaif:text><aaif:lemma rdf:resource="https://gams.uni-graz.at/o:aaif.lemma#diferente" /><aaif:position rdf:datatype="http://www.w3.org/2001/XMLSchema#int">2</aaif:position><aaif:coordinated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:coordinated><aaif:morphosyntacticStructure rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Adjective" /><aaif:inflection rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Uninflected" /><aaif:attributionTarget rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Verb" /><aaif:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:modified><aaif:semanticClassification rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Manner" /><aaif:reduplicated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:reduplicated><aaif:prepositionalPhrase rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:prepositionalPhrase></aaif:Adverb><aaif:Adverb rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En1066Ph1Ad2"><aaif:text>diferente</aaif:text><aaif:lemma rdf:resource="https://gams.uni-graz.at/o:aaif.lemma#diferente" /><aaif:position rdf:datatype="http://www.w3.org/2001/XMLSchema#int">4</aaif:position><aaif:coordinated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:coordinated><aaif:morphosyntacticStructure rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Adjective" /><aaif:inflection rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Uninflected" /><aaif:attributionTarget rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Verb" /><aaif:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:modified><aaif:semanticClassification rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Manner" /><aaif:reduplicated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:reduplicated><aaif:prepositionalPhrase rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:prepositionalPhrase></aaif:Adverb><aaif:Entry rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En1067"><aaif:phrase rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh#En1067Ph1" /><aaif:source rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh.bibl#Cnde135" /><gams:textualContent>Salió llevándose el instrumento.El niño, entonces, se puso a silbar la melodía; sonaba diferente , pero atrajo a las aves que por allí revoloteaban.Llegaban en silencio y se posaban en el suelo, </gams:textualContent><rel:isPartOf rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh" /></aaif:Entry><aaif:Phrase rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En1067Ph1"><aaif:verb rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh#En1067Ph1Ve1" /><aaif:adverb rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh#En1067Ph1Ad1" /><aaif:text>El niño, entonces, se puso a silbar la melodía; sonaba diferente </aaif:text><aaif:annoText>El niño, entonces, se puso a silbar la melodía; [v|sonaba|sonar|is] [a|diferente|diferente|auvnmnnn] </aaif:annoText></aaif:Phrase><aaif:Verb rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En1067Ph1Ve1"><aaif:text>sonaba</aaif:text><aaif:lemma rdf:resource="https://gams.uni-graz.at/o:aaif.lemma#sonar" /><aaif:position rdf:datatype="http://www.w3.org/2001/XMLSchema#int">1</aaif:position><aaif:coordinated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:coordinated><aaif:partOfText rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</aaif:partOfText><aaif:syntacticConstruction rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Intransitive" /></aaif:Verb><aaif:Adverb rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En1067Ph1Ad1"><aaif:text>diferente</aaif:text><aaif:lemma rdf:resource="https://gams.uni-graz.at/o:aaif.lemma#diferente" /><aaif:position rdf:datatype="http://www.w3.org/2001/XMLSchema#int">2</aaif:position><aaif:coordinated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:coordinated><aaif:morphosyntacticStructure rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Adjective" /><aaif:inflection rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Uninflected" /><aaif:attributionTarget rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Verb" /><aaif:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:modified><aaif:semanticClassification rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Manner" /><aaif:reduplicated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:reduplicated><aaif:prepositionalPhrase rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:prepositionalPhrase></aaif:Adverb><aaif:Entry rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En1068"><aaif:phrase rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh#En1068Ph1" /><aaif:source rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh.bibl#Cnde136" /><gams:textualContent>viviendo en un lugar con tanta leyenda ayuda.Cuando dices que estudias en Berkeley, la gente te mira diferente .</gams:textualContent><rel:isPartOf rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh" /></aaif:Entry><aaif:Phrase rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En1068Ph1"><aaif:subject rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh#En1068Ph1Su1" /><aaif:verb rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh#En1068Ph1Ve1" /><aaif:adverb rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh#En1068Ph1Ad1" /><aaif:text>Cuando dices que estudias en Berkeley, la gente te mira diferente .</aaif:text><aaif:annoText>Cuando dices que estudias en Berkeley, [s|la gente|fs] te [v|mira|mirar|ts] [a|diferente|diferente|auvnmnnn] .</aaif:annoText></aaif:Phrase><aaif:Subject rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En1068Ph1Su1"><aaif:text>la gente</aaif:text><aaif:position rdf:datatype="http://www.w3.org/2001/XMLSchema#int">1</aaif:position><aaif:gender rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Feminine" /><aaif:number rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Singular" /><aaif:overt rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</aaif:overt></aaif:Subject><aaif:Verb rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En1068Ph1Ve1"><aaif:text>mira</aaif:text><aaif:lemma rdf:resource="https://gams.uni-graz.at/o:aaif.lemma#mirar" /><aaif:position rdf:datatype="http://www.w3.org/2001/XMLSchema#int">2</aaif:position><aaif:coordinated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:coordinated><aaif:partOfText rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</aaif:partOfText><aaif:syntacticConstruction rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Transitive" /></aaif:Verb><aaif:Adverb rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En1068Ph1Ad1"><aaif:text>diferente</aaif:text><aaif:lemma rdf:resource="https://gams.uni-graz.at/o:aaif.lemma#diferente" /><aaif:position rdf:datatype="http://www.w3.org/2001/XMLSchema#int">3</aaif:position><aaif:coordinated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:coordinated><aaif:morphosyntacticStructure rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Adjective" /><aaif:inflection rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Uninflected" /><aaif:attributionTarget rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Verb" /><aaif:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:modified><aaif:semanticClassification rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Manner" /><aaif:reduplicated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:reduplicated><aaif:prepositionalPhrase rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:prepositionalPhrase></aaif:Adverb><aaif:Entry rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En1069"><aaif:phrase rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh#En1069Ph1" /><aaif:source rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh.bibl#Cnde127" /><gams:textualContent>Excelso monte, cuya verde cumbre &lt;lb/&gt; pisó  difícil  poca planta humana , &lt;lb/&gt;aunque fuera mejor que fuera llana &lt;lb/&gt;para subir con menos pesadumbre.</gams:textualContent><rel:isPartOf rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh" /></aaif:Entry><aaif:Phrase rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En1069Ph1"><aaif:subject rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh#En1069Ph1Su1" /><aaif:verb rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh#En1069Ph1Ve1" /><aaif:adverb rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh#En1069Ph1Ad1" /><aaif:text>Excelso monte, cuya verde cumbre &lt;lb\/&gt; pisó  difícil  poca planta humana </aaif:text><aaif:annoText>Excelso monte, cuya verde cumbre &lt;lb\/&gt; [v|pisó|pisar|ts]  [a|difícil|difícil|auvnmnnn]  [s|poca planta humana|fs] </aaif:annoText></aaif:Phrase><aaif:Subject rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En1069Ph1Su1"><aaif:text>poca planta humana</aaif:text><aaif:position rdf:datatype="http://www.w3.org/2001/XMLSchema#int">3</aaif:position><aaif:gender rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Feminine" /><aaif:number rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Singular" /><aaif:overt rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</aaif:overt></aaif:Subject><aaif:Verb rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En1069Ph1Ve1"><aaif:text>pisó</aaif:text><aaif:lemma rdf:resource="https://gams.uni-graz.at/o:aaif.lemma#pisar" /><aaif:position rdf:datatype="http://www.w3.org/2001/XMLSchema#int">1</aaif:position><aaif:coordinated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:coordinated><aaif:partOfText rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</aaif:partOfText><aaif:syntacticConstruction rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Transitive" /></aaif:Verb><aaif:Adverb rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En1069Ph1Ad1"><aaif:text>difícil</aaif:text><aaif:lemma rdf:resource="https://gams.uni-graz.at/o:aaif.lemma#difícil" /><aaif:position rdf:datatype="http://www.w3.org/2001/XMLSchema#int">2</aaif:position><aaif:coordinated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:coordinated><aaif:morphosyntacticStructure rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Adjective" /><aaif:inflection rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Uninflected" /><aaif:attributionTarget rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Verb" /><aaif:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:modified><aaif:semanticClassification rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Manner" /><aaif:reduplicated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:reduplicated><aaif:prepositionalPhrase rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:prepositionalPhrase></aaif:Adverb><aaif:Entry rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En1070"><aaif:phrase rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh#En1070Ph1" /><aaif:source rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh.bibl#Cnde107" /><gams:textualContent>suelo, &lt;lb/&gt;contemplar la verdad pura sin duelo?&lt;lb/&gt;Allí a mi vida junto, &lt;lb/&gt;en luz resplandeciente convertido, &lt;lb/&gt; veré  distinto y junto &lt;lb/&gt;lo que es y lo que ha sido, &lt;lb/&gt;y su principio propio y ascondido.&lt;lb/&gt;Entonces veré</gams:textualContent><rel:isPartOf rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh" /></aaif:Entry><aaif:Phrase rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En1070Ph1"><aaif:verb rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh#En1070Ph1Ve1" /><aaif:adverb rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh#En1070Ph1Ad1" /><aaif:adverb rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh#En1070Ph1Ad2" /><aaif:text> veré  distinto y junto &lt;lb\/&gt;lo que es y lo que ha sido</aaif:text><aaif:annoText> [v|veré|ver|ts]  [a|distinto|distinto|auonmnnC] y [a|junto|junto|auonmnnC] &lt;lb\/&gt;lo que es y lo que ha sido</aaif:annoText></aaif:Phrase><aaif:Verb rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En1070Ph1Ve1"><aaif:text>veré</aaif:text><aaif:lemma rdf:resource="https://gams.uni-graz.at/o:aaif.lemma#ver" /><aaif:position rdf:datatype="http://www.w3.org/2001/XMLSchema#int">1</aaif:position><aaif:coordinated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:coordinated><aaif:partOfText rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</aaif:partOfText><aaif:syntacticConstruction rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Transitive" /></aaif:Verb><aaif:Adverb rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En1070Ph1Ad1"><aaif:text>distinto</aaif:text><aaif:lemma rdf:resource="https://gams.uni-graz.at/o:aaif.lemma#distinto" /><aaif:position rdf:datatype="http://www.w3.org/2001/XMLSchema#int">2</aaif:position><aaif:coordinated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</aaif:coordinated><aaif:morphosyntacticStructure rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Adjective" /><aaif:inflection rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Uninflected" /><aaif:attributionTarget rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#VerbObject" /><aaif:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:modified><aaif:semanticClassification rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Manner" /><aaif:reduplicated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:reduplicated><aaif:prepositionalPhrase rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:prepositionalPhrase></aaif:Adverb><aaif:Adverb rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En1070Ph1Ad2"><aaif:text>junto</aaif:text><aaif:lemma rdf:resource="https://gams.uni-graz.at/o:aaif.lemma#junto" /><aaif:position rdf:datatype="http://www.w3.org/2001/XMLSchema#int">3</aaif:position><aaif:coordinated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</aaif:coordinated><aaif:morphosyntacticStructure rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Adjective" /><aaif:inflection rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Uninflected" /><aaif:attributionTarget rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#VerbObject" /><aaif:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:modified><aaif:semanticClassification rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Manner" /><aaif:reduplicated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:reduplicated><aaif:prepositionalPhrase rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:prepositionalPhrase></aaif:Adverb><aaif:Entry rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En1071"><aaif:phrase rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh#En1071Ph1" /><aaif:source rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh.bibl#Cnde108" /><gams:textualContent>no tuviera;&lt;lb/&gt;no hubiera el general gobierno hallado, &lt;lb/&gt;y los consejos fáciles perdiera, &lt;lb/&gt;con que el vivir distinto en orden tiene &lt;lb/&gt;y a ser en fin comunicable viene.&lt;lb/&gt;Perderíase el fruto de la ciencia, &lt;lb/&gt;de las conversaciones la</gams:textualContent><rel:isPartOf rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh" /></aaif:Entry><aaif:Phrase rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En1071Ph1"><aaif:verb rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh#En1071Ph1Ve1" /><aaif:adverb rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh#En1071Ph1Ad1" /><aaif:text>el vivir distinto en orden tiene</aaif:text><aaif:annoText>el [v|vivir|vivir|is] [a|distinto|distinto|auvnmnnn] en orden tiene</aaif:annoText></aaif:Phrase><aaif:Verb rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En1071Ph1Ve1"><aaif:text>vivir</aaif:text><aaif:lemma rdf:resource="https://gams.uni-graz.at/o:aaif.lemma#vivir" /><aaif:position rdf:datatype="http://www.w3.org/2001/XMLSchema#int">1</aaif:position><aaif:coordinated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:coordinated><aaif:partOfText rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</aaif:partOfText><aaif:syntacticConstruction rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Intransitive" /></aaif:Verb><aaif:Adverb rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En1071Ph1Ad1"><aaif:text>distinto</aaif:text><aaif:lemma rdf:resource="https://gams.uni-graz.at/o:aaif.lemma#distinto" /><aaif:position rdf:datatype="http://www.w3.org/2001/XMLSchema#int">2</aaif:position><aaif:coordinated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:coordinated><aaif:morphosyntacticStructure rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Adjective" /><aaif:inflection rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Uninflected" /><aaif:attributionTarget rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Verb" /><aaif:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:modified><aaif:semanticClassification rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Manner" /><aaif:reduplicated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:reduplicated><aaif:prepositionalPhrase rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:prepositionalPhrase></aaif:Adverb><aaif:Entry rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En1072"><aaif:phrase rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh#En1072Ph1" /><aaif:source rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh.bibl#Cnde109" /><gams:textualContent>sol y el arquitecto &lt;lb/&gt;dueño del maquinoso Laberinto &lt;lb/&gt;vieron sus hijos con dañoso efecto &lt;lb/&gt;lugar, cayendo, eternizar distinto ;&lt;lb/&gt;pues yo, que a tanto amor guardé respeto, &lt;lb/&gt;hacerle pienso que al dorado cinto</gams:textualContent><rel:isPartOf rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh" /></aaif:Entry><aaif:Phrase rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En1072Ph1"><aaif:verb rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh#En1072Ph1Ve1" /><aaif:adverb rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh#En1072Ph1Ad1" /><aaif:text>vieron sus hijos con dañoso efecto &lt;lb\/&gt;lugar, cayendo, eternizar distinto </aaif:text><aaif:annoText>vieron sus hijos con dañoso efecto &lt;lb\/&gt;lugar, cayendo, [v|eternizar|eternizar|is] [a|distinto|distinto|auvnmnnn] </aaif:annoText></aaif:Phrase><aaif:Verb rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En1072Ph1Ve1"><aaif:text>eternizar</aaif:text><aaif:lemma rdf:resource="https://gams.uni-graz.at/o:aaif.lemma#eternizar" /><aaif:position rdf:datatype="http://www.w3.org/2001/XMLSchema#int">1</aaif:position><aaif:coordinated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:coordinated><aaif:partOfText rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</aaif:partOfText><aaif:syntacticConstruction rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Intransitive" /></aaif:Verb><aaif:Adverb rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En1072Ph1Ad1"><aaif:text>distinto</aaif:text><aaif:lemma rdf:resource="https://gams.uni-graz.at/o:aaif.lemma#distinto" /><aaif:position rdf:datatype="http://www.w3.org/2001/XMLSchema#int">2</aaif:position><aaif:coordinated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:coordinated><aaif:morphosyntacticStructure rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Adjective" /><aaif:inflection rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Uninflected" /><aaif:attributionTarget rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Verb" /><aaif:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:modified><aaif:semanticClassification rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Manner" /><aaif:reduplicated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:reduplicated><aaif:prepositionalPhrase rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:prepositionalPhrase></aaif:Adverb><aaif:Entry rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En1073"><aaif:phrase rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh#En1073Ph1" /><aaif:source rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh.bibl#Cnde110" /><gams:textualContent>abundancia es justo, &lt;lb/&gt;no es parto del poder sino del gusto.&lt;lb/&gt;Siete veces el sol miró distinta &lt;lb/&gt;la línea equinoccial, y a los iguales &lt;lb/&gt;trópicos, declinando el áurea cinta, &lt;lb/&gt;los ilustró de rayos solsticiales</gams:textualContent><rel:isPartOf rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh" /></aaif:Entry><aaif:Phrase rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En1073Ph1"><aaif:subject rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh#En1073Ph1Su1" /><aaif:verb rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh#En1073Ph1Ve1" /><aaif:adverb rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh#En1073Ph1Ad1" /><aaif:text>Siete veces el sol miró distinta &lt;lb\/&gt;la línea equinoccial</aaif:text><aaif:annoText>Siete veces [s|el sol|ms] [v|miró|mirar|ts] [a|distinta|distinto|afonmnnn] &lt;lb\/&gt;la línea equinoccial</aaif:annoText></aaif:Phrase><aaif:Subject rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En1073Ph1Su1"><aaif:text>el sol</aaif:text><aaif:position rdf:datatype="http://www.w3.org/2001/XMLSchema#int">1</aaif:position><aaif:gender rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Masculine" /><aaif:number rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Singular" /><aaif:overt rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</aaif:overt></aaif:Subject><aaif:Verb rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En1073Ph1Ve1"><aaif:text>miró</aaif:text><aaif:lemma rdf:resource="https://gams.uni-graz.at/o:aaif.lemma#mirar" /><aaif:position rdf:datatype="http://www.w3.org/2001/XMLSchema#int">2</aaif:position><aaif:coordinated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:coordinated><aaif:partOfText rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</aaif:partOfText><aaif:syntacticConstruction rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Transitive" /></aaif:Verb><aaif:Adverb rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En1073Ph1Ad1"><aaif:text>distinta</aaif:text><aaif:lemma rdf:resource="https://gams.uni-graz.at/o:aaif.lemma#distinto" /><aaif:position rdf:datatype="http://www.w3.org/2001/XMLSchema#int">3</aaif:position><aaif:coordinated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:coordinated><aaif:morphosyntacticStructure rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Adjective" /><aaif:inflection rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#FeminineSingular" /><aaif:attributionTarget rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#VerbObject" /><aaif:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:modified><aaif:semanticClassification rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Manner" /><aaif:reduplicated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:reduplicated><aaif:prepositionalPhrase rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:prepositionalPhrase></aaif:Adverb><aaif:Entry rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En1074"><aaif:phrase rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh#En1074Ph1" /><aaif:source rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh.bibl#Cnde111" /><gams:textualContent>verían en el cielo estrellas que jamás se habían visto y que sin él no podrían verse;que advertirían distintas y claras las manchas que en la cara de la luna se mienten ojos y boca y en el cerco</gams:textualContent><rel:isPartOf rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh" /></aaif:Entry><aaif:Phrase rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En1074Ph1"><aaif:verb rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh#En1074Ph1Ve1" /><aaif:adverb rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh#En1074Ph1Ad1" /><aaif:adverb rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh#En1074Ph1Ad2" /><aaif:text>que advertirían distintas y claras las manchas</aaif:text><aaif:annoText>que [v|advertirían|advertir|ts] [a|distintas|distinto|axonmnnC] y [a|claras|claro|axonmnnC] las manchas</aaif:annoText></aaif:Phrase><aaif:Verb rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En1074Ph1Ve1"><aaif:text>advertirían</aaif:text><aaif:lemma rdf:resource="https://gams.uni-graz.at/o:aaif.lemma#advertir" /><aaif:position rdf:datatype="http://www.w3.org/2001/XMLSchema#int">1</aaif:position><aaif:coordinated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:coordinated><aaif:partOfText rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</aaif:partOfText><aaif:syntacticConstruction rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Transitive" /></aaif:Verb><aaif:Adverb rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En1074Ph1Ad1"><aaif:text>distintas</aaif:text><aaif:lemma rdf:resource="https://gams.uni-graz.at/o:aaif.lemma#distinto" /><aaif:position rdf:datatype="http://www.w3.org/2001/XMLSchema#int">2</aaif:position><aaif:coordinated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</aaif:coordinated><aaif:morphosyntacticStructure rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Adjective" /><aaif:inflection rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#FemininePlural" /><aaif:attributionTarget rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#VerbObject" /><aaif:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:modified><aaif:semanticClassification rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Manner" /><aaif:reduplicated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:reduplicated><aaif:prepositionalPhrase rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:prepositionalPhrase></aaif:Adverb><aaif:Adverb rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En1074Ph1Ad2"><aaif:text>claras</aaif:text><aaif:lemma rdf:resource="https://gams.uni-graz.at/o:aaif.lemma#claro" /><aaif:position rdf:datatype="http://www.w3.org/2001/XMLSchema#int">3</aaif:position><aaif:coordinated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</aaif:coordinated><aaif:morphosyntacticStructure rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Adjective" /><aaif:inflection rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#FemininePlural" /><aaif:attributionTarget rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#VerbObject" /><aaif:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:modified><aaif:semanticClassification rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Manner" /><aaif:reduplicated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:reduplicated><aaif:prepositionalPhrase rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:prepositionalPhrase></aaif:Adverb><aaif:Entry rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En1075"><aaif:phrase rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh#En1075Ph1" /><aaif:source rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh.bibl#Cnde112" /><gams:textualContent>que ya tenía hedad, le transformó en sol, para govierno deste mundo, que empezó á fabricar distinto del suyo;hizo el cielo en que tuuiesse su assiento perpétuo, y la fábrica de la tierra</gams:textualContent><rel:isPartOf rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh" /></aaif:Entry><aaif:Phrase rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En1075Ph1"><aaif:verb rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh#En1075Ph1Ve1" /><aaif:adverb rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh#En1075Ph1Ad1" /><aaif:text>govierno deste mundo, que empezó á fabricar distinto del suyo</aaif:text><aaif:annoText>govierno deste mundo, que empezó á [v|fabricar|fabricar|ts] [a|distinto|distinto|auvnmnnn] del suyo</aaif:annoText></aaif:Phrase><aaif:Verb rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En1075Ph1Ve1"><aaif:text>fabricar</aaif:text><aaif:lemma rdf:resource="https://gams.uni-graz.at/o:aaif.lemma#fabricar" /><aaif:position rdf:datatype="http://www.w3.org/2001/XMLSchema#int">1</aaif:position><aaif:coordinated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:coordinated><aaif:partOfText rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</aaif:partOfText><aaif:syntacticConstruction rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Transitive" /></aaif:Verb><aaif:Adverb rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En1075Ph1Ad1"><aaif:text>distinto</aaif:text><aaif:lemma rdf:resource="https://gams.uni-graz.at/o:aaif.lemma#distinto" /><aaif:position rdf:datatype="http://www.w3.org/2001/XMLSchema#int">2</aaif:position><aaif:coordinated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:coordinated><aaif:morphosyntacticStructure rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Adjective" /><aaif:inflection rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Uninflected" /><aaif:attributionTarget rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Verb" /><aaif:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:modified><aaif:semanticClassification rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Manner" /><aaif:reduplicated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:reduplicated><aaif:prepositionalPhrase rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:prepositionalPhrase></aaif:Adverb><aaif:Entry rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En1076"><aaif:phrase rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh#En1076Ph1" /><aaif:source rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh.bibl#Cnde113" /><gams:textualContent>misma cosa.Usted se enamora de una mujer y la ve con ojos de amor, y la ve distinta de como la ve todo el mundo.El mundo, es decir, la gente indiferente, ve la</gams:textualContent><rel:isPartOf rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh" /></aaif:Entry><aaif:Phrase rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En1076Ph1"><aaif:verb rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh#En1076Ph1Ve1" /><aaif:adverb rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh#En1076Ph1Ad1" /><aaif:text>Usted se enamora de una mujer y la ve con ojos de amor, y la ve distinta de como la ve todo el mundo</aaif:text><aaif:annoText>Usted se enamora de una mujer y la ve con ojos de amor, y la [v|ve|ver|ts] [a|distinta|distinto|afonmnnn] de como la ve todo el mundo</aaif:annoText></aaif:Phrase><aaif:Verb rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En1076Ph1Ve1"><aaif:text>ve</aaif:text><aaif:lemma rdf:resource="https://gams.uni-graz.at/o:aaif.lemma#ver" /><aaif:position rdf:datatype="http://www.w3.org/2001/XMLSchema#int">1</aaif:position><aaif:coordinated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:coordinated><aaif:partOfText rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</aaif:partOfText><aaif:syntacticConstruction rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Transitive" /></aaif:Verb><aaif:Adverb rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En1076Ph1Ad1"><aaif:text>distinta</aaif:text><aaif:lemma rdf:resource="https://gams.uni-graz.at/o:aaif.lemma#distinto" /><aaif:position rdf:datatype="http://www.w3.org/2001/XMLSchema#int">2</aaif:position><aaif:coordinated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:coordinated><aaif:morphosyntacticStructure rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Adjective" /><aaif:inflection rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#FeminineSingular" /><aaif:attributionTarget rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#VerbObject" /><aaif:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:modified><aaif:semanticClassification rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Manner" /><aaif:reduplicated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:reduplicated><aaif:prepositionalPhrase rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:prepositionalPhrase></aaif:Adverb><aaif:Entry rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En1077"><aaif:phrase rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh#En1077Ph1" /><aaif:source rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh.bibl#Cnde114" /><gams:textualContent>, esas coplas populares en que el llanero pone todo el sentimiento de su alma enamorada;mientras se oía distinto cada rato el alerta de los centinelas;mientras los demás heridos dormían profundamente, Felipe velaba en el silencio</gams:textualContent><rel:isPartOf rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh" /></aaif:Entry><aaif:Phrase rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En1077Ph1"><aaif:verb rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh#En1077Ph1Ve1" /><aaif:adverb rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh#En1077Ph1Ad1" /><aaif:text>se oía distinto cada rato el alerta de los centinelas</aaif:text><aaif:annoText>se [v|oía|oír|rs] [a|distinto|distinto|auvnmnnn] cada rato el alerta de los centinelas</aaif:annoText></aaif:Phrase><aaif:Verb rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En1077Ph1Ve1"><aaif:text>oía</aaif:text><aaif:lemma rdf:resource="https://gams.uni-graz.at/o:aaif.lemma#oír" /><aaif:position rdf:datatype="http://www.w3.org/2001/XMLSchema#int">1</aaif:position><aaif:coordinated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:coordinated><aaif:partOfText rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</aaif:partOfText><aaif:syntacticConstruction rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Reflexive" /></aaif:Verb><aaif:Adverb rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En1077Ph1Ad1"><aaif:text>distinto</aaif:text><aaif:lemma rdf:resource="https://gams.uni-graz.at/o:aaif.lemma#distinto" /><aaif:position rdf:datatype="http://www.w3.org/2001/XMLSchema#int">2</aaif:position><aaif:coordinated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:coordinated><aaif:morphosyntacticStructure rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Adjective" /><aaif:inflection rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Uninflected" /><aaif:attributionTarget rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Verb" /><aaif:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:modified><aaif:semanticClassification rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Manner" /><aaif:reduplicated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:reduplicated><aaif:prepositionalPhrase rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:prepositionalPhrase></aaif:Adverb><aaif:Entry rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En1078"><aaif:phrase rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh#En1078Ph1" /><aaif:source rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh.bibl#Cnde115" /><gams:textualContent> El retintín  llegó distinto á sus oídos por sobre la pared del patio.Vió al mismo tiempo entreabrirse el postigo de la puerta destinado á dejar entrar la gente de á pie.Pero cuando apoyaba la mano sobre ese postigo para abrirlo, la cara picaresca de Ñico le mostró sus ojos centelleantes de malicia y su sonrisa de muchacho travieso.</gams:textualContent><rel:isPartOf rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh" /></aaif:Entry><aaif:Phrase rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En1078Ph1"><aaif:subject rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh#En1078Ph1Su1" /><aaif:verb rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh#En1078Ph1Ve1" /><aaif:adverb rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh#En1078Ph1Ad1" /><aaif:text> El retintín  llegó distinto á sus oídos</aaif:text><aaif:annoText> [s|El retintín|ms]  [v|llegó|llegar|is] [a|distinto|distinto|auvnmnnn] á sus oídos</aaif:annoText></aaif:Phrase><aaif:Subject rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En1078Ph1Su1"><aaif:text>El retintín</aaif:text><aaif:position rdf:datatype="http://www.w3.org/2001/XMLSchema#int">1</aaif:position><aaif:gender rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Masculine" /><aaif:number rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Singular" /><aaif:overt rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</aaif:overt></aaif:Subject><aaif:Verb rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En1078Ph1Ve1"><aaif:text>llegó</aaif:text><aaif:lemma rdf:resource="https://gams.uni-graz.at/o:aaif.lemma#llegar" /><aaif:position rdf:datatype="http://www.w3.org/2001/XMLSchema#int">2</aaif:position><aaif:coordinated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:coordinated><aaif:partOfText rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</aaif:partOfText><aaif:syntacticConstruction rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Intransitive" /></aaif:Verb><aaif:Adverb rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En1078Ph1Ad1"><aaif:text>distinto</aaif:text><aaif:lemma rdf:resource="https://gams.uni-graz.at/o:aaif.lemma#distinto" /><aaif:position rdf:datatype="http://www.w3.org/2001/XMLSchema#int">3</aaif:position><aaif:coordinated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:coordinated><aaif:morphosyntacticStructure rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Adjective" /><aaif:inflection rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Uninflected" /><aaif:attributionTarget rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Verb" /><aaif:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:modified><aaif:semanticClassification rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Manner" /><aaif:reduplicated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:reduplicated><aaif:prepositionalPhrase rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:prepositionalPhrase></aaif:Adverb><aaif:Entry rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En1079"><aaif:phrase rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh#En1079Ph1" /><aaif:source rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh.bibl#Cnde116" /><gams:textualContent>cuando está peleando, qué macana, pibe.Claro que oye, vos te creés que yo no oía distinto entre los gringos, menos mal que lo tenía al trompa en el rincón, áperca, pibe,</gams:textualContent><rel:isPartOf rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh" /></aaif:Entry><aaif:Phrase rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En1079Ph1"><aaif:subject rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh#En1079Ph1Su1" /><aaif:verb rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh#En1079Ph1Ve1" /><aaif:adverb rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh#En1079Ph1Ad1" /><aaif:text>Claro que oye, vos te creés que yo no oía distinto entre los gringos</aaif:text><aaif:annoText>Claro que oye, vos te creés que [s|yo|us] no [v|oía|oír|is] [a|distinto|distinto|auvnmnnn] entre los gringos</aaif:annoText></aaif:Phrase><aaif:Subject rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En1079Ph1Su1"><aaif:text>yo</aaif:text><aaif:position rdf:datatype="http://www.w3.org/2001/XMLSchema#int">1</aaif:position><aaif:gender rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Undefined" /><aaif:number rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Singular" /><aaif:overt rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</aaif:overt></aaif:Subject><aaif:Verb rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En1079Ph1Ve1"><aaif:text>oía</aaif:text><aaif:lemma rdf:resource="https://gams.uni-graz.at/o:aaif.lemma#oír" /><aaif:position rdf:datatype="http://www.w3.org/2001/XMLSchema#int">2</aaif:position><aaif:coordinated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:coordinated><aaif:partOfText rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</aaif:partOfText><aaif:syntacticConstruction rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Intransitive" /></aaif:Verb><aaif:Adverb rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En1079Ph1Ad1"><aaif:text>distinto</aaif:text><aaif:lemma rdf:resource="https://gams.uni-graz.at/o:aaif.lemma#distinto" /><aaif:position rdf:datatype="http://www.w3.org/2001/XMLSchema#int">3</aaif:position><aaif:coordinated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:coordinated><aaif:morphosyntacticStructure rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Adjective" /><aaif:inflection rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Uninflected" /><aaif:attributionTarget rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Verb" /><aaif:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:modified><aaif:semanticClassification rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Manner" /><aaif:reduplicated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:reduplicated><aaif:prepositionalPhrase rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:prepositionalPhrase></aaif:Adverb><aaif:Entry rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En1080"><aaif:phrase rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh#En1080Ph1" /><aaif:source rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh.bibl#Cnde1" /><gams:textualContent>sólo que, igual que Rodrigo me había obligado a sentir que yo era distinta, me obligó a sentir distinto a Gervasio, y se canceló todo lo que había mantenido, el rencor, el tibio recuerdo de s</gams:textualContent><rel:isPartOf rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh" /></aaif:Entry><aaif:Phrase rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En1080Ph1"><aaif:verb rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh#En1080Ph1Ve1" /><aaif:adverb rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh#En1080Ph1Ad1" /><aaif:text>me obligó a sentir distinto a Gervasio</aaif:text><aaif:annoText>me obligó a [v|sentir|sentir|ts] [a|distinto|distinto|auvnmnnn] a Gervasio</aaif:annoText></aaif:Phrase><aaif:Verb rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En1080Ph1Ve1"><aaif:text>sentir</aaif:text><aaif:lemma rdf:resource="https://gams.uni-graz.at/o:aaif.lemma#sentir" /><aaif:position rdf:datatype="http://www.w3.org/2001/XMLSchema#int">1</aaif:position><aaif:coordinated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:coordinated><aaif:partOfText rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</aaif:partOfText><aaif:syntacticConstruction rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Transitive" /></aaif:Verb><aaif:Adverb rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En1080Ph1Ad1"><aaif:text>distinto</aaif:text><aaif:lemma rdf:resource="https://gams.uni-graz.at/o:aaif.lemma#distinto" /><aaif:position rdf:datatype="http://www.w3.org/2001/XMLSchema#int">2</aaif:position><aaif:coordinated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:coordinated><aaif:morphosyntacticStructure rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Adjective" /><aaif:inflection rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Uninflected" /><aaif:attributionTarget rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Verb" /><aaif:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:modified><aaif:semanticClassification rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Manner" /><aaif:reduplicated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:reduplicated><aaif:prepositionalPhrase rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:prepositionalPhrase></aaif:Adverb><aaif:Entry rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En1081"><aaif:phrase rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh#En1081Ph1" /><aaif:source rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh.bibl#Cnde1" /><gams:textualContent> Jaime la sentía distinta , pero no dejaba de aplaudirla y de agradecer esta sensación de independencia frente a la provincia que él también</gams:textualContent><rel:isPartOf rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh" /></aaif:Entry><aaif:Phrase rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En1081Ph1"><aaif:subject rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh#En1081Ph1Su1" /><aaif:verb rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh#En1081Ph1Ve1" /><aaif:adverb rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh#En1081Ph1Ad1" /><aaif:text> Jaime la sentía distinta </aaif:text><aaif:annoText> [s|Jaime|ms] la [v|sentía|sentir|ts] [a|distinta|distinto|afonmnnn] </aaif:annoText></aaif:Phrase><aaif:Subject rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En1081Ph1Su1"><aaif:text>Jaime</aaif:text><aaif:position rdf:datatype="http://www.w3.org/2001/XMLSchema#int">1</aaif:position><aaif:gender rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Masculine" /><aaif:number rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Singular" /><aaif:overt rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</aaif:overt></aaif:Subject><aaif:Verb rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En1081Ph1Ve1"><aaif:text>sentía</aaif:text><aaif:lemma rdf:resource="https://gams.uni-graz.at/o:aaif.lemma#sentir" /><aaif:position rdf:datatype="http://www.w3.org/2001/XMLSchema#int">2</aaif:position><aaif:coordinated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:coordinated><aaif:partOfText rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</aaif:partOfText><aaif:syntacticConstruction rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Transitive" /></aaif:Verb><aaif:Adverb rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En1081Ph1Ad1"><aaif:text>distinta</aaif:text><aaif:lemma rdf:resource="https://gams.uni-graz.at/o:aaif.lemma#distinto" /><aaif:position rdf:datatype="http://www.w3.org/2001/XMLSchema#int">3</aaif:position><aaif:coordinated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:coordinated><aaif:morphosyntacticStructure rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Adjective" /><aaif:inflection rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#FeminineSingular" /><aaif:attributionTarget rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#VerbObject" /><aaif:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:modified><aaif:semanticClassification rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Manner" /><aaif:reduplicated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:reduplicated><aaif:prepositionalPhrase rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:prepositionalPhrase></aaif:Adverb><aaif:Entry rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En1082"><aaif:phrase rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh#En1082Ph1" /><aaif:source rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh.bibl#Cnde117" /><gams:textualContent>mi cuarto.Esta noche te haré un zumbayllu especial.Tengo un winku, cholo. Los winkus  cantan distinto .Tienen alma.</gams:textualContent><rel:isPartOf rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh" /></aaif:Entry><aaif:Phrase rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En1082Ph1"><aaif:subject rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh#En1082Ph1Su1" /><aaif:verb rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh#En1082Ph1Ve1" /><aaif:adverb rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh#En1082Ph1Ad1" /><aaif:text> Los winkus  cantan distinto </aaif:text><aaif:annoText> [s|Los winkus|mp]  [v|cantan|cantar|is] [a|distinto|distinto|auvnmnnn] </aaif:annoText></aaif:Phrase><aaif:Subject rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En1082Ph1Su1"><aaif:text>Los winkus</aaif:text><aaif:position rdf:datatype="http://www.w3.org/2001/XMLSchema#int">1</aaif:position><aaif:gender rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Masculine" /><aaif:number rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Plural" /><aaif:overt rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</aaif:overt></aaif:Subject><aaif:Verb rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En1082Ph1Ve1"><aaif:text>cantan</aaif:text><aaif:lemma rdf:resource="https://gams.uni-graz.at/o:aaif.lemma#cantar" /><aaif:position rdf:datatype="http://www.w3.org/2001/XMLSchema#int">2</aaif:position><aaif:coordinated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:coordinated><aaif:partOfText rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</aaif:partOfText><aaif:syntacticConstruction rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Intransitive" /></aaif:Verb><aaif:Adverb rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En1082Ph1Ad1"><aaif:text>distinto</aaif:text><aaif:lemma rdf:resource="https://gams.uni-graz.at/o:aaif.lemma#distinto" /><aaif:position rdf:datatype="http://www.w3.org/2001/XMLSchema#int">3</aaif:position><aaif:coordinated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:coordinated><aaif:morphosyntacticStructure rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Adjective" /><aaif:inflection rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Uninflected" /><aaif:attributionTarget rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Verb" /><aaif:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:modified><aaif:semanticClassification rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Manner" /><aaif:reduplicated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:reduplicated><aaif:prepositionalPhrase rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:prepositionalPhrase></aaif:Adverb><aaif:Entry rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En1083"><aaif:phrase rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh#En1083Ph1" /><aaif:source rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh.bibl#Cnde50" /><gams:textualContent>el fondo, porque sí, porque ésa es la medida con que se mide un hombre.Pero él juega distinto y no sólo por el tamaño y el montón de las fichas.Con menos desesperación que yo, para</gams:textualContent><rel:isPartOf rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh" /></aaif:Entry><aaif:Phrase rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En1083Ph1"><aaif:subject rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh#En1083Ph1Su1" /><aaif:verb rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh#En1083Ph1Ve1" /><aaif:adverb rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh#En1083Ph1Ad1" /><aaif:text>Pero él juega distinto y no sólo por el tamaño y el montón de las fichas</aaif:text><aaif:annoText>Pero [s|él|ms] [v|juega|jugar|is] [a|distinto|distinto|auvnmnnn] y no sólo por el tamaño y el montón de las fichas</aaif:annoText></aaif:Phrase><aaif:Subject rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En1083Ph1Su1"><aaif:text>él</aaif:text><aaif:position rdf:datatype="http://www.w3.org/2001/XMLSchema#int">1</aaif:position><aaif:gender rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Masculine" /><aaif:number rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Singular" /><aaif:overt rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</aaif:overt></aaif:Subject><aaif:Verb rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En1083Ph1Ve1"><aaif:text>juega</aaif:text><aaif:lemma rdf:resource="https://gams.uni-graz.at/o:aaif.lemma#jugar" /><aaif:position rdf:datatype="http://www.w3.org/2001/XMLSchema#int">2</aaif:position><aaif:coordinated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:coordinated><aaif:partOfText rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</aaif:partOfText><aaif:syntacticConstruction rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Intransitive" /></aaif:Verb><aaif:Adverb rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En1083Ph1Ad1"><aaif:text>distinto</aaif:text><aaif:lemma rdf:resource="https://gams.uni-graz.at/o:aaif.lemma#distinto" /><aaif:position rdf:datatype="http://www.w3.org/2001/XMLSchema#int">3</aaif:position><aaif:coordinated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:coordinated><aaif:morphosyntacticStructure rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Adjective" /><aaif:inflection rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Uninflected" /><aaif:attributionTarget rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Verb" /><aaif:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:modified><aaif:semanticClassification rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Manner" /><aaif:reduplicated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:reduplicated><aaif:prepositionalPhrase rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:prepositionalPhrase></aaif:Adverb><aaif:Entry rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En1084"><aaif:phrase rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh#En1084Ph1" /><aaif:source rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh.bibl#Cnde118" /><gams:textualContent>, que de verde-tinta pasaba al verde-humo.Los marineros de colmillo husmeaban las ráfagas, sabiendo que olían distinto , con ese negror de sombra que se les atropellaba por encima y esos bruscos aquietamientos, cortados por lluvias tibias</gams:textualContent><rel:isPartOf rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh" /></aaif:Entry><aaif:Phrase rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En1084Ph1"><aaif:verb rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh#En1084Ph1Ve1" /><aaif:adverb rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh#En1084Ph1Ad1" /><aaif:text>Los marineros de colmillo husmeaban las ráfagas, sabiendo que olían distinto </aaif:text><aaif:annoText>Los marineros de colmillo husmeaban las ráfagas, sabiendo que [v|olían|oler|is] [a|distinto|distinto|auvnmnnn] </aaif:annoText></aaif:Phrase><aaif:Verb rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En1084Ph1Ve1"><aaif:text>olían</aaif:text><aaif:lemma rdf:resource="https://gams.uni-graz.at/o:aaif.lemma#oler" /><aaif:position rdf:datatype="http://www.w3.org/2001/XMLSchema#int">1</aaif:position><aaif:coordinated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:coordinated><aaif:partOfText rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</aaif:partOfText><aaif:syntacticConstruction rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Intransitive" /></aaif:Verb><aaif:Adverb rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En1084Ph1Ad1"><aaif:text>distinto</aaif:text><aaif:lemma rdf:resource="https://gams.uni-graz.at/o:aaif.lemma#distinto" /><aaif:position rdf:datatype="http://www.w3.org/2001/XMLSchema#int">2</aaif:position><aaif:coordinated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:coordinated><aaif:morphosyntacticStructure rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Adjective" /><aaif:inflection rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Uninflected" /><aaif:attributionTarget rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Verb" /><aaif:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:modified><aaif:semanticClassification rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Manner" /><aaif:reduplicated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:reduplicated><aaif:prepositionalPhrase rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:prepositionalPhrase></aaif:Adverb><aaif:Entry rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En1085"><aaif:phrase rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh#En1085Ph1" /><aaif:source rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh.bibl#Cnde119" /><gams:textualContent>del sargento Kossian han vuelto a avanzar sobre el borde de esa pila de billetes.— Se escribe distinto aquí.Más...más españoles; y nosotros somos más modernos.Eso es lo que somos.</gams:textualContent><rel:isPartOf rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh" /></aaif:Entry><aaif:Phrase rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En1085Ph1"><aaif:verb rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh#En1085Ph1Ve1" /><aaif:adverb rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh#En1085Ph1Ad1" /><aaif:text>Se escribe distinto aquí</aaif:text><aaif:annoText>Se [v|escribe|escribir|is] [a|distinto|distinto|auvnmnnn] aquí</aaif:annoText></aaif:Phrase><aaif:Verb rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En1085Ph1Ve1"><aaif:text>escribe</aaif:text><aaif:lemma rdf:resource="https://gams.uni-graz.at/o:aaif.lemma#escribir" /><aaif:position rdf:datatype="http://www.w3.org/2001/XMLSchema#int">1</aaif:position><aaif:coordinated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:coordinated><aaif:partOfText rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</aaif:partOfText><aaif:syntacticConstruction rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Intransitive" /></aaif:Verb><aaif:Adverb rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En1085Ph1Ad1"><aaif:text>distinto</aaif:text><aaif:lemma rdf:resource="https://gams.uni-graz.at/o:aaif.lemma#distinto" /><aaif:position rdf:datatype="http://www.w3.org/2001/XMLSchema#int">2</aaif:position><aaif:coordinated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:coordinated><aaif:morphosyntacticStructure rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Adjective" /><aaif:inflection rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Uninflected" /><aaif:attributionTarget rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Verb" /><aaif:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:modified><aaif:semanticClassification rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Manner" /><aaif:reduplicated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:reduplicated><aaif:prepositionalPhrase rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:prepositionalPhrase></aaif:Adverb><aaif:Entry rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En1086"><aaif:phrase rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh#En1086Ph1" /><aaif:source rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh.bibl#Cnde6" /><gams:textualContent>, al fondo, Julius volteaba y era siempre la viejita de negro llegando.Lo único que sonaba distinto eran los pasos nervioapuradísimos del señor Aurelio Lovett, que se dirigía vehemente hacia la primera banca, beato chupa</gams:textualContent><rel:isPartOf rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh" /></aaif:Entry><aaif:Phrase rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En1086Ph1"><aaif:verb rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh#En1086Ph1Ve1" /><aaif:adverb rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh#En1086Ph1Ad1" /><aaif:text>Lo único que sonaba distinto eran los pasos nervioapuradísimos del señor Aurelio Lovett</aaif:text><aaif:annoText>Lo único que [v|sonaba|sonar|is] [a|distinto|distinto|auvnmnnn] eran los pasos nervioapuradísimos del señor Aurelio Lovett</aaif:annoText></aaif:Phrase><aaif:Verb rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En1086Ph1Ve1"><aaif:text>sonaba</aaif:text><aaif:lemma rdf:resource="https://gams.uni-graz.at/o:aaif.lemma#sonar" /><aaif:position rdf:datatype="http://www.w3.org/2001/XMLSchema#int">1</aaif:position><aaif:coordinated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:coordinated><aaif:partOfText rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</aaif:partOfText><aaif:syntacticConstruction rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Intransitive" /></aaif:Verb><aaif:Adverb rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En1086Ph1Ad1"><aaif:text>distinto</aaif:text><aaif:lemma rdf:resource="https://gams.uni-graz.at/o:aaif.lemma#distinto" /><aaif:position rdf:datatype="http://www.w3.org/2001/XMLSchema#int">2</aaif:position><aaif:coordinated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:coordinated><aaif:morphosyntacticStructure rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Adjective" /><aaif:inflection rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Uninflected" /><aaif:attributionTarget rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Verb" /><aaif:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:modified><aaif:semanticClassification rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Manner" /><aaif:reduplicated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:reduplicated><aaif:prepositionalPhrase rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:prepositionalPhrase></aaif:Adverb><aaif:Entry rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En1087"><aaif:phrase rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh#En1087Ph1" /><aaif:source rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh.bibl#Cnde58" /><gams:textualContent>— Tampoco te pongas así.Has firmado y en paz.Cuando dentro de unos días nos paguen, verás distinto el asunto.</gams:textualContent><rel:isPartOf rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh" /></aaif:Entry><aaif:Phrase rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En1087Ph1"><aaif:verb rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh#En1087Ph1Ve1" /><aaif:adverb rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh#En1087Ph1Ad1" /><aaif:text>Cuando dentro de unos días nos paguen, verás distinto el asunto</aaif:text><aaif:annoText>Cuando dentro de unos días nos paguen, [v|verás|ver|ts] [a|distinto|distinto|auvnmnnn] el asunto</aaif:annoText></aaif:Phrase><aaif:Verb rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En1087Ph1Ve1"><aaif:text>verás</aaif:text><aaif:lemma rdf:resource="https://gams.uni-graz.at/o:aaif.lemma#ver" /><aaif:position rdf:datatype="http://www.w3.org/2001/XMLSchema#int">1</aaif:position><aaif:coordinated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:coordinated><aaif:partOfText rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</aaif:partOfText><aaif:syntacticConstruction rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Transitive" /></aaif:Verb><aaif:Adverb rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En1087Ph1Ad1"><aaif:text>distinto</aaif:text><aaif:lemma rdf:resource="https://gams.uni-graz.at/o:aaif.lemma#distinto" /><aaif:position rdf:datatype="http://www.w3.org/2001/XMLSchema#int">2</aaif:position><aaif:coordinated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:coordinated><aaif:morphosyntacticStructure rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Adjective" /><aaif:inflection rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Uninflected" /><aaif:attributionTarget rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Verb" /><aaif:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:modified><aaif:semanticClassification rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Manner" /><aaif:reduplicated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:reduplicated><aaif:prepositionalPhrase rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:prepositionalPhrase></aaif:Adverb><aaif:Entry rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En1088"><aaif:phrase rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh#En1088Ph1" /><aaif:source rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh.bibl#Cnde58" /><gams:textualContent>— Lo veré distinto .Pero huele a mierda, aunque uno ya no huela la mierda.</gams:textualContent><rel:isPartOf rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh" /></aaif:Entry><aaif:Phrase rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En1088Ph1"><aaif:verb rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh#En1088Ph1Ve1" /><aaif:adverb rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh#En1088Ph1Ad1" /><aaif:text>Lo veré distinto </aaif:text><aaif:annoText>Lo [v|veré|ver|ts] [a|distinto|distinto|auvnmnnn] </aaif:annoText></aaif:Phrase><aaif:Verb rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En1088Ph1Ve1"><aaif:text>veré</aaif:text><aaif:lemma rdf:resource="https://gams.uni-graz.at/o:aaif.lemma#ver" /><aaif:position rdf:datatype="http://www.w3.org/2001/XMLSchema#int">1</aaif:position><aaif:coordinated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:coordinated><aaif:partOfText rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</aaif:partOfText><aaif:syntacticConstruction rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Transitive" /></aaif:Verb><aaif:Adverb rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En1088Ph1Ad1"><aaif:text>distinto</aaif:text><aaif:lemma rdf:resource="https://gams.uni-graz.at/o:aaif.lemma#distinto" /><aaif:position rdf:datatype="http://www.w3.org/2001/XMLSchema#int">2</aaif:position><aaif:coordinated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:coordinated><aaif:morphosyntacticStructure rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Adjective" /><aaif:inflection rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Uninflected" /><aaif:attributionTarget rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Verb" /><aaif:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:modified><aaif:semanticClassification rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Manner" /><aaif:reduplicated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:reduplicated><aaif:prepositionalPhrase rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:prepositionalPhrase></aaif:Adverb><aaif:Entry rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En1089"><aaif:phrase rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh#En1089Ph1" /><aaif:source rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh.bibl#Cnde62" /><gams:textualContent>pensó ella, ésas sí que me gustan y luego cavilando se dio cuenta de que  Ramón ahora se portaba distinto y los domingos se iba dizque a misa con otros amigos que ya no eran los de antes, relajados,</gams:textualContent><rel:isPartOf rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh" /></aaif:Entry><aaif:Phrase rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En1089Ph1"><aaif:subject rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh#En1089Ph1Su1" /><aaif:verb rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh#En1089Ph1Ve1" /><aaif:adverb rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh#En1089Ph1Ad1" /><aaif:text> Ramón ahora se portaba distinto y los domingos se iba dizque a misa</aaif:text><aaif:annoText> [s|Ramón|ms] ahora se [v|portaba|portar|rs] [a|distinto|distinto|auvnmnnn] y los domingos se iba dizque a misa</aaif:annoText></aaif:Phrase><aaif:Subject rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En1089Ph1Su1"><aaif:text>Ramón</aaif:text><aaif:position rdf:datatype="http://www.w3.org/2001/XMLSchema#int">1</aaif:position><aaif:gender rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Masculine" /><aaif:number rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Singular" /><aaif:overt rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</aaif:overt></aaif:Subject><aaif:Verb rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En1089Ph1Ve1"><aaif:text>portaba</aaif:text><aaif:lemma rdf:resource="https://gams.uni-graz.at/o:aaif.lemma#portar" /><aaif:position rdf:datatype="http://www.w3.org/2001/XMLSchema#int">2</aaif:position><aaif:coordinated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:coordinated><aaif:partOfText rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</aaif:partOfText><aaif:syntacticConstruction rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Reflexive" /></aaif:Verb><aaif:Adverb rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En1089Ph1Ad1"><aaif:text>distinto</aaif:text><aaif:lemma rdf:resource="https://gams.uni-graz.at/o:aaif.lemma#distinto" /><aaif:position rdf:datatype="http://www.w3.org/2001/XMLSchema#int">3</aaif:position><aaif:coordinated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:coordinated><aaif:morphosyntacticStructure rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Adjective" /><aaif:inflection rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Uninflected" /><aaif:attributionTarget rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Verb" /><aaif:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:modified><aaif:semanticClassification rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Manner" /><aaif:reduplicated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:reduplicated><aaif:prepositionalPhrase rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:prepositionalPhrase></aaif:Adverb><aaif:Entry rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En1090"><aaif:phrase rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh#En1090Ph1" /><aaif:source rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh.bibl#Cnde120" /><gams:textualContent>pasar la aspiradora y matar unas cucarachitas que se paseaban por todas partes.En fin, su esposo debía pensar distinto a mí.Me odiaba el tipo.Odiaba a toda la humanidad, pero yo creo que sobre todo</gams:textualContent><rel:isPartOf rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh" /></aaif:Entry><aaif:Phrase rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En1090Ph1"><aaif:subject rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh#En1090Ph1Su1" /><aaif:verb rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh#En1090Ph1Ve1" /><aaif:adverb rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh#En1090Ph1Ad1" /><aaif:text>En fin, su esposo debía pensar distinto a mí</aaif:text><aaif:annoText>En fin, [s|su esposo|ms] debía [v|pensar|pensar|is] [a|distinto|distinto|auonmnnn] a mí</aaif:annoText></aaif:Phrase><aaif:Subject rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En1090Ph1Su1"><aaif:text>su esposo</aaif:text><aaif:position rdf:datatype="http://www.w3.org/2001/XMLSchema#int">1</aaif:position><aaif:gender rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Masculine" /><aaif:number rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Singular" /><aaif:overt rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</aaif:overt></aaif:Subject><aaif:Verb rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En1090Ph1Ve1"><aaif:text>pensar</aaif:text><aaif:lemma rdf:resource="https://gams.uni-graz.at/o:aaif.lemma#pensar" /><aaif:position rdf:datatype="http://www.w3.org/2001/XMLSchema#int">2</aaif:position><aaif:coordinated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:coordinated><aaif:partOfText rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</aaif:partOfText><aaif:syntacticConstruction rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Intransitive" /></aaif:Verb><aaif:Adverb rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En1090Ph1Ad1"><aaif:text>distinto</aaif:text><aaif:lemma rdf:resource="https://gams.uni-graz.at/o:aaif.lemma#distinto" /><aaif:position rdf:datatype="http://www.w3.org/2001/XMLSchema#int">3</aaif:position><aaif:coordinated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:coordinated><aaif:morphosyntacticStructure rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Adjective" /><aaif:inflection rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Uninflected" /><aaif:attributionTarget rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#VerbObject" /><aaif:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:modified><aaif:semanticClassification rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Manner" /><aaif:reduplicated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:reduplicated><aaif:prepositionalPhrase rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:prepositionalPhrase></aaif:Adverb><aaif:Entry rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En1091"><aaif:phrase rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh#En1091Ph1" /><aaif:source rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh.bibl#Cnde120" /><gams:textualContent>suba, tú le sigues la cuerda, o lo mandas a la mierda, o le dices que  piensas  distinto a él, eso es todo.¿Por qué crees que tiene que sucederte siempre algo?</gams:textualContent><rel:isPartOf rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh" /></aaif:Entry><aaif:Phrase rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En1091Ph1"><aaif:verb rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh#En1091Ph1Ve1" /><aaif:adverb rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh#En1091Ph1Ad1" /><aaif:text> piensas  distinto a él</aaif:text><aaif:annoText> [v|piensas|pensar|is]  [a|distinto|distinto|auonmnnn] a él</aaif:annoText></aaif:Phrase><aaif:Verb rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En1091Ph1Ve1"><aaif:text>piensas</aaif:text><aaif:lemma rdf:resource="https://gams.uni-graz.at/o:aaif.lemma#pensar" /><aaif:position rdf:datatype="http://www.w3.org/2001/XMLSchema#int">1</aaif:position><aaif:coordinated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:coordinated><aaif:partOfText rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</aaif:partOfText><aaif:syntacticConstruction rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Intransitive" /></aaif:Verb><aaif:Adverb rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En1091Ph1Ad1"><aaif:text>distinto</aaif:text><aaif:lemma rdf:resource="https://gams.uni-graz.at/o:aaif.lemma#distinto" /><aaif:position rdf:datatype="http://www.w3.org/2001/XMLSchema#int">2</aaif:position><aaif:coordinated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:coordinated><aaif:morphosyntacticStructure rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Adjective" /><aaif:inflection rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Uninflected" /><aaif:attributionTarget rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#VerbObject" /><aaif:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:modified><aaif:semanticClassification rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Manner" /><aaif:reduplicated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:reduplicated><aaif:prepositionalPhrase rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:prepositionalPhrase></aaif:Adverb><aaif:Entry rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En1092"><aaif:phrase rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh#En1092Ph1" /><aaif:source rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh.bibl#Cnde67" /><gams:textualContent>Pero el orden interno está quebrado, finamente molido.Tenemos los tres una llaga profunda, una espantosa connivencia.A veces me sorprendo diciéndome: ¡a qué accedes, maldito!Culpable, sucio.Nunca creí llegar tan largo y tan hondo en el placer.Quizá por eso me conviene estar recluido, sin ver caras que podrían detectar las trazas de nuestras prácticas oscuras.De lo que hicimos.De lo que hacemos.Mariestela no está de acuerdo, dice que no hacemos nada, en todo caso nada que no hayamos deseado cuando niños.Y eso también es cierto. Cuando la psicoanalista regrese de sus vacaciones anuales todo se organizará distinto .Porque es imposible vivir completamente al margen.¿Octavia y ella han vivido así siempre?Se habrán propuesto desafiar todas las leyes, romper todos los tabúes sin dejar de mantenerlos erigidos.Se lo dije y se enojó: «No me he propuesto absolutamente nada, aquí vivimos de manera cien por ciento normal.¿De qué te quejás?Nunca habías estado tan prolífico, tan productivo, tan creador.»</gams:textualContent><rel:isPartOf rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh" /></aaif:Entry><aaif:Phrase rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En1092Ph1"><aaif:verb rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh#En1092Ph1Ve1" /><aaif:adverb rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh#En1092Ph1Ad1" /><aaif:text>Cuando la psicoanalista regrese de sus vacaciones anuales todo se organizará distinto </aaif:text><aaif:annoText>Cuando la psicoanalista regrese de sus vacaciones anuales todo se [v|organizará|organizar|rs] [a|distinto|distinto|auvnmnnn] </aaif:annoText></aaif:Phrase><aaif:Verb rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En1092Ph1Ve1"><aaif:text>organizará</aaif:text><aaif:lemma rdf:resource="https://gams.uni-graz.at/o:aaif.lemma#organizar" /><aaif:position rdf:datatype="http://www.w3.org/2001/XMLSchema#int">1</aaif:position><aaif:coordinated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:coordinated><aaif:partOfText rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</aaif:partOfText><aaif:syntacticConstruction rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Reflexive" /></aaif:Verb><aaif:Adverb rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En1092Ph1Ad1"><aaif:text>distinto</aaif:text><aaif:lemma rdf:resource="https://gams.uni-graz.at/o:aaif.lemma#distinto" /><aaif:position rdf:datatype="http://www.w3.org/2001/XMLSchema#int">2</aaif:position><aaif:coordinated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:coordinated><aaif:morphosyntacticStructure rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Adjective" /><aaif:inflection rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Uninflected" /><aaif:attributionTarget rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Verb" /><aaif:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:modified><aaif:semanticClassification rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Manner" /><aaif:reduplicated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:reduplicated><aaif:prepositionalPhrase rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:prepositionalPhrase></aaif:Adverb><aaif:Entry rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En1093"><aaif:phrase rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh#En1093Ph1" /><aaif:source rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh.bibl#Cnde77" /><gams:textualContent>a la Península se llama indiano, y no puede zafarse de la designación, porque vuelto allá se comporta distinto , no es español de España sino indiano venido de estas tierras.La razón que puedo dar es que</gams:textualContent><rel:isPartOf rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh" /></aaif:Entry><aaif:Phrase rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En1093Ph1"><aaif:verb rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh#En1093Ph1Ve1" /><aaif:adverb rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh#En1093Ph1Ad1" /><aaif:text>porque vuelto allá se comporta distinto </aaif:text><aaif:annoText>porque vuelto allá se [v|comporta|comportar|rs] [a|distinto|distinto|auvnmnnn] </aaif:annoText></aaif:Phrase><aaif:Verb rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En1093Ph1Ve1"><aaif:text>comporta</aaif:text><aaif:lemma rdf:resource="https://gams.uni-graz.at/o:aaif.lemma#comportar" /><aaif:position rdf:datatype="http://www.w3.org/2001/XMLSchema#int">1</aaif:position><aaif:coordinated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:coordinated><aaif:partOfText rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</aaif:partOfText><aaif:syntacticConstruction rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Reflexive" /></aaif:Verb><aaif:Adverb rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En1093Ph1Ad1"><aaif:text>distinto</aaif:text><aaif:lemma rdf:resource="https://gams.uni-graz.at/o:aaif.lemma#distinto" /><aaif:position rdf:datatype="http://www.w3.org/2001/XMLSchema#int">2</aaif:position><aaif:coordinated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:coordinated><aaif:morphosyntacticStructure rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Adjective" /><aaif:inflection rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Uninflected" /><aaif:attributionTarget rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Verb" /><aaif:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:modified><aaif:semanticClassification rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Manner" /><aaif:reduplicated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:reduplicated><aaif:prepositionalPhrase rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:prepositionalPhrase></aaif:Adverb><aaif:Entry rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En1094"><aaif:phrase rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh#En1094Ph1" /><aaif:source rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh.bibl#Cnde121" /><gams:textualContent>dirigentes de occidente— del Caribe, donde  las cosas del estado y la nación evidentemente se dilucidan distinto a Europa.El concepto europeo de estado nacional posee una acérrirna solidez ideosincrática hace —siglos (en parte</gams:textualContent><rel:isPartOf rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh" /></aaif:Entry><aaif:Phrase rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En1094Ph1"><aaif:subject rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh#En1094Ph1Su1" /><aaif:verb rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh#En1094Ph1Ve1" /><aaif:adverb rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh#En1094Ph1Ad1" /><aaif:text> las cosas del estado y la nación evidentemente se dilucidan distinto a Europa</aaif:text><aaif:annoText> [s|las cosas del estado y la nación|fp] evidentemente se [v|dilucidan|dilucidar|rs] [a|distinto|distinto|auvnmnnn] a Europa</aaif:annoText></aaif:Phrase><aaif:Subject rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En1094Ph1Su1"><aaif:text>las cosas del estado y la nación</aaif:text><aaif:position rdf:datatype="http://www.w3.org/2001/XMLSchema#int">1</aaif:position><aaif:gender rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Feminine" /><aaif:number rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Plural" /><aaif:overt rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</aaif:overt></aaif:Subject><aaif:Verb rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En1094Ph1Ve1"><aaif:text>dilucidan</aaif:text><aaif:lemma rdf:resource="https://gams.uni-graz.at/o:aaif.lemma#dilucidar" /><aaif:position rdf:datatype="http://www.w3.org/2001/XMLSchema#int">2</aaif:position><aaif:coordinated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:coordinated><aaif:partOfText rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</aaif:partOfText><aaif:syntacticConstruction rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Reflexive" /></aaif:Verb><aaif:Adverb rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En1094Ph1Ad1"><aaif:text>distinto</aaif:text><aaif:lemma rdf:resource="https://gams.uni-graz.at/o:aaif.lemma#distinto" /><aaif:position rdf:datatype="http://www.w3.org/2001/XMLSchema#int">3</aaif:position><aaif:coordinated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:coordinated><aaif:morphosyntacticStructure rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Adjective" /><aaif:inflection rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Uninflected" /><aaif:attributionTarget rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Verb" /><aaif:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:modified><aaif:semanticClassification rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Manner" /><aaif:reduplicated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:reduplicated><aaif:prepositionalPhrase rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:prepositionalPhrase></aaif:Adverb><aaif:Entry rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En1095"><aaif:phrase rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh#En1095Ph1" /><aaif:source rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh.bibl#Cnde80" /><gams:textualContent>es de retrasar la llegada del fin del mundo.No hay electricidad y  el tiempo parece moverse distinto , lento , nunca con números digitales y, sí, prefiriendo el punzante movimiento de las agujas dentro de una</gams:textualContent><rel:isPartOf rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh" /></aaif:Entry><aaif:Phrase rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En1095Ph1"><aaif:subject rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh#En1095Ph1Su1" /><aaif:verb rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh#En1095Ph1Ve1" /><aaif:adverb rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh#En1095Ph1Ad1" /><aaif:adverb rdf:resource="https://gams.uni-graz.at/o:aaif.spacdh#En1095Ph1Ad2" /><aaif:text> el tiempo parece moverse distinto , lento , nunca con números digitales</aaif:text><aaif:annoText> [s|el tiempo|ms] parece [v|moverse|mover|rs] [a|distinto|distinto|auvnmnnC] , [a|lento|lento|auvnmnnC] , nunca con números digitales</aaif:annoText></aaif:Phrase><aaif:Subject rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En1095Ph1Su1"><aaif:text>el tiempo</aaif:text><aaif:position rdf:datatype="http://www.w3.org/2001/XMLSchema#int">1</aaif:position><aaif:gender rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Masculine" /><aaif:number rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Singular" /><aaif:overt rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</aaif:overt></aaif:Subject><aaif:Verb rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En1095Ph1Ve1"><aaif:text>moverse</aaif:text><aaif:lemma rdf:resource="https://gams.uni-graz.at/o:aaif.lemma#mover" /><aaif:position rdf:datatype="http://www.w3.org/2001/XMLSchema#int">2</aaif:position><aaif:coordinated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:coordinated><aaif:partOfText rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</aaif:partOfText><aaif:syntacticConstruction rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Reflexive" /></aaif:Verb><aaif:Adverb rdf:about="https://gams.uni-graz.at/o:aaif.spacdh#En1095Ph1Ad1"><aaif:text>distinto</aaif:text><aaif:lemma rdf:resource="https://gams.uni-graz.at/o:aaif.lemma#distinto" /><aaif:position rdf:datatype="http://www.w3.org/2001/XMLSchema#int">3</aaif:position><aaif:coordinated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</aaif:coordinated><aaif:morphosyntacticStructure rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Adjective" /><aaif:inflection rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Uninflected" /><aaif:attributionTarget rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Verb" /><aaif:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:modified><aaif:semanticClassification rdf:resource="https://gams.uni-graz.at/