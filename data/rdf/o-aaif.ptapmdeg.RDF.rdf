-graz.at/o:aaif.ptapmdeg#En1447Ph14Ad1" /><aaif:text> já depois diminui a velocidade ... certo ... diminui a velocidade dessa água</aaif:text><aaif:annoText> já depois diminui a velocidade ... [a|certo|certo|auSndnnn] ... diminui a velocidade dessa água</aaif:annoText></aaif:Phrase><aaif:Adverb rdf:about="https://gams.uni-graz.at/o:aaif.ptapmdeg#En1447Ph14Ad1"><aaif:text>certo</aaif:text><aaif:lemma rdf:resource="https://gams.uni-graz.at/o:aaif.lemma#certo" /><aaif:position rdf:datatype="http://www.w3.org/2001/XMLSchema#int">1</aaif:position><aaif:coordinated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:coordinated><aaif:morphosyntacticStructure rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Adjective" /><aaif:inflection rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Uninflected" /><aaif:attributionTarget rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Sentence" /><aaif:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:modified><aaif:semanticClassification rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Discourse" /><aaif:reduplicated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:reduplicated><aaif:prepositionalPhrase rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:prepositionalPhrase></aaif:Adverb><aaif:Phrase rdf:about="https://gams.uni-graz.at/o:aaif.ptapmdeg#En1447Ph15"><aaif:adverb rdf:resource="https://gams.uni-graz.at/o:aaif.ptapmdeg#En1447Ph15Ad1" /><aaif:text> ... certo ... por que diminui essa velocidade</aaif:text><aaif:annoText> ... [a|certo|certo|auSndnnn] ... por que diminui essa velocidade</aaif:annoText></aaif:Phrase><aaif:Adverb rdf:about="https://gams.uni-graz.at/o:aaif.ptapmdeg#En1447Ph15Ad1"><aaif:text>certo</aaif:text><aaif:lemma rdf:resource="https://gams.uni-graz.at/o:aaif.lemma#certo" /><aaif:position rdf:datatype="http://www.w3.org/2001/XMLSchema#int">1</aaif:position><aaif:coordinated rdf:datatype="http://www.w3.org/2001