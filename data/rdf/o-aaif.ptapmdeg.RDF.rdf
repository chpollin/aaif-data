1/XMLSchema#boolean">false</aaif:reduplicated><aaif:prepositionalPhrase rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:prepositionalPhrase></aaif:Adverb><aaif:Phrase rdf:about="https://gams.uni-graz.at/o:aaif.ptapmdeg#En66Ph5"><aaif:adverb rdf:resource="https://gams.uni-graz.at/o:aaif.ptapmdeg#En66Ph5Ad1" /><aaif:text> água potável... né? que aí tem o filtro embaixo e é uma torneira em que você pega da torneira mesmo pra beber... né?</aaif:text><aaif:annoText> água potável... né? que aí tem o filtro embaixo e é uma torneira em que você pega da torneira [a|mesmo|mesmo|aunnsnnn] pra beber... né?</aaif:annoText></aaif:Phrase><aaif:Adverb rdf:about="https://gams.uni-graz.at/o:aaif.ptapmdeg#En66Ph5Ad1"><aaif:text>mesmo</aaif:text><aaif:lemma rdf:resource="https://gams.uni-graz.at/o:aaif.lemma#mesmo" /><aaif:position rdf:datatype="http://www.w3.org/2001/XMLSchema#int">1</aaif:position><aaif:coordinated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:coordinated><aaif:morphosyntacticStructure rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Adjective" /><aaif:inflection rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Uninflected" /><aaif:attributionTarget rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Noun" /><aaif:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:modified><aaif:semanticClassification rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Specification" /><aaif:reduplicated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:reduplicated><aaif:prepositionalPhrase rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:prepositionalPhrase></aaif:Adverb><aaif:Phrase rdf:about="https://gams.uni-graz.at/o:aaif.ptapmdeg#En66Ph6"><aaif:adverb rdf:resource="https://gams.uni-graz.at/o:aaif.ptapmdeg#En66Ph6Ad1" /><aaif:text> é um tipo de uma prateleira só que não é uma prateleira</aaif:text><aaif:annoText> é um tipo de uma prateleira [a|só|só|auSnsnnn] que não é uma prateleira</aaif:annoText></aaif:Phrase><aaif:Adverb rdf:about="https://gams.uni-graz.at/o:aaif.ptapmdeg#En66Ph6Ad1"><aaif:text>só</aaif:text><aaif:lemma rdf:resource="https://gams.uni-graz.at/o:aaif.lemma#só" /><aaif:position rdf:datatype="http://www.w3.org/2001/XMLSchema#int">1</aaif:position><aaif:coordinated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:coordinated><aaif:morphosyntacticStructure rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Adjective" /><aaif:inflection rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Uninflected" /><aaif:attributionTarget rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Sentence" /><aaif:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:modified><aaif:semanticClassification rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Specification" /><aaif:reduplicated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:reduplicated><aaif:prepositionalPhrase rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:prepositionalPhrase></aaif:Adverb><aaif:Entry rdf:about="https://gams.uni-graz.at/o:aaif.ptapmdeg#En67"><aaif:phrase rdf:resource="https://gams.uni-graz.at/o:aaif.ptapmdeg#En67Ph1" /><aaif:phrase rdf:resource="https://gams.uni-graz.at/o:aaif.ptapmdeg#En67Ph2" /><aaif:phrase rdf:resource="https://gams.uni-graz.at/o:aaif.ptapmdeg#En67Ph3" /><aaif:phrase rdf:resource="https://gams.uni-graz.at/o:aaif.ptapmdeg#En67Ph4" /><aaif:phrase rdf:resource="https://gams.uni-graz.at/o:aaif.ptapmdeg#En67Ph5" /><aaif:phrase rdf:resource="https://gams.uni-graz.at/o:aaif.ptapmdeg#En67Ph6" /><aaif:source rdf:resource="https://gams.uni-graz.at/o:aaif.ptapmdeg.bibl#DeG13" /><gams:textualContent>E: eh::... Regina... agora eu queria que você... você me dissesse alguma coisa que você... sabe fazer e me dissesse como é que se faz isso... I: saiba fazer... uhn::... adoro fazer waffle... adoro comer waffle ((riso)) como é que faz? bem... vou te dar receita completa... né? vai sair um caderno de receitas ((riso)) ahn::... dois ovos... bem... não... primeiro ... dois copos de leite... tipo copo de requeijão... liqüidificador... duas gemas... as claras são em último... em neve... né? duas colheres de sopa de açúcar... uma pitada de sal... uma colher de sopa de fermento... duas xícaras de farinha de trigo... e::... cem gramas de manteiga derretida... aí::/ ah::... e açúcar vanille... duas colherinhas de::... de chá... de açúcar vanille... o que mais? é isso... ah... o açúcar vanille é opcional... ou você coloca o açúcar vanille ou você coloca... queijo parmeson ralado... pro waffle ficar mais salgado... e tal... aí você bate as duas claras em neve...  no fim... e coloca... por último ... na massa... tudo no liqüidificador...  depois é só botar na chapa e:: fazer TCHIII ((risos))  fica muito bom... E: mistura tudo? I: é... [no liqüidificador...] E: [no liqüidificador...] I: no liqüidificador... é...  aí depois é só botar na chapa... E: pode botar::... uma cobertura e tal em cima... I: ah... e depois que ficar pronto você coloca... com manteiga... com Karo... com mel... eu uso Karo à beça... não sou tão fã de mel assim... eu:: como mais com Karo... aí dá pra fazer...  a receita de panqueca é mais ou menos parecida... só não leva fermento e você vai na frigideira ali... aí você pode rechear também de mil maneiras...</gams:textualContent><rel:isPartOf rdf:resource="https://gams.uni-graz.at/o:aaif.ptapmdeg" /></aaif:Entry><aaif:Phrase rdf:about="https://gams.uni-graz.at/o:aaif.ptapmdeg#En67Ph1"><aaif:adverb rdf:resource="https://gams.uni-graz.at/o:aaif.ptapmdeg#En67Ph1Ad1" /><aaif:text>vai sair um caderno de receitas ((riso)) ahn::... dois ovos... bem... não... primeiro ... dois copos de leite</aaif:text><aaif:annoText>vai sair um caderno de receitas ((riso)) ahn::... dois ovos... bem... não... [a|primeiro|primeiro|auSntnnn] ... dois copos de leite</aaif:annoText></aaif:Phrase><aaif:Adverb rdf:about="https://gams.uni-graz.at/o:aaif.ptapmdeg#En67Ph1Ad1"><aaif:text>primeiro</aaif:text><aaif:lemma rdf:resource="https://gams.uni-graz.at/o:aaif.lemma#primeiro" /><aaif:position rdf:datatype="http://www.w3.org/2001/XMLSchema#int">1</aaif:position><aaif:coordinated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:coordinated><aaif:morphosyntacticStructure rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Adjective" /><aaif:inflection rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Uninflected" /><aaif:attributionTarget rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Sentence" /><aaif:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:modified><aaif:semanticClassification rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Time" /><aaif:reduplicated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:reduplicated><aaif:prepositionalPhrase rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:prepositionalPhrase></aaif:Adverb><aaif:Phrase rdf:about="https://gams.uni-graz.at/o:aaif.ptapmdeg#En67Ph2"><aaif:adverb rdf:resource="https://gams.uni-graz.at/o:aaif.ptapmdeg#En67Ph2Ad1" /><aaif:preposition rdf:resource="https://gams.uni-graz.at/o:aaif.ptapmdeg#En67Ph2Pe1" /><aaif:text> no fim... e coloca... por último ... na massa... tudo no liqüidificador</aaif:text><aaif:annoText> no fim... e coloca... [p|por|por] [a|último|último|auSntnpn] ... na massa... tudo no liqüidificador</aaif:annoText></aaif:Phrase><aaif:Adverb rdf:about="https://gams.uni-graz.at/o:aaif.ptapmdeg#En67Ph2Ad1"><aaif:text>último</aaif:text><aaif:lemma rdf:resource="https://gams.uni-graz.at/o:aaif.lemma#último" /><aaif:position rdf:datatype="http://www.w3.org/2001/XMLSchema#int">2</aaif:position><aaif:coordinated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:coordinated><aaif:morphosyntacticStructure rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Adjective" /><aaif:inflection rdf:resource="htt