olean">false</aaif:prepositionalPhrase></aaif:Adverb><aaif:Phrase rdf:about="https://gams.uni-graz.at/o:aaif.ptapmdeg#En1447Ph47"><aaif:verb rdf:resource="https://gams.uni-graz.at/o:aaif.ptapmdeg#En1447Ph47Ve1" /><aaif:adverb rdf:resource="https://gams.uni-graz.at/o:aaif.ptapmdeg#En1447Ph47Ad1" /><aaif:text> a água vai passando ... você vai aplicando ... igual  aplicou lá no coagulante</aaif:text><aaif:annoText> a água vai passando ... você vai aplicando ... [a|igual|igual|auSnmnnn]  [v|aplicou|apicar|ts] lá no coagulante</aaif:annoText></aaif:Phrase><aaif:Verb rdf:about="https://gams.uni-graz.at/o:aaif.ptapmdeg#En1447Ph47Ve1"><aaif:text>aplicou</aaif:text><aaif:lemma rdf:resource="https://gams.uni-graz.at/o:aaif.lemma#apicar" /><aaif:position rdf:datatype="http://www.w3.org/2001/XMLSchema#int">2</aaif:position><aaif:coordinated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:coordinated><aaif:partOfText rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</aaif:partOfText><aaif:syntacticConstruction rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Transitive" /></aaif:Verb><aaif:Adverb rdf:about="https://gams.uni-graz.at/o:aaif.ptapmdeg#En1447Ph47Ad1"><aaif:text>igual</aaif:text><aaif:lemma rdf:resource="https://gams.uni-graz.at/o:aaif.lemma#igual" /><aaif:position rdf:datatype="http://www.w3.org/2001/XMLSchema#int">1</aaif:position><aaif:coordinated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:coordinated><aaif:morphosyntacticStructure rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Adjective" /><aaif:inflection rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Uninflected" /><aaif:attributionTarget rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Sentence" /><aaif:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:modified><aaif:semanticClassification rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Manner" /><aaif:reduplicated rdf:datatype="http://www.w3.or