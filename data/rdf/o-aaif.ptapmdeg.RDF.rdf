butionTarget rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Sentence" /><aaif:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:modified><aaif:semanticClassification rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Specification" /><aaif:reduplicated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:reduplicated><aaif:prepositionalPhrase rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:prepositionalPhrase></aaif:Adverb><aaif:Phrase rdf:about="https://gams.uni-graz.at/o:aaif.ptapmdeg#En1405Ph69"><aaif:adverb rdf:resource="https://gams.uni-graz.at/o:aaif.ptapmdeg#En1405Ph69Ad1" /><aaif:text> o pai do ... do menino lá também sabia que o filho dele tava ... tava morto mesmo </aaif:text><aaif:annoText> o pai do ... do menino lá também sabia que o filho dele tava ... tava morto [a|mesmo|mesmo|auansnnn] </aaif:annoText></aaif:Phrase><aaif:Adverb rdf:about="https://gams.uni-graz.at/o:aaif.ptapmdeg#En1405Ph69Ad1"><aaif:text>mesmo</aaif:text><aaif:lemma rdf:resource="https://gams.uni-graz.at/o:aaif.lemma#mesmo" /><aaif:position rdf:datatype="http://www.w3.org/2001/XMLSchema#int">1</aaif:position><aaif:coordinated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:coordinated><aaif:morphosyntacticStructure rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Adjective" /><aaif:inflection rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Uninflected" /><aaif:attributionTarget rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Adjective" /><aaif:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:modified><aaif:semanticClassification rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Specification" /><aaif:reduplicated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:reduplicated><aaif:prepositionalPhrase rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:prepositionalPhrase></aaif:Adverb><aaif:Phrase rdf:about="https://gams.uni-graz.at/o:aaif.ptapmdeg#En1405Ph70"><aaif:verb rdf:resource="https://gams.uni-graz.at/o:aaif.ptapmdeg#En1405Ph70Ve1" /><aaif:adverb rdf:resource="https://gams.uni-graz.at/o:aaif.ptapmdeg#En1405Ph70Ad1" /><aaif:preposition rdf:resource="https://gams.uni-graz.at/o:aaif.ptapmdeg#En1405Ph70Pe1" /><aaif:text> ele ficou encucado aí foi lá no velho de  novo </aaif:text><aaif:annoText> ele ficou encucado aí [v|foi|ir|is] lá no velho [p|de|de]  [a|novo|novo|auvntnpn] </aaif:annoText></aaif:Phrase><aaif:Verb rdf:about="https://gams.uni-graz.at/o:aaif.ptapmdeg#En1405Ph70Ve1"><aaif:text>foi</aaif:text><aaif:lemma rdf:resource="https://gams.uni-graz.at/o:aaif.lemma#ir" /><aaif:position rdf:datatype="http://www.w3.org/2001/XMLSchema#int">1</aaif:position><aaif:coordinated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:coordinated><aaif:partOfText rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</aaif:partOfText><aaif:syntacticConstruction rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Intransitive" /></aaif:Verb><aaif:Adverb rdf:about="https://gams.uni-graz.at/o:aaif.ptapmdeg#En1405Ph70Ad1"><aaif:text>novo</aaif:text><aaif:lemma rdf:resource="https://gams.uni-graz.at/o:aaif.lemma#novo" /><aaif:position rdf:datatype="http://www.w3.org/2001/XMLSchema#int">3</aaif:position><aaif:coordinated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:coordinated><aaif:morphosyntacticStructure rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Adjective" /><aaif:inflection rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Uninflected" /><aaif:attributionTarget rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Verb" /><aaif:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:modified><aaif:semanticClassification rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Time" /><aaif:reduplicated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:reduplicated><aaif:prepositionalPhrase rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</aaif:prepositionalPhrase></aaif:Adverb><aaif:Preposition rdf:about="https://gams.uni-graz.at/o:aaif.ptapmdeg#En1405Ph70Pe1"><aaif:text>de</aaif:text><aaif:lemma rdf:resource="https://gams.uni-graz.at/o:aaif.lemma#de" /><aaif:position rdf:datatype="http://www.w3.org/2001/XMLSchema#int">2</aaif:position><aaif:contracted rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:contracted></aaif:Preposition><aaif:Phrase rdf:about="https://gams.uni-graz.at/o:aaif.ptapmdeg#En1405Ph71"><aaif:subject rdf:resource="https://gams.uni-graz.at/o:aaif.ptapmdeg#En1405Ph71Su1" /><aaif:verb rdf:resource="https://gams.uni-graz.at/o:aaif.ptapmdeg#En1405Ph71Ve1" /><aaif:adverb rdf:resource="https://gams.uni-graz.at/o:aaif.ptapmdeg#En1405Ph71Ad1" /><aaif:adverb rdf:resource="https://gams.uni-graz.at/o:aaif.ptapmdeg#En1405Ph71Ad2" /><aaif:text> mais ou menos isso aí ... só   num me lembro direito o que ele dizia</aaif:text><aaif:annoText> mais ou menos isso aí ... [a|só|só|aunnsnnn]  [s||ms] num me [v|lembro|lemrar|rs] [a|direito|direito|auvnmnnn] o que ele dizia</aaif:annoText></aaif:Phrase><aaif:Subject rdf:about="https://gams.uni-graz.at/o:aaif.ptapmdeg#En1405Ph71Su1"><aaif:position rdf:datatype="http://www.w3.org/2001/XMLSchema#int">2</aaif:position><aaif:gender rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Masculine" /><aaif:number rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Singular" /><aaif:overt rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:overt></aaif:Subject><aaif:Verb rdf:about="https://gams.uni-graz.at/o:aaif.ptapmdeg#En1405Ph71Ve1"><aaif:text>lembro</aaif:text><aaif:lemma rdf:resource="https://gams.uni-graz.at/o:aaif.lemma#lemrar" /><aaif:position rdf:datatype="http://www.w3.org/2001/XMLSchema#int">3</aaif:position><aaif:coordinated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:coordinated><aaif:partOfText rdf:datatype="h