aaif.ontology#Adjective" /><aaif:inflection rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Uninflected" /><aaif:attributionTarget rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Verb" /><aaif:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</aaif:modified><aaif:semanticClassification rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Manner" /><aaif:reduplicated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:reduplicated><aaif:prepositionalPhrase rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:prepositionalPhrase></aaif:Adverb><aaif:Entry rdf:about="https://gams.uni-graz.at/o:aaif.roadpaaif#En5"><aaif:phrase rdf:resource="https://gams.uni-graz.at/o:aaif.roadpaaif#En5Ph1" /><aaif:phrase rdf:resource="https://gams.uni-graz.at/o:aaif.roadpaaif#En5Ph2" /><aaif:phrase rdf:resource="https://gams.uni-graz.at/o:aaif.roadpaaif#En5Ph3" /><aaif:phrase rdf:resource="https://gams.uni-graz.at/o:aaif.roadpaaif#En5Ph4" /><aaif:phrase rdf:resource="https://gams.uni-graz.at/o:aaif.roadpaaif#En5Ph5" /><aaif:phrase rdf:resource="https://gams.uni-graz.at/o:aaif.roadpaaif#En5Ph6" /><aaif:phrase rdf:resource="https://gams.uni-graz.at/o:aaif.roadpaaif#En5Ph7" /><aaif:phrase rdf:resource="https://gams.uni-graz.at/o:aaif.roadpaaif#En5Ph8" /><aaif:phrase rdf:resource="https://gams.uni-graz.at/o:aaif.roadpaaif#En5Ph9" /><aaif:phrase rdf:resource="https://gams.uni-graz.at/o:aaif.roadpaaif#En5Ph10" /><aaif:phrase rdf:resource="https://gams.uni-graz.at/o:aaif.roadpaaif#En5Ph11" /><aaif:phrase rdf:resource="https://gams.uni-graz.at/o:aaif.roadpaaif#En5Ph12" /><aaif:phrase rdf:resource="https://gams.uni-graz.at/o:aaif.roadpaaif#En5Ph13" /><aaif:phrase rdf:resource="https://gams.uni-graz.at/o:aaif.roadpaaif#En5Ph14" /><aaif:phrase rdf:resource="https://gams.uni-graz.at/o:aaif.roadpaaif#En5Ph15" /><aaif:phrase rdf:resource="https://gams.uni-graz.at/o:aaif.roadpaaif#En5Ph16" /><aaif:phrase rdf:resource="https://gams.uni-g