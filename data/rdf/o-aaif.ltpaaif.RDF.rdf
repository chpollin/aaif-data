.uni-graz.at/o:aaif.ltpaaif#En1172Ph1Pe1"><aaif:text>ex</aaif:text><aaif:lemma rdf:resource="https://gams.uni-graz.at/o:aaif.lemma#ex" /><aaif:position rdf:datatype="http://www.w3.org/2001/XMLSchema#int">1</aaif:position><aaif:contracted rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:contracted></aaif:Preposition><aaif:Entry rdf:about="https://gams.uni-graz.at/o:aaif.ltpaaif#En1173"><aaif:phrase rdf:resource="https://gams.uni-graz.at/o:aaif.ltpaaif#En1173Ph1" /><aaif:source rdf:resource="https://gams.uni-graz.at/o:aaif.ltpaaif.bibl#Sen.dial." /><gams:textualContent>Est suspicax et qui spectare ludos cupiat et  ex  longinquo tutoque speculetur quos conlisit.</gams:textualContent><rel:isPartOf rdf:resource="https://gams.uni-graz.at/o:aaif.ltpaaif" /></aaif:Entry><aaif:Phrase rdf:about="https://gams.uni-graz.at/o:aaif.ltpaaif#En1173Ph1"><aaif:verb rdf:resource="https://gams.uni-graz.at/o:aaif.ltpaaif#En1173Ph1Ve1" /><aaif:adverb rdf:resource="https://gams.uni-graz.at/o:aaif.ltpaaif#En1173Ph1Ad1" /><aaif:preposition rdf:resource="https://gams.uni-graz.at/o:aaif.ltpaaif#En1173Ph1Pe1" /><aaif:text> ex  longinquo tutoque speculetur quos conlisit</aaif:text><aaif:annoText> [p|ex|ex]  [a|longinquo|longinquus|anvnlnpn] tutoque [v|speculetur|speculari|ts] quos conlisit</aaif:annoText></aaif:Phrase><aaif:Verb rdf:about="https://gams.uni-graz.at/o:aaif.ltpaaif#En1173Ph1Ve1"><aaif:text>speculetur</aaif:text><aaif:lemma rdf:resource="https://gams.uni-graz.at/o:aaif.lemma#speculari" /><aaif:position rdf:datatype="http://www.w3.org/2001/XMLSchema#int">3</aaif:position><aaif:coordinated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:coordinated><aaif:partOfText rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</aaif:partOfText><aaif:syntacticConstruction rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Transitive" /></aaif:Verb><aaif:Adverb rdf:about="https://gams.uni-graz.at/o:aaif.ltpaaif#En1173Ph1Ad1"><aaif:text>longinquo<