resource="https://gams.uni-graz.at/o:aaif.ltpaaif#En742Ph1Su1" /><aaif:verb rdf:resource="https://gams.uni-graz.at/o:aaif.ltpaaif#En742Ph1Ve1" /><aaif:adverb rdf:resource="https://gams.uni-graz.at/o:aaif.ltpaaif#En742Ph1Ad1" /><aaif:preposition rdf:resource="https://gams.uni-graz.at/o:aaif.ltpaaif#En742Ph1Pe1" /><aaif:text>quae disceptatio ex aequo , cum imperium patiendum sit, relicta est</aaif:text><aaif:annoText>quae [s|disceptatio|fs] [p|ex|ex] [a|aequo|aequus|annnmnpn] , cum imperium patiendum sit, [v|relicta|relinquere|is] est</aaif:annoText></aaif:Phrase><aaif:Subject rdf:about="https://gams.uni-graz.at/o:aaif.ltpaaif#En742Ph1Su1"><aaif:text>disceptatio</aaif:text><aaif:position rdf:datatype="http://www.w3.org/2001/XMLSchema#int">1</aaif:position><aaif:gender rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Feminine" /><aaif:number rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Singular" /><aaif:overt rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</aaif:overt></aaif:Subject><aaif:Verb rdf:about="https://gams.uni-graz.at/o:aaif.ltpaaif#En742Ph1Ve1"><aaif:text>relicta</aaif:text><aaif:lemma rdf:resource="https://gams.uni-graz.at/o:aaif.lemma#relinquere" /><aaif:position rdf:datatype="http://www.w3.org/2001/XMLSchema#int">4</aaif:position><aaif:coordinated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:coordinated><aaif:partOfText rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</aaif:partOfText><aaif:syntacticConstruction rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Intransitive" /></aaif:Verb><aaif:Adverb rdf:about="https://gams.uni-graz.at/o:aaif.ltpaaif#En742Ph1Ad1"><aaif:text>aequo</aaif:text><aaif:lemma rdf:resource="https://gams.uni-graz.at/o:aaif.lemma#aequus" /><aaif:position rdf:datatype="http://www.w3.org/2001/XMLSchema#int">3</aaif:position><aaif:coordinated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:coordinated><aaif:morphosyntacticStructure rdf:resource=