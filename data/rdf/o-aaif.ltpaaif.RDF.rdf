ositionalPhrase></aaif:Adverb><aaif:Preposition rdf:about="https://gams.uni-graz.at/o:aaif.ltpaaif#En1359Ph1Pe1"><aaif:text>ex</aaif:text><aaif:lemma rdf:resource="https://gams.uni-graz.at/o:aaif.lemma#ex" /><aaif:position rdf:datatype="http://www.w3.org/2001/XMLSchema#int">2</aaif:position><aaif:contracted rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:contracted></aaif:Preposition><aaif:Entry rdf:about="https://gams.uni-graz.at/o:aaif.ltpaaif#En1360"><aaif:phrase rdf:resource="https://gams.uni-graz.at/o:aaif.ltpaaif#En1360Ph1" /><aaif:source rdf:resource="https://gams.uni-graz.at/o:aaif.ltpaaif.bibl#Cels." /><gams:textualContent>Si discussus ex toto  dolor est, etiam ad vinum reverti, sed postea semper antequam quicquam aliud aquam bibere.</gams:textualContent><rel:isPartOf rdf:resource="https://gams.uni-graz.at/o:aaif.ltpaaif" /></aaif:Entry><aaif:Phrase rdf:about="https://gams.uni-graz.at/o:aaif.ltpaaif#En1360Ph1"><aaif:subject rdf:resource="https://gams.uni-graz.at/o:aaif.ltpaaif#En1360Ph1Su1" /><aaif:verb rdf:resource="https://gams.uni-graz.at/o:aaif.ltpaaif#En1360Ph1Ve1" /><aaif:adverb rdf:resource="https://gams.uni-graz.at/o:aaif.ltpaaif#En1360Ph1Ad1" /><aaif:preposition rdf:resource="https://gams.uni-graz.at/o:aaif.ltpaaif#En1360Ph1Pe1" /><aaif:text>Si discussus ex toto  dolor est</aaif:text><aaif:annoText>Si [v|discussus|discutere|is] [p|ex|ex] [a|toto|totus|anvnqnpn]  [s|dolor|ms] est</aaif:annoText></aaif:Phrase><aaif:Subject rdf:about="https://gams.uni-graz.at/o:aaif.ltpaaif#En1360Ph1Su1"><aaif:text>dolor</aaif:text><aaif:position rdf:datatype="http://www.w3.org/2001/XMLSchema#int">4</aaif:position><aaif:gender rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Masculine" /><aaif:number rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Singular" /><aaif:overt rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</aaif:overt></aaif:Subject><aaif:Verb rdf:about="https://gams.uni-graz.at/o:aaif.ltpaaif#En1360Ph1Ve1"><aaif:text>discussus</aaif:text><aaif:lemma rdf:resource="https://gams.uni-graz.at/o:aaif.lemma#discutere" /><aaif:position rdf:datatype="http://www.w3.org/2001/XMLSchema#int">1</aaif:position><aaif:coordinated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:coordinated><aaif:partOfText rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</aaif:partOfText><aaif:syntacticConstruction rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Intransitive" /></aaif:Verb><aaif:Adverb rdf:about="https://gams.uni-graz.at/o:aaif.ltpaaif#En1360Ph1Ad1"><aaif:text>toto</aaif:text><aaif:lemma rdf:resource="https://gams.uni-graz.at/o:aaif.lemma#totus" /><aaif:position rdf:datatype="http://www.w3.org/2001/XMLSchema#int">3</aaif:position><aaif:coordinated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:coordinated><aaif:morphosyntacticStructure rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Adjective" /><aaif:inflection rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#NeuterSingular" /><aaif:attributionTarget rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Verb" /><aaif:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:modified><aaif:semanticClassification rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Quantity" /><aaif:reduplicated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:reduplicated><aaif:prepositionalPhrase rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</aaif:prepositionalPhrase></aaif:Adverb><aaif:Preposition rdf:about="https://gams.uni-graz.at/o:aaif.ltpaaif#En1360Ph1Pe1"><aaif:text>ex</aaif:text><aaif:lemma rdf:resource="https://gams.uni-graz.at/o:aaif.lemma#ex" /><aaif:position rdf:datatype="http://www.w3.org/2001/XMLSchema#int">2</aaif:position><aaif:contracted rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:contracted></aaif:Preposition><aaif:Entry rdf:about="https://gams.uni-graz.at/o:aaif.ltpaaif#En1361"><aaif:phrase rdf:resource="https://gams.uni-graz.at/o:aaif.ltpaaif#En1361Ph1" /><aaif:source rdf:resource="https://gams.uni-graz.at/o:aaif.ltpaaif.bibl#Cels." /><gams:textualContent>At si bene processerit iamque ex  toto recte se habere cervices videbuntur, incipiendum erit a pulticula vel intrita bene madida.</gams:textualContent><rel:isPartOf rdf:resource="https://gams.uni-graz.at/o:aaif.ltpaaif" /></aaif:Entry><aaif:Phrase rdf:about="https://gams.uni-graz.at/o:aaif.ltpaaif#En1361Ph1"><aaif:verb rdf:resource="https://gams.uni-graz.at/o:aaif.ltpaaif#En1361Ph1Ve1" /><aaif:adverb rdf:resource="https://gams.uni-graz.at/o:aaif.ltpaaif#En1361Ph1Ad1" /><aaif:preposition rdf:resource="https://gams.uni-graz.at/o:aaif.ltpaaif#En1361Ph1Pe1" /><aaif:text>iamque ex  toto recte se habere cervices videbuntur</aaif:text><aaif:annoText>iamque [p|ex|ex]  [a|toto|totus|anvnqnpn] recte se [v|habere|habere|ts] cervices videbuntur</aaif:annoText></aaif:Phrase><aaif:Verb rdf:about="https://gams.uni-graz.at/o:aaif.ltpaaif#En1361Ph1Ve1"><aaif:text>habere</aaif:text><aaif:lemma rdf:resource="https://gams.uni-graz.at/o:aaif.lemma#habere" /><aaif:position rdf:datatype="http://www.w3.org/2001/XMLSchema#int">3</aaif:position><aaif:coordinated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:coordinated><aaif:partOfText rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</aaif:partOfText><aaif:syntacticConstruction rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Transitive" /></aaif:Verb><aaif:Adverb rdf:about="https://gams.uni-graz.at/o:aaif.ltpaaif#En1361Ph1Ad1"><aaif:text>toto</aaif:text><aaif:lemma rdf:resource="https://gams.uni-graz.at/o:aaif.lemma#totus" /><aaif:position rdf:datatype="http://www.w3.org/2001/XMLSchema#int">2</aaif:position><aaif:coordinated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:coordinated><aaif:morphosyntacticStructure rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Adjective" /><aaif:inflection rdf:resource