pe="http://www.w3.org/2001/XMLSchema#int">3</aaif:position><aaif:coordinated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:coordinated><aaif:morphosyntacticStructure rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Adjective" /><aaif:inflection rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#NeuterSingular" /><aaif:attributionTarget rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Verb" /><aaif:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:modified><aaif:semanticClassification rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Manner" /><aaif:reduplicated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:reduplicated><aaif:prepositionalPhrase rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</aaif:prepositionalPhrase></aaif:Adverb><aaif:Preposition rdf:about="https://gams.uni-graz.at/o:aaif.ltpaaif#En794Ph1Pe1"><aaif:text>ex</aaif:text><aaif:lemma rdf:resource="https://gams.uni-graz.at/o:aaif.lemma#ex" /><aaif:position rdf:datatype="http://www.w3.org/2001/XMLSchema#int">2</aaif:position><aaif:contracted rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:contracted></aaif:Preposition><aaif:Entry rdf:about="https://gams.uni-graz.at/o:aaif.ltpaaif#En795"><aaif:phrase rdf:resource="https://gams.uni-graz.at/o:aaif.ltpaaif#En795Ph1" /><aaif:source rdf:resource="https://gams.uni-graz.at/o:aaif.ltpaaif.bibl#Gaius.inst." /><gams:textualContent>Alter alteri obligatur de eo, quod alterum alteri ex bono et aequo  praestare oportet.</gams:textualContent><rel:isPartOf rdf:resource="https://gams.uni-graz.at/o:aaif.ltpaaif" /></aaif:Entry><aaif:Phrase rdf:about="https://gams.uni-graz.at/o:aaif.ltpaaif#En795Ph1"><aaif:verb rdf:resource="https://gams.uni-graz.at/o:aaif.ltpaaif#En795Ph1Ve1" /><aaif:adverb rdf:resource="https://gams.uni-graz.at/o:aaif.ltpaaif#En795Ph1Ad1" /><aaif:preposition rdf:resource="https://gams.uni-graz.at/o:aaif.ltpaaif#En795Ph1Pe1" /><aaif:text>quod alterum alteri ex bono et aequo  praestare oportet</aaif:text><aaif:annoText>quod alterum alteri [p|ex|ex] bono et [a|aequo|aequus|anvnmnpC]  [v|praestare|praestare|ts] oportet</aaif:annoText></aaif:Phrase><aaif:Verb rdf:about="https://gams.uni-graz.at/o:aaif.ltpaaif#En795Ph1Ve1"><aaif:text>praestare</aaif:text><aaif:lemma rdf:resource="https://gams.uni-graz.at/o:aaif.lemma#praestare" /><aaif:position rdf:datatype="http://www.w3.org/2001/XMLSchema#int">3</aaif:position><aaif:coordinated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:coordinated><aaif:partOfText rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</aaif:partOfText><aaif:syntacticConstruction rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Transitive" /></aaif:Verb><aaif:Adverb rdf:about="https://gams.uni-graz.at/o:aaif.ltpaaif#En795Ph1Ad1"><aaif:text>aequo</aaif:text><aaif:lemma rdf:resource="https://gams.uni-graz.at/o:aaif.lemma#aequus" /><aaif:position rdf:datatype="http://www.w3.org/2001/XMLSchema#int">2</aaif:position><aaif:coordinated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</aaif:coordinated><aaif:morphosyntacticStructure rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Adjective" /><aaif:inflection rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#NeuterSingular" /><aaif:attributionTarget rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Verb" /><aaif:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:modified><aaif:semanticClassification rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Manner" /><aaif:reduplicated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:reduplicated><aaif:prepositionalPhrase rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</aaif:prepositionalPhrase></aaif:Adverb><aaif:Preposition rdf:about="https://gams.uni-graz.at/o:aaif.ltpaaif#En795Ph1Pe1"><aaif:text>ex</aaif:text><aaif:lemma rdf:resource="https://gams.uni-graz.at/o:aaif.lemma#ex" /><aaif:position rdf:datatype="http://www.w3.org/2001/XMLSchema#int">1</aaif:position><aaif:contracted rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:contracted></aaif:Preposition><aaif:Entry rdf:about="https://gams.uni-graz.at/o:aaif.ltpaaif#En796"><aaif:phrase rdf:resource="https://gams.uni-graz.at/o:aaif.ltpaaif#En796Ph1" /><aaif:source rdf:resource="https://gams.uni-graz.at/o:aaif.ltpaaif.bibl#Suet.Tib." /><gams:textualContent>Sine lictore aut viatore gymnasio interdum obambulans mutuaque cum Graeculis officia usurpans prope ex  aequo .</gams:textualContent><rel:isPartOf rdf:resource="https://gams.uni-graz.at/o:aaif.ltpaaif" /></aaif:Entry><aaif:Phrase rdf:about="https://gams.uni-graz.at/o:aaif.ltpaaif#En796Ph1"><aaif:verb rdf:resource="https://gams.uni-graz.at/o:aaif.ltpaaif#En796Ph1Ve1" /><aaif:adverb rdf:resource="https://gams.uni-graz.at/o:aaif.ltpaaif#En796Ph1Ad1" /><aaif:preposition rdf:resource="https://gams.uni-graz.at/o:aaif.ltpaaif#En796Ph1Pe1" /><aaif:text>mutuaque cum Graeculis officia usurpans prope ex  aequo </aaif:text><aaif:annoText>mutuaque cum Graeculis officia [v|usurpans|usurpare|ts] prope [p|ex|ex]  [a|aequo|aequus|ananmnpn] </aaif:annoText></aaif:Phrase><aaif:Verb rdf:about="https://gams.uni-graz.at/o:aaif.ltpaaif#En796Ph1Ve1"><aaif:text>usurpans</aaif:text><aaif:lemma rdf:resource="https://gams.uni-graz.at/o:aaif.lemma#usurpare" /><aaif:position rdf:datatype="http://www.w3.org/2001/XMLSchema#int">1</aaif:position><aaif:coordinated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:coordinated><aaif:partOfText rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</aaif:partOfText><aaif:syntacticConstruction rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Transitive" /></aaif:Verb><aaif:Adverb rdf:about="https://gams.uni-graz.at/o:aaif.ltpaaif#En796Ph1Ad1"><aaif:text>aequo</aaif:text><aaif:lemma rdf:resource="https://gams.uni-graz.at/o:aaif.lemma#aequus" /><aaif:position rdf:datatype="http://www.w3.org/2001/XMLSchema#int">3</aaif:position><aaif:coordinated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:coordinated><aaif:morphosyntacticStructure rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Adjective" /><aaif:inflection rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#NeuterSingular" /><aaif:attributionTarget rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Adjective" /><aaif:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:modified><aaif:semanticClassification rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Manner" /><aaif:reduplicated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:reduplicated><aaif:prepositionalPhrase rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</aaif:prepositionalPhrase></aaif:Adverb><aaif:Preposition rdf:about="https://gams.uni-graz.at/o:aaif.ltpaaif#En796Ph1Pe1"><aaif:text>ex</aaif:text><aaif:lemma rdf:resource="https://gams.uni-graz.at/o:aaif.lemma#ex" /><aaif:position rdf:datatype="http://www.w3.org/2001/XMLSchema#int">2</aaif:position><aaif:contracted rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:contracted></aaif:Preposition><aaif:Entry rdf:about="https://gams.uni-graz.at/o:aaif.ltpaaif#En797"><aaif:phrase rdf:resource="https://gams.uni-graz.at/o:aaif.ltpaaif#En797Ph1" /><aaif:source rdf:resource="https://gams.uni-graz.at/o:aaif.ltpaaif.bibl#Apul.Plat." /><gams:textualContent>Cum inops multitudo viribus obtinuerit adversus divitum facultates lexque e iussu populi fuerit promulgata, ut ex  aequo liceat omnibus honores capessere .</gams:textualContent><rel:isPartOf rdf:resource="https://gams.uni-graz.at/o:aaif.ltpaaif" /></aaif:Entry><aaif:Phrase rdf:about="https://gams.uni-graz.at/o:aaif.ltpaaif#En797Ph1"><aaif:verb rdf:resource="https://gams.uni-graz.at/o:aaif.ltpaaif#En797Ph1Ve1" /><aaif:adverb rdf:resource="https://gams.uni-graz.at/o:aaif.ltpaaif#En797Ph1Ad1" /><aaif:preposition rdf:resource="https://gams.uni-graz.at/o:aaif.ltpaaif#En797Ph1Pe1" /><aaif:text>ut ex  aequo liceat omnibus honores capessere </aaif:text><aaif:annoText>ut [p|ex|ex]  [a|aequo|aequus|auvnmnpn] liceat omnibus honores [v|capessere|capessere|ts] </aaif:annoText></aaif:Phrase><aaif:Verb rdf:about="https://gams.uni-graz.at/o:aaif.ltpaaif#En797Ph1Ve1"><aaif:text>capessere</aaif:text><aaif:lemma rdf:resource="https://gams.uni-graz.at/o:aaif.lemma#capessere" /><aaif:position rdf:datatype="http://www.w3.org/2001/XMLSchema#int">3</aaif:position><aaif:coordinated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:coordinated><aaif:partOfText rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</aaif:partOfText><aaif:syntacticConstruction rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Transitive" /></aaif:Verb><aaif:Adverb rdf:about="https://gams.uni-graz.at/o:aaif.ltpaaif#En797Ph1Ad1"><aaif:text>aequo</aaif:text><aaif:lemma rdf:resource="https://gams.uni-graz.at/o:aaif.lemma#aequus" /><aaif:position rdf:datatype="http://www.w3.org/2001/XMLSchema#int">2</aaif:position><aaif:coordinated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:coordinated><aaif:morphosyntacticStructure rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Adjective" /><aaif:inflection rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Uninflected" /><aaif:attributionTarget rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Verb" /><aaif:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:modified><aaif:semanticClassification rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Manner" /><aaif:reduplicated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:reduplicated><aaif:prepositionalPhrase rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</aaif:prepositionalPhrase></aaif:Adverb><aaif:Preposition rdf:about="https://gams.uni-graz.at/o:aaif.ltpaaif#En797Ph1Pe1"><aaif:text>ex</aaif:text><aaif:lemma rdf:resource="https://gams.uni-graz.at/o:aaif.lemma#ex" /><aaif:position rdf:datatype="http://www.w3.org/2001/XMLSchema#int">1</aaif:position><aaif:contracted rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:contracted></aaif:Preposition><aaif:Entry rdf:about="https://gams.uni-graz.at/o:aaif.ltpaaif#En798"><aaif:phrase rdf:resource="https://gams.uni-graz.at/o:aaif.ltpaaif#En798Ph1" /><aaif:source rdf:resource="https://gams.uni-graz.at/o:aaif.ltpaaif.bibl#Plaut.Men." /><gams:textualContent>Voluptas nullast navitis, Messenio, / maior meo animo, quam quom ex  alto procul / terram conspiciunt .</gams:textualContent><rel:isPartOf rdf:resource="https://gams.uni-graz.at/o:aaif.ltpaaif" /></aaif:Entry><aaif:Phrase rdf:about="https://gams.uni-graz.at/o:aaif.ltpaaif#En798Ph1"><aaif:verb rdf:resource="https://gams.uni-graz.at/o:aaif.ltpaaif#En798Ph1Ve1" /><aaif:adverb rdf:resource="https://gams.uni-graz.at/o:aaif.ltpaaif#En798Ph1Ad1" /><aaif:preposition rdf:resource="https://gams.uni-graz.at/o:aaif.ltpaaif#En798Ph1Pe1" /><aaif:text>quom ex  alto procul \/ terram conspiciunt </aaif:text><aaif:annoText>quom [p|ex|ex]  [a|alto|altus|anAnlnpn] procul \/ terram [v|conspiciunt|cosnpicere|ts] </aaif:annoText></aaif:Phrase><aaif:Verb rdf:about="https://gams.uni-graz.at/o:aaif.ltpaaif#En798Ph1Ve1"><aaif:text>conspiciunt</aaif:text><aaif:lemma rdf:resource="https://gams.uni-graz.at/o:aaif.lemma#cosnpicere" /><aaif:position rdf:datatype="http://www.w3.org/2001/XMLSchema#int">3</aaif:position><aaif:coordinated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:coordinated><aaif:partOfText rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</aaif:partOfText><aaif:syntacticConstruction rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Transitive" /></aaif:Verb><aaif:Adverb rdf:about="https://gams.uni-graz.at/o:aaif.ltpaaif#En798Ph1Ad1"><aaif:text>alto</aaif:text><aaif:lemma rdf:resource="https://gams.uni-graz.at/o:aaif.lemma#altus" /><aaif:position rdf:datatype="http://www.w3.org/2001/XMLSchema#int">2</aaif:position><aaif:coordinated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:coordinated><aaif:morphosyntacticStructure rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Adjective" /><aaif:inflection rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#NeuterSingular" /><aaif:attributionTarget rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Adverb" /><aaif:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:modified><aaif:semanticClassification rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Location" /><aaif:reduplicated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:reduplicated><aaif:prepositionalPhrase rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</aaif:prepositionalPhrase></aaif:Adverb><aaif:Preposition rdf:about="https://gams.uni-graz.at/o:aaif.ltpaaif#En798Ph1Pe1"><aaif:text>ex</aaif:text><aaif:lemma rdf:resource="https://gams.uni-graz.at/o:aaif.lemma#ex" /><aaif:position rdf:datatype="http://www.w3.org/2001/XMLSchema#int">1</aaif:position><aaif:contracted rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:contracted></aaif:Preposition><aaif:Entry rdf:about="https://gams.uni-graz.at/o:aaif.ltpaaif#En799"><aaif:phrase rdf:resource="https://gams.uni-graz.at/o:aaif.ltpaaif#En799Ph1" /><aaif:source rdf:resource="https://gams.uni-graz.at/o:aaif.ltpaaif.bibl#Acc.trag." /><gams:textualContent>Cur vetera tam ex alto  adpetissis discidia, Agamemno?</gams:textualContent><rel:isPartOf rdf:resource="https://gams.uni-graz.at/o:aaif.ltpaaif" /></aaif:Entry><aaif:Phrase rdf:about="https://gams.uni-graz.at/o:aaif.ltpaaif#En799Ph1"><aaif:verb rdf:resource="https://gams.uni-graz.at/o:aaif.ltpaaif#En799Ph1Ve1" /><aaif:adverb rdf:resource="https://gams.uni-graz.at/o:aaif.ltpaaif#En799Ph1Ad1" /><aaif:preposition rdf:resource="https://gams.uni-graz.at/o:aaif.ltpaaif#En799Ph1Pe1" /><aaif:text