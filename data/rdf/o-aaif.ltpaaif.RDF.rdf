/www.w3.org/2001/XMLSchema#int">1</aaif:position><aaif:coordinated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:coordinated><aaif:partOfText rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</aaif:partOfText><aaif:syntacticConstruction rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Intransitive" /></aaif:Verb><aaif:Adverb rdf:about="https://gams.uni-graz.at/o:aaif.ltpaaif#En3190Ph1Ad1"><aaif:text>publico</aaif:text><aaif:lemma rdf:resource="https://gams.uni-graz.at/o:aaif.lemma#publicus" /><aaif:position rdf:datatype="http://www.w3.org/2001/XMLSchema#int">3</aaif:position><aaif:coordinated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:coordinated><aaif:morphosyntacticStructure rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Adjective" /><aaif:inflection rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#NeuterSingular" /><aaif:attributionTarget rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Verb" /><aaif:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:modified><aaif:semanticClassification rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Manner" /><aaif:reduplicated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:reduplicated><aaif:prepositionalPhrase rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</aaif:prepositionalPhrase></aaif:Adverb><aaif:Preposition rdf:about="https://gams.uni-graz.at/o:aaif.ltpaaif#En3190Ph1Pe1"><aaif:text>in</aaif:text><aaif:lemma rdf:resource="https://gams.uni-graz.at/o:aaif.lemma#in" /><aaif:position rdf:datatype="http://www.w3.org/2001/XMLSchema#int">2</aaif:position><aaif:contracted rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:contracted></aaif:Preposition><aaif:Entry rdf:about="https://gams.uni-graz.at/o:aaif.ltpaaif#En3191"><aaif:phrase rdf:resource="https://gams.uni-graz.at/o:aaif.ltpaaif#En3191Ph1" /><aaif:source rdf:resource="https://gams.uni-graz.at/o:aaif.ltpaaif.bibl#Sen.epist." /><gams:textualContent>Et sollicita urbe et armata comitatus hic fuerit in  publico , spadones duo, magis tamen viri quam ipse.</gams:textualContent><rel:isPartOf rdf:resource="https://gams.uni-graz.at/o:aaif.ltpaaif" /></aaif:Entry><aaif:Phrase rdf:about="https://gams.uni-graz.at/o:aaif.ltpaaif#En3191Ph1"><aaif:verb rdf:resource="https://gams.uni-graz.at/o:aaif.ltpaaif#En3191Ph1Ve1" /><aaif:adverb rdf:resource="https://gams.uni-graz.at/o:aaif.ltpaaif#En3191Ph1Ad1" /><aaif:preposition rdf:resource="https://gams.uni-graz.at/o:aaif.ltpaaif#En3191Ph1Pe1" /><aaif:text>Et sollicita urbe et armata comitatus hic fuerit in  publico </aaif:text><aaif:annoText>Et sollicita urbe et armata comitatus hic [v|fuerit|esse|is] [p|in|in]  [a|publico|publicus|anvnmnpn] </aaif:annoText></aaif:Phrase><aaif:Verb rdf:about="https://gams.uni-graz.at/o:aaif.ltpaaif#En3191Ph1Ve1"><aaif:text>fuerit</aaif:text><aaif:lemma rdf:resource="https://gams.uni-graz.at/o:aaif.lemma#esse" /><aaif:position rdf:datatype="http://www.w3.org/2001/XMLSchema#int">1</aaif:position><aaif:coordinated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:coordinated><aaif:partOfText rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</aaif:partOfText><aaif:syntacticConstruction rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Intransitive" /></aaif:Verb><aaif:Adverb rdf:about="https://gams.uni-graz.at/o:aaif.ltpaaif#En3191Ph1Ad1"><aaif:text>publico</aaif:text><aaif:lemma rdf:resource="https://gams.uni-graz.at/o:aaif.lemma#publicus" /><aaif:position rdf:datatype="http://www.w3.org/2001/XMLSchema#int">3</aaif:position><aaif:coordinated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:coordinated><aaif:morphosyntacticStructure rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Adjective" /><aaif:inflection rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#NeuterSingular" /><aaif:attributionTarget rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Verb" /><aaif:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:modified><aaif:semanticClassification rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Manner" /><aaif:reduplicated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:reduplicated><aaif:prepositionalPhrase rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</aaif:prepositionalPhrase></aaif:Adverb><aaif:Preposition rdf:about="https://gams.uni-graz.at/o:aaif.ltpaaif#En3191Ph1Pe1"><aaif:text>in</aaif:text><aaif:lemma rdf:resource="https://gams.uni-graz.at/o:aaif.lemma#in" /><aaif:position rdf:datatype="http://www.w3.org/2001/XMLSchema#int">2</aaif:position><aaif:contracted rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:contracted></aaif:Preposition><aaif:Entry rdf:about="https://gams.uni-graz.at/o:aaif.ltpaaif#En3192"><aaif:phrase rdf:resource="https://gams.uni-graz.at/o:aaif.ltpaaif#En3192Ph1" /><aaif:source rdf:resource="https://gams.uni-graz.at/o:aaif.ltpaaif.bibl#Sen.benef." /><gams:textualContent>Spectat et conscientiam suam dis aperuit semperque tamquam in publico  vivit  se magis veritus quam alios.</gams:textualContent><rel:isPartOf rdf:resource="https://gams.uni-graz.at/o:aaif.ltpaaif" /></aaif:Entry><aaif:Phrase rdf:about="https://gams.uni-graz.at/o:aaif.ltpaaif#En3192Ph1"><aaif:verb rdf:resource="https://gams.uni-graz.at/o:aaif.ltpaaif#En3192Ph1Ve1" /><aaif:adverb rdf:resource="https://gams.uni-graz.at/o:aaif.ltpaaif#En3192Ph1Ad1" /><aaif:preposition rdf:resource="https://gams.uni-graz.at/o:aaif.ltpaaif#En3192Ph1Pe1" /><aaif:text>semperque tamquam in publico  vivit </aaif:text><aaif:annoText>semperque tamquam [p|in|in] [a|publico|publicus|anvnmnpn]  [v|vivit|vivere|is] </aaif:annoText></aaif:Phrase><aaif:Verb rdf:about="https://gams.uni-graz.at/o:aaif.ltpaaif#En3192Ph1Ve1"><aaif:text>vivit</aaif:text><aaif:lemma rdf:resource="https://gams.uni-graz.at/o:aaif.lemma#vivere" /><aaif:position rdf:datatype="http: