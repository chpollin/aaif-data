xt><aaif:lemma rdf:resource="https://gams.uni-graz.at/o:aaif.lemma#in" /><aaif:position rdf:datatype="http://www.w3.org/2001/XMLSchema#int">2</aaif:position><aaif:contracted rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:contracted></aaif:Preposition><aaif:Entry rdf:about="https://gams.uni-graz.at/o:aaif.ltpaaif#En2424"><aaif:phrase rdf:resource="https://gams.uni-graz.at/o:aaif.ltpaaif#En2424Ph1" /><aaif:source rdf:resource="https://gams.uni-graz.at/o:aaif.ltpaaif.bibl#Cic.fam." /><gams:textualContent>Ea est enim conatus, quibus patefactis nullam sibi in  posterum non modo dignitatis, sed ne libertatis quidem partem reliquit.</gams:textualContent><rel:isPartOf rdf:resource="https://gams.uni-graz.at/o:aaif.ltpaaif" /></aaif:Entry><aaif:Phrase rdf:about="https://gams.uni-graz.at/o:aaif.ltpaaif#En2424Ph1"><aaif:verb rdf:resource="https://gams.uni-graz.at/o:aaif.ltpaaif#En2424Ph1Ve1" /><aaif:adverb rdf:resource="https://gams.uni-graz.at/o:aaif.ltpaaif#En2424Ph1Ad1" /><aaif:preposition rdf:resource="https://gams.uni-graz.at/o:aaif.ltpaaif#En2424Ph1Pe1" /><aaif:text>quibus patefactis nullam sibi in  posterum non modo dignitatis</aaif:text><aaif:annoText>quibus [v|patefactis|patefacere|is] nullam sibi [p|in|in]  [a|posterum|posterus|anantnpn] non modo dignitatis</aaif:annoText></aaif:Phrase><aaif:Verb rdf:about="https://gams.uni-graz.at/o:aaif.ltpaaif#En2424Ph1Ve1"><aaif:text>patefactis</aaif:text><aaif:lemma rdf:resource="https://gams.uni-graz.at/o:aaif.lemma#patefacere" /><aaif:position rdf:datatype="http://www.w3.org/2001/XMLSchema#int">1</aaif:position><aaif:coordinated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:coordinated><aaif:partOfText rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</aaif:partOfText><aaif:syntacticConstruction rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Intransitive" /></aaif:Verb><aaif:Adverb rdf:about="https://gams.uni-graz.at/o:aaif.ltpaaif#En2424Ph1Ad1"><aaif:text>posterum</