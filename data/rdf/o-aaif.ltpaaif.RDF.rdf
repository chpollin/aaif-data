tpaaif#En2609Ph1" /><aaif:source rdf:resource="https://gams.uni-graz.at/o:aaif.ltpaaif.bibl#Cic.part." /><gams:textualContent>Verba ponenda sunt quae vim habeant illustrandi nec ab usu sint […] in  primis que translata.</gams:textualContent><rel:isPartOf rdf:resource="https://gams.uni-graz.at/o:aaif.ltpaaif" /></aaif:Entry><aaif:Phrase rdf:about="https://gams.uni-graz.at/o:aaif.ltpaaif#En2609Ph1"><aaif:adverb rdf:resource="https://gams.uni-graz.at/o:aaif.ltpaaif#En2609Ph1Ad1" /><aaif:preposition rdf:resource="https://gams.uni-graz.at/o:aaif.ltpaaif#En2609Ph1Pe1" /><aaif:text>nec ab usu sint […] in  primis que translata</aaif:text><aaif:annoText>nec ab usu sint […] [p|in|in]  [a|primis|primus|anvnqnpn] que translata</aaif:annoText></aaif:Phrase><aaif:Adverb rdf:about="https://gams.uni-graz.at/o:aaif.ltpaaif#En2609Ph1Ad1"><aaif:text>primis</aaif:text><aaif:lemma rdf:resource="https://gams.uni-graz.at/o:aaif.lemma#primus" /><aaif:position rdf:datatype="http://www.w3.org/2001/XMLSchema#int">2</aaif:position><aaif:coordinated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:coordinated><aaif:morphosyntacticStructure rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Adjective" /><aaif:inflection rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#NeuterSingular" /><aaif:attributionTarget rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Verb" /><aaif:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:modified><aaif:semanticClassification rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Quantity" /><aaif:reduplicated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:reduplicated><aaif:prepositionalPhrase rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</aaif:prepositionalPhrase></aaif:Adverb><aaif:Preposition rdf:about="https://gams.uni-graz.at/o:aaif.ltpaaif#En2609Ph1Pe1"><aaif:text>in</aaif:text><aaif:lemma rdf:resource="https://gams.uni-graz.at/o:aaif.lemma#in" /><aaif:position