esource="https://gams.uni-graz.at/o:aaif.lemma#ad" /><aaif:position rdf:datatype="http://www.w3.org/2001/XMLSchema#int">1</aaif:position><aaif:contracted rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:contracted></aaif:Preposition><aaif:Entry rdf:about="https://gams.uni-graz.at/o:aaif.ltpaaif#En58"><aaif:phrase rdf:resource="https://gams.uni-graz.at/o:aaif.ltpaaif#En58Ph1" /><aaif:source rdf:resource="https://gams.uni-graz.at/o:aaif.ltpaaif.bibl#Varro.rust." /><gams:textualContent> Sedebat ad sinistram ei Cornelius Merula consulari familia ortus et Fircellius Pavo Reatinus, ad dextram  Minucius Pica et M. Petronius Passer.</gams:textualContent><rel:isPartOf rdf:resource="https://gams.uni-graz.at/o:aaif.ltpaaif" /></aaif:Entry><aaif:Phrase rdf:about="https://gams.uni-graz.at/o:aaif.ltpaaif#En58Ph1"><aaif:subject rdf:resource="https://gams.uni-graz.at/o:aaif.ltpaaif#En58Ph1Su1" /><aaif:verb rdf:resource="https://gams.uni-graz.at/o:aaif.ltpaaif#En58Ph1Ve1" /><aaif:adverb rdf:resource="https://gams.uni-graz.at/o:aaif.ltpaaif#En58Ph1Ad1" /><aaif:preposition rdf:resource="https://gams.uni-graz.at/o:aaif.ltpaaif#En58Ph1Pe1" /><aaif:text> Sedebat ad sinistram ei Cornelius Merula consulari familia ortus et Fircellius Pavo Reatinus, ad dextram  Minucius Pica</aaif:text><aaif:annoText> [v|Sedebat|sedere|is] ad sinistram ei Cornelius Merula consulari familia ortus et Fircellius Pavo Reatinus, [p|ad|ad] [a|dextram|dexter|afvnlnpn]  [s|Minucius|ms] Pica</aaif:annoText></aaif:Phrase><aaif:Subject rdf:about="https://gams.uni-graz.at/o:aaif.ltpaaif#En58Ph1Su1"><aaif:text>Minucius</aaif:text><aaif:position rdf:datatype="http://www.w3.org/2001/XMLSchema#int">4</aaif:position><aaif:gender rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Masculine" /><aaif:number rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Singular" /><aaif:overt rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</aaif:overt></aaif:Subject><aaif:Verb rdf:about="https://gam