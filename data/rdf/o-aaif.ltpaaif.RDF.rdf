ww.w3.org/2001/XMLSchema#boolean">true</aaif:overt></aaif:Subject><aaif:Verb rdf:about="https://gams.uni-graz.at/o:aaif.ltpaaif#En2252Ph1Ve1"><aaif:text>erant</aaif:text><aaif:lemma rdf:resource="https://gams.uni-graz.at/o:aaif.lemma#esse" /><aaif:position rdf:datatype="http://www.w3.org/2001/XMLSchema#int">4</aaif:position><aaif:coordinated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:coordinated><aaif:partOfText rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</aaif:partOfText><aaif:syntacticConstruction rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Intransitive" /></aaif:Verb><aaif:Adverb rdf:about="https://gams.uni-graz.at/o:aaif.ltpaaif#En2252Ph1Ad1"><aaif:text>occulto</aaif:text><aaif:lemma rdf:resource="https://gams.uni-graz.at/o:aaif.lemma#occultus" /><aaif:position rdf:datatype="http://www.w3.org/2001/XMLSchema#int">3</aaif:position><aaif:coordinated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:coordinated><aaif:morphosyntacticStructure rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Adjective" /><aaif:inflection rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#NeuterSingular" /><aaif:attributionTarget rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Verb" /><aaif:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:modified><aaif:semanticClassification rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Manner" /><aaif:reduplicated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:reduplicated><aaif:prepositionalPhrase rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</aaif:prepositionalPhrase></aaif:Adverb><aaif:Preposition rdf:about="https://gams.uni-graz.at/o:aaif.ltpaaif#En2252Ph1Pe1"><aaif:text>in</aaif:text><aaif:lemma rdf:resource="https://gams.uni-graz.at/o:aaif.lemma#in" /><aaif:position rdf:datatype="http://www.w3.org/2001/XMLSchema#int">2</aaif:position><aaif:contracted rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:contracted></aaif:Preposition><aaif:Entry rdf:about="https://gams.uni-graz.at/o:aaif.ltpaaif#En2253"><aaif:phrase rdf:resource="https://gams.uni-graz.at/o:aaif.ltpaaif#En2253Ph1" /><aaif:source rdf:resource="https://gams.uni-graz.at/o:aaif.ltpaaif.bibl#Varro.rust." /><gams:textualContent>Non est, ut fere non sunt in aprico loco, neque habeas in  opaco ubi facias, ut sunt sub rupibus ac montibus</gams:textualContent><rel:isPartOf rdf:resource="https://gams.uni-graz.at/o:aaif.ltpaaif" /></aaif:Entry><aaif:Phrase rdf:about="https://gams.uni-graz.at/o:aaif.ltpaaif#En2253Ph1"><aaif:verb rdf:resource="https://gams.uni-graz.at/o:aaif.ltpaaif#En2253Ph1Ve1" /><aaif:adverb rdf:resource="https://gams.uni-graz.at/o:aaif.ltpaaif#En2253Ph1Ad1" /><aaif:preposition rdf:resource="https://gams.uni-graz.at/o:aaif.ltpaaif#En2253Ph1Pe1" /><aaif:text>neque habeas in  opaco ubi facias</aaif:text><aaif:annoText>neque [v|habeas|habere|ts] [p|in|in]  [a|opaco|opacus|anvnmnpn] ubi facias</aaif:annoText></aaif:Phrase><aaif:Verb rdf:about="https://gams.uni-graz.at/o:aaif.ltpaaif#En2253Ph1Ve1"><aaif:text>habeas</aaif:text><aaif:lemma rdf:resource="https://gams.uni-graz.at/o:aaif.lemma#habere" /><aaif:position rdf:datatype="http://www.w3.org/2001/XMLSchema#int">1</aaif:position><aaif:coordinated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:coordinated><aaif:partOfText rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</aaif:partOfText><aaif:syntacticConstruction rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Transitive" /></aaif:Verb><aaif:Adverb rdf:about="https://gams.uni-graz.at/o:aaif.ltpaaif#En2253Ph1Ad1"><aaif:text>opaco</aaif:text><aaif:lemma rdf:resource="https://gams.uni-graz.at/o:aaif.lemma#opacus" /><aaif:position rdf:datatype="http://www.w3.org/2001/XMLSchema#int">3</aaif:position><aaif:coordinated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:coordinated><aaif:morphosyntacticStructure rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Adjective" /><aaif:inflection rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#NeuterSingular" /><aaif:attributionTarget rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Verb" /><aaif:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:modified><aaif:semanticClassification rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Manner" /><aaif:reduplicated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:reduplicated><aaif:prepositionalPhrase rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</aaif:prepositionalPhrase></aaif:Adverb><aaif:Preposition rdf:about="https://gams.uni-graz.at/o:aaif.ltpaaif#En2253Ph1Pe1"><aaif:text>in</aaif:text><aaif:lemma rdf:resource="https://gams.uni-graz.at/o:aaif.lemma#in" /><aaif:position rdf:datatype="http://www.w3.org/2001/XMLSchema#int">2</aaif:position><aaif:contracted rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:contracted></aaif:Preposition><aaif:Entry rdf:about="https://gams.uni-graz.at/o:aaif.ltpaaif#En2254"><aaif:phrase rdf:resource="https://gams.uni-graz.at/o:aaif.ltpaaif#En2254Ph1" /><aaif:source rdf:resource="https://gams.uni-graz.at/o:aaif.ltpaaif.bibl#Plin.nat." /><gams:textualContent>Simul umbrae quosdam repercussus ceteris,  qui et in  opaco clarius micant .</gams:textualContent><rel:isPartOf rdf:resource="https://gams.uni-graz.at/o:aaif.ltpaaif" /></aaif:Entry><aaif:Phrase rdf:about="https://gams.uni-graz.at/o:aaif.ltpaaif#En2254Ph1"><aaif:subject rdf:resource="https://gams.uni-graz.at/o:aaif.ltpaaif#En2254Ph1Su1" /><aaif:verb rdf:resource="https://gams.uni-graz.at/o:aaif.ltpaaif#En2254Ph1Ve1" /><aaif:adverb rdf:resource="https://gams.uni-graz.at/o:aaif.ltpaaif#En2254Ph1Ad1" /><aaif:preposition rdf:resource="https://gams.uni-graz.at/o:aaif.ltpaaif#En2254Ph1Pe1" /><aaif:text> qui et in  opaco clarius micant </aaif:text><aaif:annoText> [s|qui|mp] et [p|in|in]  [a|opaco|opacus|anvnmnpn] clarius [v|micant|micare|is] </aaif:annoText></aaif:Phrase><aaif:Subject rdf:about="https://gams.uni-graz.at/o:aaif.ltpaaif#En2254Ph1Su1"><aaif:text>qui</aaif:text><aaif:position rdf:datatype="http://www.w3.org/2001/XMLSchema#int">1</aaif:position><aaif:gender rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Masculine" /><aaif:number rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Plural" /><aaif:overt rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</aaif:overt></aaif:Subject><aaif:Verb rdf:about="https://gams.uni-graz.at/o:aaif.ltpaaif#En2254Ph1Ve1"><aaif:text>micant</aaif:text><aaif:lemma rdf:resource="https://gams.uni-graz.at/o:aaif.lemma#micare" /><aaif:position rdf:datatype="http://www.w3.org/2001/XMLSchema#int">4</aaif:position><aaif:coordinated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:coordinated><aaif:partOfText rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</aaif:partOfText><aaif:syntacticConstruction rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Intransitive" /></aaif:Verb><aaif:Adverb rdf:about="https://gams.uni-graz.at/o:aaif.ltpaaif#En2254Ph1Ad1"><aaif:text>opaco</aaif:text><aaif:lemma rdf:resource="https://gams.uni-graz.at/o:aaif.lemma#opacus" /><aaif:position rdf:datatype="http://www.w3.org/2001/XMLSchema#int">3</aaif:position><aaif:coordinated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:coordinated><aaif:morphosyntacticStructure rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Adjective" /><aaif:inflection rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#NeuterSingular" /><aaif:attributionTarget rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Verb" /><aaif:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:modified><aaif:semanticClassification rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Manner" /><aaif:reduplicated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:reduplicated><aaif:prepositionalPhrase rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</aaif:prepositionalPhrase></aaif:Adverb><aaif:Preposition rdf:about="https://gams.uni-graz.at/o:aaif.ltpaaif#En2254Ph1Pe1"><aaif:text>in</aaif:text><aaif:lemma rdf:resource="https://gams.uni-graz.at/o:aaif.lemma#in" /><aaif:position rdf:datatype="http://www.w3.org/2001/XMLSchema#int">2</aaif:position><aaif:contracted rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:contracted></aaif:Preposition><aaif:Entry rdf:about="https://gams.uni-graz.at/o:aaif.ltpaaif#En2255"><aaif:phrase rdf:resource="https://gams.uni-graz.at/o:aaif.ltpaaif#En2255Ph1" /><aaif:source rdf:resource="https://gams.uni-graz.at/o:aaif.ltpaaif.bibl#Plin.nat." /><gams:textualContent>Eosdem obumbrante tecto purpureos videri, sub caelo flammeos, contra radios solis scintillare, ceras signantibus his liquescere , quamvis in  opaco .</gams:textualContent><rel:isPartOf rdf:resource="https://gams.uni-graz.at/o:aaif.ltpaaif" /></aaif:Entry><aaif:Phrase rdf:about="https://gams.uni-graz.at/o:aaif.ltpaaif#En2255Ph1"><aaif:verb rdf:resource="https://gams.uni-graz.at/o:aaif.ltpaaif#En2255Ph1Ve1" /><aaif:adverb rdf:resource="https://gams.uni-graz.at/o:aaif.ltpaaif#En2255Ph1Ad1" /><aaif:preposition rdf:resource="https://gams.uni-graz.at/o:aaif.ltpaaif#En2255Ph1Pe1" /><aaif:text>ceras signantibus his liquescere , quamvis in  opaco </aaif:text><aaif:annoText>ceras signantibus his [v|liquescere|linquescere|ts] , quamvis [p|in|in]  [a|opaco|opacus|anvnmnpn] </aaif:annoText></aaif:Phrase><aaif:Verb rdf:about="https://gams.uni-graz.at/o:aaif.ltpaaif#En2255Ph1Ve1"><aaif:text>liquescere</aaif:text><aaif:lemma rdf:resource="https://gams.uni-graz.at/o:aaif.lemma#linquescere" /><aaif:position rdf:datatype="http://www.w3.org/2001/XMLSchema#int">1</aaif:position><aaif:coordinated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:coordinated><aaif:partOfText rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</aaif:partOfText><aaif:syntacticConstruction rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Transitive" /></aaif:Verb><aaif:Adverb rdf:about="https://gams.uni-graz.at/o:aaif.ltpaaif#En2255Ph1Ad1"><aaif:text>opaco</aaif:text><aaif:lemma rdf:resource="https://gams.uni-graz.at/o:aaif.lemma#opacus" /><aaif:position rdf:datatype="http://www.w3.org/2001/XMLSchema#int">3</aaif:position><aaif:coordinated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:coordinated><aaif:morphosyntacticStructure rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Adjective" /><aaif:inflection rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#NeuterSingular" /><aaif:attributionTarget rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Verb" /><aaif:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:modified><aaif:semanticClassification rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Manner" /><aaif:reduplicated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:reduplicated><aaif:prepositionalPhrase rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</aaif:prepositionalPhrase></aaif:Adverb><aaif:Preposition rdf:about="https://gams.uni-graz.at/o:aaif.ltpaaif#En2255Ph1Pe1"><aaif:text>in</aaif:text><aaif:lemma rdf:resource="https://gams.uni-graz.at/o:aaif.lemma#in" /><aaif:position rdf:datatype="http://www.w3.org/2001/XMLSchema#int">2</aaif:position><aaif:contracted rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:contracted></aaif:Preposition><aaif:Entry rdf:about="https://gams.uni-graz.at/o:aaif.ltpaaif#En2256"><aaif:phrase rdf:resource="https://gams.uni-graz.at/o:aaif.ltpaaif#En2256Ph1" /><aaif:source rdf:resource="https://gams.uni-graz.at/o:aaif.ltpaaif.bibl#Quint.inst." /><gams:textualContent>Excitanda mens et attollenda semper est, quae in eius modi secretis aut languescit et quendam velut in opaco  situm ducit.</gams:textualContent><rel:isPartOf rdf:resource="https://gams.uni-graz.at/o:aaif.ltpaaif" /></aaif:Entry><aaif:Phrase rdf:about="https://gams.uni-graz.at/o:aaif.ltpaaif#En2256Ph1"><aaif:verb rdf:resource="https://gams.uni-graz.at/o:aaif.ltpaaif#En2256Ph1Ve1" /><aaif:adverb rdf:resource="https://gams.uni-graz.at/o:aaif.ltpaaif#En2256Ph1Ad1" /><aaif:preposition rdf:resource="https://gams.uni-graz.at/o:aaif.ltpaaif#En2256Ph1Pe1" /><aaif:text>et quendam velut in opaco  situm ducit</aaif:text><aaif:annoText>et quendam velut [p|in|in] [a|opaco|opacus|anvnmnpn]  [v|situm|sinere|is] ducit</aaif:annoText></aaif:Phrase><aaif:Verb rdf:about="https://gams.uni-graz.at/o:aaif.ltpaaif#En2256Ph1Ve1"><aaif:text>situm</aaif:text><aaif:lemma rdf:resource="https://gams.uni-graz.at/o:aaif.lemma#sinere" /><aaif:position rdf:datatype="http://www.w3.org/2001/XMLSchema#int">3</aaif:position><aaif:coordinated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:coordinated><aaif:partOfText rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</aaif:partOfText><aaif:syntacticConstruction rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Intransitive" /></aaif:Verb><aaif:Adverb rdf:about="https://gams.uni-graz.at/o:aaif.ltpaaif#En2256Ph1Ad1"><aaif:text>opaco</aaif:text><aaif:lemma rdf:resource="https://gams.uni-graz.at/o:aaif.lemma#opacus" /><aaif:position rdf:datatype="http://www.w3.org/2001/XMLSchema#int">2</aaif:position><aaif:coordinated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:coordinated><aaif:morphosyntacticStructure rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Adjective" /><aaif:inflection rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#NeuterSingular" /><aaif:attributionTarget rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Verb" /><aaif:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:modified><aaif:semanticClassification rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Manner" /><aaif:reduplicated rdf:datatype="http://www.w