 /></aaif:Entry><aaif:Phrase rdf:about="https://gams.uni-graz.at/o:aaif.ltpaaif#En2889Ph1"><aaif:verb rdf:resource="https://gams.uni-graz.at/o:aaif.ltpaaif#En2889Ph1Ve1" /><aaif:adverb rdf:resource="https://gams.uni-graz.at/o:aaif.ltpaaif#En2889Ph1Ad1" /><aaif:preposition rdf:resource="https://gams.uni-graz.at/o:aaif.ltpaaif#En2889Ph1Pe1" /><aaif:text>Quorum in  primis inspici mores oportebit </aaif:text><aaif:annoText>Quorum [p|in|in]  [a|primis|primus|anvnqnpn] inspici mores [v|oportebit|oportere|ts] </aaif:annoText></aaif:Phrase><aaif:Verb rdf:about="https://gams.uni-graz.at/o:aaif.ltpaaif#En2889Ph1Ve1"><aaif:text>oportebit</aaif:text><aaif:lemma rdf:resource="https://gams.uni-graz.at/o:aaif.lemma#oportere" /><aaif:position rdf:datatype="http://www.w3.org/2001/XMLSchema#int">3</aaif:position><aaif:coordinated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:coordinated><aaif:partOfText rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</aaif:partOfText><aaif:syntacticConstruction rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Transitive" /></aaif:Verb><aaif:Adverb rdf:about="https://gams.uni-graz.at/o:aaif.ltpaaif#En2889Ph1Ad1"><aaif:text>primis</aaif:text><aaif:lemma rdf:resource="https://gams.uni-graz.at/o:aaif.lemma#primus" /><aaif:position rdf:datatype="http://www.w3.org/2001/XMLSchema#int">2</aaif:position><aaif:coordinated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:coordinated><aaif:morphosyntacticStructure rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Adjective" /><aaif:inflection rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#NeuterSingular" /><aaif:attributionTarget rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Verb" /><aaif:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:modified><aaif:semanticClassification rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Quantity" /><aaif:reduplicated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:reduplicated><aaif:prepositionalPhrase rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</aaif:prepositionalPhrase></aaif:Adverb><aaif:Preposition rdf:about="https://gams.uni-graz.at/o:aaif.ltpaaif#En2889Ph1Pe1"><aaif:text>in</aaif:text><aaif:lemma rdf:resource="https://gams.uni-graz.at/o:aaif.lemma#in" /><aaif:position rdf:datatype="http://www.w3.org/2001/XMLSchema#int">1</aaif:position><aaif:contracted rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:contracted></aaif:Preposition><aaif:Entry rdf:about="https://gams.uni-graz.at/o:aaif.ltpaaif#En2890"><aaif:phrase rdf:resource="https://gams.uni-graz.at/o:aaif.ltpaaif#En2890Ph1" /><aaif:source rdf:resource="https://gams.uni-graz.at/o:aaif.ltpaaif.bibl#Quint.inst." /><gams:textualContent>Quapropter in primis  evitandus , et in pueris praecipue, magister aridus, non minus quam teneris adhuc plantis siccum et sine umore ullo solum.</gams:textualContent><rel:isPartOf rdf:resource="https://gams.uni-graz.at/o:aaif.ltpaaif" /></aaif:Entry><aaif:Phrase rdf:about="https://gams.uni-graz.at/o:aaif.ltpaaif#En2890Ph1"><aaif:verb rdf:resource="https://gams.uni-graz.at/o:aaif.ltpaaif#En2890Ph1Ve1" /><aaif:adverb rdf:resource="https://gams.uni-graz.at/o:aaif.ltpaaif#En2890Ph1Ad1" /><aaif:preposition rdf:resource="https://gams.uni-graz.at/o:aaif.ltpaaif#En2890Ph1Pe1" /><aaif:text>Quapropter in primis  evitandus </aaif:text><aaif:annoText>Quapropter [p|in|in] [a|primis|primus|anvnqnpn]  [v|evitandus|evitare|is] </aaif:annoText></aaif:Phrase><aaif:Verb rdf:about="https://gams.uni-graz.at/o:aaif.ltpaaif#En2890Ph1Ve1"><aaif:text>evitandus</aaif:text><aaif:lemma rdf:resource="https://gams.uni-graz.at/o:aaif.lemma#evitare" /><aaif:position rdf:datatype="http://www.w3.org/2001/XMLSchema#int">3</aaif:position><aaif:coordinated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:coordinated><aaif:partOfText rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</aaif:partOfText><aaif:syntacticConstruction rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Intransitive" /></aaif:Verb><aaif:Adverb rdf:about="https://gams.uni-graz.at/o:aaif.ltpaaif#En2890Ph1Ad1"><aaif:text>primis</aaif:text><aaif:lemma rdf:resource="https://gams.uni-graz.at/o:aaif.lemma#primus" /><aaif:position rdf:datatype="http://www.w3.org/2001/XMLSchema#int">2</aaif:position><aaif:coordinated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:coordinated><aaif:morphosyntacticStructure rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Adjective" /><aaif:inflection rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#NeuterSingular" /><aaif:attributionTarget rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Verb" /><aaif:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:modified><aaif:semanticClassification rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Quantity" /><aaif:reduplicated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:reduplicated><aaif:prepositionalPhrase rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</aaif:prepositionalPhrase></aaif:Adverb><aaif:Preposition rdf:about="https://gams.uni-graz.at/o:aaif.ltpaaif#En2890Ph1Pe1"><aaif:text>in</aaif:text><aaif:lemma rdf:resource="https://gams.uni-graz.at/o:aaif.lemma#in" /><aaif:position rdf:datatype="http://www.w3.org/2001/XMLSchema#int">1</aaif:position><aaif:contracted rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:contracted></aaif:Preposition><aaif:Entry rdf:about="https://gams.uni-graz.at/o:aaif.ltpaaif#En2891"><aaif:phrase rdf:resource="https://gams.uni-graz.at/o:aaif.ltpaaif#En2891Ph1" /><aaif:source rdf:resource="https://gams.uni-graz.at/o:aaif.ltpaaif.bibl#Quint.inst." /><gams:textualContent>Nos autem ingressi formare perfectum oratorem, quem in  primis esse virum bonum volumus , ad eos qui de hoc opere melius sentiunt revertamur.</gams:textualContent><rel:isPartOf rdf:resource="https://gams.uni-graz.at/o:aaif.ltpaaif" /></aaif:Entry><aaif:Phrase rdf:about="https://gams.uni-graz.at/o:aaif.ltpaaif#En2891Ph1"><aaif:verb rdf:resource="https://gams.uni-graz.at/o:aaif.ltpaaif#En2891Ph1Ve1" /><aaif:adverb rdf:resource="https://gams.uni-graz.at/o:aaif.ltpaaif#En2891Ph1Ad1" /><aaif:preposition rdf:resource="https://gams.uni-graz.at/o:aaif.ltpaaif#En2891Ph1Pe1" /><aaif:text>quem in  primis esse virum bonum volumus </aaif:text><aaif:annoText>quem [p|in|in]  [a|primis|primus|anvnqnpn] esse virum bonum [v|volumus|velle|ts] </aaif:annoText></aaif:Phrase><aaif:Verb rdf:about="https://gams.uni-graz.at/o:aaif.ltpaaif#En2891Ph1Ve1"><aaif:text>volumus</aaif:text><aaif:lemma rdf:resource="https://gams.uni-graz.at/o:aaif.lemma#velle" /><aaif:position rdf:datatype="http://www.w3.org/2001/XMLSchema#int">3</aaif:position><aaif:coordinated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:coordinated><aaif:partOfText rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</aaif:partOfText><aaif:syntacticConstruction rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Transitive" /></aaif:Verb><aaif:Adverb rdf:about="https://gams.uni-graz.at/o:aaif.ltpaaif#En2891Ph1Ad1"><aaif:text>primis</aaif:text><aaif:lemma rdf:resource="https://gams.uni-graz.at/o:aaif.lemma#primus" /><aaif:position rdf:datatype="http://www.w3.org/2001/XMLSchema#int">2</aaif:position><aaif:coordinated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:coordinated><aaif:morphosyntacticStructure rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Adjective" /><aaif:inflection rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#NeuterSingular" /><aaif:attributionTarget rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Verb" /><aaif:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:modified><aaif:semanticClassification rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Quantity" /><aaif:reduplicated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:reduplicated><aaif:prepositionalPhrase rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</aaif:prepositionalPhrase></aaif:Adverb><aaif:Preposition rdf:about="https://gams.uni-graz.at/o:aaif.ltpaaif#En2891Ph1Pe1"><aaif:text>in</aaif:text><aaif:lemma rdf:resource="https://gams.uni-graz.at/o:aaif.lemma#in" /><aaif:position rdf:datatype="http://www.w3.org/2001/XMLSchema#int">1</aaif:position><aaif:contracted rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:contracted></aaif:Preposition><aaif:Entry rdf:about="https://gams.uni-graz.at/o:aaif.ltpaaif#En2892"><aaif:phrase rdf:resource="https://gams.uni-graz.at/o:aaif.ltpaaif#En2892Ph1" /><aaif:source rdf:resource="https://gams.uni-graz.at/o:aaif.ltpaaif.bibl#Quint.inst." /><gams:textualContent>Si vero est bene dicendi scientia, quem nos finem sequimur, ut sit orator in  primis vir bonus, utilem certe esse eam confitendum est.</gams:textualContent><rel:isPartOf rdf:resource="https://gams.uni-graz.at/o:aaif.ltpaaif" /></aaif:Entry><aaif:Phrase rdf:about="https://gams.uni-graz.at/o:aaif.ltpaaif#En2892Ph1"><aaif:adverb rdf:resource="https://gams.uni-graz.at/o:aaif.ltpaaif#En2892Ph1Ad1" /><aaif:preposition rdf:resource="https://gams.uni-graz.at/o:aaif.ltpaaif#En2892Ph1Pe1" /><aaif:text>ut sit orator in  primis vir bonus</aaif:text><aaif:annoText>ut sit orator [p|in|in]  [a|primis|primus|ananqnpn] vir bonus</aaif:annoText></aaif:Phrase><aaif:Adverb rdf:about="https://gams.uni-graz.at/o:aaif.ltpaaif#En2892Ph1Ad1"><aaif:text>primis</aaif:text><aaif:lemma rdf:resource="https://gams.uni-graz.at/o:aaif.lemma#primus" /><aaif:position rdf:datatype="http://www.w3.org/2001/XMLSchema#int">2</aaif:position><aaif:coordinated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:coordinated><aaif:morphosyntacticStructure rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Adjective" /><aaif:inflection rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#NeuterSingular" /><aaif:attributionTarget rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Adjective" /><aaif:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:modified><aaif:semanticClassification rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Quantity" /><aaif:reduplicated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:reduplicated><aaif:prepositionalPhrase rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</aaif:prepositionalPhrase></aaif:Adverb><aaif:Preposition rdf:about="https://gams.uni-graz.at/o:aaif.ltpaaif#En2892Ph1Pe1"><aaif:text>in</aaif:text><aaif:lemma rdf:resource="https://gams.uni-graz.at/o:aaif.lemma#in" /><aaif:position rdf:datatype="http://www.w3.org/2001/XMLSchema#int">1</aaif:position><aaif:contracted rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:contracted></aaif:Preposition><aaif:Entry rdf:about="https://gams.uni-graz.at/o:aaif.ltpaaif#En2893"><aaif:phrase rdf:resource="https://gams.uni-graz.at/o:aaif.ltpaaif#En2893Ph1" /><aaif:source rdf:resource="https://gams.uni-graz.at/o:aaif.ltpaaif.bibl#Quint.inst." /><gams:textualContent>Quid in eo et per quae velit efficere pars diversa, quid nostra, quod in  primis est intuendum , nihil eorum ignorare de quibus supra diximus poterit.</gams:textualContent><rel:isPartOf rdf:resource="https://gams.uni-graz.at/o:aaif.ltpaaif" /></aaif:Entry><aaif:Phrase rdf:about="https://gams.uni-graz.at/o:aaif.ltpaaif#En2893Ph1"><aaif:verb rdf:resource="https://gams.uni-graz.at/o:aaif.ltpaaif#En2893Ph1Ve1" /><aaif:adverb rdf:resource="https://gams.uni-graz.at/o:aaif.ltpaaif#En2893Ph1Ad1" /><aaif:preposition rdf:resource="https://gams.uni-graz.at/o:aaif.ltpaaif#En2893Ph1Pe1" /><aaif:text>quod in  primis est intuendum </aaif:text><aaif:annoText>quod [p|in|in]  [a|primis|primus|anvnqnpn] est [v|intuendum|intueri|is] </aaif:annoText></aaif:Phrase><aaif:Verb rdf:about="https://gams.uni-graz.at/o:aaif.ltpaaif#En2893Ph1Ve1"><aaif:text>intuendum</aaif:text><aaif:lemma rdf:resource="https://gams.uni-graz.at/o:aaif.lemma#intueri" /><aaif:position rdf:datatype="http://www.w3.org/2001/XMLSchema#int">3</aaif:position><aaif:coordinated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:coordinated><aaif:partOfText rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</aaif:partOfText><aaif:syntacticConstruction rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Intransitive" /></aaif:Verb><aaif:Adverb rdf:about="https://gams.uni-graz.at/o:aaif.ltpaaif#En2893Ph1Ad1"><aaif:text>primis</aaif:text><aaif:lemma rdf:resource="https://gams.uni-graz.at/o:aaif.lemma#primus" /><aaif:position rdf:datatype="http://www.w3.org/2001/XMLSchema#int">2</aaif:position><aaif:coordinated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:coordinated><aaif:morphosyntacticStructure rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Adjective" /><aaif:inflection rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#NeuterSingular" /><aaif:attributionTarget rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Verb" /><aaif:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:modified><aaif:semanticClassification rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Quantity" /><aaif:reduplicated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:reduplicated><aaif:prepositionalPhrase rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</aaif:prepositionalPhrase></aaif:Adverb><aaif:Preposition rdf:about="https://gams.uni-graz.at/o:aaif.ltpaaif#En2893Ph1Pe1"><aaif:text>in</aaif:text><aaif:lemma rdf:resource="https://gams.uni-graz.at/o:aaif.lemma#in" /><aaif:position rdf:datatype="http://www.w3.org/2001/XMLSchema#int">1</aaif:position><aaif:contracted rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:contracted></aaif:Preposition><aaif:Entry rdf:about="https://gams.uni-graz.at/o:aaif.ltpaaif#En2894"><aaif:phrase rdf:resource="https://gams.uni-graz.at/o:aaif.ltpaaif#En2894Ph1" /><aaif:source rdf:resource="https://gams.uni-graz.at/o:aaif.ltpaaif.bibl#Quint.inst." /><gams:textualContent>Mihi quoque profecto poterit ignosci si, quod initio quo primum hanc materiam inchoavi non feceram, nunc omnis in auxilium deos ipsumque in  primis  quo neque praesentius aliud nec studiis magis propitium numen est invocem.</gams:textualContent><rel:isPartOf rdf:resource="https://gams.uni-graz.at/o:aaif.ltpaaif" /></aaif:Entry><aaif:Phrase rdf:about="https://gams.uni-graz.at/o:aaif.ltpaaif#En2894Ph1"><aaif:adverb rdf:resource="https://gams.uni-graz.at/o:aaif.ltpaaif#En2894Ph1Ad1" /><aaif:preposition rdf:resource="https://gams.uni-graz.at/o:aaif.ltpaaif#En2894Ph1Pe1" /><aaif:text>nunc omnis in auxilium deos ipsumque in  primis </aaif:text><aaif:annoText>nunc omnis in auxilium deos ipsumque [p|in|in]  [a|primis|primus|annntnpn] </aaif:annoText></aaif:Phrase><aaif:Adverb rdf:about="https://gams.uni-graz.at/o:aaif.ltpaaif#En2894Ph1Ad1"><aaif:text>primis</aaif:text><aaif:lemma rdf:resource="https://gams.uni-graz.at/o:aaif.lemma#primus" /><aaif:position rdf:datatype="http://www.w3.org/2001/XMLSchema#int">2</aaif:position><aaif:coordinated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:coordinated><aaif:morphosyntacticStructure rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Adjective" /><aaif:inflection rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#NeuterSingular" /><aaif:attributionTarget rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Noun" /><aaif:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:modified><aaif:semanticClassification rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Time" /><aaif:reduplicated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:reduplicated><aaif:prepositionalPhrase rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</aaif:prepositionalPhrase></aaif:Adverb><aaif:Preposition rdf:about="https://gams.uni-graz.at/o:aaif.ltpaaif#En2894Ph1Pe1"><aaif:text>in</aaif:text><aaif:lemma rdf:resource="https://gams.uni-graz.at/o:aaif.lemma#in" /><aaif:position rdf:datatype="http://www.w3.org/2001/XMLSchema#int">1</aaif:position><aaif:contracted rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:contracted></aaif:Preposition><aaif:Entry rdf:about="https://gams.uni-graz.at/o:aaif.ltpaaif#En2895"><aaif:phrase rdf:resource="https://gams.uni-graz.at/o:aaif.ltpaaif#En2895Ph1" /><aaif:source rdf:resource="https://gams.uni-graz.at/o:aaif.ltpaaif.bibl#Quint.inst." /><gams:textualContent>Quare in primis  existimetur venisse ad agendum ductus officio vel cognationis vel amicitiae, maximeque, si fieri poterit, rei publicae aut alicuius certe non mediocris exempli.</gams:textualContent><rel:isPartOf rdf:resource="https://gams.uni-graz.at/o:aaif.ltpaaif" /></aaif:Entry><aaif:Phrase rdf:about="https://gams.uni-graz.at/o:aaif.ltpaaif#En2895Ph1"><aaif:verb rdf:resource="https://gams.uni-graz.at/o:aaif.ltpaaif#En2895Ph1Ve1" /><aaif:adverb rdf:resource="https://gams.uni-graz.at/o:aaif.ltpaaif#En2895Ph1Ad1" /><aaif:preposition rdf:resource="https://gams.uni-graz.at/o:aaif.ltpaaif#En2895Ph1Pe1" /><aaif:text>Quare in primis  existimetur venisse ad agendum ductus officio vel cognationis vel amicitiae</aaif:text><aaif:annoText>Quare [p|in|in] [a|primis|primus|anvnqnpn]  [v|existimetur|existimare|is] venisse ad agendum ductus officio vel cognationis vel amicitiae</aaif:annoText></aaif:Phrase><aaif:Verb rdf:about="https://gams.uni-graz.at/o:aaif.ltpaaif#En2895Ph1Ve1"><aaif:text>existimetur</aaif:text><aaif:lemma rdf:resource="https://gams.uni-graz.at/o:aaif.lemma#existimare" /><aaif:position rdf:datatype="http://www.w3.org/2001/XMLSchema#int">3</aaif:position><aaif:coordinated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:coordinated><aaif:partOfText rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</aaif:partOfText><aaif:syntacticConstruction rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Intransitive" /></aaif:Verb><aaif:Adverb rdf:about="https://gams.uni-graz.at/o:aaif.ltpaaif#En2895Ph1Ad1"><aaif:text>primis</aaif:text><aaif:lemma rdf:resource="https://gams.uni-graz.at/o:aaif.lemma#primus" /><aaif:position rdf:datatype="http://www.w3.org/2001/XMLSchema#int">2</aaif:position><aaif:coordinated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:coordinated><aaif:morphosyntacticStructure rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Adjective" /><aaif:inflection rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#NeuterSingular" /><aaif:attributionTarget rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Verb" /><aaif:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:modified><aaif:semanticClassification rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Quantity" /><aaif:reduplicated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:reduplicated><aaif:prepositionalPhrase rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</aaif:prepositionalPhrase></aaif:Adverb><aaif:Preposition rdf:about="https://gams.uni-graz.at/o:aaif.ltpaaif#En2895Ph1Pe1"><aaif:text>in</aaif:text><aaif:lemma rdf:resource="https://gams.uni-graz.at/o:aaif.lemma#in" /><aaif:position rdf:datatype="http://www.w3.org/2001/XMLSchema#int">1</aaif:position><aaif:contracted rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:contracted></aaif:Preposition><aaif:Entry rdf:about="https://gams.uni-graz.at/o:aaif.ltpaaif#En2896"><aaif:phrase rdf:resource="https://gams.uni-graz.at/o:aaif.ltpaaif#En2896Ph1" /><aaif:source rdf:resource="https://gams.uni-graz.at/o:aaif.ltpaaif.bibl#Quint.inst." /><gams:textualContent> In  primis igitur argumenta saepe a persona ducenda sunt.</gams:textualContent><rel:isPartOf rdf:resource="https://gams.uni-graz.at/o:aaif.ltpaaif" /></aaif:Entry><aaif:Phrase rdf:about="https://gams.uni-graz.at/o:aaif.ltpaaif#En2896Ph1"><aaif:verb rdf:resource="https://gams.uni-graz.at/o:aaif.ltpaaif#En2896Ph1Ve1" /><aaif:adverb rdf:resource="https://gams.uni-graz.at/o:aaif.ltpaaif#En2896Ph1Ad1" /><aaif:preposition rdf:resource="https://gams.uni-graz.at/o:aaif.ltpaaif#En2896Ph1Pe1" /><aaif:text> In  primis igitur argumenta saepe a persona ducenda sunt</aaif:text><aaif:annoText> [p|In|in]  [a|primis|primus|anvnqnpn] igitur argumenta saepe a persona [v|ducenda|ducere|is] sunt</aaif:annoText></aaif:Phrase><aaif:Verb rdf:about="https://gams.uni-graz.at/o:aaif.ltpaaif#En2896Ph1Ve1"><aaif:text>ducenda</aaif:text><aaif:lemma rdf:resource="https://gams.uni-graz.at/o:aaif.lemma#ducere" /><aaif:position rdf:datatype="http://www.w3.org/2001/XMLSchema#int">3</aaif:position><aaif:coordinated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:coordinated><aaif:partOfText rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</aaif:partOfText><aaif:syntacticConstruction rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Intransitive" /></aaif:Verb><aaif:Adverb rdf:about="https://gams.uni-graz.at/o:aaif.ltpaaif#En2896Ph1Ad1"><aaif:text>primis</aaif:text><aaif:lemma rdf:resource="https://gams.uni-graz.at/o:aaif.lemma#primus" /><aaif:position rdf:datatype="http://www.w3.org/2001/XMLSchema#int">2</aaif:position><aaif:coordinated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:coordinated><aaif:morphosyntacticStructure rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Adjective" /><aaif:inflection rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#NeuterSingular" /><aaif:attributionTarget rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Verb" /><aaif:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:modified><aaif:semanticClassification rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Quantity" /><aaif:reduplicated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:reduplicated><aaif:prepositionalPhrase rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</aaif:prepositionalPhrase></aaif:Adverb><aaif:Preposition rdf:about="https://gams.uni-graz.at/o:aaif.ltpaaif#En2896Ph1Pe1"><aaif:text>In</aaif:text><aaif:lemma rdf:resource="https://gams.uni-graz.at/o:aaif.lemma#in" /><aaif:position rdf:datatype="http://www.w3.org/2001/XMLSchema#int">1</aaif:position><aaif:contracted rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:contracted></aaif:Preposition><aaif:Entry rdf:about="https://gams.uni-graz.at/o:aaif.ltpaaif#En2897"><aaif:phrase rdf:resource="https://gams.uni-graz.at/o:aaif.ltpaaif#En2897Ph1" /><aaif:source rdf:resource="https://gams.uni-graz.at/o:aaif.ltpaaif.bibl#Quint.inst." /><gams:textualContent>Narrare quae salsa sint in  primis est subtile et oratorium, ut Cicero pro Cluentio narrat de Caepasio atque Fabricio.</gams:textualContent><rel:isPartOf rdf:resource="https://gams.uni-graz.at/o:aaif.ltpaaif" /></aaif:Entry><aaif:Phrase rdf:about="https://gams.uni-graz.at/o:aaif.ltpaaif#En2897Ph1"><aaif:adverb rdf:resource="https://gams.uni-graz.at/o:aaif.ltpaaif#En2897Ph1Ad1" /><aaif:preposition rdf:resource="https://gams.uni-graz.at/o:aaif.ltpaaif#En2897Ph1Pe1" /><aaif:text>Narrare quae salsa sint in  primis est subtile et oratorium</aaif:text><aaif:annoText>Narrare quae salsa sint [p|in|in]  [a|primis|primus|ananqnpn] est subtile et oratorium</aaif:annoText></aaif:Phrase><aaif:Adverb rdf:about="https://gams.uni-graz.at/o:aaif.ltpaaif#En2897Ph1Ad1"><aaif:text>primis</aaif:text><aaif:lemma rdf:resource="https://gams.uni-graz.at/o:aaif.lemma#primus" /><aaif:position rdf:datatype="http://www.w3.org/2001/XMLSchema#int">2</aaif:position><aaif:coordinated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:coordinated><aaif:morphosyntacticStructure rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Adjective" /><aaif:inflection rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#NeuterSingular" /><aaif:attributionTarget rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Adjective" /><aaif:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:modified><aaif:semanticClassification rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Quantity" /><aaif:reduplicated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:reduplicated><aaif:prepositionalPhrase rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</aaif:prepositionalPhrase></aaif:Adverb><aaif:Preposition rdf:about="https://gams.uni-graz.at/o:aaif.ltpaaif#En2897Ph1Pe1"><aaif:text>in</aaif:text><aaif:lemma rdf:resource="https://gams.uni-graz.at/o:aaif.lemma#in" /><aaif:position rdf:datatype="http://www.w3.org/2001/XMLSchema#int">1</aaif:position><aaif:contracted rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:contracted></aaif:Preposition><aaif:Entry rdf:about="https://gams.uni-graz.at/o:aaif.ltpaaif#En2898"><aaif:phrase rdf:resource="https://gams.uni-graz.at/o:aaif.ltpaaif#En2898Ph1" /><aaif:source rdf:resource="https://gams.uni-graz.at/o:aaif.ltpaaif.bibl#Quint.inst." /><gams:textualContent> In  primis ex amphibolia, neque illa obscura quae Atellanio more captant, nec qualia vulgo iactantur a vilissimo quoque, conversa in maledictum fere ambiguitate.</gams:textualContent><rel:isPartOf rdf:resource="https://gams.uni-graz.at/o:aaif.ltpaaif" /></aaif:Entry><aaif:Phrase rdf:about="https://gams.uni-graz.at/o:aaif.ltpaaif#En2898Ph1"><aaif:adverb rdf:resource="https://gams.uni-graz.at/o:aaif.ltpaaif#En2898Ph1Ad1" /><aaif:preposition rdf:resource="https://gams.uni-graz.at/o:aaif.ltpaaif#En2898Ph1Pe1" /><aaif:text> In  primis ex amphibolia, neque illa obscura quae Atellanio more captant, nec qualia vulgo iactantur a vilissimo quoque, conversa in maledictum fere ambiguitate</aaif:text><aaif:annoText> [p|In|in]  [a|primis|primus|annnqnpn] ex amphibolia, neque illa obscura quae Atellanio more captant, nec qualia vulgo iactantur a vilissimo quoque, conversa in maledictum fere ambiguitate</aaif:annoText></aaif:Phrase><aaif:Adverb rdf:about="https://gams.uni-graz.at/o:aaif.ltpaaif#En2898Ph1Ad1"><aaif:text>primis</aaif:text><aaif:lemma rdf:resource="https://gams.uni-graz.at/o:aaif.lemma#primus" /><aaif:position rdf:datatype="http://www.w3.org/2001/XMLSchema#int">2</aaif:position><aaif:coordinated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:coordinated><aaif:morphosyntacticStructure rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Adjective" /><aaif:inflection rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#NeuterSingular" /><aaif:attributionTarget rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Noun" /><aaif:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:modified><aaif:semanticClassification rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Quantity" /><aaif:reduplicated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:reduplicated><aaif:prepositionalPhrase rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</aaif:prepositionalPhrase></aaif:Adverb><aaif:Preposition rdf:about="https://gams.uni-graz.at/o:aaif.ltpaaif#En2898Ph1Pe1"><aaif:text>In</aaif:text><aaif:lemma rdf:resource="https://gams.uni-graz.at/o:aaif.lemma#in" /><aaif:position rdf:datatype="http://www.w3.org/2001/XMLSchema#int">1</aaif:position><aaif:contracted rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:contracted></aaif:Preposition><aaif:Entry rdf:about="https://gams.uni-graz.at/o:aaif.ltpaaif#En2899"><aaif:phrase rdf:resource="https://gams.uni-graz.at/o:aaif.ltpaaif#En2899Ph1" /><aaif:source rdf:resource="https://gams.uni-graz.at/o:aaif.ltpaaif.bibl#Quint.inst." /><gams:textualContent>Sed ea non ab hominibus modo petitur, verum etiam ab animalibus, ut nobis pueris Iunius Bassus, homo in  primis dicax, LVIII. "asinus albus" vocabatur.</gams:textualContent><rel:isPartOf rdf:resource="https://gams.uni-graz.at/o:aaif.ltpaaif" /></aaif:Entry><aaif:Phrase rdf:about="https://gams.uni-graz.at/o:aaif.ltpaaif#En2899Ph1"><aaif:adverb rdf:resource="https://gams.uni-graz.at/o:aaif.ltpaaif#En2899Ph1Ad1" /><aaif:preposition rdf:resource="https://gams.uni-graz.at/o:aaif.ltpaaif#En2899Ph1Pe1" /><aaif:text>homo in  primis dicax</aaif:text><aaif:annoText>homo [p|in|in]  [a|primis|primus|ananqnpn] dicax</aaif:annoText></aaif:Phrase><aaif:Adverb rdf:about="https://gams.uni-graz.at/o:aaif.ltpaaif#En2899Ph1Ad1"><aaif:text>primis</aaif:text><aaif:lemma rdf:resource="https://gams.uni-graz.at/o:aaif.lemma#primus" /><aaif:position rdf:datatype="http://www.w3.org/2001/XMLSchema#int">2</aaif:position><aaif:coordinated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:coordinated><aaif:morphosyntacticStructure rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Adjective" /><aaif:inflection rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#NeuterSingular" /><aaif:attributionTarget rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Adjective" /><aaif:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:modified><aaif:semanticClassification rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Quantity" /><aaif:reduplicated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:reduplicated><aaif:prepositionalPhrase rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</aaif:prepositionalPhrase></aaif:Adverb><aaif:Preposition rdf:about="https://gams.uni-graz.at/o:aaif.ltpaaif#En2899Ph1Pe1"><aaif:text>in</aaif:text><aaif:lemma rdf:resource="https://gams.uni-graz.at/o:aaif.lemma#in" /><aaif:position rdf:datatype="http://www.w3.org/2001/XMLSchema#int">1</aaif:position><aaif:contracted rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:contracted></aaif:Preposition><aaif:Entry rdf:about="https://gams.uni-graz.at/o:aaif.ltpaaif#En2900"><aaif:phrase rdf:resource="https://gams.uni-graz.at/o:aaif.ltpaaif#En2900Ph1" /><aaif:source rdf:resource="https://gams.uni-graz.at/o:aaif.ltpaaif.bibl#Quint.inst." /><gams:textualContent>Opus est igitur in  primis ingenio veloci ac mobili, animo praesenti et acri.</gams:textualContent><rel:isPartOf rdf:resource="https://gams.uni-graz.at/o:aaif.ltpaaif" /></aaif:Entry><aaif:Phrase rdf:about="https://gams.uni-graz.at/o:aaif.ltpaaif#En2900Ph1"><aaif:verb rdf:resource="https://gams.uni-graz.at/o:aaif.ltpaaif#En2900Ph1Ve1" /><aaif:adverb rdf:resource="https://gams.uni-graz.at/o:aaif.ltpaaif#En2900Ph1Ad1" /><aaif:preposition rdf:resource="https://gams.uni-graz.at/o:aaif.ltpaaif#En2900Ph1Pe1" /><aaif:text>Opus est igitur in  primis ingenio veloci ac mobili</aaif:text><aaif:annoText>Opus [v|est|esse|is] igitur [p|in|in]  [a|primis|primus|anvnqnpn] ingenio veloci ac mobili</aaif:annoText></aaif:Phrase><aaif:Verb rdf:about="https://gams.uni-graz.at/o:aaif.ltpaaif#En2900Ph1Ve1"><aaif:text>est</aaif:text><aaif:lemma rdf:resource="https://gams.uni-graz.at/o:aaif.lemma#esse" /><aaif:position rdf:datatype="http://www.w3.org/2001/XMLSchema#int">1</aaif:position><aaif:coordinated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:coordinated><aaif:partOfText rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</aaif:partOfText><aaif:syntacticConstruction rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Intransitive" /></aaif:Verb><aaif:Adverb rdf:about="https://gams.uni-graz.at/o:aaif.ltpaaif#En2900Ph1Ad1"><aaif:text>primis</aaif:text><aaif:lemma rdf:resource="https://gams.uni-graz.at/o:aaif.lemma#primus" /><aaif:position rdf:datatype="http://www.w3.org/2001/XMLSchema#int">3</aaif:position><aaif:coordinated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:coordinated><aaif:morphosyntacticStructure rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Adjective" /><aaif:inflection rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#NeuterSingular" /><aaif:attributionTarget rdf:resource="https://gam