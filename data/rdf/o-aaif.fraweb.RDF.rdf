inflected" /><aaif:attributionTarget rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Verb" /><aaif:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:modified><aaif:semanticClassification rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Manner" /><aaif:reduplicated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:reduplicated><aaif:prepositionalPhrase rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:prepositionalPhrase></aaif:Adverb><aaif:Entry rdf:about="https://gams.uni-graz.at/o:aaif.fraweb#En1443"><aaif:phrase rdf:resource="https://gams.uni-graz.at/o:aaif.fraweb#En1443Ph1" /><aaif:source rdf:resource="https://gams.uni-graz.at/o:aaif.fraweb.bibl#DC1443" /><gams:textualContent>Ha oui ça pour s'habiller court  la bas c'est pas un problème.Mais justement je trouve ça mieux, du coup y a moins de "bon je vais pas mettre ça parce qu'on va me regarder trop chelou"</gams:textualContent><rel:isPartOf rdf:resource="https://gams.uni-graz.at/o:aaif.fraweb" /></aaif:Entry><aaif:Phrase rdf:about="https://gams.uni-graz.at/o:aaif.fraweb#En1443Ph1"><aaif:verb rdf:resource="https://gams.uni-graz.at/o:aaif.fraweb#En1443Ph1Ve1" /><aaif:adverb rdf:resource="https://gams.uni-graz.at/o:aaif.fraweb#En1443Ph1Ad1" /><aaif:text>ça pour s'habiller court </aaif:text><aaif:annoText>ça pour [v|s'habiller|habiller|rs] [a|court|court|auonmnnn] </aaif:annoText></aaif:Phrase><aaif:Verb rdf:about="https://gams.uni-graz.at/o:aaif.fraweb#En1443Ph1Ve1"><aaif:text>s'habiller</aaif:text><aaif:lemma rdf:resource="https://gams.uni-graz.at/o:aaif.lemma#habiller" /><aaif:position rdf:datatype="http://www.w3.org/2001/XMLSchema#int">1</aaif:position><aaif:coordinated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:coordinated><aaif:partOfText rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</aaif:partOfText><aaif:syntacticConstruction rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Reflexive" /></aaif:Verb><aaif:Adverb rdf:about="https://gams.uni-graz.at/o:aaif.fraweb#En1443Ph1Ad1"><aaif:text>court</aaif:text><aaif:lemma rdf:resource="https://gams.uni-graz.at/o:aaif.lemma#court" /><aaif:position rdf:datatype="http://www.w3.org/2001/XMLSchema#int">2</aaif:position><aaif:coordinated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:coordinated><aaif:morphosyntacticStructure rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Adjective" /><aaif:inflection rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Uninflected" /><aaif:attributionTarget rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#VerbObject" /><aaif:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:modified><aaif:semanticClassification rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Manner" /><aaif:reduplicated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:reduplicated><aaif:prepositionalPhrase rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:prepositionalPhrase></aaif:Adverb><aaif:Entry rdf:about="https://gams.uni-graz.at/o:aaif.fraweb#En1444"><aaif:phrase rdf:resource="https://gams.uni-graz.at/o:aaif.fraweb#En1444Ph1" /><aaif:source rdf:resource="https://gams.uni-graz.at/o:aaif.fraweb.bibl#DC1444" /><gams:textualContent>Ahah c'est vrai que ces anglaises ont tendance a s'habiller court  !je l'ai remarqué lors de mes achats londoniens !;) </gams:textualContent><rel:isPartOf rdf:resource="https://gams.uni-graz.at/o:aaif.fraweb" /></aaif:Entry><aaif:Phrase rdf:about="https://gams.uni-graz.at/o:aaif.fraweb#En1444Ph1"><aaif:verb rdf:resource="https://gams.uni-graz.at/o:aaif.fraweb#En1444Ph1Ve1" /><aaif:adverb rdf:resource="https://gams.uni-graz.at/o:aaif.fraweb#En1444Ph1Ad1" /><aaif:text>ces anglaises ont tendance a s'habiller court </aaif:text><aaif:annoText>ces anglaises ont tendance a [v|s'habiller|habiller|rs] [a|court|court|auonmnnn] </aaif:annoText></aaif:Phrase><aaif:Verb rdf:about="https://gams.uni-graz.at/o:aaif.fraweb#En1444Ph1Ve1"><aaif:text>s'habiller</aaif:text><aaif:lemma rdf:resource="https://gams.uni-graz.at/o:aaif.lemma#habiller" /><aaif:position rdf:datatype="http://www.w3.org/2001/XMLSchema#int">1</aaif:position><aaif:coordinated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:coordinated><aaif:partOfText rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</aaif:partOfText><aaif:syntacticConstruction rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Reflexive" /></aaif:Verb><aaif:Adverb rdf:about="https://gams.uni-graz.at/o:aaif.fraweb#En1444Ph1Ad1"><aaif:text>court</aaif:text><aaif:lemma rdf:resource="https://gams.uni-graz.at/o:aaif.lemma#court" /><aaif:position rdf:datatype="http://www.w3.org/2001/XMLSchema#int">2</aaif:position><aaif:coordinated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:coordinated><aaif:morphosyntacticStructure rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Adjective" /><aaif:inflection rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Uninflected" /><aaif:attributionTarget rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#VerbObject" /><aaif:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:modified><aaif:semanticClassification rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Manner" /><aaif:reduplicated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:reduplicated><aaif:prepositionalPhrase rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:prepositionalPhrase></aaif:Adverb><aaif:Entry rdf:about="https://gams.uni-graz.at/o:aaif.fraweb#En1445"><aaif:phrase rdf:resource="https://gams.uni-graz.at/o:aaif.fraweb#En1445Ph1" /><aaif:source rdf:resource="https://gams.uni-graz.at/o:aaif.fraweb.bibl#DC1445" /><gams:textualContent>D'ailleurs, cette années on mélange beaucoup le jean avec de la dentelle anglaise par exemple.J'adore m'habiller courte et ultra féminin  !</gams:textualContent><rel:isPartOf rdf:resource="https://gams.uni-graz.at/o:aaif.fraweb" /></aaif:Entry><aaif:Phrase rdf:about="https://gams.uni-graz.at/o:aaif.fraweb#En1445Ph1"><aaif:verb rdf:resource="https://gams.uni-graz.at/o:aaif.fraweb#En1445Ph1Ve1" /><aaif:adverb rdf:resource="https://gams.uni-graz.at/o:aaif.fraweb#En1445Ph1Ad1" /><aaif:adverb rdf:resource="https://gams.uni-graz.at/o:aaif.fraweb#En1445Ph1Ad2" /><aaif:text>J'adore m'habiller courte et ultra féminin </aaif:text><aaif:annoText>J'adore [v|m'habiller|habiller|rs] [a|courte|court|aaonmnnC] et ultra [a|féminin|féminin|ausmmnnC] </aaif:annoText></aaif:Phrase><aaif:Verb rdf:about="https://gams.uni-graz.at/o:aaif.fraweb#En1445Ph1Ve1"><aaif:text>m'habiller</aaif:text><aaif:lemma rdf:resource="https://gams.uni-graz.at/o:aaif.lemma#habiller" /><aaif:position rdf:datatype="http://www.w3.org/2001/XMLSchema#int">1</aaif:position><aaif:coordinated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:coordinated><aaif:partOfText rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</aaif:partOfText><aaif:syntacticConstruction rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Reflexive" /></aaif:Verb><aaif:Adverb rdf:about="https://gams.uni-graz.at/o:aaif.fraweb#En1445Ph1Ad1"><aaif:text>courte</aaif:text><aaif:lemma rdf:resource="https://gams.uni-graz.at/o:aaif.lemma#court" /><aaif:position rdf:datatype="http://www.w3.org/2001/XMLSchema#int">2</aaif:position><aaif:coordinated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</aaif:coordinated><aaif:morphosyntacticStructure rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Adjective" /><aaif:inflection rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#AudibleInflection" /><aaif:attributionTarget rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#VerbObject" /><aaif:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:modified><aaif:semanticClassification rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Manner" /><aaif:reduplicated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:reduplicated><aaif:prepositionalPhrase rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:prepositionalPhrase></aaif:Adverb><aaif:Adverb rdf:about="https://gams.uni-graz.at/o:aaif.fraweb#En1445Ph1Ad2"><aaif:text>féminin</aaif:text><aaif:lemma rdf:resource="https://gams.uni-graz.at/o:aaif.lemma#féminin" /><aaif:position rdf:datatype="http://www.w3.org/2001/XMLSchema#int">3</aaif:position><aaif:coordinated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</aaif:coordinated><aaif:morphosyntacticStructure rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Adjective" /><aaif:inflection rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Uninflected" /><aaif:attributionTarget rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Verb" /><aaif:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</aaif:modified><aaif:semanticClassification rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Manner" /><aaif:reduplicated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:reduplicated><aaif:prepositionalPhrase rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:prepositionalPhrase></aaif:Adverb><aaif:Entry rdf:about="https://gams.uni-graz.at/o:aaif.fraweb#En1446"><aaif:phrase rdf:resource="https://gams.uni-graz.at/o:aaif.fraweb#En1446Ph1" /><aaif:source rdf:resource="https://gams.uni-graz.at/o:aaif.fraweb.bibl#DC1446" /><gams:textualContent>Un homme a t-il besoin de s'habiller serré et coloré pour se sentir beau  ?</gams:textualContent><rel:isPartOf rdf:resource="https://gams.uni-graz.at/o:aaif.fraweb" /></aaif:Entry><aaif:Phrase rdf:about="https://gams.uni-graz.at/o:aaif.fraweb#En1446Ph1"><aaif:verb rdf:resource="https://gams.uni-graz.at/o:aaif.fraweb#En1446Ph1Ve1" /><aaif:verb rdf:resource="https://gams.uni-graz.at/o:aaif.fraweb#En1446Ph1Ve2" /><aaif:adverb rdf:resource="https://gams.uni-graz.at/o:aaif.fraweb#En1446Ph1Ad1" /><aaif:adverb rdf:resource="https://gams.uni-graz.at/o:aaif.fraweb#En1446Ph1Ad2" /><aaif:adverb rdf:resource="https://gams.uni-graz.at/o:aaif.fraweb#En1446Ph1Ad3" /><aaif:text>Un homme a t-il besoin de s'habiller serré et coloré pour se sentir beau </aaif:text><aaif:annoText>Un homme a t-il besoin de [v|s'habiller|habiller|rs] [a|serré|serré|auonmnnC] et [a|coloré|coloré|auonmnnC] pour [v|se sentir|sentir|rs] [a|beau|beau|auvnmnnn] </aaif:annoText></aaif:Phrase><aaif:Verb rdf:about="https://gams.uni-graz.at/o:aaif.fraweb#En1446Ph1Ve1"><aaif:text>s'habiller</aaif:text><aaif:lemma rdf:resource="https://gams.uni-graz.at/o:aaif.lemma#habiller" /><aaif:position rdf:datatype="http://www.w3.org/2001/XMLSchema#int">1</aaif:position><aaif:coordinated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:coordinated><aaif:partOfText rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</aaif:partOfText><aaif:syntacticConstruction rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Reflexive" /></aaif:Verb><aaif:Verb rdf:about="https://gams.uni-graz.at/o:aaif.fraweb#En1446Ph1Ve2"><aaif:text>se sentir</aaif:text><aaif:lemma rdf:resource="https://gams.uni-graz.at/o:aaif.lemma#sentir" /><aaif:position rdf:datatype="http://www.w3.org/2001/XMLSchema#int">4</aaif:position><aaif:coordinated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:coordinated><aaif:partOfText rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</aaif:partOfText><aaif:syntacticConstruction rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Reflexive" /></aaif:Verb><aaif:Adverb rdf:about="https://gams.uni-graz.at/o:aaif.fraweb#En1446Ph1Ad1"><aaif:text>serré</aaif:text><aaif:lemma rdf:resource="https://gams.uni-graz.at/o:aaif.lemma#serré" /><aaif:position rdf:datatype="http://www.w3.org/2001/XMLSchema#int">2</aaif:position><aaif:coordinated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</aaif:coordinated><aaif:morphosyntacticStructure rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Adjective" /><aaif:inflection rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Uninflected" /><aaif:attributionTarget rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#VerbObject" /><aaif:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:modified><aaif:semanticClassification rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Manner" /><aaif:reduplicated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:reduplicated><aaif:prepositionalPhrase rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:prepositionalPhrase></aaif:Adverb><aaif:Adverb rdf:about="https://gams.uni-graz.at/o:aaif.fraweb#En1446Ph1Ad2"><aaif:text>coloré</aaif:text><aaif:lemma rdf:resource="https://gams.uni-graz.at/o:aaif.lemma#coloré" /><aaif:position rdf:datatype="http://www.w3.org/2001/XMLSchema#int">3</aaif:position><aaif:coordinated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</aaif:coordinated><aaif:morphosyntacticStructure rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Adjective" /><aaif:inflection rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Uninflected" /><aaif:attributionTarget rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#VerbObject" /><aaif:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:modified><aaif:semanticClassification rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Manner" /><aaif:reduplicated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:reduplicated><aaif:prepositionalPhrase rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:prepositionalPhrase></aaif:Adverb><aaif:Adverb rdf:about="https://gams.uni-graz.at/o:aaif.fraweb#En1446Ph1Ad3"><aaif:text>beau</aaif:text><aaif:lemma rdf:resource="https://gams.uni-graz.at/o:aaif.lemma#beau" /><aaif:position rdf:datatype="http://www.w3.org/2001/XMLSchema#int">5</aaif:position><aaif:coordinated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:coordinated><aaif:morphosyntacticStructure rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Adjective" /><aaif:inflection rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Uninflected" /><aaif:attributionTarget rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Verb" /><aaif:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:modified><aaif:semanticClassification rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Manner" /><aaif:reduplicated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:reduplicated><aaif:prepositionalPhrase rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:prepositionalPhrase></aaif:Adverb><aaif:Entry rdf:about="https://gams.uni-graz.at/o:aaif.fraweb#En1447"><aaif:phrase rdf:resource="https://gams.uni-graz.at/o:aaif.fraweb#En1447Ph1" /><aaif:source rdf:resource="https://gams.uni-graz.at/o:aaif.fraweb.bibl#DC1447" /><gams:textualContent>De ton point de vue de métrosexuel, oui, car pour vous les bobos métrosexuels parisiens, la virilité c'est s'habiller serré à la mode comme des grosses tafioles </gams:textualContent><rel:isPartOf rdf:resource="https://gams.uni-graz.at/o:aaif.fraweb" /></aaif:Entry><aaif:Phrase rdf:about="https://gams.uni-graz.at/o:aaif.fraweb#En1447Ph1"><aaif:verb rdf:resource="https://gams.uni-graz.at/o:aaif.fraweb#En1447Ph1Ve1" /><aaif:adverb rdf:resource="https://gams.uni-graz.at/o:aaif.fraweb#En1447Ph1Ad1" /><aaif:text>la virilité c'est s'habiller serré à la mode</aaif:text><aaif:annoText>la virilité c'est [v|s'habiller|habiller|rs] [a|serré|serré|auonmnnn] à la mode</aaif:annoText></aaif:Phrase><aaif:Verb rdf:about="https://gams.uni-graz.at/o:aaif.fraweb#En1447Ph1Ve1"><aaif:text>s'habiller</aaif:text><aaif:lemma rdf:resource="https://gams.uni-graz.at/o:aaif.lemma#habiller" /><aaif:position rdf:datatype="http://www.w3.org/2001/XMLSchema#int">1</aaif:position><aaif:coordinated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:coordinated><aaif:partOfText rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</aaif:partOfText><aaif:syntacticConstruction rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Reflexive" /></aaif:Verb><aaif:Adverb rdf:about="https://gams.uni-graz.at/o:aaif.fraweb#En1447Ph1Ad1"><aaif:text>serré</aaif:text><aaif:lemma rdf:resource="https://gams.uni-graz.at/o:aaif.lemma#serré" /><aaif:position rdf:datatype="http://www.w3.org/2001/XMLSchema#int">2</aaif:position><aaif:coordinated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:coordinated><aaif:morphosyntacticStructure rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Adjective" /><aaif:inflection rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Uninflected" /><aaif:attributionTarget rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#VerbObject" /><aaif:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:modified><aaif:semanticClassification rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Manner" /><aaif:reduplicated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:reduplicated><aaif:prepositionalPhrase rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:prepositionalPhrase></aaif:Adverb><aaif:Entry rdf:about="https://gams.uni-graz.at/o:aaif.fraweb#En1448"><aaif:phrase rdf:resource="https://gams.uni-graz.at/o:aaif.fraweb#En1448Ph1" /><aaif:source rdf:resource="https://gams.uni-graz.at/o:aaif.fraweb.bibl#DC1448" /><gams:textualContent>Il lance aussi ce conseil à la gent féminine : « Ma sœur, ne crois pas que de t’habiller serré , court  et de te parfumer tu vas te trouver un mari […] Les hommes sont des loups, ils veulent juste prendre ta virginité ».</gams:textualContent><rel:isPartOf rdf:resource="https://gams.uni-graz.at/o:aaif.fraweb" /></aaif:Entry><aaif:Phrase rdf:about="https://gams.uni-graz.at/o:aaif.fraweb#En1448Ph1"><aaif:verb rdf:resource="https://gams.uni-graz.at/o:aaif.fraweb#En1448Ph1Ve1" /><aaif:adverb rdf:resource="https://gams.uni-graz.at/o:aaif.fraweb#En1448Ph1Ad1" /><aaif:adverb rdf:resource="https://gams.uni-graz.at/o:aaif.fraweb#En1448Ph1Ad2" /><aaif:text>de t’habiller serré , court  et de te parfumer</aaif:text><aaif:annoText>de [v|t’habiller|habiller|rs] [a|serré|serré|auonmnnC] , [a|court|court|auonmnnC]  et de te parfumer</aaif:annoText></aaif:Phrase><aaif:Verb rdf:about="https://gams.uni-graz.at/o:aaif.fraweb#En1448Ph1Ve1"><aaif:text>t’habiller</aaif:text><aaif:lemma rdf:resource="https://gams.uni-graz.at/o:aaif.lemma#habiller" /><aaif:position rdf:datatype="http://www.w3.org/2001/XMLSchema#int">1</aaif:position><aaif:coordinated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:coordinated><aaif:partOfText rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</aaif:partOfText><aaif:syntacticConstruction rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Reflexive" /></aaif:Verb><aaif:Adverb rdf:about="https://gams.uni-graz.at/o:aaif.fraweb#En1448Ph1Ad1"><aaif:text>serré</aaif:text><aaif:lemma rdf:resource="https://gams.uni-graz.at/o:aaif.lemma#serré" /><aaif:position rdf:datatype="http://www.w3.org/2001/XMLSchema#int">2</aaif:position><aaif:coordinated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</aaif:coordinated><aaif:morphosyntacticStructure rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Adjective" /><aaif:inflection rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Uninflected" /><aaif:attributionTarget rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#VerbObject" /><aaif:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:modified><aaif:semanticClassification rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Manner" /><aaif:reduplicated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:reduplicated><aaif:prepositionalPhrase rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:prepositionalPhrase></aaif:Adverb><aaif:Adverb rdf:about="https://gams.uni-graz.at/o:aaif.fraweb#En1448Ph1Ad2"><aaif:text>court</aaif:text><aaif:lemma rdf:resource="https://gams.uni-graz.at/o:aaif.lemma#court" /><aaif:position rdf:datatype="http://www.w3.org/2001/XMLSchema#int">3</aaif:position><aaif:coordinated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</aaif:coordinated><aaif:morphosyntacticStructure rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Adjective" /><aaif:inflection rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Uninflected" /><aaif:attributionTarget rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#VerbObject" /><aaif:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:modified><aaif:semanticClassification rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Manner" /><aaif:reduplicated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:reduplicated><aaif:prepositionalPhrase rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:prepositionalPhrase></aaif:Adverb><aaif:Entry rdf:about="https://gams.uni-graz.at/o:aaif.fraweb#En1449"><aaif:phrase rdf:resource="https://gams.uni-graz.at/o:aaif.fraweb#En1449Ph1" /><aaif:source rdf:resource="https://gams.uni-graz.at/o:aaif.fraweb.bibl#DC1449" /><gams:textualContent>(je me sous estime bcp religieusement parlant vu que je suis "nouvelle" dans l'islam) des fois j'ai des envies de me maquiller m'epiler les sourcils m'habiller serrée  et sortir comme ça mais dès que j'y pense je me sens mal de suite.</gams:textualContent><rel:isPartOf rdf:resource="https://gams.uni-graz.at/o:aaif.fraweb" /></aaif:Entry><aaif:Phrase rdf:about="https://gams.uni-graz.at/o:aaif.fraweb#En1449Ph1"><aaif:verb rdf:resource="https://gams.uni-graz.at/o:aaif.fraweb#En1449Ph1Ve1" /><aaif:adverb rdf:resource="https://gams.uni-graz.at/o:aaif.fraweb#En1449Ph1Ad1" /><aaif:text>j'ai des envies de me maquiller m'epiler les sourcils m'habiller serrée </aaif:text><aaif:annoText>j'ai des envies de me maquiller m'epiler les sourcils [v|m'habiller|habiller|rs] [a|serrée|serré|aionmnnn] </aaif:annoText></aaif:Phrase><aaif:Verb rdf:about="https://gams.uni-graz.at/o:aaif.fraweb#En1449Ph1Ve1"><aaif:text>m'habiller</aaif:text><aaif:lemma rdf:resource="https://gams.uni-graz.at/o:aaif.lemma#habiller" /><aaif:position rdf:datatype="http://www.w3.org/2001/XMLSchema#int">1</aaif:position><aaif:coordinated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:coordinated><aaif:partOfText rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</aaif:partOfText><aaif:syntacticConstruction rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Reflexive" /></aaif:Verb><aaif:Adverb rdf:about="https://gams.uni-graz.at/o:aaif.fraweb#En1449Ph1Ad1"><aaif:text>serrée</aaif:text><aaif:lemma rdf:resource="https://gams.uni-graz.at/o:aaif.lemma#serré" /><aaif:position rdf:datatype="http://www.w3.org/2001/XMLSchema#int">2</aaif:position><aaif:coordinated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:coordinated><aaif:morphosyntacticStructure rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Adjective" /><aaif:inflection rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#InaudibleInflection" /><aaif:attributionTarget rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#VerbObject" /><aaif:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:modified><aaif:semanticClassification rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Manner" /><aaif:reduplicated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:reduplicated><aaif:prepositionalPhrase rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:prepositionalPhrase></aaif:Adverb><aaif:Entry rdf:about="https://gams.uni-graz.at/o:aaif.fraweb#En1450"><aaif:phrase rdf:resource="https://gams.uni-graz.at/o:aaif.fraweb#En1450Ph1" /><aaif:phrase rdf:resource="https://gams.uni-graz.at/o:aaif.fraweb#En1450Ph2" /><aaif:source rdf:resource="https://gams.uni-graz.at/o:aaif.fraweb.bibl#DC1450" /><gams:textualContent>je suis en partenariat avec des operateurs economique de l'etranger, desormais plus de chinoiseries,  habillez vous  ORIGINAL  .je reside au ghana et je suis a present a douala pour le lancement de votre magasin.merci de partager la page pour le bien de nos freres et sœurs, evitons de nous habiller faux (CHINOIS) car notre santé en depend.</gams:textualContent><rel:isPartOf rdf:resource="https://gams.uni-graz.at/o:aaif.fraweb" /></aaif:Entry><aaif:Phrase rdf:about="https://gams.uni-graz.at/o:aaif.fraweb#En1450Ph1"><aaif:verb rdf:resource="https://gams.uni-graz.at/o:aaif.fraweb#En1450Ph1Ve1" /><aaif:adverb rdf:resource="https://gams.uni-graz.at/o:aaif.fraweb#En1450Ph1Ad1" /><aaif:text> habillez vous  ORIGINAL </aaif:text><aaif:annoText> [v|habillez vous|habiller|rs]  [a|ORIGINAL|original|auonmnnn] </aaif:annoText></aaif:Phrase><aaif:Verb rdf:about="https://gams.uni-graz.at/o:aaif.fraweb#En1450Ph1Ve1"><aaif:text>habillez vous</aaif:text><aaif:lemma rdf:resource="https://gams.uni-graz.at/o:aaif.lemma#habiller" /><aaif:position rdf:datatype="http://www.w3.org/2001/XMLSchema#int">1</aaif:position><aaif:coordinated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:coordinated><aaif:partOfText rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</aaif:partOfText><aaif:syntacticConstruction rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Reflexive" /></aaif:Verb><aaif:Adverb rdf:about="https://gams.uni-graz.at/o:aaif.fraweb#En1450Ph1Ad1"><aaif:text>ORIGINAL</aaif:text><aaif:lemma rdf:resource="https://gams.uni-graz.at/o:aaif.lemma#original" /><aaif:position rdf:datatype="http://www.w3.org/2001/XMLSchema#int">2</aaif:position><aaif:coordinated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:coordinated><aaif:morphosyntacticStructure rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Adjective" /><aaif:inflection rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Uninflected" /><aaif:attributionTarget rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#VerbObject" /><aaif:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:modified><aaif:semanticClassification rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Manner" /><aaif:reduplicated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:reduplicated><aaif:prepositionalPhrase rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:prepositionalPhrase></aaif:Adverb><aaif:Phrase rdf:about="https://gams.uni-graz.at/o:aaif.fraweb#En1450Ph2"><aaif:verb rdf:resource="https://gams.uni-graz.at/o:aaif.fraweb#En1450Ph2Ve1" /><aaif:adverb rdf:resource="https://gams.uni-graz.at/o:aaif.fraweb#En1450Ph2Ad1" /><aaif:text>evitons de nous habiller faux (CHINOIS)</aaif:text><aaif:annoText>evitons de [v|nous habiller|habiller|rs] [a|faux|faux|auonmnnn] (CHINOIS)</aaif:annoText></aaif:Phrase><aaif:Verb rdf:about="https://gams.uni-graz.at/o:aaif.fraweb#En1450Ph2Ve1"><aaif:text>nous habiller</aaif:text><aaif:lemma rdf:resource="https://gams.uni-graz.at/o:aaif.lemma#habiller" /><aaif:position rdf:datatype="http://www.w3.org/2001/XMLSchema#int">1</aaif:position><aaif:coordinated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:coordinated><aaif:partOfText rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</aaif:partOfText><aaif:syntacticConstruction rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Reflexive" /></aaif:Verb><aaif:Adverb rdf:about="https://gams.uni-graz.at/o:aaif.fraweb#En1450Ph2Ad1"><aaif:text>faux</aaif:text><aaif:lemma rdf:resource="https://gams.uni-graz.at/o:aaif.lemma#faux" /><aaif:position rdf:datatype="http://www.w3.org/2001/XMLSchema#int">2</aaif:position><aaif:coordinated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:coordinated><aaif:morphosyntacticStructure rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Adjective" /><aaif:inflection rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Uninflected" /><aaif:attributionTarget rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#VerbObject" /><aaif:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:modified><aaif:semanticClassification rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Manner" /><aaif:reduplicated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:reduplicated><aaif:prepositionalPhrase rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:prepositionalPhrase></aaif:Adverb><aaif:Entry rdf:about="https://gams.uni-graz.at/o:aaif.fraweb#En1451"><aaif:phrase rdf:resource="https://gams.uni-graz.at/o:aaif.fraweb#En1451Ph1" /><aaif:source rdf:resource="https://gams.uni-graz.at/o:aaif.fraweb.bibl#DC1451" /><gams:textualContent>Ne pas connaître son style et s'habiller faux  , avec trop de bijoux...Une femme doit trouver son style, son caractère, et jouer avec.</gams:textualContent><rel:isPartOf rdf:resource="https://gams.uni-graz.at/o:aaif.fraweb" /></aaif:Entry><aaif:Phrase rdf:about="https://gams.uni-graz.at/o:aaif.fraweb#En1451Ph1"><aaif:verb rdf:resource="https://gams.uni-graz.at/o:aaif.fraweb#En1451Ph1Ve1" /><aaif:adverb rdf:resource="https://gams.uni-graz.at/o:aaif.fraweb#En1451Ph1Ad1" /><aaif:text>Ne pas connaître son style et s'habiller faux </aaif:text><aaif:annoText>Ne pas connaître son style et [v|s'habiller|habiller|rs] [a|faux|faux|auvnmnnn] </aaif:annoText></aaif:Phrase><aaif:Verb rdf:about="https://gams.uni-graz.at/o:aaif.fraweb#En1451Ph1Ve1"><aaif:text>s'habiller</aaif:text><aaif:lemma rdf:resource="https://gams.uni-graz.at/o:aaif.lemma#habiller" /><aaif:position rdf:datatype="http://www.w3.org/2001/XMLSchema#int">1</aaif:position><aaif:coordinated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:coordinated><aaif:partOfText rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</aaif:partOfText><aaif:syntacticConstruction rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Reflexive" /></aaif:Verb><aaif:Adverb rdf:about="https://gams.uni-graz.at/o:aaif.fraweb#En1451Ph1Ad1"><aaif:text>faux</aaif:text><aaif:lemma rdf:resource="https://gams.uni-graz.at/o:aaif.lemma#faux" /><aaif:position rdf:datatype="http://www.w3.org/2001/XMLSchema#int">2</aaif:position><aaif:coordinated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:coordinated><aaif:morphosyntacticStructure rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Adjective" /><aaif:inflection rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Uninflected" /><aaif:attributionTarget rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Verb" /><aaif:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:modified><aaif:semanticClassification rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Manner" /><aaif:reduplicated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:reduplicated><aaif:prepositionalPhrase rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:prepositionalPhrase></aaif:Adverb><aaif:Entry rdf:about="https://gams.uni-graz.at/o:aaif.fraweb#En1452"><aaif:phrase rdf:resource="https://gams.uni-graz.at/o:aaif.fraweb#En1452Ph1" /><aaif:source rdf:resource="https://gams.uni-graz.at/o:aaif.fraweb.bibl#DC1452" /><gams:textualContent>C'est malheureux, mais ca Dakar, gnodi rek et ils n'ont rien ou ne croient pas a ce kil font.Les gens a dkr, parlent faux , s'habillent faux , mangent faux , dorment faux  .</gams:textualContent><rel:isPartOf rdf:resource="https://gams.uni-graz.at/o:aaif.fraweb" /></aaif:Entry><aaif:Phrase rdf:about="https://gams.uni-graz.at/o:aaif.fraweb#En1452Ph1"><aaif:verb rdf:resource="https://gams.uni-graz.at/o:aaif.fraweb#En1452Ph1Ve1" /><aaif:verb rdf:resource="https://gams.uni-graz.at/o:aaif.fraweb#En1452Ph1Ve2" /><aaif:verb rdf:resource="https://gams.uni-graz.at/o:aaif.fraweb#En1452Ph1Ve3" /><aaif:verb rdf:resource="https://gams.uni-graz.at/o:aaif.fraweb#En1452Ph1Ve4" /><aaif:adverb rdf:resource="https://gams.uni-graz.at/o:aaif.fraweb#En1452Ph1Ad1" /><aaif:adverb rdf:resource="https://gams.uni-graz.at/o:aaif.fraweb#En1452Ph1Ad2" /><aaif:adverb rdf:resource="https://gams.uni-graz.at/o:aaif.fraweb#En1452Ph1Ad3" /><aaif:adverb rdf:resource="https://gams.uni-graz.at/o:aaif.fraweb#En1452Ph1Ad4" /><aaif:text>Les gens a dkr, parlent faux , s'habillent faux , mangent faux , dorment faux </aaif:text><aaif:annoText>Les gens a dkr, [v|parlent|parler|is] [a|faux|faux|auvnmnnn] , [v|s'habillent|habiller|rs] [a|faux|faux|auvnmnnn] , [v|mangent|manger|is] [a|faux|faux|auvnmnnn] , [v|dorment|dormir|is] [a|faux|faux|auvnmnnn] </aaif:annoText></aaif:Phrase><aaif:Verb rdf:about="https://gams.uni-graz.at/o:aaif.fraweb#En1452Ph1Ve1"><aaif:text>parlent</aaif:text><aaif:lemma rdf:resource="https://gams.uni-graz.at/o:aaif.lemma#parler" /><aaif:position rdf:datatype="http://www.w3.org/2001/XMLSchema#int">1</aaif:position><aaif:coordinated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:coordinated><aaif:partOfText rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</aaif:partOfText><aaif:syntacticConstruction rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Intransitive" /></aaif:Verb><aaif:Verb rdf:about="https://gams.uni-graz.at/o:aaif.fraweb#En1452Ph1Ve2"><aaif:text>s'habillent</aaif:text><aaif:lemma rdf:resource="https://gams.uni-graz.at/o:aaif.lemma#habiller" /><aaif:position rdf:datatype="http://www.w3.org/2001/XMLSchema#int">3</aaif:position><aaif:coordinated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:coordinated><aaif:partOfText rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</aaif:partOfText><aaif:syntacticConstruction rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Reflexive" /></aaif:Verb><aaif:Verb rdf:about="https://gams.uni-graz.