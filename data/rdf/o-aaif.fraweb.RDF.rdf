ut vivre facile </aaif:text><aaif:annoText>On peut [v|vivre|vivre|is] [a|facile|facile|auvnmnnn] </aaif:annoText></aaif:Phrase><aaif:Verb rdf:about="https://gams.uni-graz.at/o:aaif.fraweb#En3868Ph1Ve1"><aaif:text>vivre</aaif:text><aaif:lemma rdf:resource="https://gams.uni-graz.at/o:aaif.lemma#vivre" /><aaif:position rdf:datatype="http://www.w3.org/2001/XMLSchema#int">1</aaif:position><aaif:coordinated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:coordinated><aaif:partOfText rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</aaif:partOfText><aaif:syntacticConstruction rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Intransitive" /></aaif:Verb><aaif:Adverb rdf:about="https://gams.uni-graz.at/o:aaif.fraweb#En3868Ph1Ad1"><aaif:text>facile</aaif:text><aaif:lemma rdf:resource="https://gams.uni-graz.at/o:aaif.lemma#facile" /><aaif:position rdf:datatype="http://www.w3.org/2001/XMLSchema#int">2</aaif:position><aaif:coordinated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:coordinated><aaif:morphosyntacticStructure rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Adjective" /><aaif:inflection rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Uninflected" /><aaif:attributionTarget rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Verb" /><aaif:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:modified><aaif:semanticClassification rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Manner" /><aaif:reduplicated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:reduplicated><aaif:prepositionalPhrase rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:prepositionalPhrase></aaif:Adverb><aaif:Entry rdf:about="https://gams.uni-graz.at/o:aaif.fraweb#En3869"><aaif:phrase rdf:resource="https://gams.uni-graz.at/o:aaif.fraweb#En3869Ph1" /><aaif:source rdf:resource="https://gams.uni-graz.at/o:aaif.fraweb.bibl#DC3890" /><gams:textualContent>Pour les prix..j'en sais rien..j'ai un abonement Proximus..mais tu peux vivre facile  avec une facture de 50 euros.</gams:textualContent><rel:isPartOf rdf:resource="https://gams.uni-graz.at/o:aaif.fraweb" /></aaif:Entry><aaif:Phrase rdf:about="https://gams.uni-graz.at/o:aaif.fraweb#En3869Ph1"><aaif:verb rdf:resource="https://gams.uni-graz.at/o:aaif.fraweb#En3869Ph1Ve1" /><aaif:adverb rdf:resource="https://gams.uni-graz.at/o:aaif.fraweb#En3869Ph1Ad1" /><aaif:text>tu peux vivre facile </aaif:text><aaif:annoText>tu peux [v|vivre|vivre|is] [a|facile|facile|auvnmnnn] </aaif:annoText></aaif:Phrase><aaif:Verb rdf:about="https://gams.uni-graz.at/o:aaif.fraweb#En3869Ph1Ve1"><aaif:text>vivre</aaif:text><aaif:lemma rdf:resource="https://gams.uni-graz.at/o:aaif.lemma#vivre" /><aaif:position rdf:datatype="http://www.w3.org/2001/XMLSchema#int">1</aaif:position><aaif:coordinated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:coordinated><aaif:partOfText rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</aaif:partOfText><aaif:syntacticConstruction rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Intransitive" /></aaif:Verb><aaif:Adverb rdf:about="https://gams.uni-graz.at/o:aaif.fraweb#En3869Ph1Ad1"><aaif:text>facile</aaif:text><aaif:lemma rdf:resource="https://gams.uni-graz.at/o:aaif.lemma#facile" /><aaif:position rdf:datatype="http://www.w3.org/2001/XMLSchema#int">2</aaif:position><aaif:coordinated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:coordinated><aaif:morphosyntacticStructure rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Adjective" /><aaif:inflection rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Uninflected" /><aaif:attributionTarget rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Verb" /><aaif:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:modified><aaif:semanticClassification rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Manner" /><aaif:reduplicated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:reduplicated><aaif:prepositionalPhrase rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:prepositionalPhrase></aaif:Adverb><aaif:Entry rdf:about="https://gams.uni-graz.at/o:aaif.fraweb#En3870"><aaif:phrase rdf:resource="https://gams.uni-graz.at/o:aaif.fraweb#En3870Ph1" /><aaif:source rdf:resource="https://gams.uni-graz.at/o:aaif.fraweb.bibl#DC3891" /><gams:textualContent>Les argoniens y vivent facile  vu leur résistance à la maladie.</gams:textualContent><rel:isPartOf rdf:resource="https://gams.uni-graz.at/o:aaif.fraweb" /></aaif:Entry><aaif:Phrase rdf:about="https://gams.uni-graz.at/o:aaif.fraweb#En3870Ph1"><aaif:verb rdf:resource="https://gams.uni-graz.at/o:aaif.fraweb#En3870Ph1Ve1" /><aaif:adverb rdf:resource="https://gams.uni-graz.at/o:aaif.fraweb#En3870Ph1Ad1" /><aaif:text>Les argoniens y vivent facile </aaif:text><aaif:annoText>Les argoniens y [v|vivent|vivre|is] [a|facile|facile|auvnmnnn] </aaif:annoText></aaif:Phrase><aaif:Verb rdf:about="https://gams.uni-graz.at/o:aaif.fraweb#En3870Ph1Ve1"><aaif:text>vivent</aaif:text><aaif:lemma rdf:resource="https://gams.uni-graz.at/o:aaif.lemma#vivre" /><aaif:position rdf:datatype="http://www.w3.org/2001/XMLSchema#int">1</aaif:position><aaif:coordinated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:coordinated><aaif:partOfText rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</aaif:partOfText><aaif:syntacticConstruction rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Intransitive" /></aaif:Verb><aaif:Adverb rdf:about="https://gams.uni-graz.at/o:aaif.fraweb#En3870Ph1Ad1"><aaif:text>facile</aaif:text><aaif:lemma rdf:resource="https://gams.uni-graz.at/o:aaif.lemma#facile" /><aaif:position rdf:datatype="http://www.w3.org/2001/XMLSchema#int">2</aaif:position><aaif:coordinated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:coordinated><aaif:morphosyntacticStructure rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Adjective" /><aaif:inflection rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Uninflected" /><aaif:attributionTarget rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Verb" /><aaif:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:modified><aaif:semanticClassification rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Manner" /><aaif:reduplicated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:reduplicated><aaif:prepositionalPhrase rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:prepositionalPhrase></aaif:Adverb><aaif:Entry rdf:about="https://gams.uni-graz.at/o:aaif.fraweb#En3871"><aaif:phrase rdf:resource="https://gams.uni-graz.at/o:aaif.fraweb#En3871Ph1" /><aaif:source rdf:resource="https://gams.uni-graz.at/o:aaif.fraweb.bibl#DC3892" /><gams:textualContent>Il va s'en sortir, c'est une force de la nature.Et merde.Il a lâché prise.Comme il a vécu . Vite et fort , avec panache.</gams:textualContent><rel:isPartOf rdf:resource="https://gams.uni-graz.at/o:aaif.fraweb" /></aaif:Entry><aaif:Phrase rdf:about="https://gams.uni-graz.at/o:aaif.fraweb#En3871Ph1"><aaif:verb rdf:resource="https://gams.uni-graz.at/o:aaif.fraweb#En3871Ph1Ve1" /><aaif:adverb rdf:resource="https://gams.uni-graz.at/o:aaif.fraweb#En3871Ph1Ad1" /><aaif:text>Comme il a vécu . Vite et fort , avec panache</aaif:text><aaif:annoText>Comme il [v|a vécu|vivre|is] . Vite et [a|fort|fort|auvnqnnC] , avec panache</aaif:annoText></aaif:Phrase><aaif:Verb rdf:about="https://gams.uni-graz.at/o:aaif.fraweb#En3871Ph1Ve1"><aaif:text>a vécu</aaif:text><aaif:lemma rdf:resource="https://gams.uni-graz.at/o:aaif.lemma#vivre" /><aaif:position rdf:datatype="http://www.w3.org/2001/XMLSchema#int">1</aaif:position><aaif:coordinated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:coordinated><aaif:partOfText rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</aaif:partOfText><aaif:syntacticConstruction rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Intransitive" /></aaif:Verb><aaif:Adverb rdf:about="https://gams.uni-graz.at/o:aaif.fraweb#En3871Ph1Ad1"><aaif:text>fort</aaif:text><aaif:lemma rdf:resource="https://gams.uni-graz.at/o:aaif.lemma#fort" /><aaif:position rdf:datatype="http://www.w3.org/2001/XMLSchema#int">2</aaif:position><aaif:coordinated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</aaif:coordinated><aaif:morphosyntacticStructure rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Adjective" /><aaif:inflection rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Uninflected" /><aaif:attributionTarget rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Verb" /><aaif:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:modified><aaif:semanticClassification rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Quantity" /><aaif:reduplicated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:reduplicated><aaif:prepositionalPhrase rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:prepositionalPhrase></aaif:Adverb><aaif:Entry rdf:about="https://gams.uni-graz.at/o:aaif.fraweb#En3872"><aaif:phrase rdf:resource="https://gams.uni-graz.at/o:aaif.fraweb#En3872Ph1" /><aaif:source rdf:resource="https://gams.uni-graz.at/o:aaif.fraweb.bibl#DC3893" /><gams:textualContent>La soirée débutera avec Strychnine, un groupe mythique de la scène bordelaise, fondé en 1976. Considéré comme le premier groupe marquant de la capitale régionale, il a vécu vite et fort  jusqu'en 1982 avec trois albums à la clef.</gams:textualContent><rel:isPartOf rdf:resource="https://gams.uni-graz.at/o:aaif.fraweb" /></aaif:Entry><aaif:Phrase rdf:about="https://gams.uni-graz.at/o:aaif.fraweb#En3872Ph1"><aaif:verb rdf:resource="https://gams.uni-graz.at/o:aaif.fraweb#En3872Ph1Ve1" /><aaif:adverb rdf:resource="https://gams.uni-graz.at/o:aaif.fraweb#En3872Ph1Ad1" /><aaif:text>il a vécu vite et fort </aaif:text><aaif:annoText>il [v|a vécu|vivre|is] vite et [a|fort|fort|auvnqnnC] </aaif:annoText></aaif:Phrase><aaif:Verb rdf:about="https://gams.uni-graz.at/o:aaif.fraweb#En3872Ph1Ve1"><aaif:text>a vécu</aaif:text><aaif:lemma rdf:resource="https://gams.uni-graz.at/o:aaif.lemma#vivre" /><aaif:position rdf:datatype="http://www.w3.org/2001/XMLSchema#int">1</aaif:position><aaif:coordinated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:coordinated><aaif:partOfText rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</aaif:partOfText><aaif:syntacticConstruction rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Intransitive" /></aaif:Verb><aaif:Adverb rdf:about="https://gams.uni-graz.at/o:aaif.fraweb#En3872Ph1Ad1"><aaif:text>fort</aaif:text><aaif:lemma rdf:resource="https://gams.uni-graz.at/o:aaif.lemma#fort" /><aaif:position rdf:datatype="http://www.w3.org/2001/XMLSchema#int">2</aaif:position><aaif:coordinated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</aaif:coordinated><aaif:morphosyntacticStructure rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Adjective" /><aaif:inflection rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Uninflected" /><aaif:attributionTarget rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Verb" /><aaif:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:modified><aaif:semanticClassification rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Quantity" /><aaif:reduplicated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:reduplicated><aaif:prepositionalPhrase rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:prepositionalPhrase></aaif:Adverb><aaif:Entry rdf:about="https://gams.uni-graz.at/o:aaif.fraweb#En3873"><aaif:phrase rdf:resource="https://gams.uni-graz.at/o:aaif.fraweb#En3873Ph1" /><aaif:source rdf:resource="https://gams.uni-graz.at/o:aaif.fraweb.bibl#DC3894" /><gams:textualContent>Comme la vie, qui est une alternance de mouvements et d’arrêts, d’actions et d’instants contemplatifs.Alors, comme elle vit fort  , la musique du trio ne se fixe jamais, elle avance, s’octroie la liberté de ne pas suivre les chemins prévus, et l’on sent qu’à l’intérieur de ce triangle équilatéral chacun est susceptible d’influer sur sa trajectoire.</gams:textualContent><rel:isPartOf rdf:resource="https://gams.uni-graz.at/o:aaif.fraweb" /></aaif:Entry><aaif:Phrase rdf:about="https://gams.uni-graz.at/o:aaif.fraweb#En3873Ph1"><aaif:verb rdf:resource="https://gams.uni-graz.at/o:aaif.fraweb#En3873Ph1Ve1" /><aaif:adverb rdf:resource="https://gams.uni-graz.at/o:aaif.fraweb#En3873Ph1Ad1" /><aaif:text>elle vit fort </aaif:text><aaif:annoText>elle [v|vit|vivre|is] [a|fort|fort|auvnqnnn] </aaif:annoText></aaif:Phrase><aaif:Verb rdf:about="https://gams.uni-graz.at/o:aaif.fraweb#En3873Ph1Ve1"><aaif:text>vit</aaif:text><aaif:lemma rdf:resource="https://gams.uni-graz.at/o:aaif.lemma#vivre" /><aaif:position rdf:datatype="http://www.w3.org/2001/XMLSchema#int">1</aaif:position><aaif:coordinated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:coordinated><aaif:partOfText rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</aaif:partOfText><aaif:syntacticConstruction rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Intransitive" /></aaif:Verb><aaif:Adverb rdf:about="https://gams.uni-graz.at/o:aaif.fraweb#En3873Ph1Ad1"><aaif:text>fort</aaif:text><aaif:lemma rdf:resource="https://gams.uni-graz.at/o:aaif.lemma#fort" /><aaif:position rdf:datatype="http://www.w3.org/2001/XMLSchema#int">2</aaif:position><aaif:coordinated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:coordinated><aaif:morphosyntacticStructure rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Adjective" /><aaif:inflection rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Uninflected" /><aaif:attributionTarget rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Verb" /><aaif:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:modified><aaif:semanticClassification rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Quantity" /><aaif:reduplicated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:reduplicated><aaif:prepositionalPhrase rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:prepositionalPhrase></aaif:Adverb><aaif:Entry rdf:about="https://gams.uni-graz.at/o:aaif.fraweb#En3874"><aaif:phrase rdf:resource="https://gams.uni-graz.at/o:aaif.fraweb#En3874Ph1" /><aaif:phrase rdf:resource="https://gams.uni-graz.at/o:aaif.fraweb#En3874Ph2" /><aaif:phrase rdf:resource="https://gams.uni-graz.at/o:aaif.fraweb#En3874Ph3" /><aaif:source rdf:resource="https://gams.uni-graz.at/o:aaif.fraweb.bibl#DC3895" /><gams:textualContent>Vétuste et délabrée, Centro Habana vit rude  ; elle vit forte  , elle vit rires et cris d’enfants, de tantes et de voisins, elle vit musique et rumba, elle vit triste  , aussi, parfois, j’imagine…</gams:textualContent><rel:isPartOf rdf:resource="https://gams.uni-graz.at/o:aaif.fraweb" /></aaif:Entry><aaif:Phrase rdf:about="https://gams.uni-graz.at/o:aaif.fraweb#En3874Ph1"><aaif:verb rdf:resource="https://gams.uni-graz.at/o:aaif.fraweb#En3874Ph1Ve1" /><aaif:adverb rdf:resource="https://gams.uni-graz.at/o:aaif.fraweb#En3874Ph1Ad1" /><aaif:text>Centro Habana vit rude </aaif:text><aaif:annoText>Centro Habana [v|vit|vivre|is] [a|rude|rude|auvnmnnn] </aaif:annoText></aaif:Phrase><aaif:Verb rdf:about="https://gams.uni-graz.at/o:aaif.fraweb#En3874Ph1Ve1"><aaif:text>vit</aaif:text><aaif:lemma rdf:resource="https://gams.uni-graz.at/o:aaif.lemma#vivre" /><aaif:position rdf:datatype="http://www.w3.org/2001/XMLSchema#int">1</aaif:position><aaif:coordinated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:coordinated><aaif:partOfText rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</aaif:partOfText><aaif:syntacticConstruction rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Intransitive" /></aaif:Verb><aaif:Adverb rdf:about="https://gams.uni-graz.at/o:aaif.fraweb#En3874Ph1Ad1"><aaif:text>rude</aaif:text><aaif:lemma rdf:resource="https://gams.uni-graz.at/o:aaif.lemma#rude" /><aaif:position rdf:datatype="http://www.w3.org/2001/XMLSchema#int">2</aaif:position><aaif:coordinated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:coordinated><aaif:morphosyntacticStructure rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Adjective" /><aaif:inflection rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Uninflected" /><aaif:attributionTarget rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Verb" /><aaif:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:modified><aaif:semanticClassification rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Manner" /><aaif:reduplicated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:reduplicated><aaif:prepositionalPhrase rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:prepositionalPhrase></aaif:Adverb><aaif:Phrase rdf:about="https://gams.uni-graz.at/o:aaif.fraweb#En3874Ph2"><aaif:verb rdf:resource="https://gams.uni-graz.at/o:aaif.fraweb#En3874Ph2Ve1" /><aaif:adverb rdf:resource="https://gams.uni-graz.at/o:aaif.fraweb#En3874Ph2Ad1" /><aaif:text>elle vit forte </aaif:text><aaif:annoText>elle [v|vit|vivre|is] [a|forte|fort|aasnmnnn] </aaif:annoText></aaif:Phrase><aaif:Verb rdf:about="https://gams.uni-graz.at/o:aaif.fraweb#En3874Ph2Ve1"><aaif:text>vit</aaif:text><aaif:lemma rdf:resource="https://gams.uni-graz.at/o:aaif.lemma#vivre" /><aaif:position rdf:datatype="http://www.w3.org/2001/XMLSchema#int">1</aaif:position><aaif:coordinated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:coordinated><aaif:partOfText rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</aaif:partOfText><aaif:syntacticConstruction rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Intransitive" /></aaif:Verb><aaif:Adverb rdf:about="https://gams.uni-graz.at/o:aaif.fraweb#En3874Ph2Ad1"><aaif:text>forte</aaif:text><aaif:lemma rdf:resource="https://gams.uni-graz.at/o:aaif.lemma#fort" /><aaif:position rdf:datatype="http://www.w3.org/2001/XMLSchema#int">2</aaif:position><aaif:coordinated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:coordinated><aaif:morphosyntacticStructure rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Adjective" /><aaif:inflection rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#AudibleInflection" /><aaif:attributionTarget rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Verb" /><aaif:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:modified><aaif:semanticClassification rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Manner" /><aaif:reduplicated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:reduplicated><aaif:prepositionalPhrase rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:prepositionalPhrase></aaif:Adverb><aaif:Phrase rdf:about="https://gams.uni-graz.at/o:aaif.fraweb#En3874Ph3"><aaif:verb rdf:resource="https://gams.uni-graz.at/o:aaif.fraweb#En3874Ph3Ve1" /><aaif:adverb rdf:resource="https://gams.uni-graz.at/o:aaif.fraweb#En3874Ph3Ad1" /><aaif:text>elle vit triste </aaif:text><aaif:annoText>elle [v|vit|vivre|is] [a|triste|triste|aisnmnnn] </aaif:annoText></aaif:Phrase><aaif:Verb rdf:about="https://gams.uni-graz.at/o:aaif.fraweb#En3874Ph3Ve1"><aaif:text>vit</aaif:text><aaif:lemma rdf:resource="https://gams.uni-graz.at/o:aaif.lemma#vivre" /><aaif:position rdf:datatype="http://www.w3.org/2001/XMLSchema#int">1</aaif:position><aaif:coordinated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:coordinated><aaif:partOfText rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</aaif:partOfText><aaif:syntacticConstruction rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Intransitive" /></aaif:Verb><aaif:Adverb rdf:about="https://gams.uni-graz.at/o:aaif.fraweb#En3874Ph3Ad1"><aaif:text>triste</aaif:text><aaif:lemma rdf:resource="https://gams.uni-graz.at/o:aaif.lemma#triste" /><aaif:position rdf:datatype="http://www.w3.org/2001/XMLSchema#int">2</aaif:position><aaif:coordinated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:coordinated><aaif:morphosyntacticStructure rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Adjective" /><aaif:inflection rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#InaudibleInflection" /><aaif:attributionTarget rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Verb" /><aaif:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:modified><aaif:semanticClassification rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Manner" /><aaif:reduplicated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:reduplicated><aaif:prepositionalPhrase rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:prepositionalPhrase></aaif:Adverb><aaif:Entry rdf:about="https://gams.uni-graz.at/o:aaif.fraweb#En3875"><aaif:phrase rdf:resource="https://gams.uni-graz.at/o:aaif.fraweb#En3875Ph1" /><aaif:source rdf:resource="https://gams.uni-graz.at/o:aaif.fraweb.bibl#DC3896" /><gams:textualContent>Si le diabète promet d’être un marché prospère pour les big pharmas (50 milliards de dollars soit 46 milliards d’euros en 2020), il sera ravageur pour la croissance de nombreux pays.&lt;lb/&gt;“ Vivre  gras , mourir jeune ”</gams:textualContent><rel:isPartOf rdf:resource="https://gams.uni-graz.at/o:aaif.fraweb" /></aaif:Entry><aaif:Phrase rdf:about="https://gams.uni-graz.at/o:aaif.fraweb#En3875Ph1"><aaif:verb rdf:resource="https://gams.uni-graz.at/o:aaif.fraweb#En3875Ph1Ve1" /><aaif:verb rdf:resource="https://gams.uni-graz.at/o:aaif.fraweb#En3875Ph1Ve2" /><aaif:adverb rdf:resource="https://gams.uni-graz.at/o:aaif.fraweb#En3875Ph1Ad1" /><aaif:adverb rdf:resource="https://gams.uni-graz.at/o:aaif.fraweb#En3875Ph1Ad2" /><aaif:text> Vivre  gras , mourir jeune </aaif:text><aaif:annoText> [v|Vivre|vivre|is]  [a|gras|gras|auvnmnnn] , [v|mourir|mourir|is] [a|jeune|jeune|ausnmnnn] </aaif:annoText></aaif:Phrase><aaif:Verb rdf:about="https://gams.uni-graz.at/o:aaif.fraweb#En3875Ph1Ve1"><aaif:text>Vivre</aaif:text><aaif:lemma rdf:resource="https://gams.uni-graz.at/o:aaif.lemma#vivre" /><aaif:position rdf:datatype="http://www.w3.org/2001/XMLSchema#int">1</aaif:position><aaif:coordinated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:coordinated><aaif:partOfText rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</aaif:partOfText><aaif:syntacticConstruction rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Intransitive" /></aaif:Verb><aaif:Verb rdf:about="https://gams.uni-graz.at/o:aaif.fraweb#En3875Ph1Ve2"><aaif:text>mourir</aaif:text><aaif:lemma rdf:resource="https://gams.uni-graz.at/o:aaif.lemma#mourir" /><aaif:position rdf:datatype="http://www.w3.org/2001/XMLSchema#int">3</aaif:position><aaif:coordinated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:coordinated><aaif:partOfText rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</aaif:partOfText><aaif:syntacticConstruction rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Intransitive" /></aaif:Verb><aaif:Adverb rdf:about="https://gams.uni-graz.at/o:aaif.fraweb#En3875Ph1Ad1"><aaif:text>gras</aaif:text><aaif:lemma rdf:resource="https://gams.uni-graz.at/o:aaif.lemma#gras" /><aaif:position rdf:datatype="http://www.w3.org/2001/XMLSchema#int">2</aaif:position><aaif:coordinated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:coordinated><aaif:morphosyntacticStructure rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Adjective" /><aaif:inflection rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Uninflected" /><aaif:attributionTarget rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Verb" /><aaif:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:modified><aaif:semanticClassification rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Manner" /><aaif:reduplicated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:reduplicated><aaif:prepositionalPhrase rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:prepositionalPhrase></aaif:Adverb><aaif:Adverb rdf:about="https://gams.uni-graz.at/o:aaif.fraweb#En3875Ph1Ad2"><aaif:text>jeune</aaif:text><aaif:lemma rdf:resource="https://gams.uni-graz.at/o:aaif.lemma#jeune" /><aaif:position rdf:datatype="http://www.w3.org/2001/XMLSchema#int">4</aaif:position><aaif:coordinated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:coordinated><aaif:morphosyntacticStructure rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Adjective" /><aaif:inflection rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Uninflected" /><aaif:attributionTarget rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Verb" /><aaif:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:modified><aaif:semanticClassification rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Manner" /><aaif:reduplicated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:reduplicated><aaif:prepositionalPhrase rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:prepositionalPhrase></aaif:Adverb><aaif:Entry rdf:about="https://gams.uni-graz.at/o:aaif.fraweb#En3876"><aaif:phrase rdf:resource="https://gams.uni-graz.at/o:aaif.fraweb#En3876Ph1" /><aaif:source rdf:resource="https://gams.uni-graz.at/o:aaif.fraweb.bibl#DC3897" /><gams:textualContent>« De la mécanique, ils en mangent, et si vous me permettez l’image, ils vont vivre gras cet été.»</gams:textualContent><rel:isPartOf rdf:resource="https://gams.uni-graz.at/o:aaif.fraweb" /></aaif:Entry><aaif:Phrase rdf:about="https://gams.uni-graz.at/o:aaif.fraweb#En3876Ph1"><aaif:verb rdf:resource="https://gams.uni-graz.at/o:aaif.fraweb#En3876Ph1Ve1" /><aaif:adverb rdf:resource="https://gams.uni-graz.at/o:aaif.fraweb#En3876Ph1Ad1" /><aaif:text>ils vont vivre gras cet été</aaif:text><aaif:annoText>ils vont [v|vivre|vivre|is] [a|gras|gras|auvnmnnn] cet été</aaif:annoText></aaif:Phrase><aaif:Verb rdf:about="https://gams.uni-graz.at/o:aaif.fraweb#En3876Ph1Ve1"><aaif:text>vivre</aaif:text><aaif:lemma rdf:resource="https://gams.uni-graz.at/o:aaif.lemma#vivre" /><aaif:position rdf:datatype="http://www.w3.org/2001/XMLSchema#int">1</aaif:position><aaif:coordinated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:coordinated><aaif:partOfText rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</aaif:partOfText><aaif:syntacticConstruction rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Intransitive" /></aaif:Verb><aaif:Adverb rdf:about="https://gams.uni-graz.at/o:aaif.fraweb#En3876Ph1Ad1"><aaif:text>gras</aaif:text><aaif:lemma rdf:resource="https://gams.uni-graz.at/o:aaif.lemma#gras" /><aaif:position rdf:datatype="http://www.w3.org/2001/XMLSchema#int">2</aaif:position><aaif:coordinated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:coordinated><aaif:morphosyntacticStructure rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Adjective" /><aaif:inflection rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Uninflected" /><aaif:attributionTarget rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Verb" /><aaif:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:modified><aaif:semanticClassification rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Manner" /><aaif:reduplicated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:reduplicated><aaif:prepositionalPhrase rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:prepositionalPhrase></aaif:Adverb><aaif:Entry rdf:about="https://gams.uni-graz.at/o:aaif.fraweb#En3877"><aaif:phrase rdf:resource="https://gams.uni-graz.at/o:aaif.fraweb#En3877Ph1" /><aaif:source rdf:resource="https://gams.uni-graz.at/o:aaif.fraweb.bibl#DC3898" /><gams:textualContent>J'ai déjà eu un locataire sur le BS, batinse qu'il vivait "gras"  , la vie était belle.54 ans, 34 ans de bs et de travail au noir.Sa fille?bs aussi.</gams:textualContent><rel:isPartOf rdf:resource="https://gams.uni-graz.at/o:aaif.fraweb" /></aaif:Entry><aaif:Phrase rdf:about="https://gams.uni-graz.at/o:aaif.fraweb#En3877Ph1"><aaif:verb rdf:resource="https://gams.uni-graz.at/o:aaif.fraweb#En3877Ph1Ve1" /><aaif:adverb rdf:resource="https://gams.uni-graz.at/o:aaif.fraweb#En3877Ph1Ad1" /><aaif:text>un locataire sur le BS, batinse qu'il vivait \"gras\" </aaif:text><aaif:annoText>un locataire sur le BS, batinse qu'il [v|vivait|vivre|ts] [a|\"gras\"|gras|auvnmnnn] </aaif:annoText></aaif:Phrase><aaif:Verb rdf:about="https://gams.uni-graz.at/o:aaif.fraweb#En3877Ph1Ve1"><aaif:text>vivait</aaif:text><aaif:lemma rdf:resource="https://gams.uni-graz.at/o:aaif.lemma#vivre" /><aaif:position rdf:datatype="http://www.w3.org/2001/XMLSchema#int">1</aaif:position><aaif:coordinated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:coordinated><aaif:partOfText rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</aaif:partOfText><aaif:syntacticConstruction rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Transitive" /></aaif:Verb><aaif:Adverb rdf:about="https://gams.uni-graz.at/o:aaif.fraweb#En3877Ph1Ad1"><aaif:text>\"gras\"</aaif:text><aaif:lemma rdf:resource="https://gams.uni-graz.at/o:aaif.lemma#gras" /><aaif:position rdf:datatype="http://www.w3.org/2001/XMLSchema#int">2</aaif:position><aaif:coordinated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:coordinated><aaif:morphosyntacticStructure rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Adjective" /><aaif:inflection rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Uninflected" /><aaif:attributionTarget rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Verb" /><aaif:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:modified><aaif:semanticClassification rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Manner" /><aaif:reduplicated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:reduplicated><aaif:prepositionalPhrase rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:prepositionalPhrase></aaif:Adverb><aaif:Entry rdf:about="https://gams.uni-graz.at/o:aaif.fraweb#En3878"><aaif:phrase rdf:resource="https://gams.uni-graz.at/o:aaif.fraweb#En3878Ph1" /><aaif:source rdf:resource="https://gams.uni-graz.at/o:aaif.fraweb.bibl#DC3899" /><gams:textualContent>«Ce n’est pas qu’on vivait trop gras .Toutes les grandes organisations ont cette obligation de faire une cure d’amaigrissement.Car il y avait du travail à faire pour questionner les choses.La réalité, c’est qu’on embauchait 1400 employés par année, donc cette attrition s’est faite sans trop de heurts», a-t-il affirmé.</gams:textualContent><rel:isPartOf rdf:resource="https://gams.uni-graz.at/o:aaif.fraweb" /></aaif:Entry><aaif:Phrase rdf:about="https://gams.uni-graz.at/o:aaif.fraweb#En3878Ph1"><aaif:verb rdf:resource="https://gams.uni-graz.at/o:aaif.fraweb#En3878Ph1Ve1" /><aaif:adverb rdf:resource="https://gams.uni-graz.at/o:aaif.fraweb#En3878Ph1Ad1" /><aaif:text>on vivait trop gras </aaif:text><aaif:annoText>on [v|vivait|vivre|is] trop [a|gras|gras|auvmmnnn] </aaif:annoText></aaif:Phrase><aaif:Verb rdf:about="https://gams.uni-graz.at/o:aaif.fraweb#En3878Ph1Ve1"><aaif:text>vivait</aaif:text><aaif:lemma rdf:resource="https://gams.uni-graz.at/o:aaif.lemma#vivre" /><aaif:position rdf:datatype="http://www.w3.org/2001/XMLSchema#int">1</aaif:position><aaif:coordinated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:coordinated><aaif:partOfText rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</aaif:partOfText><aaif:syntacticConstruction rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Intransitive" /></aaif:Verb><aaif:Adverb rdf:about="https://gams.uni-graz.at/o:aaif.fraweb#En3878Ph1Ad1"><aaif:text>gras</aaif:text><aaif:lemma rdf:resource="https://gams.uni-graz.at/o:aaif.lemma#gras" /><aaif:position rdf:datatype="http://www.w3.org/2001/XMLSchema#int">2</aaif:position><aaif:coordinated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:coordinated><aaif:morphosyntacticStructure rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Adjective" /><aaif:inflection rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Uninflected" /><aaif:attributionTarget rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Verb" /><aaif:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</aaif:modified><aaif:semanticClassification rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Manner" /><aaif:reduplicated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:reduplicated><aaif:prepositionalPhrase rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:prepositionalPhrase></aaif:Adverb><aaif:Entry rdf:about="https://gams.uni-graz.at/o:aaif.fraweb#En3879"><aaif:phrase rdf:resource="https://gams.uni-graz.at/o:aaif.fraweb#En3879Ph1" /><aaif:source rdf:resource="https://gams.uni-graz.at/o:aaif.fraweb.bibl#DC3900" /><gams:textualContent>Avec ses seize ans en bandoulière, Virgile veut désormais vivre tout haut  et non plus chuchoter sa vie dans les couloirs d'une école.</gams:textualContent><rel:isPartOf rdf:resource="https://gams.uni-graz.at/o:aaif.fraweb" /></aaif:Entry><aaif:Phrase rdf:about="https://gams.uni-graz.at/o:aaif.fraweb#En3879Ph1"><aaif:verb rdf:resource="https://gams.uni-graz.at/o:aaif.fraweb#En3879Ph1Ve1" /><aaif:adverb rdf:resource="https://gams.uni-graz.at/o:aaif.fraweb#En3879Ph1Ad1" /><aaif:text>Virgile veut désormais vivre tout haut </aaif:text><aaif:annoText>Virgile veut désormais [v|vivre|vivre|is] tout [a|haut|haut|auvmmnnn] </aaif:annoText></aaif:Phrase><aaif:Verb rdf:about="https://gams.uni-graz.at/o:aaif.fraweb#En3879Ph1Ve1"><aaif:text>vivre</aaif:text><aaif:lemma rdf:resource="https://gams.uni-graz.at/o:aaif.lemma#vivre" /><aaif:position rdf:datatype="http://www.w3.org/2001/XMLSchema#int">1</aaif:position><aaif:coordinated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:coordinated><aaif:partOfText rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</aaif:partOfText><aaif:syntacticConstruction rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Intransitive" /></aaif:Verb><aaif:Adverb rdf:about="https://gams.uni-graz.at/o:aaif.fraweb#En3879Ph1Ad1"><aaif:text>haut</aaif:text><aaif:lemma rdf:resource="https://gams.uni-graz.at/o:aaif.lemma#haut" /><aaif:position rdf:datatype="http://www.w3.org/2001/XMLSchema#int">2</aaif:position><aaif:coordinated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:coordinated><aaif:morphosyntacticStructure rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Adjective" /><aaif:inflection rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Uninflected" /><aaif:attributionTarget rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Verb" /><aaif:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</aaif:modified><aaif:semanticClassification rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Manner" /><aaif:reduplicated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:reduplicated><aaif:prepositionalPhrase rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:prepositionalPhrase></aaif:Adverb><aaif:Entry rdf:about="https://gams.uni-graz.at/o:aaif.fraweb#En3880"><aaif:phrase rdf:resource="https://gams.uni-graz.at/o:aaif.fraweb#En3880Ph1" /><aaif:source rdf:resource="https://gams.uni-graz.at/o:aaif.fraweb.bibl#DC3901" /><gams:textualContent>Il paraît que dans ma culture une femme est mal vue si elle vit haut et fort  , et n’a pas peur de montrer ce qui la fait vibrer… </gams:textualContent><rel:isPartOf rdf:resource="https://gams.uni-graz.at/o:aaif.fraweb" /></aaif:Entry><aaif:Phrase rdf:about="https://gams.uni-graz.at/o:aaif.fraweb#En3880Ph1"><aaif:verb rdf:resource="https://gams.uni-graz.at/o:aaif.fraweb#En3880Ph1Ve1" /><aaif:adverb rdf:resource="https://gams.uni-graz.at/o:aaif.fraweb#En3880Ph1Ad1" /><aaif:adverb rdf:resource="https://gams.uni-graz.at/o:aaif.fraweb#En3880Ph1Ad2" /><aaif:text>elle vit haut et fort </aaif:text><aaif:annoText>elle [v|vit|vivre|is] [a|haut|haut|auvnmnnC] et [a|fort|fort|auvnmnnC] </aaif:annoText></aaif:Phrase><aaif:Verb rdf:about="https://gams.uni-graz.at/o:aaif.fraweb#En3880Ph1Ve1"><aaif:text>vit</aaif:text><aaif:lemma rdf:resource="https://gams.uni-graz.at/o:aaif.lemma#vivre" /><aaif:position rdf:datatype="http://www.w3.org/2001/XMLSchema#int">1</aaif:position><aaif:coordinated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:coordinated><aaif:partOfText rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</aaif:partOfText><aaif:syntacticConstruction rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Intransitive" /></aaif:Verb><aaif:Adverb rdf:about="https://gams.uni-graz.at/o:aaif.fraweb#En3880Ph1Ad1"><aaif:text>haut</aaif:text><aaif:lemma rdf:resource="https://gams.uni-graz.at/o:aaif.lemma#haut" /><aaif:position rdf:datatype="http://www.w3.org/2001/XMLSchema#int">2</aaif:position><aaif:coordinated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</aaif:coordinated><aaif:morphosyntacticStructure rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Adjective" /><aaif:inflection rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Uninflected" /><aaif:attributionTarget rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Verb" /><aaif:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:modified><aaif:semanticClassification rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Manner" /><aaif:reduplicated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:reduplicated><aaif:prepositionalPhrase rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:prepositionalPhrase></aaif:Adverb><aaif:Adverb rdf:about="https://gams.uni-graz.at/o:aaif.fraweb#En3880Ph1Ad2"><aaif:text>fort</aaif:text><aaif:lemma rdf:resource="https://gams.uni-graz.at/o:aaif.lemma#fort" /><aaif:position rdf:datatype="http://www.w3.org/2001/XMLSchema#int">3</aaif:position><aaif:coordinated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</aaif:coordinated><aaif:morphosyntacticStructure rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Adjective" /><aaif:inflection rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Uninflected" /><aaif:attributionTarget rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Verb" /><aaif:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:modified><aaif:semanticClassification rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Manner" /><aaif:reduplicated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:reduplicated><aaif:prepositionalPhrase rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:prepositionalPhrase></aaif:Adverb><aaif:Entry rdf:about="https://gams.uni-graz.at/o:aaif.fraweb#En3881"><aaif:phrase rdf:resource="https://gams.uni-graz.at/o:aaif.fraweb#En3881Ph1" /><aaif:source rdf:resource="https://gams.uni-graz.at/o:aaif.fraweb.bibl#DC3902" /><gams:textualContent>Lorsque vous dites que vous vivez dans une tour, les gens vous regardent d'un air apitoyé.Ils n'osent pas trop vous le dire, mais ils vous plaignent d'habiter dans une de ces cages à lapin : "Moi je ne pourrais pas vivre aussi haut  ".</gams:textualContent><rel:isPartOf rdf:resource="https://gams.uni-graz.at/o:aaif.fraweb" /></aaif:Entry><aaif:Phrase rdf:about="https://gams.uni-graz.at/o:aaif.fraweb#En3881Ph1"><aaif:verb rdf:resource="https://gams.uni-graz.at/o:aaif.fraweb#En3881Ph1Ve1" /><aaif:adverb rdf:resource="https://gams.uni-graz.at/o:aaif.fraweb#En3881Ph1Ad1" /><aaif:text>je ne pourrais pas vivre aussi haut </aaif:text><aaif:annoText>je ne pourrais pas [v|vivre|vivre|is] aussi [a|haut|haut|auvmmnnn] </aaif:annoText></aaif:Phrase><aaif:Verb rdf:about="https://gams.uni-graz.at/o:aaif.fraweb#En3881Ph1Ve1"><aaif:text>vivre</aaif:text><aaif:lemma rdf:resource="https://gams.uni-graz.at/o:aaif.lemma#vivre" /><aaif:position rdf:datatype="http://www.w3.org/2001/XMLSchema#int">1</aaif:position><aaif:coordinated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:coordinated><aaif:partOfText rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</aaif:partOfText><aaif:syntacticConstruction rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Intransitive" /></aaif:Verb><aaif:Adverb rdf:about="https://gams.uni-graz.at/o:aaif.fraweb#En3881Ph1Ad1"><aaif:text>haut</aaif:text><aaif:lemma rdf:resource="https://gams.uni-graz.at/o:aaif.lemma#haut" /><aaif:position rdf:datatype="http://www.w3.org/2001/XMLSchema#int">2</aaif:position><aaif:coordinated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:coordinated><aaif:morphosyntacticStructure rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Adjective" /><aaif:inflection rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Uninflected" /><aaif:attributionTarget rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Verb" /><aaif:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</aaif:modified><aaif:semanticClassification rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Manner" /><aaif:reduplicated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:reduplicated><aaif:prepositionalPhrase rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:prepositionalPhrase></aaif:Adverb><aaif:Entry rdf:about="https://gams.uni-graz.at/o:aaif.fraweb#En3882"><aaif:phrase rdf:resource="https://gams.uni-graz.at/o:aaif.fraweb#En3882Ph1" /><aaif:source rdf:resource="https://gams.uni-graz.at/o:aaif.fraweb.bibl#DC3903" /><gams:textualContent>L'amour est la conséquence qui marque les défauts de tout un individu dans le manque de sa liberté qu'il se vole lui même, qu'on lui a volé enfant, lui même dans son contrat akashique, qui se vole lui même en définitive car il ne passe pas à autre chose que l'enfermement dans sa mauvaise manière de voir le monde, et les autres qui eux voient vrais et vivent heureux  en montrant le chemin.</gams:textualContent><rel:isPartOf rdf:resource="https://gams.uni-graz.at/o:aaif.fraweb" /></aaif:Entry><aaif:Phrase rdf:about="https://gams.uni-graz.at/o:aaif.fraweb#En3882Ph1"><aaif:verb rdf:resource="https://gams.uni-graz.at/o:aaif.fraweb#En3882Ph1Ve1" /><aaif:verb rdf:resource="https://gams.uni-graz.at/o:aaif.fraweb#En3882Ph1Ve2" /><aaif:adverb rdf:resource="https://gams.uni-graz.at/o:aaif.fraweb#En3882Ph1Ad1" /><aaif:adverb rdf:resource="https://gams.uni-graz.at/o:aaif.fraweb#En3882Ph1Ad2" /><aaif:text>qui eux voient vrais et vivent heureux </aaif:text><aaif:annoText>qui eux [v|voient|voir|is] [a|vrais|vrai|aivnmnnn] et [v|vivent|vivre|is] [a|heureux|heureux|ausnmnnn] </aaif:annoText></aaif:Phrase><aaif:Verb rdf:about="https://gams.uni-graz.at/o:aaif.fraweb#En3882Ph1Ve1"><aaif:text>voient</aaif:text><aaif:lemma rdf:resource="https://gams.uni-graz.at/o:aaif.lemma#voir" /><aaif:position rdf:datatype="http://www.w3.org/2001/XMLSchema#int">1</aaif:position><aaif:coordinated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:coordinated><aaif:partOfText rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</aaif:partOfText><aaif:syntacticConstruction rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Intransitive" /></aaif:Verb><aaif:Verb rdf:about="https://gams.uni-graz.at/o:aaif.fraweb#En3882Ph1Ve2"><aaif:text>vivent</aaif:text><aaif:lemma rdf:resource="https://gams.uni-graz.at/o:aaif.lemma#vivre" /><aaif:position rdf:datatype="http://www.w3.org/2001/XMLSchema#int">3</aaif:position><aaif:coordinated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:coordinated><aaif:partOfText rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</aaif:partOfText><aaif:syntacticConstruction rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Intransitive" /></aaif:Verb><aaif:Adverb rdf:about="https://gams.uni-graz.at/o:aaif.fraweb#En3882Ph1Ad1"><aaif:text>vrais</aaif:text><aaif:lemma rdf:resource="https://gams.uni-graz.at/o:aaif.lemma#vrai" /><aaif:position rdf:datatype="http://www.w3.org/2001/XMLSchema#int">2</aaif:position><aaif:coordinated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:coordinated><aaif:morphosyntacticStructure rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Adjective" /><aaif:inflection rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#InaudibleInflection" /><aaif:attributionTarget rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Verb" /><aaif:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:modified><aaif:semanticClassification rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Manner" /><aaif:reduplicated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:reduplicated><aaif:prepositionalPhrase rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:prepositionalPhrase></aaif:Adverb><aaif:Adverb rdf:about="https://gams.uni-graz.at/o:aaif.fraweb#En3882Ph1Ad2"><aaif:text>heureux</aaif:text><aaif:lemma rdf:resource="https://gams.uni-graz.at/o:aaif.lemma#heureux" /><aaif:position rdf:datatype="http://www.w3.org/2001/XMLSchema#int">4</aaif:position><aaif:coordinated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:coordinated><aaif:morphosyntacticStructure rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Adjective" /><aaif:inflection rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Uninflected" /><aaif:attributionTarget rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Verb" /><aaif:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:modified><aaif:semanticClassification rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Manner" /><aaif:reduplicated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:reduplicated><aaif:prepositionalPhrase rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:prepositionalPhrase></aaif:Adverb><aaif:Entry rdf:about="https://gams.uni-graz.at/o:aaif.fraweb#En3883"><aaif:phrase rdf:resource="https://gams.uni-graz.at/o:aaif.fraweb#En3883Ph1" /><aaif:source rdf:resource="https://gams.uni-graz.at/o:aaif.fraweb.bibl#DC3904" /><gams:textualContent>On ne voit ou entend que des pubs pour des grandes surfaces qui vantent, bien être et qualité, traçabilité et prix cassés, ils nous feraient presque croire que leur producteurs vivent riches et heureux  !</gams:textualContent><rel:isPartOf rdf:resource="https://gams.uni-graz.at/o:aaif.fraweb" /></aaif:Entry><aaif:Phrase rdf:about="https://gams.uni-graz.at/o:aaif.fraweb#En3883Ph1"><aaif:verb rdf:resource="https://gams.uni-graz.at/o:aaif.fraweb#En3883Ph1Ve1" /><aaif:adverb rdf:resource="https://gams.uni-graz.at/o:aaif.fraweb#En3883Ph1Ad1" /><aaif:adverb rdf:resource="https://gams.uni-graz.at/o:aaif.fraweb#En3883Ph1Ad2" /><aaif:text>leur producteurs vivent riches et heureux </aaif:text><aaif:annoText>leur producteurs [v|vivent|vivre|is] [a|riches|riche|aisnmnnC] et [a|heureux|heureux|aisnmnnC] </aaif:annoText></aaif:Phrase><aaif:Verb rdf:about="https://gams.uni-graz.at/o:aaif.fraweb#En3883Ph1Ve1"><aaif:text>vivent</aaif:text><aaif:lemma rdf:resource="https://gams.uni-graz.at/o:aaif.lemma#vivre" /><aaif:position rdf:datatype="http://www.w3.org/2001/XMLSchema#int">1</aaif:position><aaif:coordinated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:coordinated><aaif:partOfText rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</aaif:partOfText><aaif:syntacticConstruction rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Intransitive" /></aaif:Verb><aaif:Adverb rdf:about="https://gams.uni-graz.at/o:aaif.fraweb#En3883Ph1Ad1"><aaif:text>riches</aaif:text><aaif:lemma rdf:resource="https://gams.uni-graz.at/o:aaif.lemma#riche" /><aaif:position rdf:datatype="http://www.w3.org/2001/XMLSchema#int">2</aaif:position><aaif:coordinated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</aaif:coordinated><aaif:morphosyntacticStructure rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Adjective" /><aaif:inflection rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#InaudibleInflection" /><aaif:attributionTarget rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Verb" /><aaif:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:modified><aaif:semanticClassification rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Manner" /><aaif:reduplicated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:reduplicated><aaif:prepositionalPhrase rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:prepositionalPhrase></aaif:Adverb><aaif:Adverb rdf:about="https://gams.uni-graz.at/o:aaif.fraweb#En3883Ph1Ad2"><aaif:text>heureux</aaif:text><aaif:lemma rdf:resource="https://gams.uni-graz.at/o:aaif.lemma#heureux" /><aaif:position rdf:datatype="http://www.w3.org/2001/XMLSchema#int">3</aaif:position><aaif:coordinated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</aaif:coordinated><aaif:morphosyntacticStructure rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Adjective" /><aaif:inflection rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#InaudibleInflection" /><aaif:attributionTarget rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Verb" /><aaif:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:modified><aaif:semanticClassification rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Manner" /><aaif:reduplicated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:reduplicated><aaif:prepositionalPhrase rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:prepositionalPhrase></aaif:Adverb><aaif:Entry rdf:about="https://gams.uni-graz.at/o:aaif.fraweb#En3884"><aaif:phrase rdf:resource="https://gams.uni-graz.at/o:aaif.fraweb#En3884Ph1" /><aaif:source rdf:resource="https://gams.uni-graz.at/o:aaif.fraweb.bibl#DC3905" /><gams:textualContent>Les Zarbi étaient très timides et n'allaient pas à l'extérieur des ruines.En effet, l'environnement des ruines est peuplé par de plus en plus de monde.Il est dit que cette tribu, celle qui a souhaité que les Zarbi vivent paisible et heureux , a décidé de partir laissant ainsi les Zarbi seuls.</gams:textualContent><rel:isPartOf rdf:resource="https://gams.uni-graz.at/o:aaif.fraweb" /></aaif:Entry><aaif:Phrase rdf:about="https://gams.uni-graz.at/o:aaif.fraweb#En3884Ph1"><aaif:verb rdf:resource="https://gams.uni-graz.at/o:aaif.fraweb#En3884Ph1Ve1" /><aaif:adverb rdf:resource="https://gams.uni-graz.at/o:aaif.fraweb#En3884Ph1Ad1" /><aaif:adverb rdf:resource="https://gams.uni-graz.at/o:aaif.fraweb#En3884Ph1Ad2" /><aaif:text>les Zarbi vivent paisible et heureux </aaif:text><aaif:annoText>les Zarbi [v|vivent|vivre|is] [a|paisible|paisible|ausnmnnC] et [a|heureux|heureux|ausnmnnC] </aaif:annoText></aaif:Phrase><aaif:Verb rdf:about="https://gams.uni-graz.at/o:aaif.fraweb#En3884Ph1Ve1"><aaif:text>vivent</aaif:text><aaif:lemma rdf:resource="https://gams.uni-graz.at/o:aaif.lemma#vivre" /><aaif:position rdf:datatype="http://www.w3.org/2001/XMLSchema#int">1</aaif:position><aaif:coordinated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:coordinated><aaif:partOfText rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</aaif:partOfText><aaif:syntacticConstruction rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Intransitive" /></aaif:Verb><aaif:Adverb rdf:about="https://gams.uni-graz.at/o:aaif.fraweb#En3884Ph1Ad1"><aaif:text>paisible</aaif:text><aaif:lemma rdf:resource="https://gams.uni-graz.at/o:aaif.lemma#paisible" /><aaif:position rdf:datatype="http://www.w3.org/2001/XMLSchema#int">2</aaif:position><aaif:coordinated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</aaif:coordinated><aaif:morphosyntacticStructure rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Adjective" /><aaif:inflection rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Uninflected" /><aaif:attributionTarget rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Verb" /><aaif:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:modified><aaif:semanticClassification rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Manner" /><aaif:reduplicated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:reduplicated><aaif:prepositionalPhrase rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:prepositionalPhrase></aaif:Adverb><aaif:Adverb rdf:about="https://gams.uni-graz.at/o:aaif.fraweb#En3884Ph1Ad2"><aaif:text>heureux</aaif:text><aaif:lemma rdf:resource="https://gams.uni-graz.at/o:aaif.lemma#heureux" /><aaif:position rdf:datatype="http://www.w3.org/2001/XMLSchema#int">3</aaif:position><aaif:coordinated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</aaif:coordinated><aaif:morphosyntacticStructure rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Adjective" /><aaif:inflection rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Uninflected" /><aaif:attributionTarget rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Verb" /><aaif:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:modified><aaif:semanticClassification rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Manner" /><aaif:reduplicated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:reduplicated><aaif:prepositionalPhrase rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:prepositionalPhrase></aaif:Adverb><aaif:Entry rdf:about="https://gams.uni-graz.at/o:aaif.fraweb#En3885"><aaif:phrase rdf:resource="https://gams.uni-graz.at/o:aaif.fraweb#En3885Ph1" /><aaif:source rdf:resource="https://gams.uni-graz.at/o:aaif.fraweb.bibl#DC3906" /><gams:textualContent>Auprès de Julian, elle vivait heureux  , elle aurait jamais du s'éloigner de Julian</gams:textualContent><rel:isPartOf rdf:resource="https://gams.uni-graz.at/o:aaif.fraweb" /></aaif:Entry><aaif:Phrase rdf:about="https://gams.uni-graz.at/o:aaif.fraweb#En3885Ph1"><aaif:verb rdf:resource="https://gams.uni-graz.at/o:aaif.fraweb#En3885Ph1Ve1" /><aaif:adverb rdf:resource="https://gams.uni-graz.at/o:aaif.fraweb#En3885Ph1Ad1" /><aaif:text>elle vivait heureux </aaif:text><aaif:annoText>elle [v|vivait|vivre|is] [a|heureux|heureux|ausnmnnn] </aaif:annoText></aaif:Phrase><aaif:Verb rdf:about="https://gams.uni-graz.at/o:aaif.fraweb#En3885Ph1Ve1"><aaif:text>vivait</aaif:text><aaif:lemma rdf:resource="https://gams.uni-graz.at/o:aaif.lemma#vivre" /><aaif:position rdf:datatype="http://www.w3.org/2001/XMLSchema#int">1</aaif:position><aaif:coordinated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:coordinated><aaif:partOfText rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</aaif:partOfText><aaif:syntacticConstruction rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Intransitive" /></aaif:Verb><aaif:Adverb rdf:about="https://gams.uni-graz.at/o:aaif.fraweb#En3885Ph1Ad1"><aaif:text>heureux</aaif:text><aaif:lemma rdf:resource="https://gams.uni-graz.at/o:aaif.lemma#heureux" /><aaif:position rdf:datatype="http://www.w3.org/2001/XMLSchema#int">2</aaif:position><aaif:coordinated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:coordinated><aaif:morphosyntacticStructure rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Adjective" /><aaif:inflection rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Uninflected" /><aaif:attributionTarget rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Verb" /><aaif:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:modified><aaif:semanticClassification rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Manner" /><aaif:reduplicated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:reduplicated><aaif:prepositionalPhrase rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:prepositionalPhrase></aaif:Adverb><aaif:Entry rdf:about="https://gams.uni-graz.at/o:aaif.fraweb#En3886"><aaif:phrase rdf:resource="https://gams.uni-graz.at/o:aaif.fraweb#En3886Ph1" /><aaif:source rdf:resource="https://gams.uni-graz.at/o:aaif.fraweb.bibl#DC3907" /><gams:textualContent>La communauté juive vit heureuse  à Marseille depuis des décennies.</gams:textualContent><rel:isPartOf rdf:resource="https://gams.uni-graz.at/o:aaif.fraweb" /></aaif:Entry><aaif:Phrase rdf:about="https://gams.uni-graz.at/o:aaif.fraweb#En3886Ph1"><aaif:verb rdf:resource="https://gams.uni-graz.at/o:aaif.fraweb#En3886Ph1Ve1" /><aaif:adverb rdf:resource="https://gams.uni-graz.at/o:aaif.fraweb#En3886Ph1Ad1" /><aaif:text>La communauté juive vit heureuse </aaif:text><aaif:annoText>La communauté juive [v|vit|vivre|is] [a|heureuse|heureux|aasnmnnn] </aaif:annoText></aaif:Phrase><aaif:Verb rdf:about="https://gams.uni-graz.at/o:aaif.fraweb#En3886Ph1Ve1"><aaif:text>vit</aaif:text><aaif:lemma rdf:resource="https://gams.uni-graz.at/o:aaif.lemma#vivre" /><aaif:position rdf:datatype="http://www.w3.org/2001/XMLSchema#int">1</aaif:position><aaif:coordinated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:coordinated><aaif:partOfText rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</aaif:partOfText><aaif:syntacticConstruction rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Intransitive" /></aaif:Verb><aaif:Adverb rdf:about="https://gams.uni-graz.at/o:aaif.fraweb#En3886Ph1Ad1"><aaif:text>heureuse</aaif:text><aaif:lemma rdf:resource="https://gams.uni-graz.at/o:aaif.lemma#heureux" /><aaif:position rdf:datatype="http://www.w3.org/2001/XMLSchema#int">2</aaif:position><aaif:coordinated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:coordinated><aaif:morphosyntacticStructure rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Adjective" /><aaif:inflection rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#AudibleInflection" /><aaif:attributionTarget rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Verb" /><aaif:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:modified><aaif:semanticClassification rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Manner" /><aaif:reduplicated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:reduplicated><aaif:prepositionalPhrase rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:prepositionalPhrase></aaif:Adverb><aaif:Entry rdf:about="https://gams.uni-graz.at/o:aaif.fraweb#En3887"><aaif:phrase rdf:resource="https://gams.uni-graz.at/o:aaif.fraweb#En3887Ph1" /><aaif:phrase rdf:resource="https://gams.uni-graz.at/o:aaif.fraweb#En3887Ph2" /><aaif:source rdf:resource="https://gams.uni-graz.at/o:aaif.fraweb.bibl#DC3908" /><gams:textualContent>Un jeune étudiant poursuit : « Le Burkina-Faso a-t-il besoin de la foi chrétienne pour vivre honnête  et respecter la dignité de l’être humain ?Le bon sens de nos traditions locales n’est-il pas suffisant pour vivre heureux et équilibré  ?Des gens de la religion traditionnelle sont plus rigoureux que nous.» </gams:textualContent><rel:isPartOf rdf:resource="https://gams.uni-graz.at/o:aaif.fraweb" /></aaif:Entry><aaif:Phrase rdf:about="https://gams.uni-graz.at/o:aaif.fraweb#En3887Ph1"><aaif:verb rdf:resource="https://gams.uni-graz.at/o:aaif.fraweb#En3887Ph1Ve1" /><aaif:adverb rdf:resource="https://gams.uni-graz.at/o:aaif.fraweb#En3887Ph1Ad1" /><aaif:text>pour vivre honnête </aaif:text><aaif:annoText>pour [v|vivre|vivre|is] [a|honnête|honnête|ausnmnnn] </aaif:annoText></aaif:Phrase><aaif:Verb rdf:about="https://gams.uni-graz.at/o:aaif.fraweb#En3887Ph1Ve1"><aaif:text>vivre</aaif:text><aaif:lemma rdf:resource="https://gams.uni-graz.at/o:aaif.lemma#vivre" /><aaif:position rdf:datatype="http://www.w3.org/2001/XMLSchema#int">1</aaif:position><aaif:coordinated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:coordinated><aaif:partOfText rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</aaif:partOfText><aaif:syntacticConstruction rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Intransitive" /></aaif:Verb><aaif:Adverb rdf:about="https://gams.uni-graz.at/o:aaif.fraweb#En3887Ph1Ad1"><aaif:text>honnête</aaif:text><aaif:lemma rdf:resource="https://gams.uni-graz.at/o:aaif.lemma#honnête" /><aaif:position rdf:datatype="http://www.w3.org/2001/XMLSchema#int">2</aaif:position><aaif:coordinated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:coordinated><aaif:morphosyntacticStructure rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Adjective" /><aaif:inflection rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Uninflected" /><aaif:attributionTarget rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Verb" /><aaif:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:modified><aaif:semanticClassification rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Manner" /><aaif:reduplicated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:reduplicated><aaif:prepositionalPhrase rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:prepositionalPhrase></aaif:Adverb><aaif:Phrase rdf:about="https://gams.uni-graz.at/o:aaif.fraweb#En3887Ph2"><aaif:verb rdf:resource="https://gams.uni-graz.at/o:aaif.fraweb#En3887Ph2Ve1" /><aaif:adverb rdf:resource="https://gams.uni-graz.at/o:aaif.fraweb#En3887Ph2Ad1" /><aaif:adverb rdf:resource="https://gams.uni-graz.at/o:aaif.fraweb#En3887Ph2Ad2" /><aaif:text>pour vivre heureux et équilibré </aaif:text><aaif:annoText>pour [v|vivre|vivre|is] [a|heureux|heureux|ausnmnnC] et [a|équilibré|équilibré|ausnmnnC] </aaif:annoText></aaif:Phrase><aaif:Verb rdf:about="https://gams.uni-graz.at/o:aaif.fraweb#En3887Ph2Ve1"><aaif:text>vivre</aaif:text><aaif:lemma rdf:resource="https://gams.uni-graz.at/o:aaif.lemma#vivre" /><aaif:position rdf:datatype="http://www.w3.org/2001/XMLSchema#int">1</aaif:position><aaif:coordinated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:coordinated><aaif:partOfText rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</aaif:partOfText><aaif:syntacticConstruction rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Intransitive" /></aaif:Verb><aaif:Adverb rdf:about="https://gams.uni-graz.at/o:aaif.fraweb#En3887Ph2Ad1"><aaif:text>heureux</aaif:text><aaif:lemma rdf:resource="https://gams.uni-graz.at/o:aaif.lemma#heureux" /><aaif:position rdf:datatype="http://www.w3.org/2001/XMLSchema#int">2</aaif:position><aaif:coordinated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</aaif:coordinated><aaif:morphosyntacticStructure rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Adjective" /><aaif:inflection rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Uninflected" /><aaif:attributionTarget rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Verb" /><aaif:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:modified><aaif:semanticClassification rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Manner" /><aaif:reduplicated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:reduplicated><aaif:prepositionalPhrase rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:prepositionalPhrase></aaif:Adverb><aaif:Adverb rdf:about="https://gams.uni-graz.at/o:aaif.fraweb#En3887Ph2Ad2"><aaif:text>équilibré</aaif:text><aaif:lemma rdf:resource="https://gams.uni-graz.at/o:aaif.lemma#équilibré" /><aaif:position rdf:datatype="http://www.w3.org/2001/XMLSchema#int">3</aaif:position><aaif:coordinated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</aaif:coordinated><aaif:morphosyntacticStructure rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Adjective" /><aaif:inflection rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Uninflected" /><aaif:attributionTarget rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Verb" /><aaif:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:modified><aaif:semanticClassification rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Manner" /><aaif:reduplicated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:reduplicated><aaif:prepositionalPhrase rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:prepositionalPhrase></aaif:Adverb><aaif:Entry rdf:about="https://gams.uni-graz.at/o:aaif.fraweb#En3888"><aaif:phrase rdf:resource="https://gams.uni-graz.at/o:aaif.fraweb#En3888Ph1" /><aaif:source rdf:resource="https://gams.uni-graz.at/o:aaif.fraweb.bibl#DC3909" /><gams:textualContent>Le sort des gens qui vivent honnête  , le travail productif est devenu une pauvreté sans espoir.Même le proche avenir est imprévisible.Dans ces conditions, il existe un processus objectif dadaptation de la société à lauto-organisation de nouvelles structures à tous les niveaux.</gams:textualContent><rel:isPartOf rdf:resource="https://gams.uni-graz.at/o:aaif.fraweb" /></aaif:Entry><aaif:Phrase rdf:about="https://gams.uni-graz.at/o:aaif.fraweb#En3888Ph1"><aaif:verb rdf:resource="https://gams.uni-graz.at/o:aaif.fraweb#En3888Ph1Ve1" /><aaif:adverb rdf:resource="https://gams.uni-graz.at/o:aaif.fraweb#En3888Ph1Ad1" /><aaif:text>des gens qui vivent honnête </aaif:text><aaif:annoText>des gens qui [v|vivent|vivre|is] [a|honnête|honnête|ausnmnnn] </aaif:annoText></aaif:Phrase><aaif:Verb rdf:about="https://gams.uni-graz.at/o:aaif.fraweb#En3888Ph1Ve1"><aaif:text>vivent</aaif:text><aaif:lemma rdf:resource="https://gams.uni-graz.at/o:aaif.lemma#vivre" /><aaif:position rdf:datatype="http://www.w3.org/2001/XMLSchema#int">1</aaif:position><aaif:coordinated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:coordinated><aaif:partOfText rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</aaif:partOfText><aaif:syntacticConstruction rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Intransitive" /></aaif:Verb><aaif:Adverb rdf:about="https://gams.uni-graz.at/o:aaif.fraweb#En3888Ph1Ad1"><aaif:text>honnête</aaif:text><aaif:lemma rdf:resource="https://gams.uni-graz.at/o:aaif.lemma#honnête" /><aaif:position rdf:datatype="http://www.w3.org/2001/XMLSchema#int">2</aaif:position><aaif:coordinated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:coordinated><aaif:morphosyntacticStructure rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Adjective" /><aaif:inflection rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Uninflected" /><aaif:attributionTarget rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Verb" /><aaif:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:modified><aaif:semanticClassification rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Manner" /><aaif:reduplicated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:reduplicated><aaif:prepositionalPhrase rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:prepositionalPhrase></aaif:Adverb><aaif:Entry rdf:about="https://gams.uni-graz.at/o:aaif.fraweb#En3889"><aaif:phrase rdf:resource="https://gams.uni-graz.at/o:aaif.fraweb#En3889Ph1" /><aaif:source rdf:resource="https://gams.uni-graz.at/o:aaif.fraweb.bibl#DC3910" /><gams:textualContent>… Elle aura un fils, que tu appelleras Jésus.Il mènera les hommes sur le chemin que lui montrera Dieu, pour qu’ils vivent honnêtes et vertueux .» </gams:textualContent><rel:isPartOf rdf:resource="https://gams.uni-graz.at/o:aaif.fraweb" /></aaif:Entry><aaif:Phrase rdf:about="https://gams.uni-graz.at/o:aaif.fraweb#En3889Ph1"><aaif:verb rdf:resource="https://gams.uni-graz.at/o:aaif.fraweb#En3889Ph1Ve1" /><aaif:adverb rdf:resource="https://gams.uni-graz.at/o:aaif.fraweb#En3889Ph1Ad1" /><aaif:adverb rdf:resource="https://gams.uni-graz.at/o:aaif.fraweb#En3889Ph1Ad2" /><aaif:text>ils vivent honnêtes et vertueux </aaif:text><aaif:annoText>ils [v|vivent|vivre|is] [a|honnêtes|honnête|aisnmnnC] et [a|vertueux|vertueux|aisnmnnC] </aaif:annoText></aaif:Phrase><aaif:Verb rdf:about="https://gams.uni-graz.at/o:aaif.fraweb#En3889Ph1Ve1"><aaif:text>vivent</aaif:text><aaif:lemma rdf:resource="https://gams.uni-graz.at/o:aaif.lemma#vivre" /><aaif:position rdf:datatype="http://www.w3.org/2001/XMLSchema#int">1</aaif:position><aaif:coordinated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:coordinated><aaif:partOfText rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</aaif:partOfText><aaif:syntacticConstruction rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Intransitive" /></aaif:Verb><aaif:Adverb rdf:about="https://gams.uni-graz.at/o:aaif.fraweb#En3889Ph1Ad1"><aaif:text>honnêtes</aaif:text><aaif:lemma rdf:resource="https://gams.uni-graz.at/o:aaif.lemma#honnête" /><aaif:position rdf:datatype="http://www.w3.org/2001/XMLSchema#int">2</aaif:position><aaif:coordinated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</aaif:coordinated><aaif:morphosyntacticStructure rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Adjective" /><aaif:inflection rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#InaudibleInflection" /><aaif:attributionTarget rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Verb" /><aaif:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:modified><aaif:semanticClassification rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Manner" /><aaif:reduplicated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:reduplicated><aaif:prepositionalPhrase rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:prepositionalPhrase></aaif:Adverb><aaif:Adverb rdf:about="https://gams.uni-graz.at/o:aaif.fraweb#En3889Ph1Ad2"><aaif:text>vertueux</aaif:text><aaif:lemma rdf:resource="https://gams.uni-graz.at/o:aaif.lemma#vertueux" /><aaif:position rdf:datatype="http://www.w3.org/2001/XMLSchema#int">3</aaif:position><aaif:coordinated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</aaif:coordinated><aaif:morphosyntacticStructure rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Adjective" /><aaif:inflection rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#InaudibleInflection" /><aaif:attributionTarget rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Verb" /><aaif:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:modified><aaif:semanticClassification rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Manner" /><aaif:reduplicated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:reduplicated><aaif:prepositionalPhrase rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:prepositionalPhrase></aaif:Adverb><aaif:Entry rdf:about="https://gams.uni-graz.at/o:aaif.fraweb#En3890"><aaif:phrase rdf:resource="https://gams.uni-graz.at/o:aaif.fraweb#En3890Ph1" /><aaif:source rdf:resource="https://gams.uni-graz.at/o:aaif.fraweb.bibl#DC3911" /><gams:textualContent>Les résidences autonomie : une solution pour vivre indépendant  tout en bénéficiant de services </gams:textualContent><rel:isPartOf rdf:resource="https://gams.uni-graz.at/o:aaif.fraweb" /></aaif:Entry><aaif:Phrase rdf:about="https://gams.uni-graz.at/o:aaif.fraweb#En3890Ph1"><aaif:verb rdf:resource="https://gams.uni-graz.at/o:aaif.fraweb#En3890Ph1Ve1" /><aaif:adverb rdf:resource="https://gams.uni-graz.at/o:aaif.fraweb#En3890Ph1Ad1" /><aaif:text>une solution pour vivre indépendant </aaif:text><aaif:annoText>une solution pour [v|vivre|vivre|is] [a|indépendant|indépendant|ausnmnnn] </aaif:annoText></aaif:Phrase><aaif:Verb rdf:about="https://gams.uni-graz.at/o:aaif.fraweb#En3890Ph1Ve1"><aaif:text>vivre</aaif:text><aaif:lemma rdf:resource="https://gams.uni-graz.at/o:aaif.lemma#vivre" /><aaif:position rdf:datatype="http://www.w3.org/2001/XMLSchema#int">1</aaif:position><aaif:coordinated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:coordinated><aaif:partOfText rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</aaif:partOfText><aaif:syntacticConstruction rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Intransitive" /></aaif:Verb><aaif:Adverb rdf:about="https://gams.uni-graz.at/o:aaif.fraweb#En3890Ph1Ad1"><aaif:text>indépendant</aaif:text><aaif:lemma rdf:resource="https://gams.uni-graz.at/o:aaif.lemma#indépendant" /><aaif:position rdf:datatype="http://www.w3.org/2001/XMLSchema#int">2</aaif:position><aaif:coordinated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:coordinated><aaif:morphosyntacticStructure rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Adjective" /><aaif:inflection rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Uninflected" /><aaif:attributionTarget rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Verb" /><aaif:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:modified><aaif:semanticClassification rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Manner" /><aaif:reduplicated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:reduplicated><aaif:prepositionalPhrase rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:prepositionalPhrase></aaif:Adverb><aaif:Entry rdf:about="https://gams.uni-graz.at/o:aaif.fraweb#En3891"><aaif:phrase rdf:resource="https://gams.uni-graz.at/o:aaif.fraweb#En3891Ph1" /><aaif:source rdf:resource="https://gams.uni-graz.at/o:aaif.fraweb.bibl#DC3912" /><gams:textualContent> Vivre  indépendant et dans un cadre élégant.Si vous souhaitez visiter une résidence, contactez Sopregim.</gams:textualContent><rel:isPartOf rdf:resource="https://gams.uni-graz.at/o:aaif.fraweb" /></aaif:Entry><aaif:Phrase rdf:about="https://gams.uni-graz.at/o:aaif.fraweb#En3891Ph1"><aaif:verb rdf:resource="https://gams.uni-graz.at/o:aaif.fraweb#En3891Ph1Ve1" /><aaif:adverb rdf:resource="https://gams.uni-graz.at/o:aaif.fraweb#En3891Ph1Ad1" /><aaif:text> Vivre  indépendant et dans un cadre élégant</aaif:text><aaif:annoText> [v|Vivre|vivre|is]  [a|indépendant|indépendant|ausnmnnC] et dans un cadre élégant</aaif:annoText></aaif:Phrase><aaif:Verb rdf:about="https://gams.uni-graz.at/o:aaif.fraweb#En3891Ph1Ve1"><aaif:text>Vivre</aaif:text><aaif:lemma rdf:resource="https://gams.uni-graz.at/o:aaif.lemma#vivre" /><aaif:position rdf:datatype="http://www.w3.org/2001/XMLSchema#int">1</aaif:position><aaif:coordinated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:coordinated><aaif:partOfText rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</aaif:partOfText><aaif:syntacticConstruction rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Intransitive" /></aaif:Verb><aaif:Adverb rdf:about="https://gams.uni-graz.at/o:aaif.fraweb#En3891Ph1Ad1"><aaif:text>indépendant</aaif:text><aaif:lemma rdf:resource="https://gams.uni-graz.at/o:aaif.lemma#indépendant" /><aaif:position rdf:datatype="http://www.w3.org/2001/XMLSchema#int">2</aaif:position><aaif:coordinated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</aaif:coordinated><aaif:morphosyntacticStructure rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Adjective" /><aaif:inflection rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Uninflected" /><aaif:attributionTarget rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Verb" /><aaif:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:modified><aaif:semanticClassification rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Manner" /><aaif:reduplicated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:reduplicated><aaif:prepositionalPhrase rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:prepositionalPhrase></aaif:Adverb><aaif:Entry rdf:about="https://gams.uni-graz.at/o:aaif.fraweb#En3892"><aaif:phrase rdf:resource="https://gams.uni-graz.at/o:aaif.fraweb#En3892Ph1" /><aaif:source rdf:resource="https://gams.uni-graz.at/o:aaif.fraweb.bibl#DC3913" /><gams:textualContent>Certains clubs ne sont pas affiliés aux Aînés Ruraux et vivent indépendants  .</gams:textualContent><rel:isPartOf rdf:resource="https://gams.uni-graz.at/o:aaif.fraweb" /></aaif:Entry><aaif:Phrase rdf:about="https://gams.uni-graz.at/o:aaif.fraweb#En3892Ph1"><aaif:verb rdf:resource="https://gams.uni-graz.at/o:aaif.fraweb#En3892Ph1Ve1" /><aaif:adverb rdf:resource="https://gams.uni-graz.at/o:aaif.fraweb#En3892Ph1Ad1" /><aaif:text>Certains clubs ne sont pas affiliés aux Aînés Ruraux et vivent indépendants </aaif:text><aaif:annoText>Certains clubs ne sont pas affiliés aux Aînés Ruraux et [v|vivent|vivre|is] [a|indépendants|indépendant|aisnmnnn] </aaif:annoText></aaif:Phrase><aaif:Verb rdf:about="https://gams.uni-graz.at/o:aaif.fraweb#En3892Ph1Ve1"><aaif:text>vivent</aaif:text><aaif:lemma rdf:resource="https://gams.uni-graz.at/o:aaif.lemma#vivre" /><aaif:position rdf:datatype="http://www.w3.org/2001/XMLSchema#int">1</aaif:position><aaif:coordinated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:coordinated><aaif:partOfText rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</aaif:partOfText><aaif:syntacticConstruction rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Intransitive" /></aaif:Verb><aaif:Adverb rdf:about="https://gams.uni-graz.at/o:aaif.fraweb#En3892Ph1Ad1"><aaif:text>indépendants</aaif:text><aaif:lemma rdf:resource="https://gams.uni-graz.at/o:aaif.lemma#indépendant" /><aaif:position rdf:datatype="http://www.w3.org/2001/XMLSchema#int">2</aaif:position><aaif:coordinated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:coordinated><aaif:morphosyntacticStructure rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Adjective" /><aaif:inflection rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#InaudibleInflection" /><aaif:attributionTarget rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Verb" /><aaif:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:modified><aaif:semanticClassification rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Manner" /><aaif:reduplicated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:reduplicated><aaif:prepositionalPhrase rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:prepositionalPhrase></aaif:Adverb><aaif:Entry rdf:about="https://gams.uni-graz.at/o:aaif.fraweb#En3893"><aaif:phrase rdf:resource="https://gams.uni-graz.at/o:aaif.fraweb#En3893Ph1" /><aaif:source rdf:resource="https://gams.uni-graz.at/o:aaif.fraweb.bibl#DC3914" /><gams:textualContent>Et l'on assiste beaucoup plus souvent à un faux départ : entre ceux qui vivent indépendants  la semaine mais reviennent tous les week-ends, ceux qui partent le temps de leurs études et se réinstallent chez leurs parents faute d'emploi stable, ceux qui perdent leur travail et retournent chez leur mère, au total près de la moitié des enfants partis de chez eux pratiquent en réalité des allers et retours.</gams:textualContent><rel:isPartOf rdf:resource="https://gams.uni-graz.at/o:aaif.fraweb" /></aaif:Entry><aaif:Phrase rdf:about="https://gams.uni-graz.at/o:aaif.fraweb#En3893Ph1"><aaif:verb rdf:resource="https://gams.uni-graz.at/o:aaif.fraweb#En3893Ph1Ve1" /><aaif:adverb rdf:resource="https://gams.uni-graz.at/o:aaif.fraweb#En3893Ph1Ad1" /><aaif:text>ceux qui vivent indépendants </aaif:text><aaif:annoText>ceux qui [v|vivent|vivre|is] [a|indépendants|indépendant|aisnmnnn] </aaif:annoText></aaif:Phrase><aaif:Verb rdf:about="https://gams.uni-graz.at/o:aaif.fraweb#En3893Ph1Ve1"><aaif:text>vivent</aaif:text><aaif:lemma rdf:resource="https://gams.uni-graz.at/o:aaif.lemma#vivre" /><aaif:position rdf:datatype="http://www.w3.org/2001/XMLSchema#int">1</aaif:position><aaif:coordinated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:coordinated><aaif:partOfText rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</aaif:partOfText><aaif:syntacticConstruction rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Intransitive" /></aaif:Verb><aaif:Adverb rdf:about="https://gams.uni-graz.at/o:aaif.fraweb#En3893Ph1Ad1"><aaif:text>indépendants</aaif:text><aaif:lemma rdf:resource="https://gams.uni-graz.at/o:aaif.lemma#indépendant" /><aaif:position rdf:datatype="http://www.w3.org/2001/XMLSchema#int">2</aaif:position><aaif:coordinated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:coordinated><aaif:morphosyntacticStructure rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Adjective" /><aaif:inflection rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#InaudibleInflection" /><aaif:attributionTarget rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Verb" /><aaif:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:modified><aaif:semanticClassification rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Manner" /><aaif:reduplicated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:reduplicated><aaif:prepositionalPhrase rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:prepositionalPhrase></aaif:Adverb><aaif:Entry rdf:about="https://gams.uni-graz.at/o:aaif.fraweb#En3894"><aaif:phrase rdf:resource="https://gams.uni-graz.at/o:aaif.fraweb#En3894Ph1" /><aaif:source rdf:resource="https://gams.uni-graz.at/o:aaif.fraweb.bibl#DC3915" /><gams:textualContent>Mercredi dernier, ils ont participé à une cérémonie de planting d’arbre.Ce qui leur donne l’assurance de ne pas vivre inutile  , comme le dit l’adage.</gams:textualContent><rel:isPartOf rdf:resource="https://gams.uni-graz.at/o:aaif.fraweb" /></aaif:Entry><aaif:Phrase rdf:about="https://gams.uni-graz.at/o:aaif.fraweb#En3894Ph1"><aaif:verb rdf:resource="https://gams.uni-graz.at/o:aaif.fraweb#En3894Ph1Ve1" /><aaif:adverb rdf:resource="https://gams.uni-graz.at/o:aaif.fraweb#En3894Ph1Ad1" /><aaif:text>Ce qui leur donne l’assurance de ne pas vivre inutile </aaif:text><aaif:annoText>Ce qui leur donne l’assurance de ne pas [v|vivre|vivre|is] [a|inutile|inutile|auvnmnnn] </aaif:annoText></aaif:Phrase><aaif:Verb rdf:about="https://gams.uni-graz.at/o:aaif.fraweb#En3894Ph1Ve1"><aaif:text>vivre</aaif:text><aaif:lemma rdf:resource="https://gams.uni-graz.at/o:aaif.lemma#vivre" /><aaif:position rdf:datatype="http://www.w3.org/2001/XMLSchema#int">1</aaif:position><aaif:coordinated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:coordinated><aaif:partOfText rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</aaif:partOfText><aaif:syntacticConstruction rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Intransitive" /></aaif:Verb><aaif:Adverb rdf:about="https://gams.uni-graz.at/o:aaif.fraweb#En3894Ph1Ad1"><aaif:text>inutile</aaif:text><aaif:lemma rdf:resource="https://gams.uni-graz.at/o:aaif.lemma#inutile" /><aaif:position rdf:datatype="http://www.w3.org/2001/XMLSchema#int">2</aaif:position><aaif:coordinated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:coordinated><aaif:morphosyntacticStructure rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Adjective" /><aaif:inflection rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Uninflected" /><aaif:attributionTarget rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Verb" /><aaif:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:modified><aaif:semanticClassification rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Manner" /><aaif:reduplicated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:reduplicated><aaif:prepositionalPhrase rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:prepositionalPhrase></aaif:Adverb><aaif:Entry rdf:about="https://gams.uni-graz.at/o:aaif.fraweb#En3895"><aaif:phrase rdf:resource="https://gams.uni-graz.at/o:aaif.fraweb#En3895Ph1" /><aaif:source rdf:resource="https://gams.uni-graz.at/o:aaif.fraweb.bibl#DC3916 /page4 (18.4.2016)" /><gams:textualContent>tu as raison, j'ai raisonné "vivre bien ", pour vivre juste  il n'y a pas besoin d'economiser etc...Le tout etant d'avoir un roulement de capital suffisant pour ne pas prendre de credit à la consommation; le credit pour residence principale; etant lui admis.</gams:textualContent><rel:isPartOf rdf:resource="https://gams.uni-graz.at/o:aaif.fraweb" /></aaif:Entry><aaif:Phrase rdf:about="https://gams.uni-graz.at/o:aaif.fraweb#En3895Ph1"><aaif:verb rdf:resource="https://gams.uni-graz.at/o:aaif.fraweb#En3895Ph1Ve1" /><aaif:adverb rdf:resource="https://gams.uni-graz.at/o:aaif.fraweb#En3895Ph1Ad1" /><aaif:text>\"vivre bien \", pour vivre juste </aaif:text><aaif:annoText>\"vivre bien \", pour [v|vivre|vivre|is] [a|juste|juste|auvnmnnn] </aaif:annoText></aaif:Phrase><aaif:Verb rdf:about="https://gams.uni-graz.at/o:aaif.fraweb#En3895Ph1Ve1"><aaif:text>vivre</aaif:text><aaif:lemma rdf:resource="https://gams.uni-graz.at/o:aaif.lemma#vivre" /><aaif:position rdf:datatype="http://www.w3.org/2001/XMLSchema#int">1</aaif:position><aaif:coordinated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:coordinated><aaif:partOfText rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</aaif:partOfText><aaif:syntacticConstruction rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Intransitive" /></aaif:Verb><aaif:Adverb rdf:about="https://gams.uni-graz.at/o:aaif.fraweb#En3895Ph1Ad1"><aaif:text>juste</aaif:text><aaif:lemma rdf:resource="https://gams.uni-graz.at/o:aaif.lemma#juste" /><aaif:position rdf:datatype="http://www.w3.org/2001/XMLSchema#int">2</aaif:position><aaif:coordinated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:coordinated><aaif:morphosyntacticStructure rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Adjective" /><aaif:inflection rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Uninflected" /><aaif:attributionTarget rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Verb" /><aaif:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:modified><aaif:semanticClassification rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Manner" /><aaif:reduplicated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:reduplicated><aaif:prepositionalPhrase rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:prepositionalPhrase></aaif:Adverb><aaif:Entry rdf:about="https://gams.uni-graz.at/o:aaif.fraweb#En3896"><aaif:phrase rdf:resource="https://gams.uni-graz.at/o:aaif.fraweb#En3896Ph1" /><aaif:source rdf:resource="https://gams.uni-graz.at/o:aaif.fraweb.bibl#DC3917" /><gams:textualContent>En ce jour de votre vie, je crois que Dieu souhaite que vous sachiez … que vous en tirerez les plus grands bénéfices si vous vous efforcez d’être une bonne personne.Efforcez-vous de vivre juste  .</gams:textualContent><rel:isPartOf rdf:resource="https://gams.uni-graz.at/o:aaif.fraweb" /></aaif:Entry><aaif:Phrase rdf:about="https://gams.uni-graz.at/o:aaif.fraweb#En3896Ph1"><aaif:verb rdf:resource="https://gams.uni-graz.at/o:aaif.fraweb#En3896Ph1Ve1" /><aaif:adverb rdf:resource="https://gams.uni-graz.at/o:aaif.fraweb#En3896Ph1Ad1" /><aaif:text>Efforcez-vous de vivre juste </aaif:text><aaif:annoText>Efforcez-vous de [v|vivre|vivre|is] [a|juste|juste|auvnmnnn] </aaif:annoText></aaif:Phrase><aaif:Verb rdf:about="https://gams.uni-graz.at/o:aaif.fraweb#En3896Ph1Ve1"><aaif:text>vivre</aaif:text><aaif:lemma rdf:resource="https://gams.uni-graz.at/o:aaif.lemma#vivre" /><aaif:position rdf:datatype="http://www.w3.org/2001/XMLSchema#int">1</aaif:position><aaif:coordinated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:coordinated><aaif:partOfText rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</aaif:partOfText><aaif:syntacticConstruction rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Intransitive" /></aaif:Verb><aaif:Adverb rdf:about="https://gams.uni-graz.at/o:aaif.fraweb#En3896Ph1Ad1"><aaif:text>juste</aaif:text><aaif:lemma rdf:resource="https://gams.uni-graz.at/o:aaif.lemma#juste" /><aaif:position rdf:datatype="http://www.w3.org/2001/XMLSchema#int">2</aaif:position><aaif:coordinated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:coordinated><aaif:morphosyntacticStructure rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Adjective" /><aaif:inflection rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Uninflected" /><aaif:attributionTarget rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Verb" /><aaif:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:modified><aaif:semanticClassification rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Manner" /><aaif:reduplicated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:reduplicated><aaif:prepositionalPhrase rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:prepositionalPhrase></aaif:Adverb><aaif:Entry rdf:about="https://gams.uni-graz.at/o:aaif.fraweb#En3897"><aaif:phrase rdf:resource="https://gams.uni-graz.at/o:aaif.fraweb#En3897Ph1" /><aaif:source rdf:resource="https://gams.uni-graz.at/o:aaif.fraweb.bibl#DC3918" /><gams:textualContent>Pour vivre juste  , il faut avoir la conviction profonde que Dieu est en nous.Nous ne marchons plus par la vue mais par la foi.Pas selon nos pensées mais celle du maître.C’est à nous de nous plier à la pensée de Dieu et ne pas tenter d’enfermer Dieu dans nos conceptions.</gams:textualContent><rel:isPartOf rdf:resource="https://gams.uni-graz.at/o:aaif.fraweb" /></aaif:Entry><aaif:Phrase rdf:about="https://gams.uni-graz.at/o:aaif.fraweb#En3897Ph1"><aaif:verb rdf:resource="https://gams.uni-graz.at/o:aaif.fraweb#En3897Ph1Ve1" /><aaif:adverb rdf:resource="https://gams.uni-graz.at/o:aaif.fraweb#En3897Ph1Ad1" /><aaif:text>Pour vivre juste </aaif:text><aaif:annoText>Pour [v|vivre|vivre|is] [a|juste|juste|auvnmnnn] </aaif:annoText></aaif:Phrase><aaif:Verb rdf:about="https://gams.uni-graz.at/o:aaif.fraweb#En3897Ph1Ve1"><aaif:text>vivre</aaif:text><aaif:lemma rdf:resource="https://gams.uni-graz.at/o:aaif.lemma#vivre" /><aaif:position rdf:datatype="http://www.w3.org/2001/XMLSchema#int">1</aaif:position><aaif:coordinated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:coordinated><aaif:partOfText rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</aaif:partOfText><aaif:syntacticConstruction rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Intransitive" /></aaif:Verb><aaif:Adverb rdf:about="https://gams.uni-graz.at/o:aaif.fraweb#En3897Ph1Ad1"><aaif:text>juste</aaif:text><aaif:lemma rdf:resource="https://gams.uni-graz.at/o:aaif.lemma#juste" /><aaif:position rdf:datatype="http://www.w3.org/2001/XMLSchema#int">2</aaif:position><aaif:coordinated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:coordinated><aaif:morphosyntacticStructure rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Adjective" /><aaif:inflection rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Uninflected" /><aaif:attributionTarget rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Verb" /><aaif:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:modified><aaif:semanticClassification rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Manner" /><aaif:reduplicated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:reduplicated><aaif:prepositionalPhrase rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:prepositionalPhrase></aaif:Adverb><aaif:Entry rdf:about="https://gams.uni-graz.at/o:aaif.fraweb#En3898"><aaif:phrase rdf:resource="https://gams.uni-graz.at/o:aaif.fraweb#En3898Ph1" /><aaif:source rdf:resource="https://gams.uni-graz.at/o:aaif.fraweb.bibl#DC3919" /><gams:textualContent> Vivre  léger  , c'est savoir profiter de l'essentiel et ne pas s'encombrer l'esprit ou l'espace de l'inutile, c'est-à-dire de ce qui vous distrait de l'essentiel.Et dans notre société de consommation, ce n'est pas facile.Et vous, de quelle manière le vivez-vous ?</gams:textualContent><rel:isPartOf rdf:resource="https://gams.uni-graz.at/o:aaif.fraweb" /></aaif:Entry><aaif:Phrase rdf:about="https://gams.uni-graz.at/o:aaif.fraweb#En3898Ph1"><aaif:verb rdf:resource="https://gams.uni-graz.at/o:aaif.fraweb#En3898Ph1Ve1" /><aaif:adverb rdf:resource="https://gams.uni-graz.at/o:aaif.fraweb#En3898Ph1Ad1" /><aaif:text> Vivre  léger </aaif:text><aaif:annoText> [v|Vivre|vivre|is]  [a|léger|léger|auvnmnnn] </aaif:annoText></aaif:Phrase><aaif:Verb rdf:about="https://gams.uni-graz.at/o:aaif.fraweb#En3898Ph1Ve1"><aaif:text>Vivre</aaif:text><aaif:lemma rdf:resource="https://gams.uni-graz.at/o:aaif.lemma#vivre" /><aaif:position rdf:datatype="http://www.w3.org/2001/XMLSchema#int">1</aaif:position><aaif:coordinated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:coordinated><aaif:partOfText rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</aaif:partOfText><aaif:syntacticConstruction rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Intransitive" /></aaif:Verb><aaif:Adverb rdf:about="https://gams.uni-graz.at/o:aaif.fraweb#En3898Ph1Ad1"><aaif:text>léger</aaif:text><aaif:lemma rdf:resource="https://gams.uni-graz.at/o:aaif.lemma#léger" /><aaif:position rdf:datatype="http://www.w3.org/2001/XMLSchema#int">2</aaif:position><aaif:coordinated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:coordinated><aaif:morphosyntacticStructure rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Adjective" /><aaif:inflection rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Uninflected" /><aaif:attributionTarget rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Verb" /><aaif:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:modified><aaif:semanticClassification rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Manner" /><aaif:reduplicated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:reduplicated><aaif:prepositionalPhrase rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:prepositionalPhrase></aaif:Adverb><aaif:Entry rdf:about="https://gams.uni-graz.at/o:aaif.fraweb#En3899"><aaif:phrase rdf:resource="https://gams.uni-graz.at/o:aaif.fraweb#En3899Ph1" /><aaif:source rdf:resource="https://gams.uni-graz.at/o:aaif.fraweb.bibl#DC3920" /><gams:textualContent> Vivre  léger  , c'est vivre sans mémoire.Chaque instant n'est plus alors comparé.Il ne se réfère qu'à lui-même.Passé, présent et futur sont contenus à l'instant même, dans cela qui ne peut être saisi.</gams:textualContent><rel:isPartOf rdf:resource="https://gams.uni-graz.at/o:aaif.fraweb" /></aaif:Entry><aaif:Phrase rdf:about="https://gams.uni-graz.at/o:aaif.fraweb#En3899Ph1"><aaif:verb rdf:resource="https://gams.uni-graz.at/o:aaif.fraweb#En3899Ph1Ve1" /><aaif:adverb rdf:resource="https://gams.uni-graz.at/o:aaif.fraweb#En3899Ph1Ad1" /><aaif:text> Vivre  léger </aaif:text><aaif:annoText> [v|Vivre|vivre|is]  [a|léger|léger|auvnmnnn] </aaif:annoText></aaif:Phrase><aaif:Verb rdf:about="https://gams.uni-graz.at/o:aaif.fraweb#En3899Ph1Ve1"><aaif:text>Vivre</aaif:text><aaif:lemma rdf:resource="https://gams.uni-graz.at/o:aaif.lemma#vivre" /><aaif:position rdf:datatype="http://www.w3.org/2001/XMLSchema#int">1</aaif:position><aaif:coordinated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:coordinated><aaif:partOfText rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</aaif:partOfText><aaif:syntacticConstruction rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Intransitive" /></aaif:Verb><aaif:Adverb rdf:about="https://gams.uni-graz.at/o:aaif.fraweb#En3899Ph1Ad1"><aaif:text>léger</aaif:text><aaif:lemma rdf:resource="https://gams.uni-graz.at/o:aaif.lemma#léger" /><aaif:position rdf:datatype="http://www.w3.org/2001/XMLSchema#int">2</aaif:position><aaif:coordinated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:coordinated><aaif:morphosyntacticStructure rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Adjective" /><aaif:inflection rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Uninflected" /><aaif:attributionTarget rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Verb" /><aaif:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:modified><aaif:semanticClassification rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Manner" /><aaif:reduplicated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:reduplicated><aaif:prepositionalPhrase rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:prepositionalPhrase></aaif:Adverb><aaif:Entry rdf:about="https://gams.uni-graz.at/o:aaif.fraweb#En3900"><aaif:phrase rdf:resource="https://gams.uni-graz.at/o:aaif.fraweb#En3900Ph1" /><aaif:source rdf:resource="https://gams.uni-graz.at/o:aaif.fraweb.bibl#DC3921" /><gams:textualContent>Vous pensez que j’imagine, que j’extrapole ?Mais que faisons-nous ?Combien y-a-t-il d’entres vous qui vivent légers comme des plumes, qui se laissent porter par les vents tournants ?</gams:textualContent><rel:isPartOf rdf:resource="https://gams.uni-graz.at/o:aaif.fraweb" /></aaif:Entry><aaif:Phrase rdf:about="https://gams.uni-graz.at/o:aaif.fraweb#En3900Ph1"><aaif:verb rdf:resource="https://gams.uni-graz.at/o:aaif.fraweb#En3900Ph1Ve1" /><aaif:adverb rdf:resource="https://gams.uni-graz.at/o:aaif.fraweb#En3900Ph1Ad1" /><aaif:text>qui vivent légers comme des plumes</aaif:text><aaif:annoText>qui [v|vivent|vivre|is] [a|légers|léger|aivnmnnn] comme des plumes</aaif:annoText></aaif:Phrase><aaif:Verb rdf:about="https://gams.uni-graz.at/o:aaif.fraweb#En3900Ph1Ve1"><aaif:text>vivent</aaif:text><aaif:lemma rdf:resource="https://gams.uni-graz.at/o:aaif.lemma#vivre" /><aaif:position rdf:datatype="http://www.w3.org/2001/XMLSchema#int">1</aaif:position><aaif:coordinated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:coordinated><aaif:partOfText rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</aaif:partOfText><aaif:syntacticConstruction rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Intransitive" /></aaif:Verb><aaif:Adverb rdf:about="https://gams.uni-graz.at/o:aaif.fraweb#En3900Ph1Ad1"><aaif:text>légers</aaif:text><aaif:lemma rdf:resource="https://gams.uni-graz.at/o:aaif.lemma#léger" /><aaif:position rdf:datatype="http://www.w3.org/2001/XMLSchema#int">2</aaif:position><aaif:coordinated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:coordinated><aaif:morphosyntacticStructure rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Adjective" /><aaif:inflection rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#InaudibleInflection" /><aaif:attributionTarget rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Verb" /><aaif:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:modified><aaif:semanticClassification rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Manner" /><aaif:reduplicated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:reduplicated><aaif:prepositionalPhrase rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:prepositionalPhrase></aaif:Adverb><aaif:Entry rdf:about="https://gams.uni-graz.at/o:aaif.fraweb#En3901"><aaif:phrase rdf:resource="https://gams.uni-graz.at/o:aaif.fraweb#En3901Ph1" /><aaif:source rdf:resource="https://gams.uni-graz.at/o:aaif.fraweb.bibl#DC3922" /><gams:textualContent>Les dieux grecs, qui sont partout présents là où quelque chose a lieu, ou est simplement pensé ou voulu, et dont la participation à tout événement apparaît avec une telle grandeur qu’il arrive souvent qu’ils ne soient pas seulement les instigateurs des actions humaines, mais bel et bien ceux qui les exécutent, Homère les appelle « ceux qui vivent légers  », et une de leurs dénominations les plus importantes est : « les bienheureux ».</gams:textualContent><rel:isPartOf rdf:resource="https://gams.uni-graz.at/o:aaif.fraweb" /></aaif:Entry><aaif:Phrase rdf:about="https://gams.uni-graz.at/o:aaif.fraweb#En3901Ph1"><aaif:verb rdf:resource="https://gams.uni-graz.at/o:aaif.fraweb#En3901Ph1Ve1" /><aaif:adverb rdf:resource="https://gams.uni-graz.at/o:aaif.fraweb#En3901Ph1Ad1" /><aaif:text>ceux qui vivent légers </aaif:text><aaif:annoText>ceux qui [v|vivent|vivre|is] [a|légers|léger|aivnmnnn] </aaif:annoText></aaif:Phrase><aaif:Verb rdf:about="https://gams.uni-graz.at/o:aaif.fraweb#En3901Ph1Ve1"><aaif:text>vivent</aaif:text><aaif:lemma rdf:resource="https://gams.uni-graz.at/o:aaif.lemma#vivre" /><aaif:position rdf:datatype="http://www.w3.org/2001/XMLSchema#int">1</aaif:position><aaif:coordinated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:coordinated><aaif:partOfText rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</aaif:partOfText><aaif:syntacticConstruction rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Intransitive" /></aaif:Verb><aaif:Adverb rdf:about="https://gams.uni-graz.at/o:aaif.fraweb#En3901Ph1Ad1"><aaif:text>légers</aaif:text><aaif:lemma rdf:resource="https://gams.uni-graz.at/o:aaif.lemma#léger" /><aaif:position rdf:datatype="http://www.w3.org/2001/XMLSchema#int">2</aaif:position><aaif:coordinated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:coordinated><aaif:morphosyntacticStructure rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Adjective" /><aaif:inflection rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#InaudibleInflection" /><aaif:attributionTarget rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Verb" /><aaif:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:modified><aaif:semanticClassification rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Manner" /><aaif:reduplicated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:reduplicated><aaif:prepositionalPhrase rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:prepositionalPhrase></aaif:Adverb><aaif:Entry rdf:about="https://gams.uni-graz.at/o:aaif.fraweb#En3902"><aaif:phrase rdf:resource="https://gams.uni-graz.at/o:aaif.fraweb#En3902Ph1" /><aaif:source rdf:resource="https://gams.uni-graz.at/o:aaif.fraweb.bibl#DC3923" /><gams:textualContent>Je suis révisée de cette histoire et son frère qui a juste tenter de l'aider oui il doit payer mais au prix de lacharnement débile de gardiens de prison pfffff HONTE À LA SOI DISANT JUSTICE.Occupés vous donc des réels meurtriers qui eux vivent libre  .Cette histoire est un SCANDALE.</gams:textualContent><rel:isPartOf rdf:resource="https://gams.uni-graz.at/o:aaif.fraweb" /></aaif:Entry><aaif:Phrase rdf:about="https://gams.uni-graz.at/o:aaif.fraweb#En3902Ph1"><aaif:verb rdf:resource="https://gams.uni-graz.at/o:aaif.fraweb#En3902Ph1Ve1" /><aaif:adverb rdf:resource="https://gams.uni-graz.at/o:aaif.fraweb#En3902Ph1Ad1" /><aaif:text>des réels meurtriers qui eux vivent libre </aaif:text><aaif:annoText>des réels meurtriers qui eux [v|vivent|vivre|is] [a|libre|libre|ausnmnnn] </aaif:annoText></aaif:Phrase><aaif:Verb rdf:about="https://gams.uni-graz.at/o:aaif.fraweb#En3902Ph1Ve1"><aaif:text>vivent</aaif:text><aaif:lemma rdf:resource="https://gams.uni-graz.at/o:aaif.lemma#vivre" /><aaif:position rdf:datatype="http://www.w3.org/2001/XMLSchema#int">1</aaif:position><aaif:coordinated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:coordinated><aaif:partOfText rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</aaif:partOfText><aaif:syntacticConstruction rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Intransitive" /></aaif:Verb><aaif:Adverb rdf:about="https://gams.uni-graz.at/o:aaif.fraweb#En3902Ph1Ad1"><aaif:text>libre</aaif:text><aaif:lemma rdf:resource="https://gams.uni-graz.at/o:aaif.lemma#libre" /><aaif:position rdf:datatype="http://www.w3.org/2001/XMLSchema#int">2</aaif:position><aaif:coordinated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:coordinated><aaif:morphosyntacticStructure rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Adjective" /><aaif:inflection rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Uninflected" /><aaif:attributionTarget rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Verb" /><aaif:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:modified><aaif:semanticClassification rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Manner" /><aaif:reduplicated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:reduplicated><aaif:prepositionalPhrase rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:prepositionalPhrase></aaif:Adverb><aaif:Entry rdf:about="https://gams.uni-graz.at/o:aaif.fraweb#En3903"><aaif:phrase rdf:resource="https://gams.uni-graz.at/o:aaif.fraweb#En3903Ph1" /><aaif:source rdf:resource="https://gams.uni-graz.at/o:aaif.fraweb.bibl#DC3924" /><gams:textualContent>je voudrais que les palestiniens vivent libres ,sans aucune conditions,ils y ont droit comme n'importe qu'el être humain, droit a la vie droit a la justice.</gams:textualContent><rel:isPartOf rdf:resource="https://gams.uni-graz.at/o:aaif.fraweb" /></aaif:Entry><aaif:Phrase rdf:about="https://gams.uni-graz.at/o:aaif.fraweb#En3903Ph1"><aaif:verb rdf:resource="https://gams.uni-graz.at/o:aaif.fraweb#En3903Ph1Ve1" /><aaif:adverb rdf:resource="https://gams.uni-graz.at/o:aaif.fraweb#En3903Ph1Ad1" /><aaif:text>je voudrais que les palestiniens vivent libres ,sans aucune conditions</aaif:text><aaif:annoText>je voudrais que les palestiniens [v|vivent|vivre|is] [a|libres|libre|aisnmnnn] ,sans aucune conditions</aaif:annoText></aaif:Phrase><aaif:Verb rdf:about="https://gams.uni-graz.at/o:aaif.fraweb#En3903Ph1Ve1"><aaif:text>vivent</aaif:text><aaif:lemma rdf:resource="https://gams.uni-graz.at/o:aaif.lemma#vivre" /><aaif:position rdf:datatype="http://www.w3.org/2001/XMLSchema#int">1</aaif:position><aaif:coordinated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:coordinated><aaif:partOfText rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</aaif:partOfText><aaif:syntacticConstruction rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Intransitive" /></aaif:Verb><aaif:Adverb rdf:about="https://gams.uni-graz.at/o:aaif.fraweb#En3903Ph1Ad1"><aaif:text>libres</aaif:text><aaif:lemma rdf:resource="https://gams.uni-graz.at/o:aaif.lemma#libre" /><aaif:position rdf:datatype="http://www.w3.org/2001/XMLSchema#int">2</aaif:position><aaif:coordinated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:coordinated><aaif:morphosyntacticStructure rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Adjective" /><aaif:inflection rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#InaudibleInflection" /><aaif:attributionTarget rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Verb" /><aaif:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:modified><aaif:semanticClassification rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Manner" /><aaif:reduplicated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:reduplicated><aaif:prepositionalPhrase rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:prepositionalPhrase></aaif:Adverb><aaif:Entry rdf:about="https://gams.uni-graz.at/o:aaif.fraweb#En3904"><aaif:phrase rdf:resource="https://gams.uni-graz.at/o:aaif.fraweb#En3904Ph1" /><aaif:source rdf:resource="https://gams.uni-graz.at/o:aaif.fraweb.bibl#DC3925" /><gams:textualContent>"Vaut-il mieux vivre malheureux ou mourir ?..." </gams:textualContent><rel:isPartOf rdf:resource="https://gams.uni-graz.at/o:aaif.fraweb" /></aaif:Entry><aaif:Phrase rdf:about="https://gams.uni-graz.at/o:aaif.fraweb#En3904Ph1"><aaif:verb rdf:resource="https://gams.uni-graz.at/o:aaif.fraweb#En3904Ph1Ve1" /><aaif:adverb rdf:resource="https://gams.uni-graz.at/o:aaif.fraweb#En3904Ph1Ad1" /><aaif:text>Vaut-il mieux vivre malheureux ou mourir</aaif:text><aaif:annoText>Vaut-il mieux [v|vivre|vivre|is] [a|malheureux|malheureux|ausnmnnn] ou mourir</aaif:annoText></aaif:Phrase><aaif:Verb rdf:about="https://gams.uni-graz.at/o:aaif.fraweb#En3904Ph1Ve1"><aaif:text>vivre</aaif:text><aaif:lemma rdf:resource="https://gams.uni-graz.at/o:aaif.lemma#vivre" /><aaif:position rdf:datatype="http://www.w3.org/2001/XMLSchema#int">1</aaif:position><aaif:coordinated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:coordinated><aaif:partOfText rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</aaif:partOfText><aaif:syntacticConstruction rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Intransitive" /></aaif:Verb><aaif:Adverb rdf:about="https://gams.uni-graz.at/o:aaif.fraweb#En3904Ph1Ad1"><aaif:text>malheureux</aaif:text><aaif:lemma rdf:resource="https://gams.uni-graz.at/o:aaif.lemma#malheureux" /><aaif:position rdf:datatype="http://www.w3.org/2001/XMLSchema#int">2</aaif:position><aaif:coordinated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:coordinated><aaif:morphosyntacticStructure rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Adjective" /><aaif:inflection rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Uninflected" /><aaif:attributionTarget rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Verb" /><aaif:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:modified><aaif:semanticClassification rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Manner" /><aaif:reduplicated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:reduplicated><aaif:prepositionalPhrase rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:prepositionalPhrase></aaif:Adverb><aaif:Entry rdf:about="https://gams.uni-graz.at/o:aaif.fraweb#En3905"><aaif:phrase rdf:resource="https://gams.uni-graz.at/o:aaif.fraweb#En3905Ph1" /><aaif:source rdf:resource="https://gams.uni-graz.at/o:aaif.fraweb.bibl#DC3926" /><gams:textualContent>pourquoi vivre malheureux  et entraîner vos enfants dans ce tourbillon de tristesse, de crise et dispute en tout genre..</gams:textualContent><rel:isPartOf rdf:resource="https://gams.uni-graz.at/o:aaif.fraweb" /></aaif:Entry><aaif:Phrase rdf:about="https://gams.uni-graz.at/o:aaif.fraweb#En3905Ph1"><aaif:verb rdf:resource="https://gams.uni-graz.at/o:aaif.fraweb#En3905Ph1Ve1" /><aaif:adverb rdf:resource="https://gams.uni-graz.at/o:aaif.fraweb#En3905Ph1Ad1" /><aaif:text>pourquoi vivre malheureux </aaif:text><aaif:annoText>pourquoi [v|vivre|vivre|is] [a|malheureux|malheureux|ausnmnnn] </aaif:annoText></aaif:Phrase><aaif:Verb rdf:about="https://gams.uni-graz.at/o:aaif.fraweb#En3905Ph1Ve1"><aaif:text>vivre</aaif:text><aaif:lemma rdf:resource="https://gams.uni-graz.at/o:aaif.lemma#vivre" /><aaif:position rdf:datatype="http://www.w3.org/2001/XMLSchema#int">1</aaif:position><aaif:coordinated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:coordinated><aaif:partOfText rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</aaif:partOfText><aaif:syntacticConstruction rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Intransitive" /></aaif:Verb><aaif:Adverb rdf:about="https://gams.uni-graz.at/o:aaif.fraweb#En3905Ph1Ad1"><aaif:text>malheureux</aaif:text><aaif:lemma rdf:resource="https://gams.uni-graz.at/o:aaif.lemma#malheureux" /><aaif:position rdf:datatype="http://www.w3.org/2001/XMLSchema#int">2</aaif:position><aaif:coordinated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:coordinated><aaif:morphosyntacticStructure rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Adjective" /><aaif:inflection rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Uninflected" /><aaif:attributionTarget rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Verb" /><aaif:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:modified><aaif:semanticClassification rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Manner" /><aaif:reduplicated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:reduplicated><aaif:prepositionalPhrase rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:prepositionalPhrase></aaif:Adverb><aaif:Entry rdf:about="https://gams.uni-graz.at/o:aaif.fraweb#En3906"><aaif:phrase rdf:resource="https://gams.uni-graz.at/o:aaif.fraweb#En3906Ph1" /><aaif:source rdf:resource="https://gams.uni-graz.at/o:aaif.fraweb.bibl#DC3927" /><gams:textualContent>Tu as raison quand tu dis qu'il faut être pragmatique et reconnaître que certaines personnes vivent malheureuses  toutes leur vie </gams:textualContent><rel:isPartOf rdf:resource="https://gams.uni-graz.at/o:aaif.fraweb" /></aaif:Entry><aaif:Phrase rdf:about="https://gams.uni-graz.at/o:aaif.fraweb#En3906Ph1"><aaif:verb rdf:resource="https://gams.uni-graz.at/o:aaif.fraweb#En3906Ph1Ve1" /><aaif:adverb rdf:resource="https://gams.uni-graz.at/o:aaif.fraweb#En3906Ph1Ad1" /><aaif:text>certaines personnes vivent malheureuses </aaif:text><aaif:annoText>certaines personnes [v|vivent|vivre|is] [a|malheureuses|malheureux|aasnmnnn] </aaif:annoText></aaif:Phrase><aaif:Verb rdf:about="https://gams.uni-graz.at/o:aaif.fraweb#En3906Ph1Ve1"><aaif:text>vivent</aaif:text><aaif:lemma rdf:resource="https://gams.uni-graz.at/o:aaif.lemma#vivre" /><aaif:position rdf:datatype="http://www.w3.org/2001/XMLSchema#int">1</aaif:position><aaif:coordinated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:coordinated><aaif:partOfText rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</aaif:partOfText><aaif:syntacticConstruction rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Intransitive" /></aaif:Verb><aaif:Adverb rdf:about="https://gams.uni-graz.at/o:aaif.fraweb#En3906Ph1Ad1"><aaif:text>malheureuses</aaif:text><aaif:lemma rdf:resource="https://gams.uni-graz.at/o:aaif.lemma#malheureux" /><aaif:position rdf:datatype="http://www.w3.org/2001/XMLSchema#int">2</aaif:position><aaif:coordinated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:coordinated><aaif:morphosyntacticStructure rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Adjective" /><aaif:inflection rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#AudibleInflection" /><aaif:attributionTarget rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Verb" /><aaif:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:modified><aaif:semanticClassification rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Manner" /><aaif:reduplicated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:reduplicated><aaif:prepositionalPhrase rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:prepositionalPhrase></aaif:Adverb><aaif:Entry rdf:about="https://gams.uni-graz.at/o:aaif.fraweb#En3907"><aaif:phrase rdf:resource="https://gams.uni-graz.at/o:aaif.fraweb#En3907Ph1" /><aaif:source rdf:resource="https://gams.uni-graz.at/o:aaif.fraweb.bibl#DC3928" /><gams:textualContent>La maison de repos a été choisi pour mener des recherches, car avant ils ont entendu l'hôpital 18 personnes âgées vivant dans la pauvreté, vivent misérable  .</gams:textualContent><rel:isPartOf rdf:resource="https://gams.uni-graz.at/o:aaif.fraweb" /></aaif:Entry><aaif:Phrase rdf:about="https://gams.uni-graz.at/o:aaif.fraweb#En3907Ph1"><aaif:verb rdf:resource="https://gams.uni-graz.at/o:aaif.fraweb#En3907Ph1Ve1" /><aaif:adverb rdf:resource="https://gams.uni-graz.at/o:aaif.fraweb#En3907Ph1Ad1" /><aaif:text>personnes âgées vivant dans la pauvreté, vivent misérable </aaif:text><aaif:annoText>personnes âgées vivant dans la pauvreté, [v|vivent|vivre|is] [a|misérable|misérable|ausnmnnn] </aaif:annoText></aaif:Phrase><aaif:Verb rdf:about="https://gams.uni-graz.at/o:aaif.fraweb#En3907Ph1Ve1"><aaif:text>vivent</aaif:text><aaif:lemma rdf:resource="https://gams.uni-graz.at/o:aaif.lemma#vivre" /><aaif:position rdf:datatype="http://www.w3.org/2001/XMLSchema#int">1</aaif:position><aaif:coordinated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:coordinated><aaif:partOfText rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</aaif:partOfText><aaif:syntacticConstruction rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Intransitive" /></aaif:Verb><aaif:Adverb rdf:about="https://gams.uni-graz.at/o:aaif.fraweb#En3907Ph1Ad1"><aaif:text>misérable</aaif:text><aaif:lemma rdf:resource="https://gams.uni-graz.at/o:aaif.lemma#misérable" /><aaif:position rdf:datatype="http://www.w3.org/2001/XMLSchema#int">2</aaif:position><aaif:coordinated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:coordinated><aaif:morphosyntacticStructure rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Adjective" /><aaif:inflection rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Uninflected" /><aaif:attributionTarget rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Verb" /><aaif:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:modified><aaif:semanticClassification rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Manner" /><aaif:reduplicated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:reduplicated><aaif:prepositionalPhrase rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:prepositionalPhrase></aaif:Adverb><aaif:Entry rdf:about="https://gams.uni-graz.at/o:aaif.fraweb#En3908"><aaif:phrase rdf:resource="https://gams.uni-graz.at/o:aaif.fraweb#En3908Ph1" /><aaif:source rdf:resource="https://gams.uni-graz.at/o:aaif.fraweb.bibl#DC3929" /><gams:textualContent>Ils vivent miserable  sur cette terre alegerienne aussi chaude..aussi haute...L'algerie fait du polisario un outil productif...pour raccolter l'aide humanitaire, qu'ils vendent dans la ville de Tindouf...et pour autant affaiblir ses voisins...</gams:textualContent><rel:isPartOf rdf:resource="https://gams.uni-graz.at/o:aaif.fraweb" /></aaif:Entry><aaif:Phrase rdf:about="https://gams.uni-graz.at/o:aaif.fraweb#En3908Ph1"><aaif:verb rdf:resource="https://gams.uni-graz.at/o:aaif.fraweb#En3908Ph1Ve1" /><aaif:adverb rdf:resource="https://gams.uni-graz.at/o:aaif.fraweb#En3908Ph1Ad1" /><aaif:text>Ils vivent miserable </aaif:text><aaif:annoText>Ils [v|vivent|vivre|is] [a|miserable|misérable|ausnmnnn] </aaif:annoText></aaif:Phrase><aaif:Verb rdf:about="https://gams.uni-graz.at/o:aaif.fraweb#En3908Ph1Ve1"><aaif:text>vivent</aaif:text><aaif:lemma rdf:resource="https://gams.uni-graz.at/o:aaif.lemma#vivre" /><aaif:position rdf:datatype="http://www.w3.org/2001/XMLSchema#int">1</aaif:position><aaif:coordinated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:coordinated><aaif:partOfText rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</aaif:partOfText><aaif:syntacticConstruction rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Intransitive" /></aaif:Verb><aaif:Adverb rdf:about="https://gams.uni-graz.at/o:aaif.fraweb#En3908Ph1Ad1"><aaif:text>miserable</aaif:text><aaif:lemma rdf:resource="https://gams.uni-graz.at/o:aaif.lemma#misérable" /><aaif:position rdf:datatype="http://www.w3.org/2001/XMLSchema#int">2</aaif:position><aaif:coordinated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:coordinated><aaif:morphosyntacticStructure rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Adjective" /><aaif:inflection rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Uninflected" /><aaif:attributionTarget rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Verb" /><aaif:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:modified><aaif:semanticClassification rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Manner" /><aaif:reduplicated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:reduplicated><aaif:prepositionalPhrase rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:prepositionalPhrase></aaif:Adverb><aaif:Entry rdf:about="https://gams.uni-graz.at/o:aaif.fraweb#En3909"><aaif:phrase rdf:resource="https://gams.uni-graz.at/o:aaif.fraweb#En3909Ph1" /><aaif:source rdf:resource="https://gams.uni-graz.at/o:aaif.fraweb.bibl#DC3930" /><gams:textualContent>pour ca j'espere vraiment que les gens comme toi vivent misérables  pendant leur vie pour ressentir ce qu'ils aiment pour les autres </gams:textualContent><rel:isPartOf rdf:resource="https://gams.uni-graz.at/o:aaif.fraweb" /></aaif:Entry><aaif:Phrase rdf:about="https://gams.uni-graz.at/o:aaif.fraweb#En3909Ph1"><aaif:verb rdf:resource="https://gams.uni-graz.at/o:aaif.fraweb#En3909Ph1Ve1" /><aaif:adverb rdf:resource="https://gams.uni-graz.at/o:aaif.fraweb#En3909Ph1Ad1" /><aaif:text>les gens comme toi vivent misérables </aaif:text><aaif:annoText>les gens comme toi [v|vivent|vivre|is] [a|misérables|misérable|aisnmnnn] </aaif:annoText></aaif:Phrase><aaif:Verb rdf:about="https://gams.uni-graz.at/o:aaif.fraweb#En3909Ph1Ve1"><aaif:text>vivent</aaif:text><aaif:lemma rdf:resource="https://gams.uni-graz.at/o:aaif.lemma#vivre" /><aaif:position rdf:datatype="http://www.w3.org/2001/XMLSchema#int">1</aaif:position><aaif:coordinated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:coordinated><aaif:partOfText rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</aaif:partOfText><aaif:syntacticConstruction rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Intransitive" /></aaif:Verb><aaif:Adverb rdf:about="https://gams.uni-graz.at/o:aaif.fraweb#En3909Ph1Ad1"><aaif:text>misérables</aaif:text><aaif:lemma rdf:resource="https://gams.uni-graz.at/o:aaif.lemma#misérable" /><aaif:position rdf:datatype="http://www.w3.org/2001/XMLSchema#int">2</aaif:position><aaif:coordinated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:coordinated><aaif:morphosyntacticStructure rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Adjective" /><aaif:inflection rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#InaudibleInflection" /><aaif:attributionTarget rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Verb" /><aaif:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:modified><aaif:semanticClassification rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Manner" /><aaif:reduplicated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:reduplicated><aaif:prepositionalPhrase rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:prepositionalPhrase></aaif:Adverb><aaif:Entry rdf:about="https://gams.uni-graz.at/o:aaif.fraweb#En3910"><aaif:phrase rdf:resource="https://gams.uni-graz.at/o:aaif.fraweb#En3910Ph1" /><aaif:source rdf:resource="https://gams.uni-graz.at/o:aaif.fraweb.bibl#DC3931" /><gams:textualContent>Tout au long de l'enquête, à la fin est une démangeaison de quatre ans ou quatorze ans de réflexion de sept ans démangent n'ya pas de consensus, mais la plupart des données de recherche plus agréable que, avec la poursuite de la vie conjugale, en particulier pour ceux qui vivent monotone  , ennuyeux vie conjugale des personnes, en particulier la vie sexuelle du mariage existant ainsi que la perte d'intérêt et de passion fatigué de la situation semble venir tôt ou tard.</gams:textualContent><rel:isPartOf rdf:resource="https://gams.uni-graz.at/o:aaif.fraweb" /></aaif:Entry><aaif:Phrase rdf:about="https://gams.uni-graz.at/o:aaif.fraweb#En3910Ph1"><aaif:verb rdf:resource="https://gams.uni-graz.at/o:aaif.fraweb#En3910Ph1Ve1" /><aaif:adverb rdf:resource="https://gams.uni-graz.at/o:aaif.fraweb#En3910Ph1Ad1" /><aaif:text>ceux qui vivent monotone </aaif:text><aaif:annoText>ceux qui [v|vivent|vivre|is] [a|monotone|monotone|auvnmnnn] </aaif:annoText></aaif:Phrase><aaif:Verb rdf:about="https://gams.uni-graz.at/o:aaif.fraweb#En3910Ph1Ve1"><aaif:text>vivent</aaif:text><aaif:lemma rdf:resource="https://gams.uni-graz.at/o:aaif.lemma#vivre" /><aaif:position rdf:datatype="http://www.w3.org/2001/XMLSchema#int">1</aaif:position><aaif:coordinated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:coordinated><aaif:partOfText rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</aaif:partOfText><aaif:syntacticConstruction rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Intransitive" /></aaif:Verb><aaif:Adverb rdf:about="https://gams.uni-graz.at/o:aaif.fraweb#En3910Ph1Ad1"><aaif:text>monotone</aaif:text><aaif:lemma rdf:resource="https://gams.uni-graz.at/o:aaif.lemma#monotone" /><aaif:position rdf:datatype="http://www.w3.org/2001/XMLSchema#int">2</aaif:position><aaif:coordinated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:coordinated><aaif:morphosyntacticStructure rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Adjective" /><aaif:inflection rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Uninflected" /><aaif:attributionTarget rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Verb" /><aaif:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:modified><aaif:semanticClassification rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Manner" /><aaif:reduplicated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:reduplicated><aaif:prepositionalPhrase rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:prepositionalPhrase></aaif:Adverb><aaif:Entry rdf:about="https://gams.uni-graz.at/o:aaif.fraweb#En3911"><aaif:phrase rdf:resource="https://gams.uni-graz.at/o:aaif.fraweb#En3911Ph1" /><aaif:source rdf:resource="https://gams.uni-graz.at/o:aaif.fraweb.bibl#DC3932" /><gams:textualContent>Pendant son séjour en Corse, de Villiers a une sorte de pressentiment de l'élévation prochaine de la famille de Bonaparte.Il lui fait de fréquentes visites.Il évite les parvenus.Il désire vivre obscur  .</gams:textualContent><rel:isPartOf rdf:resource="https://gams.uni-graz.at/o:aaif.fraweb" /></aaif:Entry><aaif:Phrase rdf:about="https://gams.uni-graz.at/o:aaif.fraweb#En3911Ph1"><aaif:verb rdf:resource="https://gams.uni-graz.at/o:aaif.fraweb#En3911Ph1Ve1" /><aaif:adverb rdf:resource="https://gams.uni-graz.at/o:aaif.fraweb#En3911Ph1Ad1" /><aaif:text>Il désire vivre obscur </aaif:text><aaif:annoText>Il désire [v|vivre|vivre|is] [a|obscur|obscur|auvnmnnn] </aaif:annoText></aaif:Phrase><aaif:Verb rdf:about="https://gams.uni-graz.at/o:aaif.fraweb#En3911Ph1Ve1"><aaif:text>vivre</aaif:text><aaif:lemma rdf:resource="https://gams.uni-graz.at/o:aaif.lemma#vivre" /><aaif:position rdf:datatype="http://www.w3.org/2001/XMLSchema#int">1</aaif:position><aaif:coordinated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:coordinated><aaif:partOfText rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</aaif:partOfText><aaif:syntacticConstruction rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Intransitive" /></aaif:Verb><aaif:Adverb rdf:about="https://gams.uni-graz.at/o:aaif.fraweb#En3911Ph1Ad1"><aaif:text>obscur</aaif:text><aaif:lemma rdf:resource="https://gams.uni-graz.at/o:aaif.lemma#obscur" /><aaif:position rdf:datatype="http://www.w3.org/2001/XMLSchema#int">2</aaif:position><aaif:coordinated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:coordinated><aaif:morphosyntacticStructure rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Adjective" /><aaif:inflection rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Uninflected" /><aaif:attributionTarget rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Verb" /><aaif:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:modified><aaif:semanticClassification rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Manner" /><aaif:reduplicated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:reduplicated><aaif:prepositionalPhrase rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:prepositionalPhrase></aaif:Adverb><aaif:Entry rdf:about="https://gams.uni-graz.at/o:aaif.fraweb#En3912"><aaif:phrase rdf:resource="https://gams.uni-graz.at/o:aaif.fraweb#En3912Ph1" /><aaif:source rdf:resource="https://gams.uni-graz.at/o:aaif.fraweb.bibl#DC3933" /><gams:textualContent>Alors, dit Tchoang-tzeu, retournez d’où vous êtes venus ; moi aussi je préfère traîner ma queue dans la boue des marais.Je continuerai à vivre obscur mais libre  ; je ne veux pas d’une charge, qui coûte souvent la vie à celui qui la porte, et qui lui coûte la paix toujours.</gams:textualContent><rel:isPartOf rdf:resource="https://gams.uni-graz.at/o:aaif.fraweb" /></aaif:Entry><aaif:Phrase rdf:about="https://gams.uni-graz.at/o:aaif.fraweb#En3912Ph1"><aaif:verb rdf:resource="https://gams.uni-graz.at/o:aaif.fraweb#En3912Ph1Ve1" /><aaif:adverb rdf:resource="https://gams.uni-graz.at/o:aaif.fraweb#En3912Ph1Ad1" /><aaif:adverb rdf:resource="https://gams.uni-graz.at/o:aaif.fraweb#En3912Ph1Ad2" /><aaif:text>Je continuerai à vivre obscur mais libre </aaif:text><aaif:annoText>Je continuerai à [v|vivre|vivre|is] [a|obscur|obscur|auvnmnnC] mais [a|libre|libre|ausnmnnC] </aaif:annoText></aaif:Phrase><aaif:Verb rdf:about="https://gams.uni-graz.at/o:aaif.fraweb#En3912Ph1Ve1"><aaif:text>vivre</aaif:text><aaif:lemma rdf:resource="https://gams.uni-graz.at/o:aaif.lemma#vivre" /><aaif:position rdf:datatype="http://www.w3.org/2001/XMLSchema#int">1</aaif:position><aaif:coordinated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:coordinated><aaif:partOfText rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</aaif:partOfText><aaif:syntacticConstruction rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Intransitive" /></aaif:Verb><aaif:Adverb rdf:about="https://gams.uni-graz.at/o:aaif.fraweb#En3912Ph1Ad1"><aaif:text>obscur</aaif:text><aaif:lemma rdf:resource="https://gams.uni-graz.at/o:aaif.lemma#obscur" /><aaif:position rdf:datatype="http://www.w3.org/2001/XMLSchema#int">2</aaif:position><aaif:coordinated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</aaif:coordinated><aaif:morphosyntacticStructure rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Adjective" /><aaif:inflection rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Uninflected" /><aaif:attributionTarget rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Verb" /><aaif:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:modified><aaif:semanticClassification rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Manner" /><aaif:reduplicated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:reduplicated><aaif:prepositionalPhrase rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:prepositionalPhrase></aaif:Adverb><aaif:Adverb rdf:about="https://gams.uni-graz.at/o:aaif.fraweb#En3912Ph1Ad2"><aaif:text>libre</aaif:text><aaif:lemma rdf:resource="https://gams.uni-graz.at/o:aaif.lemma#libre" /><aaif:position rdf:datatype="http://www.w3.org/2001/XMLSchema#int">3</aaif:position><aaif:coordinated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</aaif:coordinated><aaif:morphosyntacticStructure rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Adjective" /><aaif:inflection rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Uninflected" /><aaif:attributionTarget rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Verb" /><aaif:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:modified><aaif:semanticClassification rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Manner" /><aaif:reduplicated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:reduplicated><aaif:prepositionalPhrase rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:prepositionalPhrase></aaif:Adverb><aaif:Entry rdf:about="https://gams.uni-graz.at/o:aaif.fraweb#En3913"><aaif:phrase rdf:resource="https://gams.uni-graz.at/o:aaif.fraweb#En3913Ph1" /><aaif:source rdf:resource="https://gams.uni-graz.at/o:aaif.fraweb.bibl#DC3934" /><gams:textualContent>Ce système établi et indétrônable a besoin pour se maintenir, de cette nuée d’esclaves et de guerriers, qui loin de ce marché et dans l’ignorance la plus absolue des droits de l’homme ou d’une quelconque paix, s’activent dans ces tourments pour que vivent paisible , les consommateurs que nous sommes.</gams:textualContent><rel:isPartOf rdf:resource="https://gams.uni-graz.at/o:aaif.fraweb" /></aaif:Entry><aaif:Phrase rdf:about="https://gams.uni-graz.at/o:aaif.fraweb#En3913Ph1"><aaif:verb rdf:resource="https://gams.uni-graz.at/o:aaif.fraweb#En3913Ph1Ve1" /><aaif:adverb rdf:resource="https://gams.uni-graz.at/o:aaif.fraweb#En3913Ph1Ad1" /><aaif:text>pour que vivent paisible , les consommateurs</aaif:text><aaif:annoText>pour que [v|vivent|vivre|is] [a|paisible|paisible|ausnmnnn] , les consommateurs</aaif:annoText></aaif:Phrase><aaif:Verb rdf:about="https://gams.uni-graz.at/o:aaif.fraweb#En3913Ph1Ve1"><aaif:text>vivent</aaif:text><aaif:lemma rdf:resource="https://gams.uni-graz.at/o:aaif.lemma#vivre" /><aaif:position rdf:datatype="http://www.w3.org/2001/XMLSchema#int">1</aaif:position><aaif:coordinated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:coordinated><aaif:partOfText rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</aaif:partOfText><aaif:syntacticConstruction rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Intransitive" /></aaif:Verb><aaif:Adverb rdf:about="https://gams.uni-graz.at/o:aaif.fraweb#En3913Ph1Ad1"><aaif:text>paisible</aaif:text><aaif:lemma rdf:resource="https://gams.uni-graz.at/o:aaif.lemma#paisible" /><aaif:position rdf:datatype="http://www.w3.org/2001/XMLSchema#int">2</aaif:position><aaif:coordinated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:coordinated><aaif:morphosyntacticStructure rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Adjective" /><aaif:inflection rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Uninflected" /><aaif:attributionTarget rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Verb" /><aaif:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:modified><aaif:semanticClassification rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Manner" /><aaif:reduplicated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:reduplicated><aaif:prepositionalPhrase rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:prepositionalPhrase></aaif:Adverb><aaif:Entry rdf:about="https://gams.uni-graz.at/o:aaif.fraweb#En3914"><aaif:phrase rdf:resource="https://gams.uni-graz.at/o:aaif.fraweb#En3914Ph1" /><aaif:source rdf:resource="https://gams.uni-graz.at/o:aaif.fraweb.bibl#DC3935" /><gams:textualContent>Les Zarbi étaient très timides et n'allaient pas à l'extérieur des ruines.En effet, l'environnement des ruines est peuplé par de plus en plus de monde.Il est dit que cette tribu, celle qui a souhaité que les Zarbi vivent paisible et heureux , a décidé de partir laissant ainsi les Zarbi seuls.</gams:textualContent><rel:isPartOf rdf:resource="https://gams.uni-graz.at/o:aaif.fraweb" /></aaif:Entry><aaif:Phrase rdf:about="https://gams.uni-graz.at/o:aaif.fraweb#En3914Ph1"><aaif:verb rdf:resource="https://gams.uni-graz.at/o:aaif.fraweb#En3914Ph1Ve1" /><aaif:adverb rdf:resource="https://gams.uni-graz.at/o:aaif.fraweb#En3914Ph1Ad1" /><aaif:adverb rdf:resource="https://gams.uni-graz.at/o:aaif.fraweb#En3914Ph1Ad2" /><aaif:text>les Zarbi vivent paisible et heureux </aaif:text><aaif:annoText>les Zarbi [v|vivent|vivre|is] [a|paisible|paisible|ausnmnnC] et [a|heureux|heureux|ausnmnnC] </aaif:annoText></aaif:Phrase><aaif:Verb rdf:about="https://gams.uni-graz.at/o:aaif.fraweb#En3914Ph1Ve1"><aaif:text>vivent</aaif:text><aaif:lemma rdf:resource="https://gams.uni-graz.at/o:aaif.lemma#vivre" /><aaif:position rdf:datatype="http://www.w3.org/2001/XMLSchema#int">1</aaif:position><aaif:coordinated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:coordinated><aaif:partOfText rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</aaif:partOfText><aaif:syntacticConstruction rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Intransitive" /></aaif:Verb><aaif:Adverb rdf:about="https://gams.uni-graz.at/o:aaif.fraweb#En3914Ph1Ad1"><aaif:text>paisible</aaif:text><aaif:lemma rdf:resource="https://gams.uni-graz.at/o:aaif.lemma#paisible" /><aaif:position rdf:datatype="http://www.w3.org/2001/XMLSchema#int">2</aaif:position><aaif:coordinated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</aaif:coordinated><aaif:morphosyntacticStructure rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Adjective" /><aaif:inflection rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Uninflected" /><aaif:attributionTarget rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Verb" /><aaif:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:modified><aaif:semanticClassification rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Manner" /><aaif:reduplicated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:reduplicated><aaif:prepositionalPhrase rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:prepositionalPhrase></aaif:Adverb><aaif:Adverb rdf:about="https://gams.uni-graz.at/o:aaif.fraweb#En3914Ph1Ad2"><aaif:text>heureux</aaif:text><aaif:lemma rdf:resource="https://gams.uni-graz.at/o:aaif.lemma#heureux" /><aaif:position rdf:datatype="http://www.w3.org/2001/XMLSchema#int">3</aaif:position><aaif:coordinated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</aaif:coordinated><aaif:morphosyntacticStructure rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Adjective" /><aaif:inflection rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Uninflected" /><aaif:attributionTarget rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Verb" /><aaif:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:modified><aaif:semanticClassification rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Manner" /><aaif:reduplicated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:reduplicated><aaif:prepositionalPhrase rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:prepositionalPhrase></aaif:Adverb><aaif:Entry rdf:about="https://gams.uni-graz.at/o:aaif.fraweb#En3915"><aaif:phrase rdf:resource="https://gams.uni-graz.at/o:aaif.fraweb#En3915Ph1" /><aaif:source rdf:resource="https://gams.uni-graz.at/o:aaif.fraweb.bibl#DC3936" /><gams:textualContent>Les juments mettent bas aux herbes (d'avril à juin).Les poulains restent auprès d'elles durant les 6 premiers mois de leur vie...Ils vivent paisibles … en troupeau...à l'état quasi sauvage dans les grands espaces de liberté de la petite Camargue.</gams:textualContent><rel:isPartOf rdf:resource="https://gams.uni-graz.at/o:aaif.fraweb" /></aaif:Entry><aaif:Phrase rdf:about="https://gams.uni-graz.at/o:aaif.fraweb#En3915Ph1"><aaif:verb rdf:resource="https://gams.uni-graz.at/o:aaif.fraweb#En3915Ph1Ve1" /><aaif:adverb rdf:resource="https://gams.uni-graz.at/o:aaif.fraweb#En3915Ph1Ad1" /><aaif:text>Ils vivent paisibles … en troupeau</aaif:text><aaif:annoText>Ils [v|vivent|vivre|is] [a|paisibles|paisible|aisnmnnn] … en troupeau</aaif:annoText></aaif:Phrase><aaif:Verb rdf:about="https://gams.uni-graz.at/o:aaif.fraweb#En3915Ph1Ve1"><aaif:text>vivent</aaif:text><aaif:lemma rdf:resource="https://gams.uni-graz.at/o:aaif.lemma#vivre" /><aaif:position rdf:datatype="http://www.w3.org/2001/XMLSchema#int">1</aaif:position><aaif:coordinated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:coordinated><aaif:partOfText rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</aaif:partOfText><aaif:syntacticConstruction rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Intransitive" /></aaif:Verb><aaif:Adverb rdf:about="https://gams.uni-graz.at/o:aaif.fraweb#En3915Ph1Ad1"><aaif:text>paisibles</aaif:text><aaif:lemma rdf:resource="https://gams.uni-graz.at/o:aaif.lemma#paisible" /><aaif:position rdf:datatype="http://www.w3.org/2001/XMLSchema#int">2</aaif:position><aaif:coordinated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:coordinated><aaif:morphosyntacticStructure rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Adjective" /><aaif:inflection rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#InaudibleInflection" /><aaif:attributionTarget rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Verb" /><aaif:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:modified><aaif:semanticClassification rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Manner" /><aaif:reduplicated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:reduplicated><aaif:prepositionalPhrase rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:prepositionalPhrase></aaif:Adverb><aaif:Entry rdf:about="https://gams.uni-graz.at/o:aaif.fraweb#En3916"><aaif:phrase rdf:resource="https://gams.uni-graz.at/o:aaif.fraweb#En3916Ph1" /><aaif:source rdf:resource="https://gams.uni-graz.at/o:aaif.fraweb.bibl#DC3937" /><gams:textualContent>« On dit que l’agriculteur vit pauvre et meurt riche  .» plaisante Max Bersinger.</gams:textualContent><rel:isPartOf rdf:resource="https://gams.uni-graz.at/o:aaif.fraweb" /></aaif:Entry><aaif:Phrase rdf:about="https://gams.uni-graz.at/o:aaif.fraweb#En3916Ph1"><aaif:verb rdf:resource="https://gams.uni-graz.at/o:aaif.fraweb#En3916Ph1Ve1" /><aaif:verb rdf:resource="https://gams.uni-graz.at/o:aaif.fraweb#En3916Ph1Ve2" /><aaif:adverb rdf:resource="https://gams.uni-graz.at/o:aaif.fraweb#En3916Ph1Ad1" /><aaif:adverb rdf:resource="https://gams.uni-graz.at/o:aaif.fraweb#En3916Ph1Ad2" /><aaif:text>l’agriculteur vit pauvre et meurt riche </aaif:text><aaif:annoText>l’agriculteur [v|vit|vivre|is] [a|pauvre|pauvre|ausnmnnn] et [v|meurt|mourir|is] [a|riche|riche|ausnmnnn] </aaif:annoText></aaif:Phrase><aaif:Verb rdf:about="https://gams.uni-graz.at/o:aaif.fraweb#En3916Ph1Ve1"><aaif:text>vit</aaif:text><aaif:lemma rdf:resource="https://gams.uni-graz.at/o:aaif.lemma#vivre" /><aaif:position rdf:datatype="http://www.w3.org/2001/XMLSchema#int">1</aaif:position><aaif:coordinated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:coordinated><aaif:partOfText rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</aaif:partOfText><aaif:syntacticConstruction rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Intransitive" /></aaif:Verb><aaif:Verb rdf:about="https://gams.uni-graz.at/o:aaif.fraweb#En3916Ph1Ve2"><aaif:text>meurt</aaif:text><aaif:lemma rdf:resource="https://gams.uni-graz.at/o:aaif.lemma#mourir" /><aaif:position rdf:datatype="http://www.w3.org/2001/XMLSchema#int">3</aaif:position><aaif:coordinated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:coordinated><aaif:partOfText rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</aaif:partOfText><aaif:syntacticConstruction rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Intransitive" /></aaif:Verb><aaif:Adverb rdf:about="https://gams.uni-graz.at/o:aaif.fraweb#En3916Ph1Ad1"><aaif:text>pauvre</aaif:text><aaif:lemma rdf:resource="https://gams.uni-graz.at/o:aaif.lemma#pauvre" /><aaif:position rdf:datatype="http://www.w3.org/2001/XMLSchema#int">2</aaif:position><aaif:coordinated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:coordinated><aaif:morphosyntacticStructure rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Adjective" /><aaif:inflection rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Uninflected" /><aaif:attributionTarget rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Verb" /><aaif:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:modified><aaif:semanticClassification rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Manner" /><aaif:reduplicated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:reduplicated><aaif:prepositionalPhrase rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:prepositionalPhrase></aaif:Adverb><aaif:Adverb rdf:about="https://gams.uni-graz.at/o:aaif.fraweb#En3916Ph1Ad2"><aaif:text>riche</aaif:text><aaif:lemma rdf:resource="https://gams.uni-graz.at/o:aaif.lemma#riche" /><aaif:position rdf:datatype="http://www.w3.org/2001/XMLSchema#int">4</aaif:position><aaif:coordinated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:coordinated><aaif:morphosyntacticStructure rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Adjective" /><aaif:inflection rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Uninflected" /><aaif:attributionTarget rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Verb" /><aaif:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:modified><aaif:semanticClassification rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Manner" /><aaif:reduplicated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:reduplicated><aaif:prepositionalPhrase rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:prepositionalPhrase></aaif:Adverb><aaif:Entry rdf:about="https://gams.uni-graz.at/o:aaif.fraweb#En3917"><aaif:phrase rdf:resource="https://gams.uni-graz.at/o:aaif.fraweb#En3917Ph1" /><aaif:source rdf:resource="https://gams.uni-graz.at/o:aaif.fraweb.bibl#DC3938" /><gams:textualContent>Aujourd'hui, il vit pauvre et seul  .Pour Naphiri, l'histoire se termine bien.</gams:textualContent><rel:isPartOf rdf:resource="https://gams.uni-graz.at/o:aaif.fraweb" /></aaif:Entry><aaif:Phrase rdf:about="https://gams.uni-graz.at/o:aaif.fraweb#En3917Ph1"><aaif:verb rdf:resource="https://gams.uni-graz.at/o:aaif.fraweb#En3917Ph1Ve1" /><aaif:adverb rdf:resource="https://gams.uni-graz.at/o:aaif.fraweb#En3917Ph1Ad1" /><aaif:adverb rdf:resource="https://gams.uni-graz.at/o:aaif.fraweb#En3917Ph1Ad2" /><aaif:text>il vit pauvre et seul </aaif:text><aaif:annoText>il [v|vit|vivre|is] [a|pauvre|pauvre|ausnmnnC] et [a|seul|seul|ausnmnnC] </aaif:annoText></aaif:Phrase><aaif:Verb rdf:about="https://gams.uni-graz.at/o:aaif.fraweb#En3917Ph1Ve1"><aaif:text>vit</aaif:text><aaif:lemma rdf:resource="https://gams.uni-graz.at/o:aaif.lemma#vivre" /><aaif:position rdf:datatype="http://www.w3.org/2001/XMLSchema#int">1</aaif:position><aaif:coordinated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:coordinated><aaif:partOfText rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</aaif:partOfText><aaif:syntacticConstruction rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Intransitive" /></aaif:Verb><aaif:Adverb rdf:about="https://gams.uni-graz.at/o:aaif.fraweb#En3917Ph1Ad1"><aaif:text>pauvre</aaif:text><aaif:lemma rdf:resource="https://gams.uni-graz.at/o:aaif.lemma#pauvre" /><aaif:position rdf:datatype="http://www.w3.org/2001/XMLSchema#int">2</aaif:position><aaif:coordinated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</aaif:coordinated><aaif:morphosyntacticStructure rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Adjective" /><aaif:inflection rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Uninflected" /><aaif:attributionTarget rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Verb" /><aaif:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:modified><aaif:semanticClassification rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Manner" /><aaif:reduplicated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:reduplicated><aaif:prepositionalPhrase rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:prepositionalPhrase></aaif:Adverb><aaif:Adverb rdf:about="https://gams.uni-graz.at/o:aaif.fraweb#En3917Ph1Ad2"><aaif:text>seul</aaif:text><aaif:lemma rdf:resource="https://gams.uni-graz.at/o:aaif.lemma#seul" /><aaif:position rdf:datatype="http://www.w3.org/2001/XMLSchema#int">3</aaif:position><aaif:coordinated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</aaif:coordinated><aaif:morphosyntacticStructure rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Adjective" /><aaif:inflection rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Uninflected" /><aaif:attributionTarget rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Verb" /><aaif:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:modified><aaif:semanticClassification rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Manner" /><aaif:reduplicated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:reduplicated><aaif:prepositionalPhrase rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:prepositionalPhrase></aaif:Adverb><aaif:Entry rdf:about="https://gams.uni-graz.at/o:aaif.fraweb#En3918"><aaif:phrase rdf:resource="https://gams.uni-graz.at/o:aaif.fraweb#En3918Ph1" /><aaif:source rdf:resource="https://gams.uni-graz.at/o:aaif.fraweb.bibl#DC3939" /><gams:textualContent>…je suis content qu’un juge d’instruction […] enquête sur les biens du président Obiang et de sa famille, biens acquis avec l’argent des citoyens qui vivent pauvres  ici », a-t-il ajouté.</gams:textualContent><rel:isPartOf rdf:resource="https://gams.uni-graz.at/o:aaif.fraweb" /></aaif:Entry><aaif:Phrase rdf:about="https://gams.uni-graz.at/o:aaif.fraweb#En3918Ph1"><aaif:verb rdf:resource="https://gams.uni-graz.at/o:aaif.fraweb#En3918Ph1Ve1" /><aaif:adverb rdf:resource="https://gams.uni-graz.at/o:aaif.fraweb#En3918Ph1Ad1" /><aaif:text>des citoyens qui vivent pauvres </aaif:text><aaif:annoText>des citoyens qui [v|vivent|vivre|is] [a|pauvres|pauvre|aisnmnnn] </aaif:annoText></aaif:Phrase><aaif:Verb rdf:about="https://gams.uni-graz.at/o:aaif.fraweb#En3918Ph1Ve1"><aaif:text>vivent</aaif:text><aaif:lemma rdf:resource="https://gams.uni-graz.at/o:aaif.lemma#vivre" /><aaif:position rdf:datatype="http://www.w3.org/2001/XMLSchema#int">1</aaif:position><aaif:coordinated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:coordinated><aaif:partOfText rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</aaif:partOfText><aaif:syntacticConstruction rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Intransitive" /></aaif:Verb><aaif:Adverb rdf:about="https://gams.uni-graz.at/o:aaif.fraweb#En3918Ph1Ad1"><aaif:text>pauvres</aaif:text><aaif:lemma rdf:resource="https://gams.uni-graz.at/o:aaif.lemma#pauvre" /><aaif:position rdf:datatype="http://www.w3.org/2001/XMLSchema#int">2</aaif:position><aaif:coordinated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:coordinated><aaif:morphosyntacticStructure rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Adjective" /><aaif:inflection rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#InaudibleInflection" /><aaif:attributionTarget rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Verb" /><aaif:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:modified><aaif:semanticClassification rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Manner" /><aaif:reduplicated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:reduplicated><aaif:prepositionalPhrase rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:prepositionalPhrase></aaif:Adverb><aaif:Entry rdf:about="https://gams.uni-graz.at/o:aaif.fraweb#En3919"><aaif:phrase rdf:resource="https://gams.uni-graz.at/o:aaif.fraweb#En3919Ph1" /><aaif:source rdf:resource="https://gams.uni-graz.at/o:aaif.fraweb.bibl#DC3940" /><gams:textualContent>Merci pour cet encouragement car aujourd'hui on se demande s'il est néssaire de mettre en pratique la Parole de Dieu étand donné que même dans L'Eglise la depravation et le péché sont devenus légitimes et lorsque vous cherchez à prêcher le contraire vous vous faites de ennemis.Aujourd'hui l'evangile a été tellement denaturé que lorsque tu cherches à vivre pur  on te traite comme on a traité Noé.</gams:textualContent><rel:isPartOf rdf:resource="https://gams.uni-graz.at/o:aaif.fraweb" /></aaif:Entry><aaif:Phrase rdf:about="https://gams.uni-graz.at/o:aaif.fraweb#En3919Ph1"><aaif:verb rdf:resource="https://gams.uni-graz.at/o:aaif.fraweb#En3919Ph1Ve1" /><aaif:adverb rdf:resource="https://gams.uni-graz.at/o:aaif.fraweb#En3919Ph1Ad1" /><aaif:text>tu cherches à vivre pur </aaif:text><aaif:annoText>tu cherches à [v|vivre|vivre|is] [a|pur|pur|auvnmnnn] </aaif:annoText></aaif:Phrase><aaif:Verb rdf:about="https://gams.uni-graz.at/o:aaif.fraweb#En3919Ph1Ve1"><aaif:text>vivre</aaif:text><aaif:lemma rdf:resource="https://gams.uni-graz.at/o:aaif.lemma#vivre" /><aaif:position rdf:datatype="http://www.w3.org/2001/XMLSchema#int">1</aaif:position><aaif:coordinated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:coordinated><aaif:partOfText rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</aaif:partOfText><aaif:syntacticConstruction rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Intransitive" /></aaif:Verb><aaif:Adverb rdf:about="https://gams.uni-graz.at/o:aaif.fraweb#En3919Ph1Ad1"><aaif:text>pur</aaif:text><aaif:lemma rdf:resource="https://gams.uni-graz.at/o:aaif.lemma#pur" /><aaif:position rdf:datatype="http://www.w3.org/2001/XMLSchema#int">2</aaif:position><aaif:coordinated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:coordinated><aaif:morphosyntacticStructure rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Adjective" /><aaif:inflection rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Uninflected" /><aaif:attributionTarget rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Verb" /><aaif:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:modified><aaif:semanticClassification rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Manner" /><aaif:reduplicated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:reduplicated><aaif:prepositionalPhrase rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:prepositionalPhrase></aaif:Adverb><aaif:Entry rdf:about="https://gams.uni-graz.at/o:aaif.fraweb#En3920"><aaif:phrase rdf:resource="https://gams.uni-graz.at/o:aaif.fraweb#En3920Ph1" /><aaif:source rdf:resource="https://gams.uni-graz.at/o:aaif.fraweb.bibl#DC3941" /><gams:textualContent>Le Groupe CIAT agit pour concilier les besoins de l’Homme et l’Environnement, et vise pour tous le même objectif : vivre bien, vivre pur , vivre durable  </gams:textualContent><rel:isPartOf rdf:resource="https://gams.uni-graz.at/o:aaif.fraweb" /></aaif:Entry><aaif:Phrase rdf:about="https://gams.uni-graz.at/o:aaif.fraweb#En3920Ph1"><aaif:verb rdf:resource="https://gams.uni-graz.at/o:aaif.fraweb#En3920Ph1Ve1" /><aaif:verb rdf:resource="https://gams.uni-graz.at/o:aaif.fraweb#En3920Ph1Ve2" /><aaif:adverb rdf:resource="https://gams.uni-graz.at/o:aaif.fraweb#En3920Ph1Ad1" /><aaif:adverb rdf:resource="https://gams.uni-graz.at/o:aaif.fraweb#En3920Ph1Ad2" /><aaif:text>vivre bien, vivre pur , vivre durable </aaif:text><aaif:annoText>vivre bien, [v|vivre|vivre|is] [a|pur|pur|auvnmnnn] , [v|vivre|vivre|is] [a|durable|durable|auvnmnnn] </aaif:annoText></aaif:Phrase><aaif:Verb rdf:about="https://gams.uni-graz.at/o:aaif.fraweb#En3920Ph1Ve1"><aaif:text>vivre</aaif:text><aaif:lemma rdf:resource="https://gams.uni-graz.at/o:aaif.lemma#vivre" /><aaif:position rdf:datatype="http://www.w3.org/2001/XMLSchema#int">1</aaif:position><aaif:coordinated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:coordinated><aaif:partOfText rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</aaif:partOfText><aaif:syntacticConstruction rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Intransitive" /></aaif:Verb><aaif:Verb rdf:about="https://gams.uni-graz.at/o:aaif.fraweb#En3920Ph1Ve2"><aaif:text>vivre</aaif:text><aaif:lemma rdf:resource="https://gams.uni-graz.at/o:aaif.lemma#vivre" /><aaif:position rdf:datatype="http://www.w3.org/2001/XMLSchema#int">3</aaif:position><aaif:coordinated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:coordinated><aaif:partOfText rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</aaif:partOfText><aaif:syntacticConstruction rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Intransitive" /></aaif:Verb><aaif:Adverb rdf:about="https://gams.uni-graz.at/o:aaif.fraweb#En3920Ph1Ad1"><aaif:text>pur</aaif:text><aaif:lemma rdf:resource="https://gams.uni-graz.at/o:aaif.lemma#pur" /><aaif:position rdf:datatype="http://www.w3.org/2001/XMLSchema#int">2</aaif:position><aaif:coordinated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:coordinated><aaif:morphosyntacticStructure rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Adjective" /><aaif:inflection rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Uninflected" /><aaif:attributionTarget rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Verb" /><aaif:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:modified><aaif:semanticClassification rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Manner" /><aaif:reduplicated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:reduplicated><aaif:prepositionalPhrase rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:prepositionalPhrase></aaif:Adverb><aaif:Adverb rdf:about="https://gams.uni-graz.at/o:aaif.fraweb#En3920Ph1Ad2"><aaif:text>durable</aaif:text><aaif:lemma rdf:resource="https://gams.uni-graz.at/o:aaif.lemma#durable" /><aaif:position rdf:datatype="http://www.w3.org/2001/XMLSchema#int">4</aaif:position><aaif:coordinated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:coordinated><aaif:morphosyntacticStructure rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Adjective" /><aaif:inflection rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Uninflected" /><aaif:attributionTarget rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Verb" /><aaif:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:modified><aaif:semanticClassification rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Manner" /><aaif:reduplicated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:reduplicated><aaif:prepositionalPhrase rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:prepositionalPhrase></aaif:Adverb><aaif:Entry rdf:about="https://gams.uni-graz.at/o:aaif.fraweb#En3921"><aaif:phrase rdf:resource="https://gams.uni-graz.at/o:aaif.fraweb#En3921Ph1" /><aaif:source rdf:resource="https://gams.uni-graz.at/o:aaif.fraweb.bibl#DC3942" /><gams:textualContent>ils vivent retiré de la civilisation </gams:textualContent><rel:isPartOf rdf:resource="https://gams.uni-graz.at/o:aaif.fraweb" /></aaif:Entry><aaif:Phrase rdf:about="https://gams.uni-graz.at/o:aaif.fraweb#En3921Ph1"><aaif:verb rdf:resource="https://gams.uni-graz.at/o:aaif.fraweb#En3921Ph1Ve1" /><aaif:adverb rdf:resource="https://gams.uni-graz.at/o:aaif.fraweb#En3921Ph1Ad1" /><aaif:text>ils vivent retiré de la civilisation</aaif:text><aaif:annoText>ils [v|vivent|vivre|is] [a|retiré|retiré|ausnmnnn] de la civilisation</aaif:annoText></aaif:Phrase><aaif:Verb rdf:about="https://gams.uni-graz.at/o:aaif.fraweb#En3921Ph1Ve1"><aaif:text>vivent</aaif:text><aaif:lemma rdf:resource="https://gams.uni-graz.at/o:aaif.lemma#vivre" /><aaif:position rdf:datatype="http://www.w3.org/2001/XMLSchema#int">1</aaif:position><aaif:coordinated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:coordinated><aaif:partOfText rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</aaif:partOfText><aaif:syntacticConstruction rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Intransitive" /></aaif:Verb><aaif:Adverb rdf:about="https://gams.uni-graz.at/o:aaif.fraweb#En3921Ph1Ad1"><aaif:text>retiré</aaif:text><aaif:lemma rdf:resource="https://gams.uni-graz.at/o:aaif.lemma#retiré" /><aaif:position rdf:datatype="http://www.w3.org/2001/XMLSchema#int">2</aaif:position><aaif:coordinated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:coordinated><aaif:morphosyntacticStructure rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Adjective" /><aaif:inflection rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Uninflected" /><aaif:attributionTarget rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Verb" /><aaif:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:modified><aaif:semanticClassification rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Manner" /><aaif:reduplicated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:reduplicated><aaif:prepositionalPhrase rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:prepositionalPhrase></aaif:Adverb><aaif:Entry rdf:about="https://gams.uni-graz.at/o:aaif.fraweb#En3922"><aaif:phrase rdf:resource="https://gams.uni-graz.at/o:aaif.fraweb#En3922Ph1" /><aaif:source rdf:resource="https://gams.uni-graz.at/o:aaif.fraweb.bibl#DC3943" /><gams:textualContent>Il est rare d'apercevoir un Dragon sylvestre, car ceci [= ceux-ci ?] ne vivent retiré  qu'au plus profond des forêts d'Undomë ou de Vaendark.</gams:textualContent><rel:isPartOf rdf:resource="https://gams.uni-graz.at/o:aaif.fraweb" /></aaif:Entry><aaif:Phrase rdf:about="https://gams.uni-graz.at/o:aaif.fraweb#En3922Ph1"><aaif:verb rdf:resource="https://gams.uni-graz.at/o:aaif.fraweb#En3922Ph1Ve1" /><aaif:adverb rdf:resource="https://gams.uni-graz.at/o:aaif.fraweb#En3922Ph1Ad1" /><aaif:text>ceci [= ceux-ci ?] ne vivent retiré </aaif:text><aaif:annoText>ceci [= ceux-ci ?] ne [v|vivent|vivre|is] [a|retiré|retiré|ausnmnnn] </aaif:annoText></aaif:Phrase><aaif:Verb rdf:about="https://gams.uni-graz.at/o:aaif.fraweb#En3922Ph1Ve1"><aaif:text>vivent</aaif:text><aaif:lemma rdf:resource="https://gams.uni-graz.at/o:aaif.lemma#vivre" /><aaif:position rdf:datatype="http://www.w3.org/2001/XMLSchema#int">1</aaif:position><aaif:coordinated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:coordinated><aaif:partOfText rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</aaif:partOfText><aaif:syntacticConstruction rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Intransitive" /></aaif:Verb><aaif:Adverb rdf:about="https://gams.uni-graz.at/o:aaif.fraweb#En3922Ph1Ad1"><aaif:text>retiré</aaif:text><aaif:lemma rdf:resource="https://gams.uni-graz.at/o:aaif.lemma#retiré" /><aaif:position rdf:datatype="http://www.w3.org/2001/XMLSchema#int">2</aaif:position><aaif:coordinated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:coordinated><aaif:morphosyntacticStructure rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Adjective" /><aaif:inflection rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Uninflected" /><aaif:attributionTarget rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Verb" /><aaif:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:modified><aaif:semanticClassification rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Manner" /><aaif:reduplicated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:reduplicated><aaif:prepositionalPhrase rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:prepositionalPhrase></aaif:Adverb><aaif:Entry rdf:about="https://gams.uni-graz.at/o:aaif.fraweb#En3923"><aaif:phrase rdf:resource="https://gams.uni-graz.at/o:aaif.fraweb#En3923Ph1" /><aaif:source rdf:resource="https://gams.uni-graz.at/o:aaif.fraweb.bibl#DC3944" /><gams:textualContent>Les gorilles sont les plus grands singes anthropoïdes vivants.Ils vivent retirés dans la jungle africaine, où ils se nourrissent presque exclusivement de plantes.</gams:textualContent><rel:isPartOf rdf:resource="https://gams.uni-graz.at/o:aaif.fraweb" /></aaif:Entry><aaif:Phrase rdf:about="https://gams.uni-graz.at/o:aaif.fraweb#En3923Ph1"><aaif:verb rdf:resource="https://gams.uni-graz.at/o:aaif.fraweb#En3923Ph1Ve1" /><aaif:adverb rdf:resource="https://gams.uni-graz.at/o:aaif.fraweb#En3923Ph1Ad1" /><aaif:text>Ils vivent retirés dans la jungle africaine</aaif:text><aaif:annoText>Ils [v|vivent|vivre|is] [a|retirés|retiré|aisnmnnn] dans la jungle africaine</aaif:annoText></aaif:Phrase><aaif:Verb rdf:about="https://gams.uni-graz.at/o:aaif.fraweb#En3923Ph1Ve1"><aaif:text>vivent</aaif:text><aaif:lemma rdf:resource="https://gams.uni-graz.at/o:aaif.lemma#vivre" /><aaif:position rdf:datatype="http://www.w3.org/2001/XMLSchema#int">1</aaif:position><aaif:coordinated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:coordinated><aaif:partOfText rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</aaif:partOfText><aaif:syntacticConstruction rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Intransitive" /></aaif:Verb><aaif:Adverb rdf:about="https://gams.uni-graz.at/o:aaif.fraweb#En3923Ph1Ad1"><aaif:text>retirés</aaif:text><aaif:lemma rdf:resource="https://gams.uni-graz.at/o:aaif.lemma#retiré" /><aaif:position rdf:datatype="http://www.w3.org/2001/XMLSchema#int">2</aaif:position><aaif:coordinated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:coordinated><aaif:morphosyntacticStructure rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Adjective" /><aaif:inflection rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#InaudibleInflection" /><aaif:attributionTarget rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Verb" /><aaif:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:modified><aaif:semanticClassification rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Manner" /><aaif:reduplicated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:reduplicated><aaif:prepositionalPhrase rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:prepositionalPhrase></aaif:Adverb><aaif:Entry rdf:about="https://gams.uni-graz.at/o:aaif.fraweb#En3924"><aaif:phrase rdf:resource="https://gams.uni-graz.at/o:aaif.fraweb#En3924Ph1" /><aaif:source rdf:resource="https://gams.uni-graz.at/o:aaif.fraweb.bibl#DC3945" /><gams:textualContent>Une abbaye (synonyme de monastère) est un lieu où des croyants vivent retirés  pour prier.</gams:textualContent><rel:isPartOf rdf:resource="https://gams.uni-graz.at/o:aaif.fraweb" /></aaif:Entry><aaif:Phrase rdf:about="https://gams.uni-graz.at/o:aaif.fraweb#En3924Ph1"><aaif:verb rdf:resource="https://gams.uni-graz.at/o:aaif.fraweb#En3924Ph1Ve1" /><aaif:adverb rdf:resource="https://gams.uni-graz.at/o:aaif.fraweb#En3924Ph1Ad1" /><aaif:text>des croyants vivent retirés </aaif:text><aaif:annoText>des croyants [v|vivent|vivre|is] [a|retirés|retiré|aisnmnnn] </aaif:annoText></aaif:Phrase><aaif:Verb rdf:about="https://gams.uni-graz.at/o:aaif.fraweb#En3924Ph1Ve1"><aaif:text>vivent</aaif:text><aaif:lemma rdf:resource="https://gams.uni-graz.at/o:aaif.lemma#vivre" /><aaif:position rdf:datatype="http://www.w3.org/2001/XMLSchema#int">1</aaif:position><aaif:coordinated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:coordinated><aaif:partOfText rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</aaif:partOfText><aaif:syntacticConstruction rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Intransitive" /></aaif:Verb><aaif:Adverb rdf:about="https://gams.uni-graz.at/o:aaif.fraweb#En3924Ph1Ad1"><aaif:text>retirés</aaif:text><aaif:lemma rdf:resource="https://gams.uni-graz.at/o:aaif.lemma#retiré" /><aaif:position rdf:datatype="http://www.w3.org/2001/XMLSchema#int">2</aaif:position><aaif:coordinated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:coordinated><aaif:morphosyntacticStructure rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Adjective" /><aaif:inflection rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#InaudibleInflection" /><aaif:attributionTarget rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Verb" /><aaif:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:modified><aaif:semanticClassification rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Manner" /><aaif:reduplicated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:reduplicated><aaif:prepositionalPhrase rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:prepositionalPhrase></aaif:Adverb><aaif:Entry rdf:about="https://gams.uni-graz.at/o:aaif.fraweb#En3925"><aaif:phrase rdf:resource="https://gams.uni-graz.at/o:aaif.fraweb#En3925Ph1" /><aaif:source rdf:resource="https://gams.uni-graz.at/o:aaif.fraweb.bibl#DC3946" /><gams:textualContent>Les zélus vivent riche  car ils ne payent pas le RSA en Polynésie Française, scandale que dénonce René Hoffer!</gams:textualContent><rel:isPartOf rdf:resource="https://gams.uni-graz.at/o:aaif.fraweb" /></aaif:Entry><aaif:Phrase rdf:about="https://gams.uni-graz.at/o:aaif.fraweb#En3925Ph1"><aaif:verb rdf:resource="https://gams.uni-graz.at/o:aaif.fraweb#En3925Ph1Ve1" /><aaif:adverb rdf:resource="https://gams.uni-graz.at/o:aaif.fraweb#En3925Ph1Ad1" /><aaif:text>Les zélus vivent riche </aaif:text><aaif:annoText>Les zélus [v|vivent|vivre|is] [a|riche|riche|ausnmnnn] </aaif:annoText></aaif:Phrase><aaif:Verb rdf:about="https://gams.uni-graz.at/o:aaif.fraweb#En3925Ph1Ve1"><aaif:text>vivent</aaif:text><aaif:lemma rdf:resource="https://gams.uni-graz.at/o:aaif.lemma#vivre" /><aaif:position rdf:datatype="http://www.w3.org/2001/XMLSchema#int">1</aaif:position><aaif:coordinated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:coordinated><aaif:partOfText rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</aaif:partOfText><aaif:syntacticConstruction rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Intransitive" /></aaif:Verb><aaif:Adverb rdf:about="https://gams.uni-graz.at/o:aaif.fraweb#En3925Ph1Ad1"><aaif:text>riche</aaif:text><aaif:lemma rdf:resource="https://gams.uni-graz.at/o:aaif.lemma#riche" /><aaif:position rdf:datatype="http://www.w3.org/2001/XMLSchema#int">2</aaif:position><aaif:coordinated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:coordinated><aaif:morphosyntacticStructure rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Adjective" /><aaif:inflection rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Uninflected" /><aaif:attributionTarget rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Verb" /><aaif:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:modified><aaif:semanticClassification rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Manner" /><aaif:reduplicated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:reduplicated><aaif:prepositionalPhrase rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:prepositionalPhrase></aaif:Adverb><aaif:Entry rdf:about="https://gams.uni-graz.at/o:aaif.fraweb#En3926"><aaif:phrase rdf:resource="https://gams.uni-graz.at/o:aaif.fraweb#En3926Ph1" /><aaif:source rdf:resource="https://gams.uni-graz.at/o:aaif.fraweb.bibl#DC3947" /><gams:textualContent>Pour ceux qui domine présentement même, ils ont pas besoin de faire travailler les citoyens tant que cela parce que ils en ont rien à foutre de rien à rien et comme ils l'ont répéter à des millier de reprises, ils tuent tout le monde en même temps, il vivent riche  et ils en ont rien à foutre de rien à rien.</gams:textualContent><rel:isPartOf rdf:resource="https://gams.uni-graz.at/o:aaif.fraweb" /></aaif:Entry><aaif:Phrase rdf:about="https://gams.uni-graz.at/o:aaif.fraweb#En3926Ph1"><aaif:verb rdf:resource="https://gams.uni-graz.at/o:aaif.fraweb#En3926Ph1Ve1" /><aaif:adverb rdf:resource="https://gams.uni-graz.at/o:aaif.fraweb#En3926Ph1Ad1" /><aaif:text>il vivent riche </aaif:text><aaif:annoText>il [v|vivent|vivre|is] [a|riche|riche|ausnmnnn] </aaif:annoText></aaif:Phrase><aaif:Verb rdf:about="https://gams.uni-graz.at/o:aaif.fraweb#En3926Ph1Ve1"><aaif:text>vivent</aaif:text><aaif:lemma rdf:resource="https://gams.uni-graz.at/o:aaif.lemma#vivre" /><aaif:position rdf:datatype="http://www.w3.org/2001/XMLSchema#int">1</aaif:position><aaif:coordinated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:coordinated><aaif:partOfText rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</aaif:partOfText><aaif:syntacticConstruction rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Intransitive" /></aaif:Verb><aaif:Adverb rdf:about="https://gams.uni-graz.at/o:aaif.fraweb#En3926Ph1Ad1"><aaif:text>riche</aaif:text><aaif:lemma rdf:resource="https://gams.uni-graz.at/o:aaif.lemma#riche" /><aaif:position rdf:datatype="http://www.w3.org/2001/XMLSchema#int">2</aaif:position><aaif:coordinated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:coordinated><aaif:morphosyntacticStructure rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Adjective" /><aaif:inflection rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Uninflected" /><aaif:attributionTarget rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Verb" /><aaif:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:modified><aaif:semanticClassification rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Manner" /><aaif:reduplicated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:reduplicated><aaif:prepositionalPhrase rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:prepositionalPhrase></aaif:Adverb><aaif:Entry rdf:about="https://gams.uni-graz.at/o:aaif.fraweb#En3927"><aaif:phrase rdf:resource="https://gams.uni-graz.at/o:aaif.fraweb#En3927Ph1" /><aaif:source rdf:resource="https://gams.uni-graz.at/o:aaif.fraweb.bibl#DC3948" /><gams:textualContent>Heureux qui, comme les Suisses, vivent riches , en sécurité et en démocratie</gams:textualContent><rel:isPartOf rdf:resource="https://gams.uni-graz.at/o:aaif.fraweb" /></aaif:Entry><aaif:Phrase rdf:about="https://gams.uni-graz.at/o:aaif.fraweb#En3927Ph1"><aaif:verb rdf:resource="https://gams.uni-graz.at/o:aaif.fraweb#En3927Ph1Ve1" /><aaif:adverb rdf:resource="https://gams.uni-graz.at/o:aaif.fraweb#En3927Ph1Ad1" /><aaif:text>Heureux qui, comme les Suisses, vivent riches , en sécurité et en démocratie</aaif:text><aaif:annoText>Heureux qui, comme les Suisses, [v|vivent|vivre|is] [a|riches|riche|aisnmnnC] , en sécurité et en démocratie</aaif:annoText></aaif:Phrase><aaif:Verb rdf:about="https://gams.uni-graz.at/o:aaif.fraweb#En3927Ph1Ve1"><aaif:text>vivent</aaif:text><aaif:lemma rdf:resource="https://gams.uni-graz.at/o:aaif.lemma#vivre" /><aaif:position rdf:datatype="http://www.w3.org/2001/XMLSchema#int">1</aaif:position><aaif:coordinated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:coordinated><aaif:partOfText rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</aaif:partOfText><aaif:syntacticConstruction rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Intransitive" /></aaif:Verb><aaif:Adverb rdf:about="https://gams.uni-graz.at/o:aaif.fraweb#En3927Ph1Ad1"><aaif:text>riches</aaif:text><aaif:lemma rdf:resource="https://gams.uni-graz.at/o:aaif.lemma#riche" /><aaif:position rdf:datatype="http://www.w3.org/2001/XMLSchema#int">2</aaif:position><aaif:coordinated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</aaif:coordinated><aaif:morphosyntacticStructure rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Adjective" /><aaif:inflection rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#InaudibleInflection" /><aaif:attributionTarget rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Verb" /><aaif:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:modified><aaif:semanticClassification rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Manner" /><aaif:reduplicated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:reduplicated><aaif:prepositionalPhrase rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:prepositionalPhrase></aaif:Adverb><aaif:Entry rdf:about="https://gams.uni-graz.at/o:aaif.fraweb#En3928"><aaif:phrase rdf:resource="https://gams.uni-graz.at/o:aaif.fraweb#En3928Ph1" /><aaif:source rdf:resource="https://gams.uni-graz.at/o:aaif.fraweb.bibl#DC3949" /><gams:textualContent>On ne voit ou entend que des pubs pour des grandes surfaces qui vantent, bien être et qualité, traçabilité et prix cassés, ils nous feraient presque croire que leur producteurs vivent riches et heureux  !</gams:textualContent><rel:isPartOf rdf:resource="https://gams.uni-graz.at/o:aaif.fraweb" /></aaif:Entry><aaif:Phrase rdf:about="https://gams.uni-graz.at/o:aaif.fraweb#En3928Ph1"><aaif:verb rdf:resource="https://gams.uni-graz.at/o:aaif.fraweb#En3928Ph1Ve1" /><aaif:adverb rdf:resource="https://gams.uni-graz.at/o:aaif.fraweb#En3928Ph1Ad1" /><aaif:adverb rdf:resource="https://gams.uni-graz.at/o:aaif.fraweb#En3928Ph1Ad2" /><aaif:text>eur producteurs vivent riches et heureux </aaif:text><aaif:annoText>eur producteurs [v|vivent|vivre|is] [a|riches|riche|aisnmnnC] et [a|heureux|heureux|aisnmnnC] </aaif:annoText></aaif:Phrase><aaif:Verb rdf:about="https://gams.uni-graz.at/o:aaif.fraweb#En3928Ph1Ve1"><aaif:text>vivent</aaif:text><aaif:lemma rdf:resource="https://gams.uni-graz.at/o:aaif.lemma#vivre" /><aaif:position rdf:datatype="http://www.w3.org/2001/XMLSchema#int">1</aaif:position><aaif:coordinated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:coordinated><aaif:partOfText rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</aaif:partOfText><aaif:syntacticConstruction rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Intransitive" /></aaif:Verb><aaif:Adverb rdf:about="https://gams.uni-graz.at/o:aaif.fraweb#En3928Ph1Ad1"><aaif:text>riches</aaif:text><aaif:lemma rdf:resource="https://gams.uni-graz.at/o:aaif.lemma#riche" /><aaif:position rdf:datatype="http://www.w3.org/2001/XMLSchema#int">2</aaif:position><aaif:coordinated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</aaif:coordinated><aaif:morphosyntacticStructure rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Adjective" /><aaif:inflection rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#InaudibleInflection" /><aaif:attributionTarget rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Verb" /><aaif:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:modified><aaif:semanticClassification rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Manner" /><aaif:reduplicated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:reduplicated><aaif:prepositionalPhrase rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:prepositionalPhrase></aaif:Adverb><aaif:Adverb rdf:about="https://gams.uni-graz.at/o:aaif.fraweb#En3928Ph1Ad2"><aaif:text>heureux</aaif:text><aaif:lemma rdf:resource="https://gams.uni-graz.at/o:aaif.lemma#heureux" /><aaif:position rdf:datatype="http://www.w3.org/2001/XMLSchema#int">3</aaif:position><aaif:coordinated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</aaif:coordinated><aaif:morphosyntacticStructure rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Adjective" /><aaif:inflection rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#InaudibleInflection" /><aaif:attributionTarget rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Verb" /><aaif:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:modified><aaif:semanticClassification rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Manner" /><aaif:reduplicated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:reduplicated><aaif:prepositionalPhrase rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:prepositionalPhrase></aaif:Adverb><aaif:Entry rdf:about="https://gams.uni-graz.at/o:aaif.fraweb#En3929"><aaif:phrase rdf:resource="https://gams.uni-graz.at/o:aaif.fraweb#En3929Ph1" /><aaif:phrase rdf:resource="https://gams.uni-graz.at/o:aaif.fraweb#En3929Ph2" /><aaif:source rdf:resource="https://gams.uni-graz.at/o:aaif.fraweb.bibl#DC3950" /><gams:textualContent> Manger  vivant et végétal  pour  vivre  sain et dynamique  !</gams:textualContent><rel:isPartOf rdf:resource="https://gams.uni-graz.at/o:aaif.fraweb" /></aaif:Entry><aaif:Phrase rdf:about="https://gams.uni-graz.at/o:aaif.fraweb#En3929Ph1"><aaif:verb rdf:resource="https://gams.uni-graz.at/o:aaif.fraweb#En3929Ph1Ve1" /><aaif:adverb rdf:resource="https://gams.uni-graz.at/o:aaif.fraweb#En3929Ph1Ad1" /><aaif:adverb rdf:resource="https://gams.uni-graz.at/o:aaif.fraweb#En3929Ph1Ad2" /><aaif:text> Manger  vivant et végétal </aaif:text><aaif:annoText> [v|Manger|manger|is]  [a|vivant|vivant|auvnmnnC] et [a|végétal|végétal|auonmnnC] </aaif:annoText></aaif:Phrase><aaif:Verb rdf:about="https://gams.uni-graz.at/o:aaif.fraweb#En3929Ph1Ve1"><aaif:text>Manger</aaif:text><aaif:lemma rdf:resource="https://gams.uni-graz.at/o:aaif.lemma#manger" /><aaif:position rdf:datatype="http://www.w3.org/2001/XMLSchema#int">1</aaif:position><aaif:coordinated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:coordinated><aaif:partOfText rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</aaif:partOfText><aaif:syntacticConstruction rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Intransitive" /></aaif:Verb><aaif:Adverb rdf:about="https://gams.uni-graz.at/o:aaif.fraweb#En3929Ph1Ad1"><aaif:text>vivant</aaif:text><aaif:lemma rdf:resource="https://gams.uni-graz.at/o:aaif.lemma#vivant" /><aaif:position rdf:datatype="http://www.w3.org/2001/XMLSchema#int">2</aaif:position><aaif:coordinated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</aaif:coordinated><aaif:morphosyntacticStructure rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Adjective" /><aaif:inflection rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Uninflected" /><aaif:attributionTarget rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Verb" /><aaif:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:modified><aaif:semanticClassification rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Manner" /><aaif:reduplicated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:reduplicated><aaif:prepositionalPhrase rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:prepositionalPhrase></aaif:Adverb><aaif:Adverb rdf:about="https://gams.uni-graz.at/o:aaif.fraweb#En3929Ph1Ad2"><aaif:text>végétal</aaif:text><aaif:lemma rdf:resource="https://gams.uni-graz.at/o:aaif.lemma#végétal" /><aaif:position rdf:datatype="http://www.w3.org/2001/XMLSchema#int">3</aaif:position><aaif:coordinated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</aaif:coordinated><aaif:morphosyntacticStructure rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Adjective" /><aaif:inflection rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Uninflected" /><aaif:attributionTarget rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#VerbObject" /><aaif:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:modified><aaif:semanticClassification rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Manner" /><aaif:reduplicated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:reduplicated><aaif:prepositionalPhrase rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:prepositionalPhrase></aaif:Adverb><aaif:Phrase rdf:about="https://gams.uni-graz.at/o:aaif.fraweb#En3929Ph2"><aaif:verb rdf:resource="https://gams.uni-graz.at/o:aaif.fraweb#En3929Ph2Ve1" /><aaif:adverb rdf:resource="https://gams.uni-graz.at/o:aaif.fraweb#En3929Ph2Ad1" /><aaif:adverb rdf:resource="https://gams.uni-graz.at/o:aaif.fraweb#En3929Ph2Ad2" /><aaif:text> vivre  sain et dynamique </aaif:text><aaif:annoText> [v|vivre|vivre|is]  [a|sain|sain|ausnmnnC] et [a|dynamique|dynamique|ausnmnnC] </aaif:annoText></aaif:Phrase><aaif:Verb rdf:about="https://gams.uni-graz.at/o:aaif.fraweb#En3929Ph2Ve1"><aaif:text>vivre</aaif:text><aaif:lemma rdf:resource="https://gams.uni-graz.at/o:aaif.lemma#vivre" /><aaif:position rdf:datatype="http://www.w3.org/2001/XMLSchema#int">1</aaif:position><aaif:coordinated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:coordinated><aaif:partOfText rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</aaif:partOfText><aaif:syntacticConstruction rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Intransitive" /></aaif:Verb><aaif:Adverb rdf:about="https://gams.uni-graz.at/o:aaif.fraweb#En3929Ph2Ad1"><aaif:text>sain</aaif:text><aaif:lemma rdf:resource="https://gams.uni-graz.at/o:aaif.lemma#sain" /><aaif:position rdf:datatype="http://www.w3.org/2001/XMLSchema#int">2</aaif:position><aaif:coordinated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</aaif:coordinated><aaif:morphosyntacticStructure rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Adjective" /><aaif:inflection rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Uninflected" /><aaif:attributionTarget rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Verb" /><aaif:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:modified><aaif:semanticClassification rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Manner" /><aaif:reduplicated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:reduplicated><aaif:prepositionalPhrase rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:prepositionalPhrase></aaif:Adverb><aaif:Adverb rdf:about="https://gams.uni-graz.at/o:aaif.fraweb#En3929Ph2Ad2"><aaif:text>dynamique</aaif:text><aaif:lemma rdf:resource="https://gams.uni-graz.at/o:aaif.lemma#dynamique" /><aaif:position rdf:datatype="http://www.w3.org/2001/XMLSchema#int">3</aaif:position><aaif:coordinated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</aaif:coordinated><aaif:morphosyntacticStructure rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Adjective" /><aaif:inflection rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Uninflected" /><aaif:attributionTarget rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Verb" /><aaif:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:modified><aaif:semanticClassification rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Manner" /><aaif:reduplicated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:reduplicated><aaif:prepositionalPhrase rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:prepositionalPhrase></aaif:Adverb><aaif:Entry rdf:about="https://gams.uni-graz.at/o:aaif.fraweb#En3930"><aaif:phrase rdf:resource="https://gams.uni-graz.at/o:aaif.fraweb#En3930Ph1" /><aaif:source rdf:resource="https://gams.uni-graz.at/o:aaif.fraweb.bibl#DC3951" /><gams:textualContent>Ces maladies sont certes graves car mortelles à moyen ou long terme (certains chats porteurs vivent sain  jusqu'à plus de 15 ans sans déclarer la maladie, d'autres ont moins de chance et vivent moins longtemps), mais ne devraient pas être vues comme des fatalités.</gams:textualContent><rel:isPartOf rdf:resource="https://gams.uni-graz.at/o:aaif.fraweb" /></aaif:Entry><aaif:Phrase rdf:about="https://gams.uni-graz.at/o:aaif.fraweb#En3930Ph1"><aaif:verb rdf:resource="https://gams.uni-graz.at/o:aaif.fraweb#En3930Ph1Ve1" /><aaif:adverb rdf:resource="https://gams.uni-graz.at/o:aaif.fraweb#En3930Ph1Ad1" /><aaif:text>certains chats porteurs vivent sain </aaif:text><aaif:annoText>certains chats porteurs [v|vivent|vivre|is] [a|sain|sain|ausnmnnn] </aaif:annoText></aaif:Phrase><aaif:Verb rdf:about="https://gams.uni-graz.at/o:aaif.fraweb#En3930Ph1Ve1"><aaif:text>vivent</aaif:text><aaif:lemma rdf:resource="https://gams.uni-graz.at/o:aaif.lemma#vivre" /><aaif:position rdf:datatype="http://www.w3.org/2001/XMLSchema#int">1</aaif:position><aaif:coordinated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:coordinated><aaif:partOfText rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</aaif:partOfText><aaif:syntacticConstruction rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Intransitive" /></aaif:Verb><aaif:Adverb rdf:about="https://gams.uni-graz.at/o:aaif.fraweb#En3930Ph1Ad1"><aaif:text>sain</aaif:text><aaif:lemma rdf:resource="https://gams.uni-graz.at/o:aaif.lemma#sain" /><aaif:position rdf:datatype="http://www.w3.org/2001/XMLSchema#int">2</aaif:position><aaif:coordinated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:coordinated><aaif:morphosyntacticStructure rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Adjective" /><aaif:inflection rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Uninflected" /><aaif:attributionTarget rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Verb" /><aaif:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:modified><aaif:semanticClassification rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Manner" /><aaif:reduplicated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:reduplicated><aaif:prepositionalPhrase rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:prepositionalPhrase></aaif:Adverb><aaif:Entry rdf:about="https://gams.uni-graz.at/o:aaif.fraweb#En3931"><aaif:phrase rdf:resource="https://gams.uni-graz.at/o:aaif.fraweb#En3931Ph1" /><aaif:source rdf:resource="https://gams.uni-graz.at/o:aaif.fraweb.bibl#DC3952" /><gams:textualContent>l'amour c'est comme la vie, c'est inexplicable, magique, ça ne réponds à aucune, ce n'est pas un concept cohérent, peut importe ou comment ou pourquoi, l'amour ou ça marche ou ça marche pas, ou t'es vivant ou t'es mort, et pourquoi l'un ou pourquoi l'autre, pourquoi y a des fumeur qui vivent sain et longtemps , pourquoi des gens qui ne boivent pas fume pas et attrape des cancers des poumon, pourquoi, des couples qui sont a des kilometres de distance ça marche et d'autres l'un a coté de l'autre et qui ce frittent, on a tous entendu parler de tauladrs qui se marient pendant leur peine, pourquoi ça marche, tu crois pas que c'est la magie de l'amour qui fait son oeuvre?</gams:textualContent><rel:isPartOf rdf:resource="https://gams.uni-graz.at/o:aaif.fraweb" /></aaif:Entry><aaif:Phrase rdf:about="https://gams.uni-graz.at/o:aaif.fraweb#En3931Ph1"><aaif:verb rdf:resource="https://gams.uni-graz.at/o:aaif.fraweb#En3931Ph1Ve1" /><aaif:adverb rdf:resource="https://gams.uni-graz.at/o:aaif.fraweb#En3931Ph1Ad1" /><aaif:text>des fumeur qui vivent sain et longtemps</aaif:text><aaif:annoText>des fumeur qui [v|vivent|vivre|is] [a|sain|sain|ausnmnnC] et longtemps</aaif:annoText></aaif:Phrase><aaif:Verb rdf:about="https://gams.uni-graz.at/o:aaif.fraweb#En3931Ph1Ve1"><aaif:text>vivent</aaif:text><aaif:lemma rdf:resource="https://gams.uni-graz.at/o:aaif.lemma#vivre" /><aaif:position rdf:datatype="http://www.w3.org/2001/XMLSchema#int">1</aaif:position><aaif:coordinated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:coordinated><aaif:partOfText rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</aaif:partOfText><aaif:syntacticConstruction rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Intransitive" /></aaif:Verb><aaif:Adverb rdf:about="https://gams.uni-graz.at/o:aaif.fraweb#En3931Ph1Ad1"><aaif:text>sain</aaif:text><aaif:lemma rdf:resource="https://gams.uni-graz.at/o:aaif.lemma#sain" /><aaif:position rdf:datatype="http://www.w3.org/2001/XMLSchema#int">2</aaif:position><aaif:coordinated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</aaif:coordinated><aaif:morphosyntacticStructure rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Adjective" /><aaif:inflection rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Uninflected" /><aaif:attributionTarget rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Verb" /><aaif:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:modified><aaif:semanticClassification rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Manner" /><aaif:reduplicated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:reduplicated><aaif:prepositionalPhrase rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:prepositionalPhrase></aaif:Adverb><aaif:Entry rdf:about="https://gams.uni-graz.at/o:aaif.fraweb#En3932"><aaif:phrase rdf:resource="https://gams.uni-graz.at/o:aaif.fraweb#En3932Ph1" /><aaif:source rdf:resource="https://gams.uni-graz.at/o:aaif.fraweb.bibl#DC3953" /><gams:textualContent>Spectacle pour enfants la semaine prochaine à Sutton!Que tous êtres vivent sains et en paix !!!!!</gams:textualContent><rel:isPartOf rdf:resource="https://gams.uni-graz.at/o:aaif.fraweb" /></aaif:Entry><aaif:Phrase rdf:about="https://gams.uni-graz.at/o:aaif.fraweb#En3932Ph1"><aaif:verb rdf:resource="https://gams.uni-graz.at/o:aaif.fraweb#En3932Ph1Ve1" /><aaif:adverb rdf:resource="https://gams.uni-graz.at/o:aaif.fraweb#En3932Ph1Ad1" /><aaif:text>tous êtres vivent sains et en paix</aaif:text><aaif:annoText>tous êtres [v|vivent|vivre|is] [a|sains|sain|aisnmnnC] et en paix</aaif:annoText></aaif:Phrase><aaif:Verb rdf:about="https://gams.uni-graz.at/o:aaif.fraweb#En3932Ph1Ve1"><aaif:text>vivent</aaif:text><aaif:lemma rdf:resource="https://gams.uni-graz.at/o:aaif.lemma#vivre" /><aaif:position rdf:datatype="http://www.w3.org/2001/XMLSchema#int">1</aaif:position><aaif:coordinated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:coordinated><aaif:partOfText rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</aaif:partOfText><aaif:syntacticConstruction rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Intransitive" /></aaif:Verb><aaif:Adverb rdf:about="https://gams.uni-graz.at/o:aaif.fraweb#En3932Ph1Ad1"><aaif:text>sains</aaif:text><aaif:lemma rdf:resource="https://gams.uni-graz.at/o:aaif.lemma#sain" /><aaif:position rdf:datatype="http://www.w3.org/2001/XMLSchema#int">2</aaif:position><aaif:coordinated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</aaif:coordinated><aaif:morphosyntacticStructure rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Adjective" /><aaif:inflection rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#InaudibleInflection" /><aaif:attributionTarget rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Verb" /><aaif:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:modified><aaif:semanticClassification rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Manner" /><aaif:reduplicated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:reduplicated><aaif:prepositionalPhrase rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:prepositionalPhrase></aaif:Adverb><aaif:Entry rdf:about="https://gams.uni-graz.at/o:aaif.fraweb#En3933"><aaif:phrase rdf:resource="https://gams.uni-graz.at/o:aaif.fraweb#En3933Ph1" /><aaif:source rdf:resource="https://gams.uni-graz.at/o:aaif.fraweb.bibl#DC3954" /><gams:textualContent>A vrai dire, qu'est ce qui peut être plus important que de vivre satisfait  de sa life ?...</gams:textualContent><rel:isPartOf rdf:resource="https://gams.uni-graz.at/o:aaif.fraweb" /></aaif:Entry><aaif:Phrase rdf:about="https://gams.uni-graz.at/o:aaif.fraweb#En3933Ph1"><aaif:verb rdf:resource="https://gams.uni-graz.at/o:aaif.fraweb#En3933Ph1Ve1" /><aaif:adverb rdf:resource="https://gams.uni-graz.at/o:aaif.fraweb#En3933Ph1Ad1" /><aaif:text>qui peut être plus important que de vivre satisfait </aaif:text><aaif:annoText>qui peut être plus important que de [v|vivre|vivre|is] [a|satisfait|satisfait|ausnmnnn] </aaif:annoText></aaif:Phrase><aaif:Verb rdf:about="https://gams.uni-graz.at/o:aaif.fraweb#En3933Ph1Ve1"><aaif:text>vivre</aaif:text><aaif:lemma rdf:resource="https://gams.uni-graz.at/o:aaif.lemma#vivre" /><aaif:position rdf:datatype="http://www.w3.org/2001/XMLSchema#int">1</aaif:position><aaif:coordinated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:coordinated><aaif:partOfText rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</aaif:partOfText><aaif:syntacticConstruction rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Intransitive" /></aaif:Verb><aaif:Adverb rdf:about="https://gams.uni-graz.at/o:aaif.fraweb#En3933Ph1Ad1"><aaif:text>satisfait</aaif:text><aaif:lemma rdf:resource="https://gams.uni-graz.at/o:aaif.lemma#satisfait" /><aaif:position rdf:datatype="http://www.w3.org/2001/XMLSchema#int">2</aaif:position><aaif:coordinated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:coordinated><aaif:morphosyntacticStructure rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Adjective" /><aaif:inflection rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Uninflected" /><aaif:attributionTarget rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Verb" /><aaif:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:modified><aaif:semanticClassification rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Manner" /><aaif:reduplicated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:reduplicated><aaif:prepositionalPhrase rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:prepositionalPhrase></aaif:Adverb><aaif:Entry rdf:about="https://gams.uni-graz.at/o:aaif.fraweb#En3934"><aaif:phrase rdf:resource="https://gams.uni-graz.at/o:aaif.fraweb#En3934Ph1" /><aaif:source rdf:resource="https://gams.uni-graz.at/o:aaif.fraweb.bibl#DC3955" /><gams:textualContent>Etant conscient de ce que l’on possède en Jésus Christ, nous pouvons vivre satisfait  dans un monde de vanité.C’est la libération de l’Evangile !</gams:textualContent><rel:isPartOf rdf:resource="https://gams.uni-graz.at/o:aaif.fraweb" /></aaif:Entry><aaif:Phrase rdf:about="https://gams.uni-graz.at/o:aaif.fraweb#En3934Ph1"><aaif:verb rdf:resource="https://gams.uni-graz.at/o:aaif.fraweb#En3934Ph1Ve1" /><aaif:adverb rdf:resource="https://gams.uni-graz.at/o:aaif.fraweb#En3934Ph1Ad1" /><aaif:text>nous pouvons vivre satisfait </aaif:text><aaif:annoText>nous pouvons [v|vivre|vivre|is] [a|satisfait|satisfait|ausnmnnn] </aaif:annoText></aaif:Phrase><aaif:Verb rdf:about="https://gams.uni-graz.at/o:aaif.fraweb#En3934Ph1Ve1"><aaif:text>vivre</aaif:text><aaif:lemma rdf:resource="https://gams.uni-graz.at/o:aaif.lemma#vivre" /><aaif:position rdf:datatype="http://www.w3.org/2001/XMLSchema#int">1</aaif:position><aaif:coordinated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:coordinated><aaif:partOfText rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</aaif:partOfText><aaif:syntacticConstruction rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Intransitive" /></aaif:Verb><aaif:Adverb rdf:about="https://gams.uni-graz.at/o:aaif.fraweb#En3934Ph1Ad1"><aaif:text>satisfait</aaif:text><aaif:lemma rdf:resource="https://gams.uni-graz.at/o:aaif.lemma#satisfait" /><aaif:position rdf:datatype="http://www.w3.org/2001/XMLSchema#int">2</aaif:position><aaif:coordinated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:coordinated><aaif:morphosyntacticStructure rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Adjective" /><aaif:inflection rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Uninflected" /><aaif:attributionTarget rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Verb" /><aaif:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:modified><aaif:semanticClassification rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Manner" /><aaif:reduplicated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:reduplicated><aaif:prepositionalPhrase rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:prepositionalPhrase></aaif:Adverb><aaif:Entry rdf:about="https://gams.uni-graz.at/o:aaif.fraweb#En3935"><aaif:phrase rdf:resource="https://gams.uni-graz.at/o:aaif.fraweb#En3935Ph1" /><aaif:source rdf:resource="https://gams.uni-graz.at/o:aaif.fraweb.bibl#DC3956" /><gams:textualContent>Conquerir rien que le marche de moscou en cafe´ fini serai suffisant pour que nos planteurs vivent satisfaits  .</gams:textualContent><rel:isPartOf rdf:resource="https://gams.uni-graz.at/o:aaif.fraweb" /></aaif:Entry><aaif:Phrase rdf:about="https://gams.uni-graz.at/o:aaif.fraweb#En3935Ph1"><aaif:verb rdf:resource="https://gams.uni-graz.at/o:aaif.fraweb#En3935Ph1Ve1" /><aaif:adverb rdf:resource="https://gams.uni-graz.at/o:aaif.fraweb#En3935Ph1Ad1" /><aaif:text>nos planteurs vivent satisfaits </aaif:text><aaif:annoText>nos planteurs [v|vivent|vivre|is] [a|satisfaits|satisfait|aisnmnnn] </aaif:annoText></aaif:Phrase><aaif:Verb rdf:about="https://gams.uni-graz.at/o:aaif.fraweb#En3935Ph1Ve1"><aaif:text>vivent</aaif:text><aaif:lemma rdf:resource="https://gams.uni-graz.at/o:aaif.lemma#vivre" /><aaif:position rdf:datatype="http://www.w3.org/2001/XMLSchema#int">1</aaif:position><aaif:coordinated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:coordinated><aaif:partOfText rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</aaif:partOfText><aaif:syntacticConstruction rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Intransitive" /></aaif:Verb><aaif:Adverb rdf:about="https://gams.uni-graz.at/o:aaif.fraweb#En3935Ph1Ad1"><aaif:text>satisfaits</aaif:text><aaif:lemma rdf:resource="https://gams.uni-graz.at/o:aaif.lemma#satisfait" /><aaif:position rdf:datatype="http://www.w3.org/2001/XMLSchema#int">2</aaif:position><aaif:coordinated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:coordinated><aaif:morphosyntacticStructure rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Adjective" /><aaif:inflection rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#InaudibleInflection" /><aaif:attributionTarget rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Verb" /><aaif:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:modified><aaif:semanticClassification rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Manner" /><aaif:reduplicated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:reduplicated><aaif:prepositionalPhrase rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:prepositionalPhrase></aaif:Adverb><aaif:Entry rdf:about="https://gams.uni-graz.at/o:aaif.fraweb#En3936"><aaif:phrase rdf:resource="https://gams.uni-graz.at/o:aaif.fraweb#En3936Ph1" /><aaif:source rdf:resource="https://gams.uni-graz.at/o:aaif.fraweb.bibl#DC3957" /><gams:textualContent>Le japon c'est pas ce que tu vois à la télé, certes c'est beau mais les gens vivent serré comme des fourmis, tu dors dans des chambres de 2m² :D tu dois travailler tout les jours (très peu de congés), la bouffe est bonne, mais le travail et la pression sont énorme sans parlé des risque d'éruptions volcaniques, de tremblements de terres, de Tsunami de tempête etc...</gams:textualContent><rel:isPartOf rdf:resource="https://gams.uni-graz.at/o:aaif.fraweb" /></aaif:Entry><aaif:Phrase rdf:about="https://gams.uni-graz.at/o:aaif.fraweb#En3936Ph1"><aaif:verb rdf:resource="https://gams.uni-graz.at/o:aaif.fraweb#En3936Ph1Ve1" /><aaif:adverb rdf:resource="https://gams.uni-graz.at/o:aaif.fraweb#En3936Ph1Ad1" /><aaif:text>les gens vivent serré comme des fourmis</aaif:text><aaif:annoText>les gens [v|vivent|vivre|is] [a|serré|serré|ausnlnnn] comme des fourmis</aaif:annoText></aaif:Phrase><aaif:Verb rdf:about="https://gams.uni-graz.at/o:aaif.fraweb#En3936Ph1Ve1"><aaif:text>vivent</aaif:text><aaif:lemma rdf:resource="https://gams.uni-graz.at/o:aaif.lemma#vivre" /><aaif:position rdf:datatype="http://www.w3.org/2001/XMLSchema#int">1</aaif:position><aaif:coordinated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:coordinated><aaif:partOfText rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</aaif:partOfText><aaif:syntacticConstruction rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Intransitive" /></aaif:Verb><aaif:Adverb rdf:about="https://gams.uni-graz.at/o:aaif.fraweb#En3936Ph1Ad1"><aaif:text>serré</aaif:text><aaif:lemma rdf:resource="https://gams.uni-graz.at/o:aaif.lemma#serré" /><aaif:position rdf:datatype="http://www.w3.org/2001/XMLSchema#int">2</aaif:position><aaif:coordinated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:coordinated><aaif:morphosyntacticStructure rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Adjective" /><aaif:inflection rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Uninflected" /><aaif:attributionTarget rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Verb" /><aaif:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:modified><aaif:semanticClassification rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Location" /><aaif:reduplicated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:reduplicated><aaif:prepositionalPhrase rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:prepositionalPhrase></aaif:Adverb><aaif:Entry rdf:about="https://gams.uni-graz.at/o:aaif.fraweb#En3937"><aaif:phrase rdf:resource="https://gams.uni-graz.at/o:aaif.fraweb#En3937Ph1" /><aaif:source rdf:resource="https://gams.uni-graz.at/o:aaif.fraweb.bibl#DC3958" /><gams:textualContent>ils ont plus de 4000 euro de revenu.mais en plus ils payent la creche 500 euro.ils vivent serré  : pas de vacances, pas de loisirs, ils doivent de l'argent à pas mal de monde.</gams:textualContent><rel:isPartOf rdf:resource="https://gams.uni-graz.at/o:aaif.fraweb" /></aaif:Entry><aaif:Phrase rdf:about="https://gams.uni-graz.at/o:aaif.fraweb#En3937Ph1"><aaif:verb rdf:resource="https://gams.uni-graz.at/o:aaif.fraweb#En3937Ph1Ve1" /><aaif:adverb rdf:resource="https://gams.uni-graz.at/o:aaif.fraweb#En3937Ph1Ad1" /><aaif:text>ils vivent serré </aaif:text><aaif:annoText>ils [v|vivent|vivre|is] [a|serré|serré|auvnmnnn] </aaif:annoText></aaif:Phrase><aaif:Verb rdf:about="https://gams.uni-graz.at/o:aaif.fraweb#En3937Ph1Ve1"><aaif:text>vivent</aaif:text><aaif:lemma rdf:resource="https://gams.uni-graz.at/o:aaif.lemma#vivre" /><aaif:position rdf:datatype="http://www.w3.org/2001/XMLSchema#int">1</aaif:position><aaif:coordinated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:coordinated><aaif:partOfText rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</aaif:partOfText><aaif:syntacticConstruction rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Intransitive" /></aaif:Verb><aaif:Adverb rdf:about="https://gams.uni-graz.at/o:aaif.fraweb#En3937Ph1Ad1"><aaif:text>serré</aaif:text><aaif:lemma rdf:resource="https://gams.uni-graz.at/o:aaif.lemma#serré" /><aaif:position rdf:datatype="http://www.w3.org/2001/XMLSchema#int">2</aaif:position><aaif:coordinated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:coordinated><aaif:morphosyntacticStructure rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Adjective" /><aaif:inflection rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Uninflected" /><aaif:attributionTarget rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Verb" /><aaif:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:modified><aaif:semanticClassification rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Manner" /><aaif:reduplicated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:reduplicated><aaif:prepositionalPhrase rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:prepositionalPhrase></aaif:Adverb><aaif:Entry rdf:about="https://gams.uni-graz.at/o:aaif.fraweb#En3938"><aaif:phrase rdf:resource="https://gams.uni-graz.at/o:aaif.fraweb#En3938Ph1" /><aaif:source rdf:resource="https://gams.uni-graz.at/o:aaif.fraweb.bibl#DC3959" /><gams:textualContent>Dans les camps qui sont apparus dans toute la ville depuis le séisme dévastateur du 12 janvier, l'accès à l'eau s'est lentement amélioré.Des camions-citernes font le tour des parcs où des survivants vivent serrés comme des sardines, et où des réservoirs souples et des citernes à eau comme celles de l'Asile ont été installés.</gams:textualContent><rel:isPartOf rdf:resource="https://gams.uni-graz.at/o:aaif.fraweb" /></aaif:Entry><aaif:Phrase rdf:about="https://gams.uni-graz.at/o:aaif.fraweb#En3938Ph1"><aaif:verb rdf:resource="https://gams.uni-graz.at/o:aaif.fraweb#En3938Ph1Ve1" /><aaif:adverb rdf:resource="https://gams.uni-graz.at/o:aaif.fraweb#En3938Ph1Ad1" /><aaif:text>des survivants vivent serrés comme des sardines</aaif:text><aaif:annoText>des survivants [v|vivent|vivre|is] [a|serrés|serré|aisnlnnn] comme des sardines</aaif:annoText></aaif:Phrase><aaif:Verb rdf:about="https://gams.uni-graz.at/o:aaif.fraweb#En3938Ph1Ve1"><aaif:text>vivent</aaif:text><aaif:lemma rdf:resource="https://gams.uni-graz.at/o:aaif.lemma#vivre" /><aaif:position rdf:datatype="http://www.w3.org/2001/XMLSchema#int">1</aaif:position><aaif:coordinated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:coordinated><aaif:partOfText rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</aaif:partOfText><aaif:syntacticConstruction rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Intransitive" /></aaif:Verb><aaif:Adverb rdf:about="https://gams.uni-graz.at/o:aaif.fraweb#En3938Ph1Ad1"><aaif:text>serrés</aaif:text><aaif:lemma rdf:resource="https://gams.uni-graz.at/o:aaif.lemma#serré" /><aaif:position rdf:datatype="http://www.w3.org/2001/XMLSchema#int">2</aaif:position><aaif:coordinated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:coordinated><aaif:morphosyntacticStructure rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Adjective" /><aaif:inflection rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#InaudibleInflection" /><aaif:attributionTarget rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Verb" /><aaif:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:modified><aaif:semanticClassification rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Location" /><aaif:reduplicated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:reduplicated><aaif:prepositionalPhrase rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:prepositionalPhrase></aaif:Adverb><aaif:Entry rdf:about="https://gams.uni-graz.at/o:aaif.fraweb#En3939"><aaif:phrase rdf:resource="https://gams.uni-graz.at/o:aaif.fraweb#En3939Ph1" /><aaif:source rdf:resource="https://gams.uni-graz.at/o:aaif.fraweb.bibl#DC3960" /><gams:textualContent>Les petits Franciliens vivent serrés  &lt;lb/&gt;Selon une étude de l'Insee rendue publique aujourd'hui, un quart des enfants vivent dans un logement surpeuplé en Ile-de-France.L'étude indique que les familles monoparentales sont plus touchées.</gams:textualContent><rel:isPartOf rdf:resource="https://gams.uni-graz.at/o:aaif.fraweb" /></aaif:Entry><aaif:Phrase rdf:about="https://gams.uni-graz.at/o:aaif.fraweb#En3939Ph1"><aaif:verb rdf:resource="https://gams.uni-graz.at/o:aaif.fraweb#En3939Ph1Ve1" /><aaif:adverb rdf:resource="https://gams.uni-graz.at/o:aaif.fraweb#En3939Ph1Ad1" /><aaif:text>Les petits Franciliens vivent serrés </aaif:text><aaif:annoText>Les petits Franciliens [v|vivent|vivre|is] [a|serrés|serré|aisnlnnn] </aaif:annoText></aaif:Phrase><aaif:Verb rdf:about="https://gams.uni-graz.at/o:aaif.fraweb#En3939Ph1Ve1"><aaif:text>vivent</aaif:text><aaif:lemma rdf:resource="https://gams.uni-graz.at/o:aaif.lemma#vivre" /><aaif:position rdf:datatype="http://www.w3.org/2001/XMLSchema#int">1</aaif:position><aaif:coordinated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:coordinated><aaif:partOfText rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</aaif:partOfText><aaif:syntacticConstruction rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Intransitive" /></aaif:Verb><aaif:Adverb rdf:about="https://gams.uni-graz.at/o:aaif.fraweb#En3939Ph1Ad1"><aaif:text>serrés</aaif:text><aaif:lemma rdf:resource="https://gams.uni-graz.at/o:aaif.lemma#serré" /><aaif:position rdf:datatype="http://www.w3.org/2001/XMLSchema#int">2</aaif:position><aaif:coordinated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:coordinated><aaif:morphosyntacticStructure rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Adjective" /><aaif:inflection rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#InaudibleInflection" /><aaif:attributionTarget rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Verb" /><aaif:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:modified><aaif:semanticClassification rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Location" /><aaif:reduplicated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:reduplicated><aaif:prepositionalPhrase rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:prepositionalPhrase></aaif:Adverb><aaif:Entry rdf:about="https://gams.uni-graz.at/o:aaif.fraweb#En3940"><aaif:phrase rdf:resource="https://gams.uni-graz.at/o:aaif.fraweb#En3940Ph1" /><aaif:source rdf:resource="https://gams.uni-graz.at/o:aaif.fraweb.bibl#DC3961" /><gams:textualContent>Les habitants vivent simple  .ils endurent mais ils sont heureus.Les habitants sont tres genereux.</gams:textualContent><rel:isPartOf rdf:resource="https://gams.uni-graz.at/o:aaif.fraweb" /></aaif:Entry><aaif:Phrase rdf:about="https://gams.uni-graz.at/o:aaif.fraweb#En3940Ph1"><aaif:verb rdf:resource="https://gams.uni-graz.at/o:aaif.fraweb#En3940Ph1Ve1" /><aaif:adverb rdf:resource="https://gams.uni-graz.at/o:aaif.fraweb#En3940Ph1Ad1" /><aaif:text>Les habitants vivent simple </aaif:text><aaif:annoText>Les habitants [v|vivent|vivre|is] [a|simple|simple|auvnmnnn] </aaif:annoText></aaif:Phrase><aaif:Verb rdf:about="https://gams.uni-graz.at/o:aaif.fraweb#En3940Ph1Ve1"><aaif:text>vivent</aaif:text><aaif:lemma rdf:resource="https://gams.uni-graz.at/o:aaif.lemma#vivre" /><aaif:position rdf:datatype="http://www.w3.org/2001/XMLSchema#int">1</aaif:position><aaif:coordinated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:coordinated><aaif:partOfText rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</aaif:partOfText><aaif:syntacticConstruction rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Intransitive" /></aaif:Verb><aaif:Adverb rdf:about="https://gams.uni-graz.at/o:aaif.fraweb#En3940Ph1Ad1"><aaif:text>simple</aaif:text><aaif:lemma rdf:resource="https://gams.uni-graz.at/o:aaif.lemma#simple" /><aaif:position rdf:datatype="http://www.w3.org/2001/XMLSchema#int">2</aaif:position><aaif:coordinated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:coordinated><aaif:morphosyntacticStructure rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Adjective" /><aaif:inflection rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Uninflected" /><aaif:attributionTarget rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Verb" /><aaif:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:modified><aaif:semanticClassification rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Manner" /><aaif:reduplicated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:reduplicated><aaif:prepositionalPhrase rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:prepositionalPhrase></aaif:Adverb><aaif:Entry rdf:about="https://gams.uni-graz.at/o:aaif.fraweb#En3941"><aaif:phrase rdf:resource="https://gams.uni-graz.at/o:aaif.fraweb#En3941Ph1" /><aaif:source rdf:resource="https://gams.uni-graz.at/o:aaif.fraweb.bibl#DC3962" /><gams:textualContent>bah ils vivent simple  je sais pas il y a de la baraka ds leur argent la voiture qu ils ont, est simple un scenic pr toute la clique mdr </gams:textualContent><rel:isPartOf rdf:resource="https://gams.uni-graz.at/o:aaif.fraweb" /></aaif:Entry><aaif:Phrase rdf:about="https://gams.uni-graz.at/o:aaif.fraweb#En3941Ph1"><aaif:verb rdf:resource="https://gams.uni-graz.at/o:aaif.fraweb#En3941Ph1Ve1" /><aaif:adverb rdf:resource="https://gams.uni-graz.at/o:aaif.fraweb#En3941Ph1Ad1" /><aaif:text>ils vivent simple </aaif:text><aaif:annoText>ils [v|vivent|vivre|is] [a|simple|simple|auvnmnnn] </aaif:annoText></aaif:Phrase><aaif:Verb rdf:about="https://gams.uni-graz.at/o:aaif.fraweb#En3941Ph1Ve1"><aaif:text>vivent</aaif:text><aaif:lemma rdf:resource="https://gams.uni-graz.at/o:aaif.lemma#vivre" /><aaif:position rdf:datatype="http://www.w3.org/2001/XMLSchema#int">1</aaif:position><aaif:coordinated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:coordinated><aaif:partOfText rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</aaif:partOfText><aaif:syntacticConstruction rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Intransitive" /></aaif:Verb><aaif:Adverb rdf:about="https://gams.uni-graz.at/o:aaif.fraweb#En3941Ph1Ad1"><aaif:text>simple</aaif:text><aaif:lemma rdf:resource="https://gams.uni-graz.at/o:aaif.lemma#simple" /><aaif:position rdf:datatype="http://www.w3.org/2001/XMLSchema#int">2</aaif:position><aaif:coordinated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:coordinated><aaif:morphosyntacticStructure rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Adjective" /><aaif:inflection rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Uninflected" /><aaif:attributionTarget rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Verb" /><aaif:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:modified><aaif:semanticClassification rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Manner" /><aaif:reduplicated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:reduplicated><aaif:prepositionalPhrase rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:prepositionalPhrase></aaif:Adverb><aaif:Entry rdf:about="https://gams.uni-graz.at/o:aaif.fraweb#En3942"><aaif:phrase rdf:resource="https://gams.uni-graz.at/o:aaif.fraweb#En3942Ph1" /><aaif:source rdf:resource="https://gams.uni-graz.at/o:aaif.fraweb.bibl#DC3963" /><gams:textualContent>Et puis tout à coup - de nouveau, et le vendredi soir, nous avons tous les week-end sur les familles privée capitaliste dispersion.Ils disent, regardez, les citoyens, les camarades, en tant que peuple américains vivent simples  , grâce aux soins infatigable de partir du gouvernement et diverses institutions démocratiques.</gams:textualContent><rel:isPartOf rdf:resource="https://gams.uni-graz.at/o:aaif.fraweb" /></aaif:Entry><aaif:Phrase rdf:about="https://gams.uni-graz.at/o:aaif.fraweb#En3942Ph1"><aaif:verb rdf:resource="https://gams.uni-graz.at/o:aaif.fraweb#En3942Ph1Ve1" /><aaif:adverb rdf:resource="https://gams.uni-graz.at/o:aaif.fraweb#En3942Ph1Ad1" /><aaif:text>américains vivent simples </aaif:text><aaif:annoText>américains [v|vivent|vivre|is] [a|simples|simple|aivnmnnn] </aaif:annoText></aaif:Phrase><aaif:Verb rdf:about="https://gams.uni-graz.at/o:aaif.fraweb#En3942Ph1Ve1"><aaif:text>vivent</aaif:text><aaif:lemma rdf:resource="https://gams.uni-graz.at/o:aaif.lemma#vivre" /><aaif:position rdf:datatype="http://www.w3.org/2001/XMLSchema#int">1</aaif:position><aaif:coordinated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:coordinated><aaif:partOfText rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</aaif:partOfText><aaif:syntacticConstruction rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Intransitive" /></aaif:Verb><aaif:Adverb rdf:about="https://gams.uni-graz.at/o:aaif.fraweb#En3942Ph1Ad1"><aaif:text>simples</aaif:text><aaif:lemma rdf:resource="https://gams.uni-graz.at/o:aaif.lemma#simple" /><aaif:position rdf:datatype="http://www.w3.org/2001/XMLSchema#int">2</aaif:position><aaif:coordinated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:coordinated><aaif:morphosyntacticStructure rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Adjective" /><aaif:inflection rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#InaudibleInflection" /><aaif:attributionTarget rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Verb" /><aaif:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:modified><aaif:semanticClassification rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Manner" /><aaif:reduplicated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:reduplicated><aaif:prepositionalPhrase rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:prepositionalPhrase></aaif:Adverb><aaif:Entry rdf:about="https://gams.uni-graz.at/o:aaif.fraweb#En3943"><aaif:phrase rdf:resource="https://gams.uni-graz.at/o:aaif.fraweb#En3943Ph1" /><aaif:source rdf:resource="https://gams.uni-graz.at/o:aaif.fraweb.bibl#DC3964" /><gams:textualContent>« Les riches qui vivent simples  … j’adore, dit l’un des internautes qui ajoute… les classes pauvre et moyennes devraient apprendre d’eux… aimer la famille Obama ».</gams:textualContent><rel:isPartOf rdf:resource="https://gams.uni-graz.at/o:aaif.fraweb" /></aaif:Entry><aaif:Phrase rdf:about="https://gams.uni-graz.at/o:aaif.fraweb#En3943Ph1"><aaif:verb rdf:resource="https://gams.uni-graz.at/o:aaif.fraweb#En3943Ph1Ve1" /><aaif:adverb rdf:resource="https://gams.uni-graz.at/o:aaif.fraweb#En3943Ph1Ad1" /><aaif:text>Les riches qui vivent simples </aaif:text><aaif:annoText>Les riches qui [v|vivent|vivre|is] [a|simples|simple|aivnmnnn] </aaif:annoText></aaif:Phrase><aaif:Verb rdf:about="https://gams.uni-graz.at/o:aaif.fraweb#En3943Ph1Ve1"><aaif:text>vivent</aaif:text><aaif:lemma rdf:resource="https://gams.uni-graz.at/o:aaif.lemma#vivre" /><aaif:position rdf:datatype="http://www.w3.org/2001/XMLSchema#int">1</aaif:position><aaif:coordinated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:coordinated><aaif:partOfText rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</aaif:partOfText><aaif:syntacticConstruction rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Intransitive" /></aaif:Verb><aaif:Adverb rdf:about="https://gams.uni-graz.at/o:aaif.fraweb#En3943Ph1Ad1"><aaif:text>simples</aaif:text><aaif:lemma rdf:resource="https://gams.uni-graz.at/o:aaif.lemma#simple" /><aaif:position rdf:datatype="http://www.w3.org/2001/XMLSchema#int">2</aaif:position><aaif:coordinated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:coordinated><aaif:morphosyntacticStructure rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Adjective" /><aaif:inflection rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#InaudibleInflection" /><aaif:attributionTarget rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Verb" /><aaif:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:modified><aaif:semanticClassification rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Manner" /><aaif:reduplicated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:reduplicated><aaif:prepositionalPhrase rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:prepositionalPhrase></aaif:Adverb><aaif:Entry rdf:about="https://gams.uni-graz.at/o:aaif.fraweb#En3944"><aaif:phrase rdf:resource="https://gams.uni-graz.at/o:aaif.fraweb#En3944Ph1" /><aaif:source rdf:resource="https://gams.uni-graz.at/o:aaif.fraweb.bibl#DC3965" /><gams:textualContent>La Salsa Cubaine est originaire des rues de Cuba.Là-bas, la danse est un art de vivre.Une façon de vivre souriant et heureux  .</gams:textualContent><rel:isPartOf rdf:resource="https://gams.uni-graz.at/o:aaif.fraweb" /></aaif:Entry><aaif:Phrase rdf:about="https://gams.uni-graz.at/o:aaif.fraweb#En3944Ph1"><aaif:verb rdf:resource="https://gams.uni-graz.at/o:aaif.fraweb#En3944Ph1Ve1" /><aaif:adverb rdf:resource="https://gams.uni-graz.at/o:aaif.fraweb#En3944Ph1Ad1" /><aaif:adverb rdf:resource="https://gams.uni-graz.at/o:aaif.fraweb#En3944Ph1Ad2" /><aaif:text>Une façon de vivre souriant et heureux </aaif:text><aaif:annoText>Une façon de [v|vivre|vivre|is] [a|souriant|souriant|ausnmnnC] et [a|heureux|heureux|ausnmnnC] </aaif:annoText></aaif:Phrase><aaif:Verb rdf:about="https://gams.uni-graz.at/o:aaif.fraweb#En3944Ph1Ve1"><aaif:text>vivre</aaif:text><aaif:lemma rdf:resource="https://gams.uni-graz.at/o:aaif.lemma#vivre" /><aaif:position rdf:datatype="http://www.w3.org/2001/XMLSchema#int">1</aaif:position><aaif:coordinated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:coordinated><aaif:partOfText rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</aaif:partOfText><aaif:syntacticConstruction rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Intransitive" /></aaif:Verb><aaif:Adverb rdf:about="https://gams.uni-graz.at/o:aaif.fraweb#En3944Ph1Ad1"><aaif:text>souriant</aaif:text><aaif:lemma rdf:resource="https://gams.uni-graz.at/o:aaif.lemma#souriant" /><aaif:position rdf:datatype="http://www.w3.org/2001/XMLSchema#int">2</aaif:position><aaif:coordinated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</aaif:coordinated><aaif:morphosyntacticStructure rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Adjective" /><aaif:inflection rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Uninflected" /><aaif:attributionTarget rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Verb" /><aaif:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:modified><aaif:semanticClassification rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Manner" /><aaif:reduplicated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:reduplicated><aaif:prepositionalPhrase rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:prepositionalPhrase></aaif:Adverb><aaif:Adverb rdf:about="https://gams.uni-graz.at/o:aaif.fraweb#En3944Ph1Ad2"><aaif:text>heureux</aaif:text><aaif:lemma rdf:resource="https://gams.uni-graz.at/o:aaif.lemma#heureux" /><aaif:position rdf:datatype="http://www.w3.org/2001/XMLSchema#int">3</aaif:position><aaif:coordinated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</aaif:coordinated><aaif:morphosyntacticStructure rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Adjective" /><aaif:inflection rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Uninflected" /><aaif:attributionTarget rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Verb" /><aaif:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:modified><aaif:semanticClassification rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Manner" /><aaif:reduplicated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:reduplicated><aaif:prepositionalPhrase rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:prepositionalPhrase></aaif:Adverb><aaif:Entry rdf:about="https://gams.uni-graz.at/o:aaif.fraweb#En3945"><aaif:phrase rdf:resource="https://gams.uni-graz.at/o:aaif.fraweb#En3945Ph1" /><aaif:source rdf:resource="https://gams.uni-graz.at/o:aaif.fraweb.bibl#DC3966" /><gams:textualContent>D’autres, vivant en communauté sont protégés sous un dôme de Lumière.Ni le ciel obscur, ni le gel ne peuvent les atteindre.Ils sont protégés et continuent à vivre souriant  dans leur foi.</gams:textualContent><rel:isPartOf rdf:resource="https://gams.uni-graz.at/o:aaif.fraweb" /></aaif:Entry><aaif:Phrase rdf:about="https://gams.uni-graz.at/o:aaif.fraweb#En3945Ph1"><aaif:verb rdf:resource="https://gams.uni-graz.at/o:aaif.fraweb#En3945Ph1Ve1" /><aaif:adverb rdf:resource="https://gams.uni-graz.at/o:aaif.fraweb#En3945Ph1Ad1" /><aaif:text>Ils sont protégés et continuent à vivre souriant </aaif:text><aaif:annoText>Ils sont protégés et continuent à [v|vivre|vivre|is] [a|souriant|souriant|ausnmnnn] </aaif:annoText></aaif:Phrase><aaif:Verb rdf:about="https://gams.uni-graz.at/o:aaif.fraweb#En3945Ph1Ve1"><aaif:text>vivre</aaif:text><aaif:lemma rdf:resource="https://gams.uni-graz.at/o:aaif.lemma#vivre" /><aaif:position rdf:datatype="http://www.w3.org/2001/XMLSchema#int">1</aaif:position><aaif:coordinated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:coordinated><aaif:partOfText rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</aaif:partOfText><aaif:syntacticConstruction rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Intransitive" /></aaif:Verb><aaif:Adverb rdf:about="https://gams.uni-graz.at/o:aaif.fraweb#En3945Ph1Ad1"><aaif:text>souriant</aaif:text><aaif:lemma rdf:resource="https://gams.uni-graz.at/o:aaif.lemma#souriant" /><aaif:position rdf:datatype="http://www.w3.org/2001/XMLSchema#int">2</aaif:position><aaif:coordinated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:coordinated><aaif:morphosyntacticStructure rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Adjective" /><aaif:inflection rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Uninflected" /><aaif:attributionTarget rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Verb" /><aaif:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:modified><aaif:semanticClassification rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Manner" /><aaif:reduplicated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:reduplicated><aaif:prepositionalPhrase rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:prepositionalPhrase></aaif:Adverb><aaif:Entry rdf:about="https://gams.uni-graz.at/o:aaif.fraweb#En3946"><aaif:phrase rdf:resource="https://gams.uni-graz.at/o:aaif.fraweb#En3946Ph1" /><aaif:source rdf:resource="https://gams.uni-graz.at/o:aaif.fraweb.bibl#DC3967" /><gams:textualContent>Ces nids sont normalement trouvés sur un rebord couvert, qui est supposé à imiter une falaise que les pigeons vivent sûrs en Europe.Aussi, (C'est rare) on peut les trouver dans les arbres.</gams:textualContent><rel:isPartOf rdf:resource="https://gams.uni-graz.at/o:aaif.fraweb" /></aaif:Entry><aaif:Phrase rdf:about="https://gams.uni-graz.at/o:aaif.fraweb#En3946Ph1"><aaif:verb rdf:resource="https://gams.uni-graz.at/o:aaif.fraweb#En3946Ph1Ve1" /><aaif:adverb rdf:resource="https://gams.uni-graz.at/o:aaif.fraweb#En3946Ph1Ad1" /><aaif:text>les pigeons vivent sûrs en Europe</aaif:text><aaif:annoText>les pigeons [v|vivent|vivre|is] [a|sûrs|sûr|aisnmnnn] en Europe</aaif:annoText></aaif:Phrase><aaif:Verb rdf:about="https://gams.uni-graz.at/o:aaif.fraweb#En3946Ph1Ve1"><aaif:text>vivent</aaif:text><aaif:lemma rdf:resource="https://gams.uni-graz.at/o:aaif.lemma#vivre" /><aaif:position rdf:datatype="http://www.w3.org/2001/XMLSchema#int">1</aaif:position><aaif:coordinated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:coordinated><aaif:partOfText rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</aaif:partOfText><aaif:syntacticConstruction rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Intransitive" /></aaif:Verb><aaif:Adverb rdf:about="https://gams.uni-graz.at/o:aaif.fraweb#En3946Ph1Ad1"><aaif:text>sûrs</aaif:text><aaif:lemma rdf:resource="https://gams.uni-graz.at/o:aaif.lemma#sûr" /><aaif:position rdf:datatype="http://www.w3.org/2001/XMLSchema#int">2</aaif:position><aaif:coordinated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:coordinated><aaif:morphosyntacticStructure rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Adjective" /><aaif:inflection rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#InaudibleInflection" /><aaif:attributionTarget rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Verb" /><aaif:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:modified><aaif:semanticClassification rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Manner" /><aaif:reduplicated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:reduplicated><aaif:prepositionalPhrase rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:prepositionalPhrase></aaif:Adverb><aaif:Entry rdf:about="https://gams.uni-graz.at/o:aaif.fraweb#En3947"><aaif:phrase rdf:resource="https://gams.uni-graz.at/o:aaif.fraweb#En3947Ph1" /><aaif:source rdf:resource="https://gams.uni-graz.at/o:aaif.fraweb.bibl#DC3968" /><gams:textualContent>Les Nords-Coréens vivent tranquille et en paix , je n'écoute pas les médias occidentaux personnellement qui veulent rattacher ce pays aux "joies" du consumérisme de masse et à la décadence des mœurs </gams:textualContent><rel:isPartOf rdf:resource="https://gams.uni-graz.at/o:aaif.fraweb" /></aaif:Entry><aaif:Phrase rdf:about="https://gams.uni-graz.at/o:aaif.fraweb#En3947Ph1"><aaif:verb rdf:resource="https://gams.uni-graz.at/o:aaif.fraweb#En3947Ph1Ve1" /><aaif:adverb rdf:resource="https://gams.uni-graz.at/o:aaif.fraweb#En3947Ph1Ad1" /><aaif:text>Les Nords-Coréens vivent tranquille et en paix</aaif:text><aaif:annoText>Les Nords-Coréens [v|vivent|vivre|is] [a|tranquille|tranquille|ausnmnnC] et en paix</aaif:annoText></aaif:Phrase><aaif:Verb rdf:about="https://gams.uni-graz.at/o:aaif.fraweb#En3947Ph1Ve1"><aaif:text>vivent</aaif:text><aaif:lemma rdf:resource="https://gams.uni-graz.at/o:aaif.lemma#vivre" /><aaif:position rdf:datatype="http://www.w3.org/2001/XMLSchema#int">1</aaif:position><aaif:coordinated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:coordinated><aaif:partOfText rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</aaif:partOfText><aaif:syntacticConstruction rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Intransitive" /></aaif:Verb><aaif:Adverb rdf:about="https://gams.uni-graz.at/o:aaif.fraweb#En3947Ph1Ad1"><aaif:text>tranquille</aaif:text><aaif:lemma rdf:resource="https://gams.uni-graz.at/o:aaif.lemma#tranquille" /><aaif:position rdf:datatype="http://www.w3.org/2001/XMLSchema#int">2</aaif:position><aaif:coordinated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</aaif:coordinated><aaif:morphosyntacticStructure rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Adjective" /><aaif:inflection rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Uninflected" /><aaif:attributionTarget rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Verb" /><aaif:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:modified><aaif:semanticClassification rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Manner" /><aaif:reduplicated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:reduplicated><aaif:prepositionalPhrase rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:prepositionalPhrase></aaif:Adverb><aaif:Entry rdf:about="https://gams.uni-graz.at/o:aaif.fraweb#En3948"><aaif:phrase rdf:resource="https://gams.uni-graz.at/o:aaif.fraweb#En3948Ph1" /><aaif:source rdf:resource="https://gams.uni-graz.at/o:aaif.fraweb.bibl#DC3969" /><gams:textualContent>il paraitrait qu'il y aurait en France plein de petits Mérat qui vivent tranquille  et trafiquent en toute impunité.Marseille ville tranquille, la Corse île tranquille.Les banlieues zone de vie tranquille.</gams:textualContent><rel:isPartOf rdf:resource="https://gams.uni-graz.at/o:aaif.fraweb" /></aaif:Entry><aaif:Phrase rdf:about="https://gams.uni-graz.at/o:aaif.fraweb#En3948Ph1"><aaif:verb rdf:resource="https://gams.uni-graz.at/o:aaif.fraweb#En3948Ph1Ve1" /><aaif:adverb rdf:resource="https://gams.uni-graz.at/o:aaif.fraweb#En3948Ph1Ad1" /><aaif:text>de petits Mérat qui vivent tranquille </aaif:text><aaif:annoText>de petits Mérat qui [v|vivent|vivre|is] [a|tranquille|tranquille|ausnmnnn] </aaif:annoText></aaif:Phrase><aaif:Verb rdf:about="https://gams.uni-graz.at/o:aaif.fraweb#En3948Ph1Ve1"><aaif:text>vivent</aaif:text><aaif:lemma rdf:resource="https://gams.uni-graz.at/o:aaif.lemma#vivre" /><aaif:position rdf:datatype="http://www.w3.org/2001/XMLSchema#int">1</aaif:position><aaif:coordinated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:coordinated><aaif:partOfText rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</aaif:partOfText><aaif:syntacticConstruction rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Intransitive" /></aaif:Verb><aaif:Adverb rdf:about="https://gams.uni-graz.at/o:aaif.fraweb#En3948Ph1Ad1"><aaif:text>tranquille</aaif:text><aaif:lemma rdf:resource="https://gams.uni-graz.at/o:aaif.lemma#tranquille" /><aaif:position rdf:datatype="http://www.w3.org/2001/XMLSchema#int">2</aaif:position><aaif:coordinated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:coordinated><aaif:morphosyntacticStructure rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Adjective" /><aaif:inflection rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Uninflected" /><aaif:attributionTarget rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Verb" /><aaif:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:modified><aaif:semanticClassification rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Manner" /><aaif:reduplicated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:reduplicated><aaif:prepositionalPhrase rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:prepositionalPhrase></aaif:Adverb><aaif:Entry rdf:about="https://gams.uni-graz.at/o:aaif.fraweb#En3949"><aaif:phrase rdf:resource="https://gams.uni-graz.at/o:aaif.fraweb#En3949Ph1" /><aaif:source rdf:resource="https://gams.uni-graz.at/o:aaif.fraweb.bibl#DC3970" /><gams:textualContent>En 2014, beaucoup de gens vivent tranquilles en France.Ils travaillent, ont un salaire, partent en vacances, ont des loisirs...</gams:textualContent><rel:isPartOf rdf:resource="https://gams.uni-graz.at/o:aaif.fraweb" /></aaif:Entry><aaif:Phrase rdf:about="https://gams.uni-graz.at/o:aaif.fraweb#En3949Ph1"><aaif:verb rdf:resource="https://gams.uni-graz.at/o:aaif.fraweb#En3949Ph1Ve1" /><aaif:adverb rdf:resource="https://gams.uni-graz.at/o:aaif.fraweb#En3949Ph1Ad1" /><aaif:text>beaucoup de gens vivent tranquilles en France</aaif:text><aaif:annoText>beaucoup de gens [v|vivent|vivre|is] [a|tranquilles|tranquille|aisnmnnn] en France</aaif:annoText></aaif:Phrase><aaif:Verb rdf:about="https://gams.uni-graz.at/o:aaif.fraweb#En3949Ph1Ve1"><aaif:text>vivent</aaif:text><aaif:lemma rdf:resource="https://gams.uni-graz.at/o:aaif.lemma#vivre" /><aaif:position rdf:datatype="http://www.w3.org/2001/XMLSchema#int">1</aaif:position><aaif:coordinated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:coordinated><aaif:partOfText rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</aaif:partOfText><aaif:syntacticConstruction rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Intransitive" /></aaif:Verb><aaif:Adverb rdf:about="https://gams.uni-graz.at/o:aaif.fraweb#En3949Ph1Ad1"><aaif:text>tranquilles</aaif:text><aaif:lemma rdf:resource="https://gams.uni-graz.at/o:aaif.lemma#tranquille" /><aaif:position rdf:datatype="http://www.w3.org/2001/XMLSchema#int">2</aaif:position><aaif:coordinated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:coordinated><aaif:morphosyntacticStructure rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Adjective" /><aaif:inflection rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#InaudibleInflection" /><aaif:attributionTarget rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Verb" /><aaif:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:modified><aaif:semanticClassification rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Manner" /><aaif:reduplicated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:reduplicated><aaif:prepositionalPhrase rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:prepositionalPhrase></aaif:Adverb><aaif:Entry rdf:about="https://gams.uni-graz.at/o:aaif.fraweb#En3950"><aaif:phrase rdf:resource="https://gams.uni-graz.at/o:aaif.fraweb#En3950Ph1" /><aaif:source rdf:resource="https://gams.uni-graz.at/o:aaif.fraweb.bibl#DC3971" /><gams:textualContent>Petit résumé rapide de l'histoire: Tout va pour le mieux pour nos jouets préférés qui vivent tranquilles  dans leur nouveau foyer, Woody et Buzz ne sont plus rivaux mais d'inséparables partenaires, un beau jour alors que Woody devait accompagner Andy en camps de vacance, l'un de ses bras se déchire au cours d'un "accident de jeux" ainsi il doit faire une croix sur ses vacance.</gams:textualContent><rel:isPartOf rdf:resource="https://gams.uni-graz.at/o:aaif.fraweb" /></aaif:Entry><aaif:Phrase rdf:about="https://gams.uni-graz.at/o:aaif.fraweb#En3950Ph1"><aaif:verb rdf:resource="https://gams.uni-graz.at/o:aaif.fraweb#En3950Ph1Ve1" /><aaif:adverb rdf:resource="https://gams.uni-graz.at/o:aaif.fraweb#En3950Ph1Ad1" /><aaif:text>qui vivent tranquilles </aaif:text><aaif:annoText>qui [v|vivent|vivre|is] [a|tranquilles|tranquille|aisnmnnn] </aaif:annoText></aaif:Phrase><aaif:Verb rdf:about="https://gams.uni-graz.at/o:aaif.fraweb#En3950Ph1Ve1"><aaif:text>vivent</aaif:text><aaif:lemma rdf:resource="https://gams.uni-graz.at/o:aaif.lemma#vivre" /><aaif:position rdf:datatype="http://www.w3.org/2001/XMLSchema#int">1</aaif:position><aaif:coordinated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:coordinated><aaif:partOfText rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</aaif:partOfText><aaif:syntacticConstruction rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Intransitive" /></aaif:Verb><aaif:Adverb rdf:about="https://gams.uni-graz.at/o:aaif.fraweb#En3950Ph1Ad1"><aaif:text>tranquilles</aaif:text><aaif:lemma rdf:resource="https://gams.uni-graz.at/o:aaif.lemma#tranquille" /><aaif:position rdf:datatype="http://www.w3.org/2001/XMLSchema#int">2</aaif:position><aaif:coordinated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:coordinated><aaif:morphosyntacticStructure rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Adjective" /><aaif:inflection rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#InaudibleInflection" /><aaif:attributionTarget rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Verb" /><aaif:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:modified><aaif:semanticClassification rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Manner" /><aaif:reduplicated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:reduplicated><aaif:prepositionalPhrase rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:prepositionalPhrase></aaif:Adverb><aaif:Entry rdf:about="https://gams.uni-graz.at/o:aaif.fraweb#En3951"><aaif:phrase rdf:resource="https://gams.uni-graz.at/o:aaif.fraweb#En3951Ph1" /><aaif:source rdf:resource="https://gams.uni-graz.at/o:aaif.fraweb.bibl#DC3972" /><gams:textualContent>Du coup jai crisé, vraiment fait une crise en plus enceinte...mais ça me fait tellement de mal, d'avoir un mari, sans en avoir un vrai, de se sentir seule, de vivre triste  ...</gams:textualContent><rel:isPartOf rdf:resource="https://gams.uni-graz.at/o:aaif.fraweb" /></aaif:Entry><aaif:Phrase rdf:about="https://gams.uni-graz.at/o:aaif.fraweb#En3951Ph1"><aaif:verb rdf:resource="https://gams.uni-graz.at/o:aaif.fraweb#En3951Ph1Ve1" /><aaif:adverb rdf:resource="https://gams.uni-graz.at/o:aaif.fraweb#En3951Ph1Ad1" /><aaif:text>de vivre triste </aaif:text><aaif:annoText>de [v|vivre|vivre|is] [a|triste|triste|ausnmnnn] </aaif:annoText></aaif:Phrase><aaif:Verb rdf:about="https://gams.uni-graz.at/o:aaif.fraweb#En3951Ph1Ve1"><aaif:text>vivre</aaif:text><aaif:lemma rdf:resource="https://gams.uni-graz.at/o:aaif.lemma#vivre" /><aaif:position rdf:datatype="http://www.w3.org/2001/XMLSchema#int">1</aaif:position><aaif:coordinated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:coordinated><aaif:partOfText rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</aaif:partOfText><aaif:syntacticConstruction rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Intransitive" /></aaif:Verb><aaif:Adverb rdf:about="https://gams.uni-graz.at/o:aaif.fraweb#En3951Ph1Ad1"><aaif:text>triste</aaif:text><aaif:lemma rdf:resource="https://gams.uni-graz.at/o:aaif.lemma#triste" /><aaif:position rdf:datatype="http://www.w3.org/2001/XMLSchema#int">2</aaif:position><aaif:coordinated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:coordinated><aaif:morphosyntacticStructure rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Adjective" /><aaif:inflection rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Uninflected" /><aaif:attributionTarget rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Verb" /><aaif:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:modified><aaif:semanticClassification rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Manner" /><aaif:reduplicated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:reduplicated><aaif:prepositionalPhrase rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:prepositionalPhrase></aaif:Adverb><aaif:Entry rdf:about="https://gams.uni-graz.at/o:aaif.fraweb#En3952"><aaif:phrase rdf:resource="https://gams.uni-graz.at/o:aaif.fraweb#En3952Ph1" /><aaif:source rdf:resource="https://gams.uni-graz.at/o:aaif.fraweb.bibl#DC3973" /><gams:textualContent>Johnny Depp et Vanessa Paradis " vivent  tristes et séparés  ": Le couple qu'ils formaient depuis...</gams:textualContent><rel:isPartOf rdf:resource="https://gams.uni-graz.at/o:aaif.fraweb" /></aaif:Entry><aaif:Phrase rdf:about="https://gams.uni-graz.at/o:aaif.fraweb#En3952Ph1"><aaif:verb rdf:resource="https://gams.uni-graz.at/o:aaif.fraweb#En3952Ph1Ve1" /><aaif:adverb rdf:resource="https://gams.uni-graz.at/o:aaif.fraweb#En3952Ph1Ad1" /><aaif:adverb rdf:resource="https://gams.uni-graz.at/o:aaif.fraweb