coordinated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:coordinated><aaif:morphosyntacticStructure rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Adjective" /><aaif:inflection rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Uninflected" /><aaif:attributionTarget rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Verb" /><aaif:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:modified><aaif:semanticClassification rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Manner" /><aaif:reduplicated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:reduplicated><aaif:prepositionalPhrase rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:prepositionalPhrase></aaif:Adverb><aaif:Adverb rdf:about="https://gams.uni-graz.at/o:aaif.fraweb#En2142Ph1Ad2"><aaif:text>doux</aaif:text><aaif:lemma rdf:resource="https://gams.uni-graz.at/o:aaif.lemma#doux" /><aaif:position rdf:datatype="http://www.w3.org/2001/XMLSchema#int">4</aaif:position><aaif:coordinated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:coordinated><aaif:morphosyntacticStructure rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Adjective" /><aaif:inflection rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Uninflected" /><aaif:attributionTarget rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Verb" /><aaif:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:modified><aaif:semanticClassification rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Manner" /><aaif:reduplicated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:reduplicated><aaif:prepositionalPhrase rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:prepositionalPhrase></aaif:Adverb><aaif:Entry rdf:about="https://gams.uni-graz.at/o:aaif.fraweb#En2143"><aaif:phrase rdf:resource="https://gams.uni-graz.at/o:aaif.fraweb#En2143Ph1" /><aaif:phrase rdf:resource="https://gams.uni-graz.at/o:aaif.fraweb#En2143Ph2" /><aaif:source rdf:resource="https://gams.uni-graz.at/o:aaif.fraweb.bibl#DC2151" /><gams:textualContent>Les filles?Aimez vous parler cru  pendant l’amour.Si oui, qu'est ce que vous aimez dire?Sinon est ce qu'il y a parmi vous des filles qui aimeraient parler cru mais qui n'ose pas...</gams:textualContent><rel:isPartOf rdf:resource="https://gams.uni-graz.at/o:aaif.fraweb" /></aaif:Entry><aaif:Phrase rdf:about="https://gams.uni-graz.at/o:aaif.fraweb#En2143Ph1"><aaif:verb rdf:resource="https://gams.uni-graz.at/o:aaif.fraweb#En2143Ph1Ve1" /><aaif:adverb rdf:resource="https://gams.uni-graz.at/o:aaif.fraweb#En2143Ph1Ad1" /><aaif:text>Aimez vous parler cru </aaif:text><aaif:annoText>Aimez vous [v|parler|parler|is] [a|cru|cru|auvnmnnn] </aaif:annoText></aaif:Phrase><aaif:Verb rdf:about="https://gams.uni-graz.at/o:aaif.fraweb#En2143Ph1Ve1"><aaif:text>parler</aaif:text><aaif:lemma rdf:resource="https://gams.uni-graz.at/o:aaif.lemma#parler" /><aaif:position rdf:datatype="http://www.w3.org/2001/XMLSchema#int">1</aaif:position><aaif:coordinated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:coordinated><aaif:partOfText rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</aaif:partOfText><aaif:syntacticConstruction rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Intransitive" /></aaif:Verb><aaif:Adverb rdf:about="https://gams.uni-graz.at/o:aaif.fraweb#En2143Ph1Ad1"><aaif:text>cru</aaif:text><aaif:lemma rdf:resource="https://gams.uni-graz.at/o:aaif.lemma#cru" /><aaif:position rdf:datatype="http://www.w3.org/2001/XMLSchema#int">2</aaif:position><aaif:coordinated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:coordinated><aaif:morphosyntacticStructure rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Adjective" /><aaif:inflection rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Uninflected" /><aaif:attributionTarget rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Verb" /><aaif:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:modified><aaif:semanticClassification rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Manner" /><aaif:reduplicated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:reduplicated><aaif:prepositionalPhrase rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:prepositionalPhrase></aaif:Adverb><aaif:Phrase rdf:about="https://gams.uni-graz.at/o:aaif.fraweb#En2143Ph2"><aaif:verb rdf:resource="https://gams.uni-graz.at/o:aaif.fraweb#En2143Ph2Ve1" /><aaif:adverb rdf:resource="https://gams.uni-graz.at/o:aaif.fraweb#En2143Ph2Ad1" /><aaif:text>des filles qui aimeraient parler cru mais qui n'ose pas</aaif:text><aaif:annoText>des filles qui aimeraient [v|parler|parler|is] [a|cru|cru|auvnmnnn] mais qui n'ose pas</aaif:annoText></aaif:Phrase><aaif:Verb rdf:about="https://gams.uni-graz.at/o:aaif.fraweb#En2143Ph2Ve1"><aaif:text>parler</aaif:text><aaif:lemma rdf:resource="https://gams.uni-graz.at/o:aaif.lemma#parler" /><aaif:position rdf:datatype="http://www.w3.org/2001/XMLSchema#int">1</aaif:position><aaif:coordinated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:coordinated><aaif:partOfText rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</aaif:partOfText><aaif:syntacticConstruction rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Intransitive" /></aaif:Verb><aaif:Adverb rdf:about="https://gams.uni-graz.at/o:aaif.fraweb#En2143Ph2Ad1"><aaif:text>cru</aaif:text><aaif:lemma rdf:resource="https://gams.uni-graz.at/o:aaif.lemma#cru" /><aaif:position rdf:datatype="http://www.w3.org/2001/XMLSchema#int">2</aaif:position><aaif:coordinated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:coordinated><aaif:morphosyntacticStructure rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Adjective" /><aaif:inflection rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Uninflected" /><aaif:attributionTarget rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Verb" /><aaif:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:modified><aaif:semanticClassification rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Manner" /><aaif:reduplicated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:reduplicated><aaif:prepositionalPhrase rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:prepositionalPhrase></aaif:Adverb><aaif:Entry rdf:about="https://gams.uni-graz.at/o:aaif.fraweb#En2144"><aaif:phrase rdf:resource="https://gams.uni-graz.at/o:aaif.fraweb#En2144Ph1" /><aaif:source rdf:resource="https://gams.uni-graz.at/o:aaif.fraweb.bibl#DC2152" /><gams:textualContent>"Je parle cru et dru  .Je ne tourne pas deux heures autour du pot, a lancé, dimanche 24 mars, Jean-Luc Mélenchon, au cours d'un meeting qui a clos le congrès du Parti de gauche à Bordeaux.</gams:textualContent><rel:isPartOf rdf:resource="https://gams.uni-graz.at/o:aaif.fraweb" /></aaif:Entry><aaif:Phrase rdf:about="https://gams.uni-graz.at/o:aaif.fraweb#En2144Ph1"><aaif:verb rdf:resource="https://gams.uni-graz.at/o:aaif.fraweb#En2144Ph1Ve1" /><aaif:adverb rdf:resource="https://gams.uni-graz.at/o:aaif.fraweb#En2144Ph1Ad1" /><aaif:adverb rdf:resource="https://gams.uni-graz.at/o:aaif.fraweb#En2144Ph1Ad2" /><aaif:text>Je parle cru et dru </aaif:text><aaif:annoText>Je [v|parle|parler|is] [a|cru|cru|auvnmnnC] et [a|dru|dru|auvnmnnC] </aaif:annoText></aaif:Phrase><aaif:Verb rdf:about="https://gams.uni-graz.at/o:aaif.fraweb#En2144Ph1Ve1"><aaif:text>parle</aaif:text><aaif:lemma rdf:resource="https://gams.uni-graz.at/o:aaif.lemma#parler" /><aaif:position rdf:datatype="http://www.w3.org/2001/XMLSchema#int">1</aaif:position><aaif:coordinated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:coordinated><aaif:partOfText rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</aaif:partOfText><aaif:syntacticConstruction rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Intransitive" /></aaif:Verb><aaif:Adverb rdf:about="https://gams.uni-graz.at/o:aaif.fraweb#En2144Ph1Ad1"><aaif:text>cru</aaif:text><aaif:lemma rdf:resource="https://gams.uni-graz.at/o:aaif.lemma#cru" /><aaif:position rdf:datatype="http://www.w3.org/2001/XMLSchema#int">2</aaif:position><aaif:coordinated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</aaif:coordinated><aaif:morphosyntacticStructure rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Adjective" /><aaif:inflection rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Uninflected" /><aaif:attributionTarget rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Verb" /><aaif:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:modified><aaif:semanticClassification rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Manner" /><aaif:reduplicated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:reduplicated><aaif:prepositionalPhrase rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:prepositionalPhrase></aaif:Adverb><aaif:Adverb rdf:about="https://gams.uni-graz.at/o:aaif.fraweb#En2144Ph1Ad2"><aaif:text>dru</aaif:text><aaif:lemma rdf:resource="https://gams.uni-graz.at/o:aaif.lemma#dru" /><aaif:position rdf:datatype="http://www.w3.org/2001/XMLSchema#int">3</aaif:position><aaif:coordinated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</aaif:coordinated><aaif:morphosyntacticStructure rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Adjective" /><aaif:inflection rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Uninflected" /><aaif:attributionTarget rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Verb" /><aaif:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:modified><aaif:semanticClassification rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Manner" /><aaif:reduplicated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:reduplicated><aaif:prepositionalPhrase rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:prepositionalPhrase></aaif:Adverb><aaif:Entry rdf:about="https://gams.uni-graz.at/o:aaif.fraweb#En2145"><aaif:phrase rdf:resource="https://gams.uni-graz.at/o:aaif.fraweb#En2145Ph1" /><aaif:source rdf:resource="https://gams.uni-graz.at/o:aaif.fraweb.bibl#DC2153" /><gams:textualContent>Le bruxellois auteur-compositeur et pianiste caresse de sa voix des mélodies pop.La pilule passe mieux, les mots sont bien sentis, sans fioritures, qu'ils nous parlent doux ou dur  .</gams:textualContent><rel:isPartOf rdf:resource="https://gams.uni-graz.at/o:aaif.fraweb" /></aaif:Entry><aaif:Phrase rdf:about="https://gams.uni-graz.at/o:aaif.fraweb#En2145Ph1"><aaif:verb rdf:resource="https://gams.uni-graz.at/o:aaif.fraweb#En2145Ph1Ve1" /><aaif:adverb rdf:resource="https://gams.uni-graz.at/o:aaif.fraweb#En2145Ph1Ad1" /><aaif:adverb rdf:resource="https://gams.uni-graz.at/o:aaif.fraweb#En2145Ph1Ad2" /><aaif:text>ils nous parlent doux ou dur </aaif:text><aaif:annoText>ils nous [v|parlent|parler|is] [a|doux|doux|auvnmnnC] ou [a|dur|dur|auvnmnnC] </aaif:annoText></aaif:Phrase><aaif:Verb rdf:about="https://gams.uni-graz.at/o:aaif.fraweb#En2145Ph1Ve1"><aaif:text>parlent</aaif:text><aaif:lemma rdf:resource="https://gams.uni-graz.at/o:aaif.lemma#parler" /><aaif:position rdf:datatype="http://www.w3.org/2001/XMLSchema#int">1</aaif:position><aaif:coordinated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:coordinated><aaif:partOfText rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</aaif:partOfText><aaif:syntacticConstruction rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Intransitive" /></aaif:Verb><aaif:Adverb rdf:about="https://gams.uni-graz.at/o:aaif.fraweb#En2145Ph1Ad1"><aaif:text>doux</aaif:text><aaif:lemma rdf:resource="https://gams.uni-graz.at/o:aaif.lemma#doux" /><aaif:position rdf:datatype="http://www.w3.org/2001/XMLSchema#int">2</aaif:position><aaif:coordinated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</aaif:coordinated><aaif:morphosyntacticStructure rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Adjective" /><aaif:inflection rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Uninflected" /><aaif:attributionTarget rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Verb" /><aaif:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:modified><aaif:semanticClassification rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Manner" /><aaif:reduplicated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:reduplicated><aaif:prepositionalPhrase rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:prepositionalPhrase></aaif:Adverb><aaif:Adverb rdf:about="https://gams.uni-graz.at/o:aaif.fraweb#En2145Ph1Ad2"><aaif:text>dur</aaif:text><aaif:lemma rdf:resource="https://gams.uni-graz.at/o:aaif.lemma#dur" /><aaif:position rdf:datatype="http://www.w3.org/2001/XMLSchema#int">3</aaif:position><aaif:coordinated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</aaif:coordinated><aaif:morphosyntacticStructure rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Adjective" /><aaif:inflection rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Uninflected" /><aaif:attributionTarget rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Verb" /><aaif:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:modified><aaif:semanticClassification rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Manner" /><aaif:reduplicated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:reduplicated><aaif:prepositionalPhrase rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:prepositionalPhrase></aaif:Adverb><aaif:Entry rdf:about="https://gams.uni-graz.at/o:aaif.fraweb#En2146"><aaif:phrase rdf:resource="https://gams.uni-graz.at/o:aaif.fraweb#En2146Ph1" /><aaif:source rdf:resource="https://gams.uni-graz.at/o:aaif.fraweb.bibl#DC2154" /><gams:textualContent>Imaginez, derrière un décor de vieux Paris miroitant sous sa verrière, un boudoir grand comme une boîte à chaussures, paré d'un design pur et lactescent, où les 22 convives portent beau et parlent doux  .</gams:textualContent><rel:isPartOf rdf:resource="https://gams.uni-graz.at/o:aaif.fraweb" /></aaif:Entry><aaif:Phrase rdf:about="https://gams.uni-graz.at/o:aaif.fraweb#En2146Ph1"><aaif:verb rdf:resource="https://gams.uni-graz.at/o:aaif.fraweb#En2146Ph1Ve1" /><aaif:verb rdf:resource="https://gams.uni-graz.at/o:aaif.fraweb#En2146Ph1Ve2" /><aaif:adverb rdf:resource="https://gams.uni-graz.at/o:aaif.fraweb#En2146Ph1Ad1" /><aaif:adverb rdf:resource="https://gams.uni-graz.at/o:aaif.fraweb#En2146Ph1Ad2" /><aaif:text>les 22 convives portent beau et parlent doux </aaif:text><aaif:annoText>les 22 convives [v|portent|parler|is] [a|beau|beau|auonmnnn] et [v|parlent|parler|is] [a|doux|doux|auvnmnnn] </aaif:annoText></aaif:Phrase><aaif:Verb rdf:about="https://gams.uni-graz.at/o:aaif.fraweb#En2146Ph1Ve1"><aaif:text>portent</aaif:text><aaif:lemma rdf:resource="https://gams.uni-graz.at/o:aaif.lemma#parler" /><aaif:position rdf:datatype="http://www.w3.org/2001/XMLSchema#int">1</aaif:position><aaif:coordinated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:coordinated><aaif:partOfText rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</aaif:partOfText><aaif:syntacticConstruction rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Intransitive" /></aaif:Verb><aaif:Verb rdf:about="https://gams.uni-graz.at/o:aaif.fraweb#En2146Ph1Ve2"><aaif:text>parlent</aaif:text><aaif:lemma rdf:resource="https://gams.uni-graz.at/o:aaif.lemma#parler" /><aaif:position rdf:datatype="http://www.w3.org/2001/XMLSchema#int">3</aaif:position><aaif:coordinated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:coordinated><aaif:partOfText rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</aaif:partOfText><aaif:syntacticConstruction rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Intransitive" /></aaif:Verb><aaif:Adverb rdf:about="https://gams.uni-graz.at/o:aaif.fraweb#En2146Ph1Ad1"><aaif:text>beau</aaif:text><aaif:lemma rdf:resource="https://gams.uni-graz.at/o:aaif.lemma#beau" /><aaif:position rdf:datatype="http://www.w3.org/2001/XMLSchema#int">2</aaif:position><aaif:coordinated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:coordinated><aaif:morphosyntacticStructure rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Adjective" /><aaif:inflection rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Uninflected" /><aaif:attributionTarget rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#VerbObject" /><aaif:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:modified><aaif:semanticClassification rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Manner" /><aaif:reduplicated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:reduplicated><aaif:prepositionalPhrase rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:prepositionalPhrase></aaif:Adverb><aaif:Adverb rdf:about="https://gams.uni-graz.at/o:aaif.fraweb#En2146Ph1Ad2"><aaif:text>doux</aaif:text><aaif:lemma rdf:resource="https://gams.uni-graz.at/o:aaif.lemma#doux" /><aaif:position rdf:datatype="http://www.w3.org/2001/XMLSchema#int">4</aaif:position><aaif:coordinated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:coordinated><aaif:morphosyntacticStructure rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Adjective" /><aaif:inflection rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Uninflected" /><aaif:attributionTarget rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Verb" /><aaif:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:modified><aaif:semanticClassification rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Manner" /><aaif:reduplicated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:reduplicated><aaif:prepositionalPhrase rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:prepositionalPhrase></aaif:Adverb><aaif:Entry rdf:about="https://gams.uni-graz.at/o:aaif.fraweb#En2147"><aaif:phrase rdf:resource="https://gams.uni-graz.at/o:aaif.fraweb#En2147Ph1" /><aaif:source rdf:resource="https://gams.uni-graz.at/o:aaif.fraweb.bibl#DC2155" /><gams:textualContent>Marcher dans les pas de Jésus, c’est une belle phrase… mais quand on marche dans les pas de Jésus, TOUT remonte, la bible prend corps, les textes entendus dans les messes se mettent à vivre, à vibrer à l’intérieur… S’asseoir sur l’un des rochers ou le Christ était probablement assis parlant à ses disciples… quelle expérience !Les textes nous parlent droit au cœur, droit à l’âme… </gams:textualContent><rel:isPartOf rdf:resource="https://gams.uni-graz.at/o:aaif.fraweb" /></aaif:Entry><aaif:Phrase rdf:about="https://gams.uni-graz.at/o:aaif.fraweb#En2147Ph1"><aaif:verb rdf:resource="https://gams.uni-graz.at/o:aaif.fraweb#En2147Ph1Ve1" /><aaif:adverb rdf:resource="https://gams.uni-graz.at/o:aaif.fraweb#En2147Ph1Ad1" /><aaif:adverb rdf:resource="https://gams.uni-graz.at/o:aaif.fraweb#En2147Ph1Ad2" /><aaif:text>Les textes nous parlent droit au cœur, droit à l’âme</aaif:text><aaif:annoText>Les textes nous [v|parlent|parler|is] [a|droit|droit|auvnlnnC] au cœur, [a|droit|droit|auvnlnnC] à l’âme</aaif:annoText></aaif:Phrase><aaif:Verb rdf:about="https://gams.uni-graz.at/o:aaif.fraweb#En2147Ph1Ve1"><aaif:text>parlent</aaif:text><aaif:lemma rdf:resource="https://gams.uni-graz.at/o:aaif.lemma#parler" /><aaif:position rdf:datatype="http://www.w3.org/2001/XMLSchema#int">1</aaif:position><aaif:coordinated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:coordinated><aaif:partOfText rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</aaif:partOfText><aaif:syntacticConstruction rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Intransitive" /></aaif:Verb><aaif:Adverb rdf:about="https://gams.uni-graz.at/o:aaif.fraweb#En2147Ph1Ad1"><aaif:text>droit</aaif:text><aaif:lemma rdf:resource="https://gams.uni-graz.at/o:aaif.lemma#droit" /><aaif:position rdf:datatype="http://www.w3.org/2001/XMLSchema#int">2</aaif:position><aaif:coordinated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</aaif:coordinated><aaif:morphosyntacticStructure rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Adjective" /><aaif:inflection rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Uninflected" /><aaif:attributionTarget rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Verb" /><aaif:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:modified><aaif:semanticClassification rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Location" /><aaif:reduplicated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:reduplicated><aaif:prepositionalPhrase rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:prepositionalPhrase></aaif:Adverb><aaif:Adverb rdf:about="https://gams.uni-graz.at/o:aaif.fraweb#En2147Ph1Ad2"><aaif:text>droit</aaif:text><aaif:lemma rdf:resource="https://gams.uni-graz.at/o:aaif.lemma#droit" /><aaif:position rdf:datatype="http://www.w3.org/2001/XMLSchema#int">3</aaif:position><aaif:coordinated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</aaif:coordinated><aaif:morphosyntacticStructure rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Adjective" /><aaif:inflection rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Uninflected" /><aaif:attributionTarget rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Verb" /><aaif:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:modified><aaif:semanticClassification rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Location" /><aaif:reduplicated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:reduplicated><aaif:prepositionalPhrase rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:prepositionalPhrase></aaif:Adverb><aaif:Entry rdf:about="https://gams.uni-graz.at/o:aaif.fraweb#En2148"><aaif:phrase rdf:resource="https://gams.uni-graz.at/o:aaif.fraweb#En2148Ph1" /><aaif:source rdf:resource="https://gams.uni-graz.at/o:aaif.fraweb.bibl#DC2156" /><gams:textualContent>Brahms, Schubert, Mendelssohn, Schumann : les plus grands noms du romantisme allemand s’intéressent tous à la forme chorale.C’est qu’au xixe siècle celle-ci ne véhicule plus exclusivement la parole divine, mais aussi la voix du peuple, celle des traditions populaires qui prennent racine dans la nuit des temps et  parlent  droit au cœur des gens simples.</gams:textualContent><rel:isPartOf rdf:resource="https://gams.uni-graz.at/o:aaif.fraweb" /></aaif:Entry><aaif:Phrase rdf:about="https://gams.uni-graz.at/o:aaif.fraweb#En2148Ph1"><aaif:verb rdf:resource="https://gams.uni-graz.at/o:aaif.fraweb#En2148Ph1Ve1" /><aaif:adverb rdf:resource="https://gams.uni-graz.at/o:aaif.fraweb#En2148Ph1Ad1" /><aaif:text> parlent  droit au cœur</aaif:text><aaif:annoText> [v|parlent|parler|is]  [a|droit|droit|auvnlnnn] au cœur</aaif:annoText></aaif:Phrase><aaif:Verb rdf:about="https://gams.uni-graz.at/o:aaif.fraweb#En2148Ph1Ve1"><aaif:text>parlent</aaif:text><aaif:lemma rdf:resource="https://gams.uni-graz.at/o:aaif.lemma#parler" /><aaif:position rdf:datatype="http://www.w3.org/2001/XMLSchema#int">1</aaif:position><aaif:coordinated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:coordinated><aaif:partOfText rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</aaif:partOfText><aaif:syntacticConstruction rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Intransitive" /></aaif:Verb><aaif:Adverb rdf:about="https://gams.uni-graz.at/o:aaif.fraweb#En2148Ph1Ad1"><aaif:text>droit</aaif:text><aaif:lemma rdf:resource="https://gams.uni-graz.at/o:aaif.lemma#droit" /><aaif:position rdf:datatype="http://www.w3.org/2001/XMLSchema#int">2</aaif:position><aaif:coordinated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:coordinated><aaif:morphosyntacticStructure rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Adjective" /><aaif:inflection rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Uninflected" /><aaif:attributionTarget rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Verb" /><aaif:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:modified><aaif:semanticClassification rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Location" /><aaif:reduplicated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:reduplicated><aaif:prepositionalPhrase rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:prepositionalPhrase></aaif:Adverb><aaif:Entry rdf:about="https://gams.uni-graz.at/o:aaif.fraweb#En2149"><aaif:phrase rdf:resource="https://gams.uni-graz.at/o:aaif.fraweb#En2149Ph1" /><aaif:source rdf:resource="https://gams.uni-graz.at/o:aaif.fraweb.bibl#DC2157" /><gams:textualContent>Michel Rocard, cinquante ans de politique, toujours aussi présent dans le débat au moment où le partis socialiste se déchire, toujours aussi engagé et flamboyant, parlant vrai , parlant dru  , n'esquive aucune contradiction et évoque dans ces cinq entretiens tour à tour :</gams:textualContent><rel:isPartOf rdf:resource="https://gams.uni-graz.at/o:aaif.fraweb" /></aaif:Entry><aaif:Phrase rdf:about="https://gams.uni-graz.at/o:aaif.fraweb#En2149Ph1"><aaif:verb rdf:resource="https://gams.uni-graz.at/o:aaif.fraweb#En2149Ph1Ve1" /><aaif:verb rdf:resource="https://gams.uni-graz.at/o:aaif.fraweb#En2149Ph1Ve2" /><aaif:adverb rdf:resource="https://gams.uni-graz.at/o:aaif.fraweb#En2149Ph1Ad1" /><aaif:adverb rdf:resource="https://gams.uni-graz.at/o:aaif.fraweb#En2149Ph1Ad2" /><aaif:text>le partis socialiste se déchire, toujours aussi engagé et flamboyant, parlant vrai , parlant dru </aaif:text><aaif:annoText>le partis socialiste se déchire, toujours aussi engagé et flamboyant, [v|parlant|parler|is] [a|vrai|vrai|auvnmnnn] , [v|parlant|parler|is] [a|dru|dru|auvnmnnn] </aaif:annoText></aaif:Phrase><aaif:Verb rdf:about="https://gams.uni-graz.at/o:aaif.fraweb#En2149Ph1Ve1"><aaif:text>parlant</aaif:text><aaif:lemma rdf:resource="https://gams.uni-graz.at/o:aaif.lemma#parler" /><aaif:position rdf:datatype="http://www.w3.org/2001/XMLSchema#int">1</aaif:position><aaif:coordinated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:coordinated><aaif:partOfText rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</aaif:partOfText><aaif:syntacticConstruction rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Intransitive" /></aaif:Verb><aaif:Verb rdf:about="https://gams.uni-graz.at/o:aaif.fraweb#En2149Ph1Ve2"><aaif:text>parlant</aaif:text><aaif:lemma rdf:resource="https://gams.uni-graz.at/o:aaif.lemma#parler" /><aaif:position rdf:datatype="http://www.w3.org/2001/XMLSchema#int">3</aaif:position><aaif:coordinated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:coordinated><aaif:partOfText rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</aaif:partOfText><aaif:syntacticConstruction rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Intransitive" /></aaif:Verb><aaif:Adverb rdf:about="https://gams.uni-graz.at/o:aaif.fraweb#En2149Ph1Ad1"><aaif:text>vrai</aaif:text><aaif:lemma rdf:resource="https://gams.uni-graz.at/o:aaif.lemma#vrai" /><aaif:position rdf:datatype="http://www.w3.org/2001/XMLSchema#int">2</aaif:position><aaif:coordinated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:coordinated><aaif:morphosyntacticStructure rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Adjective" /><aaif:inflection rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Uninflected" /><aaif:attributionTarget rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Verb" /><aaif:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:modified><aaif:semanticClassification rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Manner" /><aaif:reduplicated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:reduplicated><aaif:prepositionalPhrase rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:prepositionalPhrase></aaif:Adverb><aaif:Adverb rdf:about="https://gams.uni-graz.at/o:aaif.fraweb#En2149Ph1Ad2"><aaif:text>dru</aaif:text><aaif:lemma rdf:resource="https://gams.uni-graz.at/o:aaif.lemma#dru" /><aaif:position rdf:datatype="http://www.w3.org/2001/XMLSchema#int">4</aaif:position><aaif:coordinated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:coordinated><aaif:morphosyntacticStructure rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Adjective" /><aaif:inflection rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Uninflected" /><aaif:attributionTarget rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Verb" /><aaif:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:modified><aaif:semanticClassification rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Manner" /><aaif:reduplicated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:reduplicated><aaif:prepositionalPhrase rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:prepositionalPhrase></aaif:Adverb><aaif:Entry rdf:about="https://gams.uni-graz.at/o:aaif.fraweb#En2150"><aaif:phrase rdf:resource="https://gams.uni-graz.at/o:aaif.fraweb#En2150Ph1" /><aaif:source rdf:resource="https://gams.uni-graz.at/o:aaif.fraweb.bibl#DC2158" /><gams:textualContent>Une langue inventée mâtinée de patois, riche en crases pétillantes et en ellipses audacieuses, des personnages hauts en couleurs parlant dru et franc  : La Gonfle oscille entre la facétie grotesque et le plus réalistement terrifiant des tableaux de mœurs.</gams:textualContent><rel:isPartOf rdf:resource="https://gams.uni-graz.at/o:aaif.fraweb" /></aaif:Entry><aaif:Phrase rdf:about="https://gams.uni-graz.at/o:aaif.fraweb#En2150Ph1"><aaif:verb rdf:resource="https://gams.uni-graz.at/o:aaif.fraweb#En2150Ph1Ve1" /><aaif:adverb rdf:resource="https://gams.uni-graz.at/o:aaif.fraweb#En2150Ph1Ad1" /><aaif:adverb rdf:resource="https://gams.uni-graz.at/o:aaif.fraweb#En2150Ph1Ad2" /><aaif:text>des personnages hauts en couleurs parlant dru et franc </aaif:text><aaif:annoText>des personnages hauts en couleurs [v|parlant|parler|is] [a|dru|dru|auvnmnnC] et [a|franc|franc|auvnmnnC] </aaif:annoText></aaif:Phrase><aaif:Verb rdf:about="https://gams.uni-graz.at/o:aaif.fraweb#En2150Ph1Ve1"><aaif:text>parlant</aaif:text><aaif:lemma rdf:resource="https://gams.uni-graz.at/o:aaif.lemma#parler" /><aaif:position rdf:datatype="http://www.w3.org/2001/XMLSchema#int">1</aaif:position><aaif:coordinated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:coordinated><aaif:partOfText rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</aaif:partOfText><aaif:syntacticConstruction rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Intransitive" /></aaif:Verb><aaif:Adverb rdf:about="https://gams.uni-graz.at/o:aaif.fraweb#En2150Ph1Ad1"><aaif:text>dru</aaif:text><aaif:lemma rdf:resource="https://gams.uni-graz.at/o:aaif.lemma#dru" /><aaif:position rdf:datatype="http://www.w3.org/2001/XMLSchema#int">2</aaif:position><aaif:coordinated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</aaif:coordinated><aaif:morphosyntacticStructure rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Adjective" /><aaif:inflection rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Uninflected" /><aaif:attributionTarget rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Verb" /><aaif:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:modified><aaif:semanticClassification rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Manner" /><aaif:reduplicated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:reduplicated><aaif:prepositionalPhrase rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:prepositionalPhrase></aaif:Adverb><aaif:Adverb rdf:about="https://gams.uni-graz.at/o:aaif.fraweb#En2150Ph1Ad2"><aaif:text>franc</aaif:text><aaif:lemma rdf:resource="https://gams.uni-graz.at/o:aaif.lemma#franc" /><aaif:position rdf:datatype="http://www.w3.org/2001/XMLSchema#int">3</aaif:position><aaif:coordinated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</aaif:coordinated><aaif:morphosyntacticStructure rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Adjective" /><aaif:inflection rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Uninflected" /><aaif:attributionTarget rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Verb" /><aaif:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:modified><aaif:semanticClassification rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Manner" /><aaif:reduplicated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:reduplicated><aaif:prepositionalPhrase rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:prepositionalPhrase></aaif:Adverb><aaif:Entry rdf:about="https://gams.uni-graz.at/o:aaif.fraweb#En2151"><aaif:phrase rdf:resource="https://gams.uni-graz.at/o:aaif.fraweb#En2151Ph1" /><aaif:source rdf:resource="https://gams.uni-graz.at/o:aaif.fraweb.bibl#DC2159" /><gams:textualContent>haa bah une chose, ils sont criards et parfois même méchants, mais tu risque pas de perdre ton poste même si tu leur réponds!ils parlent dur  , mais ils sont aussi capables d'en recevoir!;)</gams:textualContent><rel:isPartOf rdf:resource="https://gams.uni-graz.at/o:aaif.fraweb" /></aaif:Entry><aaif:Phrase rdf:about="https://gams.uni-graz.at/o:aaif.fraweb#En2151Ph1"><aaif:verb rdf:resource="https://gams.uni-graz.at/o:aaif.fraweb#En2151Ph1Ve1" /><aaif:adverb rdf:resource="https://gams.uni-graz.at/o:aaif.fraweb#En2151Ph1Ad1" /><aaif:text>ils parlent dur </aaif:text><aaif:annoText>ils [v|parlent|parler|is] [a|dur|dur|ausnmnnn] </aaif:annoText></aaif:Phrase><aaif:Verb rdf:about="https://gams.uni-graz.at/o:aaif.fraweb#En2151Ph1Ve1"><aaif:text>parlent</aaif:text><aaif:lemma rdf:resource="https://gams.uni-graz.at/o:aaif.lemma#parler" /><aaif:position rdf:datatype="http://www.w3.org/2001/XMLSchema#int">1</aaif:position><aaif:coordinated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:coordinated><aaif:partOfText rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</aaif:partOfText><aaif:syntacticConstruction rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Intransitive" /></aaif:Verb><aaif:Adverb rdf:about="https://gams.uni-graz.at/o:aaif.fraweb#En2151Ph1Ad1"><aaif:text>dur</aaif:text><aaif:lemma rdf:resource="https://gams.uni-graz.at/o:aaif.lemma#dur" /><aaif:position rdf:datatype="http://www.w3.org/2001/XMLSchema#int">2</aaif:position><aaif:coordinated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:coordinated><aaif:morphosyntacticStructure rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Adjective" /><aaif:inflection rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Uninflected" /><aaif:attributionTarget rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Verb" /><aaif:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:modified><aaif:semanticClassification rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Manner" /><aaif:reduplicated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:reduplicated><aaif:prepositionalPhrase rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:prepositionalPhrase></aaif:Adverb><aaif:Entry rdf:about="https://gams.uni-graz.at/o:aaif.fraweb#En2152"><aaif:phrase rdf:resource="https://gams.uni-graz.at/o:aaif.fraweb#En2152Ph1" /><aaif:source rdf:resource="https://gams.uni-graz.at/o:aaif.fraweb.bibl#DC2160" /><gams:textualContent>L'Algérie c'est dur mon ami.Pas vraiment, l'Algerie est une republique prise en otage par des affairistes qui ont decide qu'un pays pouvait marcher selon les lois de la mafia au lieu de lois economiques.Ils parlent dur  peut etre parce que le baril est a 130 dollars, mais s'il descend a 100 dollars, ils passeront la parole au peuple algerien et ils iront parler de Suisse.</gams:textualContent><rel:isPartOf rdf:resource="https://gams.uni-graz.at/o:aaif.fraweb" /></aaif:Entry><aaif:Phrase rdf:about="https://gams.uni-graz.at/o:aaif.fraweb#En2152Ph1"><aaif:verb rdf:resource="https://gams.uni-graz.at/o:aaif.fraweb#En2152Ph1Ve1" /><aaif:adverb rdf:resource="https://gams.uni-graz.at/o:aaif.fraweb#En2152Ph1Ad1" /><aaif:text>Ils parlent dur </aaif:text><aaif:annoText>Ils [v|parlent|parler|is] [a|dur|dur|auvnmnnn] </aaif:annoText></aaif:Phrase><aaif:Verb rdf:about="https://gams.uni-graz.at/o:aaif.fraweb#En2152Ph1Ve1"><aaif:text>parlent</aaif:text><aaif:lemma rdf:resource="https://gams.uni-graz.at/o:aaif.lemma#parler" /><aaif:position rdf:datatype="http://www.w3.org/2001/XMLSchema#int">1</aaif:position><aaif:coordinated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:coordinated><aaif:partOfText rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</aaif:partOfText><aaif:syntacticConstruction rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Intransitive" /></aaif:Verb><aaif:Adverb rdf:about="https://gams.uni-graz.at/o:aaif.fraweb#En2152Ph1Ad1"><aaif:text>dur</aaif:text><aaif:lemma rdf:resource="https://gams.uni-graz.at/o:aaif.lemma#dur" /><aaif:position rdf:datatype="http://www.w3.org/2001/XMLSchema#int">2</aaif:position><aaif:coordinated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:coordinated><aaif:morphosyntacticStructure rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Adjective" /><aaif:inflection rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Uninflected" /><aaif:attributionTarget rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Verb" /><aaif:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:modified><aaif:semanticClassification rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Manner" /><aaif:reduplicated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:reduplicated><aaif:prepositionalPhrase rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:prepositionalPhrase></aaif:Adverb><aaif:Entry rdf:about="https://gams.uni-graz.at/o:aaif.fraweb#En2153"><aaif:phrase rdf:resource="https://gams.uni-graz.at/o:aaif.fraweb#En2153Ph1" /><aaif:source rdf:resource="https://gams.uni-graz.at/o:aaif.fraweb.bibl#DC2161" /><gams:textualContent>pourquoi les hommes politiques parlent faux  alors que la vérité va leur éclater à la figure ?</gams:textualContent><rel:isPartOf rdf:resource="https://gams.uni-graz.at/o:aaif.fraweb" /></aaif:Entry><aaif:Phrase rdf:about="https://gams.uni-graz.at/o:aaif.fraweb#En2153Ph1"><aaif:verb rdf:resource="https://gams.uni-graz.at/o:aaif.fraweb#En2153Ph1Ve1" /><aaif:adverb rdf:resource="https://gams.uni-graz.at/o:aaif.fraweb#En2153Ph1Ad1" /><aaif:text>les hommes politiques parlent faux </aaif:text><aaif:annoText>les hommes politiques [v|parlent|parler|is] [a|faux|faux|auvnmnnn] </aaif:annoText></aaif:Phrase><aaif:Verb rdf:about="https://gams.uni-graz.at/o:aaif.fraweb#En2153Ph1Ve1"><aaif:text>parlent</aaif:text><aaif:lemma rdf:resource="https://gams.uni-graz.at/o:aaif.lemma#parler" /><aaif:position rdf:datatype="http://www.w3.org/2001/XMLSchema#int">1</aaif:position><aaif:coordinated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:coordinated><aaif:partOfText rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</aaif:partOfText><aaif:syntacticConstruction rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Intransitive" /></aaif:Verb><aaif:Adverb rdf:about="https://gams.uni-graz.at/o:aaif.fraweb#En2153Ph1Ad1"><aaif:text>faux</aaif:text><aaif:lemma rdf:resource="https://gams.uni-graz.at/o:aaif.lemma#faux" /><aaif:position rdf:datatype="http://www.w3.org/2001/XMLSchema#int">2</aaif:position><aaif:coordinated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:coordinated><aaif:morphosyntacticStructure rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Adjective" /><aaif:inflection rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Uninflected" /><aaif:attributionTarget rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Verb" /><aaif:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:modified><aaif:semanticClassification rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Manner" /><aaif:reduplicated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:reduplicated><aaif:prepositionalPhrase rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:prepositionalPhrase></aaif:Adverb><aaif:Entry rdf:about="https://gams.uni-graz.at/o:aaif.fraweb#En2154"><aaif:phrase rdf:resource="https://gams.uni-graz.at/o:aaif.fraweb#En2154Ph1" /><aaif:source rdf:resource="https://gams.uni-graz.at/o:aaif.fraweb.bibl#DC2162" /><gams:textualContent>Le problème, c’est que l’argument se dissout dans un enchaînement sans queue ni tête autour de situations floues.On ne croit pas une seule seconde aux personnages qui parlent faux  , et qui donnent du « bordel de chèvre !» ou du « J’m’en tamponne les ovaires avec le dos de la cuillère » à tout bout de champ.</gams:textualContent><rel:isPartOf rdf:resource="https://gams.uni-graz.at/o:aaif.fraweb" /></aaif:Entry><aaif:Phrase rdf:about="https://gams.uni-graz.at/o:aaif.fraweb#En2154Ph1"><aaif:verb rdf:resource="https://gams.uni-graz.at/o:aaif.fraweb#En2154Ph1Ve1" /><aaif:adverb rdf:resource="https://gams.uni-graz.at/o:aaif.fraweb#En2154Ph1Ad1" /><aaif:text>qui parlent faux </aaif:text><aaif:annoText>qui [v|parlent|parler|is] [a|faux|faux|auvnmnnn] </aaif:annoText></aaif:Phrase><aaif:Verb rdf:about="https://gams.uni-graz.at/o:aaif.fraweb#En2154Ph1Ve1"><aaif:text>parlent</aaif:text><aaif:lemma rdf:resource="https://gams.uni-graz.at/o:aaif.lemma#parler" /><aaif:position rdf:datatype="http://www.w3.org/2001/XMLSchema#int">1</aaif:position><aaif:coordinated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:coordinated><aaif:partOfText rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</aaif:partOfText><aaif:syntacticConstruction rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Intransitive" /></aaif:Verb><aaif:Adverb rdf:about="https://gams.uni-graz.at/o:aaif.fraweb#En2154Ph1Ad1"><aaif:text>faux</aaif:text><aaif:lemma rdf:resource="https://gams.uni-graz.at/o:aaif.lemma#faux" /><aaif:position rdf:datatype="http://www.w3.org/2001/XMLSchema#int">2</aaif:position><aaif:coordinated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:coordinated><aaif:morphosyntacticStructure rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Adjective" /><aaif:inflection rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Uninflected" /><aaif:attributionTarget rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Verb" /><aaif:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:modified><aaif:semanticClassification rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Manner" /><aaif:reduplicated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:reduplicated><aaif:prepositionalPhrase rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:prepositionalPhrase></aaif:Adverb><aaif:Entry rdf:about="https://gams.uni-graz.at/o:aaif.fraweb#En2155"><aaif:phrase rdf:resource="https://gams.uni-graz.at/o:aaif.fraweb#En2155Ph1" /><aaif:source rdf:resource="https://gams.uni-graz.at/o:aaif.fraweb.bibl#DC2163" /><gams:textualContent>La parole, la parole, toujours la parole; du matin au soir, les gens parlent… et ils parlent rarement de ce qu’ils connaissent.Ils parlent et ils rapportent; ils parlent et ils rajoutent… ils parlent pour ne jamais s’arrêter.Ils parlent haut et ils parlent fort ; ils parlent beau et ils parlent faux  … Quand le monde travaille, les Sénégalais parlent; quand le monde avance, les Sénégalais parlent.</gams:textualContent><rel:isPartOf rdf:resource="https://gams.uni-graz.at/o:aaif.fraweb" /></aaif:Entry><aaif:Phrase rdf:about="https://gams.uni-graz.at/o:aaif.fraweb#En2155Ph1"><aaif:verb rdf:resource="https://gams.uni-graz.at/o:aaif.fraweb#En2155Ph1Ve1" /><aaif:verb rdf:resource="https://gams.uni-graz.at/o:aaif.fraweb#En2155Ph1Ve2" /><aaif:verb rdf:resource="https://gams.uni-graz.at/o:aaif.fraweb#En2155Ph1Ve3" /><aaif:verb rdf:resource="https://gams.uni-graz.at/o:aaif.fraweb#En2155Ph1Ve4" /><aaif:adverb rdf:resource="https://gams.uni-graz.at/o:aaif.fraweb#En2155Ph1Ad1" /><aaif:adverb rdf:resource="https://gams.uni-graz.at/o:aaif.fraweb#En2155Ph1Ad2" /><aaif:adverb rdf:resource="https://gams.uni-graz.at/o:aaif.fraweb#En2155Ph1Ad3" /><aaif:adverb rdf:resource="https://gams.uni-graz.at/o:aaif.fraweb#En2155Ph1Ad4" /><aaif:text>Ils parlent haut et ils parlent fort ; ils parlent beau et ils parlent faux </aaif:text><aaif:annoText>Ils [v|parlent|parler|is] [a|haut|haut|auvnmnnn] et ils [v|parlent|parler|is] [a|fort|fort|auvnmnnn] ; ils [v|parlent|parler|is] [a|beau|beau|auvnmnnn] et ils [v|parlent|parler|is] [a|faux|faux|auvnmnnn] </aaif:annoText></aaif:Phrase><aaif:Verb rdf:about="https://gams.uni-graz.at/o:aaif.fraweb#En2155Ph1Ve1"><aaif:text>parlent</aaif:text><aaif:lemma rdf:resource="https://gams.uni-graz.at/o:aaif.lemma#parler" /><aaif:position rdf:datatype="http://www.w3.org/2001/XMLSchema#int">1</aaif:position><aaif:coordinated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:coordinated><aaif:partOfText rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</aaif:partOfText><aaif:syntacticConstruction rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Intransitive" /></aaif:Verb><aaif:Verb rdf:about="https://gams.uni-graz.at/o:aaif.fraweb#En2155Ph1Ve2"><aaif:text>parlent</aaif:text><aaif:lemma rdf:resource="https://gams.uni-graz.at/o:aaif.lemma#parler" /><aaif:position rdf:datatype="http://www.w3.org/2001/XMLSchema#int">3</aaif:position><aaif:coordinated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:coordinated><aaif:partOfText rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</aaif:partOfText><aaif:syntacticConstruction rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Intransitive" /></aaif:Verb><aaif:Verb rdf:about="https://gams.uni-graz.at/o:aaif.fraweb#En2155Ph1Ve3"><aaif:text>parlent</aaif:text><aaif:lemma rdf:resource="https://gams.uni-graz.at/o:aaif.lemma#parler" /><aaif:position rdf:datatype="http://www.w3.org/2001/XMLSchema#int">5</aaif:position><aaif:coordinated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:coordinated><aaif:partOfText rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</aaif:partOfText><aaif:syntacticConstruction rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Intransitive" /></aaif:Verb><aaif:Verb rdf:about="https://gams.uni-graz.at/o:aaif.fraweb#En2155Ph1Ve4"><aaif:text>parlent</aaif:text><aaif:lemma rdf:resource="https://gams.uni-graz.at/o:aaif.lemma#parler" /><aaif:position rdf:datatype="http://www.w3.org/2001/XMLSchema#int">7</aaif:position><aaif:coordinated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:coordinated><aaif:partOfText rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</aaif:partOfText><aaif:syntacticConstruction rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Intransitive" /></aaif:Verb><aaif:Adverb rdf:about="https://gams.uni-graz.at/o:aaif.fraweb#En2155Ph1Ad1"><aaif:text>haut</aaif:text><aaif:lemma rdf:resource="https://gams.uni-graz.at/o:aaif.lemma#haut" /><aaif:position rdf:datatype="http://www.w3.org/2001/XMLSchema#int">2</aaif:position><aaif:coordinated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:coordinated><aaif:morphosyntacticStructure rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Adjective" /><aaif:inflection rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Uninflected" /><aaif:attributionTarget rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Verb" /><aaif:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:modified><aaif:semanticClassification rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Manner" /><aaif:reduplicated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:reduplicated><aaif:prepositionalPhrase rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:prepositionalPhrase></aaif:Adverb><aaif:Adverb rdf:about="https://gams.uni-graz.at/o:aaif.fraweb#En2155Ph1Ad2"><aaif:text>fort</aaif:text><aaif:lemma rdf:resource="https://gams.uni-graz.at/o:aaif.lemma#fort" /><aaif:position rdf:datatype="http://www.w3.org/2001/XMLSchema#int">4</aaif:position><aaif:coordinated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:coordinated><aaif:morphosyntacticStructure rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Adjective" /><aaif:inflection rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Uninflected" /><aaif:attributionTarget rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Verb" /><aaif:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:modified><aaif:semanticClassification rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Manner" /><aaif:reduplicated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:reduplicated><aaif:prepositionalPhrase rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:prepositionalPhrase></aaif:Adverb><aaif:Adverb rdf:about="https://gams.uni-graz.at/o:aaif.fraweb#En2155Ph1Ad3"><aaif:text>beau</aaif:text><aaif:lemma rdf:resource="https://gams.uni-graz.at/o:aaif.lemma#beau" /><aaif:position rdf:datatype="http://www.w3.org/2001/XMLSchema#int">6</aaif:position><aaif:coordinated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:coordinated><aaif:morphosyntacticStructure rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Adjective" /><aaif:inflection rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Uninflected" /><aaif:attributionTarget rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Verb" /><aaif:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:modified><aaif:semanticClassification rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Manner" /><aaif:reduplicated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:reduplicated><aaif:prepositionalPhrase rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:prepositionalPhrase></aaif:Adverb><aaif:Adverb rdf:about="https://gams.uni-graz.at/o:aaif.fraweb#En2155Ph1Ad4"><aaif:text>faux</aaif:text><aaif:lemma rdf:resource="https://gams.uni-graz.at/o:aaif.lemma#faux" /><aaif:position rdf:datatype="http://www.w3.org/2001/XMLSchema#int">8</aaif:position><aaif:coordinated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:coordinated><aaif:morphosyntacticStructure rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Adjective" /><aaif:inflection rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Uninflected" /><aaif:attributionTarget rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Verb" /><aaif:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:modified><aaif:semanticClassification rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Manner" /><aaif:reduplicated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:reduplicated><aaif:prepositionalPhrase rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:prepositionalPhrase></aaif:Adverb><aaif:Entry rdf:about="https://gams.uni-graz.at/o:aaif.fraweb#En2156"><aaif:phrase rdf:resource="https://gams.uni-graz.at/o:aaif.fraweb#En2156Ph1" /><aaif:source rdf:resource="https://gams.uni-graz.at/o:aaif.fraweb.bibl#DC2164" /><gams:textualContent>Ils s’enferment au lieu d’ouvrir grandes les portes et les bouches, de parler ferme  , sans arrogance, avec des mots simples et vigoureux.</gams:textualContent><rel:isPartOf rdf:resource="https://gams.uni-graz.at/o:aaif.fraweb" /></aaif:Entry><aaif:Phrase rdf:about="https://gams.uni-graz.at/o:aaif.fraweb#En2156Ph1"><aaif:verb rdf:resource="https://gams.uni-graz.at/o:aaif.fraweb#En2156Ph1Ve1" /><aaif:adverb rdf:resource="https://gams.uni-graz.at/o:aaif.fraweb#En2156Ph1Ad1" /><aaif:text>de parler ferme </aaif:text><aaif:annoText>de [v|parler|parler|is] [a|ferme|ferme|auvnmnnn] </aaif:annoText></aaif:Phrase><aaif:Verb rdf:about="https://gams.uni-graz.at/o:aaif.fraweb#En2156Ph1Ve1"><aaif:text>parler</aaif:text><aaif:lemma rdf:resource="https://gams.uni-graz.at/o:aaif.lemma#parler" /><aaif:position rdf:datatype="http://www.w3.org/2001/XMLSchema#int">1</aaif:position><aaif:coordinated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:coordinated><aaif:partOfText rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</aaif:partOfText><aaif:syntacticConstruction rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Intransitive" /></aaif:Verb><aaif:Adverb rdf:about="https://gams.uni-graz.at/o:aaif.fraweb#En2156Ph1Ad1"><aaif:text>ferme</aaif:text><aaif:lemma rdf:resource="https://gams.uni-graz.at/o:aaif.lemma#ferme" /><aaif:position rdf:datatype="http://www.w3.org/2001/XMLSchema#int">2</aaif:position><aaif:coordinated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:coordinated><aaif:morphosyntacticStructure rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Adjective" /><aaif:inflection rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Uninflected" /><aaif:attributionTarget rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Verb" /><aaif:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:modified><aaif:semanticClassification rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Manner" /><aaif:reduplicated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:reduplicated><aaif:prepositionalPhrase rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:prepositionalPhrase></aaif:Adverb><aaif:Entry rdf:about="https://gams.uni-graz.at/o:aaif.fraweb#En2157"><aaif:phrase rdf:resource="https://gams.uni-graz.at/o:aaif.fraweb#En2157Ph1" /><aaif:source rdf:resource="https://gams.uni-graz.at/o:aaif.fraweb.bibl#DC2165" /><gams:textualContent>Mais comment peut on parler ferme et clair  lorsqu’on a transigé avec les parlementaires sur une mise en pratique rapide du non cumul des mandats ou qu’on a toléré jusqu’à la limite morale un Cahuzac au gouvernement ?</gams:textualContent><rel:isPartOf rdf:resource="https://gams.uni-graz.at/o:aaif.fraweb" /></aaif:Entry><aaif:Phrase rdf:about="https://gams.uni-graz.at/o:aaif.fraweb#En2157Ph1"><aaif:verb rdf:resource="https://gams.uni-graz.at/o:aaif.fraweb#En2157Ph1Ve1" /><aaif:adverb rdf:resource="https://gams.uni-graz.at/o:aaif.fraweb#En2157Ph1Ad1" /><aaif:adverb rdf:resource="https://gams.uni-graz.at/o:aaif.fraweb#En2157Ph1Ad2" /><aaif:text>comment peut on parler ferme et clair </aaif:text><aaif:annoText>comment peut on [v|parler|parler|is] [a|ferme|ferme|auvnmnnC] et [a|clair|clair|auvnmnnC] </aaif:annoText></aaif:Phrase><aaif:Verb rdf:about="https://gams.uni-graz.at/o:aaif.fraweb#En2157Ph1Ve1"><aaif:text>parler</aaif:text><aaif:lemma rdf:resource="https://gams.uni-graz.at/o:aaif.lemma#parler" /><aaif:position rdf:datatype="http://www.w3.org/2001/XMLSchema#int">1</aaif:position><aaif:coordinated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:coordinated><aaif:partOfText rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</aaif:partOfText><aaif:syntacticConstruction rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Intransitive" /></aaif:Verb><aaif:Adverb rdf:about="https://gams.uni-graz.at/o:aaif.fraweb#En2157Ph1Ad1"><aaif:text>ferme</aaif:text><aaif:lemma rdf:resource="https://gams.uni-graz.at/o:aaif.lemma#ferme" /><aaif:position rdf:datatype="http://www.w3.org/2001/XMLSchema#int">2</aaif:position><aaif:coordinated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</aaif:coordinated><aaif:morphosyntacticStructure rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Adjective" /><aaif:inflection rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Uninflected" /><aaif:attributionTarget rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Verb" /><aaif:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:modified><aaif:semanticClassification rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Manner" /><aaif:reduplicated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:reduplicated><aaif:prepositionalPhrase rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:prepositionalPhrase></aaif:Adverb><aaif:Adverb rdf:about="https://gams.uni-graz.at/o:aaif.fraweb#En2157Ph1Ad2"><aaif:text>clair</aaif:text><aaif:lemma rdf:resource="https://gams.uni-graz.at/o:aaif.lemma#clair" /><aaif:position rdf:datatype="http://www.w3.org/2001/XMLSchema#int">3</aaif:position><aaif:coordinated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</aaif:coordinated><aaif:morphosyntacticStructure rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Adjective" /><aaif:inflection rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Uninflected" /><aaif:attributionTarget rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Verb" /><aaif:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:modified><aaif:semanticClassification rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Manner" /><aaif:reduplicated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:reduplicated><aaif:prepositionalPhrase rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:prepositionalPhrase></aaif:Adverb><aaif:Entry rdf:about="https://gams.uni-graz.at/o:aaif.fraweb#En2158"><aaif:phrase rdf:resource="https://gams.uni-graz.at/o:aaif.fraweb#En2158Ph1" /><aaif:source rdf:resource="https://gams.uni-graz.at/o:aaif.fraweb.bibl#DC2166" /><gams:textualContent>Au bout de deux heures, nous retrouvons les trois malheureux, étouffés.Les sortir, puis faire la toilette, je la fais moi-même.Les mettre dans des draps, les ramener à la mairie, reconnaissance par les familles.C'est déchirant, c'est dur.Il me faut un cœur de pierre et parler ferme  .</gams:textualContent><rel:isPartOf rdf:resource="https://gams.uni-graz.at/o:aaif.fraweb" /></aaif:Entry><aaif:Phrase rdf:about="https://gams.uni-graz.at/o:aaif.fraweb#En2158Ph1"><aaif:verb rdf:resource="https://gams.uni-graz.at/o:aaif.fraweb#En2158Ph1Ve1" /><aaif:adverb rdf:resource="https://gams.uni-graz.at/o:aaif.fraweb#En2158Ph1Ad1" /><aaif:text>Il me faut un cœur de pierre et parler ferme </aaif:text><aaif:annoText>Il me faut un cœur de pierre et [v|parler|parler|is] [a|ferme|ferme|auvnmnnn] </aaif:annoText></aaif:Phrase><aaif:Verb rdf:about="https://gams.uni-graz.at/o:aaif.fraweb#En2158Ph1Ve1"><aaif:text>parler</aaif:text><aaif:lemma rdf:resource="https://gams.uni-graz.at/o:aaif.lemma#parler" /><aaif:position rdf:datatype="http://www.w3.org/2001/XMLSchema#int">1</aaif:position><aaif:coordinated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:coordinated><aaif:partOfText rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</aaif:partOfText><aaif:syntacticConstruction rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Intransitive" /></aaif:Verb><aaif:Adverb rdf:about="https://gams.uni-graz.at/o:aaif.fraweb#En2158Ph1Ad1"><aaif:text>ferme</aaif:text><aaif:lemma rdf:resource="https://gams.uni-graz.at/o:aaif.lemma#ferme" /><aaif:position rdf:datatype="http://www.w3.org/2001/XMLSchema#int">2</aaif:position><aaif:coordinated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:coordinated><aaif:morphosyntacticStructure rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Adjective" /><aaif:inflection rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Uninflected" /><aaif:attributionTarget rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Verb" /><aaif:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:modified><aaif:semanticClassification rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Manner" /><aaif:reduplicated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:reduplicated><aaif:prepositionalPhrase rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:prepositionalPhrase></aaif:Adverb><aaif:Entry rdf:about="https://gams.uni-graz.at/o:aaif.fraweb#En2159"><aaif:phrase rdf:resource="https://gams.uni-graz.at/o:aaif.fraweb#En2159Ph1" /><aaif:source rdf:resource="https://gams.uni-graz.at/o:aaif.fraweb.bibl#DC2168" /><gams:textualContent>Les hommes et les femmes de pouvoir parlent haut et fort  ; les hommes et les femmes d'influence murmurent à l'oreille.</gams:textualContent><rel:isPartOf rdf:resource="https://gams.uni-graz.at/o:aaif.fraweb" /></aaif:Entry><aaif:Phrase rdf:about="https://gams.uni-graz.at/o:aaif.fraweb#En2159Ph1"><aaif:verb rdf:resource="https://gams.uni-graz.at/o:aaif.fraweb#En2159Ph1Ve1" /><aaif:adverb rdf:resource="https://gams.uni-graz.at/o:aaif.fraweb#En2159Ph1Ad1" /><aaif:adverb rdf:resource="https://gams.uni-graz.at/o:aaif.fraweb#En2159Ph1Ad2" /><aaif:text>Les hommes et les femmes de pouvoir parlent haut et fort </aaif:text><aaif:annoText>Les hommes et les femmes de pouvoir [v|parlent|parler|is] [a|haut|haut|auvnmnnC] et [a|fort|fort|auvnmnnC] </aaif:annoText></aaif:Phrase><aaif:Verb rdf:about="https://gams.uni-graz.at/o:aaif.fraweb#En2159Ph1Ve1"><aaif:text>parlent</aaif:text><aaif:lemma rdf:resource="https://gams.uni-graz.at/o:aaif.lemma#parler" /><aaif:position rdf:datatype="http://www.w3.org/2001/XMLSchema#int">1</aaif:position><aaif:coordinated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:coordinated><aaif:partOfText rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</aaif:partOfText><aaif:syntacticConstruction rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Intransitive" /></aaif:Verb><aaif:Adverb rdf:about="https://gams.uni-graz.at/o:aaif.fraweb#En2159Ph1Ad1"><aaif:text>haut</aaif:text><aaif:lemma rdf:resource="https://gams.uni-graz.at/o:aaif.lemma#haut" /><aaif:position rdf:datatype="http://www.w3.org/2001/XMLSchema#int">2</aaif:position><aaif:coordinated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</aaif:coordinated><aaif:morphosyntacticStructure rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Adjective" /><aaif:inflection rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Uninflected" /><aaif:attributionTarget rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Verb" /><aaif:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:modified><aaif:semanticClassification rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Manner" /><aaif:reduplicated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:reduplicated><aaif:prepositionalPhrase rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:prepositionalPhrase></aaif:Adverb><aaif:Adverb rdf:about="https://gams.uni-graz.at/o:aaif.fraweb#En2159Ph1Ad2"><aaif:text>fort</aaif:text><aaif:lemma rdf:resource="https://gams.uni-graz.at/o:aaif.lemma#fort" /><aaif:position rdf:datatype="http://www.w3.org/2001/XMLSchema#int">3</aaif:position><aaif:coordinated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</aaif:coordinated><aaif:morphosyntacticStructure rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Adjective" /><aaif:inflection rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Uninflected" /><aaif:attributionTarget rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Verb" /><aaif:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:modified><aaif:semanticClassification rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Manner" /><aaif:reduplicated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:reduplicated><aaif:prepositionalPhrase rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:prepositionalPhrase></aaif:Adverb><aaif:Entry rdf:about="https://gams.uni-graz.at/o:aaif.fraweb#En2160"><aaif:phrase rdf:resource="https://gams.uni-graz.at/o:aaif.fraweb#En2160Ph1" /><aaif:source rdf:resource="https://gams.uni-graz.at/o:aaif.fraweb.bibl#DC2169" /><gams:textualContent>Etats généraux des territoires: les élus locaux parlent haut et fort  face à l'Etat</gams:textualContent><rel:isPartOf rdf:resource="https://gams.uni-graz.at/o:aaif.fraweb" /></aaif:Entry><aaif:Phrase rdf:about="https://gams.uni-graz.at/o:aaif.fraweb#En2160Ph1"><aaif:verb rdf:resource="https://gams.uni-graz.at/o:aaif.fraweb#En2160Ph1Ve1" /><aaif:adverb rdf:resource="https://gams.uni-graz.at/o:aaif.fraweb#En2160Ph1Ad1" /><aaif:adverb rdf:resource="https://gams.uni-graz.at/o:aaif.fraweb#En2160Ph1Ad2" /><aaif:text>les élus locaux parlent haut et fort </aaif:text><aaif:annoText>les élus locaux [v|parlent|parler|is] [a|haut|haut|auvnmnnC] et [a|fort|fort|auvnmnnC] </aaif:annoText></aaif:Phrase><aaif:Verb rdf:about="https://gams.uni-graz.at/o:aaif.fraweb#En2160Ph1Ve1"><aaif:text>parlent</aaif:text><aaif:lemma rdf:resource="https://gams.uni-graz.at/o:aaif.lemma#parler" /><aaif:position rdf:datatype="http://www.w3.org/2001/XMLSchema#int">1</aaif:position><aaif:coordinated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:coordinated><aaif:partOfText rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</aaif:partOfText><aaif:syntacticConstruction rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Intransitive" /></aaif:Verb><aaif:Adverb rdf:about="https://gams.uni-graz.at/o:aaif.fraweb#En2160Ph1Ad1"><aaif:text>haut</aaif:text><aaif:lemma rdf:resource="https://gams.uni-graz.at/o:aaif.lemma#haut" /><aaif:position rdf:datatype="http://www.w3.org/2001/XMLSchema#int">2</aaif:position><aaif:coordinated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</aaif:coordinated><aaif:morphosyntacticStructure rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Adjective" /><aaif:inflection rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Uninflected" /><aaif:attributionTarget rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Verb" /><aaif:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:modified><aaif:semanticClassification rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Manner" /><aaif:reduplicated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:reduplicated><aaif:prepositionalPhrase rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:prepositionalPhrase></aaif:Adverb><aaif:Adverb rdf:about="https://gams.uni-graz.at/o:aaif.fraweb#En2160Ph1Ad2"><aaif:text>fort</aaif:text><aaif:lemma rdf:resource="https://gams.uni-graz.at/o:aaif.lemma#fort" /><aaif:position rdf:datatype="http://www.w3.org/2001/XMLSchema#int">3</aaif:position><aaif:coordinated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</aaif:coordinated><aaif:morphosyntacticStructure rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Adjective" /><aaif:inflection rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Uninflected" /><aaif:attributionTarget rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Verb" /><aaif:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:modified><aaif:semanticClassification rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Manner" /><aaif:reduplicated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:reduplicated><aaif:prepositionalPhrase rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:prepositionalPhrase></aaif:Adverb><aaif:Entry rdf:about="https://gams.uni-graz.at/o:aaif.fraweb#En2161"><aaif:phrase rdf:resource="https://gams.uni-graz.at/o:aaif.fraweb#En2161Ph1" /><aaif:source rdf:resource="https://gams.uni-graz.at/o:aaif.fraweb.bibl#DC2170" /><gams:textualContent>Un texte qui donne vie aux voix des laveuses auxquelles la société n'a offert aucune tribune : autour du bassin, des histoires simples.Protégées par la singularité codifiée de cette cérémonie féminine, unies par leurs difficiles conditions de vie, ces femmes parlent franc  , révèlent les petits ou grands événements d'une vie rude, elles s'écoutent, se querellent, chantent, dansent et rient pour parer le malheur.</gams:textualContent><rel:isPartOf rdf:resource="https://gams.uni-graz.at/o:aaif.fraweb" /></aaif:Entry><aaif:Phrase rdf:about="https://gams.uni-graz.at/o:aaif.fraweb#En2161Ph1"><aaif:verb rdf:resource="https://gams.uni-graz.at/o:aaif.fraweb#En2161Ph1Ve1" /><aaif:adverb rdf:resource="https://gams.uni-graz.at/o:aaif.fraweb#En2161Ph1Ad1" /><aaif:text>ces femmes parlent franc </aaif:text><aaif:annoText>ces femmes [v|parlent|parler|is] [a|franc|franc|auvnmnnn] </aaif:annoText></aaif:Phrase><aaif:Verb rdf:about="https://gams.uni-graz.at/o:aaif.fraweb#En2161Ph1Ve1"><aaif:text>parlent</aaif:text><aaif:lemma rdf:resource="https://gams.uni-graz.at/o:aaif.lemma#parler" /><aaif:position rdf:datatype="http://www.w3.org/2001/XMLSchema#int">1</aaif:position><aaif:coordinated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:coordinated><aaif:partOfText rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</aaif:partOfText><aaif:syntacticConstruction rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Intransitive" /></aaif:Verb><aaif:Adverb rdf:about="https://gams.uni-graz.at/o:aaif.fraweb#En2161Ph1Ad1"><aaif:text>franc</aaif:text><aaif:lemma rdf:resource="https://gams.uni-graz.at/o:aaif.lemma#franc" /><aaif:position rdf:datatype="http://www.w3.org/2001/XMLSchema#int">2</aaif:position><aaif:coordinated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:coordinated><aaif:morphosyntacticStructure rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Adjective" /><aaif:inflection rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Uninflected" /><aaif:attributionTarget rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Verb" /><aaif:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:modified><aaif:semanticClassification rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Manner" /><aaif:reduplicated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:reduplicated><aaif:prepositionalPhrase rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:prepositionalPhrase></aaif:Adverb><aaif:Entry rdf:about="https://gams.uni-graz.at/o:aaif.fraweb#En2162"><aaif:phrase rdf:resource="https://gams.uni-graz.at/o:aaif.fraweb#En2162Ph1" /><aaif:source rdf:resource="https://gams.uni-graz.at/o:aaif.fraweb.bibl#DC2171" /><gams:textualContent>En général, les Portugais sont des gens très amicaux et accueillants envers les étrangers.Ils sont sincères et d’habitude parlent franc .</gams:textualContent><rel:isPartOf rdf:resource="https://gams.uni-graz.at/o:aaif.fraweb" /></aaif:Entry><aaif:Phrase rdf:about="https://gams.uni-graz.at/o:aaif.fraweb#En2162Ph1"><aaif:verb rdf:resource="https://gams.uni-graz.at/o:aaif.fraweb#En2162Ph1Ve1" /><aaif:adverb rdf:resource="https://gams.uni-graz.at/o:aaif.fraweb#En2162Ph1Ad1" /><aaif:text>Ils sont sincères et d’habitude parlent franc </aaif:text><aaif:annoText>Ils sont sincères et d’habitude [v|parlent|parler|is] [a|franc|franc|auvnmnnn] </aaif:annoText></aaif:Phrase><aaif:Verb rdf:about="https://gams.uni-graz.at/o:aaif.fraweb#En2162Ph1Ve1"><aaif:text>parlent</aaif:text><aaif:lemma rdf:resource="https://gams.uni-graz.at/o:aaif.lemma#parler" /><aaif:position rdf:datatype="http://www.w3.org/2001/XMLSchema#int">1</aaif:position><aaif:coordinated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:coordinated><aaif:partOfText rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</aaif:partOfText><aaif:syntacticConstruction rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Intransitive" /></aaif:Verb><aaif:Adverb rdf:about="https://gams.uni-graz.at/o:aaif.fraweb#En2162Ph1Ad1"><aaif:text>franc</aaif:text><aaif:lemma rdf:resource="https://gams.uni-graz.at/o:aaif.lemma#franc" /><aaif:position rdf:datatype="http://www.w3.org/2001/XMLSchema#int">2</aaif:position><aaif:coordinated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:coordinated><aaif:morphosyntacticStructure rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Adjective" /><aaif:inflection rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Uninflected" /><aaif:attributionTarget rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Verb" /><aaif:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:modified><aaif:semanticClassification rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Manner" /><aaif:reduplicated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:reduplicated><aaif:prepositionalPhrase rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:prepositionalPhrase></aaif:Adverb><aaif:Entry rdf:about="https://gams.uni-graz.at/o:aaif.fraweb#En2163"><aaif:phrase rdf:resource="https://gams.uni-graz.at/o:aaif.fraweb#En2163Ph1" /><aaif:source rdf:resource="https://gams.uni-graz.at/o:aaif.fraweb.bibl#DC2172" /><gams:textualContent>Je préfère la vulgarité des « petites gens » qui parlent gras et travaillent dur  , à cette grossièreté cousue de fil blanc, tricotée par des gens qui ne connaissent pas l’onglée dès le matin et la cohue des trams bondés aux heures de pointe.</gams:textualContent><rel:isPartOf rdf:resource="https://gams.uni-graz.at/o:aaif.fraweb" /></aaif:Entry><aaif:Phrase rdf:about="https://gams.uni-graz.at/o:aaif.fraweb#En2163Ph1"><aaif:verb rdf:resource="https://gams.uni-graz.at/o:aaif.fraweb#En2163Ph1Ve1" /><aaif:verb rdf:resource="https://gams.uni-graz.at/o:aaif.fraweb#En2163Ph1Ve2" /><aaif:adverb rdf:resource="https://gams.uni-graz.at/o:aaif.fraweb#En2163Ph1Ad1" /><aaif:adverb rdf:resource="https://gams.uni-graz.at/o:aaif.fraweb#En2163Ph1Ad2" /><aaif:text>qui parlent gras et travaillent dur </aaif:text><aaif:annoText>qui [v|parlent|parler|is] [a|gras|gras|auvnmnnn] et [v|travaillent|travailler|is] [a|dur|dur|auvnmnnn] </aaif:annoText></aaif:Phrase><aaif:Verb rdf:about="https://gams.uni-graz.at/o:aaif.fraweb#En2163Ph1Ve1"><aaif:text>parlent</aaif:text><aaif:lemma rdf:resource="https://gams.uni-graz.at/o:aaif.lemma#parler" /><aaif:position rdf:datatype="http://www.w3.org/2001/XMLSchema#int">1</aaif:position><aaif:coordinated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:coordinated><aaif:partOfText rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</aaif:partOfText><aaif:syntacticConstruction rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Intransitive" /></aaif:Verb><aaif:Verb rdf:about="https://gams.uni-graz.at/o:aaif.fraweb#En2163Ph1Ve2"><aaif:text>travaillent</aaif:text><aaif:lemma rdf:resource="https://gams.uni-graz.at/o:aaif.lemma#travailler" /><aaif:position rdf:datatype="http://www.w3.org/2001/XMLSchema#int">3</aaif:position><aaif:coordinated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:coordinated><aaif:partOfText rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</aaif:partOfText><aaif:syntacticConstruction rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Intransitive" /></aaif:Verb><aaif:Adverb rdf:about="https://gams.uni-graz.at/o:aaif.fraweb#En2163Ph1Ad1"><aaif:text>gras</aaif:text><aaif:lemma rdf:resource="https://gams.uni-graz.at/o:aaif.lemma#gras" /><aaif:position rdf:datatype="http://www.w3.org/2001/XMLSchema#int">2</aaif:position><aaif:coordinated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:coordinated><aaif:morphosyntacticStructure rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Adjective" /><aaif:inflection rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Uninflected" /><aaif:attributionTarget rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Verb" /><aaif:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:modified><aaif:semanticClassification rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Manner" /><aaif:reduplicated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:reduplicated><aaif:prepositionalPhrase rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:prepositionalPhrase></aaif:Adverb><aaif:Adverb rdf:about="https://gams.uni-graz.at/o:aaif.fraweb#En2163Ph1Ad2"><aaif:text>dur</aaif:text><aaif:lemma rdf:resource="https://gams.uni-graz.at/o:aaif.lemma#dur" /><aaif:position rdf:datatype="http://www.w3.org/2001/XMLSchema#int">4</aaif:position><aaif:coordinated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:coordinated><aaif:morphosyntacticStructure rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Adjective" /><aaif:inflection rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Uninflected" /><aaif:attributionTarget rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Verb" /><aaif:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:modified><aaif:semanticClassification rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Manner" /><aaif:reduplicated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:reduplicated><aaif:prepositionalPhrase rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:prepositionalPhrase></aaif:Adverb><aaif:Entry rdf:about="https://gams.uni-graz.at/o:aaif.fraweb#En2164"><aaif:phrase rdf:resource="https://gams.uni-graz.at/o:aaif.fraweb#En2164Ph1" /><aaif:source rdf:resource="https://gams.uni-graz.at/o:aaif.fraweb.bibl#DC2173" /><gams:textualContent>Je parle gras  , je jure, mais j'suis une fille hyper fragile en fait.</gams:textualContent><rel:isPartOf rdf:resource="https://gams.uni-graz.at/o:aaif.fraweb" /></aaif:Entry><aaif:Phrase rdf:about="https://gams.uni-graz.at/o:aaif.fraweb#En2164Ph1"><aaif:verb rdf:resource="https://gams.uni-graz.at/o:aaif.fraweb#En2164Ph1Ve1" /><aaif:adverb rdf:resource="https://gams.uni-graz.at/o:aaif.fraweb#En2164Ph1Ad1" /><aaif:text>Je parle gras </aaif:text><aaif:annoText>Je [v|parle|parler|is] [a|gras|gras|auvnmnnn] </aaif:annoText></aaif:Phrase><aaif:Verb rdf:about="https://gams.uni-graz.at/o:aaif.fraweb#En2164Ph1Ve1"><aaif:text>parle</aaif:text><aaif:lemma rdf:resource="https://gams.uni-graz.at/o:aaif.lemma#parler" /><aaif:position rdf:datatype="http://www.w3.org/2001/XMLSchema#int">1</aaif:position><aaif:coordinated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:coordinated><aaif:partOfText rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</aaif:partOfText><aaif:syntacticConstruction rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Intransitive" /></aaif:Verb><aaif:Adverb rdf:about="https://gams.uni-graz.at/o:aaif.fraweb#En2164Ph1Ad1"><aaif:text>gras</aaif:text><aaif:lemma rdf:resource="https://gams.uni-graz.at/o:aaif.lemma#gras" /><aaif:position rdf:datatype="http://www.w3.org/2001/XMLSchema#int">2</aaif:position><aaif:coordinated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:coordinated><aaif:morphosyntacticStructure rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Adjective" /><aaif:inflection rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Uninflected" /><aaif:attributionTarget rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Verb" /><aaif:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:modified><aaif:semanticClassification rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Manner" /><aaif:reduplicated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:reduplicated><aaif:prepositionalPhrase rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:prepositionalPhrase></aaif:Adverb><aaif:Entry rdf:about="https://gams.uni-graz.at/o:aaif.fraweb#En2165"><aaif:phrase rdf:resource="https://gams.uni-graz.at/o:aaif.fraweb#En2165Ph1" /><aaif:source rdf:resource="https://gams.uni-graz.at/o:aaif.fraweb.bibl#DC2174" /><gams:textualContent>Pour rester dans le même ton: elles fument comme des mecs, elles picolent comme des mecs, elles conduisent comme des mecs, elles parlent gras comme des mecs...et après elles s'étonnent qu'on les encule!</gams:textualContent><rel:isPartOf rdf:resource="https://gams.uni-graz.at/o:aaif.fraweb" /></aaif:Entry><aaif:Phrase rdf:about="https://gams.uni-graz.at/o:aaif.fraweb#En2165Ph1"><aaif:verb rdf:resource="https://gams.uni-graz.at/o:aaif.fraweb#En2165Ph1Ve1" /><aaif:adverb rdf:resource="https://gams.uni-graz.at/o:aaif.fraweb#En2165Ph1Ad1" /><aaif:text>elles parlent gras comme des mecs</aaif:text><aaif:annoText>elles [v|parlent|parler|is] [a|gras|gras|auvnmnnn] comme des mecs</aaif:annoText></aaif:Phrase><aaif:Verb rdf:about="https://gams.uni-graz.at/o:aaif.fraweb#En2165Ph1Ve1"><aaif:text>parlent</aaif:text><aaif:lemma rdf:resource="https://gams.uni-graz.at/o:aaif.lemma#parler" /><aaif:position rdf:datatype="http://www.w3.org/2001/XMLSchema#int">1</aaif:position><aaif:coordinated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:coordinated><aaif:partOfText rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</aaif:partOfText><aaif:syntacticConstruction rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Intransitive" /></aaif:Verb><aaif:Adverb rdf:about="https://gams.uni-graz.at/o:aaif.fraweb#En2165Ph1Ad1"><aaif:text>gras</aaif:text><aaif:lemma rdf:resource="https://gams.uni-graz.at/o:aaif.lemma#gras" /><aaif:position rdf:datatype="http://www.w3.org/2001/XMLSchema#int">2</aaif:position><aaif:coordinated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:coordinated><aaif:morphosyntacticStructure rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Adjective" /><aaif:inflection rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Uninflected" /><aaif:attributionTarget rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Verb" /><aaif:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:modified><aaif:semanticClassification rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Manner" /><aaif:reduplicated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:reduplicated><aaif:prepositionalPhrase rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:prepositionalPhrase></aaif:Adverb><aaif:Entry rdf:about="https://gams.uni-graz.at/o:aaif.fraweb#En2166"><aaif:phrase rdf:resource="https://gams.uni-graz.at/o:aaif.fraweb#En2166Ph1" /><aaif:source rdf:resource="https://gams.uni-graz.at/o:aaif.fraweb.bibl#DC2175" /><gams:textualContent>Bien entendu certains hommes politiques parlent GROS  actuellement, qu'ils peuvent gerer le Congo...Mais pourtant au meme moment ils n'arrivent meme pas a gerer leurs propres partis politiques; ces memes opposants ne demontrent aucun signe de democratie dans leurs partis...et veulent faire croire aux gens qu'ils sont les democrates...</gams:textualContent><rel:isPartOf rdf:resource="https://gams.uni-graz.at/o:aaif.fraweb" /></aaif:Entry><aaif:Phrase rdf:about="https://gams.uni-graz.at/o:aaif.fraweb#En2166Ph1"><aaif:verb rdf:resource="https://gams.uni-graz.at/o:aaif.fraweb#En2166Ph1Ve1" /><aaif:adverb rdf:resource="https://gams.uni-graz.at/o:aaif.fraweb#En2166Ph1Ad1" /><aaif:text>certains hommes politiques parlent GROS </aaif:text><aaif:annoText>certains hommes politiques [v|parlent|parler|is] [a|GROS|gros|auvnmnnn] </aaif:annoText></aaif:Phrase><aaif:Verb rdf:about="https://gams.uni-graz.at/o:aaif.fraweb#En2166Ph1Ve1"><aaif:text>parlent</aaif:text><aaif:lemma rdf:resource="https://gams.uni-graz.at/o:aaif.lemma#parler" /><aaif:position rdf:datatype="http://www.w3.org/2001/XMLSchema#int">1</aaif:position><aaif:coordinated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:coordinated><aaif:partOfText rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</aaif:partOfText><aaif:syntacticConstruction rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Intransitive" /></aaif:Verb><aaif:Adverb rdf:about="https://gams.uni-graz.at/o:aaif.fraweb#En2166Ph1Ad1"><aaif:text>GROS</aaif:text><aaif:lemma rdf:resource="https://gams.uni-graz.at/o:aaif.lemma#gros" /><aaif:position rdf:datatype="http://www.w3.org/2001/XMLSchema#int">2</aaif:position><aaif:coordinated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:coordinated><aaif:morphosyntacticStructure rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Adjective" /><aaif:inflection rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Uninflected" /><aaif:attributionTarget rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Verb" /><aaif:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:modified><aaif:semanticClassification rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Manner" /><aaif:reduplicated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:reduplicated><aaif:prepositionalPhrase rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:prepositionalPhrase></aaif:Adverb><aaif:Entry rdf:about="https://gams.uni-graz.at/o:aaif.fraweb#En2167"><aaif:phrase rdf:resource="https://gams.uni-graz.at/o:aaif.fraweb#En2167Ph1" /><aaif:source rdf:resource="https://gams.uni-graz.at/o:aaif.fraweb.bibl#DC2176" /><gams:textualContent>Moi perso.les filles (ou gars) qui parlent gros  ca m'enarve !lol</gams:textualContent><rel:isPartOf rdf:resource="https://gams.uni-graz.at/o:aaif.fraweb" /></aaif:Entry><aaif:Phrase rdf:about="https://gams.uni-graz.at/o:aaif.fraweb#En2167Ph1"><aaif:verb rdf:resource="https://gams.uni-graz.at/o:aaif.fraweb#En2167Ph1Ve1" /><aaif:adverb rdf:resource="https://gams.uni-graz.at/o:aaif.fraweb#En2167Ph1Ad1" /><aaif:text>les filles (ou gars) qui parlent gros </aaif:text><aaif:annoText>les filles (ou gars) qui [v|parlent|parler|is] [a|gros|gros|auvnmnnn] </aaif:annoText></aaif:Phrase><aaif:Verb rdf:about="https://gams.uni-graz.at/o:aaif.fraweb#En2167Ph1Ve1"><aaif:text>parlent</aaif:text><aaif:lemma rdf:resource="https://gams.uni-graz.at/o:aaif.lemma#parler" /><aaif:position rdf:datatype="http://www.w3.org/2001/XMLSchema#int">1</aaif:position><aaif:coordinated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:coordinated><aaif:partOfText rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</aaif:partOfText><aaif:syntacticConstruction rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Intransitive" /></aaif:Verb><aaif:Adverb rdf:about="https://gams.uni-graz.at/o:aaif.fraweb#En2167Ph1Ad1"><aaif:text>gros</aaif:text><aaif:lemma rdf:resource="https://gams.uni-graz.at/o:aaif.lemma#gros" /><aaif:position rdf:datatype="http://www.w3.org/2001/XMLSchema#int">2</aaif:position><aaif:coordinated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:coordinated><aaif:morphosyntacticStructure rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Adjective" /><aaif:inflection rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Uninflected" /><aaif:attributionTarget rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Verb" /><aaif:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:modified><aaif:semanticClassification rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Manner" /><aaif:reduplicated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:reduplicated><aaif:prepositionalPhrase rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:prepositionalPhrase></aaif:Adverb><aaif:Entry rdf:about="https://gams.uni-graz.at/o:aaif.fraweb#En2168"><aaif:phrase rdf:resource="https://gams.uni-graz.at/o:aaif.fraweb#En2168Ph1" /><aaif:source rdf:resource="https://gams.uni-graz.at/o:aaif.fraweb.bibl#DC2177" /><gams:textualContent>Alors montrons-nous dignes et indignons-nous, nous parents lorsque nos enfants, parlent “gros”  , et pointons du doigt ceux qui le font.</gams:textualContent><rel:isPartOf rdf:resource="https://gams.uni-graz.at/o:aaif.fraweb" /></aaif:Entry><aaif:Phrase rdf:about="https://gams.uni-graz.at/o:aaif.fraweb#En2168Ph1"><aaif:verb rdf:resource="https://gams.uni-graz.at/o:aaif.fraweb#En2168Ph1Ve1" /><aaif:adverb rdf:resource="https://gams.uni-graz.at/o:aaif.fraweb#En2168Ph1Ad1" /><aaif:text>nous parents lorsque nos enfants, parlent “gros” </aaif:text><aaif:annoText>nous parents lorsque nos enfants, [v|parlent|parler|is] [a|“gros”|gros|auvnmnnn] </aaif:annoText></aaif:Phrase><aaif:Verb rdf:about="https://gams.uni-graz.at/o:aaif.fraweb#En2168Ph1Ve1"><aaif:text>parlent</aaif:text><aaif:lemma rdf:resource="https://gams.uni-graz.at/o:aaif.lemma#parler" /><aaif:position rdf:datatype="http://www.w3.org/2001/XMLSchema#int">1</aaif:position><aaif:coordinated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:coordinated><aaif:partOfText rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</aaif:partOfText><aaif:syntacticConstruction rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Intransitive" /></aaif:Verb><aaif:Adverb rdf:about="https://gams.uni-graz.at/o:aaif.fraweb#En2168Ph1Ad1"><aaif:text>“gros”</aaif:text><aaif:lemma rdf:resource="https://gams.uni-graz.at/o:aaif.lemma#gros" /><aaif:position rdf:datatype="http://www.w3.org/2001/XMLSchema#int">2</aaif:position><aaif:coordinated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:coordinated><aaif:morphosyntacticStructure rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Adjective" /><aaif:inflection rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Uninflected" /><aaif:attributionTarget rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Verb" /><aaif:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:modified><aaif:semanticClassification rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Manner" /><aaif:reduplicated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:reduplicated><aaif:prepositionalPhrase rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:prepositionalPhrase></aaif:Adverb><aaif:Entry rdf:about="https://gams.uni-graz.at/o:aaif.fraweb#En2169"><aaif:phrase rdf:resource="https://gams.uni-graz.at/o:aaif.fraweb#En2169Ph1" /><aaif:source rdf:resource="https://gams.uni-graz.at/o:aaif.fraweb.bibl#DC2178" /><gams:textualContent>Quant au fait qu'ils viennent " profiter " ou "piller" le système social...Laissez-moi rigoler...Qui pille le système social en ce moment ?Le grand capital, nos politiques, nos ministres...Ils pillent plus en une journée que tous les autres en un an.Mais ils ont de beaux costumes et parlent joli  ...C'est de l'empapaoutage distinguÈ</gams:textualContent><rel:isPartOf rdf:resource="https://gams.uni-graz.at/o:aaif.fraweb" /></aaif:Entry><aaif:Phrase rdf:about="https://gams.uni-graz.at/o:aaif.fraweb#En2169Ph1"><aaif:verb rdf:resource="https://gams.uni-graz.at/o:aaif.fraweb#En2169Ph1Ve1" /><aaif:adverb rdf:resource="https://gams.uni-graz.at/o:aaif.fraweb#En2169Ph1Ad1" /><aaif:text>ils ont de beaux costumes et parlent joli </aaif:text><aaif:annoText>ils ont de beaux costumes et [v|parlent|parler|is] [a|joli|joli|auvnmnnn] </aaif:annoText></aaif:Phrase><aaif:Verb rdf:about="https://gams.uni-graz.at/o:aaif.fraweb#En2169Ph1Ve1"><aaif:text>parlent</aaif:text><aaif:lemma rdf:resource="https://gams.uni-graz.at/o:aaif.lemma#parler" /><aaif:position rdf:datatype="http://www.w3.org/2001/XMLSchema#int">1</aaif:position><aaif:coordinated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:coordinated><aaif:partOfText rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</aaif:partOfText><aaif:syntacticConstruction rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Intransitive" /></aaif:Verb><aaif:Adverb rdf:about="https://gams.uni-graz.at/o:aaif.fraweb#En2169Ph1Ad1"><aaif:text>joli</aaif:text><aaif:lemma rdf:resource="https://gams.uni-graz.at/o:aaif.lemma#joli" /><aaif:position rdf:datatype="http://www.w3.org/2001/XMLSchema#int">2</aaif:position><aaif:coordinated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:coordinated><aaif:morphosyntacticStructure rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Adjective" /><aaif:inflection rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Uninflected" /><aaif:attributionTarget rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Verb" /><aaif:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:modified><aaif:semanticClassification rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Manner" /><aaif:reduplicated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:reduplicated><aaif:prepositionalPhrase rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:prepositionalPhrase></aaif:Adverb><aaif:Entry rdf:about="https://gams.uni-graz.at/o:aaif.fraweb#En2170"><aaif:phrase rdf:resource="https://gams.uni-graz.at/o:aaif.fraweb#En2170Ph1" /><aaif:source rdf:resource="https://gams.uni-graz.at/o:aaif.fraweb.bibl#DC2179" /><gams:textualContent>François Morel!Ça alors, pour moi c'est un Deschiens!Comme il vieillit bien, comme il écrit bien, comme il parle joli  !</gams:textualContent><rel:isPartOf rdf:resource="https://gams.uni-graz.at/o:aaif.fraweb" /></aaif:Entry><aaif:Phrase rdf:about="https://gams.uni-graz.at/o:aaif.fraweb#En2170Ph1"><aaif:verb rdf:resource="https://gams.uni-graz.at/o:aaif.fraweb#En2170Ph1Ve1" /><aaif:adverb rdf:resource="https://gams.uni-graz.at/o:aaif.fraweb#En2170Ph1Ad1" /><aaif:text>il parle joli </aaif:text><aaif:annoText>il [v|parle|parler|is] [a|joli|joli|auvnmnnn] </aaif:annoText></aaif:Phrase><aaif:Verb rdf:about="https://gams.uni-graz.at/o:aaif.fraweb#En2170Ph1Ve1"><aaif:text>parle</aaif:text><aaif:lemma rdf:resource="https://gams.uni-graz.at/o:aaif.lemma#parler" /><aaif:position rdf:datatype="http://www.w3.org/2001/XMLSchema#int">1</aaif:position><aaif:coordinated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:coordinated><aaif:partOfText rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</aaif:partOfText><aaif:syntacticConstruction rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Intransitive" /></aaif:Verb><aaif:Adverb rdf:about="https://gams.uni-graz.at/o:aaif.fraweb#En2170Ph1Ad1"><aaif:text>joli</aaif:text><aaif:lemma rdf:resource="https://gams.uni-graz.at/o:aaif.lemma#joli" /><aaif:position rdf:datatype="http://www.w3.org/2001/XMLSchema#int">2</aaif:position><aaif:coordinated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:coordinated><aaif:morphosyntacticStructure rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Adjective" /><aaif:inflection rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Uninflected" /><aaif:attributionTarget rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Verb" /><aaif:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:modified><aaif:semanticClassification rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Manner" /><aaif:reduplicated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:reduplicated><aaif:prepositionalPhrase rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:prepositionalPhrase></aaif:Adverb><aaif:Entry rdf:about="https://gams.uni-graz.at/o:aaif.fraweb#En2171"><aaif:phrase rdf:resource="https://gams.uni-graz.at/o:aaif.fraweb#En2171Ph1" /><aaif:source rdf:resource="https://gams.uni-graz.at/o:aaif.fraweb.bibl#DC2180" /><gams:textualContent>nan, mais il me parle joli  de la bouche le bouseux des vosges là ?:D pis la neige, j'l'ai dressée moi, elle ne tombe pas sur mes trottoirs, ni dans la cour, que sur le gazon ...</gams:textualContent><rel:isPartOf rdf:resource="https://gams.uni-graz.at/o:aaif.fraweb" /></aaif:Entry><aaif:Phrase rdf:about="https://gams.uni-graz.at/o:aaif.fraweb#En2171Ph1"><aaif:verb rdf:resource="https://gams.uni-graz.at/o:aaif.fraweb#En2171Ph1Ve1" /><aaif:adverb rdf:resource="https://gams.uni-graz.at/o:aaif.fraweb#En2171Ph1Ad1" /><aaif:text>il me parle joli </aaif:text><aaif:annoText>il me [v|parle|parler|is] [a|joli|joli|auvnmnnn] </aaif:annoText></aaif:Phrase><aaif:Verb rdf:about="https://gams.uni-graz.at/o:aaif.fraweb#En2171Ph1Ve1"><aaif:text>parle</aaif:text><aaif:lemma rdf:resource="https://gams.uni-graz.at/o:aaif.lemma#parler" /><aaif:position rdf:datatype="http://www.w3.org/2001/XMLSchema#int">1</aaif:position><aaif:coordinated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:coordinated><aaif:partOfText rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</aaif:partOfText><aaif:syntacticConstruction rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Intransitive" /></aaif:Verb><aaif:Adverb rdf:about="https://gams.uni-graz.at/o:aaif.fraweb#En2171Ph1Ad1"><aaif:text>joli</aaif:text><aaif:lemma rdf:resource="https://gams.uni-graz.at/o:aaif.lemma#joli" /><aaif:position rdf:datatype="http://www.w3.org/2001/XMLSchema#int">2</aaif:position><aaif:coordinated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:coordinated><aaif:morphosyntacticStructure rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Adjective" /><aaif:inflection rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Uninflected" /><aaif:attributionTarget rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Verb" /><aaif:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:modified><aaif:semanticClassification rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Manner" /><aaif:reduplicated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:reduplicated><aaif:prepositionalPhrase rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:prepositionalPhrase></aaif:Adverb><aaif:Entry rdf:about="https://gams.uni-graz.at/o:aaif.fraweb#En2172"><aaif:phrase rdf:resource="https://gams.uni-graz.at/o:aaif.fraweb#En2172Ph1" /><aaif:source rdf:resource="https://gams.uni-graz.at/o:aaif.fraweb.bibl#DC2181" /><gams:textualContent>c est coloré, ça parle joyeux , ça parle optimpisme tout cela mieux vivre entouré de belels couleurs</gams:textualContent><rel:isPartOf rdf:resource="https://gams.uni-graz.at/o:aaif.fraweb" /></aaif:Entry><aaif:Phrase rdf:about="https://gams.uni-graz.at/o:aaif.fraweb#En2172Ph1"><aaif:verb rdf:resource="https://gams.uni-graz.at/o:aaif.fraweb#En2172Ph1Ve1" /><aaif:adverb rdf:resource="https://gams.uni-graz.at/o:aaif.fraweb#En2172Ph1Ad1" /><aaif:text>ça parle joyeux , ça parle optimpisme</aaif:text><aaif:annoText>ça [v|parle|parler|is] [a|joyeux|joyeux|ausnmnnn] , ça parle optimpisme</aaif:annoText></aaif:Phrase><aaif:Verb rdf:about="https://gams.uni-graz.at/o:aaif.fraweb#En2172Ph1Ve1"><aaif:text>parle</aaif:text><aaif:lemma rdf:resource="https://gams.uni-graz.at/o:aaif.lemma#parler" /><aaif:position rdf:datatype="http://www.w3.org/2001/XMLSchema#int">1</aaif:position><aaif:coordinated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:coordinated><aaif:partOfText rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</aaif:partOfText><aaif:syntacticConstruction rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Intransitive" /></aaif:Verb><aaif:Adverb rdf:about="https://gams.uni-graz.at/o:aaif.fraweb#En2172Ph1Ad1"><aaif:text>joyeux</aaif:text><aaif:lemma rdf:resource="https://gams.uni-graz.at/o:aaif.lemma#joyeux" /><aaif:position rdf:datatype="http://www.w3.org/2001/XMLSchema#int">2</aaif:position><aaif:coordinated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:coordinated><aaif:morphosyntacticStructure rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Adjective" /><aaif:inflection rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Uninflected" /><aaif:attributionTarget rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Verb" /><aaif:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:modified><aaif:semanticClassification rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Manner" /><aaif:reduplicated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:reduplicated><aaif:prepositionalPhrase rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:prepositionalPhrase></aaif:Adverb><aaif:Entry rdf:about="https://gams.uni-graz.at/o:aaif.fraweb#En2173"><aaif:phrase rdf:resource="https://gams.uni-graz.at/o:aaif.fraweb#En2173Ph1" /><aaif:source rdf:resource="https://gams.uni-graz.at/o:aaif.fraweb.bibl#DC2182" /><gams:textualContent>J’entrevis Pil Guk, je fis un pas vers lui, les individus m’accompagnant me suivirent, mais voyant qu’il parlait joyeux  et avec entrain à d’autres, je décidai de me retirer un peu plus loin.</gams:textualContent><rel:isPartOf rdf:resource="https://gams.uni-graz.at/o:aaif.fraweb" /></aaif:Entry><aaif:Phrase rdf:about="https://gams.uni-graz.at/o:aaif.fraweb#En2173Ph1"><aaif:verb rdf:resource="https://gams.uni-graz.at/o:aaif.fraweb#En2173Ph1Ve1" /><aaif:adverb rdf:resource="https://gams.uni-graz.at/o:aaif.fraweb#En2173Ph1Ad1" /><aaif:text>il parlait joyeux </aaif:text><aaif:annoText>il [v|parlait|parler|is] [a|joyeux|joyeux|ausnmnnn] </aaif:annoText></aaif:Phrase><aaif:Verb rdf:about="https://gams.uni-graz.at/o:aaif.fraweb#En2173Ph1Ve1"><aaif:text>parlait</aaif:text><aaif:lemma rdf:resource="https://gams.uni-graz.at/o:aaif.lemma#parler" /><aaif:position rdf:datatype="http://www.w3.org/2001/XMLSchema#int">1</aaif:position><aaif:coordinated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:coordinated><aaif:partOfText rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</aaif:partOfText><aaif:syntacticConstruction rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Intransitive" /></aaif:Verb><aaif:Adverb rdf:about="https://gams.uni-graz.at/o:aaif.fraweb#En2173Ph1Ad1"><aaif:text>joyeux</aaif:text><aaif:lemma rdf:resource="https://gams.uni-graz.at/o:aaif.lemma#joyeux" /><aaif:position rdf:datatype="http://www.w3.org/2001/XMLSchema#int">2</aaif:position><aaif:coordinated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:coordinated><aaif:morphosyntacticStructure rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Adjective" /><aaif:inflection rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Uninflected" /><aaif:attributionTarget rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Verb" /><aaif:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:modified><aaif:semanticClassification rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Manner" /><aaif:reduplicated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:reduplicated><aaif:prepositionalPhrase rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:prepositionalPhrase></aaif:Adverb><aaif:Entry rdf:about="https://gams.uni-graz.at/o:aaif.fraweb#En2174"><aaif:phrase rdf:resource="https://gams.uni-graz.at/o:aaif.fraweb#En2174Ph1" /><aaif:source rdf:resource="https://gams.uni-graz.at/o:aaif.fraweb.bibl#DC2183" /><gams:textualContent>A Pompéï, sous les fenêtres de l'hôtel les italiens parlaient , joyeux  !</gams:textualContent><rel:isPartOf rdf:resource="https://gams.uni-graz.at/o:aaif.fraweb" /></aaif:Entry><aaif:Phrase rdf:about="https://gams.uni-graz.at/o:aaif.fraweb#En2174Ph1"><aaif:verb rdf:resource="https://gams.uni-graz.at/o:aaif.fraweb#En2174Ph1Ve1" /><aaif:adverb rdf:resource="https://gams.uni-graz.at/o:aaif.fraweb#En2174Ph1Ad1" /><aaif:text>les italiens parlaient , joyeux </aaif:text><aaif:annoText>les italiens [v|parlaient|parler|is] , [a|joyeux|joyeux|ausnmnnn] </aaif:annoText></aaif:Phrase><aaif:Verb rdf:about="https://gams.uni-graz.at/o:aaif.fraweb#En2174Ph1Ve1"><aaif:text>parlaient</aaif:text><aaif:lemma rdf:resource="https://gams.uni-graz.at/o:aaif.lemma#parler" /><aaif:position rdf:datatype="http://www.w3.org/2001/XMLSchema#int">1</aaif:position><aaif:coordinated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:coordinated><aaif:partOfText rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</aaif:partOfText><aaif:syntacticConstruction rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Intransitive" /></aaif:Verb><aaif:Adverb rdf:about="https://gams.uni-graz.at/o:aaif.fraweb#En2174Ph1Ad1"><aaif:text>joyeux</aaif:text><aaif:lemma rdf:resource="https://gams.uni-graz.at/o:aaif.lemma#joyeux" /><aaif:position rdf:datatype="http://www.w3.org/2001/XMLSchema#int">2</aaif:position><aaif:coordinated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:coordinated><aaif:morphosyntacticStructure rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Adjective" /><aaif:inflection rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Uninflected" /><aaif:attributionTarget rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Verb" /><aaif:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:modified><aaif:semanticClassification rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Manner" /><aaif:reduplicated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:reduplicated><aaif:prepositionalPhrase rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:prepositionalPhrase></aaif:Adverb><aaif:Entry rdf:about="https://gams.uni-graz.at/o:aaif.fraweb#En2175"><aaif:phrase rdf:resource="https://gams.uni-graz.at/o:aaif.fraweb#En2175Ph1" /><aaif:source rdf:resource="https://gams.uni-graz.at/o:aaif.fraweb.bibl#DC2184" /><gams:textualContent>Les costumes seront d’époque et le dispositif scénique assez sobre pour laisser une aire de jeu aussi libre que possible.Mais dans un premier temps ce sont les masques qui m’importent, ils sont à concevoir, à inventer, il faut qu’ils parlent juste  et donnent aux personnages une totale crédibilité.</gams:textualContent><rel:isPartOf rdf:resource="https://gams.uni-graz.at/o:aaif.fraweb" /></aaif:Entry><aaif:Phrase rdf:about="https://gams.uni-graz.at/o:aaif.fraweb#En2175Ph1"><aaif:verb rdf:resource="https://gams.uni-graz.at/o:aaif.fraweb#En2175Ph1Ve1" /><aaif:adverb rdf:resource="https://gams.uni-graz.at/o:aaif.fraweb#En2175Ph1Ad1" /><aaif:text>il faut qu’ils parlent juste </aaif:text><aaif:annoText>il faut qu’ils [v|parlent|parler|is] [a|juste|juste|auvnmnnn] </aaif:annoText></aaif:Phrase><aaif:Verb rdf:about="https://gams.uni-graz.at/o:aaif.fraweb#En2175Ph1Ve1"><aaif:text>parlent</aaif:text><aaif:lemma rdf:resource="https://gams.uni-graz.at/o:aaif.lemma#parler" /><aaif:position rdf:datatype="http://www.w3.org/2001/XMLSchema#int">1</aaif:position><aaif:coordinated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:coordinated><aaif:partOfText rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</aaif:partOfText><aaif:syntacticConstruction rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Intransitive" /></aaif:Verb><aaif:Adverb rdf:about="https://gams.uni-graz.at/o:aaif.fraweb#En2175Ph1Ad1"><aaif:text>juste</aaif:text><aaif:lemma rdf:resource="https://gams.uni-graz.at/o:aaif.lemma#juste" /><aaif:position rdf:datatype="http://www.w3.org/2001/XMLSchema#int">2</aaif:position><aaif:coordinated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:coordinated><aaif:morphosyntacticStructure rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Adjective" /><aaif:inflection rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Uninflected" /><aaif:attributionTarget rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Verb" /><aaif:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:modified><aaif:semanticClassification rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Manner" /><aaif:reduplicated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:reduplicated><aaif:prepositionalPhrase rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:prepositionalPhrase></aaif:Adverb><aaif:Entry rdf:about="https://gams.uni-graz.at/o:aaif.fraweb#En2176"><aaif:phrase rdf:resource="https://gams.uni-graz.at/o:aaif.fraweb#En2176Ph1" /><aaif:source rdf:resource="https://gams.uni-graz.at/o:aaif.fraweb.bibl#DC2185" /><gams:textualContent>merci pour ces RV avec le pr Latrémouille et Pierre Joxe qui parlent juste , de façon concise, efficace et refusent que l'interlocuteur pense à leur place.</gams:textualContent><rel:isPartOf rdf:resource="https://gams.uni-graz.at/o:aaif.fraweb" /></aaif:Entry><aaif:Phrase rdf:about="https://gams.uni-graz.at/o:aaif.fraweb#En2176Ph1"><aaif:verb rdf:resource="https://gams.uni-graz.at/o:aaif.fraweb#En2176Ph1Ve1" /><aaif:adverb rdf:resource="https://gams.uni-graz.at/o:aaif.fraweb#En2176Ph1Ad1" /><aaif:text>qui parlent juste , de façon concise, efficace</aaif:text><aaif:annoText>qui [v|parlent|parler|is] [a|juste|juste|auvnmnnC] , de façon concise, efficace</aaif:annoText></aaif:Phrase><aaif:Verb rdf:about="https://gams.uni-graz.at/o:aaif.fraweb#En2176Ph1Ve1"><aaif:text>parlent</aaif:text><aaif:lemma rdf:resource="https://gams.uni-graz.at/o:aaif.lemma#parler" /><aaif:position rdf:datatype="http://www.w3.org/2001/XMLSchema#int">1</aaif:position><aaif:coordinated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:coordinated><aaif:partOfText rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</aaif:partOfText><aaif:syntacticConstruction rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Intransitive" /></aaif:Verb><aaif:Adverb rdf:about="https://gams.uni-graz.at/o:aaif.fraweb#En2176Ph1Ad1"><aaif:text>juste</aaif:text><aaif:lemma rdf:resource="https://gams.uni-graz.at/o:aaif.lemma#juste" /><aaif:position rdf:datatype="http://www.w3.org/2001/XMLSchema#int">2</aaif:position><aaif:coordinated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</aaif:coordinated><aaif:morphosyntacticStructure rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Adjective" /><aaif:inflection rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Uninflected" /><aaif:attributionTarget rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Verb" /><aaif:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:modified><aaif:semanticClassification rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Manner" /><aaif:reduplicated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:reduplicated><aaif:prepositionalPhrase rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:prepositionalPhrase></aaif:Adverb><aaif:Entry rdf:about="https://gams.uni-graz.at/o:aaif.fraweb#En2177"><aaif:phrase rdf:resource="https://gams.uni-graz.at/o:aaif.fraweb#En2177Ph1" /><aaif:source rdf:resource="https://gams.uni-graz.at/o:aaif.fraweb.bibl#DC2186" /><gams:textualContent>Les personnages sonnent « vrais » , ils parlent juste  et ont souvent, malgré la rudesse de la vie, une vision optimiste.</gams:textualContent><rel:isPartOf rdf:resource="https://gams.uni-graz.at/o:aaif.fraweb" /></aaif:Entry><aaif:Phrase rdf:about="https://gams.uni-graz.at/o:aaif.fraweb#En2177Ph1"><aaif:verb rdf:resource="https://gams.uni-graz.at/o:aaif.fraweb#En2177Ph1Ve1" /><aaif:verb rdf:resource="https://gams.uni-graz.at/o:aaif.fraweb#En2177Ph1Ve2" /><aaif:adverb rdf:resource="https://gams.uni-graz.at/o:aaif.fraweb#En2177Ph1Ad1" /><aaif:adverb rdf:resource="https://gams.uni-graz.at/o:aaif.fraweb#En2177Ph1Ad2" /><aaif:text>Les personnages sonnent « vrais » , ils parlent juste </aaif:text><aaif:annoText>Les personnages [v|sonnent|sonner|is] [a|« vrais »|vrai|aisnmnnn] , ils [v|parlent|parler|is] [a|juste|juste|auvnmnnn] </aaif:annoText></aaif:Phrase><aaif:Verb rdf:about="https://gams.uni-graz.at/o:aaif.fraweb#En2177Ph1Ve1"><aaif:text>sonnent</aaif:text><aaif:lemma rdf:resource="https://gams.uni-graz.at/o:aaif.lemma#sonner" /><aaif:position rdf:datatype="http://www.w3.org/2001/XMLSchema#int">1</aaif:position><aaif:coordinated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:coordinated><aaif:partOfText rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</aaif:partOfText><aaif:syntacticConstruction rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Intransitive" /></aaif:Verb><aaif:Verb rdf:about="https://gams.uni-graz.at/o:aaif.fraweb#En2177Ph1Ve2"><aaif:text>parlent</aaif:text><aaif:lemma rdf:resource="https://gams.uni-graz.at/o:aaif.lemma#parler" /><aaif:position rdf:datatype="http://www.w3.org/2001/XMLSchema#int">3</aaif:position><aaif:coordinated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:coordinated><aaif:partOfText rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</aaif:partOfText><aaif:syntacticConstruction rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Intransitive" /></aaif:Verb><aaif:Adverb rdf:about="https://gams.uni-graz.at/o:aaif.fraweb#En2177Ph1Ad1"><aaif:text>« vrais »</aaif:text><aaif:lemma rdf:resource="https://gams.uni-graz.at/o:aaif.lemma#vrai" /><aaif:position rdf:datatype="http://www.w3.org/2001/XMLSchema#int">2</aaif:position><aaif:coordinated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:coordinated><aaif:morphosyntacticStructure rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Adjective" /><aaif:inflection rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#InaudibleInflection" /><aaif:attributionTarget rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Verb" /><aaif:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:modified><aaif:semanticClassification rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Manner" /><aaif:reduplicated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:reduplicated><aaif:prepositionalPhrase rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:prepositionalPhrase></aaif:Adverb><aaif:Adverb rdf:about="https://gams.uni-graz.at/o:aaif.fraweb#En2177Ph1Ad2"><aaif:text>juste</aaif:text><aaif:lemma rdf:resource="https://gams.uni-graz.at/o:aaif.lemma#juste" /><aaif:position rdf:datatype="http://www.w3.org/2001/XMLSchema#int">4</aaif:position><aaif:coordinated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:coordinated><aaif:morphosyntacticStructure rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Adjective" /><aaif:inflection rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Uninflected" /><aaif:attributionTarget rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Verb" /><aaif:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:modified><aaif:semanticClassification rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Manner" /><aaif:reduplicated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:reduplicated><aaif:prepositionalPhrase rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:prepositionalPhrase></aaif:Adverb><aaif:Entry rdf:about="https://gams.uni-graz.at/o:aaif.fraweb#En2178"><aaif:phrase rdf:resource="https://gams.uni-graz.at/o:aaif.fraweb#En2178Ph1" /><aaif:source rdf:resource="https://gams.uni-graz.at/o:aaif.fraweb.bibl#DC2187" /><gams:textualContent>il y en a, qui pour ne vexer personne votent mou quand ils votent, parlent mou  quand ils parlent, et on fait de la mollesse leur cheval de bataille (molle elle aussi).</gams:textualContent><rel:isPartOf rdf:resource="https://gams.uni-graz.at/o:aaif.fraweb" /></aaif:Entry><aaif:Phrase rdf:about="https://gams.uni-graz.at/o:aaif.fraweb#En2178Ph1"><aaif:verb rdf:resource="https://gams.uni-graz.at/o:aaif.fraweb#En2178Ph1Ve1" /><aaif:verb rdf:resource="https://gams.uni-graz.at/o:aaif.fraweb#En2178Ph1Ve2" /><aaif:adverb rdf:resource="https://gams.uni-graz.at/o:aaif.fraweb#En2178Ph1Ad1" /><aaif:adverb rdf:resource="https://gams.uni-graz.at/o:aaif.fraweb#En2178Ph1Ad2" /><aaif:text>pour ne vexer personne votent mou quand ils votent, parlent mou </aaif:text><aaif:annoText>pour ne vexer personne [v|votent|voter|is] [a|mou|mou|auvnmnnn] quand ils votent, [v|parlent|parler|is] [a|mou|mou|auvnmnnn] </aaif:annoText></aaif:Phrase><aaif:Verb rdf:about="https://gams.uni-graz.at/o:aaif.fraweb#En2178Ph1Ve1"><aaif:text>votent</aaif:text><aaif:lemma rdf:resource="https://gams.uni-graz.at/o:aaif.lemma#voter" /><aaif:position rdf:datatype="http://www.w3.org/2001/XMLSchema#int">1</aaif:position><aaif:coordinated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:coordinated><aaif:partOfText rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</aaif:partOfText><aaif:syntacticConstruction rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Intransitive" /></aaif:Verb><aaif:Verb rdf:about="https://gams.uni-graz.at/o:aaif.fraweb#En2178Ph1Ve2"><aaif:text>parlent</aaif:text><aaif:lemma rdf:resource="https://gams.uni-graz.at/o:aaif.lemma#parler" /><aaif:position rdf:datatype="http://www.w3.org/2001/XMLSchema#int">3</aaif:position><aaif:coordinated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:coordinated><aaif:partOfText rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</aaif:partOfText><aaif:syntacticConstruction rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Intransitive" /></aaif:Verb><aaif:Adverb rdf:about="https://gams.uni-graz.at/o:aaif.fraweb#En2178Ph1Ad1"><aaif:text>mou</aaif:text><aaif:lemma rdf:resource="https://gams.uni-graz.at/o:aaif.lemma#mou" /><aaif:position rdf:datatype="http://www.w3.org/2001/XMLSchema#int">2</aaif:position><aaif:coordinated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:coordinated><aaif:morphosyntacticStructure rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Adjective" /><aaif:inflection rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Uninflected" /><aaif:attributionTarget rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Verb" /><aaif:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:modified><aaif:semanticClassification rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Manner" /><aaif:reduplicated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:reduplicated><aaif:prepositionalPhrase rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:prepositionalPhrase></aaif:Adverb><aaif:Adverb rdf:about="https://gams.uni-graz.at/o:aaif.fraweb#En2178Ph1Ad2"><aaif:text>mou</aaif:text><aaif:lemma rdf:resource="https://gams.uni-graz.at/o:aaif.lemma#mou" /><aaif:position rdf:datatype="http://www.w3.org/2001/XMLSchema#int">4</aaif:position><aaif:coordinated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:coordinated><aaif:morphosyntacticStructure rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Adjective" /><aaif:inflection rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Uninflected" /><aaif:attributionTarget rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Verb" /><aaif:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:modified><aaif:semanticClassification rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Manner" /><aaif:reduplicated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:reduplicated><aaif:prepositionalPhrase rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:prepositionalPhrase></aaif:Adverb><aaif:Entry rdf:about="https://gams.uni-graz.at/o:aaif.fraweb#En2179"><aaif:phrase rdf:resource="https://gams.uni-graz.at/o:aaif.fraweb#En2179Ph1" /><aaif:source rdf:resource="https://gams.uni-graz.at/o:aaif.fraweb.bibl#DC2188" /><gams:textualContent>C’est juste ce qui encombre ta vie malgré toi — qui te colle aux adidas dès que tu bouges un pied sur les trottoirs sans mégot jonchés de merdes avant Demain [les chiens], alors que le bruit alentour résulte sans raisonner même pas d’une trace de civilité quand ils parlent mou  , sur la pointe des pieds pour ne pas salir leurs Timberland(s) — et qui explose à raison de plusieurs détails par page.</gams:textualContent><rel:isPartOf rdf:resource="https://gams.uni-graz.at/o:aaif.fraweb" /></aaif:Entry><aaif:Phrase rdf:about="https://gams.uni-graz.at/o:aaif.fraweb#En2179Ph1"><aaif:verb rdf:resource="https://gams.uni-graz.at/o:aaif.fraweb#En2179Ph1Ve1" /><aaif:adverb rdf:resource="https://gams.uni-graz.at/o:aaif.fraweb#En2179Ph1Ad1" /><aaif:text>ils parlent mou </aaif:text><aaif:annoText>ils [v|parlent|parler|is] [a|mou|mou|auvnmnnn] </aaif:annoText></aaif:Phrase><aaif:Verb rdf:about="https://gams.uni-graz.at/o:aaif.fraweb#En2179Ph1Ve1"><aaif:text>parlent</aaif:text><aaif:lemma rdf:resource="https://gams.uni-graz.at/o:aaif.lemma#parler" /><aaif:position rdf:datatype="http://www.w3.org/2001/XMLSchema#int">1</aaif:position><aaif:coordinated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:coordinated><aaif:partOfText rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</aaif:partOfText><aaif:syntacticConstruction rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Intransitive" /></aaif:Verb><aaif:Adverb rdf:about="https://gams.uni-graz.at/o:aaif.fraweb#En2179Ph1Ad1"><aaif:text>mou</aaif:text><aaif:lemma rdf:resource="https://gams.uni-graz.at/o:aaif.lemma#mou" /><aaif:position rdf:datatype="http://www.w3.org/2001/XMLSchema#int">2</aaif:position><aaif:coordinated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:coordinated><aaif:morphosyntacticStructure rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Adjective" /><aaif:inflection rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Uninflected" /><aaif:attributionTarget rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Verb" /><aaif:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:modified><aaif:semanticClassification rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Manner" /><aaif:reduplicated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:reduplicated><aaif:prepositionalPhrase rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:prepositionalPhrase></aaif:Adverb><aaif:Entry rdf:about="https://gams.uni-graz.at/o:aaif.fraweb#En2180"><aaif:phrase rdf:resource="https://gams.uni-graz.at/o:aaif.fraweb#En2180Ph1" /><aaif:source rdf:resource="https://gams.uni-graz.at/o:aaif.fraweb.bibl#DC2189" /><gams:textualContent>Pas étonnant de voir que vos porte-étendards sont des brûlés de la Mescaline qui parlent mou  , qui n'ont pas assez de respect pour eux et les autres, pour laver comme il se doit un simple pare-brise, et qu'aussitôt le fruit de leur labeur empoché, il retombe directement dans les poches du crime organisé.</gams:textualContent><rel:isPartOf rdf:resource="https://gams.uni-graz.at/o:aaif.fraweb" /></aaif:Entry><aaif:Phrase rdf:about="https://gams.uni-graz.at/o:aaif.fraweb#En2180Ph1"><aaif:verb rdf:resource="https://gams.uni-graz.at/o:aaif.fraweb#En2180Ph1Ve1" /><aaif:adverb rdf:resource="https://gams.uni-graz.at/o:aaif.fraweb#En2180Ph1Ad1" /><aaif:text>qui parlent mou </aaif:text><aaif:annoText>qui [v|parlent|parler|is] [a|mou|mou|auvnmnnn] </aaif:annoText></aaif:Phrase><aaif:Verb rdf:about="https://gams.uni-graz.at/o:aaif.fraweb#En2180Ph1Ve1"><aaif:text>parlent</aaif:text><aaif:lemma rdf:resource="https://gams.uni-graz.at/o:aaif.lemma#parler" /><aaif:position rdf:datatype="http://www.w3.org/2001/XMLSchema#int">1</aaif:position><aaif:coordinated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:coordinated><aaif:partOfText rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</aaif:partOfText><aaif:syntacticConstruction rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Intransitive" /></aaif:Verb><aaif:Adverb rdf:about="https://gams.uni-graz.at/o:aaif.fraweb#En2180Ph1Ad1"><aaif:text>mou</aaif:text><aaif:lemma rdf:resource="https://gams.uni-graz.at/o:aaif.lemma#mou" /><aaif:position rdf:datatype="http://www.w3.org/2001/XMLSchema#int">2</aaif:position><aaif:coordinated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:coordinated><aaif:morphosyntacticStructure rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Adjective" /><aaif:inflection rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Uninflected" /><aaif:attributionTarget rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Verb" /><aaif:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:modified><aaif:semanticClassification rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Manner" /><aaif:reduplicated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:reduplicated><aaif:prepositionalPhrase rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:prepositionalPhrase></aaif:Adverb><aaif:Entry rdf:about="https://gams.uni-graz.at/o:aaif.fraweb#En2181"><aaif:phrase rdf:resource="https://gams.uni-graz.at/o:aaif.fraweb#En2181Ph1" /><aaif:source rdf:resource="https://gams.uni-graz.at/o:aaif.fraweb.bibl#DC2190" /><gams:textualContent>Elles sont trash, elles parlent net  , elles poussent des vrais coups de gueule, lancent les débats et clash sans pitié.Pas de chichis et de clichés, de “trucs de filles” ici: voilà six Bad Girls qui cartonnent sur le web.</gams:textualContent><rel:isPartOf rdf:resource="https://gams.uni-graz.at/o:aaif.fraweb" /></aaif:Entry><aaif:Phrase rdf:about="https://gams.uni-graz.at/o:aaif.fraweb#En2181Ph1"><aaif:verb rdf:resource="https://gams.uni-graz.at/o:aaif.fraweb#En2181Ph1Ve1" /><aaif:adverb rdf:resource="https://gams.uni-graz.at/o:aaif.fraweb#En2181Ph1Ad1" /><aaif:text>elles parlent net </aaif:text><aaif:annoText>elles [v|parlent|parler|is] [a|net|net|auvnmnnn] </aaif:annoText></aaif:Phrase><aaif:Verb rdf:about="https://gams.uni-graz.at/o:aaif.fraweb#En2181Ph1Ve1"><aaif:text>parlent</aaif:text><aaif:lemma rdf:resource="https://gams.uni-graz.at/o:aaif.lemma#parler" /><aaif:position rdf:datatype="http://www.w3.org/2001/XMLSchema#int">1</aaif:position><aaif:coordinated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:coordinated><aaif:partOfText rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</aaif:partOfText><aaif:syntacticConstruction rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Intransitive" /></aaif:Verb><aaif:Adverb rdf:about="https://gams.uni-graz.at/o:aaif.fraweb#En2181Ph1Ad1"><aaif:text>net</aaif:text><aaif:lemma rdf:resource="https://gams.uni-graz.at/o:aaif.lemma#net" /><aaif:position rdf:datatype="http://www.w3.org/2001/XMLSchema#int">2</aaif:position><aaif:coordinated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:coordinated><aaif:morphosyntacticStructure rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Adjective" /><aaif:inflection rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Uninflected" /><aaif:attributionTarget rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Verb" /><aaif:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:modified><aaif:semanticClassification rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Manner" /><aaif:reduplicated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:reduplicated><aaif:prepositionalPhrase rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:prepositionalPhrase></aaif:Adverb><aaif:Entry rdf:about="https://gams.uni-graz.at/o:aaif.fraweb#En2182"><aaif:phrase rdf:resource="https://gams.uni-graz.at/o:aaif.fraweb#En2182Ph1" /><aaif:source rdf:resource="https://gams.uni-graz.at/o:aaif.fraweb.bibl#DC2191" /><gams:textualContent>Tout en se méfiant du prisme spectaculaire - et souvent déformant - de ces groupuscules qui parlent net , haut et fort  , vis-à-vis de masses souvent silencieuses qui forment pourtant le gros des troupes, l'air du temps religieux, celui qui « fait parler » et qui « fait bouger », est à l'intransigeance contre ce qu'il est convenu d'appeler « l'esprit du monde ».</gams:textualContent><rel:isPartOf rdf:resource="https://gams.uni-graz.at/o:aaif.fraweb" /></aaif:Entry><aaif:Phrase rdf:about="https://gams.uni-graz.at/o:aaif.fraweb#En2182Ph1"><aaif:verb rdf:resource="https://gams.uni-graz.at/o:aaif.fraweb#En2182Ph1Ve1" /><aaif:adverb rdf:resource="https://gams.uni-graz.at/o:aaif.fraweb#En2182Ph1Ad1" /><aaif:adverb rdf:resource="https://gams.uni-graz.at/o:aaif.fraweb#En2182Ph1Ad2" /><aaif:adverb rdf:resource="https://gams.uni-graz.at/o:aaif.fraweb#En2182Ph1Ad3" /><aaif:text>de ces groupuscules qui parlent net , haut et fort </aaif:text><aaif:annoText>de ces groupuscules qui [v|parlent|parler|is] [a|net|net|auvnmnnC] , [a|haut|haut|auvnmnnC] et [a|fort|fort|auvnmnnC] </aaif:annoText></aaif:Phrase><aaif:Verb rdf:about="https://gams.uni-graz.at/o:aaif.fraweb#En2182Ph1Ve1"><aaif:text>parlent</aaif:text><aaif:lemma rdf:resource="https://gams.uni-graz.at/o:aaif.lemma#parler" /><aaif:position rdf:datatype="http://www.w3.org/2001/XMLSchema#int">1</aaif:position><aaif:coordinated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:coordinated><aaif:partOfText rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</aaif:partOfText><aaif:syntacticConstruction rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Intransitive" /></aaif:Verb><aaif:Adverb rdf:about="https://gams.uni-graz.at/o:aaif.fraweb#En2182Ph1Ad1"><aaif:text>net</aaif:text><aaif:lemma rdf:resource="https://gams.uni-graz.at/o:aaif.lemma#net" /><aaif:position rdf:datatype="http://www.w3.org/2001/XMLSchema#int">2</aaif:position><aaif:coordinated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</aaif:coordinated><aaif:morphosyntacticStructure rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Adjective" /><aaif:inflection rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Uninflected" /><aaif:attributionTarget rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Verb" /><aaif:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:modified><aaif:semanticClassification rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Manner" /><aaif:reduplicated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:reduplicated><aaif:prepositionalPhrase rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:prepositionalPhrase></aaif:Adverb><aaif:Adverb rdf:about="https://gams.uni-graz.at/o:aaif.fraweb#En2182Ph1Ad2"><aaif:text>haut</aaif:text><aaif:lemma rdf:resource="https://gams.uni-graz.at/o:aaif.lemma#haut" /><aaif:position rdf:datatype="http://www.w3.org/2001/XMLSchema#int">3</aaif:position><aaif:coordinated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</aaif:coordinated><aaif:morphosyntacticStructure rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Adjective" /><aaif:inflection rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Uninflected" /><aaif:attributionTarget rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Verb" /><aaif:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:modified><aaif:semanticClassification rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Manner" /><aaif:reduplicated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:reduplicated><aaif:prepositionalPhrase rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:prepositionalPhrase></aaif:Adverb><aaif:Adverb rdf:about="https://gams.uni-graz.at/o:aaif.fraweb#En2182Ph1Ad3"><aaif:text>fort</aaif:text><aaif:lemma rdf:resource="https://gams.uni-graz.at/o:aaif.lemma#fort" /><aaif:position rdf:datatype="http://www.w3.org/2001/XMLSchema#int">4</aaif:position><aaif:coordinated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</aaif:coordinated><aaif:morphosyntacticStructure rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Adjective" /><aaif:inflection rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Uninflected" /><aaif:attributionTarget rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Verb" /><aaif:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:modified><aaif:semanticClassification rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Manner" /><aaif:reduplicated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:reduplicated><aaif:prepositionalPhrase rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:prepositionalPhrase></aaif:Adverb><aaif:Entry rdf:about="https://gams.uni-graz.at/o:aaif.fraweb#En2183"><aaif:phrase rdf:resource="https://gams.uni-graz.at/o:aaif.fraweb#En2183Ph1" /><aaif:source rdf:resource="https://gams.uni-graz.at/o:aaif.fraweb.bibl#DC2192" /><gams:textualContent>Un succès mérité !&lt;lb/&gt;Quelques chiffres qui parlent net  : 392 adhérents (dont 102 hommes et 290 femmes) dès le mois de septembre (à noter : 60% d’entre eux ont entre 50 et 70 ans).</gams:textualContent><rel:isPartOf rdf:resource="https://gams.uni-graz.at/o:aaif.fraweb" /></aaif:Entry><aaif:Phrase rdf:about="https://gams.uni-graz.at/o:aaif.fraweb#En2183Ph1"><aaif:verb rdf:resource="https://gams.uni-graz.at/o:aaif.fraweb#En2183Ph1Ve1" /><aaif:adverb rdf:resource="https://gams.uni-graz.at/o:aaif.fraweb#En2183Ph1Ad1" /><aaif:text>Quelques chiffres qui parlent net </aaif:text><aaif:annoText>Quelques chiffres qui [v|parlent|parler|is] [a|net|net|auvnmnnn] </aaif:annoText></aaif:Phrase><aaif:Verb rdf:about="https://gams.uni-graz.at/o:aaif.fraweb#En2183Ph1Ve1"><aaif:text>parlent</aaif:text><aaif:lemma rdf:resource="https://gams.uni-graz.at/o:aaif.lemma#parler" /><aaif:position rdf:datatype="http://www.w3.org/2001/XMLSchema#int">1</aaif:position><aaif:coordinated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:coordinated><aaif:partOfText rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</aaif:partOfText><aaif:syntacticConstruction rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Intransitive" /></aaif:Verb><aaif:Adverb rdf:about="https://gams.uni-graz.at/o:aaif.fraweb#En2183Ph1Ad1"><aaif:text>net</aaif:text><aaif:lemma rdf:resource="https://gams.uni-graz.at/o:aaif.lemma#net" /><aaif:position rdf:datatype="http://www.w3.org/2001/XMLSchema#int">2</aaif:position><aaif:coordinated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:coordinated><aaif:morphosyntacticStructure rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Adjective" /><aaif:inflection rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Uninflected" /><aaif:attributionTarget rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Verb" /><aaif:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:modified><aaif:semanticClassification rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Manner" /><aaif:reduplicated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:reduplicated><aaif:prepositionalPhrase rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:prepositionalPhrase></aaif:Adverb><aaif:Entry rdf:about="https://gams.uni-graz.at/o:aaif.fraweb#En2184"><aaif:phrase rdf:resource="https://gams.uni-graz.at/o:aaif.fraweb#En2184Ph1" /><aaif:source rdf:resource="https://gams.uni-graz.at/o:aaif.fraweb.bibl#DC2193" /><gams:textualContent>L'apprentissage forcé au français par la lecture de nos parents à l'école fait que nous parlons celui-ci "plat" en prononçant toutes les lettres, en fait dans le midi on n'a pas d'accent quand on parle français, ce sont les "francimands" qui parlent "pointu"  .</gams:textualContent><rel:isPartOf rdf:resource="https://gams.uni-graz.at/o:aaif.fraweb" /></aaif:Entry><aaif:Phrase rdf:about="https://gams.uni-graz.at/o:aaif.fraweb#En2184Ph1"><aaif:verb rdf:resource="https://gams.uni-graz.at/o:aaif.fraweb#En2184Ph1Ve1" /><aaif:adverb rdf:resource="https://gams.uni-graz.at/o:aaif.fraweb#En2184Ph1Ad1" /><aaif:text>les \"francimands\" qui parlent \"pointu\" </aaif:text><aaif:annoText>les \"francimands\" qui [v|parlent|parler|is] [a|\"pointu\"|pointu|auvnmnnn] </aaif:annoText></aaif:Phrase><aaif:Verb rdf:about="https://gams.uni-graz.at/o:aaif.fraweb#En2184Ph1Ve1"><aaif:text>parlent</aaif:text><aaif:lemma rdf:resource="https://gams.uni-graz.at/o:aaif.lemma#parler" /><aaif:position rdf:datatype="http://www.w3.org/2001/XMLSchema#int">1</aaif:position><aaif:coordinated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:coordinated><aaif:partOfText rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</aaif:partOfText><aaif:syntacticConstruction rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Intransitive" /></aaif:Verb><aaif:Adverb rdf:about="https://gams.uni-graz.at/o:aaif.fraweb#En2184Ph1Ad1"><aaif:text>\"pointu\"</aaif:text><aaif:lemma rdf:resource="https://gams.uni-graz.at/o:aaif.lemma#pointu" /><aaif:position rdf:datatype="http://www.w3.org/2001/XMLSchema#int">2</aaif:position><aaif:coordinated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:coordinated><aaif:morphosyntacticStructure rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Adjective" /><aaif:inflection rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Uninflected" /><aaif:attributionTarget rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Verb" /><aaif:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:modified><aaif:semanticClassification rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Manner" /><aaif:reduplicated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:reduplicated><aaif:prepositionalPhrase rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:prepositionalPhrase></aaif:Adverb><aaif:Entry rdf:about="https://gams.uni-graz.at/o:aaif.fraweb#En2185"><aaif:phrase rdf:resource="https://gams.uni-graz.at/o:aaif.fraweb#En2185Ph1" /><aaif:source rdf:resource="https://gams.uni-graz.at/o:aaif.fraweb.bibl#DC2194" /><gams:textualContent>Aujourd'hui chez Jeannine, les adultes parlent pointu  autour d'un picon bière, pendant que les gosses du quartier trouvent un terrain de jeu privilégié et bienveillant, pour le plus grand bonheur des parents.</gams:textualContent><rel:isPartOf rdf:resource="https://gams.uni-graz.at/o:aaif.fraweb" /></aaif:Entry><aaif:Phrase rdf:about="https://gams.uni-graz.at/o:aaif.fraweb#En2185Ph1"><aaif:verb rdf:resource="https://gams.uni-graz.at/o:aaif.fraweb#En2185Ph1Ve1" /><aaif:adverb rdf:resource="https://gams.uni-graz.at/o:aaif.fraweb#En2185Ph1Ad1" /><aaif:text>les adultes parlent pointu </aaif:text><aaif:annoText>les adultes [v|parlent|parler|is] [a|pointu|pointu|auvnmnnn] </aaif:annoText></aaif:Phrase><aaif:Verb rdf:about="https://gams.uni-graz.at/o:aaif.fraweb#En2185Ph1Ve1"><aaif:text>parlent</aaif:text><aaif:lemma rdf:resource="https://gams.uni-graz.at/o:aaif.lemma#parler" /><aaif:position rdf:datatype="http://www.w3.org/2001/XMLSchema#int">1</aaif:position><aaif:coordinated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:coordinated><aaif:partOfText rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</aaif:partOfText><aaif:syntacticConstruction rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Intransitive" /></aaif:Verb><aaif:Adverb rdf:about="https://gams.uni-graz.at/o:aaif.fraweb#En2185Ph1Ad1"><aaif:text>pointu</aaif:text><aaif:lemma rdf:resource="https://gams.uni-graz.at/o:aaif.lemma#pointu" /><aaif:position rdf:datatype="http://www.w3.org/2001/XMLSchema#int">2</aaif:position><aaif:coordinated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:coordinated><aaif:morphosyntacticStructure rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Adjective" /><aaif:inflection rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Uninflected" /><aaif:attributionTarget rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Verb" /><aaif:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:modified><aaif:semanticClassification rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Manner" /><aaif:reduplicated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:reduplicated><aaif:prepositionalPhrase rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:prepositionalPhrase></aaif:Adverb><aaif:Entry rdf:about="https://gams.uni-graz.at/o:aaif.fraweb#En2186"><aaif:phrase rdf:resource="https://gams.uni-graz.at/o:aaif.fraweb#En2186Ph1" /><aaif:phrase rdf:resource="https://gams.uni-graz.at/o:aaif.fraweb#En2186Ph2" /><aaif:source rdf:resource="https://gams.uni-graz.at/o:aaif.fraweb.bibl#DC2195" /><gams:textualContent>Les gens des hauts plateaux, boliviens de la Paz, péruviens de la Sierra, équatoriens, colombiens de Bogota, mexicains de Mexico, parlent pointu , bref et sibilant  , raccourcissent les voyelles ; ceux de la plaine, argentins de la Pampa, uruguayens, ilaneros du Vénezuela et de la Colombie parlent allongé  avec des voyelles qui s’allongent à l’image de l’horizon infini ; et enfin ceux des tropiques parlent les lèvres si écartées qu’aucune consonne ne saurait s’y installer.</gams:textualContent><rel:isPartOf rdf:resource="https://gams.uni-graz.at/o:aaif.fraweb" /></aaif:Entry><aaif:Phrase rdf:about="https://gams.uni-graz.at/o:aaif.fraweb#En2186Ph1"><aaif:verb rdf:resource="https://gams.uni-graz.at/o:aaif.fraweb#En2186Ph1Ve1" /><aaif:adverb rdf:resource="https://gams.uni-graz.at/o:aaif.fraweb#En2186Ph1Ad1" /><aaif:adverb rdf:resource="https://gams.uni-graz.at/o:aaif.fraweb#En2186Ph1Ad2" /><aaif:adverb rdf:resource="https://gams.uni-graz.at/o:aaif.fraweb#En2186Ph1Ad3" /><aaif:text>Les gens des hauts plateaux, boliviens de la Paz, péruviens de la Sierra, équatoriens, colombiens de Bogota, mexicains de Mexico, parlent pointu , bref et sibilant </aaif:text><aaif:annoText>Les gens des hauts plateaux, boliviens de la Paz, péruviens de la Sierra, équatoriens, colombiens de Bogota, mexicains de Mexico, [v|parlent|parler|is] [a|pointu|pointu|auvnmnnC] , [a|bref|bref|auvntnnC] et [a|sibilant|sibilant|auvnmnnC] </aaif:annoText></aaif:Phrase><aaif:Verb rdf:about="https://gams.uni-graz.at/o:aaif.fraweb#En2186Ph1Ve1"><aaif:text>parlent</aaif:text><aaif:lemma rdf:resource="https://gams.uni-graz.at/o:aaif.lemma#parler" /><aaif:position rdf:datatype="http://www.w3.org/2001/XMLSchema#int">1</aaif:position><aaif:coordinated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:coordinated><aaif:partOfText rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</aaif:partOfText><aaif:syntacticConstruction rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Intransitive" /></aaif:Verb><aaif:Adverb rdf:about="https://gams.uni-graz.at/o:aaif.fraweb#En2186Ph1Ad1"><aaif:text>pointu</aaif:text><aaif:lemma rdf:resource="https://gams.uni-graz.at/o:aaif.lemma#pointu" /><aaif:position rdf:datatype="http://www.w3.org/2001/XMLSchema#int">2</aaif:position><aaif:coordinated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</aaif:coordinated><aaif:morphosyntacticStructure rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Adjective" /><aaif:inflection rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Uninflected" /><aaif:attributionTarget rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Verb" /><aaif:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:modified><aaif:semanticClassification rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Manner" /><aaif:reduplicated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:reduplicated><aaif:prepositionalPhrase rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:prepositionalPhrase></aaif:Adverb><aaif:Adverb rdf:about="https://gams.uni-graz.at/o:aaif.fraweb#En2186Ph1Ad2"><aaif:text>bref</aaif:text><aaif:lemma rdf:resource="https://gams.uni-graz.at/o:aaif.lemma#bref" /><aaif:position rdf:datatype="http://www.w3.org/2001/XMLSchema#int">3</aaif:position><aaif:coordinated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</aaif:coordinated><aaif:morphosyntacticStructure rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Adjective" /><aaif:inflection rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Uninflected" /><aaif:attributionTarget rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Verb" /><aaif:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:modified><aaif:semanticClassification rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Time" /><aaif:reduplicated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:reduplicated><aaif:prepositionalPhrase rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:prepositionalPhrase></aaif:Adverb><aaif:Adverb rdf:about="https://gams.uni-graz.at/o:aaif.fraweb#En2186Ph1Ad3"><aaif:text>sibilant</aaif:text><aaif:lemma rdf:resource="https://gams.uni-graz.at/o:aaif.lemma#sibilant" /><aaif:position rdf:datatype="http://www.w3.org/2001/XMLSchema#int">4</aaif:position><aaif:coordinated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</aaif:coordinated><aaif:morphosyntacticStructure rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Adjective" /><aaif:inflection rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Uninflected" /><aaif:attributionTarget rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Verb" /><aaif:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:modified><aaif:semanticClassification rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Manner" /><aaif:reduplicated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:reduplicated><aaif:prepositionalPhrase rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:prepositionalPhrase></aaif:Adverb><aaif:Phrase rdf:about="https://gams.uni-graz.at/o:aaif.fraweb#En2186Ph2"><aaif:verb rdf:resource="https://gams.uni-graz.at/o:aaif.fraweb#En2186Ph2Ve1" /><aaif:adverb rdf:resource="https://gams.uni-graz.at/o:aaif.fraweb#En2186Ph2Ad1" /><aaif:text>ceux de la plaine, argentins de la Pampa, uruguayens, ilaneros du Vénezuela et de la Colombie parlent allongé </aaif:text><aaif:annoText>ceux de la plaine, argentins de la Pampa, uruguayens, ilaneros du Vénezuela et de la Colombie [v|parlent|parler|is] [a|allongé|allongé|auvnmnnn] </aaif:annoText></aaif:Phrase><aaif:Verb rdf:about="https://gams.uni-graz.at/o:aaif.fraweb#En2186Ph2Ve1"><aaif:text>parlent</aaif:text><aaif:lemma rdf:resource="https://gams.uni-graz.at/o:aaif.lemma#parler" /><aaif:position rdf:datatype="http://www.w3.org/2001/XMLSchema#int">1</aaif:position><aaif:coordinated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:coordinated><aaif:partOfText rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</aaif:partOfText><aaif:syntacticConstruction rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Intransitive" /></aaif:Verb><aaif:Adverb rdf:about="https://gams.uni-graz.at/o:aaif.fraweb#En2186Ph2Ad1"><aaif:text>allongé</aaif:text><aaif:lemma rdf:resource="https://gams.uni-graz.at/o:aaif.lemma#allongé" /><aaif:position rdf:datatype="http://www.w3.org/2001/XMLSchema#int">2</aaif:position><aaif:coordinated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:coordinated><aaif:morphosyntacticStructure rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Adjective" /><aaif:inflection rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Uninflected" /><aaif:attributionTarget rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Verb" /><aaif:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:modified><aaif:semanticClassification rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Manner" /><aaif:reduplicated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:reduplicated><aaif:prepositionalPhrase rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:prepositionalPhrase></aaif:Adverb><aaif:Entry rdf:about="https://gams.uni-graz.at/o:aaif.fraweb#En2187"><aaif:phrase rdf:resource="https://gams.uni-graz.at/o:aaif.fraweb#En2187Ph1" /><aaif:source rdf:resource="https://gams.uni-graz.at/o:aaif.fraweb.bibl#DC2196" /><gams:textualContent>Travailleur de longue haleine dans un univers de beatmakers en mode livraison rapide, Skread porte sa réussite sur lui.Le blondinet parle précis  , d’une voix mesurée, et sait où il va :</gams:textualContent><rel:isPartOf rdf:resource="https://gams.uni-graz.at/o:aaif.fraweb" /></aaif:Entry><aaif:Phrase rdf:about="https://gams.uni-graz.at/o:aaif.fraweb#En2187Ph1"><aaif:verb rdf:resource="https://gams.uni-graz.at/o:aaif.fraweb#En2187Ph1Ve1" /><aaif:adverb rdf:resource="https://gams.uni-graz.at/o:aaif.fraweb#En2187Ph1Ad1" /><aaif:text>Le blondinet parle précis </aaif:text><aaif:annoText>Le blondinet [v|parle|parler|is] [a|précis|précis|auvnmnnn] </aaif:annoText></aaif:Phrase><aaif:Verb rdf:about="https://gams.uni-graz.at/o:aaif.fraweb#En2187Ph1Ve1"><aaif:text>parle</aaif:text><aaif:lemma rdf:resource="https://gams.uni-graz.at/o:aaif.lemma#parler" /><aaif:position rdf:datatype="http://www.w3.org/2001/XMLSchema#int">1</aaif:position><aaif:coordinated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:coordinated><aaif:partOfText rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</aaif:partOfText><aaif:syntacticConstruction rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Intransitive" /></aaif:Verb><aaif:Adverb rdf:about="https://gams.uni-graz.at/o:aaif.fraweb#En2187Ph1Ad1"><aaif:text>précis</aaif:text><aaif:lemma rdf:resource="https://gams.uni-graz.at/o:aaif.lemma#précis" /><aaif:position rdf:datatype="http://www.w3.org/2001/XMLSchema#int">2</aaif:position><aaif:coordinated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:coordinated><aaif:morphosyntacticStructure rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Adjective" /><aaif:inflection rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Uninflected" /><aaif:attributionTarget rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Verb" /><aaif:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:modified><aaif:semanticClassification rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Manner" /><aaif:reduplicated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:reduplicated><aaif:prepositionalPhrase rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:prepositionalPhrase></aaif:Adverb><aaif:Entry rdf:about="https://gams.uni-graz.at/o:aaif.fraweb#En2188"><aaif:phrase rdf:resource="https://gams.uni-graz.at/o:aaif.fraweb#En2188Ph1" /><aaif:source rdf:resource="https://gams.uni-graz.at/o:aaif.fraweb.bibl#DC2197" /><gams:textualContent>La timidité contrariée par sa réputation.Il parle précis  .D’une voix minuscule qui se transforme en ciseau aiguisé lorsqu’il chante.</gams:textualContent><rel:isPartOf rdf:resource="https://gams.uni-graz.at/o:aaif.fraweb" /></aaif:Entry><aaif:Phrase rdf:about="https://gams.uni-graz.at/o:aaif.fraweb#En2188Ph1"><aaif:verb rdf:resource="https://gams.uni-graz.at/o:aaif.fraweb#En2188Ph1Ve1" /><aaif:adverb rdf:resource="https://gams.uni-graz.at/o:aaif.fraweb#En2188Ph1Ad1" /><aaif:text>Il parle précis </aaif:text><aaif:annoText>Il [v|parle|parler|is] [a|précis|précis|auvnmnnn] </aaif:annoText></aaif:Phrase><aaif:Verb rdf:about="https://gams.uni-graz.at/o:aaif.fraweb#En2188Ph1Ve1"><aaif:text>parle</aaif:text><aaif:lemma rdf:resource="https://gams.uni-graz.at/o:aaif.lemma#parler" /><aaif:position rdf:datatype="http://www.w3.org/2001/XMLSchema#int">1</aaif:position><aaif:coordinated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:coordinated><aaif:partOfText rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</aaif:partOfText><aaif:syntacticConstruction rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Intransitive" /></aaif:Verb><aaif:Adverb rdf:about="https://gams.uni-graz.at/o:aaif.fraweb#En2188Ph1Ad1"><aaif:text>précis</aaif:text><aaif:lemma rdf:resource="https://gams.uni-graz.at/o:aaif.lemma#précis" /><aaif:position rdf:datatype="http://www.w3.org/2001/XMLSchema#int">2</aaif:position><aaif:coordinated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:coordinated><aaif:morphosyntacticStructure rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Adjective" /><aaif:inflection rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Uninflected" /><aaif:attributionTarget rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Verb" /><aaif:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:modified><aaif:semanticClassification rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Manner" /><aaif:reduplicated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:reduplicated><aaif:prepositionalPhrase rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:prepositionalPhrase></aaif:Adverb><aaif:Entry rdf:about="https://gams.uni-graz.at/o:aaif.fraweb#En2189"><aaif:phrase rdf:resource="https://gams.uni-graz.at/o:aaif.fraweb#En2189Ph1" /><aaif:source rdf:resource="https://gams.uni-graz.at/o:aaif.fraweb.bibl#DC2198" /><gams:textualContent>Ce témoignage nous parle , précis , juste , poignant  </gams:textualContent><rel:isPartOf rdf:resource="https://gams.uni-graz.at/o:aaif.fraweb" /></aaif:Entry><aaif:Phrase rdf:about="https://gams.uni-graz.at/o:aaif.fraweb#En2189Ph1"><aaif:verb rdf:resource="https://gams.uni-graz.at/o:aaif.fraweb#En2189Ph1Ve1" /><aaif:adverb rdf:resource="https://gams.uni-graz.at/o:aaif.fraweb#En2189Ph1Ad1" /><aaif:adverb rdf:resource="https://gams.uni-graz.at/o:aaif.fraweb#En2189Ph1Ad2" /><aaif:adverb rdf:resource="https://gams.uni-graz.at/o:aaif.fraweb#En2189Ph1Ad3" /><aaif:text>Ce témoignage nous parle , précis , juste , poignant </aaif:text><aaif:annoText>Ce témoignag