En3691Ph1Ad1" /><aaif:text>Gant 100% coton tricoté léger </aaif:text><aaif:annoText>Gant 100% coton [v|tricoté|tricoter|ts] [a|léger|léger|auanmnnn] </aaif:annoText></aaif:Phrase><aaif:Verb rdf:about="https://gams.uni-graz.at/o:aaif.fraweb#En3691Ph1Ve1"><aaif:text>tricoté</aaif:text><aaif:lemma rdf:resource="https://gams.uni-graz.at/o:aaif.lemma#tricoter" /><aaif:position rdf:datatype="http://www.w3.org/2001/XMLSchema#int">1</aaif:position><aaif:coordinated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:coordinated><aaif:partOfText rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</aaif:partOfText><aaif:syntacticConstruction rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Transitive" /></aaif:Verb><aaif:Adverb rdf:about="https://gams.uni-graz.at/o:aaif.fraweb#En3691Ph1Ad1"><aaif:text>léger</aaif:text><aaif:lemma rdf:resource="https://gams.uni-graz.at/o:aaif.lemma#léger" /><aaif:position rdf:datatype="http://www.w3.org/2001/XMLSchema#int">2</aaif:position><aaif:coordinated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:coordinated><aaif:morphosyntacticStructure rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Adjective" /><aaif:inflection rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Uninflected" /><aaif:attributionTarget rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Adjective" /><aaif:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:modified><aaif:semanticClassification rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Manner" /><aaif:reduplicated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:reduplicated><aaif:prepositionalPhrase rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:prepositionalPhrase></aaif:Adverb><aaif:Entry rdf:about="https://gams.uni-graz.at/o:aaif.fraweb#En3692"><aaif:phrase rdf:resource="https://gams.uni-graz.at/o:aaif.fraweb#En3692Ph1" /><aaif:source rdf:resource="https://gams.uni-graz.at/o:aaif.fraweb.bibl#DC3710" /><gams:textualContent>Fil à tricoter léger et volumineux  , Seraina de Lang Yarns se présente sous l'aspect d'un tube tricoté multicolore.</gams:textualContent><rel:isPartOf rdf:resource="https://gams.uni-graz.at/o:aaif.fraweb" /></aaif:Entry><aaif:Phrase rdf:about="https://gams.uni-graz.at/o:aaif.fraweb#En3692Ph1"><aaif:verb rdf:resource="https://gams.uni-graz.at/o:aaif.fraweb#En3692Ph1Ve1" /><aaif:adverb rdf:resource="https://gams.uni-graz.at/o:aaif.fraweb#En3692Ph1Ad1" /><aaif:adverb rdf:resource="https://gams.uni-graz.at/o:aaif.fraweb#En3692Ph1Ad2" /><aaif:text>Fil à tricoter léger et volumineux </aaif:text><aaif:annoText>Fil à [v|tricoter|tricoter|ts] [a|léger|léger|auvnmnnC] et [a|volumineux|volumineux|auvnmnnC] </aaif:annoText></aaif:Phrase><aaif:Verb rdf:about="https://gams.uni-graz.at/o:aaif.fraweb#En3692Ph1Ve1"><aaif:text>tricoter</aaif:text><aaif:lemma rdf:resource="https://gams.uni-graz.at/o:aaif.lemma#tricoter" /><aaif:position rdf:datatype="http://www.w3.org/2001/XMLSchema#int">1</aaif:position><aaif:coordinated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:coordinated><aaif:partOfText rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</aaif:partOfText><aaif:syntacticConstruction rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Transitive" /></aaif:Verb><aaif:Adverb rdf:about="https://gams.uni-graz.at/o:aaif.fraweb#En3692Ph1Ad1"><aaif:text>léger</aaif:text><aaif:lemma rdf:resource="https://gams.uni-graz.at/o:aaif.lemma#léger" /><aaif:position rdf:datatype="http://www.w3.org/2001/XMLSchema#int">2</aaif:position><aaif:coordinated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</aaif:coordinated><aaif:morphosyntacticStructure rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Adjective" /><aaif:inflection rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Uninflected" /><aaif:attributionTarget rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Verb" /><aaif:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:modified><aaif:semanticClassification rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Manner" /><aaif:reduplicated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:reduplicated><aaif:prepositionalPhrase rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:prepositionalPhrase></aaif:Adverb><aaif:Adverb rdf:about="https://gams.uni-graz.at/o:aaif.fraweb#En3692Ph1Ad2"><aaif:text>volumineux</aaif:text><aaif:lemma rdf:resource="https://gams.uni-graz.at/o:aaif.lemma#volumineux" /><aaif:position rdf:datatype="http://www.w3.org/2001/XMLSchema#int">3</aaif:position><aaif:coordinated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</aaif:coordinated><aaif:morphosyntacticStructure rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Adjective" /><aaif:inflection rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Uninflected" /><aaif:attributionTarget rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Verb" /><aaif:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:modified><aaif:semanticClassification rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Manner" /><aaif:reduplicated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:reduplicated><aaif:prepositionalPhrase rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:prepositionalPhrase></aaif:Adverb><aaif:Entry rdf:about="https://gams.uni-graz.at/o:aaif.fraweb#En3693"><aaif:phrase rdf:resource="https://gams.uni-graz.at/o:aaif.fraweb#En3693Ph1" /><aaif:source rdf:resource="https://gams.uni-graz.at/o:aaif.fraweb.bibl#DC3711" /><gams:textualContent>Ces femmes qui chevauchent les motos au dos droit et à la tête bien haute porte sur leur dos un enfant qui ne saurait trouver meilleure place.Mobilette, vélo, camion, 4x4 tricottent serré  pour partager la route.Même les ânes, à leur rythme, suivent le trafic.</gams:textualContent><rel:isPartOf rdf:resource="https://gams.uni-graz.at/o:aaif.fraweb" /></aaif:Entry><aaif:Phrase rdf:about="https://gams.uni-graz.at/o:aaif.fraweb#En3693Ph1"><aaif:verb rdf:resource="https://gams.uni-graz.at/o:aaif.fraweb#En3693Ph1Ve1" /><aaif:adverb rdf:resource="https://gams.uni-graz.at/o:aaif.fraweb#En3693Ph1Ad1" /><aaif:text>4x4 tricottent serré </aaif:text><aaif:annoText>4x4 [v|tricottent|tricoter|is] [a|serré|serré|ausnlnnn] </aaif:annoText></aaif:Phrase><aaif:Verb rdf:about="https://gams.uni-graz.at/o:aaif.fraweb#En3693Ph1Ve1"><aaif:text>tricottent</aaif:text><aaif:lemma rdf:resource="https://gams.uni-graz.at/o:aaif.lemma#tricoter" /><aaif:position rdf:datatype="http://www.w3.org/2001/XMLSchema#int">1</aaif:position><aaif:coordinated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:coordinated><aaif:partOfText rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</aaif:partOfText><aaif:syntacticConstruction rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Intransitive" /></aaif:Verb><aaif:Adverb rdf:about="https://gams.uni-graz.at/o:aaif.fraweb#En3693Ph1Ad1"><aaif:text>serré</aaif:text><aaif:lemma rdf:resource="https://gams.uni-graz.at/o:aaif.lemma#serré" /><aaif:position rdf:datatype="http://www.w3.org/2001/XMLSchema#int">2</aaif:position><aaif:coordinated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:coordinated><aaif:morphosyntacticStructure rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Adjective" /><aaif:inflection rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Uninflected" /><aaif:attributionTarget rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Verb" /><aaif:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:modified><aaif:semanticClassification rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Location" /><aaif:reduplicated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:reduplicated><aaif:prepositionalPhrase rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:prepositionalPhrase></aaif:Adverb><aaif:Entry rdf:about="https://gams.uni-graz.at/o:aaif.fraweb#En3694"><aaif:phrase rdf:resource="https://gams.uni-graz.at/o:aaif.fraweb#En3694Ph1" /><aaif:source rdf:resource="https://gams.uni-graz.at/o:aaif.fraweb.bibl#DC3712" /><gams:textualContent>Depuis plus de 40 ans, des relations culturelles stimulantes se sont tissées entre la Belgique et le Québec.En 2015, avec l‘événement Mons, capitale européenne de la culture, quelques modèles belges inspirants elles se tricotent serré  .Coup de projecteur sur les Québécois en Belgique et les Belges du Québec.</gams:textualContent><rel:isPartOf rdf:resource="https://gams.uni-graz.at/o:aaif.fraweb" /></aaif:Entry><aaif:Phrase rdf:about="https://gams.uni-graz.at/o:aaif.fraweb#En3694Ph1"><aaif:verb rdf:resource="https://gams.uni-graz.at/o:aaif.fraweb#En3694Ph1Ve1" /><aaif:adverb rdf:resource="https://gams.uni-graz.at/o:aaif.fraweb#En3694Ph1Ad1" /><aaif:text>elles se tricotent serré </aaif:text><aaif:annoText>elles [v|se tricotent|tricoter|rs] [a|serré|serré|ausnlnnn] </aaif:annoText></aaif:Phrase><aaif:Verb rdf:about="https://gams.uni-graz.at/o:aaif.fraweb#En3694Ph1Ve1"><aaif:text>se tricotent</aaif:text><aaif:lemma rdf:resource="https://gams.uni-graz.at/o:aaif.lemma#tricoter" /><aaif:position rdf:datatype="http://www.w3.org/2001/XMLSchema#int">1</aaif:position><aaif:coordinated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:coordinated><aaif:partOfText rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</aaif:partOfText><aaif:syntacticConstruction rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Reflexive" /></aaif:Verb><aaif:Adverb rdf:about="https://gams.uni-graz.at/o:aaif.fraweb#En3694Ph1Ad1"><aaif:text>serré</aaif:text><aaif:lemma rdf:resource="https://gams.uni-graz.at/o:aaif.lemma#serré" /><aaif:position rdf:datatype="http://www.w3.org/2001/XMLSchema#int">2</aaif:position><aaif:coordinated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:coordinated><aaif:morphosyntacticStructure rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Adjective" /><aaif:inflection rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Uninflected" /><aaif:attributionTarget rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Verb" /><aaif:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:modified><aaif:semanticClassification rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Location" /><aaif:reduplicated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:reduplicated><aaif:prepositionalPhrase rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:prepositionalPhrase></aaif:Adverb><aaif:Entry rdf:about="https://gams.uni-graz.at/o:aaif.fraweb#En3695"><aaif:phrase rdf:resource="https://gams.uni-graz.at/o:aaif.fraweb#En3695Ph1" /><aaif:source rdf:resource="https://gams.uni-graz.at/o:aaif.fraweb.bibl#DC3713" /><gams:textualContent>ar experience, pour mon châle j'ai commencé avec 6 mailles, et j'ai tricoter jusqu'à avoir 150cm de long, je pense que ça depend comment tu le veux en longueur.Car on ne fait pas tou(te)s les meme points, certain(e)s tricotent serrés d'autre  laches ...</gams:textualContent><rel:isPartOf rdf:resource="https://gams.uni-graz.at/o:aaif.fraweb" /></aaif:Entry><aaif:Phrase rdf:about="https://gams.uni-graz.at/o:aaif.fraweb#En3695Ph1"><aaif:verb rdf:resource="https://gams.uni-graz.at/o:aaif.fraweb#En3695Ph1Ve1" /><aaif:adverb rdf:resource="https://gams.uni-graz.at/o:aaif.fraweb#En3695Ph1Ad1" /><aaif:adverb rdf:resource="https://gams.uni-graz.at/o:aaif.fraweb#En3695Ph1Ad2" /><aaif:text>certain(e)s tricotent serrés d'autre  laches </aaif:text><aaif:annoText>certain(e)s [v|tricotent|tricoter|is] [a|serrés|serré|aionlnnC] d'autre  [a|laches|lâche|aionlnnC] </aaif:annoText></aaif:Phrase><aaif:Verb rdf:about="https://gams.uni-graz.at/o:aaif.fraweb#En3695Ph1Ve1"><aaif:text>tricotent</aaif:text><aaif:lemma rdf:resource="https://gams.uni-graz.at/o:aaif.lemma#tricoter" /><aaif:position rdf:datatype="http://www.w3.org/2001/XMLSchema#int">1</aaif:position><aaif:coordinated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:coordinated><aaif:partOfText rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</aaif:partOfText><aaif:syntacticConstruction rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Intransitive" /></aaif:Verb><aaif:Adverb rdf:about="https://gams.uni-graz.at/o:aaif.fraweb#En3695Ph1Ad1"><aaif:text>serrés</aaif:text><aaif:lemma rdf:resource="https://gams.uni-graz.at/o:aaif.lemma#serré" /><aaif:position rdf:datatype="http://www.w3.org/2001/XMLSchema#int">2</aaif:position><aaif:coordinated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</aaif:coordinated><aaif:morphosyntacticStructure rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Adjective" /><aaif:inflection rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#InaudibleInflection" /><aaif:attributionTarget rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#VerbObject" /><aaif:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:modified><aaif:semanticClassification rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Location" /><aaif:reduplicated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:reduplicated><aaif:prepositionalPhrase rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:prepositionalPhrase></aaif:Adverb><aaif:Adverb rdf:about="https://gams.uni-graz.at/o:aaif.fraweb#En3695Ph1Ad2"><aaif:text>laches</aaif:text><aaif:lemma rdf:resource="https://gams.uni-graz.at/o:aaif.lemma#lâche" /><aaif:position rdf:datatype="http://www.w3.org/2001/XMLSchema#int">3</aaif:position><aaif:coordinated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</aaif:coordinated><aaif:morphosyntacticStructure rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Adjective" /><aaif:inflection rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#InaudibleInflection" /><aaif:attributionTarget rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#VerbObject" /><aaif:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:modified><aaif:semanticClassification rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Location" /><aaif:reduplicated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:reduplicated><aaif:prepositionalPhrase rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:prepositionalPhrase></aaif:Adverb><aaif:Entry rdf:about="https://gams.uni-graz.at/o:aaif.fraweb#En3696"><aaif:phrase rdf:resource="https://gams.uni-graz.at/o:aaif.fraweb#En3696Ph1" /><aaif:source rdf:resource="https://gams.uni-graz.at/o:aaif.fraweb.bibl#DC3714" /><gams:textualContent>Que je parle de tous ces « bons moments » vécus en FAMILLE, de ces belles retrouvailles, de ces liens qui se tricotent serrés  , de cette joyeuse complicité qui naît et renaît entre nous...De ces rires et de ces « Poutpout...» imprévus, incommodants...parfois !...</gams:textualContent><rel:isPartOf rdf:resource="https://gams.uni-graz.at/o:aaif.fraweb" /></aaif:Entry><aaif:Phrase rdf:about="https://gams.uni-graz.at/o:aaif.fraweb#En3696Ph1"><aaif:verb rdf:resource="https://gams.uni-graz.at/o:aaif.fraweb#En3696Ph1Ve1" /><aaif:adverb rdf:resource="https://gams.uni-graz.at/o:aaif.fraweb#En3696Ph1Ad1" /><aaif:text>ces liens qui se tricotent serrés </aaif:text><aaif:annoText>ces liens qui [v|se tricotent|tricoter|rs] [a|serrés|serré|aisnlnnn] </aaif:annoText></aaif:Phrase><aaif:Verb rdf:about="https://gams.uni-graz.at/o:aaif.fraweb#En3696Ph1Ve1"><aaif:text>se tricotent</aaif:text><aaif:lemma rdf:resource="https://gams.uni-graz.at/o:aaif.lemma#tricoter" /><aaif:position rdf:datatype="http://www.w3.org/2001/XMLSchema#int">1</aaif:position><aaif:coordinated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:coordinated><aaif:partOfText rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</aaif:partOfText><aaif:syntacticConstruction rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Reflexive" /></aaif:Verb><aaif:Adverb rdf:about="https://gams.uni-graz.at/o:aaif.fraweb#En3696Ph1Ad1"><aaif:text>serrés</aaif:text><aaif:lemma rdf:resource="https://gams.uni-graz.at/o:aaif.lemma#serré" /><aaif:position rdf:datatype="http://www.w3.org/2001/XMLSchema#int">2</aaif:position><aaif:coordinated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:coordinated><aaif:morphosyntacticStructure rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Adjective" /><aaif:inflection rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#InaudibleInflection" /><aaif:attributionTarget rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Verb" /><aaif:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:modified><aaif:semanticClassification rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Location" /><aaif:reduplicated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:reduplicated><aaif:prepositionalPhrase rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:prepositionalPhrase></aaif:Adverb><aaif:Entry rdf:about="https://gams.uni-graz.at/o:aaif.fraweb#En3697"><aaif:phrase rdf:resource="https://gams.uni-graz.at/o:aaif.fraweb#En3697Ph1" /><aaif:source rdf:resource="https://gams.uni-graz.at/o:aaif.fraweb.bibl#DC3715" /><gams:textualContent>Où on confirme que les ganseys (l'Aberlady est un gansey - pull typique des pêcheurs des îles anglo-normandes, britanniques, irlandaises - et p'têt d'autres) se tricotent serrés  .</gams:textualContent><rel:isPartOf rdf:resource="https://gams.uni-graz.at/o:aaif.fraweb" /></aaif:Entry><aaif:Phrase rdf:about="https://gams.uni-graz.at/o:aaif.fraweb#En3697Ph1"><aaif:verb rdf:resource="https://gams.uni-graz.at/o:aaif.fraweb#En3697Ph1Ve1" /><aaif:adverb rdf:resource="https://gams.uni-graz.at/o:aaif.fraweb#En3697Ph1Ad1" /><aaif:text>les ganseys (l'Aberlady est un gansey - pull typique des pêcheurs des îles anglo-normandes, britanniques, irlandaises - et p'têt d'autres) se tricotent serrés </aaif:text><aaif:annoText>les ganseys (l'Aberlady est un gansey - pull typique des pêcheurs des îles anglo-normandes, britanniques, irlandaises - et p'têt d'autres) [v|se tricotent|tricoter|rs] [a|serrés|serré|aionlnnn] </aaif:annoText></aaif:Phrase><aaif:Verb rdf:about="https://gams.uni-graz.at/o:aaif.fraweb#En3697Ph1Ve1"><aaif:text>se tricotent</aaif:text><aaif:lemma rdf:resource="https://gams.uni-graz.at/o:aaif.lemma#tricoter" /><aaif:position rdf:datatype="http://www.w3.org/2001/XMLSchema#int">1</aaif:position><aaif:coordinated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:coordinated><aaif:partOfText rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</aaif:partOfText><aaif:syntacticConstruction rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Reflexive" /></aaif:Verb><aaif:Adverb rdf:about="https://gams.uni-graz.at/o:aaif.fraweb#En3697Ph1Ad1"><aaif:text>serrés</aaif:text><aaif:lemma rdf:resource="https://gams.uni-graz.at/o:aaif.lemma#serré" /><aaif:position rdf:datatype="http://www.w3.org/2001/XMLSchema#int">2</aaif:position><aaif:coordinated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:coordinated><aaif:morphosyntacticStructure rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Adjective" /><aaif:inflection rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#InaudibleInflection" /><aaif:attributionTarget rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#VerbObject" /><aaif:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:modified><aaif:semanticClassification rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Location" /><aaif:reduplicated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:reduplicated><aaif:prepositionalPhrase rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:prepositionalPhrase></aaif:Adverb><aaif:Entry rdf:about="https://gams.uni-graz.at/o:aaif.fraweb#En3698"><aaif:phrase rdf:resource="https://gams.uni-graz.at/o:aaif.fraweb#En3698Ph1" /><aaif:source rdf:resource="https://gams.uni-graz.at/o:aaif.fraweb.bibl#DC3716" /><gams:textualContent>Aig.n° 3 (Je conseille à celles qui tricotent lâche  de choisir une laine qui se tricote habituellement en 3,5 pour que les mailles soient bien serrées.C'est important pour que le bourrage ne transparaisse pas à travers les mailles et pour une tenue ferme de la poupée).</gams:textualContent><rel:isPartOf rdf:resource="https://gams.uni-graz.at/o:aaif.fraweb" /></aaif:Entry><aaif:Phrase rdf:about="https://gams.uni-graz.at/o:aaif.fraweb#En3698Ph1"><aaif:verb rdf:resource="https://gams.uni-graz.at/o:aaif.fraweb#En3698Ph1Ve1" /><aaif:adverb rdf:resource="https://gams.uni-graz.at/o:aaif.fraweb#En3698Ph1Ad1" /><aaif:text> celles qui tricotent lâche </aaif:text><aaif:annoText> celles qui [v|tricotent|tricoter|is] [a|lâche|lâche|auonlnnn] </aaif:annoText></aaif:Phrase><aaif:Verb rdf:about="https://gams.uni-graz.at/o:aaif.fraweb#En3698Ph1Ve1"><aaif:text>tricotent</aaif:text><aaif:lemma rdf:resource="https://gams.uni-graz.at/o:aaif.lemma#tricoter" /><aaif:position rdf:datatype="http://www.w3.org/2001/XMLSchema#int">1</aaif:position><aaif:coordinated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:coordinated><aaif:partOfText rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</aaif:partOfText><aaif:syntacticConstruction rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Intransitive" /></aaif:Verb><aaif:Adverb rdf:about="https://gams.uni-graz.at/o:aaif.fraweb#En3698Ph1Ad1"><aaif:text>lâche</aaif:text><aaif:lemma rdf:resource="https://gams.uni-graz.at/o:aaif.lemma#lâche" /><aaif:position rdf:datatype="http://www.w3.org/2001/XMLSchema#int">2</aaif:position><aaif:coordinated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:coordinated><aaif:morphosyntacticStructure rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Adjective" /><aaif:inflection rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Uninflected" /><aaif:attributionTarget rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#VerbObject" /><aaif:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:modified><aaif:semanticClassification rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Location" /><aaif:reduplicated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:reduplicated><aaif:prepositionalPhrase rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:prepositionalPhrase></aaif:Adverb><aaif:Entry rdf:about="https://gams.uni-graz.at/o:aaif.fraweb#En3699"><aaif:phrase rdf:resource="https://gams.uni-graz.at/o:aaif.fraweb#En3699Ph1" /><aaif:source rdf:resource="https://gams.uni-graz.at/o:aaif.fraweb.bibl#DC3717" /><gams:textualContent>Les mensurations que je vous donne correspondent au fil « Lambswool » de Phildar pour les personnes qui tricotent lâche  .</gams:textualContent><rel:isPartOf rdf:resource="https://gams.uni-graz.at/o:aaif.fraweb" /></aaif:Entry><aaif:Phrase rdf:about="https://gams.uni-graz.at/o:aaif.fraweb#En3699Ph1"><aaif:verb rdf:resource="https://gams.uni-graz.at/o:aaif.fraweb#En3699Ph1Ve1" /><aaif:adverb rdf:resource="https://gams.uni-graz.at/o:aaif.fraweb#En3699Ph1Ad1" /><aaif:text>les personnes qui tricotent lâche </aaif:text><aaif:annoText>les personnes qui [v|tricotent|tricoter|is] [a|lâche|lâche|auonlnnn] </aaif:annoText></aaif:Phrase><aaif:Verb rdf:about="https://gams.uni-graz.at/o:aaif.fraweb#En3699Ph1Ve1"><aaif:text>tricotent</aaif:text><aaif:lemma rdf:resource="https://gams.uni-graz.at/o:aaif.lemma#tricoter" /><aaif:position rdf:datatype="http://www.w3.org/2001/XMLSchema#int">1</aaif:position><aaif:coordinated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:coordinated><aaif:partOfText rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</aaif:partOfText><aaif:syntacticConstruction rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Intransitive" /></aaif:Verb><aaif:Adverb rdf:about="https://gams.uni-graz.at/o:aaif.fraweb#En3699Ph1Ad1"><aaif:text>lâche</aaif:text><aaif:lemma rdf:resource="https://gams.uni-graz.at/o:aaif.lemma#lâche" /><aaif:position rdf:datatype="http://www.w3.org/2001/XMLSchema#int">2</aaif:position><aaif:coordinated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:coordinated><aaif:morphosyntacticStructure rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Adjective" /><aaif:inflection rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Uninflected" /><aaif:attributionTarget rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#VerbObject" /><aaif:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:modified><aaif:semanticClassification rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Location" /><aaif:reduplicated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:reduplicated><aaif:prepositionalPhrase rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:prepositionalPhrase></aaif:Adverb><aaif:Entry rdf:about="https://gams.uni-graz.at/o:aaif.fraweb#En3700"><aaif:phrase rdf:resource="https://gams.uni-graz.at/o:aaif.fraweb#En3700Ph1" /><aaif:source rdf:resource="https://gams.uni-graz.at/o:aaif.fraweb.bibl#DC3718" /><gams:textualContent>Je viens de trouver la photo de ton modèle, peut-être que la partie basse se tricote lache  pour plus de souplesse ?Comment se tricote le haut...</gams:textualContent><rel:isPartOf rdf:resource="https://gams.uni-graz.at/o:aaif.fraweb" /></aaif:Entry><aaif:Phrase rdf:about="https://gams.uni-graz.at/o:aaif.fraweb#En3700Ph1"><aaif:verb rdf:resource="https://gams.uni-graz.at/o:aaif.fraweb#En3700Ph1Ve1" /><aaif:adverb rdf:resource="https://gams.uni-graz.at/o:aaif.fraweb#En3700Ph1Ad1" /><aaif:text>la partie basse se tricote lache </aaif:text><aaif:annoText>la partie basse [v|se tricote|tricoter|rs] [a|lache|lâche|auonlnnn] </aaif:annoText></aaif:Phrase><aaif:Verb rdf:about="https://gams.uni-graz.at/o:aaif.fraweb#En3700Ph1Ve1"><aaif:text>se tricote</aaif:text><aaif:lemma rdf:resource="https://gams.uni-graz.at/o:aaif.lemma#tricoter" /><aaif:position rdf:datatype="http://www.w3.org/2001/XMLSchema#int">1</aaif:position><aaif:coordinated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:coordinated><aaif:partOfText rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</aaif:partOfText><aaif:syntacticConstruction rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Reflexive" /></aaif:Verb><aaif:Adverb rdf:about="https://gams.uni-graz.at/o:aaif.fraweb#En3700Ph1Ad1"><aaif:text>lache</aaif:text><aaif:lemma rdf:resource="https://gams.uni-graz.at/o:aaif.lemma#lâche" /><aaif:position rdf:datatype="http://www.w3.org/2001/XMLSchema#int">2</aaif:position><aaif:coordinated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:coordinated><aaif:morphosyntacticStructure rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Adjective" /><aaif:inflection rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Uninflected" /><aaif:attributionTarget rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#VerbObject" /><aaif:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:modified><aaif:semanticClassification rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Location" /><aaif:reduplicated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:reduplicated><aaif:prepositionalPhrase rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:prepositionalPhrase></aaif:Adverb><aaif:Entry rdf:about="https://gams.uni-graz.at/o:aaif.fraweb#En3701"><aaif:phrase rdf:resource="https://gams.uni-graz.at/o:aaif.fraweb#En3701Ph1" /><aaif:source rdf:resource="https://gams.uni-graz.at/o:aaif.fraweb.bibl#DC3719" /><gams:textualContent>aujourd'hui : trop chaud pour monter dans l'aprem du coup on est allé voir Boycott.Essai du filet puis je l'ai sortit du parc et promené un peu.Il a été sage comme tjrs, par contre il est très sensible des pieds.Puis un peu de trot en main sur le macadam, là aussi il trottait court  .</gams:textualContent><rel:isPartOf rdf:resource="https://gams.uni-graz.at/o:aaif.fraweb" /></aaif:Entry><aaif:Phrase rdf:about="https://gams.uni-graz.at/o:aaif.fraweb#En3701Ph1"><aaif:verb rdf:resource="https://gams.uni-graz.at/o:aaif.fraweb#En3701Ph1Ve1" /><aaif:adverb rdf:resource="https://gams.uni-graz.at/o:aaif.fraweb#En3701Ph1Ad1" /><aaif:text>il trottait court </aaif:text><aaif:annoText>il [v|trottait|trotter|is] [a|court|court|auvnmnnn] </aaif:annoText></aaif:Phrase><aaif:Verb rdf:about="https://gams.uni-graz.at/o:aaif.fraweb#En3701Ph1Ve1"><aaif:text>trottait</aaif:text><aaif:lemma rdf:resource="https://gams.uni-graz.at/o:aaif.lemma#trotter" /><aaif:position rdf:datatype="http://www.w3.org/2001/XMLSchema#int">1</aaif:position><aaif:coordinated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:coordinated><aaif:partOfText rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</aaif:partOfText><aaif:syntacticConstruction rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Intransitive" /></aaif:Verb><aaif:Adverb rdf:about="https://gams.uni-graz.at/o:aaif.fraweb#En3701Ph1Ad1"><aaif:text>court</aaif:text><aaif:lemma rdf:resource="https://gams.uni-graz.at/o:aaif.lemma#court" /><aaif:position rdf:datatype="http://www.w3.org/2001/XMLSchema#int">2</aaif:position><aaif:coordinated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:coordinated><aaif:morphosyntacticStructure rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Adjective" /><aaif:inflection rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Uninflected" /><aaif:attributionTarget rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Verb" /><aaif:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:modified><aaif:semanticClassification rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Manner" /><aaif:reduplicated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:reduplicated><aaif:prepositionalPhrase rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:prepositionalPhrase></aaif:Adverb><aaif:Entry rdf:about="https://gams.uni-graz.at/o:aaif.fraweb#En3702"><aaif:phrase rdf:resource="https://gams.uni-graz.at/o:aaif.fraweb#En3702Ph1" /><aaif:source rdf:resource="https://gams.uni-graz.at/o:aaif.fraweb.bibl#DC3720" /><gams:textualContent>ma jument n'a pas passé l'initial de la 130, elle trottait court  suite à une blessure.de toute facon je serais pas partie ce matin avec ce temps.</gams:textualContent><rel:isPartOf rdf:resource="https://gams.uni-graz.at/o:aaif.fraweb" /></aaif:Entry><aaif:Phrase rdf:about="https://gams.uni-graz.at/o:aaif.fraweb#En3702Ph1"><aaif:verb rdf:resource="https://gams.uni-graz.at/o:aaif.fraweb#En3702Ph1Ve1" /><aaif:adverb rdf:resource="https://gams.uni-graz.at/o:aaif.fraweb#En3702Ph1Ad1" /><aaif:text>elle trottait court </aaif:text><aaif:annoText>elle [v|trottait|trotter|is] [a|court|court|auvnmnnn] </aaif:annoText></aaif:Phrase><aaif:Verb rdf:about="https://gams.uni-graz.at/o:aaif.fraweb#En3702Ph1Ve1"><aaif:text>trottait</aaif:text><aaif:lemma rdf:resource="https://gams.uni-graz.at/o:aaif.lemma#trotter" /><aaif:position rdf:datatype="http://www.w3.org/2001/XMLSchema#int">1</aaif:position><aaif:coordinated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:coordinated><aaif:partOfText rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</aaif:partOfText><aaif:syntacticConstruction rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Intransitive" /></aaif:Verb><aaif:Adverb rdf:about="https://gams.uni-graz.at/o:aaif.fraweb#En3702Ph1Ad1"><aaif:text>court</aaif:text><aaif:lemma rdf:resource="https://gams.uni-graz.at/o:aaif.lemma#court" /><aaif:position rdf:datatype="http://www.w3.org/2001/XMLSchema#int">2</aaif:position><aaif:coordinated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:coordinated><aaif:morphosyntacticStructure rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Adjective" /><aaif:inflection rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Uninflected" /><aaif:attributionTarget rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Verb" /><aaif:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:modified><aaif:semanticClassification rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Manner" /><aaif:reduplicated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:reduplicated><aaif:prepositionalPhrase rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:prepositionalPhrase></aaif:Adverb><aaif:Entry rdf:about="https://gams.uni-graz.at/o:aaif.fraweb#En3703"><aaif:phrase rdf:resource="https://gams.uni-graz.at/o:aaif.fraweb#En3703Ph1" /><aaif:source rdf:resource="https://gams.uni-graz.at/o:aaif.fraweb.bibl#DC3721" /><gams:textualContent>Pensez donc, un maquis grec, c’est pas la pelouse du stade de France!Si seulement j’avais pu lui reprendre Google Maps des mains… Mais c’est qu’elle trottait dur , à son aise dans cette vilaine junglerie… Oui, oui, j’ai suivi… </gams:textualContent><rel:isPartOf rdf:resource="https://gams.uni-graz.at/o:aaif.fraweb" /></aaif:Entry><aaif:Phrase rdf:about="https://gams.uni-graz.at/o:aaif.fraweb#En3703Ph1"><aaif:verb rdf:resource="https://gams.uni-graz.at/o:aaif.fraweb#En3703Ph1Ve1" /><aaif:adverb rdf:resource="https://gams.uni-graz.at/o:aaif.fraweb#En3703Ph1Ad1" /><aaif:text>elle trottait dur , à son aise</aaif:text><aaif:annoText>elle [v|trottait|trotter|is] [a|dur|dur|auvnmnnC] , à son aise</aaif:annoText></aaif:Phrase><aaif:Verb rdf:about="https://gams.uni-graz.at/o:aaif.fraweb#En3703Ph1Ve1"><aaif:text>trottait</aaif:text><aaif:lemma rdf:resource="https://gams.uni-graz.at/o:aaif.lemma#trotter" /><aaif:position rdf:datatype="http://www.w3.org/2001/XMLSchema#int">1</aaif:position><aaif:coordinated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:coordinated><aaif:partOfText rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</aaif:partOfText><aaif:syntacticConstruction rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Intransitive" /></aaif:Verb><aaif:Adverb rdf:about="https://gams.uni-graz.at/o:aaif.fraweb#En3703Ph1Ad1"><aaif:text>dur</aaif:text><aaif:lemma rdf:resource="https://gams.uni-graz.at/o:aaif.lemma#dur" /><aaif:position rdf:datatype="http://www.w3.org/2001/XMLSchema#int">2</aaif:position><aaif:coordinated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</aaif:coordinated><aaif:morphosyntacticStructure rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Adjective" /><aaif:inflection rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Uninflected" /><aaif:attributionTarget rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Verb" /><aaif:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:modified><aaif:semanticClassification rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Manner" /><aaif:reduplicated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:reduplicated><aaif:prepositionalPhrase rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:prepositionalPhrase></aaif:Adverb><aaif:Entry rdf:about="https://gams.uni-graz.at/o:aaif.fraweb#En3704"><aaif:phrase rdf:resource="https://gams.uni-graz.at/o:aaif.fraweb#En3704Ph1" /><aaif:source rdf:resource="https://gams.uni-graz.at/o:aaif.fraweb.bibl#DC3722" /><gams:textualContent>Mais ce n’est pas la seule raison car lorsque le cheval « trottait dur  » il recevait sur le rein le choc du cavalier peu aguerri et les cavaliers en souffraient aussi.</gams:textualContent><rel:isPartOf rdf:resource="https://gams.uni-graz.at/o:aaif.fraweb" /></aaif:Entry><aaif:Phrase rdf:about="https://gams.uni-graz.at/o:aaif.fraweb#En3704Ph1"><aaif:verb rdf:resource="https://gams.uni-graz.at/o:aaif.fraweb#En3704Ph1Ve1" /><aaif:adverb rdf:resource="https://gams.uni-graz.at/o:aaif.fraweb#En3704Ph1Ad1" /><aaif:text>le cheval « trottait dur </aaif:text><aaif:annoText>le cheval « [v|trottait|trotter|is] [a|dur|dur|auvnmnnn] </aaif:annoText></aaif:Phrase><aaif:Verb rdf:about="https://gams.uni-graz.at/o:aaif.fraweb#En3704Ph1Ve1"><aaif:text>trottait</aaif:text><aaif:lemma rdf:resource="https://gams.uni-graz.at/o:aaif.lemma#trotter" /><aaif:position rdf:datatype="http://www.w3.org/2001/XMLSchema#int">1</aaif:position><aaif:coordinated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:coordinated><aaif:partOfText rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</aaif:partOfText><aaif:syntacticConstruction rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Intransitive" /></aaif:Verb><aaif:Adverb rdf:about="https://gams.uni-graz.at/o:aaif.fraweb#En3704Ph1Ad1"><aaif:text>dur</aaif:text><aaif:lemma rdf:resource="https://gams.uni-graz.at/o:aaif.lemma#dur" /><aaif:position rdf:datatype="http://www.w3.org/2001/XMLSchema#int">2</aaif:position><aaif:coordinated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:coordinated><aaif:morphosyntacticStructure rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Adjective" /><aaif:inflection rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Uninflected" /><aaif:attributionTarget rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Verb" /><aaif:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:modified><aaif:semanticClassification rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Manner" /><aaif:reduplicated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:reduplicated><aaif:prepositionalPhrase rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:prepositionalPhrase></aaif:Adverb><aaif:Entry rdf:about="https://gams.uni-graz.at/o:aaif.fraweb#En3705"><aaif:phrase rdf:resource="https://gams.uni-graz.at/o:aaif.fraweb#En3705Ph1" /><aaif:source rdf:resource="https://gams.uni-graz.at/o:aaif.fraweb.bibl#DC3723" /><gams:textualContent>Alors pendant deux soirées, je me suis penchée sur la création du patron du canard qui me trottait menu dans la tête depuis un bout de temps, et petit à petit, partant d'une forme improbable de bipède allongé, en allongeant les magrets, en rabotant le croupion, en élargissant l'assise, le tout en plaçant les coutures de façon à souligner une silhouette de canard...</gams:textualContent><rel:isPartOf rdf:resource="https://gams.uni-graz.at/o:aaif.fraweb" /></aaif:Entry><aaif:Phrase rdf:about="https://gams.uni-graz.at/o:aaif.fraweb#En3705Ph1"><aaif:verb rdf:resource="https://gams.uni-graz.at/o:aaif.fraweb#En3705Ph1Ve1" /><aaif:adverb rdf:resource="https://gams.uni-graz.at/o:aaif.fraweb#En3705Ph1Ad1" /><aaif:text>canard qui me trottait menu dans la tête</aaif:text><aaif:annoText>canard qui me [v|trottait|trotter|ts] [a|menu|menu|auvnmnnn] dans la tête</aaif:annoText></aaif:Phrase><aaif:Verb rdf:about="https://gams.uni-graz.at/o:aaif.fraweb#En3705Ph1Ve1"><aaif:text>trottait</aaif:text><aaif:lemma rdf:resource="https://gams.uni-graz.at/o:aaif.lemma#trotter" /><aaif:position rdf:datatype="http://www.w3.org/2001/XMLSchema#int">1</aaif:position><aaif:coordinated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:coordinated><aaif:partOfText rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</aaif:partOfText><aaif:syntacticConstruction rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Transitive" /></aaif:Verb><aaif:Adverb rdf:about="https://gams.uni-graz.at/o:aaif.fraweb#En3705Ph1Ad1"><aaif:text>menu</aaif:text><aaif:lemma rdf:resource="https://gams.uni-graz.at/o:aaif.lemma#menu" /><aaif:position rdf:datatype="http://www.w3.org/2001/XMLSchema#int">2</aaif:position><aaif:coordinated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:coordinated><aaif:morphosyntacticStructure rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Adjective" /><aaif:inflection rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Uninflected" /><aaif:attributionTarget rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Verb" /><aaif:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:modified><aaif:semanticClassification rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Manner" /><aaif:reduplicated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:reduplicated><aaif:prepositionalPhrase rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:prepositionalPhrase></aaif:Adverb><aaif:Entry rdf:about="https://gams.uni-graz.at/o:aaif.fraweb#En3706"><aaif:phrase rdf:resource="https://gams.uni-graz.at/o:aaif.fraweb#En3706Ph1" /><aaif:source rdf:resource="https://gams.uni-graz.at/o:aaif.fraweb.bibl#DC3724" /><gams:textualContent>Il devint le divin enfant, en ce jour de mai 007, le prez de tous les gaulois, et des gauloises mentholées.A la même époque, l'Manu trottait menu  , dans sa banlieue à prolos, pas très Blanco.Supportait la cause palestinienne, plantait un arbre pour ça sous les caméras, donnait la tape dans l'dos à tout arabe déambulant en babouche de métro.</gams:textualContent><rel:isPartOf rdf:resource="https://gams.uni-graz.at/o:aaif.fraweb" /></aaif:Entry><aaif:Phrase rdf:about="https://gams.uni-graz.at/o:aaif.fraweb#En3706Ph1"><aaif:verb rdf:resource="https://gams.uni-graz.at/o:aaif.fraweb#En3706Ph1Ve1" /><aaif:adverb rdf:resource="https://gams.uni-graz.at/o:aaif.fraweb#En3706Ph1Ad1" /><aaif:text>l'Manu trottait menu </aaif:text><aaif:annoText>l'Manu [v|trottait|trotter|is] [a|menu|menu|auvnmnnn] </aaif:annoText></aaif:Phrase><aaif:Verb rdf:about="https://gams.uni-graz.at/o:aaif.fraweb#En3706Ph1Ve1"><aaif:text>trottait</aaif:text><aaif:lemma rdf:resource="https://gams.uni-graz.at/o:aaif.lemma#trotter" /><aaif:position rdf:datatype="http://www.w3.org/2001/XMLSchema#int">1</aaif:position><aaif:coordinated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:coordinated><aaif:partOfText rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</aaif:partOfText><aaif:syntacticConstruction rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Intransitive" /></aaif:Verb><aaif:Adverb rdf:about="https://gams.uni-graz.at/o:aaif.fraweb#En3706Ph1Ad1"><aaif:text>menu</aaif:text><aaif:lemma rdf:resource="https://gams.uni-graz.at/o:aaif.lemma#menu" /><aaif:position rdf:datatype="http://www.w3.org/2001/XMLSchema#int">2</aaif:position><aaif:coordinated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:coordinated><aaif:morphosyntacticStructure rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Adjective" /><aaif:inflection rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Uninflected" /><aaif:attributionTarget rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Verb" /><aaif:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:modified><aaif:semanticClassification rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Manner" /><aaif:reduplicated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:reduplicated><aaif:prepositionalPhrase rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:prepositionalPhrase></aaif:Adverb><aaif:Entry rdf:about="https://gams.uni-graz.at/o:aaif.fraweb#En3707"><aaif:phrase rdf:resource="https://gams.uni-graz.at/o:aaif.fraweb#En3707Ph1" /><aaif:source rdf:resource="https://gams.uni-graz.at/o:aaif.fraweb.bibl#DC3725" /><gams:textualContent>Ici on a trottiné menu  , menuisé, coupé, raboté : éclats de bois, éclisses, veines tranchées dans la matière elle-même.Le quartier s’y prêtait, avant que Muji (la marque qui n’en est pas une) ou d’autres viennent investir certains de ces ateliers, lieux parfois extraordinaires à verrières célestes et poutres métalliques tarabiscotées.</gams:textualContent><rel:isPartOf rdf:resource="https://gams.uni-graz.at/o:aaif.fraweb" /></aaif:Entry><aaif:Phrase rdf:about="https://gams.uni-graz.at/o:aaif.fraweb#En3707Ph1"><aaif:verb rdf:resource="https://gams.uni-graz.at/o:aaif.fraweb#En3707Ph1Ve1" /><aaif:adverb rdf:resource="https://gams.uni-graz.at/o:aaif.fraweb#En3707Ph1Ad1" /><aaif:text>on a trottiné menu </aaif:text><aaif:annoText>on [v|a trottiné|trottiner|is] [a|menu|menu|auvnmnnn] </aaif:annoText></aaif:Phrase><aaif:Verb rdf:about="https://gams.uni-graz.at/o:aaif.fraweb#En3707Ph1Ve1"><aaif:text>a trottiné</aaif:text><aaif:lemma rdf:resource="https://gams.uni-graz.at/o:aaif.lemma#trottiner" /><aaif:position rdf:datatype="http://www.w3.org/2001/XMLSchema#int">1</aaif:position><aaif:coordinated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:coordinated><aaif:partOfText rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</aaif:partOfText><aaif:syntacticConstruction rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Intransitive" /></aaif:Verb><aaif:Adverb rdf:about="https://gams.uni-graz.at/o:aaif.fraweb#En3707Ph1Ad1"><aaif:text>menu</aaif:text><aaif:lemma rdf:resource="https://gams.uni-graz.at/o:aaif.lemma#menu" /><aaif:position rdf:datatype="http://www.w3.org/2001/XMLSchema#int">2</aaif:position><aaif:coordinated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:coordinated><aaif:morphosyntacticStructure rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Adjective" /><aaif:inflection rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Uninflected" /><aaif:attributionTarget rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Verb" /><aaif:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:modified><aaif:semanticClassification rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Manner" /><aaif:reduplicated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:reduplicated><aaif:prepositionalPhrase rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:prepositionalPhrase></aaif:Adverb><aaif:Entry rdf:about="https://gams.uni-graz.at/o:aaif.fraweb#En3708"><aaif:phrase rdf:resource="https://gams.uni-graz.at/o:aaif.fraweb#En3708Ph1" /><aaif:source rdf:resource="https://gams.uni-graz.at/o:aaif.fraweb.bibl#DC3726" /><gams:textualContent>Dino trottine menu  et se pointe un quart d’heure plus tard avec une fiche au nom de Duval.Raté !Essaye encore… </gams:textualContent><rel:isPartOf rdf:resource="https://gams.uni-graz.at/o:aaif.fraweb" /></aaif:Entry><aaif:Phrase rdf:about="https://gams.uni-graz.at/o:aaif.fraweb#En3708Ph1"><aaif:verb rdf:resource="https://gams.uni-graz.at/o:aaif.fraweb#En3708Ph1Ve1" /><aaif:adverb rdf:resource="https://gams.uni-graz.at/o:aaif.fraweb#En3708Ph1Ad1" /><aaif:text>Dino trottine menu </aaif:text><aaif:annoText>Dino [v|trottine|trottiner|is] [a|menu|menu|auvnmnnn] </aaif:annoText></aaif:Phrase><aaif:Verb rdf:about="https://gams.uni-graz.at/o:aaif.fraweb#En3708Ph1Ve1"><aaif:text>trottine</aaif:text><aaif:lemma rdf:resource="https://gams.uni-graz.at/o:aaif.lemma#trottiner" /><aaif:position rdf:datatype="http://www.w3.org/2001/XMLSchema#int">1</aaif:position><aaif:coordinated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:coordinated><aaif:partOfText rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</aaif:partOfText><aaif:syntacticConstruction rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Intransitive" /></aaif:Verb><aaif:Adverb rdf:about="https://gams.uni-graz.at/o:aaif.fraweb#En3708Ph1Ad1"><aaif:text>menu</aaif:text><aaif:lemma rdf:resource="https://gams.uni-graz.at/o:aaif.lemma#menu" /><aaif:position rdf:datatype="http://www.w3.org/2001/XMLSchema#int">2</aaif:position><aaif:coordinated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:coordinated><aaif:morphosyntacticStructure rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Adjective" /><aaif:inflection rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Uninflected" /><aaif:attributionTarget rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Verb" /><aaif:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:modified><aaif:semanticClassification rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Manner" /><aaif:reduplicated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:reduplicated><aaif:prepositionalPhrase rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:prepositionalPhrase></aaif:Adverb><aaif:Entry rdf:about="https://gams.uni-graz.at/o:aaif.fraweb#En3709"><aaif:phrase rdf:resource="https://gams.uni-graz.at/o:aaif.fraweb#En3709Ph1" /><aaif:source rdf:resource="https://gams.uni-graz.at/o:aaif.fraweb.bibl#DC3727" /><gams:textualContent>Moi, dis la plus âgée, j'y mettrais le gris de l'âne qui chemine doucement parmi les chardons violets.Le gris feutré de la petite souris qui trottine menue  ou qui prestement se sauve devant le chat.</gams:textualContent><rel:isPartOf rdf:resource="https://gams.uni-graz.at/o:aaif.fraweb" /></aaif:Entry><aaif:Phrase rdf:about="https://gams.uni-graz.at/o:aaif.fraweb#En3709Ph1"><aaif:verb rdf:resource="https://gams.uni-graz.at/o:aaif.fraweb#En3709Ph1Ve1" /><aaif:adverb rdf:resource="https://gams.uni-graz.at/o:aaif.fraweb#En3709Ph1Ad1" /><aaif:text>la petite souris qui trottine menue </aaif:text><aaif:annoText>la petite souris qui [v|trottine|trottiner|is] [a|menue|menu|aivnmnnn] </aaif:annoText></aaif:Phrase><aaif:Verb rdf:about="https://gams.uni-graz.at/o:aaif.fraweb#En3709Ph1Ve1"><aaif:text>trottine</aaif:text><aaif:lemma rdf:resource="https://gams.uni-graz.at/o:aaif.lemma#trottiner" /><aaif:position rdf:datatype="http://www.w3.org/2001/XMLSchema#int">1</aaif:position><aaif:coordinated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:coordinated><aaif:partOfText rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</aaif:partOfText><aaif:syntacticConstruction rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Intransitive" /></aaif:Verb><aaif:Adverb rdf:about="https://gams.uni-graz.at/o:aaif.fraweb#En3709Ph1Ad1"><aaif:text>menue</aaif:text><aaif:lemma rdf:resource="https://gams.uni-graz.at/o:aaif.lemma#menu" /><aaif:position rdf:datatype="http://www.w3.org/2001/XMLSchema#int">2</aaif:position><aaif:coordinated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:coordinated><aaif:morphosyntacticStructure rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Adjective" /><aaif:inflection rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#InaudibleInflection" /><aaif:attributionTarget rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Verb" /><aaif:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:modified><aaif:semanticClassification rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Manner" /><aaif:reduplicated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:reduplicated><aaif:prepositionalPhrase rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:prepositionalPhrase></aaif:Adverb><aaif:Entry rdf:about="https://gams.uni-graz.at/o:aaif.fraweb#En3710"><aaif:phrase rdf:resource="https://gams.uni-graz.at/o:aaif.fraweb#En3710Ph1" /><aaif:source rdf:resource="https://gams.uni-graz.at/o:aaif.fraweb.bibl#DC3728" /><gams:textualContent>Ici et là, plus présente, une note s’impose et revient au silence du tapis ostinato des basses.On retrouve ce climat distancié dans la Sérénade interrompue dont quelques brusqueries clairement affirmées troublent fort justement la tendresse.</gams:textualContent><rel:isPartOf rdf:resource="https://gams.uni-graz.at/o:aaif.fraweb" /></aaif:Entry><aaif:Phrase rdf:about="https://gams.uni-graz.at/o:aaif.fraweb#En3710Ph1"><aaif:verb rdf:resource="https://gams.uni-graz.at/o:aaif.fraweb#En3710Ph1Ve1" /><aaif:adverb rdf:resource="https://gams.uni-graz.at/o:aaif.fraweb#En3710Ph1Ad1" /><aaif:text>quelques brusqueries clairement affirmées troublent fort justement la tendresse</aaif:text><aaif:annoText>quelques brusqueries clairement affirmées [v|troublent|troubler|ts] [a|fort|fort|auvnqnnn] justement la tendresse</aaif:annoText></aaif:Phrase><aaif:Verb rdf:about="https://gams.uni-graz.at/o:aaif.fraweb#En3710Ph1Ve1"><aaif:text>troublent</aaif:text><aaif:lemma rdf:resource="https://gams.uni-graz.at/o:aaif.lemma#troubler" /><aaif:position rdf:datatype="http://www.w3.org/2001/XMLSchema#int">1</aaif:position><aaif:coordinated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:coordinated><aaif:partOfText rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</aaif:partOfText><aaif:syntacticConstruction rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Transitive" /></aaif:Verb><aaif:Adverb rdf:about="https://gams.uni-graz.at/o:aaif.fraweb#En3710Ph1Ad1"><aaif:text>fort</aaif:text><aaif:lemma rdf:resource="https://gams.uni-graz.at/o:aaif.lemma#fort" /><aaif:position rdf:datatype="http://www.w3.org/2001/XMLSchema#int">2</aaif:position><aaif:coordinated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:coordinated><aaif:morphosyntacticStructure rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Adjective" /><aaif:inflection rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Uninflected" /><aaif:attributionTarget rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Verb" /><aaif:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:modified><aaif:semanticClassification rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Quantity" /><aaif:reduplicated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:reduplicated><aaif:prepositionalPhrase rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:prepositionalPhrase></aaif:Adverb><aaif:Entry rdf:about="https://gams.uni-graz.at/o:aaif.fraweb#En3711"><aaif:phrase rdf:resource="https://gams.uni-graz.at/o:aaif.fraweb#En3711Ph1" /><aaif:source rdf:resource="https://gams.uni-graz.at/o:aaif.fraweb.bibl#DC3729" /><gams:textualContent>Comme d’hab, je te lis avec… une certaine délectation !(Même si je déplore que la Décroissance ne réserve pas ses flèches parfumées… au vitriol… à ceux qui les méritent le plus… et dont ni toi ni Patrick, ne font partie !)&lt;lb/&gt;Qu’un organe d’opinion soit en même temps un moyen d’existence pour ceux qui le fabriquent… est une “nécessité inexorable”… qui me trouble fort  !</gams:textualContent><rel:isPartOf rdf:resource="https://gams.uni-graz.at/o:aaif.fraweb" /></aaif:Entry><aaif:Phrase rdf:about="https://gams.uni-graz.at/o:aaif.fraweb#En3711Ph1"><aaif:verb rdf:resource="https://gams.uni-graz.at/o:aaif.fraweb#En3711Ph1Ve1" /><aaif:adverb rdf:resource="https://gams.uni-graz.at/o:aaif.fraweb#En3711Ph1Ad1" /><aaif:text>qui me trouble fort </aaif:text><aaif:annoText>qui me [v|trouble|troubler|ts] [a|fort|fort|auvnqnnn] </aaif:annoText></aaif:Phrase><aaif:Verb rdf:about="https://gams.uni-graz.at/o:aaif.fraweb#En3711Ph1Ve1"><aaif:text>trouble</aaif:text><aaif:lemma rdf:resource="https://gams.uni-graz.at/o:aaif.lemma#troubler" /><aaif:position rdf:datatype="http://www.w3.org/2001/XMLSchema#int">1</aaif:position><aaif:coordinated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:coordinated><aaif:partOfText rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</aaif:partOfText><aaif:syntacticConstruction rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Transitive" /></aaif:Verb><aaif:Adverb rdf:about="https://gams.uni-graz.at/o:aaif.fraweb#En3711Ph1Ad1"><aaif:text>fort</aaif:text><aaif:lemma rdf:resource="https://gams.uni-graz.at/o:aaif.lemma#fort" /><aaif:position rdf:datatype="http://www.w3.org/2001/XMLSchema#int">2</aaif:position><aaif:coordinated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:coordinated><aaif:morphosyntacticStructure rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Adjective" /><aaif:inflection rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Uninflected" /><aaif:attributionTarget rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Verb" /><aaif:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:modified><aaif:semanticClassification rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Quantity" /><aaif:reduplicated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:reduplicated><aaif:prepositionalPhrase rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:prepositionalPhrase></aaif:Adverb><aaif:Entry rdf:about="https://gams.uni-graz.at/o:aaif.fraweb#En3712"><aaif:phrase rdf:resource="https://gams.uni-graz.at/o:aaif.fraweb#En3712Ph1" /><aaif:source rdf:resource="https://gams.uni-graz.at/o:aaif.fraweb.bibl#DC3730" /><gams:textualContent>Estepous (Guillierme) se met vite à température.Katif est de tous les coups, ça chauffe pour le taureau, 2 minutes les premiers attributs.Katif pleine piste se trouve court  , Estepous pousse et le déséquilibre, le raseteur se jette par terre, mais le taureau ne va pas le lâcher pendant de longues secondes.</gams:textualContent><rel:isPartOf rdf:resource="https://gams.uni-graz.at/o:aaif.fraweb" /></aaif:Entry><aaif:Phrase rdf:about="https://gams.uni-graz.at/o:aaif.fraweb#En3712Ph1"><aaif:verb rdf:resource="https://gams.uni-graz.at/o:aaif.fraweb#En3712Ph1Ve1" /><aaif:adverb rdf:resource="https://gams.uni-graz.at/o:aaif.fraweb#En3712Ph1Ad1" /><aaif:text>Katif pleine piste se trouve court </aaif:text><aaif:annoText>Katif pleine piste [v|se trouve|trouver|rs] [a|court|court|auvnmnnn] </aaif:annoText></aaif:Phrase><aaif:Verb rdf:about="https://gams.uni-graz.at/o:aaif.fraweb#En3712Ph1Ve1"><aaif:text>se trouve</aaif:text><aaif:lemma rdf:resource="https://gams.uni-graz.at/o:aaif.lemma#trouver" /><aaif:position rdf:datatype="http://www.w3.org/2001/XMLSchema#int">1</aaif:position><aaif:coordinated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:coordinated><aaif:partOfText rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</aaif:partOfText><aaif:syntacticConstruction rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Reflexive" /></aaif:Verb><aaif:Adverb rdf:about="https://gams.uni-graz.at/o:aaif.fraweb#En3712Ph1Ad1"><aaif:text>court</aaif:text><aaif:lemma rdf:resource="https://gams.uni-graz.at/o:aaif.lemma#court" /><aaif:position rdf:datatype="http://www.w3.org/2001/XMLSchema#int">2</aaif:position><aaif:coordinated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:coordinated><aaif:morphosyntacticStructure rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Adjective" /><aaif:inflection rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Uninflected" /><aaif:attributionTarget rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Verb" /><aaif:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:modified><aaif:semanticClassification rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Manner" /><aaif:reduplicated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:reduplicated><aaif:prepositionalPhrase rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:prepositionalPhrase></aaif:Adverb><aaif:Entry rdf:about="https://gams.uni-graz.at/o:aaif.fraweb#En3713"><aaif:phrase rdf:resource="https://gams.uni-graz.at/o:aaif.fraweb#En3713Ph1" /><aaif:source rdf:resource="https://gams.uni-graz.at/o:aaif.fraweb.bibl#DC3731" /><gams:textualContent>Essayez d'avoir l'air sans importance, au cas où ceux d'en face se trouvent courts sur les munitions.</gams:textualContent><rel:isPartOf rdf:resource="https://gams.uni-graz.at/o:aaif.fraweb" /></aaif:Entry><aaif:Phrase rdf:about="https://gams.uni-graz.at/o:aaif.fraweb#En3713Ph1"><aaif:verb rdf:resource="https://gams.uni-graz.at/o:aaif.fraweb#En3713Ph1Ve1" /><aaif:adverb rdf:resource="https://gams.uni-graz.at/o:aaif.fraweb#En3713Ph1Ad1" /><aaif:text>ceux d'en face se trouvent courts sur les munitions</aaif:text><aaif:annoText>ceux d'en face [v|se trouvent|trouver|rs] [a|courts|court|aivnqnnn] sur les munitions</aaif:annoText></aaif:Phrase><aaif:Verb rdf:about="https://gams.uni-graz.at/o:aaif.fraweb#En3713Ph1Ve1"><aaif:text>se trouvent</aaif:text><aaif:lemma rdf:resource="https://gams.uni-graz.at/o:aaif.lemma#trouver" /><aaif:position rdf:datatype="http://www.w3.org/2001/XMLSchema#int">1</aaif:position><aaif:coordinated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:coordinated><aaif:partOfText rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</aaif:partOfText><aaif:syntacticConstruction rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Reflexive" /></aaif:Verb><aaif:Adverb rdf:about="https://gams.uni-graz.at/o:aaif.fraweb#En3713Ph1Ad1"><aaif:text>courts</aaif:text><aaif:lemma rdf:resource="https://gams.uni-graz.at/o:aaif.lemma#court" /><aaif:position rdf:datatype="http://www.w3.org/2001/XMLSchema#int">2</aaif:position><aaif:coordinated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:coordinated><aaif:morphosyntacticStructure rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Adjective" /><aaif:inflection rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#InaudibleInflection" /><aaif:attributionTarget rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Verb" /><aaif:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:modified><aaif:semanticClassification rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Quantity" /><aaif:reduplicated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:reduplicated><aaif:prepositionalPhrase rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:prepositionalPhrase></aaif:Adverb><aaif:Entry rdf:about="https://gams.uni-graz.at/o:aaif.fraweb#En3714"><aaif:phrase rdf:resource="https://gams.uni-graz.at/o:aaif.fraweb#En3714Ph1" /><aaif:source rdf:resource="https://gams.uni-graz.at/o:aaif.fraweb.bibl#DC3732" /><gams:textualContent>Sur les autres miradors sa a bien tirer un ami a rater un brocard, mais un autre a fait un doubler.Il tire vers un brocard qu'il pense avoir manqué et 30 minutes plus tard uil retire sur un autre qu'il tue net  en allant rechercher son brocard il va vérifier sur son premier, il est mort 20 métres a l'interieur du bois.Total de l'affut du matin 3 brocards et 1 sangliers.</gams:textualContent><rel:isPartOf rdf:resource="https://gams.uni-graz.at/o:aaif.fraweb" /></aaif:Entry><aaif:Phrase rdf:about="https://gams.uni-graz.at/o:aaif.fraweb#En3714Ph1"><aaif:verb rdf:resource="https://gams.uni-graz.at/o:aaif.fraweb#En3714Ph1Ve1" /><aaif:adverb rdf:resource="https://gams.uni-graz.at/o:aaif.fraweb#En3714Ph1Ad1" /><aaif:text>un autre qu'il tue net </aaif:text><aaif:annoText>un autre qu'il [v|tue|tuer|ts] [a|net|net|auvnmnnn] </aaif:annoText></aaif:Phrase><aaif:Verb rdf:about="https://gams.uni-graz.at/o:aaif.fraweb#En3714Ph1Ve1"><aaif:text>tue</aaif:text><aaif:lemma rdf:resource="https://gams.uni-graz.at/o:aaif.lemma#tuer" /><aaif:position rdf:datatype="http://www.w3.org/2001/XMLSchema#int">1</aaif:position><aaif:coordinated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:coordinated><aaif:partOfText rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</aaif:partOfText><aaif:syntacticConstruction rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Transitive" /></aaif:Verb><aaif:Adverb rdf:about="https://gams.uni-graz.at/o:aaif.fraweb#En3714Ph1Ad1"><aaif:text>net</aaif:text><aaif:lemma rdf:resource="https://gams.uni-graz.at/o:aaif.lemma#net" /><aaif:position rdf:datatype="http://www.w3.org/2001/XMLSchema#int">2</aaif:position><aaif:coordinated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:coordinated><aaif:morphosyntacticStructure rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Adjective" /><aaif:inflection rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Uninflected" /><aaif:attributionTarget rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Verb" /><aaif:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:modified><aaif:semanticClassification rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Manner" /><aaif:reduplicated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:reduplicated><aaif:prepositionalPhrase rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:prepositionalPhrase></aaif:Adverb><aaif:Entry rdf:about="https://gams.uni-graz.at/o:aaif.fraweb#En3715"><aaif:phrase rdf:resource="https://gams.uni-graz.at/o:aaif.fraweb#En3715Ph1" /><aaif:source rdf:resource="https://gams.uni-graz.at/o:aaif.fraweb.bibl#DC3733" /><gams:textualContent>Le style de kung fu ensuite y est très "Wang yu" aussi, c'est à dire risible, à l'opposé de Bruce Lee, composé de coups de poing qui tuent nets bien violents et de coups de pieds ridicules il faut bien le dire.</gams:textualContent><rel:isPartOf rdf:resource="https://gams.uni-graz.at/o:aaif.fraweb" /></aaif:Entry><aaif:Phrase rdf:about="https://gams.uni-graz.at/o:aaif.fraweb#En3715Ph1"><aaif:verb rdf:resource="https://gams.uni-graz.at/o:aaif.fraweb#En3715Ph1Ve1" /><aaif:adverb rdf:resource="https://gams.uni-graz.at/o:aaif.fraweb#En3715Ph1Ad1" /><aaif:text>de coups de poing qui tuent nets bien violents</aaif:text><aaif:annoText>de coups de poing qui [v|tuent|tuer|is] [a|nets|net|aivnmnnn] bien violents</aaif:annoText></aaif:Phrase><aaif:Verb rdf:about="https://gams.uni-graz.at/o:aaif.fraweb#En3715Ph1Ve1"><aaif:text>tuent</aaif:text><aaif:lemma rdf:resource="https://gams.uni-graz.at/o:aaif.lemma#tuer" /><aaif:position rdf:datatype="http://www.w3.org/2001/XMLSchema#int">1</aaif:position><aaif:coordinated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:coordinated><aaif:partOfText rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</aaif:partOfText><aaif:syntacticConstruction rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Intransitive" /></aaif:Verb><aaif:Adverb rdf:about="https://gams.uni-graz.at/o:aaif.fraweb#En3715Ph1Ad1"><aaif:text>nets</aaif:text><aaif:lemma rdf:resource="https://gams.uni-graz.at/o:aaif.lemma#net" /><aaif:position rdf:datatype="http://www.w3.org/2001/XMLSchema#int">2</aaif:position><aaif:coordinated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:coordinated><aaif:morphosyntacticStructure rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Adjective" /><aaif:inflection rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#InaudibleInflection" /><aaif:attributionTarget rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Verb" /><aaif:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:modified><aaif:semanticClassification rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Manner" /><aaif:reduplicated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:reduplicated><aaif:prepositionalPhrase rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:prepositionalPhrase></aaif:Adverb><aaif:Entry rdf:about="https://gams.uni-graz.at/o:aaif.fraweb#En3716"><aaif:phrase rdf:resource="https://gams.uni-graz.at/o:aaif.fraweb#En3716Ph1" /><aaif:source rdf:resource="https://gams.uni-graz.at/o:aaif.fraweb.bibl#DC3734" /><gams:textualContent>il les coupent parce que c'est accidentogéne (c'est la cause de plus de morts avec les arbres ) ils pensent que un accident avec les arbres tuent nets les gens !!pas d'arbres juste des barrieres </gams:textualContent><rel:isPartOf rdf:resource="https://gams.uni-graz.at/o:aaif.fraweb" /></aaif:Entry><aaif:Phrase rdf:about="https://gams.uni-graz.at/o:aaif.fraweb#En3716Ph1"><aaif:verb rdf:resource="https://gams.uni-graz.at/o:aaif.fraweb#En3716Ph1Ve1" /><aaif:adverb rdf:resource="https://gams.uni-graz.at/o:aaif.fraweb#En3716Ph1Ad1" /><aaif:text>ils pensent que un accident avec les arbres tuent nets les gens</aaif:text><aaif:annoText>ils pensent que un accident avec les arbres [v|tuent|tuer|ts] [a|nets|nets|aivnmnnn] les gens</aaif:annoText></aaif:Phrase><aaif:Verb rdf:about="https://gams.uni-graz.at/o:aaif.fraweb#En3716Ph1Ve1"><aaif:text>tuent</aaif:text><aaif:lemma rdf:resource="https://gams.uni-graz.at/o:aaif.lemma#tuer" /><aaif:position rdf:datatype="http://www.w3.org/2001/XMLSchema#int">1</aaif:position><aaif:coordinated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:coordinated><aaif:partOfText rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</aaif:partOfText><aaif:syntacticConstruction rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Transitive" /></aaif:Verb><aaif:Adverb rdf:about="https://gams.uni-graz.at/o:aaif.fraweb#En3716Ph1Ad1"><aaif:text>nets</aaif:text><aaif:lemma rdf:resource="https://gams.uni-graz.at/o:aaif.lemma#nets" /><aaif:position rdf:datatype="http://www.w3.org/2001/XMLSchema#int">2</aaif:position><aaif:coordinated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:coordinated><aaif:morphosyntacticStructure rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Adjective" /><aaif:inflection rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#InaudibleInflection" /><aaif:attributionTarget rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Verb" /><aaif:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:modified><aaif:semanticClassification rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Manner" /><aaif:reduplicated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:reduplicated><aaif:prepositionalPhrase rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:prepositionalPhrase></aaif:Adverb><aaif:Entry rdf:about="https://gams.uni-graz.at/o:aaif.fraweb#En3717"><aaif:phrase rdf:resource="https://gams.uni-graz.at/o:aaif.fraweb#En3717Ph1" /><aaif:source rdf:resource="https://gams.uni-graz.at/o:aaif.fraweb.bibl#DC3735" /><gams:textualContent>La foudre entre par une partie du corps et ressort par les pieds par exemple.Dans le cas de foudre descendante, une très grande partie de l’éclair contourne le corps mais ce qui passe au travers est suffisant pour tuer raide  .</gams:textualContent><rel:isPartOf rdf:resource="https://gams.uni-graz.at/o:aaif.fraweb" /></aaif:Entry><aaif:Phrase rdf:about="https://gams.uni-graz.at/o:aaif.fraweb#En3717Ph1"><aaif:verb rdf:resource="https://gams.uni-graz.at/o:aaif.fraweb#En3717Ph1Ve1" /><aaif:adverb rdf:resource="https://gams.uni-graz.at/o:aaif.fraweb#En3717Ph1Ad1" /><aaif:text>pour tuer raide </aaif:text><aaif:annoText>pour [v|tuer|tuer|is] [a|raide|raide|auvnmnnn] </aaif:annoText></aaif:Phrase><aaif:Verb rdf:about="https://gams.uni-graz.at/o:aaif.fraweb#En3717Ph1Ve1"><aaif:text>tuer</aaif:text><aaif:lemma rdf:resource="https://gams.uni-graz.at/o:aaif.lemma#tuer" /><aaif:position rdf:datatype="http://www.w3.org/2001/XMLSchema#int">1</aaif:position><aaif:coordinated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:coordinated><aaif:partOfText rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</aaif:partOfText><aaif:syntacticConstruction rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Intransitive" /></aaif:Verb><aaif:Adverb rdf:about="https://gams.uni-graz.at/o:aaif.fraweb#En3717Ph1Ad1"><aaif:text>raide</aaif:text><aaif:lemma rdf:resource="https://gams.uni-graz.at/o:aaif.lemma#raide" /><aaif:position rdf:datatype="http://www.w3.org/2001/XMLSchema#int">2</aaif:position><aaif:coordinated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:coordinated><aaif:morphosyntacticStructure rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Adjective" /><aaif:inflection rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Uninflected" /><aaif:attributionTarget rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Verb" /><aaif:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:modified><aaif:semanticClassification rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Manner" /><aaif:reduplicated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:reduplicated><aaif:prepositionalPhrase rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:prepositionalPhrase></aaif:Adverb><aaif:Entry rdf:about="https://gams.uni-graz.at/o:aaif.fraweb#En3718"><aaif:phrase rdf:resource="https://gams.uni-graz.at/o:aaif.fraweb#En3718Ph1" /><aaif:source rdf:resource="https://gams.uni-graz.at/o:aaif.fraweb.bibl#DC3736" /><gams:textualContent>Éperdument amoureux, aussi Voyage civitavecchia palerme il y a bientôt deux cents ans que les tribus sont revenues aux rites anciens et aux nobles qui étaient dans la confidence des alcôves.Aie pas peur, ce garçon-là; qu'est-ce que ça pouvait tuer raide une femme, d'une féerie, et quoique de jour en jo Voyage civitavecchia palerme ur plus important.</gams:textualContent><rel:isPartOf rdf:resource="https://gams.uni-graz.at/o:aaif.fraweb" /></aaif:Entry><aaif:Phrase rdf:about="https://gams.uni-graz.at/o:aaif.fraweb#En3718Ph1"><aaif:verb rdf:resource="https://gams.uni-graz.at/o:aaif.fraweb#En3718Ph1Ve1" /><aaif:adverb rdf:resource="https://gams.uni-graz.at/o:aaif.fraweb#En3718Ph1Ad1" /><aaif:text>ça pouvait tuer raide une femme</aaif:text><aaif:annoText>ça pouvait [v|tuer|tuer|ts] [a|raide|raide|auvnmnnn] une femme</aaif:annoText></aaif:Phrase><aaif:Verb rdf:about="https://gams.uni-graz.at/o:aaif.fraweb#En3718Ph1Ve1"><aaif:text>tuer</aaif:text><aaif:lemma rdf:resource="https://gams.uni-graz.at/o:aaif.lemma#tuer" /><aaif:position rdf:datatype="http://www.w3.org/2001/XMLSchema#int">1</aaif:position><aaif:coordinated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:coordinated><aaif:partOfText rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</aaif:partOfText><aaif:syntacticConstruction rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Transitive" /></aaif:Verb><aaif:Adverb rdf:about="https://gams.uni-graz.at/o:aaif.fraweb#En3718Ph1Ad1"><aaif:text>raide</aaif:text><aaif:lemma rdf:resource="https://gams.uni-graz.at/o:aaif.lemma#raide" /><aaif:position rdf:datatype="http://www.w3.org/2001/XMLSchema#int">2</aaif:position><aaif:coordinated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:coordinated><aaif:morphosyntacticStructure rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Adjective" /><aaif:inflection rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Uninflected" /><aaif:attributionTarget rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Verb" /><aaif:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:modified><aaif:semanticClassification rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Manner" /><aaif:reduplicated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:reduplicated><aaif:prepositionalPhrase rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:prepositionalPhrase></aaif:Adverb><aaif:Entry rdf:about="https://gams.uni-graz.at/o:aaif.fraweb#En3719"><aaif:phrase rdf:resource="https://gams.uni-graz.at/o:aaif.fraweb#En3719Ph1" /><aaif:source rdf:resource="https://gams.uni-graz.at/o:aaif.fraweb.bibl#DC3737" /><gams:textualContent>Voici encore fait divers illustrant le danger des allumettes laissées entre les mains des enfants.Une petite fille qui jouait auprès d'une fenêtre avec des allumettes, s'étant penchée pour regarder dans la rue, est tombée du huitième étage et s'est tuée raide  .</gams:textualContent><rel:isPartOf rdf:resource="https://gams.uni-graz.at/o:aaif.fraweb" /></aaif:Entry><aaif:Phrase rdf:about="https://gams.uni-graz.at/o:aaif.fraweb#En3719Ph1"><aaif:verb rdf:resource="https://gams.uni-graz.at/o:aaif.fraweb#En3719Ph1Ve1" /><aaif:adverb rdf:resource="https://gams.uni-graz.at/o:aaif.fraweb#En3719Ph1Ad1" /><aaif:text>Une petite fille qui jouait auprès d'une fenêtre avec des allumettes, s'étant penchée pour regarder dans la rue, est tombée du huitième étage et s'est tuée raide </aaif:text><aaif:annoText>Une petite fille qui jouait auprès d'une fenêtre avec des allumettes, s'étant penchée pour regarder dans la rue, est tombée du huitième étage et [v|s'est tuée|tuer|rs] [a|raide|raide|auvnmnnn] </aaif:annoText></aaif:Phrase><aaif:Verb rdf:about="https://gams.uni-graz.at/o:aaif.fraweb#En3719Ph1Ve1"><aaif:text>s'est tuée</aaif:text><aaif:lemma rdf:resource="https://gams.uni-graz.at/o:aaif.lemma#tuer" /><aaif:position rdf:datatype="http://www.w3.org/2001/XMLSchema#int">1</aaif:position><aaif:coordinated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:coordinated><aaif:partOfText rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</aaif:partOfText><aaif:syntacticConstruction rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Reflexive" /></aaif:Verb><aaif:Adverb rdf:about="https://gams.uni-graz.at/o:aaif.fraweb#En3719Ph1Ad1"><aaif:text>raide</aaif:text><aaif:lemma rdf:resource="https://gams.uni-graz.at/o:aaif.lemma#raide" /><aaif:position rdf:datatype="http://www.w3.org/2001/XMLSchema#int">2</aaif:position><aaif:coordinated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:coordinated><aaif:morphosyntacticStructure rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Adjective" /><aaif:inflection rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Uninflected" /><aaif:attributionTarget rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Verb" /><aaif:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:modified><aaif:semanticClassification rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Manner" /><aaif:reduplicated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:reduplicated><aaif:prepositionalPhrase rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:prepositionalPhrase></aaif:Adverb><aaif:Entry rdf:about="https://gams.uni-graz.at/o:aaif.fraweb#En3720"><aaif:phrase rdf:resource="https://gams.uni-graz.at/o:aaif.fraweb#En3720Ph1" /><aaif:source rdf:resource="https://gams.uni-graz.at/o:aaif.fraweb.bibl#DC3738" /><gams:textualContent>pour les insectes nous n'avons pas eu de problèmes à chaque soir il passe un gaz qui les tuent raides  (ha, ha, ha) nous n'avons pas eu besoins de watkins durant notre voyage même au resto à la carte.</gams:textualContent><rel:isPartOf rdf:resource="https://gams.uni-graz.at/o:aaif.fraweb" /></aaif:Entry><aaif:Phrase rdf:about="https://gams.uni-graz.at/o:aaif.fraweb#En3720Ph1"><aaif:verb rdf:resource="https://gams.uni-graz.at/o:aaif.fraweb#En3720Ph1Ve1" /><aaif:adverb rdf:resource="https://gams.uni-graz.at/o:aaif.fraweb#En3720Ph1Ad1" /><aaif:text>il passe un gaz qui les tuent raides </aaif:text><aaif:annoText>il passe un gaz qui les [v|tuent|tuer|ts] [a|raides|raide|aivnmnnn] </aaif:annoText></aaif:Phrase><aaif:Verb rdf:about="https://gams.uni-graz.at/o:aaif.fraweb#En3720Ph1Ve1"><aaif:text>tuent</aaif:text><aaif:lemma rdf:resource="https://gams.uni-graz.at/o:aaif.lemma#tuer" /><aaif:position rdf:datatype="http://www.w3.org/2001/XMLSchema#int">1</aaif:position><aaif:coordinated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:coordinated><aaif:partOfText rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</aaif:partOfText><aaif:syntacticConstruction rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Transitive" /></aaif:Verb><aaif:Adverb rdf:about="https://gams.uni-graz.at/o:aaif.fraweb#En3720Ph1Ad1"><aaif:text>raides</aaif:text><aaif:lemma rdf:resource="https://gams.uni-graz.at/o:aaif.lemma#raide" /><aaif:position rdf:datatype="http://www.w3.org/2001/XMLSchema#int">2</aaif:position><aaif:coordinated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:coordinated><aaif:morphosyntacticStructure rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Adjective" /><aaif:inflection rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#InaudibleInflection" /><aaif:attributionTarget rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Verb" /><aaif:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:modified><aaif:semanticClassification rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Manner" /><aaif:reduplicated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:reduplicated><aaif:prepositionalPhrase rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:prepositionalPhrase></aaif:Adverb><aaif:Entry rdf:about="https://gams.uni-graz.at/o:aaif.fraweb#En3721"><aaif:phrase rdf:resource="https://gams.uni-graz.at/o:aaif.fraweb#En3721Ph1" /><aaif:source rdf:resource="https://gams.uni-graz.at/o:aaif.fraweb.bibl#DC3739" /><gams:textualContent>Elle avait pour complices deux autres femmes, fabricant et vendant des essences vénéneuses.La partie volatile, les gaz que dégageait leur marchandise, finirent par tuer raides ces Locustes ; du moins, on les trouva empoisonnées, comme trois rats, dont la mort n’entraîne pas de deuil.</gams:textualContent><rel:isPartOf rdf:resource="https://gams.uni-graz.at/o:aaif.fraweb" /></aaif:Entry><aaif:Phrase rdf:about="https://gams.uni-graz.at/o:aaif.fraweb#En3721Ph1"><aaif:verb rdf:resource="https://gams.uni-graz.at/o:aaif.fraweb#En3721Ph1Ve1" /><aaif:adverb rdf:resource="https://gams.uni-graz.at/o:aaif.fraweb#En3721Ph1Ad1" /><aaif:text>par tuer raides ces Locustes</aaif:text><aaif:annoText>par [v|tuer|tuer|ts] [a|raides|raide|aivnmnnn] ces Locustes</aaif:annoText></aaif:Phrase><aaif:Verb rdf:about="https://gams.uni-graz.at/o:aaif.fraweb#En3721Ph1Ve1"><aaif:text>tuer</aaif:text><aaif:lemma rdf:resource="https://gams.uni-graz.at/o:aaif.lemma#tuer" /><aaif:position rdf:datatype="http://www.w3.org/2001/XMLSchema#int">1</aaif:position><aaif:coordinated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:coordinated><aaif:partOfText rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</aaif:partOfText><aaif:syntacticConstruction rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Transitive" /></aaif:Verb><aaif:Adverb rdf:about="https://gams.uni-graz.at/o:aaif.fraweb#En3721Ph1Ad1"><aaif:text>raides</aaif:text><aaif:lemma rdf:resource="https://gams.uni-graz.at/o:aaif.lemma#raide" /><aaif:position rdf:datatype="http://www.w3.org/2001/XMLSchema#int">2</aaif:position><aaif:coordinated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:coordinated><aaif:morphosyntacticStructure rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Adjective" /><aaif:inflection rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#InaudibleInflection" /><aaif:attributionTarget rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Verb" /><aaif:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:modified><aaif:semanticClassification rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Manner" /><aaif:reduplicated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:reduplicated><aaif:prepositionalPhrase rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:prepositionalPhrase></aaif:Adverb><aaif:Entry rdf:about="https://gams.uni-graz.at/o:aaif.fraweb#En3722"><aaif:phrase rdf:resource="https://gams.uni-graz.at/o:aaif.fraweb#En3722Ph1" /><aaif:phrase rdf:resource="https://gams.uni-graz.at/o:aaif.fraweb#En3722Ph2" /><aaif:source rdf:resource="https://gams.uni-graz.at/o:aaif.fraweb.bibl#DC3740" /><gams:textualContent>Ma rune vaut elle cher  ?Bonjour tout le monde, je voulais savoir quel est le niveau de rarete de ma rune et si elle vaut cher  .</gams:textualContent><rel:isPartOf rdf:resource="https://gams.uni-graz.at/o:aaif.fraweb" /></aaif:Entry><aaif:Phrase rdf:about="https://gams.uni-graz.at/o:aaif.fraweb#En3722Ph1"><aaif:verb rdf:resource="https://gams.uni-graz.at/o:aaif.fraweb#En3722Ph1Ve1" /><aaif:adverb rdf:resource="https://gams.uni-graz.at/o:aaif.fraweb#En3722Ph1Ad1" /><aaif:text>Ma rune vaut elle cher </aaif:text><aaif:annoText>Ma rune [v|vaut elle|valoir|is] [a|cher|cher|ausnmnnn] </aaif:annoText></aaif:Phrase><aaif:Verb rdf:about="https://gams.uni-graz.at/o:aaif.fraweb#En3722Ph1Ve1"><aaif:text>vaut elle</aaif:text><aaif:lemma rdf:resource="https://gams.uni-graz.at/o:aaif.lemma#valoir" /><aaif:position rdf:datatype="http://www.w3.org/2001/XMLSchema#int">1</aaif:position><aaif:coordinated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:coordinated><aaif:partOfText rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</aaif:partOfText><aaif:syntacticConstruction rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Intransitive" /></aaif:Verb><aaif:Adverb rdf:about="https://gams.uni-graz.at/o:aaif.fraweb#En3722Ph1Ad1"><aaif:text>cher</aaif:text><aaif:lemma rdf:resource="https://gams.uni-graz.at/o:aaif.lemma#cher" /><aaif:position rdf:datatype="http://www.w3.org/2001/XMLSchema#int">2</aaif:position><aaif:coordinated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:coordinated><aaif:morphosyntacticStructure rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Adjective" /><aaif:inflection rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Uninflected" /><aaif:attributionTarget rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Verb" /><aaif:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:modified><aaif:semanticClassification rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Manner" /><aaif:reduplicated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:reduplicated><aaif:prepositionalPhrase rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:prepositionalPhrase></aaif:Adverb><aaif:Phrase rdf:about="https://gams.uni-graz.at/o:aaif.fraweb#En3722Ph2"><aaif:verb rdf:resource="https://gams.uni-graz.at/o:aaif.fraweb#En3722Ph2Ve1" /><aaif:adverb rdf:resource="https://gams.uni-graz.at/o:aaif.fraweb#En3722Ph2Ad1" /><aaif:text>quel est le niveau de rarete de ma rune 