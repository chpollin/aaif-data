ps://gams.uni-graz.at/o:aaif.fraweb#En1996Ph1" /><aaif:source rdf:resource="https://gams.uni-graz.at/o:aaif.fraweb.bibl#DC2004" /><gams:textualContent>Bien manger pour mourir gras  !</gams:textualContent><rel:isPartOf rdf:resource="https://gams.uni-graz.at/o:aaif.fraweb" /></aaif:Entry><aaif:Phrase rdf:about="https://gams.uni-graz.at/o:aaif.fraweb#En1996Ph1"><aaif:verb rdf:resource="https://gams.uni-graz.at/o:aaif.fraweb#En1996Ph1Ve1" /><aaif:adverb rdf:resource="https://gams.uni-graz.at/o:aaif.fraweb#En1996Ph1Ad1" /><aaif:text>Bien manger pour mourir gras </aaif:text><aaif:annoText>Bien manger pour [v|mourir|mourir|is] [a|gras|gras|ausnmnnn] </aaif:annoText></aaif:Phrase><aaif:Verb rdf:about="https://gams.uni-graz.at/o:aaif.fraweb#En1996Ph1Ve1"><aaif:text>mourir</aaif:text><aaif:lemma rdf:resource="https://gams.uni-graz.at/o:aaif.lemma#mourir" /><aaif:position rdf:datatype="http://www.w3.org/2001/XMLSchema#int">1</aaif:position><aaif:coordinated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:coordinated><aaif:partOfText rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</aaif:partOfText><aaif:syntacticConstruction rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Intransitive" /></aaif:Verb><aaif:Adverb rdf:about="https://gams.uni-graz.at/o:aaif.fraweb#En1996Ph1Ad1"><aaif:text>gras</aaif:text><aaif:lemma rdf:resource="https://gams.uni-graz.at/o:aaif.lemma#gras" /><aaif:position rdf:datatype="http://www.w3.org/2001/XMLSchema#int">2</aaif:position><aaif:coordinated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:coordinated><aaif:morphosyntacticStructure rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Adjective" /><aaif:inflection rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Uninflected" /><aaif:attributionTarget rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Verb" /><aaif:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:modified><aaif:semanticClassification rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Manner" /><aaif:reduplicated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:reduplicated><aaif:prepositionalPhrase rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:prepositionalPhrase></aaif:Adverb><aaif:Entry rdf:about="https://gams.uni-graz.at/o:aaif.fraweb#En1997"><aaif:phrase rdf:resource="https://gams.uni-graz.at/o:aaif.fraweb#En1997Ph1" /><aaif:source rdf:resource="https://gams.uni-graz.at/o:aaif.fraweb.bibl#DC2005" /><gams:textualContent>Sans parler de l'oie et du canard qui ont l'habitude ici de mourir gras  , Cologne est au cœur de la culture de l'ail.</gams:textualContent><rel:isPartOf rdf:resource="https://gams.uni-graz.at/o:aaif.fraweb" /></aaif:Entry><aaif:Phrase rdf:about="https://gams.uni-graz.at/o:aaif.fraweb#En1997Ph1"><aaif:verb rdf:resource="https://gams.uni-graz.at/o:aaif.fraweb#En1997Ph1Ve1" /><aaif:adverb rdf:resource="https://gams.uni-graz.at/o:aaif.fraweb#En1997Ph1Ad1" /><aaif:text>qui ont l'habitude ici de mourir gras </aaif:text><aaif:annoText>qui ont l'habitude ici de [v|mourir|mourir|is] [a|gras|gras|ausnmnnn] </aaif:annoText></aaif:Phrase><aaif:Verb rdf:about="https://gams.uni-graz.at/o:aaif.fraweb#En1997Ph1Ve1"><aaif:text>mourir</aaif:text><aaif:lemma rdf:resource="https://gams.uni-graz.at/o:aaif.lemma#mourir" /><aaif:position rdf:datatype="http://www.w3.org/2001/XMLSchema#int">1</aaif:position><aaif:coordinated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:coordinated><aaif:partOfText rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</aaif:partOfText><aaif:syntacticConstruction rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Intransitive" /></aaif:Verb><aaif:Adverb rdf:about="https://gams.uni-graz.at/o:aaif.fraweb#En1997Ph1Ad1"><aaif:text>gras</aaif:text><aaif:lemma rdf:resource="https://gams.uni-graz.at/o:aaif.lemma#gras" /><aaif:position rdf:datatype="http://www.w3.org/2001/XMLSchema#int">2</aaif:posit