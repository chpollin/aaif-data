<rdf:RDF xmlns:rdf="http://www.w3.org/1999/02/22-rdf-syntax-ns#" xmlns:dc="http://purl.org/dc/elements/1.1/" xmlns:functx="http://www.functx.com" xmlns:gn="http://www.geonames.org/ontology#" xmlns:dcterms="http://purl.org/dc/terms/" xmlns:gams="https://gams.uni-graz.at/o:gams-ontology/#" xmlns:skos="http://glossa.uni-graz.at/skos/scheme/o:oth/#" xmlns:t="http://www.tei-c.org/ns/1.0" xmlns:rdau="http://rdaregistry.info/Elements/u/" xmlns:aaif="https://gams.uni-graz.at/o:aaif.ontology#" xmlns:rel="http://gams.uni-graz.at#" xmlns:xd="http://www.oxygenxml.com/ns/doc/xsl"><rdf:Description rdf:about="https://gams.uni-graz.at/o:aaif.fraweb"><rel:isPartOf rdf:resource="https://gams.uni-graz.at/corpus:aaif.fraweb" /><dcterms:extent>137387</dcterms:extent></rdf:Description><aaif:Entry rdf:about="https://gams.uni-graz.at/o:aaif.fraweb#En4"><aaif:phrase rdf:resource="https://gams.uni-graz.at/o:aaif.fraweb#En4Ph1" /><aaif:source rdf:resource="https://gams.uni-graz.at/o:aaif.fraweb.bibl#DC1" /><gams:textualContent>Je m'abaisse bas vers le sol, inclinant ma tête en révérance.</gams:textualContent><rel:isPartOf rdf:resource="https://gams.uni-graz.at/o:aaif.fraweb" /></aaif:Entry><aaif:Phrase rdf:about="https://gams.uni-graz.at/o:aaif.fraweb#En4Ph1"><aaif:verb rdf:resource="https://gams.uni-graz.at/o:aaif.fraweb#En4Ph1Ve1" /><aaif:adverb rdf:resource="https://gams.uni-graz.at/o:aaif.fraweb#En4Ph1Ad1" /><aaif:text>Je m'abaisse bas vers le sol</aaif:text><aaif:annoText>Je [v|m'abaisse|abaisser|rs] [a|bas|bas|auvnlnnn] vers le sol</aaif:annoText></aaif:Phrase><aaif:Verb rdf:about="https://gams.uni-graz.at/o:aaif.fraweb#En4Ph1Ve1"><aaif:text>m'abaisse</aaif:text><aaif:lemma rdf:resource="https://gams.uni-graz.at/o:aaif.lemma#abaisser" /><aaif:position rdf:datatype="http://www.w3.org/2001/XMLSchema#int">1</aaif:position><aaif:coordinated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:coordinated><aaif:partOfText rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</aaif:partOfText><aaif:syntacticConstruction rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Reflexive" /></aaif:Verb><aaif:Adverb rdf:about="https://gams.uni-graz.at/o:aaif.fraweb#En4Ph1Ad1"><aaif:text>bas</aaif:text><aaif:lemma rdf:resource="https://gams.uni-graz.at/o:aaif.lemma#bas" /><aaif:position rdf:datatype="http://www.w3.org/2001/XMLSchema#int">2</aaif:position><aaif:coordinated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:coordinated><aaif:morphosyntacticStructure rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Adjective" /><aaif:inflection rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Uninflected" /><aaif:attributionTarget rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Verb" /><aaif:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:modified><aaif:semanticClassification rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Location" /><aaif:reduplicated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:reduplicated><aaif:prepositionalPhrase rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:prepositionalPhrase></aaif:Adverb><aaif:Entry rdf:about="https://gams.uni-graz.at/o:aaif.fraweb#En5"><aaif:phrase rdf:resource="https://gams.uni-graz.at/o:aaif.fraweb#En5Ph1" /><aaif:source rdf:resource="https://gams.uni-graz.at/o:aaif.fraweb.bibl#DC2" /><gams:textualContent>Non sérieusement arrête tu fais pitié tu t'abaisse bas la sérieux ..</gams:textualContent><rel:isPartOf rdf:resource="https://gams.uni-graz.at/o:aaif.fraweb" /></aaif:Entry><aaif:Phrase rdf:about="https://gams.uni-graz.at/o:aaif.fraweb#En5Ph1"><aaif:verb rdf:resource="https://gams.uni-graz.at/o:aaif.fraweb#En5Ph1Ve1" /><aaif:adverb rdf:resource="https://gams.uni-graz.at/o:aaif.fraweb#En5Ph1Ad1" /><aaif:text>tu t'abaisse bas la sérieux</aaif:text><aaif:annoText>tu [v|t'abaisse|abaisser|rs] [a|bas|bas|auvnmnnn] la sérieux</aaif:annoText></aaif:Phrase><aaif:Verb rdf:about="https://gams.uni-graz.at/o:aaif.fraweb#En5Ph1Ve1"><aaif:text>t'abaisse</aaif:text><aaif:lemma rdf:resource="https://gams.uni-graz.at/o:aaif.lemma#abaisser" /><aaif:position rdf:datatype="http://www.w3.org/2001/XMLSchema#int">1</aaif:position><aaif:coordinated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:coordinated><aaif:partOfText rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</aaif:partOfText><aaif:syntacticConstruction rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Reflexive" /></aaif:Verb><aaif:Adverb rdf:about="https://gams.uni-graz.at/o:aaif.fraweb#En5Ph1Ad1"><aaif:text>bas</aaif:text><aaif:lemma rdf:resource="https://gams.uni-graz.at/o:aaif.lemma#bas" /><aaif:position rdf:datatype="http://www.w3.org/2001/XMLSchema#int">2</aaif:position><aaif:coordinated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:coordinated><aaif:morphosyntacticStructure rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Adjective" /><aaif:inflection rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Uninflected" /><aaif:attributionTarget rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Verb" /><aaif:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:modified><aaif:semanticClassification rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Manner" /><aaif:reduplicated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:reduplicated><aaif:prepositionalPhrase rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:prepositionalPhrase></aaif:Adverb><aaif:Entry rdf:about="https://gams.uni-graz.at/o:aaif.fraweb#En6"><aaif:phrase rdf:resource="https://gams.uni-graz.at/o:aaif.fraweb#En6Ph1" /><aaif:source rdf:resource="https://gams.uni-graz.at/o:aaif.fraweb.bibl#DC3" /><gams:textualContent>Une table articulée, qui monte et descend, position fauteuil etc.Une vraie révolution qui permettra à bon nombre de personnes en situation de handicap de pouvoir enfin être auscultées chez leur médecin; de pouvoir s'installer comme il faut vu que la table s'abaisse bas  et minimisant les manipulations grâce aux diverses articulations.</gams:textualContent><rel:isPartOf rdf:resource="https://gams.uni-graz.at/o:aaif.fraweb" /></aaif:Entry><aaif:Phrase rdf:about="https://gams.uni-graz.at/o:aaif.fraweb#En6Ph1"><aaif:verb rdf:resource="https://gams.uni-graz.at/o:aaif.fraweb#En6Ph1Ve1" /><aaif:adverb rdf:resource="https://gams.uni-graz.at/o:aaif.fraweb#En6Ph1Ad1" /><aaif:text>la table s'abaisse bas </aaif:text><aaif:annoText>la table [v|s'abaisse|abaisser|rs] [a|bas|bas|auvnlnnn] </aaif:annoText></aaif:Phrase><aaif:Verb rdf:about="https://gams.uni-graz.at/o:aaif.fraweb#En6Ph1Ve1"><aaif:text>s'abaisse</aaif:text><aaif:lemma rdf:resource="https://gams.uni-graz.at/o:aaif.lemma#abaisser" /><aaif:position rdf:datatype="http://www.w3.org/2001/XMLSchema#int">1</aaif:position><aaif:coordinated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:coordinated><aaif:partOfText rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</aaif:partOfText><aaif:syntacticConstruction rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Reflexive" /></aaif:Verb><aaif:Adverb rdf:about="https://gams.uni-graz.at/o:aaif.fraweb#En6Ph1Ad1"><aaif:text>bas</aaif:text><aaif:lemma rdf:resource="https://gams.uni-graz.at/o:aaif.lemma#bas" /><aaif:position rdf:datatype="http://www.w3.org/2001/XMLSchema#int">2</aaif:position><aaif:coordinated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:coordinated><aaif:morphosyntacticStructure rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Adjective" /><aaif:inflection rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Uninflected" /><aaif:attributionTarget rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Verb" /><aaif:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:modified><aaif:semanticClassification rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Location" /><aaif:reduplicated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:reduplicated><aaif:prepositionalPhrase rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:prepositionalPhrase></aaif:Adverb><aaif:Entry rdf:about="https://gams.uni-graz.at/o:aaif.fraweb#En7"><aaif:phrase rdf:resource="https://gams.uni-graz.at/o:aaif.fraweb#En7Ph1" /><aaif:source rdf:resource="https://gams.uni-graz.at/o:aaif.fraweb.bibl#DC4" /><gams:textualContent>Tandis que l’on célèbre le Jubilé de la Reine Victoria à coups de feu d’artifices dans les rues de Toronto, Amos Robinson, boxeur ayant refusé au cours d’un match décisif, est abattu mort par balle dans sa chambre d’hôtel.</gams:textualContent><rel:isPartOf rdf:resource="https://gams.uni-graz.at/o:aaif.fraweb" /></aaif:Entry><aaif:Phrase rdf:about="https://gams.uni-graz.at/o:aaif.fraweb#En7Ph1"><aaif:verb rdf:resource="https://gams.uni-graz.at/o:aaif.fraweb#En7Ph1Ve1" /><aaif:adverb rdf:resource="https://gams.uni-graz.at/o:aaif.fraweb#En7Ph1Ad1" /><aaif:text>Amos Robinson, boxeur ayant refusé au cours d’un match décisif, est abattu mort par balle</aaif:text><aaif:annoText>Amos Robinson, boxeur ayant refusé au cours d’un match décisif, [v|est abattu|abattre|ts] [a|mort|mort|ausnmnnn] par balle</aaif:annoText></aaif:Phrase><aaif:Verb rdf:about="https://gams.uni-graz.at/o:aaif.fraweb#En7Ph1Ve1"><aaif:text>est abattu</aaif:text><aaif:lemma rdf:resource="https://gams.uni-graz.at/o:aaif.lemma#abattre" /><aaif:position rdf:datatype="http://www.w3.org/2001/XMLSchema#int">1</aaif:position><aaif:coordinated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:coordinated><aaif:partOfText rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</aaif:partOfText><aaif:syntacticConstruction rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Transitive" /></aaif:Verb><aaif:Adverb rdf:about="https://gams.uni-graz.at/o:aaif.fraweb#En7Ph1Ad1"><aaif:text>mort</aaif:text><aaif:lemma rdf:resource="https://gams.uni-graz.at/o:aaif.lemma#mort" /><aaif:position rdf:datatype="http://www.w3.org/2001/XMLSchema#int">2</aaif:position><aaif:coordinated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:coordinated><aaif:morphosyntacticStructure rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Adjective" /><aaif:inflection rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Uninflected" /><aaif:attributionTarget rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Verb" /><aaif:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:modified><aaif:semanticClassification rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Manner" /><aaif:reduplicated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:reduplicated><aaif:prepositionalPhrase rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:prepositionalPhrase></aaif:Adverb><aaif:Entry rdf:about="https://gams.uni-graz.at/o:aaif.fraweb#En8"><aaif:phrase rdf:resource="https://gams.uni-graz.at/o:aaif.fraweb#En8Ph1" /><aaif:source rdf:resource="https://gams.uni-graz.at/o:aaif.fraweb.bibl#DC5" /><gams:textualContent>Et lorsqu'il la retira, le monstre s'abattit , mort  , tel la Tour de garde Impératrice que les Vartallensis détruisirent lors de la Bataille des Chemins de givre.</gams:textualContent><rel:isPartOf rdf:resource="https://gams.uni-graz.at/o:aaif.fraweb" /></aaif:Entry><aaif:Phrase rdf:about="https://gams.uni-graz.at/o:aaif.fraweb#En8Ph1"><aaif:verb rdf:resource="https://gams.uni-graz.at/o:aaif.fraweb#En8Ph1Ve1" /><aaif:adverb rdf:resource="https://gams.uni-graz.at/o:aaif.fraweb#En8Ph1Ad1" /><aaif:text>le monstre s'abattit , mort </aaif:text><aaif:annoText>le monstre [v|s'abattit|abattre|rs] , [a|mort|mort|ausnmnnn] </aaif:annoText></aaif:Phrase><aaif:Verb rdf:about="https://gams.uni-graz.at/o:aaif.fraweb#En8Ph1Ve1"><aaif:text>s'abattit</aaif:text><aaif:lemma rdf:resource="https://gams.uni-graz.at/o:aaif.lemma#abattre" /><aaif:position rdf:datatype="http://www.w3.org/2001/XMLSchema#int">1</aaif:position><aaif:coordinated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:coordinated><aaif:partOfText rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</aaif:partOfText><aaif:syntacticConstruction rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Reflexive" /></aaif:Verb><aaif:Adverb rdf:about="https://gams.uni-graz.at/o:aaif.fraweb#En8Ph1Ad1"><aaif:text>mort</aaif:text><aaif:lemma rdf:resource="https://gams.uni-graz.at/o:aaif.lemma#mort" /><aaif:position rdf:datatype="http://www.w3.org/2001/XMLSchema#int">2</aaif:position><aaif:coordinated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:coordinated><aaif:morphosyntacticStructure rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Adjective" /><aaif:inflection rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Uninflected" /><aaif:attributionTarget rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Verb" /><aaif:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:modified><aaif:semanticClassification rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Manner" /><aaif:reduplicated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:reduplicated><aaif:prepositionalPhrase rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:prepositionalPhrase></aaif:Adverb><aaif:Entry rdf:about="https://gams.uni-graz.at/o:aaif.fraweb#En9"><aaif:phrase rdf:resource="https://gams.uni-graz.at/o:aaif.fraweb#En9Ph1" /><aaif:source rdf:resource="https://gams.uni-graz.at/o:aaif.fraweb.bibl#DC6" /><gams:textualContent>Le premier réflexe du jeune homme fut de tirer une salve de trois rayons sur sa cible qui s'abattit mort sur le sol.</gams:textualContent><rel:isPartOf rdf:resource="https://gams.uni-graz.at/o:aaif.fraweb" /></aaif:Entry><aaif:Phrase rdf:about="https://gams.uni-graz.at/o:aaif.fraweb#En9Ph1"><aaif:verb rdf:resource="https://gams.uni-graz.at/o:aaif.fraweb#En9Ph1Ve1" /><aaif:adverb rdf:resource="https://gams.uni-graz.at/o:aaif.fraweb#En9Ph1Ad1" /><aaif:text>sur sa cible qui s'abattit mort sur le sol.</aaif:text><aaif:annoText>sur sa cible qui [v|s'abattit|abattre|rs] [a|mort|mort|ausnmnnn] sur le sol.</aaif:annoText></aaif:Phrase><aaif:Verb rdf:about="https://gams.uni-graz.at/o:aaif.fraweb#En9Ph1Ve1"><aaif:text>s'abattit</aaif:text><aaif:lemma rdf:resource="https://gams.uni-graz.at/o:aaif.lemma#abattre" /><aaif:position rdf:datatype="http://www.w3.org/2001/XMLSchema#int">1</aaif:position><aaif:coordinated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:coordinated><aaif:partOfText rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</aaif:partOfText><aaif:syntacticConstruction rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Reflexive" /></aaif:Verb><aaif:Adverb rdf:about="https://gams.uni-graz.at/o:aaif.fraweb#En9Ph1Ad1"><aaif:text>mort</aaif:text><aaif:lemma rdf:resource="https://gams.uni-graz.at/o:aaif.lemma#mort" /><aaif:position rdf:datatype="http://www.w3.org/2001/XMLSchema#int">2</aaif:position><aaif:coordinated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:coordinated><aaif:morphosyntacticStructure rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Adjective" /><aaif:inflection rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Uninflected" /><aaif:attributionTarget rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Verb" /><aaif:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:modified><aaif:semanticClassification rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Manner" /><aaif:reduplicated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:reduplicated><aaif:prepositionalPhrase rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:prepositionalPhrase></aaif:Adverb><aaif:Entry rdf:about="https://gams.uni-graz.at/o:aaif.fraweb#En10"><aaif:phrase rdf:resource="https://gams.uni-graz.at/o:aaif.fraweb#En10Ph1" /><aaif:source rdf:resource="https://gams.uni-graz.at/o:aaif.fraweb.bibl#DC7" /><gams:textualContent>Sans réponses tu m'as laissée abattue morte dans mon être</gams:textualContent><rel:isPartOf rdf:resource="https://gams.uni-graz.at/o:aaif.fraweb" /></aaif:Entry><aaif:Phrase rdf:about="https://gams.uni-graz.at/o:aaif.fraweb#En10Ph1"><aaif:verb rdf:resource="https://gams.uni-graz.at/o:aaif.fraweb#En10Ph1Ve1" /><aaif:adverb rdf:resource="https://gams.uni-graz.at/o:aaif.fraweb#En10Ph1Ad1" /><aaif:text>tu m'as laissée abattue morte dans mon être</aaif:text><aaif:annoText>tu m'as laissée [v|abattue|abattre|ts] [a|morte|mort|aaonmnnn] dans mon être</aaif:annoText></aaif:Phrase><aaif:Verb rdf:about="https://gams.uni-graz.at/o:aaif.fraweb#En10Ph1Ve1"><aaif:text>abattue</aaif:text><aaif:lemma rdf:resource="https://gams.uni-graz.at/o:aaif.lemma#abattre" /><aaif:position rdf:datatype="http://www.w3.org/2001/XMLSchema#int">1</aaif:position><aaif:coordinated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:coordinated><aaif:partOfText rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</aaif:partOfText><aaif:syntacticConstruction rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Transitive" /></aaif:Verb><aaif:Adverb rdf:about="https://gams.uni-graz.at/o:aaif.fraweb#En10Ph1Ad1"><aaif:text>morte</aaif:text><aaif:lemma rdf:resource="https://gams.uni-graz.at/o:aaif.lemma#mort" /><aaif:position rdf:datatype="http://www.w3.org/2001/XMLSchema#int">2</aaif:position><aaif:coordinated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:coordinated><aaif:morphosyntacticStructure rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Adjective" /><aaif:inflection rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#AudibleInflection" /><aaif:attributionTarget rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#VerbObject" /><aaif:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#bool