ms.uni-graz.at/o:aaif.itaaaif" /></aaif:Entry><aaif:Phrase rdf:about="https://gams.uni-graz.at/o:aaif.itaaaif#En23Ph1"><aaif:verb rdf:resource="https://gams.uni-graz.at/o:aaif.itaaaif#En23Ph1Ve1" /><aaif:adverb rdf:resource="https://gams.uni-graz.at/o:aaif.itaaaif#En23Ph1Ad1" /><aaif:text> Va  bonu </aaif:text><aaif:annoText> [v|Va|andare|is]  [a|bonu|buono|auvnmnnn] </aaif:annoText></aaif:Phrase><aaif:Verb rdf:about="https://gams.uni-graz.at/o:aaif.itaaaif#En23Ph1Ve1"><aaif:text>Va</aaif:text><aaif:lemma rdf:resource="https://gams.uni-graz.at/o:aaif.lemma#andare" /><aaif:position rdf:datatype="http://www.w3.org/2001/XMLSchema#int">1</aaif:position><aaif:coordinated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:coordinated><aaif:partOfText rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</aaif:partOfText><aaif:syntacticConstruction rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Intransitive" /></aaif:Verb><aaif:Adverb rdf:about="https://gams.uni-graz.at/o:aaif.itaaaif#En23Ph1Ad1"><aaif:text>bonu</aaif:text><aaif:lemma rdf:resource="https://gams.uni-graz.at/o:aaif.lemma#buono" /><aaif:position rdf:datatype="http://www.w3.org/2001/XMLSchema#int">2</aaif:position><aaif:coordinated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:coordinated><aaif:morphosyntacticStructure rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Adjective" /><aaif:inflection rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Uninflected" /><aaif:attributionTarget rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Verb" /><aaif:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:modified><aaif:semanticClassification rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Manner" /><aaif:reduplicated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:reduplicated><aaif:prepositionalPhrase rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:prepositionalPhrase></aaif:Adverb><aaif:Entry rdf:about="https://gams.uni-graz.at/o:aaif.itaaaif#En24"><aaif:phrase rdf:resource="https://gams.uni-graz.at/o:aaif.itaaaif#En24Ph1" /><aaif:source rdf:resource="https://gams.uni-graz.at/o:aaif.itaaaif.bibl#Cal1" /><gams:textualContent>vi vannu boni </gams:textualContent><rel:isPartOf rdf:resource="https://gams.uni-graz.at/o:aaif.itaaaif" /></aaif:Entry><aaif:Phrase rdf:about="https://gams.uni-graz.at/o:aaif.itaaaif#En24Ph1"><aaif:verb rdf:resource="https://gams.uni-graz.at/o:aaif.itaaaif#En24Ph1Ve1" /><aaif:adverb rdf:resource="https://gams.uni-graz.at/o:aaif.itaaaif#En24Ph1Ad1" /><aaif:text>vi vannu boni </aaif:text><aaif:annoText>vi [v|vannu|andare|is] [a|boni|buono|apvnmnnn] </aaif:annoText></aaif:Phrase><aaif:Verb rdf:about="https://gams.uni-graz.at/o:aaif.itaaaif#En24Ph1Ve1"><aaif:text>vannu</aaif:text><aaif:lemma rdf:resource="https://gams.uni-graz.at/o:aaif.lemma#andare" /><aaif:position rdf:datatype="http://www.w3.org/2001/XMLSchema#int">1</aaif:position><aaif:coordinated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:coordinated><aaif:partOfText rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</aaif:partOfText><aaif:syntacticConstruction rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Intransitive" /></aaif:Verb><aaif:Adverb rdf:about="https://gams.uni-graz.at/o:aaif.itaaaif#En24Ph1Ad1"><aaif:text>boni</aaif:text><aaif:lemma rdf:resource="https://gams.uni-graz.at/o:aaif.lemma#buono" /><aaif:position rdf:datatype="http://www.w3.org/2001/XMLSchema#int">2</aaif:position><aaif:coordinated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:coordinated><aaif:morphosyntacticStructure rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Adjective" /><aaif:inflection rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#MasculinePlural" /><aaif:attributionTarget rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Verb" /><aaif:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:modified><aaif:semanticClassification rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Manner" /><aaif:reduplicated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:reduplicated><aaif:prepositionalPhrase rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:prepositionalPhrase></aaif:Adverb><aaif:Entry rdf:about="https://gams.uni-graz.at/o:aaif.itaaaif#En25"><aaif:phrase rdf:resource="https://gams.uni-graz.at/o:aaif.itaaaif#En25Ph1" /><aaif:source rdf:resource="https://gams.uni-graz.at/o:aaif.itaaaif.bibl#Cal7" /><gams:textualContent>(Tutti tacciono per prestare attenzione. Hanno i bicchieri in mano. M.N. si alza, solleva il bicchiere, si raccoglie in sè un momento e poi) Pimmu fannu chistu vinu / bellu villutatu e finu eppiri a îri a scola / brindisi fazzu a Rita e a Cola.</gams:textualContent><rel:isPartOf rdf:resource="https://gams.uni-graz.at/o:aaif.itaaaif" /></aaif:Entry><aaif:Phrase rdf:about="https://gams.uni-graz.at/o:aaif.itaaaif#En25Ph1"><aaif:adverb rdf:resource="https://gams.uni-graz.at/o:aaif.itaaaif#En25Ph1Ad1" /><aaif:text>chistu vinu \/ bellu villutatu e finu</aaif:text><aaif:annoText>chistu vinu \/ [a|bellu|bello|auanqnnn] villutatu e finu</aaif:annoText></aaif:Phrase><aaif:Adverb rdf:about="https://gams.uni-graz.at/o:aaif.itaaaif#En25Ph1Ad1"><aaif:text>bellu</aaif:text><aaif:lemma rdf:resource="https://gams.uni-graz.at/o:aaif.lemma#bello" /><aaif:position rdf:datatype="http://www.w3.org/2001/XMLSchema#int">1</aaif:position><aaif:coordinated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:coordinated><aaif:morphosyntacticStructure rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Adjective" /><aaif:inflection rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Uninflected" /><aaif:attributionTarget rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Adjective" /><aaif:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:modified><aaif:semanticClassification rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Quantity" /><aaif:reduplicated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:reduplicated><aaif:prepositionalPhrase rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:prepositionalPhrase></aaif:Adverb><aaif:Entry rdf:about="https://gams.uni-graz.at/o:aaif.itaaaif#En26"><aaif:phrase rdf:resource="https://gams.uni-graz.at/o:aaif.itaaaif#En26Ph1" /><aaif:source rdf:resource="https://gams.uni-graz.at/o:aaif.itaaaif.bibl#Cal7" /><gams:textualContent>Io vi viu bonu  </gams:textualContent><rel:isPartOf rdf:resource="https://gams.uni-graz.at/o:aaif.itaaaif" /></aaif:Entry><aaif:Phrase rdf:about="https://gams.uni-graz.at/o:aaif.itaaaif#En26Ph1"><aaif:verb rdf:resource="https://gams.uni-graz.at/o:aaif.itaaaif#En26Ph1Ve1" /><aaif:adverb rdf:resource="https://gams.uni-graz.at/o:aaif.itaaaif#En26Ph1Ad1" /><aaif:text>Io vi viu bonu </aaif:text><aaif:annoText>'Io la vedo bene'Io vi [v|viu|vedere|ts] [a|bonu|buono|auvnmnnn] </aaif:annoText></aaif:Phrase><aaif:Verb rdf:about="https://gams.uni-graz.at/o:aaif.itaaaif#En26Ph1Ve1"><aaif:text>viu</aaif:text><aaif:lemma rdf:resource="https://gams.uni-graz.at/o:aaif.lemma#vedere" /><aaif:position rdf:datatype="http://www.w3.org/2001/XMLSchema#int">1</aaif:position><aaif:coordinated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:coordinated><aaif:partOfText rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</aaif:partOfText><aaif:syntacticConstruction rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Transitive" /></aaif:Verb><aaif:Adverb rdf:about="https://gams.uni-graz.at/o:aaif.itaaaif#En26Ph1Ad1"><aaif:text>bonu</aaif:text><aaif:lemma rdf:resource="https://gams.uni-graz.at/o:aaif.lemma#buono" /><aaif:position rdf:datatype="http://www.w3.org/2001/XMLSchema#int">2</aaif:position><aaif:coordinated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:coordinated><aaif:morphosyntacticStructure rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Adjective" /><aaif:inflection rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Uninflected" /><aaif:attributionTarget rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Verb" /><aaif:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:modified><aaif:semanticClassification rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Manner" /><aaif:reduplicated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:reduplicated><aaif:prepositionalPhrase rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:prepositionalPhrase></aaif:Adverb><aaif:Entry rdf:about="https://gams.uni-graz.at/o:aaif.itaaaif#En27"><aaif:phrase rdf:resource="https://gams.uni-graz.at/o:aaif.itaaaif#En27Ph1" /><aaif:source rdf:resource="https://gams.uni-graz.at/o:aaif.itaaaif.bibl#Cal7" /><gams:textualContent>(Per tagliar corto) Ndi canuscimu vecchî ; vi sacciu chi pirareji siti! Va! Mbiscamula ca è megghju.</gams:textualContent><rel:isPartOf rdf:resource="https://gams.uni-graz.at/o:aaif.itaaaif" /></aaif:Entry><aaif:Phrase rdf:about="https://gams.uni-graz.at/o:aaif.itaaaif#En27Ph1"><aaif:verb rdf:resource="https://gams.uni-graz.at/o:aaif.itaaaif#En27Ph1Ve1" /><aaif:adverb rdf:resource="https://gams.uni-graz.at/o:aaif.itaaaif#En27Ph1Ad1" /><aaif:text>Ndi canuscimu vecchî </aaif:text><aaif:annoText>'Ci conosciamo bene, so che tipi siete.'Ndi [v|canuscimu|conoscere|ts] [a|vecchî|vecchio|apvmnn] </aaif:annoText></aaif:Phrase><aaif:Verb rdf:about="https://gams.uni-graz.at/o:aaif.itaaaif#En27Ph1Ve1"><aaif:text>canuscimu</aaif:text><aaif:lemma rdf:resource="https://gams.uni-graz.at/o:aaif.lemma#conoscere" /><aaif:position rdf:datatype="http://www.w3.org/2001/XMLSchema#int">1</aaif:position><aaif:coordinated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:coordinated><aaif:partOfText rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</aaif:partOfText><aaif:syntacticConstruction rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Transitive" /></aaif:Verb><aaif:Adverb rdf:about="https://gams.uni-graz.at/o:aaif.itaaaif#En27Ph1Ad1"><aaif:text>vecchî</aaif:text><aaif:lemma rdf:resource="https://gams.uni-graz.at/o:aaif.lemma#vecchio" /><aaif:position rdf:datatype="http://www.w3.org/2001/XMLSchema#int">2</aaif:position><aaif:coordinated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:coordinated><aaif:morphosyntacticStructure rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Adjective" /><aaif:inflection rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#MasculinePlural" /><aaif:attributionTarget rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Verb" /><aaif:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</aaif:modified><aaif:reduplicated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:reduplicated><aaif:prepositionalPhrase rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:prepositionalPhrase></aaif:Adverb><aaif:Entry rdf:about="https://gams.uni-graz.at/o:aaif.itaaaif#En28"><aaif:phrase rdf:resource="https://gams.uni-graz.at/o:aaif.itaaaif#En28Ph1" /><aaif:source rdf:resource="https://gams.uni-graz.at/o:aaif.itaaaif.bibl#Cal7" /><gams:textualContent>―TERESA: E ca picchì? Ca megghju 'i tia cu' staci? ―COLA: M’a passu bona , comu no, però cu n'autru misteri potarria guadagnari 'i cchjù.</gams:textualContent><rel:isPartOf rdf:resource="https://gams.uni-graz.at/o:aaif.itaaaif" /></aaif:Entry><aaif:Phrase rdf:about="https://gams.uni-graz.at/o:aaif.itaaaif#En28Ph1"><aaif:verb rdf:resource="https://gams.uni-graz.at/o:aaif.itaaaif#En28Ph1Ve1" /><aaif:adverb rdf:resource="https://gams.uni-graz.at/o:aaif.itaaaif#En28Ph1Ad1" /><aaif:text>M’a passu bona </aaif:text><aaif:annoText>' Sto bene si, però con un altro lavoro…'M’a [v|passu|passare|tsn] [a|bona|buono|afsnmnnn] </aaif:annoText></aaif:Phrase><aaif:Verb rdf:about="https://gams.uni-graz.at/o:aaif.itaaaif#En28Ph1Ve1"><aaif:text>passu</aaif:text><aaif:lemma rdf:resource="https://gams.uni-graz.at/o:aaif.lemma#passare" /><aaif:position rdf:datatype="http://www.w3.org/2001/XMLSchema#int">1</aaif:position><aaif:coordinated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:coordinated><aaif:partOfText rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</aaif:partOfText><aaif:syntacticConstruction rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Transitive" /></aaif:Verb><aaif:Adverb rdf:about="https://gams.uni-graz.at/o:aaif.itaaaif#En28Ph1Ad1"><aaif:text>bona</aaif:text><aaif:lemma rdf:resource="https://gams.uni-graz.at/o:aaif.lemma#buono" /><aaif:position rdf:datatype="http://www.w3.org/2001/XMLSchema#int">2</aaif:position><aaif:coordinated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:coordinated><aaif:morphosyntacticStructure rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Adjective" /><aaif:inflection rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#FeminineSingular" /><aaif:attributionTarget rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Verb" /><aaif:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:modified><aaif:semanticClassification rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Manner" /><aaif:reduplicated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:reduplicated><aaif:prepositionalPhrase rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:prepositionalPhrase></aaif:Adverb><aaif:Entry rdf:about="https://gams.uni-graz.at/o:aaif.itaaaif#En29"><aaif:phrase rdf:resource="https://gams.uni-graz.at/o:aaif.itaaaif#En29Ph1" /><aaif:source rdf:resource="https://gams.uni-graz.at/o:aaif.itaaaif.bibl#Cal7" /><gams:textualContent> facistivu  bonu mu nc’i cantati</gams:textualContent><rel:isPartOf rdf:resource="https://gams.uni-graz.at/o:aaif.itaaaif" /></aaif:Entry><aaif:Phrase rdf:about="https://gams.uni-graz.at/o:aaif.itaaaif#En29Ph1"><aaif:verb rdf:resource="https://gams.uni-graz.at/o:aaif.itaaaif#En29Ph1Ve1" /><aaif:adverb rdf:resource="https://gams.uni-graz.at/o:aaif.itaaaif#En29Ph1Ad1" /><aaif:text> facistivu  bonu mu nc’i cantati</aaif:text><aaif:annoText> [v|facistivu|fare|ts]  [a|bonu|buono|auvnmnnn] mu nc’i cantati</aaif:annoText></aaif:Phrase><aaif:Verb rdf:about="https://gams.uni-graz.at/o:aaif.itaaaif#En29Ph1Ve1"><aaif:text>facistivu</aaif:text><aaif:lemma rdf:resource="https://gams.uni-graz.at/o:aaif.lemma#fare" /><aaif:position rdf:datatype="http://www.w3.org/2001/XMLSchema#int">1</aaif:position><aaif:coordinated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:coordinated><aaif:partOfText rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</aaif:partOfText><aaif:syntacticConstruction rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Transitive" /></aaif:Verb><aaif:Adverb rdf:about="https://gams.uni-graz.at/o:aaif.itaaaif#En29Ph1Ad1"><aaif:text>bonu</aaif:text><aaif:lemma rdf:resource="https://gams.uni-graz.at/o:aaif.lemma#buono" /><aaif:position rdf:datatype="http://www.w3.org/2001/XMLSchema#int">2</aaif:position><aaif:coordinated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:coordinated><aaif:morphosyntacticStructure rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Adjective" /><aaif:inflection rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Uninflected" /><aaif:attributionTarget rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Verb" /><aaif:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:modified><aaif:semanticClassification rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Manner" /><aaif:reduplicated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:reduplicated><aaif:prepositionalPhrase rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:prepositionalPhrase></aaif:Adverb><aaif:Entry rdf:about="http