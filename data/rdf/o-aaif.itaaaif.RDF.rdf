ww.w3.org/2001/XMLSchema#boolean">false</aaif:reduplicated><aaif:prepositionalPhrase rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:prepositionalPhrase></aaif:Adverb><aaif:Entry rdf:about="https://gams.uni-graz.at/o:aaif.itaaaif#En250"><aaif:phrase rdf:resource="https://gams.uni-graz.at/o:aaif.itaaaif#En250Ph1" /><aaif:source rdf:resource="https://gams.uni-graz.at/o:aaif.itaaaif.bibl#Nap8" /><gams:textualContent>si po li buò fà de sceroppata, nce miette l'amarene, o la percocata, li chiudi buoni , e li friarraje.</gams:textualContent><rel:isPartOf rdf:resource="https://gams.uni-graz.at/o:aaif.itaaaif" /></aaif:Entry><aaif:Phrase rdf:about="https://gams.uni-graz.at/o:aaif.itaaaif#En250Ph1"><aaif:verb rdf:resource="https://gams.uni-graz.at/o:aaif.itaaaif#En250Ph1Ve1" /><aaif:adverb rdf:resource="https://gams.uni-graz.at/o:aaif.itaaaif#En250Ph1Ad1" /><aaif:text>li chiudi buoni </aaif:text><aaif:annoText>li [v|chiudi|chiudere|ts] [a|buoni|buono|aponmnnn] </aaif:annoText></aaif:Phrase><aaif:Verb rdf:about="https://gams.uni-graz.at/o:aaif.itaaaif#En250Ph1Ve1"><aaif:text>chiudi</aaif:text><aaif:lemma rdf:resource="https://gams.uni-graz.at/o:aaif.lemma#chiudere" /><aaif:position rdf:datatype="http://www.w3.org/2001/XMLSchema#int">1</aaif:position><aaif:coordinated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:coordinated><aaif:partOfText rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</aaif:partOfText><aaif:syntacticConstruction rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Transitive" /></aaif:Verb><aaif:Adverb rdf:about="https://gams.uni-graz.at/o:aaif.itaaaif#En250Ph1Ad1"><aaif:text>buoni</aaif:text><aaif:lemma rdf:resource="https://gams.uni-graz.at/o:aaif.lemma#buono" /><aaif:position rdf:datatype="http://www.w3.org/2001/XMLSchema#int">2</aaif:position><aaif:coordinated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:coordinated><aaif:morphosyntacticStructure rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Adjective" /><aaif:inflection rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#MasculinePlural" /><aaif:attributionTarget rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#VerbObject" /><aaif:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:modified><aaif:semanticClassification rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Manner" /><aaif:reduplicated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:reduplicated><aaif:prepositionalPhrase rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:prepositionalPhrase></aaif:Adverb><aaif:Entry rdf:about="https://gams.uni-graz.at/o:aaif.itaaaif#En251"><aaif:phrase rdf:resource="https://gams.uni-graz.at/o:aaif.itaaaif#En251Ph1" /><aaif:source rdf:resource="https://gams.uni-graz.at/o:aaif.itaaaif.bibl#Nap8" /><gams:textualContent>mperò de caso, e ova, mozzarelle, e presutto, nce miette l'auta pettola, la chiude bona attuorno, e ncoppa a essa nce farraje pure na sodognuta de nzogna, e la farraje cocere a lo furno, o co lo tiesto.</gams:textualContent><rel:isPartOf rdf:resource="https://gams.uni-graz.at/o:aaif.itaaaif" /></aaif:Entry><aaif:Phrase rdf:about="https://gams.uni-graz.at/o:aaif.itaaaif#En251Ph1"><aaif:verb rdf:resource="https://gams.uni-graz.at/o:aaif.itaaaif#En251Ph1Ve1" /><aaif:adverb rdf:resource="https://gams.uni-graz.at/o:aaif.itaaaif#En251Ph1Ad1" /><aaif:text>la chiude bona attuorno</aaif:text><aaif:annoText>la [v|chiude|chiudere|ts] [a|bona|buono|afonmnnn] attuorno</aaif:annoText></aaif:Phrase><aaif:Verb rdf:about="https://gams.uni-graz.at/o:aaif.itaaaif#En251Ph1Ve1"><aaif:text>chiude</aaif:text><aaif:lemma rdf:resource="https://gams.uni-graz.at/o:aaif.lemma#chiudere" /><aaif:position rdf:datatype="http://www.w3.org/2001/XMLSchema#int">1</aaif:position><aaif:coordinated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:coordinated><aaif:partOfText rdf:datatype="http://www.w3.org/2001/XM