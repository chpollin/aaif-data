Phrase rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:prepositionalPhrase></aaif:Adverb><aaif:Entry rdf:about="https://gams.uni-graz.at/o:aaif.itaaaif#En148"><aaif:phrase rdf:resource="https://gams.uni-graz.at/o:aaif.itaaaif#En148Ph1" /><aaif:source rdf:resource="https://gams.uni-graz.at/o:aaif.itaaaif.bibl#Nap2" /><gams:textualContent>non moveva chianta de pede, che non carcasse bone le spalle a chi pendeva da la corda de le speranze</gams:textualContent><rel:isPartOf rdf:resource="https://gams.uni-graz.at/o:aaif.itaaaif" /></aaif:Entry><aaif:Phrase rdf:about="https://gams.uni-graz.at/o:aaif.itaaaif#En148Ph1"><aaif:verb rdf:resource="https://gams.uni-graz.at/o:aaif.itaaaif#En148Ph1Ve1" /><aaif:adverb rdf:resource="https://gams.uni-graz.at/o:aaif.itaaaif#En148Ph1Ad1" /><aaif:text>che non carcasse bone le spalle a chi pendeva da la corda de le speranze</aaif:text><aaif:annoText>che non [v|carcasse|calcare|ts] [a|bone|buono|axonmnnn] le spalle a chi pendeva da la corda de le speranze</aaif:annoText></aaif:Phrase><aaif:Verb rdf:about="https://gams.uni-graz.at/o:aaif.itaaaif#En148Ph1Ve1"><aaif:text>carcasse</aaif:text><aaif:lemma rdf:resource="https://gams.uni-graz.at/o:aaif.lemma#calcare" /><aaif:position rdf:datatype="http://www.w3.org/2001/XMLSchema#int">1</aaif:position><aaif:coordinated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:coordinated><aaif:partOfText rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</aaif:partOfText><aaif:syntacticConstruction rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Transitive" /></aaif:Verb><aaif:Adverb rdf:about="https://gams.uni-graz.at/o:aaif.itaaaif#En148Ph1Ad1"><aaif:text>bone</aaif:text><aaif:lemma rdf:resource="https://gams.uni-graz.at/o:aaif.lemma#buono" /><aaif:position rdf:datatype="http://www.w3.org/2001/XMLSchema#int">2</aaif:position><aaif:coordinated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:coordinated><aaif:morphosyntacticStruct