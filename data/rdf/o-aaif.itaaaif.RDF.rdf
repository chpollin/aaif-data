.at/o:aaif.ontology#Verb" /><aaif:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:modified><aaif:semanticClassification rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Manner" /><aaif:reduplicated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:reduplicated><aaif:prepositionalPhrase rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:prepositionalPhrase></aaif:Adverb><aaif:Entry rdf:about="https://gams.uni-graz.at/o:aaif.itaaaif#En222"><aaif:phrase rdf:resource="https://gams.uni-graz.at/o:aaif.itaaaif#En222Ph1" /><aaif:source rdf:resource="https://gams.uni-graz.at/o:aaif.itaaaif.bibl#Nap8" /><gams:textualContent>le menieste facennoli scolà buoni </gams:textualContent><rel:isPartOf rdf:resource="https://gams.uni-graz.at/o:aaif.itaaaif" /></aaif:Entry><aaif:Phrase rdf:about="https://gams.uni-graz.at/o:aaif.itaaaif#En222Ph1"><aaif:verb rdf:resource="https://gams.uni-graz.at/o:aaif.itaaaif#En222Ph1Ve1" /><aaif:adverb rdf:resource="https://gams.uni-graz.at/o:aaif.itaaaif#En222Ph1Ad1" /><aaif:text>le menieste facennoli scolà buoni </aaif:text><aaif:annoText>le menieste facennoli [v|scolà|scolare|ts] [a|buoni|buono|aponmnnn] </aaif:annoText></aaif:Phrase><aaif:Verb rdf:about="https://gams.uni-graz.at/o:aaif.itaaaif#En222Ph1Ve1"><aaif:text>scolà</aaif:text><aaif:lemma rdf:resource="https://gams.uni-graz.at/o:aaif.lemma#scolare" /><aaif:position rdf:datatype="http://www.w3.org/2001/XMLSchema#int">1</aaif:position><aaif:coordinated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:coordinated><aaif:partOfText rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</aaif:partOfText><aaif:syntacticConstruction rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Transitive" /></aaif:Verb><aaif:Adverb rdf:about="https://gams.uni-graz.at/o:aaif.itaaaif#En222Ph1Ad1"><aaif:text>buoni</aaif:text><aaif:lemma rdf:resource="https://gams.uni-graz.at/o:aaif.lemma#buono" /><aaif:position rdf:datatype="http://www.w3.org/2001/XMLSchema#int">2</aaif:position><aaif:coordinated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:coordinated><aaif:morphosyntacticStructure rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Adjective" /><aaif:inflection rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#MasculinePlural" /><aaif:attributionTarget rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#VerbObject" /><aaif:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:modified><aaif:semanticClassification rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Manner" /><aaif:reduplicated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:reduplicated><aaif:prepositionalPhrase rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:prepositionalPhrase></aaif:Adverb><aaif:Entry rdf:about="https://gams.uni-graz.at/o:aaif.itaaaif#En223"><aaif:phrase rdf:resource="https://gams.uni-graz.at/o:aaif.itaaaif#En223Ph1" /><aaif:source rdf:resource="https://gams.uni-graz.at/o:aaif.itaaaif.bibl#Nap8" /><gams:textualContent>mbrogliannoli de caso viecchio, e provola, e quant'aute sciorte de caso so, chiù beneno buoni  lli miette a filaro a filaro, o dint'a na zoppiera</gams:textualContent><rel:isPartOf rdf:resource="https://gams.uni-graz.at/o:aaif.itaaaif" /></aaif:Entry><aaif:Phrase rdf:about="https://gams.uni-graz.at/o:aaif.itaaaif#En223Ph1"><aaif:verb rdf:resource="https://gams.uni-graz.at/o:aaif.itaaaif#En223Ph1Ve1" /><aaif:adverb rdf:resource="https://gams.uni-graz.at/o:aaif.itaaaif#En223Ph1Ad1" /><aaif:text>chiù beneno buoni </aaif:text><aaif:annoText>chiù [v|beneno|venire|is] [a|buoni|buono|apsnmnnn] </aaif:annoText></aaif:Phrase><aaif:Verb rdf:about="https://gams.uni-graz.at/o:aaif.itaaaif#En223Ph1Ve1"><aaif:text>beneno</aaif:text><aaif:lemma rdf:resource="https://gams.uni-graz.at/o:aaif.lemma#venire" /><aaif:position rdf:datatype="http://www.w3.org/2001/XMLSchema#int">1</aaif:position><aaif:coordinated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:coordinated><aaif:partOfText rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</aaif:partOfText><aaif:syntacticConstruction rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Intransitive" /></aaif:Verb><aaif:Adverb rdf:about="https://gams.uni-graz.at/o:aaif.itaaaif#En223Ph1Ad1"><aaif:text>buoni</aaif:text><aaif:lemma rdf:resource="https://gams.uni-graz.at/o:aaif.lemma#buono" /><aaif:position rdf:datatype="http://www.w3.org/2001/XMLSchema#int">2</aaif:position><aaif:coordinated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:coordinated><aaif:morphosyntacticStructure rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Adjective" /><aaif:inflection rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#MasculinePlural" /><aaif:attributionTarget rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Verb" /><aaif:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:modified><aaif:semanticClassification rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Manner" /><aaif:reduplicated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:reduplicated><aaif:prepositionalPhrase rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:prepositionalPhrase></aaif:Adverb><aaif:Entry rdf:about="https://gams.uni-graz.at/o:aaif.itaaaif#En224"><aaif:phrase rdf:resource="https://gams.uni-graz.at/o:aaif.itaaaif#En224Ph1" /><aaif:source rdf:resource="https://gams.uni-graz.at/o:aaif.itaaaif.bibl#Nap8" /><gams:textualContent>lli miette a filaro a filaro, o dint'a na zoppiera, o a no vacile co lo brodo russo de lo stufato, e si po Ie miette ncoppa a la cenisa a stufà se faranno belli russe russe</gams:textualContent><rel:isPartOf rdf:resource="https://gams.uni-graz.at/o:aaif.itaaaif" /></aaif:Entry><aaif:Phrase rdf:about="https://gams.uni-graz.at/o:aaif.itaaaif#En224Ph1"><aaif:adverb rdf:resource="https://gams.uni-graz.at/o:aaif.itaaaif#En224Ph1Ad1" /><aaif:text>se faranno belli russe russe</aaif:text><aaif:annoText>se faranno [a|belli|bello|apanqnnn] russe russe</aaif:annoText></aaif:Phrase><aaif:Adverb rdf:about="https://gams.uni-graz.at/o:aaif.itaaaif#En224Ph1Ad1"><aaif:text>belli</aaif:text><aaif:lemma rdf:resource="https://gams.uni-graz.at/o:aaif.lemma#bello" /><aaif:position rdf:datatype="http://www.w3.org/2001/XMLSchema#int">1</aaif:position><aaif:coordinated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:coordinated><aaif:morphosyntacticStructure rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Adjective" /><aaif:inflection rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#MasculinePlural" /><aaif:attributionTarget rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Adjective" /><aaif:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:modified><aaif:semanticClassification rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Quantity" /><aaif:reduplicated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:reduplicated><aaif:prepositionalPhrase rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:prepositionalPhrase></aaif:Adverb><aaif:Entry rdf:about="https://gams.uni-graz.at/o:aaif.itaaaif#En225"><aaif:phrase rdf:resource="https://gams.uni-graz.at/o:aaif.itaaaif#En225Ph1" /><aaif:source rdf:resource="https://gams.uni-graz.at/o:aaif.itaaaif.bibl#Nap8" /><gams:textualContent>fuoco mettennoce no terzo de nzogna quanno la sauza s'è stregnuta justa , scaudarraje doje rotola de viermicielli vierdi vierdi, e scolati buoni</gams:textualContent><rel:isPartOf rdf:resource="https://gams.uni-graz.at/o:aaif.itaaaif" /></aaif:Entry><aaif:Phrase rdf:about="https://gams.uni-graz.at/o:aaif.itaaaif#En225Ph1"><aaif:subject rdf:resource="https://gams.uni-graz.at/o:aaif.itaaaif#En225Ph1Su1" /><aaif:verb rdf:resource="https://gams.uni-graz.at/o:aaif.itaaaif#En225Ph1Ve1" /><aaif:adverb rdf:resource="https://gams.uni-graz.at/o:aaif.itaaaif#En225Ph1Ad1" /><aaif:text>quanno la sauza s'è stregnuta justa </aaif:text><aaif:annoText>quanno [s|la sauza|fs] [v|s'è stregnuta|stringere|ts] [a|justa|giusto|afsnmnnn] </aaif:annoText></aaif:Phrase><aaif:Subject rdf:about="https://gams.uni-graz.at/o:aaif.itaaaif#En225Ph1Su1"><aaif:text>la sauza</aaif:text><aaif:position rdf:datatype="http://www.w3.org/2001/XMLSchema#int">1</aaif:position><aaif:gender rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Feminine" /><aaif:number rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Singular" /><aaif:overt rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</aaif:overt></aaif:Subject><aaif:Verb rdf:about="https://gams.uni-graz.at/o:aaif.itaaaif#En225Ph1Ve1"><aaif:text>s'è stregnuta</aaif:text><aaif:lemma rdf:resource="https://gams.uni-graz.at/o:aaif.lemma#stringere" /><aaif:position rdf:datatype="http://www.w3.org/2001/XMLSchema#int">2</aaif:position><aaif:coordinated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:coordinated><aaif:partOfText rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</aaif:partOfText><aaif:syntacticConstruction rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Transitive" /></aaif:Verb><aaif:Adverb rdf:about="https://gams.uni-graz.at/o:aaif.itaaaif#En225Ph1Ad1"><aaif:text>justa</aaif:text><aaif:lemma rdf:resource="https://gams.uni-graz.at/o:aaif.lemma#giusto" /><aaif:position rdf:datatype="http://www.w3.org/2001/XMLSchema#int">3</aaif:position><aaif:coordinated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:coordinated><aaif:morphosyntacticStructure rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Adjective" /><aaif:inflection rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#FeminineSingular" /><aaif:attributionTarget rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Verb" /><aaif:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:modified><aaif:semanticClassification rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Manner" /><aaif:reduplicated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:reduplicated><aaif:prepositionalPhrase rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:prepositionalPhrase></aaif:Adverb><aaif:Entry rdf:about="https://gams.uni-graz.at/o:aaif.itaaaif#En226"><aaif:phrase rdf:resource="https://gams.uni-graz.at/o:aaif.itaaaif#En226Ph1" /><aaif:source rdf:resource="https://gams.uni-graz.at/o:aaif.itaaaif.bibl#Nap8" /><gams:textualContent>Da li frutti ne lieve la scorza, e li tagli a quart’a quart, le cocozzelle li gratte co lo cortiello, e accossi ne Ievarraje la scorza, li spacche ne lieve la semmenta, e le tagliarraje a mostacciolilli acuonc' accuonce : a le torzelle ne lieve tutte le fronne, restannoce lo cemmolillo co lo torzillo</gams:textualContent><rel:isPartOf rdf:resource="https://gams.uni-graz.at/o:aaif.itaaaif" /></aaif:Entry><aaif:Phrase rdf:about="https://gams.uni-graz.at/o:aaif.itaaaif#En226Ph1"><aaif:verb rdf:resource="https://gams.uni-graz.at/o:aaif.itaaaif#En226Ph1Ve1" /><aaif:adverb rdf:resource="https://gams.uni-graz.at/o:aaif.itaaaif#En226Ph1Ad1" /><aaif:text>le tagliarraje a mostacciolilli acuonc' accuonce </aaif:text><aaif:annoText>le [v|tagliarraje|tagliare|ts] a mostacciolilli acuonc' [a|accuonce|acconcio|axonmrnn] </aaif:annoText></aaif:Phrase><aaif:Verb rdf:about="https://gams.uni-graz.at/o:aaif.itaaaif#En226Ph1Ve1"><aaif:text>tagliarraje</aaif:text><aaif:lemma rdf:resource="https://gams.uni-graz.at/o:aaif.lemma#tagliare" /><aaif:position rdf:datatype="http://www.w3.org/2001/XMLSchema#int">1</aaif:position><aaif:coordinated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:coordinated><aaif:partOfText rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</aaif:partOfText><aaif:syntacticConstruction rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Transitive" /></aaif:Verb><aaif:Adverb rdf:about="https://gams.uni-graz.at/o:aaif.itaaaif#En226Ph1Ad1"><aaif:text>accuonce</aaif:text><aaif:lemma rdf:resource="https://gams.uni-graz.at/o:aaif.lemma#acconcio" /><aaif:position rdf:datatype="http://www.w3.org/2001/XMLSchema#int">2</aaif:position><aaif:coordinated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:coordinated><aaif:morphosyntacticStructure rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Adjective" /><aaif:inflection rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#FemininePlural" /><aaif:attributionTarget rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#VerbObject" /><aaif:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:modified><aaif:semanticClassification rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Manner" /><aaif:reduplicated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</aaif:reduplicated><aaif:prepositionalPhrase rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:prepositionalPhrase></aaif:Adverb><aaif:Entry rdf:about="https://gams.uni-graz.at/o:aaif.itaaaif#En227"><aaif:phrase rdf:resource="https://gams.uni-graz.at/o:aaif.itaaaif#En227Ph1" /><aaif:source rdf:resource="https://gams.uni-graz.at/o:aaif.itaaaif.bibl#Nap8" /><gams:textualContent>Si pò la vuò fà dint’a lo brodo de stufato pure vene bona  ma lo brodo mperò ha da essere chiù grasso.</gams:textualContent><rel:isPartOf rdf:resource="https://gams.uni-graz.at/o:aaif.itaaaif" /></aaif:Entry><aaif:Phrase rdf:about="https://gams.uni-graz.at/o:aaif.itaaaif#En227Ph1"><aaif:verb rdf:resource="https://gams.uni-graz.at/o:aaif.itaaaif#En227Ph1Ve1" /><aaif:adverb rdf:resource="https://gams.uni-graz.at/o:aaif.itaaaif#En227Ph1Ad1" /><aaif:text>pure vene bona </aaif:text><aaif:annoText>pure [v|vene|venire|is] [a|bona|buono|afsnmnnn] </aaif:annoText></aaif:Phrase><aaif:Verb rdf:about="https://gams.uni-graz.at/o:aaif.itaaaif#En227Ph1Ve1"><aaif:text>vene</aaif:text><aaif:lemma rdf:resource="