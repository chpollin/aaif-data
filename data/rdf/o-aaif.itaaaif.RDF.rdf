ntology#Intransitive" /></aaif:Verb><aaif:Adverb rdf:about="https://gams.uni-graz.at/o:aaif.itaaaif#En161Ph1Ad1"><aaif:text>buono</aaif:text><aaif:lemma rdf:resource="https://gams.uni-graz.at/o:aaif.lemma#buono" /><aaif:position rdf:datatype="http://www.w3.org/2001/XMLSchema#int">2</aaif:position><aaif:coordinated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:coordinated><aaif:morphosyntacticStructure rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Adjective" /><aaif:inflection rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Uninflected" /><aaif:attributionTarget rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Verb" /><aaif:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:modified><aaif:semanticClassification rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Manner" /><aaif:reduplicated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:reduplicated><aaif:prepositionalPhrase rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:prepositionalPhrase></aaif:Adverb><aaif:Entry rdf:about="https://gams.uni-graz.at/o:aaif.itaaaif#En162"><aaif:phrase rdf:resource="https://gams.uni-graz.at/o:aaif.itaaaif#En162Ph1" /><aaif:source rdf:resource="https://gams.uni-graz.at/o:aaif.itaaaif.bibl#Nap40" /><gams:textualContent> Veramente  disse buono , e non potea dicere meglio</gams:textualContent><rel:isPartOf rdf:resource="https://gams.uni-graz.at/o:aaif.itaaaif" /></aaif:Entry><aaif:Phrase rdf:about="https://gams.uni-graz.at/o:aaif.itaaaif#En162Ph1"><aaif:verb rdf:resource="https://gams.uni-graz.at/o:aaif.itaaaif#En162Ph1Ve1" /><aaif:adverb rdf:resource="https://gams.uni-graz.at/o:aaif.itaaaif#En162Ph1Ad1" /><aaif:adverb rdf:resource="https://gams.uni-graz.at/o:aaif.itaaaif#En162Ph1Ad2" /><aaif:text> Veramente  disse buono , e non potea dicere meglio</aaif:text><aaif:annoText> [a|Veramente|vero|muSndnnn]  [v|disse|dire|is] [a|buono|buono|auonmnnn] , e non potea dicere meglio</aaif:annoText></aaif:Phrase><aaif:Verb rdf:about="https://gams.uni-graz.at/o:aaif.itaaaif#En162Ph1Ve1"><aaif:text>disse</aaif:text><aaif:lemma rdf:resource="https://gams.uni-graz.at/o:aaif.lemma#dire" /><aaif:position rdf:datatype="http://www.w3.org/2001/XMLSchema#int">2</aaif:position><aaif:coordinated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:coordinated><aaif:partOfText rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</aaif:partOfText><aaif:syntacticConstruction rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Intransitive" /></aaif:Verb><aaif:Adverb rdf:about="https://gams.uni-graz.at/o:aaif.itaaaif#En162Ph1Ad1"><aaif:text>Veramente</aaif:text><aaif:lemma rdf:resource="https://gams.uni-graz.at/o:aaif.lemma#vero" /><aaif:position rdf:datatype="http://www.w3.org/2001/XMLSchema#int">1</aaif:position><aaif:coordinated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:coordinated><aaif:morphosyntacticStructure rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#mente" /><aaif:inflection rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Uninflected" /><aaif:attributionTarget rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Sentence" /><aaif:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:modified><aaif:semanticClassification rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Discourse" /><aaif:reduplicated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:reduplicated><aaif:prepositionalPhrase rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:prepositionalPhrase></aaif:Adverb><aaif:Adverb rdf:about="https://gams.uni-graz.at/o:aaif.itaaaif#En162Ph1Ad2"><aaif:text>buono</aaif:text><aaif:lemma rdf:resource="https://gams.uni-graz.at/o:aaif.lemma#buono" /><aaif:position rdf:datatype="http://www.w3.org/2001/XMLSchema#int">3</aaif:position><aaif:coordinated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:coordinated><aaif:morphosyntacticStructure rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Adjective" /><aaif:inflection rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Uninflected" /><aaif:attributionTarget rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#VerbObject" /><aaif:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:modified><aaif:semanticClassification rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Manner" /><aaif:reduplicated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:reduplicated><aaif:prepositionalPhrase rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:prepositionalPhrase></aaif:Adverb><aaif:Entry rdf:about="https://gams.uni-graz.at/o:aaif.itaaaif#En163"><aaif:phrase rdf:resource="https://gams.uni-graz.at/o:aaif.itaaaif#En163Ph1" /><aaif:source rdf:resource="https://gams.uni-graz.at/o:aaif.itaaaif.bibl#Nap40" /><gams:textualContent>ed è mpossibele che da lo fummo de lo pegnato de le miserie meje, che me volle e male  coce , non se scommoveno ss'uocchie tuoje a quarche compassione?</gams:textualContent><rel:isPartOf rdf:resource="https://gams.uni-graz.at/o:aaif.itaaaif" /></aaif:Entry><aaif:Phrase rdf:about="https://gams.uni-graz.at/o:aaif.itaaaif#En163Ph1"><aaif:verb rdf:resource="https://gams.uni-graz.at/o:aaif.itaaaif#En163Ph1Ve1" /><aaif:adverb rdf:resource="https://gams.uni-graz.at/o:aaif.itaaaif#En163Ph1Ad1" /><aaif:text>le miserie meje, che me volle e male  coce </aaif:text><aaif:annoText>le miserie meje, che me volle e [a|male|malo|afsnmnnn]  [v|coce|cuocere|is] </aaif:annoText></aaif:Phrase><aaif:Verb rdf:about="https://gams.uni-graz.at/o:aaif.itaaaif#En163Ph1Ve1"><aaif:text>coce</aaif:text><aaif:lemma rdf:resource="https://gams.uni-graz.at/o:aaif.lemma#cuocere" /><aaif:position rdf:datatype="http://www.w3.org/2001/XMLSchema#int">2</aaif:position><aaif:coordinated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:coordinated><aaif:partOfText rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</aaif:partOfText><aaif:syntacticConstruction rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Intransitive" /></aaif:Verb><aaif:Adverb rdf:about="https://gams.uni-graz.at/o:aaif.itaaaif#En163Ph1Ad1"><aaif:text>male</aaif:text><aaif:lemma rdf:resource="https://gams.uni-graz.at/o:aaif.lemma#malo" /><aaif:position rdf:datatype="http://www.w3.org/2001/XMLSchema#int">1</aaif:position><aaif:coordinated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:coordinated><aaif:morphosyntacticStructure rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Adjective" /><aaif:inflection rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#FeminineSingular" /><aaif:attributionTarget rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Verb" /><aaif:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:modified><aaif:semanticClassification rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Manner" /><aaif:reduplicated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:reduplicated><aaif:prepositionalPhrase rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:prepositionalPhrase></aaif:Adverb><aaif:Entry rdf:about="https://gams.uni-graz.at/o:aaif.itaaaif#En164"><aaif:phrase rdf:resource="https://gams.uni-graz.at/o:aaif.itaaaif#En164Ph1" /><aaif:source rdf:resource="https://gams.uni-graz.at/o:aaif.itaaaif.bibl#Nap40" /><gams:textualContent>reo che no' le jevano bone </gams:textualContent><rel:isPartOf rdf:resource="https://gams.uni-graz.at/o:aaif.itaaaif" /></aaif:Entry><aaif:Phrase rdf:about="https://gams.uni-graz.at/o:aaif.itaaaif#En164Ph1"><aaif:verb rdf:resource="https://gams.uni-graz.at/o:aaif.itaaaif#En164Ph1Ve1" /><aaif:adverb rdf:resource="https://gams.uni-graz.at/o:aaif.itaaaif#En164Ph1Ad1" /><aaif:text>reo che no' le jevano bone </aaif:text><aaif:annoText>reo che no' le [v|jevano|andare|is] [a|bone|buono|axonmnnn] </aaif:annoText></aaif:Phrase><aaif:Verb rdf:about="https://gams.uni-graz.at/o:aaif.itaaaif#En164Ph1Ve1"><aaif:text>jevano</aaif:text><aaif:lemma rdf:resource="https://gams.uni-graz.at/o:aaif.lemma#andare" /><aaif:position rdf:datatype="http://www.w3.org/2001/XMLSchema#int">1</aaif:position><aaif:coordinated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:coordinated><aaif:partOfText rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</aaif:partOfText><aaif:syntacticConstruction rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Intransitive" /></aaif:Verb><aaif:Adverb rdf:about="https://gams.uni-graz.at/o:aaif.itaaaif#En164Ph1Ad1"><aaif:text>bone</aaif:text><aaif:lemma rdf:resource="https://gams.uni-graz.at/o:aaif.lemma#buono" /><aaif:position rdf:datatype="http://www.w3.org/2001/XMLSchema#int">2</aaif:position><aaif:coordinated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:coordinated><aaif:morphosyntacticStructure rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Adjective" /><aaif:inflection rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#FemininePlural" /><aaif:attributionTarget rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#VerbObject" /><aaif:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:modified><aaif:semanticClassification rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Manner" /><aaif:reduplicated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:reduplicated><aaif:prepositionalPhrase rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:prepositionalPhrase></aaif:Adverb><aaif:Entry rdf:about="https://gams.uni-graz.at/o:aaif.itaaaif#En165"><aaif:phrase rdf:resource="https://gams.uni-graz.at/o:aaif.itaaaif#En165Ph1" /><aaif:source rdf:resource="https://gams.uni-graz.at/o:aaif.itaaaif.bibl#Nap40" /><gams:textualContent>E, pe'bona fortuna, cogliette lo vozzacchio; e le fece cadere la palommella, da le granfe. La quale caduta, 'ncoppa 'na troffa d'erva, a mala pena, la toccaje, che, subeto, (fatte quatto capotrommola, e brocioleata, 'no poco, 'nterra,) se ne tornaje a bolare , bella e bona , comme, se, maje, fosse stata scannarozzata.</gams:textualContent><rel:isPartOf rdf:resource="https://gams.uni-graz.at/o:aaif.itaaaif" /></aaif:Entry><aaif:Phrase rdf:about="https://gams.uni-graz.at/o:aaif.itaaaif#En165Ph1"><aaif:verb rdf:resource="https://gams.uni-graz.at/o:aaif.itaaaif#En165Ph1Ve1" /><aaif:adverb rdf:resource="https://gams.uni-graz.at/o:aaif.itaaaif#En165Ph1Ad1" /><aaif:adverb rdf:resource="https://gams.uni-graz.at/o:aaif.itaaaif#En165Ph1Ad2" /><aaif:text>se ne tornaje a bolare , bella e bona ,</aaif:text><aaif:annoText>se ne tornaje a [v|bolare|volare|is] , [a|bella|bello|afsnmnnC] e [a|bona|buono|afsnmnnC] ,</aaif:annoText></aaif:Phrase><aaif:Verb rdf:about="https://gams.uni-graz.at/o:aaif.itaaaif#En165Ph1Ve1"><aaif:text>bolare</aaif:text><aaif:lemma rdf:resource="https://gams.uni-graz.at/o:aaif.lemma#volare" /><aaif:position rdf:datatype="http://www.w3.org/2001/XMLSchema#int">1</aaif:position><aaif:coordinated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</aaif:coordinated><aaif:partOfText rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</aaif:partOfText><aaif:syntacticConstruction rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Intransitive" /></aaif:Verb><aaif:Adverb rdf:about="https://gams.uni-graz.at/o:aaif.itaaaif#En165Ph1Ad1"><aaif:text>bella</aaif:text><aaif:lemma rdf:resource="https://gams.uni-graz.at/o:aaif.lemma#bello" /><aaif:position rdf:datatype="http://www.w3.org/2001/XMLSchema#int">2</aaif:position><aaif:coordinated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</aaif:coordinated><aaif:morphosyntacticStructure rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#Adjective" /><aaif:inflection rdf:resource="https://gams.uni-graz.at/o:aaif.ontology#FeminineSingular" /><aaif:attributionTarget rdf:resource="https://gams.un